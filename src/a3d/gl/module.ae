// OpenGL 4.1 core backend.
//
// Uniform locations are resolved once per program into named slots rather than
// looked up (or hashed) per draw: `ProgramSlots` is filled the first time a
// program is seen and reused for every frame afterwards. Custom per-model
// uniforms cache their own location on the `Uniform` that owns them.
//
// Every struct here holds primitives and raw handles only, so this module never
// depends on another module's struct layout.

import std.list
import std.heap
import std.string
import a3d.core
import a3d.shaders

exports (
    GLRenderer, ProgramSlots, TextureEntry, Skybox,
    skybox_create, skybox_free,
    renderer_new, renderer_free, backend,
    renderer_add_light, renderer_remove_light, renderer_model_count, renderer_model,
    renderer_draw_calls, renderer_instance_count,
    renderer_set_clear_color, renderer_set_fxaa, renderer_set_bloom, renderer_set_msaa,
    renderer_set_target,
    renderer_set_bloom_params, renderer_set_post, renderer_default_program,
    renderer_load_texture, renderer_release_texture, renderer_texture_count,
    read_pixel
)

