// Wavefront OBJ/MTL loading and procedural primitives.
//
// A face vertex in OBJ is a (position, uv, normal) triplet, and the same triplet
// may appear on many faces. Every triplet is pushed through the native
// deduplicating emitter, so the GPU sees each distinct vertex exactly once
// regardless of how the file is authored.

import std.fs
import std.list
import std.heap
import std.string
import std.bytes
import std.mem
import std.os
import std.worker
import std.set
import ae3d.core
import ae3d.geometry

exports (
    cache_flush, cache_hits, cache_directory, load_obj, load_obj_skinned, load_obj_baked, load_obj_instanced, load_mtl, materials_free,
    cube, sphere, capsule, push_capsule, plane, water_surface, quad, grid, box_outline,
    last_error
)

extern ae3d_farr_count(values: ptr) -> int
extern ae3d_farr_get(values: ptr, i: int) -> float
extern calloc(count: int, size: int) -> ptr
extern realloc(p: ptr, size: long) -> ptr
extern free(p: ptr)

var g_error = ""
var g_error_owned = false

last_error() -> string {
    return g_error
}

// The message is owned and replaced in place, so a caller that never reads it
// still costs exactly one live allocation rather than one per failed load.
set_error(reason: string, detail: string) {
    if g_error_owned { string.free(g_error) }
    g_error = string.concat(reason, detail)
    g_error_owned = true
}

// std.string hands back a borrowed C string as a `ptr`; returning it from a
// function declared `-> string` is the conversion the language provides.
field(fields: ptr, index: int) -> string {
    return string.array_get(fields, index)
}

// OBJ separates fields with arbitrary whitespace, and exporters do emit runs of
// it ("v  1.6991 29.1946 -0.4757"). Splitting on a single space leaves empty
// entries, so tokens are counted and addressed skipping those: reading them
// positionally would shift every coordinate by one.
token_count(fields: ptr) -> int {
    total = string.array_size(fields)
    count = 0
    i = 0
    while i < total {
        if string.length(field(fields, i)) > 0 { count = count + 1 }
        i = i + 1
    }
    return count
}

token(fields: ptr, index: int) -> string {
    total = string.array_size(fields)
    seen = 0
    i = 0
    while i < total {
        value = field(fields, i)
        if string.length(value) > 0 {
            if seen == index { return value }
            seen = seen + 1
        }
        i = i + 1
    }
    return ""
}

// A tab-separated line is flattened first. The split array borrows slices of
// whatever it was given, so the flattened copy has to outlive it: splitting a
// temporary and freeing it here would hand back dangling tokens.
split_fields(line: string) -> string {
    if string.contains(line, "\t") == 1 {
        return string.replace_all(line, "\t", " ")
    }
    return string.copy(line)
}

parse_float(text: string) -> float {
    if string.try_double(text) == 0 { return 0.0 }
    return string.get_double(text)
}

// --- the builder: what the lines are read into ------------------------------------------------------------------
//
// An OBJ face vertex is a (position, uv, normal) triplet of indices into
// three lists, and a GPU vertex is one of each: the same triplet reaching
// emit twice must be one vertex, or the index buffer grows without bound on
// a large model. So the three lists are kept as read (float32, as the mesh
// keeps them), and a hash of the triplets seen maps each to the vertex it
// became -- open addressing, grown at three quarters full. Vertices come
// out in the order their triplets are first seen, whatever the table's
// layout. It was C (native/geometry/mesh.c) until Aether had a 32-bit
// float (aether#2134).

struct ObjBuild {
    positions: ptr                 // f32[], three a position
    uvs: ptr                       // f32[], two a coordinate
    normals: ptr                   // f32[], three a normal
    position_count: int            // floats, not positions
    position_capacity: int
    uv_count: int
    uv_capacity: int
    normal_count: int
    normal_capacity: int
    table: ptr                     // int[slots * 4]: v, vt, vn, the vertex (-1 when empty)
    table_mask: int
    table_used: int
    // Borrowed for one load: written per position, onto the vertices each
    // position becomes, which only the loader knows.
    skin: ptr                      // geometry skin rows, or null
    occlusion: ptr                 // a float array of one value a position, or null
}

objbuild_create() -> *ObjBuild {
    b = calloc(1, sizeof(ObjBuild)) as *ObjBuild
    objbuild_grow_table(b)
    return b
}

objbuild_destroy(b: *ObjBuild) {
    if b == null { return }
    if b.positions != null { free(b.positions) }
    if b.uvs != null { free(b.uvs) }
    if b.normals != null { free(b.normals) }
    if b.table != null { free(b.table) }
    free(b as ptr)
}

// FNV-1a over the three indices, in 32 bits.
objkey_hash(v: int, vt: int, vn: int) -> int {
    h = 0 - 2128831035
    h = (h ^ v) * 16777619
    h = (h ^ vt) * 16777619
    h = (h ^ vn) * 16777619
    return h
}

objbuild_grow_table(b: *ObjBuild) {
    old = b.table
    old_capacity = b.table_mask + 1
    capacity = 1024
    if old != null { capacity = old_capacity * 2 }
    fresh_block = calloc(capacity * 4, 4)
    fresh = fresh_block as int[]
    i = 0
    while i < capacity {
        fresh[i * 4 + 3] = 0 - 1
        i = i + 1
    }
    b.table = fresh_block
    b.table_mask = capacity - 1
    if old == null { return }
    previous = old as int[]
    i = 0
    while i < old_capacity {
        at = i * 4
        if previous[at + 3] >= 0 {
            slot = objkey_hash(previous[at], previous[at + 1], previous[at + 2]) & b.table_mask
            while fresh[slot * 4 + 3] >= 0 { slot = (slot + 1) & b.table_mask }
            fresh[slot * 4] = previous[at]
            fresh[slot * 4 + 1] = previous[at + 1]
            fresh[slot * 4 + 2] = previous[at + 2]
            fresh[slot * 4 + 3] = previous[at + 3]
        }
        i = i + 1
    }
    free(old)
}

// `values` float32s onto one of the builder's lists, grown as needed; the
// list's new length in floats.
objbuild_push(block: ptr, count: int, capacity: int, a: float, b: float, c: float, n: int) -> ptr {
    list = block
    if count + n > capacity { return null }
    f = list as f32[]
    f[count] = a
    f[count + 1] = b
    if n == 3 { f[count + 2] = c }
    return list
}

// The capacity a list of `count` floats needs to take `n` more.
objbuild_room(count: int, capacity: int, n: int) -> int {
    if count + n <= capacity { return capacity }
    size = capacity
    if size == 0 { size = 256 }
    while size < count + n { size = size * 2 }
    return size
}

objbuild_add_position(b: *ObjBuild, x: float, y: float, z: float) {
    room = objbuild_room(b.position_count, b.position_capacity, 3)
    if room != b.position_capacity {
        b.positions = realloc(b.positions, (room * 4) as long)
        b.position_capacity = room
    }
    objbuild_push(b.positions, b.position_count, b.position_capacity, x, y, z, 3)
    b.position_count = b.position_count + 3
}

objbuild_add_uv(b: *ObjBuild, u: float, v: float) {
    room = objbuild_room(b.uv_count, b.uv_capacity, 2)
    if room != b.uv_capacity {
        b.uvs = realloc(b.uvs, (room * 4) as long)
        b.uv_capacity = room
    }
    objbuild_push(b.uvs, b.uv_count, b.uv_capacity, u, v, 0.0, 2)
    b.uv_count = b.uv_count + 2
}

objbuild_add_normal(b: *ObjBuild, x: float, y: float, z: float) {
    room = objbuild_room(b.normal_count, b.normal_capacity, 3)
    if room != b.normal_capacity {
        b.normals = realloc(b.normals, (room * 4) as long)
        b.normal_capacity = room
    }
    objbuild_push(b.normals, b.normal_count, b.normal_capacity, x, y, z, 3)
    b.normal_count = b.normal_count + 3
}

// The mesh vertex for the triplet (v, vt, vn), made the first time it is
// seen; -1 when the mesh could not take one.
objbuild_emit(b: *ObjBuild, mesh: ptr, v: int, vt: int, vn: int) -> int {
    if b == null || mesh == null { return 0 - 1 }
    if (b.table_used + 1) * 4 >= (b.table_mask + 1) * 3 { objbuild_grow_table(b) }
    table = b.table as int[]
    slot = objkey_hash(v, vt, vn) & b.table_mask
    while table[slot * 4 + 3] >= 0 {
        if table[slot * 4] == v && table[slot * 4 + 1] == vt && table[slot * 4 + 2] == vn {
            return table[slot * 4 + 3]
        }
        slot = (slot + 1) & b.table_mask
    }
    px = 0.0
    py = 0.0
    pz = 0.0
    u = 0.0
    tv = 0.0
    nx = 0.0
    ny = 1.0
    nz = 0.0
    if v >= 0 && v * 3 + 2 < b.position_count {
        p = b.positions as f32[]
        px = p[v * 3] as float
        py = p[v * 3 + 1] as float
        pz = p[v * 3 + 2] as float
    }
    if vt >= 0 && vt * 2 + 1 < b.uv_count {
        t = b.uvs as f32[]
        u = t[vt * 2] as float
        tv = t[vt * 2 + 1] as float
    }
    if vn >= 0 && vn * 3 + 2 < b.normal_count {
        n = b.normals as f32[]
        nx = n[vn * 3] as float
        ny = n[vn * 3 + 1] as float
        nz = n[vn * 3 + 2] as float
    }
    unified = geometry.mesh_push_vertex(mesh, px, py, pz, u, tv, nx, ny, nz)
    if unified < 0 { return 0 - 1 }
    if b.skin != null { geometry.skinrows_apply(b.skin, mesh, unified, v) }
    if b.occlusion != null && v >= 0 && v < ae3d_farr_count(b.occlusion) {
        geometry.mesh_set_occlusion(mesh, unified, ae3d_farr_get(b.occlusion, v))
    }
    table[slot * 4] = v
    table[slot * 4 + 1] = vt
    table[slot * 4 + 2] = vn
    table[slot * 4 + 3] = unified
    b.table_used = b.table_used + 1
    return unified
}

// --- the geometry lines, read in place -----------------------------------------
//
// A vertex, a texture coordinate, a normal and a face are nearly every line of
// an OBJ, and each used to go through a trimmed copy, a tab-flattened copy, a
// split into a fresh array of fresh strings, a token lookup that walked that
// array from the start for every field, and a number parsed twice (tried, then
// read). The street's 245 sources -- 4.4 MB, half of it one character mesh --
// took 275 ms that way. These four read the line where it lies instead: a
// number is cut out once and parsed once, and a face's indices, being
// integers, are read digit by digit with no string at all. Everything else
// (mtllib, usemtl, the lines a loader ignores) still takes the general path.

var g_at = 0                       // where the scan stands in the line
var g_number: ptr = null           // one double, the parser's out-value
var g_powers: ptr = null           // 10^0 .. 10^22, each exact in a double

is_blank(c: int) -> bool { return c == 32 || c == 9 || c == 13 }

skip_blanks(line: string, length: int) {
    while g_at < length && is_blank(string.char_at(line, g_at)) { g_at = g_at + 1 }
}

// The next whitespace-separated number, as the general path read it: a field
// that does not parse is 0.
//
// A number with at most fifteen significant digits and a power of ten no
// larger than 10^22 either way -- every coordinate an exporter writes -- is
// read here without a string: its digits are an integer a double holds
// exactly, the power is exact too, and one multiplication or division of two
// exact doubles is correctly rounded, which is what strtod returns (Clinger's
// fast path). Anything else -- more digits, a larger exponent, "inf", a hex
// float, a stray character -- is cut out and handed to the parser as before.
next_float(line: string, length: int) -> float {
    skip_blanks(line, length)
    start = g_at
    while g_at < length && !is_blank(string.char_at(line, g_at)) { g_at = g_at + 1 }
    if g_at == start { return 0.0 }
    fast = exact_float(line, start, g_at)
    if g_exact { return fast }
    if g_number == null { g_number = calloc(1, 8) }
    text = string.substring(line, start, g_at)
    value = 0.0
    if string.to_double_raw(text, g_number) != 0 { value = (g_number as float[])[0] }
    string.free(text)
    return value
}

var g_exact = false                // whether exact_float read the field

// The field [start, end) as a number when the fast path applies, g_exact
// saying whether it did.
exact_float(line: string, start: int, end: int) -> float {
    g_exact = false
    at = start
    negative = false
    c = string.char_at(line, at)
    if c == 45 || c == 43 {
        negative = c == 45
        at = at + 1
    }
    mantissa = 0 as long
    significant = 0  // digits in the mantissa past its leading zeros
    digits = 0  // all of them, zeros included
    scale = 0  // the power of ten the mantissa is off by
    seen_point = false
    while at < end {
        c = string.char_at(line, at)
        if c >= 48 && c <= 57 {
            digits = digits + 1
            if significant > 0 || c != 48 { significant = significant + 1 }
            if significant > 15 { return 0.0 }
            mantissa = mantissa * (10 as long) + ((c - 48) as long)
            if seen_point { scale = scale - 1 }
        } else if c == 46 && !seen_point {
            seen_point = true
        } else {
            break
        }
        at = at + 1
    }
    if digits == 0 { return 0.0 }
    if at < end {
        c = string.char_at(line, at)
        if c != 101 && c != 69 { return 0.0 }
        at = at + 1
        exponent_negative = false
        if at < end {
            c = string.char_at(line, at)
            if c == 45 || c == 43 {
                exponent_negative = c == 45
                at = at + 1
            }
        }
        exponent = 0
        exponent_digits = 0
        while at < end {
            c = string.char_at(line, at)
            if c < 48 || c > 57 { return 0.0 }
            exponent = exponent * 10 + (c - 48)
            exponent_digits = exponent_digits + 1
            if exponent > 400 { return 0.0 }
            at = at + 1
        }
        if exponent_digits == 0 { return 0.0 }
        if exponent_negative { exponent = 0 - exponent }
        scale = scale + exponent
    }
    if scale > 22 || scale < 0 - 22 { return 0.0 }
    powers = exact_powers()
    value = mantissa as float
    if scale > 0 { value = value * powers[scale] }
    if scale < 0 { value = value / powers[0 - scale] }
    // strtod keeps the sign of a zero; multiplying keeps it too.
    if negative { value = value * (0.0 - 1.0) }
    g_exact = true
    return value
}

// 10^0 .. 10^22, built by multiplying by ten: every one of them is exact in
// a double, and so is each product on the way.
exact_powers() -> float[] {
    if g_powers == null {
        g_powers = calloc(23, 8)
        table = g_powers as float[]
        table[0] = 1.0
        k = 1
        while k <= 22 {
            table[k] = table[k - 1] * 10.0
            k = k + 1
        }
    }
    return g_powers as float[]
}

// A face's index as parse_index reads one, from the digits at the scan: -1
// when there are none (the empty slot of "1//3") or they are not a number.
// Stops at the '/' or the blank after it, leaving the scan there.
next_index(line: string, length: int, present_count: int) -> int {
    negative = false
    if g_at < length && string.char_at(line, g_at) == 45 {
        negative = true
        g_at = g_at + 1
    }
    digits = 0
    value = 0
    valid = true
    while g_at < length {
        c = string.char_at(line, g_at)
        if c == 47 || is_blank(c) { break }
        if c >= 48 && c <= 57 {
            value = value * 10 + (c - 48)
            digits = digits + 1
        } else {
            valid = false
        }
        g_at = g_at + 1
    }
    if digits == 0 || !valid { return 0 - 1 }
    if negative { value = 0 - value }
    if value > 0 { return value - 1 }
    if value < 0 { return present_count + value }
    return 0 - 1
}

// How many whitespace-separated fields the line has from the scan on,
// without moving it: the general path skipped a vertex line of fewer than
// three numbers and a face of fewer than three references, and so must this.
fields_ahead(line: string, length: int) -> int {
    at = g_at
    count = 0
    while at < length {
        while at < length && is_blank(string.char_at(line, at)) { at = at + 1 }
        if at >= length { break }
        count = count + 1
        while at < length && !is_blank(string.char_at(line, at)) { at = at + 1 }
    }
    return count
}

// A face from the line's second field on, fanned into triangles exactly as
// emit_face does it.
emit_face_line(build: ptr, mesh: ptr, line: string, length: int,
               positions: int, uvs: int, normals: int) {
    first = 0 - 1
    previous = 0 - 1
    while true {
        skip_blanks(line, length)
        if g_at >= length { break }
        v = next_index(line, length, positions)
        vt = 0 - 1
        vn = 0 - 1
        if g_at < length && string.char_at(line, g_at) == 47 {
            g_at = g_at + 1
            vt = next_index(line, length, uvs)
            if g_at < length && string.char_at(line, g_at) == 47 {
                g_at = g_at + 1
                vn = next_index(line, length, normals)
            }
        }
        // Whatever else the reference carried, to its end.
        while g_at < length && !is_blank(string.char_at(line, g_at)) { g_at = g_at + 1 }
        if v < 0 { continue }
        unified = objbuild_emit(build as *ObjBuild, mesh, v, vt, vn)
        if unified < 0 { continue }
        if first < 0 {
            first = unified
        } else if previous < 0 {
            previous = unified
        } else {
            core.mesh_push_triangle(mesh, first, previous, unified)
            previous = unified
        }
    }
}

// OBJ indices are 1-based and may be negative, in which case they count back
// from the end of the list read so far.
parse_index(text: string, present_count: int) -> int {
    if text == "" { return 0 - 1 }
    if string.try_int(text) == 0 { return 0 - 1 }
    value = string.get_int(text)
    if value > 0 { return value - 1 }
    if value < 0 { return present_count + value }
    return 0 - 1
}

directory_of(path: string) -> string {
    cut = 0 - 1
    i = 0
    length = string.length(path)
    while i < length {
        c = string.char_at(path, i)
        if c == 47 || c == 92 { cut = i }
        i = i + 1
    }
    if cut < 0 { return "" }
    return string.substring(path, 0, cut + 1)
}

basename_of(path: string) -> string {
    cut = 0 - 1
    i = 0
    length = string.length(path)
    while i < length {
        c = string.char_at(path, i)
        if c == 47 || c == 92 { cut = i }
        i = i + 1
    }
    return string.substring(path, cut + 1, length)
}

find_material(materials: ptr, name: string) -> *Material {
    count = list.size(materials)
    i = 0
    while i < count {
        m = list.get_raw(materials, i) as *Material
        if m != null && string.equals(m.name, name) == 1 { return m }
        i = i + 1
    }
    return null
}

// The classic Blinn-Phong exponent, as a roughness: a mirror-sharp exponent is
// a smooth surface, a low one is a rough surface. Kept off zero so a highlight
// never collapses to a point the shader cannot show.
roughness_of_exponent(exponent: float) -> float {
    e = exponent
    if e < 0.0 { e = 0.0 }
    r = core.sqrt_of(2.0 / (e + 2.0))
    if r < 0.04 { r = 0.04 }
    if r > 1.0 { r = 1.0 }
    return r
}

load_mtl(path: string) -> ptr {
    materials = list.new()

    content, err = fs.read(path)
    if err != "" {
        set_error("cannot read ", path)
        string.free(content)
        return materials
    }

    lines = string.split(content, "\n")
    line_count = string.array_size(lines)
    current = null as *Material
    // A material that states its roughness outright keeps it, whatever order the
    // file mentions the old specular exponent in.
    stated_roughness = false
    base = directory_of(path)

    i = 0
    while i < line_count {
        raw = field(lines, i)
        line = string.trim(raw)
        i = i + 1
        if line == "" { continue }
        if string.char_at(line, 0) == 35 { continue }

        flattened = split_fields(line)
        fields = string.split(flattened, " ")
        field_count = token_count(fields)
        if field_count == 0 { string.array_free(fields) ; string.free(flattened) ; continue }

        keyword = token(fields, 0)

        if string.equals(keyword, "newmtl") == 1 && field_count >= 2 {
            current = core.material_new(token(fields, 1))
            list.add_raw(materials, current)
            stated_roughness = false
        } else if current != null {
            if string.equals(keyword, "Kd") == 1 && field_count >= 4 {
                current.diffuse = core.vec3(parse_float(token(fields, 1)),
                                            parse_float(token(fields, 2)),
                                            parse_float(token(fields, 3)))
            } else if string.equals(keyword, "Ks") == 1 && field_count >= 4 {
                current.specular = core.vec3(parse_float(token(fields, 1)),
                                             parse_float(token(fields, 2)),
                                             parse_float(token(fields, 3)))
            } else if string.equals(keyword, "Ns") == 1 && field_count >= 2 {
                // A specular exponent is the old way of saying how sharp a
                // highlight is, and this shader asks for roughness instead. The
                // file used to be read and thrown away.
                if !stated_roughness {
                    current.roughness = roughness_of_exponent(parse_float(token(fields, 1)))
                }
            } else if string.equals(keyword, "d") == 1 && field_count >= 2 {
                current.alpha = parse_float(token(fields, 1))
            } else if string.equals(keyword, "Tr") == 1 && field_count >= 2 {
                current.alpha = 1.0 - parse_float(token(fields, 1))
            } else if string.equals(keyword, "Pm") == 1 && field_count >= 2 {
                current.metallic = parse_float(token(fields, 1))
            } else if string.equals(keyword, "Pr") == 1 && field_count >= 2 {
                current.roughness = parse_float(token(fields, 1))
                stated_roughness = true
            } else if string.equals(keyword, "map_Kd") == 1 && field_count >= 2 {
                texture = token(fields, field_count - 1)
                if string.contains(texture, "/") == 1 || string.contains(texture, "\\") == 1 {
                    core.material_set_texture_path(current, texture)
                } else {
                    joined = string.concat(base, texture)
                    core.material_set_texture_path(current, joined)
                    string.free(joined)
                }
            } else if string.equals(keyword, "norm") == 1 && field_count >= 2 {
                // OBJ grew `norm` for a tangent-space normal map. map_Bump is
                // a height map and means something else, however often the two
                // are written for each other.
                texture = token(fields, field_count - 1)
                if string.contains(texture, "/") == 1 || string.contains(texture, "\\") == 1 {
                    core.material_set_normal_path(current, texture)
                } else {
                    joined = string.concat(base, texture)
                    core.material_set_normal_path(current, joined)
                    string.free(joined)
                }
            }
        }
        string.array_free(fields)
        string.free(flattened)
    }

    string.array_free(lines)
    string.free(content)
    string.free(base)
    return materials
}

// Materials from a standalone load_mtl belong to the caller; a load_obj hands
// them to the model instead.
materials_free(materials: ptr) {
    if materials == null { return }
    count = list.size(materials)
    i = 0
    while i < count {
        m = list.get_raw(materials, i) as *Material
        if m != null { core.material_free(m) }
        i = i + 1
    }
    list.free(materials)
}

// --- the parse cache (#411) --------------------------------------------------------------------
//
// A text parse is fast for text; not doing it again is faster. After a
// parse, what it made -- the vertices and indices as they will be drawn,
// each group's index range and material name, the model's material name,
// and the mtllib lines -- goes to a file of its own under the cache
// directory, headed by the source's absolute path, size and modification
// time. A load whose source still matches reads that instead, copies the
// geometry in one go, and parses only the MTLs (they are small), binding
// their materials to the groups by name as the parse would have.
//
// The directory is AE3D_MESH_CACHE, or build/cache/meshes when there is a
// build/ directory where the program runs (an ae3d checkout, a game built
// the same way), or none; AE3D_MESH_CACHE=off turns it off. A skinned or
// baked load writes rows per position that only a parse can place, so it
// never touches the cache. The modification time is to the second: a file
// rewritten within the second at the same size reads the old parse.
//
// The file, little-endian: "OBJC", version, the source's size and time
// (u64 each), whether normals were recalculated, the vertex, index and
// group counts, the file's own length (u64: a torn file is shorter); then
// strings (u32 length, bytes): the absolute path, the
// model's material name, the mtllib names joined by newlines; a group each:
// start, count, material name; then the vertices (nine f32 each) and the
// indices (u32).

const CACHE_MAGIC = 1128940111      // "OBJC" read little-endian, 0x434A424F
const CACHE_VERSION = 1

var g_cache_dir = ""
var g_cache_known = false
var g_cache_queue: ptr = null       // list of *CacheWrite, waiting for cache_flush
var g_cache_hits = 0
var g_cache_names: ptr = null       // std.set of the cache's files: a miss asked of the disk costs 40 us on Windows

cache_dir() -> string {
    if g_cache_known { return g_cache_dir }
    g_cache_known = true
    asked = os.getenv("AE3D_MESH_CACHE")
    if asked != null {
        // string.equals, not != : aether lowers a comparison with "0" to a
        // pointer compare (aether-lang-dev/aether#2206).
        if asked != "" && asked != "off" && string.equals(asked, "0") != 1 { g_cache_dir = asked }
    } else if fs.dir_exists("build") != 0 {
        g_cache_dir = "build/cache/meshes"
    }
    if g_cache_dir != "" {
        if fs.mkdir_p(g_cache_dir) != "" { g_cache_dir = "" }
    }
    if g_cache_dir != "" {
        g_cache_names = set.new()
        listing, why = fs.list_dir(g_cache_dir)
        if why == "" && listing != null {
            i = 0
            while i < fs.dir_list_count(listing) {
                set.add(g_cache_names, "${g_cache_dir}/${fs.dir_list_get(listing, i)}")
                i = i + 1
            }
            fs.dir_list_free(listing)
        }
    }
    return g_cache_dir
}

// Loads the cache answered, since the program began.
cache_hits() -> int { return g_cache_hits }

// Where the cache is, or "" when there is none.
cache_directory() -> string { return cache_dir() }

// Two FNV-1a hashes of the path, 32 bits each, from different offsets: the
// file's name. The path in the file is what decides; the name only finds it.
cache_file(absolute: string) -> string {
    a = 2166136261 as long
    b = 84696351 as long
    mask = 4294967295 as long
    length = string.length(absolute)
    i = 0
    while i < length {
        c = string.char_at(absolute, i) as long
        a = ((a ^ c) * (16777619 as long)) & mask
        b = ((b ^ c) * (16777619 as long)) & mask
        i = i + 1
    }
    return "${cache_dir()}/${a}_${b}.bin"
}

// The path from the root: as given when it is, else under the working
// directory. Not canonical -- "a/../b" and "b" are two entries -- which
// costs a parse, never a wrong read, and saves the file open realpath is.
absolute_of(path: string) -> string {
    if fs.path_is_absolute(path) != 0 { return string.concat(path, "") }
    here = os.getcwd()
    under = string.concat(here, "/")
    whole = string.concat(under, path)
    string.free(under)
    return whole
}

// A cache file's bytes and name, for the worker that writes it.
struct CacheWrite {
    data: ptr                        // std.bytes
    total: int
    name: ptr                        // std.bytes
    name_length: int
    source: ptr                      // std.bytes: the OBJ's path, as loaded
    source_length: int
    began: long                      // wall seconds when the parse began
}

// The queued cache files, to one worker that writes them all: called when
// a scene has loaded, and every frame (where there is nothing to do but
// look at an empty queue). Without a worker, here.
cache_flush() {
    if g_cache_queue == null || list.size(g_cache_queue) == 0 { return }
    queue = g_cache_queue
    g_cache_queue = list.new()
    if !worker.run_detached(|| { return cache_write_all(queue) }) { cache_write_all(queue) }
}

cache_write_all(queue: ptr) -> ptr {
    i = 0
    while i < list.size(queue) {
        cache_write_job(list.get_raw(queue, i))
        i = i + 1
    }
    list.free(queue)
    return null
}

cache_write_job(context: ptr) -> ptr {
    job = context as *CacheWrite
    name = bytes.to_string(job.name, job.name_length)
    source = bytes.to_string(job.source, job.source_length)
    // The source as it is now. Changed since the parse began (or within the
    // second before, the clock's grain), what was parsed may not be what is
    // there: no cache, and the next load parses again.
    size, size_err = fs.size(source)
    time, time_err = fs.mtime(source)
    if size_err == "" && time_err == "" && time < job.began - (1 as long) {
        bytes.set_le64(job.data, 8, size)
        bytes.set_le64(job.data, 16, time)
        text = bytes.to_string(job.data, job.total)
        fs.write_binary(name, text, job.total)
    }
    bytes.free(job.data)
    bytes.free(job.name)
    bytes.free(job.source)
    heap.free(job)
    return null
}

cache_put_string(b: ptr, at: int, text: string) -> int {
    length = string.length(text)
    bytes.set_le32(b, at, length)
    if length > 0 { bytes.copy_from_string(b, at + 4, text, length) }
    return at + 4 + length
}

cache_get_string(raw: ptr, at: int, length: int) -> string {
    return bytes.string_from_ptr(raw + at, length)
}

material_name(material: *Material) -> string {
    if material == null { return "" }
    return material.name
}

// A parse's model, and the mtllib names it read, to the cache.
cache_write(file: string, path: string, absolute: string, began: long, recalculated: bool,
            m: *Model, mtllibs: string) {
    vertex_count = core.mesh_vertex_count(m.mesh)
    index_count = core.mesh_index_count(m.mesh)
    group_count = core.model_group_count(m)
    model_material = material_name(m.material)
    total = 48 + 12 + string.length(absolute) + string.length(model_material) + string.length(mtllibs)
    g = 0
    while g < group_count {
        total = total + 12 + string.length(material_name(core.model_group(m, g).material))
        g = g + 1
    }
    geometry_at = total
    total = total + vertex_count * 36 + index_count * 4
    b = bytes.new(total)
    bytes.set_length(b, total)
    bytes.set_le32(b, 0, CACHE_MAGIC)
    bytes.set_le32(b, 4, CACHE_VERSION)
    // The source's size and time are the writer's to fill in.
    flags = 0
    if recalculated { flags = 1 }
    bytes.set_le32(b, 24, flags)
    bytes.set_le32(b, 28, vertex_count)
    bytes.set_le32(b, 32, index_count)
    bytes.set_le32(b, 36, group_count)
    bytes.set_le64(b, 40, total as long)
    at = cache_put_string(b, 48, absolute)
    at = cache_put_string(b, at, model_material)
    at = cache_put_string(b, at, mtllibs)
    g = 0
    while g < group_count {
        group = core.model_group(m, g)
        bytes.set_le32(b, at, group.index_start)
        bytes.set_le32(b, at + 4, group.index_count)
        at = cache_put_string(b, at + 8, material_name(group.material))
        g = g + 1
    }
    data = bytes.data(b)
    mem.copy_at(data, geometry_at as long, geometry.mesh_vertex_data(m.mesh), 0 as long, (vertex_count * 36) as long)
    mem.copy_at(data, (geometry_at + vertex_count * 36) as long, geometry.mesh_index_data(m.mesh), 0 as long, (index_count * 4) as long)
    // Queued, and written by one worker when the loading is done
    // (cache_flush): a few hundred small files written during a load cost it
    // half again its parse, on this thread or beside it. Not atomic -- a torn
    // or half-written file is shorter than its counts say, and cache_read
    // turns it down.
    set.add(g_cache_names, file)
    job = heap.new(CacheWrite)
    job.data = b
    job.total = total
    job.name_length = string.length(file)
    job.name = bytes.new(job.name_length + 1)
    bytes.set_length(job.name, job.name_length)
    bytes.copy_from_string(job.name, 0, file, job.name_length)
    job.source_length = string.length(path)
    job.source = bytes.new(job.source_length + 1)
    bytes.set_length(job.source, job.source_length)
    bytes.copy_from_string(job.source, 0, path, job.source_length)
    job.began = began
    if g_cache_queue == null { g_cache_queue = list.new() }
    list.add_raw(g_cache_queue, job as ptr)
}

// The model a cache file holds for this source, or null when there is none
// or it no longer matches: another path, size, time or normals.
cache_read(file: string, path: string, absolute: string, size: long, time: long,
           recalculated: bool) -> *Model {
    if !set.contains(g_cache_names, file) { return null }
    content, length, err = fs.read_binary(file)
    if err != "" || length < 60 { return null }
    b = bytes.new(length + 4)
    bytes.copy_from_string(b, 0, content, length)
    raw = bytes.data(b)
    flags = 0
    if recalculated { flags = 1 }
    if bytes.get_le32(b, 0) != CACHE_MAGIC || bytes.get_le32(b, 4) != CACHE_VERSION ||
       bytes.get_le64(b, 8) != size || bytes.get_le64(b, 16) != time || bytes.get_le32(b, 24) != flags ||
       bytes.get_le64(b, 40) != (length as long) {
        bytes.free(b)
        return null
    }
    vertex_count = bytes.get_le32(b, 28)
    index_count = bytes.get_le32(b, 32)
    group_count = bytes.get_le32(b, 36)
    at = 48
    path_length = bytes.get_le32(b, at)
    if at + 4 + path_length > length || string.equals(cache_get_string(raw, at + 4, path_length), absolute) != 1 {
        bytes.free(b)
        return null
    }
    at = at + 4 + path_length
    name_length = bytes.get_le32(b, at)
    model_material = cache_get_string(raw, at + 4, name_length)
    at = at + 4 + name_length
    libs_length = bytes.get_le32(b, at)
    mtllibs = cache_get_string(raw, at + 4, libs_length)
    at = at + 4 + libs_length

    m = core.model_new()
    core.model_set_source_path(m, path)
    base_name = basename_of(path)
    core.model_set_name(m, base_name)
    string.free(base_name)
    materials = list.new()
    if libs_length > 0 {
        base = directory_of(path)
        names = string.split(mtllibs, "\n")
        i = 0
        while i < string.array_size(names) {
            mtl_path = string.concat(base, field(names, i))
            loaded = load_mtl(mtl_path)
            string.free(mtl_path)
            merge_materials(materials, loaded)
            list.free(loaded)
            i = i + 1
        }
        string.array_free(names)
        string.free(base)
    }
    g = 0
    while g < group_count {
        start = bytes.get_le32(b, at)
        count = bytes.get_le32(b, at + 4)
        group_length = bytes.get_le32(b, at + 8)
        core.model_add_group(m, find_material(materials, cache_get_string(raw, at + 12, group_length)), start, count)
        at = at + 12 + group_length
        g = g + 1
    }
    if at + vertex_count * 36 + index_count * 4 > length {
        bytes.free(b)
        materials_free(materials)
        core.model_free(m)
        return null
    }
    geometry.mesh_append_raw(m.mesh, raw + at, vertex_count, raw + at + vertex_count * 36, index_count)
    bytes.free(b)
    if name_length > 0 { m.material = find_material(materials, model_material) }
    if core.model_group_count(m) == 0 && m.material == null && list.size(materials) > 0 {
        m.material = list.get_raw(materials, 0) as *Material
    }
    owned = list.size(materials)
    i = 0
    while i < owned {
        core.model_own_material(m, list.get_raw(materials, i) as *Material)
        i = i + 1
    }
    list.free(materials)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

load_obj(path: string, recalculate_normals: bool) -> *Model {
    return load_obj_skinned(path, recalculate_normals, null)
}

// The same load, with weights. A loaded mesh has more vertices than the OBJ has
// positions -- a position with two normals across a hard edge is two vertices,
// and only this knows which -- so the weights arrive keyed by position and are
// written onto each vertex as it is emitted. A null skin loads exactly as
// load_obj always did and touches nothing.
load_obj_skinned(path: string, recalculate_normals: bool, skin: ptr) -> *Model {
    return load_obj_baked(path, recalculate_normals, skin, null)
}

// The same load, with what was baked against the scene: weights, and how much
// of the sky each position can see. Both arrive keyed by position, because a
// position becomes as many vertices as it has distinct normals and UVs and
// only this knows which.
load_obj_baked(path: string, recalculate_normals: bool, skin: ptr,
               occlusion: ptr) -> *Model {
    // The cache first, for a load that only a parse's geometry makes.
    cache = ""
    absolute = ""
    parse_began = 0 as long
    if skin == null && occlusion == null && cache_dir() != "" {
        absolute = absolute_of(path)
        cache = cache_file(absolute)
        // Only a source with a cache file is asked its size and time here;
        // one without is parsed, and the writer asks.
        if set.contains(g_cache_names, cache) {
            _kind, size_read, time_read, why = fs.file_stat(path)
            if why == "" {
                cached = cache_read(cache, path, absolute, size_read, time_read, recalculate_normals)
                if cached != null {
                    g_cache_hits = g_cache_hits + 1
                    string.free(cache)
                    string.free(absolute)
                    return cached
                }
            }
        }
        parse_began = os.wall_seconds()
    }
    mtllibs = ""
    content, err = fs.read(path)
    if err != "" {
        set_error("cannot read ", path)
        string.free(content)
        if cache != "" { string.free(cache) ; string.free(absolute) }
        return null
    }

    m = core.model_new()
    core.model_set_source_path(m, path)
    base_name = basename_of(path)
    core.model_set_name(m, base_name)
    string.free(base_name)
    build = objbuild_create()
    if build == null {
        set_error("out of memory loading ", path)
        string.free(content)
        core.model_free(m)
        if cache != "" { string.free(cache) ; string.free(absolute) }
        return null
    }

    build.skin = skin
    build.occlusion = occlusion

    materials = list.new()
    positions = 0
    uvs = 0
    normals = 0
    group_start = 0
    group_material = null as *Material
    have_group = false

    // The file is read line by line where it lies: a line is the span up to
    // the next newline, and only one the general path takes becomes a string
    // of its own. Splitting the file first made a string of every line, most
    // of the allocations an OBJ cost.
    content_length = string.length(content)
    line_start = 0
    while line_start < content_length {
        line_end = string.index_of_from(content, "\n", line_start)
        if line_end < 0 { line_end = content_length }
        here = line_start
        line_start = line_end + 1
        // The geometry lines, read where they lie.
        g_at = here
        skip_blanks(content, line_end)
        if g_at >= line_end { continue }
        c0 = string.char_at(content, g_at)
        if c0 == 35 { continue }
        c1 = 0
        if g_at + 1 < line_end { c1 = string.char_at(content, g_at + 1) }
        c2 = 0
        if g_at + 2 < line_end { c2 = string.char_at(content, g_at + 2) }
        if c0 == 118 && is_blank(c1) {
            g_at = g_at + 1
            if fields_ahead(content, line_end) < 3 { continue }
            x = next_float(content, line_end)
            y = next_float(content, line_end)
            z = next_float(content, line_end)
            objbuild_add_position(build, x, y, z)
            positions = positions + 1
            continue
        }
        if c0 == 118 && c1 == 116 && is_blank(c2) {
            g_at = g_at + 2
            if fields_ahead(content, line_end) < 2 { continue }
            u = next_float(content, line_end)
            v = next_float(content, line_end)
            objbuild_add_uv(build, u, v)
            uvs = uvs + 1
            continue
        }
        if c0 == 118 && c1 == 110 && is_blank(c2) {
            g_at = g_at + 2
            if fields_ahead(content, line_end) < 3 { continue }
            x = next_float(content, line_end)
            y = next_float(content, line_end)
            z = next_float(content, line_end)
            objbuild_add_normal(build, x, y, z)
            normals = normals + 1
            continue
        }
        if c0 == 102 && is_blank(c1) {
            g_at = g_at + 1
            if fields_ahead(content, line_end) < 3 { continue }
            emit_face_line(build as ptr, m.mesh, content, line_end, positions, uvs, normals)
            continue
        }

        raw = string.substring(content, here, line_end)
        line = string.trim(raw)
        string.free(raw)
        if line == "" { continue }
        flattened = split_fields(line)
        fields = string.split(flattened, " ")
        field_count = token_count(fields)
        if field_count == 0 { string.array_free(fields) ; string.free(flattened) ; continue }
        keyword = token(fields, 0)

        if string.equals(keyword, "v") == 1 && field_count >= 4 {
            objbuild_add_position(build,
                parse_float(token(fields, 1)),
                parse_float(token(fields, 2)),
                parse_float(token(fields, 3)))
            positions = positions + 1
        } else if string.equals(keyword, "vt") == 1 && field_count >= 3 {
            objbuild_add_uv(build,
                parse_float(token(fields, 1)),
                parse_float(token(fields, 2)))
            uvs = uvs + 1
        } else if string.equals(keyword, "vn") == 1 && field_count >= 4 {
            objbuild_add_normal(build,
                parse_float(token(fields, 1)),
                parse_float(token(fields, 2)),
                parse_float(token(fields, 3)))
            normals = normals + 1
        } else if string.equals(keyword, "f") == 1 && field_count >= 4 {
            emit_face(build as ptr, m.mesh, fields, field_count, positions, uvs, normals)
        } else if string.equals(keyword, "mtllib") == 1 && field_count >= 2 {
            if cache != "" {
                if mtllibs == "" {
                    mtllibs = string.concat(token(fields, 1), "")
                } else {
                    joined = string.concat(mtllibs, "\n")
                    string.free(mtllibs)
                    mtllibs = string.concat(joined, token(fields, 1))
                    string.free(joined)
                }
            }
            base = directory_of(path)
            mtl_path = string.concat(base, token(fields, 1))
            string.free(base)
            loaded = load_mtl(mtl_path)
            string.free(mtl_path)
            merge_materials(materials, loaded)
            list.free(loaded)
        } else if string.equals(keyword, "usemtl") == 1 && field_count >= 2 {
            index_here = core.mesh_index_count(m.mesh)
            if have_group && index_here > group_start {
                core.model_add_group(m, group_material, group_start, index_here - group_start)
            }
            group_material = find_material(materials, token(fields, 1))
            group_start = index_here
            have_group = true
        }
        string.array_free(fields)
        string.free(flattened)
    }

    final_count = core.mesh_index_count(m.mesh)
    if have_group && final_count > group_start {
        if core.model_group_count(m) == 0 && group_start == 0 {
            // One usemtl covering the whole mesh is a material, not a group.
            // A group is a run of faces with a material of its own, and a
            // model with any is drawn on its own: the renderers merge only
            // models whose one material is the model's. Every object an
            // exporter writes has a usemtl line, so without this nothing
            // exported could ever be merged, and a street of bollards cost a
            // draw a bollard.
            m.material = group_material
        } else {
            core.model_add_group(m, group_material, group_start, final_count - group_start)
        }
    }

    string.free(content)
    objbuild_destroy(build)

    if core.mesh_vertex_count(m.mesh) == 0 {
        set_error("no geometry in ", path)
        if cache != "" { string.free(cache) ; string.free(absolute) }
        if mtllibs != "" { string.free(mtllibs) }
        stranded = list.size(materials)
        i = 0
        while i < stranded {
            core.model_own_material(m, list.get_raw(materials, i) as *Material)
            i = i + 1
        }
        list.free(materials)
        core.model_free(m)
        return null
    }

    if recalculate_normals || normals == 0 {
        core.mesh_recalculate_normals(m.mesh)
    }

    if core.model_group_count(m) == 0 && m.material == null && list.size(materials) > 0 {
        m.material = list.get_raw(materials, 0) as *Material
    }

    owned = list.size(materials)
    i = 0
    while i < owned {
        core.model_own_material(m, list.get_raw(materials, i) as *Material)
        i = i + 1
    }
    list.free(materials)

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    if cache != "" {
        cache_write(cache, path, absolute, parse_began, recalculate_normals, m, mtllibs)
        string.free(cache)
        string.free(absolute)
    }
    if mtllibs != "" { string.free(mtllibs) }
    return m
}

merge_materials(target: ptr, source: ptr) {
    count = list.size(source)
    i = 0
    while i < count {
        m = list.get_raw(source, i) as *Material
        if m != null && find_material(target, m.name) == null {
            list.add_raw(target, m)
        }
        i = i + 1
    }
}

// A face with more than three vertices is triangulated as a fan, which is exact
// for the convex polygons OBJ permits.
emit_face(build: ptr, mesh: ptr, fields: ptr, field_count: int,
          positions: int, uvs: int, normals: int) {
    first = 0 - 1
    previous = 0 - 1

    slot = 1
    while slot < field_count {
        reference = token(fields, slot)
        slot = slot + 1
        if string.length(reference) == 0 { continue }

        // The slash-separated parts are read positionally, unlike the
        // whitespace-separated fields: "1//3" means no texture coordinate, and
        // skipping that empty slot would read the normal index as the uv.
        parts = string.split(reference, "/")
        part_count = string.array_size(parts)

        v = parse_index(field(parts, 0), positions)
        vt = 0 - 1
        vn = 0 - 1
        if part_count > 1 { vt = parse_index(field(parts, 1), uvs) }
        if part_count > 2 { vn = parse_index(field(parts, 2), normals) }
        string.array_free(parts)

        if v < 0 { continue }
        unified = objbuild_emit(build as *ObjBuild, mesh, v, vt, vn)
        if unified < 0 { continue }

        if first < 0 {
            first = unified
        } else if previous < 0 {
            previous = unified
        } else {
            core.mesh_push_triangle(mesh, first, previous, unified)
            previous = unified
        }
    }
}

load_obj_instanced(path: string, recalculate_normals: bool, instances: int) -> *Model {
    m = load_obj(path, recalculate_normals)
    if m == null { return null }
    if !core.model_enable_instancing(m, instances) {
        set_error("cannot allocate instances for ", path)
        core.model_free(m)
        return null
    }
    return m
}

// Every flat primitive faces up. Winding them the other way makes a ground plane
// vanish the moment face culling is on, which is the kind of thing that gets
// worked around by turning culling off for the whole scene.
quad(width: float, depth: float) -> *Model {
    m = core.model_new()
    half_w = width * 0.5
    half_d = depth * 0.5
    up = core.vec3(0.0, 1.0, 0.0)

    core.mesh_reserve(m.mesh, 4, 6)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - half_w, 0.0, 0.0 - half_d), 0.0, 0.0, up)
    core.mesh_push_vertex(m.mesh, core.vec3(half_w, 0.0, 0.0 - half_d), 1.0, 0.0, up)
    core.mesh_push_vertex(m.mesh, core.vec3(half_w, 0.0, half_d), 1.0, 1.0, up)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - half_w, 0.0, half_d), 0.0, 1.0, up)
    core.mesh_push_triangle(m.mesh, 0, 2, 1)
    core.mesh_push_triangle(m.mesh, 0, 3, 2)

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// A reference grid built from thin quads rather than lines: a line primitive
// has no thickness in a perspective view, so it shimmers and disappears at
// grazing angles, while a quad behaves like the geometry it sits among.
grid(extent: float, step: float, thickness: float) -> *Model {
    m = core.model_new()
    up = core.vec3(0.0, 1.0, 0.0)
    half = thickness * 0.5

    lines = ((extent * 2.0) / step) as int
    core.mesh_reserve(m.mesh, (lines + 1) * 8, (lines + 1) * 12)

    i = 0
    while i <= lines {
        offset = 0.0 - extent + (i * 1.0) * step

        base = core.mesh_vertex_count(m.mesh)
        core.mesh_push_vertex(m.mesh, core.vec3(0.0 - extent, 0.0, offset - half), 0.0, 0.0, up)
        core.mesh_push_vertex(m.mesh, core.vec3(extent, 0.0, offset - half), 1.0, 0.0, up)
        core.mesh_push_vertex(m.mesh, core.vec3(extent, 0.0, offset + half), 1.0, 1.0, up)
        core.mesh_push_vertex(m.mesh, core.vec3(0.0 - extent, 0.0, offset + half), 0.0, 1.0, up)
        core.mesh_push_triangle(m.mesh, base, base + 2, base + 1)
        core.mesh_push_triangle(m.mesh, base, base + 3, base + 2)

        base = core.mesh_vertex_count(m.mesh)
        core.mesh_push_vertex(m.mesh, core.vec3(offset - half, 0.0, 0.0 - extent), 0.0, 0.0, up)
        core.mesh_push_vertex(m.mesh, core.vec3(offset + half, 0.0, 0.0 - extent), 1.0, 0.0, up)
        core.mesh_push_vertex(m.mesh, core.vec3(offset + half, 0.0, extent), 1.0, 1.0, up)
        core.mesh_push_vertex(m.mesh, core.vec3(offset - half, 0.0, extent), 0.0, 1.0, up)
        core.mesh_push_triangle(m.mesh, base, base + 2, base + 1)
        core.mesh_push_triangle(m.mesh, base, base + 3, base + 2)

        i = i + 1
    }

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// A wireframe box built the same way, used to mark the selected object.
box_outline(thickness: float) -> *Model {
    m = core.model_new()
    up = core.vec3(0.0, 1.0, 0.0)
    h = 0.5
    t = thickness * 0.5

    edge_x(m.mesh, up, 0.0 - h, h, 0.0 - h, 0.0 - h, t)
    edge_x(m.mesh, up, 0.0 - h, h, h, 0.0 - h, t)
    edge_x(m.mesh, up, 0.0 - h, h, 0.0 - h, h, t)
    edge_x(m.mesh, up, 0.0 - h, h, h, h, t)

    edge_z(m.mesh, up, 0.0 - h, h, 0.0 - h, 0.0 - h, t)
    edge_z(m.mesh, up, 0.0 - h, h, h, 0.0 - h, t)
    edge_z(m.mesh, up, 0.0 - h, h, 0.0 - h, h, t)
    edge_z(m.mesh, up, 0.0 - h, h, h, h, t)

    edge_y(m.mesh, up, 0.0 - h, h, 0.0 - h, 0.0 - h, t)
    edge_y(m.mesh, up, 0.0 - h, h, h, 0.0 - h, t)
    edge_y(m.mesh, up, 0.0 - h, h, 0.0 - h, h, t)
    edge_y(m.mesh, up, 0.0 - h, h, h, h, t)

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

push_bar(mesh: ptr, up: Vec3, ax: float, ay: float, az: float,
         bx: float, by: float, bz: float, ox: float, oy: float, oz: float) {
    base = core.mesh_vertex_count(mesh)
    core.mesh_push_vertex(mesh, core.vec3(ax - ox, ay - oy, az - oz), 0.0, 0.0, up)
    core.mesh_push_vertex(mesh, core.vec3(bx - ox, by - oy, bz - oz), 1.0, 0.0, up)
    core.mesh_push_vertex(mesh, core.vec3(bx + ox, by + oy, bz + oz), 1.0, 1.0, up)
    core.mesh_push_vertex(mesh, core.vec3(ax + ox, ay + oy, az + oz), 0.0, 1.0, up)
    core.mesh_push_triangle(mesh, base, base + 1, base + 2)
    core.mesh_push_triangle(mesh, base, base + 2, base + 3)
    core.mesh_push_triangle(mesh, base, base + 2, base + 1)
    core.mesh_push_triangle(mesh, base, base + 3, base + 2)
}

edge_x(mesh: ptr, up: Vec3, from: float, to: float, y: float, z: float, t: float) {
    push_bar(mesh, up, from, y, z, to, y, z, 0.0, t, 0.0)
}

edge_y(mesh: ptr, up: Vec3, from: float, to: float, x: float, z: float, t: float) {
    push_bar(mesh, up, x, from, z, x, to, z, t, 0.0, 0.0)
}

edge_z(mesh: ptr, up: Vec3, from: float, to: float, x: float, y: float, t: float) {
    push_bar(mesh, up, x, y, from, x, y, to, t, 0.0, 0.0)
}

cube(size: float) -> *Model {
    m = core.model_new()
    h = size * 0.5
    core.mesh_reserve(m.mesh, 24, 36)

    push_face(m.mesh, core.vec3(0.0 - h, 0.0 - h,  h), core.vec3(h, 0.0 - h,  h),
                      core.vec3(h, h,  h), core.vec3(0.0 - h, h,  h), core.vec3(0.0, 0.0, 1.0))
    push_face(m.mesh, core.vec3(h, 0.0 - h, 0.0 - h), core.vec3(0.0 - h, 0.0 - h, 0.0 - h),
                      core.vec3(0.0 - h, h, 0.0 - h), core.vec3(h, h, 0.0 - h), core.vec3(0.0, 0.0, 0.0 - 1.0))
    push_face(m.mesh, core.vec3(h, 0.0 - h,  h), core.vec3(h, 0.0 - h, 0.0 - h),
                      core.vec3(h, h, 0.0 - h), core.vec3(h, h,  h), core.vec3(1.0, 0.0, 0.0))
    push_face(m.mesh, core.vec3(0.0 - h, 0.0 - h, 0.0 - h), core.vec3(0.0 - h, 0.0 - h,  h),
                      core.vec3(0.0 - h, h,  h), core.vec3(0.0 - h, h, 0.0 - h), core.vec3(0.0 - 1.0, 0.0, 0.0))
    push_face(m.mesh, core.vec3(0.0 - h, h,  h), core.vec3(h, h,  h),
                      core.vec3(h, h, 0.0 - h), core.vec3(0.0 - h, h, 0.0 - h), core.vec3(0.0, 1.0, 0.0))
    push_face(m.mesh, core.vec3(0.0 - h, 0.0 - h, 0.0 - h), core.vec3(h, 0.0 - h, 0.0 - h),
                      core.vec3(h, 0.0 - h,  h), core.vec3(0.0 - h, 0.0 - h,  h), core.vec3(0.0, 0.0 - 1.0, 0.0))

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

push_face(mesh: ptr, a: Vec3, b: Vec3, c: Vec3, d: Vec3, normal: Vec3) {
    base = core.mesh_vertex_count(mesh)
    core.mesh_push_vertex(mesh, a, 0.0, 0.0, normal)
    core.mesh_push_vertex(mesh, b, 1.0, 0.0, normal)
    core.mesh_push_vertex(mesh, c, 1.0, 1.0, normal)
    core.mesh_push_vertex(mesh, d, 0.0, 1.0, normal)
    core.mesh_push_triangle(mesh, base, base + 1, base + 2)
    core.mesh_push_triangle(mesh, base, base + 2, base + 3)
}

sphere(radius: float, segments: int, rings: int) -> *Model {
    m = core.model_new()
    columns = segments
    rows = rings
    if columns < 3 { columns = 3 }
    if rows < 2 { rows = 2 }

    core.mesh_reserve(m.mesh, (rows + 1) * (columns + 1), rows * columns * 6)

    row = 0
    while row <= rows {
        phi = core.PI * (row * 1.0) / (rows * 1.0)
        y = core.cos_of(phi)
        ring_radius = core.sin_of(phi)

        column = 0
        while column <= columns {
            theta = core.TWO_PI * (column * 1.0) / (columns * 1.0)
            x = ring_radius * core.cos_of(theta)
            z = ring_radius * core.sin_of(theta)
            normal = core.vec3(x, y, z)
            core.mesh_push_vertex(m.mesh, core.v3_mul(normal, radius),
                                  (column * 1.0) / (columns * 1.0),
                                  1.0 - (row * 1.0) / (rows * 1.0),
                                  normal)
            column = column + 1
        }
        row = row + 1
    }

    stride = columns + 1
    row = 0
    while row < rows {
        column = 0
        while column < columns {
            top_left = row * stride + column
            top_right = top_left + 1
            bottom_left = top_left + stride
            bottom_right = bottom_left + 1
            core.mesh_push_triangle(m.mesh, top_left, bottom_right, bottom_left)
            core.mesh_push_triangle(m.mesh, top_left, top_right, bottom_right)
            column = column + 1
        }
        row = row + 1
    }

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// A capsule between two centres: a tube of `segments` sides capped by
// hemispheres of `rings` latitude rows each, its axis wherever the two
// centres point. push_capsule adds one to a mesh being built (a bone
// with a shin and a foot is two in one model); capsule is a model of one.
capsule(center1: Vec3, center2: Vec3, radius: float, segments: int, rings: int) -> *Model {
    m = core.model_new()
    push_capsule(m.mesh, center1, center2, radius, segments, rings)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

push_capsule(mesh: ptr, center1: Vec3, center2: Vec3, radius: float, segments: int, rings: int) {
    columns = segments
    if columns < 3 { columns = 3 }
    rows = rings
    if rows < 1 { rows = 1 }
    axis = core.v3_sub(center2, center1)
    length = core.v3_len(axis)
    up = core.vec3(0.0, 1.0, 0.0)
    if length > 0.000001 { up = core.v3_mul(axis, 1.0 / length) }
    // An orthonormal frame about the axis.
    seed = core.vec3(1.0, 0.0, 0.0)
    if core.abs_of(up.x) > 0.9 { seed = core.vec3(0.0, 0.0, 1.0) }
    side = core.v3_normalize(core.v3_cross(up, seed))
    front = core.v3_cross(side, up)
    base = core.mesh_vertex_count(mesh)
    // Latitude rows from the top pole over center2, the equator split at
    // the two centres so the tube is straight, to the bottom pole under
    // center1: 2 * rows + 2 rows of columns + 1 vertices.
    total_rows = 2 * rows + 2
    row = 0
    while row < total_rows {
        // The hemisphere angle: 0 at the pole, pi/2 at the equator.
        cap_row = row
        center = center2
        sign = 1.0
        if row > rows {
            cap_row = total_rows - 1 - row
            center = center1
            sign = 0.0 - 1.0
        }
        phi = core.HALF_PI * (cap_row * 1.0) / (rows * 1.0)
        ring_radius = core.sin_of(phi)
        height = core.cos_of(phi) * sign
        column = 0
        while column <= columns {
            theta = core.TWO_PI * (column * 1.0) / (columns * 1.0)
            c = core.cos_of(theta)
            sn = core.sin_of(theta)
            normal = core.v3_add(core.v3_add(core.v3_mul(side, ring_radius * c), core.v3_mul(front, ring_radius * sn)), core.v3_mul(up, height))
            position = core.v3_add(center, core.v3_mul(normal, radius))
            core.mesh_push_vertex(mesh, position, (column * 1.0) / (columns * 1.0), (row * 1.0) / ((total_rows - 1) * 1.0), normal)
            column = column + 1
        }
        row = row + 1
    }
    stride = columns + 1
    row = 0
    while row < total_rows - 1 {
        column = 0
        while column < columns {
            top_left = base + row * stride + column
            top_right = top_left + 1
            bottom_left = top_left + stride
            bottom_right = bottom_left + 1
            core.mesh_push_triangle(mesh, top_left, bottom_right, bottom_left)
            core.mesh_push_triangle(mesh, top_left, top_right, bottom_right)
            column = column + 1
        }
        row = row + 1
    }
}

plane(grid_size: int, spacing: float) -> *Model {
    size = grid_size
    if size < 2 { size = 2 }

    m = core.model_new()
    up = core.vec3(0.0, 1.0, 0.0)
    core.mesh_reserve(m.mesh, size * size, (size - 1) * (size - 1) * 6)

    x = 0
    while x < size {
        z = 0
        while z < size {
            core.mesh_push_vertex(m.mesh,
                core.vec3((x * 1.0) * spacing, 0.0, (z * 1.0) * spacing),
                (x * 1.0) / ((size - 1) * 1.0),
                (z * 1.0) / ((size - 1) * 1.0),
                up)
            z = z + 1
        }
        x = x + 1
    }

    x = 0
    while x < size - 1 {
        z = 0
        while z < size - 1 {
            top_left = x * size + z
            top_right = top_left + 1
            bottom_left = (x + 1) * size + z
            bottom_right = bottom_left + 1
            core.mesh_push_triangle(m.mesh, top_left, bottom_right, bottom_left)
            core.mesh_push_triangle(m.mesh, top_left, top_right, bottom_right)
            z = z + 1
        }
        x = x + 1
    }

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

water_surface(size: float, center_x: float, center_z: float, resolution: int) -> *Model {
    steps = resolution
    if steps < 16 { steps = 16 }
    if steps > 8192 { steps = 8192 }

    m = core.model_new()
    up = core.vec3(0.0, 1.0, 0.0)
    step_size = size / ((steps - 1) * 1.0)
    start_x = center_x - size * 0.5
    start_z = center_z - size * 0.5

    core.mesh_reserve(m.mesh, steps * steps, (steps - 1) * (steps - 1) * 6)

    x = 0
    while x < steps {
        z = 0
        while z < steps {
            core.mesh_push_vertex(m.mesh,
                core.vec3(start_x + (x * 1.0) * step_size, 0.0, start_z + (z * 1.0) * step_size),
                (x * 1.0) / ((steps - 1) * 1.0),
                (z * 1.0) / ((steps - 1) * 1.0),
                up)
            z = z + 1
        }
        x = x + 1
    }

    x = 0
    while x < steps - 1 {
        z = 0
        while z < steps - 1 {
            top_left = x * steps + z
            top_right = top_left + 1
            bottom_left = (x + 1) * steps + z
            bottom_right = bottom_left + 1
            core.mesh_push_triangle(m.mesh, top_left, bottom_right, bottom_left)
            core.mesh_push_triangle(m.mesh, top_left, top_right, bottom_right)
            z = z + 1
        }
        x = x + 1
    }

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}
