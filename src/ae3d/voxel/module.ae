// Voxel worlds rendered as one instanced draw.
//
// Storage is one flat grid rather than Gopher3D's per-chunk 3D slices: the
// instanced path builds a single model for the whole world anyway, so chunking
// bought nothing and cost a pointer chase per voxel. Only voxels with at least
// one exposed face become instances, which is what keeps a solid world from
// paying for its own interior.
//
// The grid is a plain allocation viewed as `int[]` rather than a boxed array:
// the exposed-face scan reads six neighbours per voxel, so on a 192x192x48 world
// that is twenty-one million reads, and they have to be real indexed loads
// rather than calls.

import std.list
import std.heap
import ae3d.core

extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)
extern memset(block: ptr, value: int, bytes: int) -> ptr
extern ae3d_mesh_set_occlusion(mesh: ptr, index: int, value: float)
extern ae3d_image_register(name: string, rgba: ptr, width: int, height: int) -> int
extern ae3d_image_unregister(name: string)
extern ae3d_rgba_set(rgba: ptr, index: int, r: float, g: float, b: float, a: float)

exports (
    VoxelWorld, Palette,
    EMPTY, GRASS, DIRT, STONE, SAND, WOOD, LEAF,
    world_new, world_free,
    world_set, world_get, world_solid, world_in_bounds,
    world_fill_column, world_generate, world_clear,
    world_column_height, world_set_column_height,
    world_active_count, world_visible_count, world_build, world_build_mesh,
    world_palette_texture, PALETTE_KINDS,
    world_size_x, world_size_z, world_max_height, world_voxel_size,
    world_set_origin, world_origin_seed, world_origin_kind, world_set_base_height,
    palette_set, palette_reset, palette_color,
    world_sdf_enable, world_sdf_set, world_sdf_get, world_sdf_from_voxels,
    world_build_surface
)

var g_cell_x = 0.0
var g_cell_y = 0.0
var g_cell_z = 0.0

const EMPTY = 0
const GRASS = 1
const DIRT = 2
const STONE = 3
const SAND = 4
const WOOD = 5
const LEAF = 6

struct Palette {
    id: int
    red: float
    green: float
    blue: float
}

struct VoxelWorld {
    voxels: ptr
    sdf: ptr
    palette: ptr
    size_x: int
    size_z: int
    max_height: int
    voxel_size: float
    active: int

    // How this world was filled, recorded rather than interpreted: whoever
    // filled it says so, and a scene writes it down so the world can be filled
    // the same way again instead of storing a grid it can reproduce.
    origin_seed: long
    origin_kind: int
    // Where the world's floor sits in the scene, in metres: the instances a
    // build places are absolute, so a world lowered under a sea is lowered
    // here and not by moving the model.
    base_y: float
    // The name its palette image is registered under, once it has been.
    palette_name: string
}

var g_palettes_named = 0

world_new(size_x: int, size_z: int, max_height: int, voxel_size: float) -> *VoxelWorld {
    if size_x <= 0 || size_z <= 0 || max_height <= 0 { return null }

    w = heap.new(VoxelWorld)
    w.base_y = 0.0
    w.palette_name = ""
    w.size_x = size_x
    w.size_z = size_z
    w.max_height = max_height
    w.voxel_size = voxel_size
    w.palette = list.new()
    w.voxels = calloc(size_x * max_height * size_z, 4)
    if w.voxels == null {
        list.free(w.palette)
        heap.free(w)
        return null
    }
    return w
}

world_free(w: *VoxelWorld) {
    if w == null { return }
    if w.voxels != null { free(w.voxels) }
    if w.sdf != null { free(w.sdf) }
    if w.palette != null {
        count = list.size(w.palette)
        i = 0
        while i < count {
            entry = list.get_raw(w.palette, i) as *Palette
            if entry != null { heap.free(entry) }
            i = i + 1
        }
        list.free(w.palette)
    }
    heap.free(w)
}

world_size_x(w: *VoxelWorld) -> int { return w.size_x }
world_size_z(w: *VoxelWorld) -> int { return w.size_z }
world_max_height(w: *VoxelWorld) -> int { return w.max_height }
world_voxel_size(w: *VoxelWorld) -> float { return w.voxel_size }
world_active_count(w: *VoxelWorld) -> int { return w.active }

world_in_bounds(w: *VoxelWorld, x: int, y: int, z: int) -> bool {
    return x >= 0 && y >= 0 && z >= 0 && x < w.size_x && y < w.max_height && z < w.size_z
}

// Index so that a column of constant (x, z) is contiguous: terrain generation
// and the exposed-face scan both walk y innermost.
voxel_index(w: *VoxelWorld, x: int, y: int, z: int) -> int {
    return (x * w.size_z + z) * w.max_height + y
}

world_get(w: *VoxelWorld, x: int, y: int, z: int) -> int {
    if !world_in_bounds(w, x, y, z) { return EMPTY }
    data = w.voxels as int[]
    return data[voxel_index(w, x, y, z)]
}

world_solid(w: *VoxelWorld, x: int, y: int, z: int) -> bool {
    if !world_in_bounds(w, x, y, z) { return false }
    data = w.voxels as int[]
    return data[voxel_index(w, x, y, z)] != EMPTY
}

world_set(w: *VoxelWorld, x: int, y: int, z: int, id: int) {
    if !world_in_bounds(w, x, y, z) { return }
    data = w.voxels as int[]
    index = voxel_index(w, x, y, z)
    previous = data[index]
    if previous == id { return }

    data[index] = id
    if previous == EMPTY && id != EMPTY { w.active = w.active + 1 }
    if previous != EMPTY && id == EMPTY { w.active = w.active - 1 }
}

world_fill_column(w: *VoxelWorld, x: int, z: int, height: int, id: int) {
    top = height
    if top > w.max_height { top = w.max_height }
    y = 0
    while y < top {
        world_set(w, x, y, z, id)
        y = y + 1
    }
}

// How tall a column stands: one past the highest solid cell, zero for an
// empty column. What a brush reads before it raises or lowers the ground.
world_column_height(w: *VoxelWorld, x: int, z: int) -> int {
    if x < 0 || z < 0 || x >= w.size_x || z >= w.size_z { return 0 }
    y = w.max_height - 1
    while y >= 0 {
        if world_solid(w, x, y, z) { return y + 1 }
        y = y - 1
    }
    return 0
}

// A column made `height` tall. Raised, the new cells take the kind of the
// cell that was the top, so grass stays grass as a hill grows and sand
// stays sand; an empty column grows as dirt. Lowered, the cells above are
// cleared, and what was buried is the top now.
world_set_column_height(w: *VoxelWorld, x: int, z: int, height: int) {
    if x < 0 || z < 0 || x >= w.size_x || z >= w.size_z { return }
    if height < 0 { height = 0 }
    if height > w.max_height { height = w.max_height }
    was = world_column_height(w, x, z)
    if height == was { return }
    if height > was {
        kind = DIRT
        if was > 0 { kind = world_get(w, x, was - 1, z) }
        y = was
        while y < height {
            world_set(w, x, y, z, kind)
            y = y + 1
        }
    } else {
        y = height
        while y < was {
            world_set(w, x, y, z, EMPTY)
            y = y + 1
        }
    }
}

world_clear(w: *VoxelWorld) {
    memset(w.voxels, 0, w.size_x * w.max_height * w.size_z * 4)
    w.active = 0
}

world_generate(w: *VoxelWorld, generator: fn(ptr, int, int, int) -> int, state: ptr) {
    x = 0
    while x < w.size_x {
        z = 0
        while z < w.size_z {
            y = 0
            while y < w.max_height {
                world_set(w, x, y, z, generator(state, x, y, z))
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
}

// Recorded by whatever filled the world, and read back by whatever wants to
// fill another one the same way. The voxel module does not act on either.
world_set_base_height(w: *VoxelWorld, y: float) { w.base_y = y }

world_set_origin(w: *VoxelWorld, seed: long, kind: int) {
    w.origin_seed = seed
    w.origin_kind = kind
}

world_origin_seed(w: *VoxelWorld) -> long { return w.origin_seed }
world_origin_kind(w: *VoxelWorld) -> int { return w.origin_kind }

palette_set(w: *VoxelWorld, id: int, red: float, green: float, blue: float) {
    count = list.size(w.palette)
    i = 0
    while i < count {
        entry = list.get_raw(w.palette, i) as *Palette
        if entry != null && entry.id == id {
            entry.red = red
            entry.green = green
            entry.blue = blue
            return
        }
        i = i + 1
    }
    entry = heap.new(Palette)
    entry.id = id
    entry.red = red
    entry.green = green
    entry.blue = blue
    list.add_raw(w.palette, entry)
}

palette_reset(w: *VoxelWorld) {
    count = list.size(w.palette)
    i = 0
    while i < count {
        entry = list.get_raw(w.palette, i) as *Palette
        if entry != null { heap.free(entry) }
        i = i + 1
    }
    list.clear(w.palette)
}

palette_color(w: *VoxelWorld, id: int) -> Vec3 {
    count = list.size(w.palette)
    i = 0
    while i < count {
        entry = list.get_raw(w.palette, i) as *Palette
        if entry != null && entry.id == id {
            return core.vec3(entry.red, entry.green, entry.blue)
        }
        i = i + 1
    }

    if id == EMPTY { return core.vec3(0.0, 0.0, 0.0) }
    if id == GRASS { return core.vec3(0.3, 0.7, 0.2) }
    if id == DIRT  { return core.vec3(0.6, 0.4, 0.2) }
    if id == STONE { return core.vec3(0.5, 0.5, 0.5) }
    if id == SAND  { return core.vec3(0.9, 0.8, 0.5) }
    if id == WOOD  { return core.vec3(0.4, 0.25, 0.1) }
    if id == LEAF  { return core.vec3(0.2, 0.6, 0.2) }
    return core.vec3(0.8, 0.8, 0.8)
}

// A voxel on the world boundary is always exposed; inside, the six neighbours
// are fixed offsets from the voxel's own index, so the scan needs no coordinate
// arithmetic and no bounds test per neighbour.
exposed_at(data: int[], w: *VoxelWorld, x: int, y: int, z: int, index: int) -> bool {
    if x == 0 || y == 0 || z == 0 { return true }
    if x == w.size_x - 1 || y == w.max_height - 1 || z == w.size_z - 1 { return true }

    column = w.max_height
    plane = w.size_z * column

    if data[index - plane] == EMPTY { return true }
    if data[index + plane] == EMPTY { return true }
    if data[index - column] == EMPTY { return true }
    if data[index + column] == EMPTY { return true }
    if data[index - 1] == EMPTY { return true }
    if data[index + 1] == EMPTY { return true }
    return false
}

world_visible_count(w: *VoxelWorld) -> int {
    data = w.voxels as int[]
    visible = 0
    total = w.size_x * w.size_z * w.max_height
    column = w.max_height
    plane = w.size_z * column

    index = 0
    while index < total {
        if data[index] != EMPTY {
            x = index / plane
            remainder = index - x * plane
            z = remainder / column
            y = remainder - z * column
            if exposed_at(data, w, x, y, z, index) { visible = visible + 1 }
        }
        index = index + 1
    }
    return visible
}

// `base` supplies the geometry every voxel instance draws; it becomes the
// instanced model and the world takes ownership of it.
world_build(w: *VoxelWorld, base: *Model) -> *Model {
    if base == null { return null }

    visible = world_visible_count(w)
    if visible == 0 { return base }

    if !core.model_enable_instancing(base, visible) { return null }
    if !core.model_enable_instance_colors(base) { return null }

    data = w.voxels as int[]
    total = w.size_x * w.size_z * w.max_height
    column = w.max_height
    plane = w.size_z * column

    placed = 0
    index = 0
    while index < total && placed < visible {
        kind = data[index]
        if kind != EMPTY {
            x = index / plane
            remainder = index - x * plane
            z = remainder / column
            y = remainder - z * column
            if exposed_at(data, w, x, y, z, index) {
                core.model_set_instance_position(base, placed,
                    core.vec3((x * 1.0) * w.voxel_size,
                              (y * 1.0) * w.voxel_size + w.base_y,
                              (z * 1.0) * w.voxel_size))
                colour = palette_color(w, kind)
                core.model_set_instance_color(base, placed, colour.x, colour.y, colour.z)
                placed = placed + 1
            }
        }
        index = index + 1
    }

    core.model_recalculate_bounds(base)
    return base
}


// The world as one mesh: only the faces that show, each with the sky it can
// see baked into its corners.
//
// The instanced build draws every exposed voxel as a whole cube, buried faces
// and all, and every cube is lit alike: the one at the lip of a terrace and
// the one at the foot of a cliff. This walks the grid once and emits a quad
// per face whose neighbour is air, so a 384x384 island is a few hundred
// thousand quads and not six times that, and the shadow pass has no buried
// faces to fight over. Each corner carries how much of the sky it can see,
// from the three voxels that crowd it (the two along the face's edges and
// the one on the diagonal), which is the darkening in a crevice and the
// light on an edge that reads as a voxel world rather than a pile of dice.
//
// A mesh has one colour per model, so the kinds are told apart through a
// palette texture the world registers with the image layer: each kind a
// column of it, and every corner of a face at the centre of its kind's
// column, so no filter ever mixes two.

const PALETTE_KINDS = 16
const PALETTE_CELL = 8

// The palette as an image, registered under the world's own name so the
// mesh can be textured with it by both backends, and rewritten by the next
// build if the palette changed in between.
world_palette_texture(w: *VoxelWorld) -> string {
    if w.palette_name == "" {
        g_palettes_named = g_palettes_named + 1
        w.palette_name = "ae3d://voxel-palette/${g_palettes_named}"
    }
    name = w.palette_name
    pixels = calloc(PALETTE_KINDS * PALETTE_CELL * PALETTE_CELL * 4, 1)
    if pixels == null { return "" }
    kind = 0
    while kind < PALETTE_KINDS {
        colour = palette_color(w, kind)
        row = 0
        while row < PALETTE_CELL {
            column = 0
            while column < PALETTE_CELL {
                ae3d_rgba_set(pixels, row * PALETTE_KINDS * PALETTE_CELL + kind * PALETTE_CELL + column,
                              colour.x, colour.y, colour.z, 1.0)
                column = column + 1
            }
            row = row + 1
        }
        kind = kind + 1
    }
    ok = ae3d_image_register(name, pixels, PALETTE_KINDS * PALETTE_CELL, PALETTE_CELL) == 1
    free(pixels)
    if !ok { return "" }
    return name
}

// Whether a voxel is there, with the world's edges as air and the ground
// under it as rock, so the sides of the block show and its underside does not.
filled(data: int[], w: *VoxelWorld, x: int, y: int, z: int) -> bool {
    if y < 0 { return true }
    if x < 0 || z < 0 || y >= w.max_height || x >= w.size_x || z >= w.size_z { return false }
    return data[(x * w.size_z + z) * w.max_height + y] != EMPTY
}

// How much sky a face's corner sees, 0..3, from the three voxels beside it
// on the face's own side: the two along its edges and the diagonal one.
// Both edge voxels present is a corner the diagonal cannot open further.
corner_sky(data: int[], w: *VoxelWorld, x: int, y: int, z: int,
           ux: int, uy: int, uz: int, vx: int, vy: int, vz: int) -> int {
    side_u = 0
    if filled(data, w, x + ux, y + uy, z + uz) { side_u = 1 }
    side_v = 0
    if filled(data, w, x + vx, y + vy, z + vz) { side_v = 1 }
    if side_u == 1 && side_v == 1 { return 0 }
    diagonal = 0
    if filled(data, w, x + ux + vx, y + uy + vy, z + uz + vz) { diagonal = 1 }
    return 3 - side_u - side_v - diagonal
}

// Three of four neighbours open is full daylight; a corner with none open
// keeps under half of it, which is as dark as a crevice a voxel wide gets.
sky_to_light(sky: int) -> float {
    return 0.45 + 0.55 * (sky as float) / 3.0
}

// One face of one voxel: four corners, their sky, and the two triangles
// laid across the diagonal that keeps the lighter pair together, so the
// shading does not streak one way along a run of faces. The tangents u and
// v are positive axes; the face's low corner is the voxel's own, pushed to
// its far side where the normal is positive.
emit_face(m: *Model, data: int[], w: *VoxelWorld, x: int, y: int, z: int, kind: int,
          nx: int, ny: int, nz: int, ux: int, uy: int, uz: int, vx: int, vy: int, vz: int) {
    size = w.voxel_size
    normal = core.vec3(nx as float, ny as float, nz as float)
    u = ((kind as float) + 0.5) / (PALETTE_KINDS as float)
    ox = (x as float) * size
    oy = (y as float) * size + w.base_y
    oz = (z as float) * size
    if nx > 0 { ox = ox + size }
    if ny > 0 { oy = oy + size }
    if nz > 0 { oz = oz + size }
    // The air voxel the face looks into, where its corner neighbours are.
    ax = x + nx
    ay = y + ny
    az = z + nz

    sky0 = corner_sky(data, w, ax, ay, az, 0 - ux, 0 - uy, 0 - uz, 0 - vx, 0 - vy, 0 - vz)
    sky1 = corner_sky(data, w, ax, ay, az, ux, uy, uz, 0 - vx, 0 - vy, 0 - vz)
    sky2 = corner_sky(data, w, ax, ay, az, ux, uy, uz, vx, vy, vz)
    sky3 = corner_sky(data, w, ax, ay, az, 0 - ux, 0 - uy, 0 - uz, vx, vy, vz)

    a = core.mesh_push_vertex(m.mesh, core.vec3(ox, oy, oz), u, 0.5, normal)
    b = core.mesh_push_vertex(m.mesh, core.vec3(ox + (ux as float) * size, oy + (uy as float) * size, oz + (uz as float) * size), u, 0.5, normal)
    c = core.mesh_push_vertex(m.mesh, core.vec3(ox + ((ux + vx) as float) * size, oy + ((uy + vy) as float) * size, oz + ((uz + vz) as float) * size), u, 0.5, normal)
    d = core.mesh_push_vertex(m.mesh, core.vec3(ox + (vx as float) * size, oy + (vy as float) * size, oz + (vz as float) * size), u, 0.5, normal)
    ae3d_mesh_set_occlusion(m.mesh, a, sky_to_light(sky0))
    ae3d_mesh_set_occlusion(m.mesh, b, sky_to_light(sky1))
    ae3d_mesh_set_occlusion(m.mesh, c, sky_to_light(sky2))
    ae3d_mesh_set_occlusion(m.mesh, d, sky_to_light(sky3))

    // Wound so the triangles face along the normal: u then v runs counter-
    // clockwise seen from u x v, so where that is against the normal asked
    // the order turns.
    flip = (uy * vz - uz * vy) * nx + (uz * vx - ux * vz) * ny + (ux * vy - uy * vx) * nz < 0
    if sky0 + sky2 > sky1 + sky3 {
        if flip {
            core.mesh_push_triangle(m.mesh, a, c, b)
            core.mesh_push_triangle(m.mesh, a, d, c)
        } else {
            core.mesh_push_triangle(m.mesh, a, b, c)
            core.mesh_push_triangle(m.mesh, a, c, d)
        }
    } else {
        if flip {
            core.mesh_push_triangle(m.mesh, b, d, c)
            core.mesh_push_triangle(m.mesh, b, a, d)
        } else {
            core.mesh_push_triangle(m.mesh, b, c, d)
            core.mesh_push_triangle(m.mesh, b, d, a)
        }
    }
}

// The faces the world shows, as one mesh with the palette for its texture,
// or null when the world is empty or the memory is not there.
world_build_mesh(w: *VoxelWorld) -> *Model {
    data = w.voxels as int[]
    total = w.size_x * w.size_z * w.max_height
    column = w.max_height
    plane = w.size_z * column

    // Count first so the mesh is reserved once: a face per side whose
    // neighbour is air, the underside of the bottom row never.
    faces = 0
    index = 0
    while index < total {
        if data[index] != EMPTY {
            x = index / plane
            remainder = index - x * plane
            z = remainder / column
            y = remainder - z * column
            if !filled(data, w, x + 1, y, z) { faces = faces + 1 }
            if !filled(data, w, x - 1, y, z) { faces = faces + 1 }
            if !filled(data, w, x, y + 1, z) { faces = faces + 1 }
            if !filled(data, w, x, y - 1, z) { faces = faces + 1 }
            if !filled(data, w, x, y, z + 1) { faces = faces + 1 }
            if !filled(data, w, x, y, z - 1) { faces = faces + 1 }
        }
        index = index + 1
    }
    if faces == 0 { return null }

    m = core.model_new()
    if !core.mesh_reserve(m.mesh, faces * 4, faces * 6) {
        core.model_free(m)
        return null
    }
    index = 0
    while index < total {
        kind = data[index]
        if kind != EMPTY {
            x = index / plane
            remainder = index - x * plane
            z = remainder / column
            y = remainder - z * column
            if !filled(data, w, x + 1, y, z) { emit_face(m, data, w, x, y, z, kind, 1, 0, 0, 0, 0, 1, 0, 1, 0) }
            if !filled(data, w, x - 1, y, z) { emit_face(m, data, w, x, y, z, kind, 0 - 1, 0, 0, 0, 0, 1, 0, 1, 0) }
            if !filled(data, w, x, y + 1, z) { emit_face(m, data, w, x, y, z, kind, 0, 1, 0, 1, 0, 0, 0, 0, 1) }
            if !filled(data, w, x, y - 1, z) { emit_face(m, data, w, x, y, z, kind, 0, 0 - 1, 0, 1, 0, 0, 0, 0, 1) }
            if !filled(data, w, x, y, z + 1) { emit_face(m, data, w, x, y, z, kind, 0, 0, 1, 1, 0, 0, 0, 1, 0) }
            if !filled(data, w, x, y, z - 1) { emit_face(m, data, w, x, y, z, kind, 0, 0, 0 - 1, 1, 0, 0, 0, 1, 0) }
        }
        index = index + 1
    }

    palette = world_palette_texture(w)
    if palette != "" { core.model_set_texture(m, palette) }
    core.model_set_diffuse(m, 1.0, 1.0, 1.0)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// Surface nets over a signed distance field.
//
// Gopher3D carries the pieces of this (corner sampling, edge interpolation, the
// gradient normal) but its surface path only ever emits a height field, so the
// pieces are never reached. This is the algorithm they describe: one vertex per
// cell that straddles the surface, placed at the average of the crossings on
// that cell's edges, and a quad around every grid edge whose ends differ in
// sign. The result is a smooth surface rather than a staircase.

const SDF_OUTSIDE = 1.0

world_sdf_enable(w: *VoxelWorld) -> bool {
    if w.sdf != null { return true }
    total = w.size_x * w.max_height * w.size_z
    w.sdf = calloc(total, 8)
    if w.sdf == null { return false }

    field = w.sdf as float[]
    i = 0
    while i < total {
        field[i] = SDF_OUTSIDE
        i = i + 1
    }
    return true
}

world_sdf_set(w: *VoxelWorld, x: int, y: int, z: int, value: float) {
    if w.sdf == null || !world_in_bounds(w, x, y, z) { return }
    field = w.sdf as float[]
    field[voxel_index(w, x, y, z)] = value
}

world_sdf_get(w: *VoxelWorld, x: int, y: int, z: int) -> float {
    if w.sdf == null || !world_in_bounds(w, x, y, z) { return SDF_OUTSIDE }
    field = w.sdf as float[]
    return field[voxel_index(w, x, y, z)]
}

// A solid voxel is inside the surface and an empty one is outside, which gives a
// coarse field good enough to smooth a blocky world.
world_sdf_from_voxels(w: *VoxelWorld) -> bool {
    if !world_sdf_enable(w) { return false }

    data = w.voxels as int[]
    field = w.sdf as float[]
    total = w.size_x * w.max_height * w.size_z

    i = 0
    while i < total {
        if data[i] == EMPTY {
            field[i] = SDF_OUTSIDE
        } else {
            field[i] = 0.0 - SDF_OUTSIDE
        }
        i = i + 1
    }
    return true
}

inside(value: float) -> bool {
    return value < 0.0
}

// Central differences on the field, which points away from the surface.
surface_normal(w: *VoxelWorld, x: int, y: int, z: int) -> Vec3 {
    dx = world_sdf_get(w, x + 1, y, z) - world_sdf_get(w, x - 1, y, z)
    dy = world_sdf_get(w, x, y + 1, z) - world_sdf_get(w, x, y - 1, z)
    dz = world_sdf_get(w, x, y, z + 1) - world_sdf_get(w, x, y, z - 1)

    normal = core.vec3(dx, dy, dz)
    if core.v3_len(normal) < 0.000001 { return core.vec3(0.0, 1.0, 0.0) }
    return core.v3_normalize(normal)
}

crossing(a: float, b: float) -> float {
    if a == b { return 0.5 }
    t = a / (a - b)
    if t < 0.0 { return 0.0 }
    if t > 1.0 { return 1.0 }
    return t
}

// Averages the crossings on the twelve edges of one cell. Returns false when the
// cell does not straddle the surface.
cell_vertex(w: *VoxelWorld, x: int, y: int, z: int) -> bool {
    corner000 = world_sdf_get(w, x, y, z)
    corner100 = world_sdf_get(w, x + 1, y, z)
    corner010 = world_sdf_get(w, x, y + 1, z)
    corner110 = world_sdf_get(w, x + 1, y + 1, z)
    corner001 = world_sdf_get(w, x, y, z + 1)
    corner101 = world_sdf_get(w, x + 1, y, z + 1)
    corner011 = world_sdf_get(w, x, y + 1, z + 1)
    corner111 = world_sdf_get(w, x + 1, y + 1, z + 1)

    negatives = 0
    if inside(corner000) { negatives = negatives + 1 }
    if inside(corner100) { negatives = negatives + 1 }
    if inside(corner010) { negatives = negatives + 1 }
    if inside(corner110) { negatives = negatives + 1 }
    if inside(corner001) { negatives = negatives + 1 }
    if inside(corner101) { negatives = negatives + 1 }
    if inside(corner011) { negatives = negatives + 1 }
    if inside(corner111) { negatives = negatives + 1 }

    if negatives == 0 || negatives == 8 { return false }

    sum_x = 0.0
    sum_y = 0.0
    sum_z = 0.0
    count = 0

    if inside(corner000) != inside(corner100) {
        sum_x = sum_x + crossing(corner000, corner100)
        count = count + 1
    }
    if inside(corner010) != inside(corner110) {
        sum_x = sum_x + crossing(corner010, corner110)
        sum_y = sum_y + 1.0
        count = count + 1
    }
    if inside(corner001) != inside(corner101) {
        sum_x = sum_x + crossing(corner001, corner101)
        sum_z = sum_z + 1.0
        count = count + 1
    }
    if inside(corner011) != inside(corner111) {
        sum_x = sum_x + crossing(corner011, corner111)
        sum_y = sum_y + 1.0
        sum_z = sum_z + 1.0
        count = count + 1
    }

    if inside(corner000) != inside(corner010) {
        sum_y = sum_y + crossing(corner000, corner010)
        count = count + 1
    }
    if inside(corner100) != inside(corner110) {
        sum_y = sum_y + crossing(corner100, corner110)
        sum_x = sum_x + 1.0
        count = count + 1
    }
    if inside(corner001) != inside(corner011) {
        sum_y = sum_y + crossing(corner001, corner011)
        sum_z = sum_z + 1.0
        count = count + 1
    }
    if inside(corner101) != inside(corner111) {
        sum_y = sum_y + crossing(corner101, corner111)
        sum_x = sum_x + 1.0
        sum_z = sum_z + 1.0
        count = count + 1
    }

    if inside(corner000) != inside(corner001) {
        sum_z = sum_z + crossing(corner000, corner001)
        count = count + 1
    }
    if inside(corner100) != inside(corner101) {
        sum_z = sum_z + crossing(corner100, corner101)
        sum_x = sum_x + 1.0
        count = count + 1
    }
    if inside(corner010) != inside(corner011) {
        sum_z = sum_z + crossing(corner010, corner011)
        sum_y = sum_y + 1.0
        count = count + 1
    }
    if inside(corner110) != inside(corner111) {
        sum_z = sum_z + crossing(corner110, corner111)
        sum_x = sum_x + 1.0
        sum_y = sum_y + 1.0
        count = count + 1
    }

    if count == 0 { return false }

    g_cell_x = (x * 1.0) + sum_x / (count * 1.0)
    g_cell_y = (y * 1.0) + sum_y / (count * 1.0)
    g_cell_z = (z * 1.0) + sum_z / (count * 1.0)
    return true
}

world_build_surface(w: *VoxelWorld) -> *Model {
    if w.sdf == null { return null }

    cells_x = w.size_x - 1
    cells_y = w.max_height - 1
    cells_z = w.size_z - 1
    if cells_x < 1 || cells_y < 1 || cells_z < 1 { return null }

    total_cells = cells_x * cells_y * cells_z
    lookup = calloc(total_cells, 4)
    if lookup == null { return null }
    cells = lookup as int[]

    m = core.model_new()
    plane = cells_y * cells_z

    i = 0
    while i < total_cells {
        cells[i] = 0 - 1
        i = i + 1
    }

    x = 0
    while x < cells_x {
        y = 0
        while y < cells_y {
            z = 0
            while z < cells_z {
                if cell_vertex(w, x, y, z) {
                    position = core.vec3(g_cell_x * w.voxel_size,
                                         g_cell_y * w.voxel_size,
                                         g_cell_z * w.voxel_size)
                    normal = surface_normal(w, x, y, z)
                    // From where the vertex actually sits, not the cell it
                    // sits in: the vertex is the average of the crossings on
                    // the cell's edges, anywhere inside it, and a texture
                    // pinned to the cell's corner was offset from the surface
                    // by up to a cell at every vertex, which notched every
                    // contour of it.
                    u = g_cell_x / (cells_x * 1.0)
                    v = g_cell_z / (cells_z * 1.0)
                    cells[x * plane + y * cells_z + z] =
                        core.mesh_push_vertex(m.mesh, position, u, v, normal)
                }
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }

    emit_quads(w, m, cells, cells_x, cells_y, cells_z)
    free(lookup)

    if core.mesh_vertex_count(m.mesh) == 0 {
        core.model_free(m)
        return null
    }

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// Every grid edge whose ends differ in sign is surrounded by four cells, and
// those four vertices form one quad of the surface. Each axis rings its four
// cells in a fixed order whose natural normal is +x, -y and +z respectively, so
// the y ring flips on the opposite condition to the other two for the whole mesh
// to face outward.
emit_quads(w: *VoxelWorld, m: *Model, cells: int[], cells_x: int, cells_y: int, cells_z: int) {
    plane = cells_y * cells_z

    // Every corner from the first, not the second. A quad around the edge
    // from corner (x, y, z) along one axis is stitched from the four cells
    // around that edge, which lie one cell back along the *other* two axes
    // only -- so an x edge in column 0 is a perfectly good quad, needing
    // nothing at x - 1. Starting all three loops at 1 skipped the first row
    // of faces on every axis, and a field closed at its boundary still
    // meshed to a surface open along the grid's rim: a camera whose ray
    // slipped in through that seam saw the inside of the volume, where every
    // face is a back face and culled, and the terrain example read as hills
    // you could see through.
    x = 0
    while x < cells_x {
        y = 0
        while y < cells_y {
            z = 0
            while z < cells_z {
                here = world_sdf_get(w, x, y, z)

                if y > 0 && z > 0 && inside(here) != inside(world_sdf_get(w, x + 1, y, z)) {
                    a = cells[x * plane + (y - 1) * cells_z + (z - 1)]
                    b = cells[x * plane + y * cells_z + (z - 1)]
                    c = cells[x * plane + y * cells_z + z]
                    d = cells[x * plane + (y - 1) * cells_z + z]
                    push_quad(m, a, b, c, d, !inside(here))
                }

                if x > 0 && z > 0 && inside(here) != inside(world_sdf_get(w, x, y + 1, z)) {
                    a = cells[(x - 1) * plane + y * cells_z + (z - 1)]
                    b = cells[x * plane + y * cells_z + (z - 1)]
                    c = cells[x * plane + y * cells_z + z]
                    d = cells[(x - 1) * plane + y * cells_z + z]
                    push_quad(m, a, b, c, d, inside(here))
                }

                if x > 0 && y > 0 && inside(here) != inside(world_sdf_get(w, x, y, z + 1)) {
                    a = cells[(x - 1) * plane + (y - 1) * cells_z + z]
                    b = cells[x * plane + (y - 1) * cells_z + z]
                    c = cells[x * plane + y * cells_z + z]
                    d = cells[(x - 1) * plane + y * cells_z + z]
                    push_quad(m, a, b, c, d, !inside(here))
                }

                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
}

push_quad(m: *Model, a: int, b: int, c: int, d: int, flip: bool) {
    if a < 0 || b < 0 || c < 0 || d < 0 { return }
    if flip {
        core.mesh_push_triangle(m.mesh, a, d, c)
        core.mesh_push_triangle(m.mesh, a, c, b)
    } else {
        core.mesh_push_triangle(m.mesh, a, b, c)
        core.mesh_push_triangle(m.mesh, a, c, d)
    }
}
