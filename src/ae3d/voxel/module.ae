// Voxel worlds rendered as one instanced draw.
//
// Storage is one flat grid rather than Gopher3D's per-chunk 3D slices: the
// instanced path builds a single model for the whole world anyway, so chunking
// bought nothing and cost a pointer chase per voxel. Only voxels with at least
// one exposed face become instances, which is what keeps a solid world from
// paying for its own interior.
//
// The grid is a plain allocation viewed as `int[]` rather than a boxed array:
// the exposed-face scan reads six neighbours per voxel, so on a 192x192x48 world
// that is twenty-one million reads, and they have to be real indexed loads
// rather than calls.

import std.list
import std.heap
import ae3d.core

extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)
extern memset(block: ptr, value: int, bytes: int) -> ptr

exports (
    World, Palette,
    EMPTY, GRASS, DIRT, STONE, SAND, WOOD, LEAF,
    world_new, world_free,
    world_set, world_get, world_solid, world_in_bounds,
    world_fill_column, world_generate, world_clear,
    world_active_count, world_visible_count, world_build,
    world_size_x, world_size_z, world_max_height, world_voxel_size,
    world_set_origin, world_origin_seed, world_origin_kind,
    palette_set, palette_reset, palette_color,
    world_sdf_enable, world_sdf_set, world_sdf_get, world_sdf_from_voxels,
    world_build_surface
)

var g_cell_x = 0.0
var g_cell_y = 0.0
var g_cell_z = 0.0

const EMPTY = 0
const GRASS = 1
const DIRT = 2
const STONE = 3
const SAND = 4
const WOOD = 5
const LEAF = 6

struct Palette {
    id: int
    red: float
    green: float
    blue: float
}

struct World {
    voxels: ptr
    sdf: ptr
    palette: ptr
    size_x: int
    size_z: int
    max_height: int
    voxel_size: float
    active: int

    // How this world was filled, recorded rather than interpreted: whoever
    // filled it says so, and a scene writes it down so the world can be filled
    // the same way again instead of storing a grid it can reproduce.
    origin_seed: long
    origin_kind: int
}

world_new(size_x: int, size_z: int, max_height: int, voxel_size: float) -> *World {
    if size_x <= 0 || size_z <= 0 || max_height <= 0 { return null }

    w = heap.new(World)
    w.size_x = size_x
    w.size_z = size_z
    w.max_height = max_height
    w.voxel_size = voxel_size
    w.palette = list.new()
    w.voxels = calloc(size_x * max_height * size_z, 4)
    if w.voxels == null {
        list.free(w.palette)
        heap.free(w)
        return null
    }
    return w
}

world_free(w: *World) {
    if w == null { return }
    if w.voxels != null { free(w.voxels) }
    if w.sdf != null { free(w.sdf) }
    if w.palette != null {
        count = list.size(w.palette)
        i = 0
        while i < count {
            entry = list.get_raw(w.palette, i) as *Palette
            if entry != null { heap.free(entry) }
            i = i + 1
        }
        list.free(w.palette)
    }
    heap.free(w)
}

world_size_x(w: *World) -> int { return w.size_x }
world_size_z(w: *World) -> int { return w.size_z }
world_max_height(w: *World) -> int { return w.max_height }
world_voxel_size(w: *World) -> float { return w.voxel_size }
world_active_count(w: *World) -> int { return w.active }

world_in_bounds(w: *World, x: int, y: int, z: int) -> bool {
    return x >= 0 && y >= 0 && z >= 0 && x < w.size_x && y < w.max_height && z < w.size_z
}

// Index so that a column of constant (x, z) is contiguous: terrain generation
// and the exposed-face scan both walk y innermost.
voxel_index(w: *World, x: int, y: int, z: int) -> int {
    return (x * w.size_z + z) * w.max_height + y
}

world_get(w: *World, x: int, y: int, z: int) -> int {
    if !world_in_bounds(w, x, y, z) { return EMPTY }
    data = w.voxels as int[]
    return data[voxel_index(w, x, y, z)]
}

world_solid(w: *World, x: int, y: int, z: int) -> bool {
    if !world_in_bounds(w, x, y, z) { return false }
    data = w.voxels as int[]
    return data[voxel_index(w, x, y, z)] != EMPTY
}

world_set(w: *World, x: int, y: int, z: int, id: int) {
    if !world_in_bounds(w, x, y, z) { return }
    data = w.voxels as int[]
    index = voxel_index(w, x, y, z)
    previous = data[index]
    if previous == id { return }

    data[index] = id
    if previous == EMPTY && id != EMPTY { w.active = w.active + 1 }
    if previous != EMPTY && id == EMPTY { w.active = w.active - 1 }
}

world_fill_column(w: *World, x: int, z: int, height: int, id: int) {
    top = height
    if top > w.max_height { top = w.max_height }
    y = 0
    while y < top {
        world_set(w, x, y, z, id)
        y = y + 1
    }
}

world_clear(w: *World) {
    memset(w.voxels, 0, w.size_x * w.max_height * w.size_z * 4)
    w.active = 0
}

world_generate(w: *World, generator: fn(ptr, int, int, int) -> int, state: ptr) {
    x = 0
    while x < w.size_x {
        z = 0
        while z < w.size_z {
            y = 0
            while y < w.max_height {
                world_set(w, x, y, z, generator(state, x, y, z))
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
}

// Recorded by whatever filled the world, and read back by whatever wants to
// fill another one the same way. The voxel module does not act on either.
world_set_origin(w: *World, seed: long, kind: int) {
    w.origin_seed = seed
    w.origin_kind = kind
}

world_origin_seed(w: *World) -> long { return w.origin_seed }
world_origin_kind(w: *World) -> int { return w.origin_kind }

palette_set(w: *World, id: int, red: float, green: float, blue: float) {
    count = list.size(w.palette)
    i = 0
    while i < count {
        entry = list.get_raw(w.palette, i) as *Palette
        if entry != null && entry.id == id {
            entry.red = red
            entry.green = green
            entry.blue = blue
            return
        }
        i = i + 1
    }
    entry = heap.new(Palette)
    entry.id = id
    entry.red = red
    entry.green = green
    entry.blue = blue
    list.add_raw(w.palette, entry)
}

palette_reset(w: *World) {
    count = list.size(w.palette)
    i = 0
    while i < count {
        entry = list.get_raw(w.palette, i) as *Palette
        if entry != null { heap.free(entry) }
        i = i + 1
    }
    list.clear(w.palette)
}

palette_color(w: *World, id: int) -> Vec3 {
    count = list.size(w.palette)
    i = 0
    while i < count {
        entry = list.get_raw(w.palette, i) as *Palette
        if entry != null && entry.id == id {
            return core.vec3(entry.red, entry.green, entry.blue)
        }
        i = i + 1
    }

    if id == EMPTY { return core.vec3(0.0, 0.0, 0.0) }
    if id == GRASS { return core.vec3(0.3, 0.7, 0.2) }
    if id == DIRT  { return core.vec3(0.6, 0.4, 0.2) }
    if id == STONE { return core.vec3(0.5, 0.5, 0.5) }
    if id == SAND  { return core.vec3(0.9, 0.8, 0.5) }
    if id == WOOD  { return core.vec3(0.4, 0.25, 0.1) }
    if id == LEAF  { return core.vec3(0.2, 0.6, 0.2) }
    return core.vec3(0.8, 0.8, 0.8)
}

// A voxel on the world boundary is always exposed; inside, the six neighbours
// are fixed offsets from the voxel's own index, so the scan needs no coordinate
// arithmetic and no bounds test per neighbour.
exposed_at(data: int[], w: *World, x: int, y: int, z: int, index: int) -> bool {
    if x == 0 || y == 0 || z == 0 { return true }
    if x == w.size_x - 1 || y == w.max_height - 1 || z == w.size_z - 1 { return true }

    column = w.max_height
    plane = w.size_z * column

    if data[index - plane] == EMPTY { return true }
    if data[index + plane] == EMPTY { return true }
    if data[index - column] == EMPTY { return true }
    if data[index + column] == EMPTY { return true }
    if data[index - 1] == EMPTY { return true }
    if data[index + 1] == EMPTY { return true }
    return false
}

world_visible_count(w: *World) -> int {
    data = w.voxels as int[]
    visible = 0
    total = w.size_x * w.size_z * w.max_height
    column = w.max_height
    plane = w.size_z * column

    index = 0
    while index < total {
        if data[index] != EMPTY {
            x = index / plane
            remainder = index - x * plane
            z = remainder / column
            y = remainder - z * column
            if exposed_at(data, w, x, y, z, index) { visible = visible + 1 }
        }
        index = index + 1
    }
    return visible
}

// `base` supplies the geometry every voxel instance draws; it becomes the
// instanced model and the world takes ownership of it.
world_build(w: *World, base: *Model) -> *Model {
    if base == null { return null }

    visible = world_visible_count(w)
    if visible == 0 { return base }

    if !core.model_enable_instancing(base, visible) { return null }
    if !core.model_enable_instance_colors(base) { return null }

    data = w.voxels as int[]
    total = w.size_x * w.size_z * w.max_height
    column = w.max_height
    plane = w.size_z * column

    placed = 0
    index = 0
    while index < total && placed < visible {
        kind = data[index]
        if kind != EMPTY {
            x = index / plane
            remainder = index - x * plane
            z = remainder / column
            y = remainder - z * column
            if exposed_at(data, w, x, y, z, index) {
                core.model_set_instance_position(base, placed,
                    core.vec3((x * 1.0) * w.voxel_size,
                              (y * 1.0) * w.voxel_size,
                              (z * 1.0) * w.voxel_size))
                colour = palette_color(w, kind)
                core.model_set_instance_color(base, placed, colour.x, colour.y, colour.z)
                placed = placed + 1
            }
        }
        index = index + 1
    }

    core.model_recalculate_bounds(base)
    return base
}


// Surface nets over a signed distance field.
//
// Gopher3D carries the pieces of this (corner sampling, edge interpolation, the
// gradient normal) but its surface path only ever emits a height field, so the
// pieces are never reached. This is the algorithm they describe: one vertex per
// cell that straddles the surface, placed at the average of the crossings on
// that cell's edges, and a quad around every grid edge whose ends differ in
// sign. The result is a smooth surface rather than a staircase.

const SDF_OUTSIDE = 1.0

world_sdf_enable(w: *World) -> bool {
    if w.sdf != null { return true }
    total = w.size_x * w.max_height * w.size_z
    w.sdf = calloc(total, 8)
    if w.sdf == null { return false }

    field = w.sdf as float[]
    i = 0
    while i < total {
        field[i] = SDF_OUTSIDE
        i = i + 1
    }
    return true
}

world_sdf_set(w: *World, x: int, y: int, z: int, value: float) {
    if w.sdf == null || !world_in_bounds(w, x, y, z) { return }
    field = w.sdf as float[]
    field[voxel_index(w, x, y, z)] = value
}

world_sdf_get(w: *World, x: int, y: int, z: int) -> float {
    if w.sdf == null || !world_in_bounds(w, x, y, z) { return SDF_OUTSIDE }
    field = w.sdf as float[]
    return field[voxel_index(w, x, y, z)]
}

// A solid voxel is inside the surface and an empty one is outside, which gives a
// coarse field good enough to smooth a blocky world.
world_sdf_from_voxels(w: *World) -> bool {
    if !world_sdf_enable(w) { return false }

    data = w.voxels as int[]
    field = w.sdf as float[]
    total = w.size_x * w.max_height * w.size_z

    i = 0
    while i < total {
        if data[i] == EMPTY {
            field[i] = SDF_OUTSIDE
        } else {
            field[i] = 0.0 - SDF_OUTSIDE
        }
        i = i + 1
    }
    return true
}

inside(value: float) -> bool {
    return value < 0.0
}

// Central differences on the field, which points away from the surface.
surface_normal(w: *World, x: int, y: int, z: int) -> Vec3 {
    dx = world_sdf_get(w, x + 1, y, z) - world_sdf_get(w, x - 1, y, z)
    dy = world_sdf_get(w, x, y + 1, z) - world_sdf_get(w, x, y - 1, z)
    dz = world_sdf_get(w, x, y, z + 1) - world_sdf_get(w, x, y, z - 1)

    normal = core.vec3(dx, dy, dz)
    if core.v3_len(normal) < 0.000001 { return core.vec3(0.0, 1.0, 0.0) }
    return core.v3_normalize(normal)
}

crossing(a: float, b: float) -> float {
    if a == b { return 0.5 }
    t = a / (a - b)
    if t < 0.0 { return 0.0 }
    if t > 1.0 { return 1.0 }
    return t
}

// Averages the crossings on the twelve edges of one cell. Returns false when the
// cell does not straddle the surface.
cell_vertex(w: *World, x: int, y: int, z: int) -> bool {
    corner000 = world_sdf_get(w, x, y, z)
    corner100 = world_sdf_get(w, x + 1, y, z)
    corner010 = world_sdf_get(w, x, y + 1, z)
    corner110 = world_sdf_get(w, x + 1, y + 1, z)
    corner001 = world_sdf_get(w, x, y, z + 1)
    corner101 = world_sdf_get(w, x + 1, y, z + 1)
    corner011 = world_sdf_get(w, x, y + 1, z + 1)
    corner111 = world_sdf_get(w, x + 1, y + 1, z + 1)

    negatives = 0
    if inside(corner000) { negatives = negatives + 1 }
    if inside(corner100) { negatives = negatives + 1 }
    if inside(corner010) { negatives = negatives + 1 }
    if inside(corner110) { negatives = negatives + 1 }
    if inside(corner001) { negatives = negatives + 1 }
    if inside(corner101) { negatives = negatives + 1 }
    if inside(corner011) { negatives = negatives + 1 }
    if inside(corner111) { negatives = negatives + 1 }

    if negatives == 0 || negatives == 8 { return false }

    sum_x = 0.0
    sum_y = 0.0
    sum_z = 0.0
    count = 0

    if inside(corner000) != inside(corner100) {
        sum_x = sum_x + crossing(corner000, corner100)
        count = count + 1
    }
    if inside(corner010) != inside(corner110) {
        sum_x = sum_x + crossing(corner010, corner110)
        sum_y = sum_y + 1.0
        count = count + 1
    }
    if inside(corner001) != inside(corner101) {
        sum_x = sum_x + crossing(corner001, corner101)
        sum_z = sum_z + 1.0
        count = count + 1
    }
    if inside(corner011) != inside(corner111) {
        sum_x = sum_x + crossing(corner011, corner111)
        sum_y = sum_y + 1.0
        sum_z = sum_z + 1.0
        count = count + 1
    }

    if inside(corner000) != inside(corner010) {
        sum_y = sum_y + crossing(corner000, corner010)
        count = count + 1
    }
    if inside(corner100) != inside(corner110) {
        sum_y = sum_y + crossing(corner100, corner110)
        sum_x = sum_x + 1.0
        count = count + 1
    }
    if inside(corner001) != inside(corner011) {
        sum_y = sum_y + crossing(corner001, corner011)
        sum_z = sum_z + 1.0
        count = count + 1
    }
    if inside(corner101) != inside(corner111) {
        sum_y = sum_y + crossing(corner101, corner111)
        sum_x = sum_x + 1.0
        sum_z = sum_z + 1.0
        count = count + 1
    }

    if inside(corner000) != inside(corner001) {
        sum_z = sum_z + crossing(corner000, corner001)
        count = count + 1
    }
    if inside(corner100) != inside(corner101) {
        sum_z = sum_z + crossing(corner100, corner101)
        sum_x = sum_x + 1.0
        count = count + 1
    }
    if inside(corner010) != inside(corner011) {
        sum_z = sum_z + crossing(corner010, corner011)
        sum_y = sum_y + 1.0
        count = count + 1
    }
    if inside(corner110) != inside(corner111) {
        sum_z = sum_z + crossing(corner110, corner111)
        sum_x = sum_x + 1.0
        sum_y = sum_y + 1.0
        count = count + 1
    }

    if count == 0 { return false }

    g_cell_x = (x * 1.0) + sum_x / (count * 1.0)
    g_cell_y = (y * 1.0) + sum_y / (count * 1.0)
    g_cell_z = (z * 1.0) + sum_z / (count * 1.0)
    return true
}

world_build_surface(w: *World) -> *Model {
    if w.sdf == null { return null }

    cells_x = w.size_x - 1
    cells_y = w.max_height - 1
    cells_z = w.size_z - 1
    if cells_x < 1 || cells_y < 1 || cells_z < 1 { return null }

    total_cells = cells_x * cells_y * cells_z
    lookup = calloc(total_cells, 4)
    if lookup == null { return null }
    cells = lookup as int[]

    m = core.model_new()
    plane = cells_y * cells_z

    i = 0
    while i < total_cells {
        cells[i] = 0 - 1
        i = i + 1
    }

    x = 0
    while x < cells_x {
        y = 0
        while y < cells_y {
            z = 0
            while z < cells_z {
                if cell_vertex(w, x, y, z) {
                    position = core.vec3(g_cell_x * w.voxel_size,
                                         g_cell_y * w.voxel_size,
                                         g_cell_z * w.voxel_size)
                    normal = core.v3_neg(surface_normal(w, x, y, z))
                    u = (x * 1.0) / (cells_x * 1.0)
                    v = (z * 1.0) / (cells_z * 1.0)
                    cells[x * plane + y * cells_z + z] =
                        core.mesh_push_vertex(m.mesh, position, u, v, normal)
                }
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }

    emit_quads(w, m, cells, cells_x, cells_y, cells_z)
    free(lookup)

    if core.mesh_vertex_count(m.mesh) == 0 {
        core.model_free(m)
        return null
    }

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// Every grid edge whose ends differ in sign is surrounded by four cells, and
// those four vertices form one quad of the surface. Each axis rings its four
// cells in a fixed order whose natural normal is +x, -y and +z respectively, so
// the y ring flips on the opposite condition to the other two for the whole mesh
// to face outward.
emit_quads(w: *World, m: *Model, cells: int[], cells_x: int, cells_y: int, cells_z: int) {
    plane = cells_y * cells_z

    x = 1
    while x < cells_x {
        y = 1
        while y < cells_y {
            z = 1
            while z < cells_z {
                here = world_sdf_get(w, x, y, z)

                if inside(here) != inside(world_sdf_get(w, x + 1, y, z)) {
                    a = cells[x * plane + (y - 1) * cells_z + (z - 1)]
                    b = cells[x * plane + y * cells_z + (z - 1)]
                    c = cells[x * plane + y * cells_z + z]
                    d = cells[x * plane + (y - 1) * cells_z + z]
                    push_quad(m, a, b, c, d, !inside(here))
                }

                if inside(here) != inside(world_sdf_get(w, x, y + 1, z)) {
                    a = cells[(x - 1) * plane + y * cells_z + (z - 1)]
                    b = cells[x * plane + y * cells_z + (z - 1)]
                    c = cells[x * plane + y * cells_z + z]
                    d = cells[(x - 1) * plane + y * cells_z + z]
                    push_quad(m, a, b, c, d, inside(here))
                }

                if inside(here) != inside(world_sdf_get(w, x, y, z + 1)) {
                    a = cells[(x - 1) * plane + (y - 1) * cells_z + z]
                    b = cells[x * plane + (y - 1) * cells_z + z]
                    c = cells[x * plane + y * cells_z + z]
                    d = cells[(x - 1) * plane + y * cells_z + z]
                    push_quad(m, a, b, c, d, !inside(here))
                }

                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
}

push_quad(m: *Model, a: int, b: int, c: int, d: int, flip: bool) {
    if a < 0 || b < 0 || c < 0 || d < 0 { return }
    if flip {
        core.mesh_push_triangle(m.mesh, a, d, c)
        core.mesh_push_triangle(m.mesh, a, c, b)
    } else {
        core.mesh_push_triangle(m.mesh, a, b, c)
        core.mesh_push_triangle(m.mesh, a, c, d)
    }
}
