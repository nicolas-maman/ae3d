// The agent channel, engine side: what a request means.
//
// native/ae3d_agent.c owns the socket and hands over whole lines. Every
// request is one JSON object on one line and every answer is another,
// carrying back the id it answers. `help` returns the op table as data.
//
// Imports core, gl and vk but never engine: engine imports this, and the
// dependency runs one way. What it needs from a frame arrives in a Context.

import std.heap
import std.json
import std.string
import std.list
import ae3d.core
import ae3d.gl
import ae3d.skin
import ae3d.vulkan
import ae3d.anim
import ae3d.assets
import ae3d.scene
import ae3d.input
import ae3d.channel
import ae3d.capture
import ae3d.raycast
import ae3d.picture

exports (
    Context, context_new, context_free,
    start, active, port, stop, pump, answer_step, answer_snapshot, answer_capture,
    capture_release, capture_frame, capture_adopt, answer_pending_trace, answer_deferred,
    wants_deferred, clear_deferred, wants_capture, clear_capture,
    answer_capture_unsupported, is_paused,
    schema_json, last_error
)


extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)
extern pow(x: float, y: float) -> float

// A frame can only be read between the last draw and the buffer swap, and
// requests are drained after it. Everything that reads pixels is therefore
// answered a frame late, from the frame that was on screen when the request
// arrived: reading whatever happened to be in the capture buffer answers a
// question about a picture that is no longer there, which is worse than not
// answering at all.
const READ_PIXEL = 0
const READ_REGION = 1
const READ_HOLD = 2
const READ_DIFF = 3
const READ_GRID = 4
const READ_SKELETON = 5

// A grid fine enough that a silhouette is legible in it and coarse enough to
// fit in one reply. 64 by 36 is 2304 cells, which is a frame a person could
// read and a program certainly can.
const GRID_LIMIT = 4096

struct Deferred {
    kind: int
    id: int
    x: int
    y: int
    width: int
    height: int
    background: int
    tolerance: int
    // A grid reads a window of the frame at a resolution of its own, so it
    // needs both: where to look and how finely.
    columns: int
    rows: int
    // What the read is about, for the reads that are about something.
    subject: ptr
}

struct Context {
    camera: ptr
    light: ptr
    // The engine's input service, for an agent that plays: keys, mouse
    // buttons, pad buttons and sticks pressed over the channel.
    input: ptr
    gl_renderer: ptr
    animations: ptr
    vk_renderer: ptr
    backend: string
    // The scene's per-frame pose solve (IK, head tracking), and what to hand
    // it. anim.track replays a pose exactly as a drawn frame builds it, which
    // means running this on top of the clips at each sampled time.
    on_pose: fn(ptr)
    // What the engine's systems record of the models beside what the
    // renderer draws (a body on each that has one), for scene.save.
    on_attachments: fn(ptr) -> ptr
    user_data: ptr

    frame_count: int
    fps: float
    render_ms: float
    shadow_ms: float
    scene_ms: float
    post_ms: float
    cpu_work_ms: float
    post_active: bool
    device: string
    program_binds: int
    material_binds: int
    texture_binds: int
    triangles: int
    delta: float
    width: int
    height: int
    draw_calls: int
    instances: int

    want_stop: bool
    want_snapshot: string
    want_steps: int
    want_pause: bool
    want_resume: bool

    pending_step_id: int
    pending_snapshot_id: int
    pending_capture_id: int
    pending_trace_id: int
    pending_trace_model: ptr
    pending_explain_id: int
    pending_explain_model: ptr
    want_capture: bool
    want_deferred: bool
    step_from: int
    paused: bool
    shadows: bool
    shadow_map: int
    light_count: int
    fog_enabled: bool
    // The exposure the frame was drawn at over every material's: 1, or
    // what the eye adaptation has steered it to (engine_frame_exposure).
    frame_exposure: float
    eye_adaptation: bool

    deferred: ptr
    reference_frame: int
}

var g_error = ""

last_error() -> string { return g_error }

context_new() -> *Context {
    c = heap.new(Context)
    c.backend = ""
    c.want_snapshot = ""
    c.pending_step_id = -1
    c.pending_snapshot_id = -1
    c.pending_capture_id = -1
    c.pending_trace_id = -1
    c.pending_explain_id = -1
    c.frame_exposure = 1.0
    c.want_deferred = false
    c.deferred = list.new()
    c.reference_frame = -1
    return c
}

defer_read(c: *Context, kind: int, id: int, x: int, y: int, width: int, height: int,
           background: int, tolerance: int) -> bool {
    return defer_grid(c, kind, id, x, y, width, height, background, tolerance, 0, 0)
}

defer_skeleton(c: *Context, id: int, skeleton: ptr) -> bool {
    d = heap.new(Deferred)
    d.kind = READ_SKELETON
    d.id = id
    d.subject = skeleton
    list.add_raw(c.deferred, d as ptr)
    // A skeleton read answers bone positions at the frame boundary, so it is
    // deferred, but it needs no pixels -- setting want_capture here made every
    // one of the hundreds a gait measure does stall a full Vulkan readback.
    c.want_deferred = true
    return true
}

defer_grid(c: *Context, kind: int, id: int, x: int, y: int, width: int, height: int,
           background: int, tolerance: int, columns: int, rows: int) -> bool {
    d = heap.new(Deferred)
    d.kind = kind
    d.id = id
    d.x = x
    d.y = y
    d.width = width
    d.height = height
    d.background = background
    d.tolerance = tolerance
    d.columns = columns
    d.rows = rows
    list.add_raw(c.deferred, d as ptr)
    c.want_capture = true
    c.want_deferred = true
    return true
}

wants_deferred(c: *Context) -> bool { return c.want_deferred }
clear_deferred(c: *Context) { c.want_deferred = false }
wants_capture(c: *Context) -> bool { return c.want_capture }
clear_capture(c: *Context) { c.want_capture = false }

// Called once the frame has been read back, in the order the requests arrived.
answer_deferred(c: *Context) {
    count = list.size(c.deferred)
    i = 0
    while i < count {
        d = list.get_raw(c.deferred, i) as *Deferred
        answer_one_read(c, d)
        heap.free(d)
        i = i + 1
    }
    list.clear(c.deferred)
}

answer_one_read(c: *Context, d: *Deferred) {
    if d.kind == READ_PIXEL {
        block = capture_doubles()
        if capture.pixel(d.x, d.y, block) == 0 {
            free(block)
            fail(d.id, "the point is outside the frame")
            return
        }
        out = colour_json(block)
        free(block)
        json.object_set_raw(out, "x", json.from_int(d.x))
        json.object_set_raw(out, "y", json.from_int(d.y))
        json.object_set_raw(out, "frame", json.from_int(c.frame_count))
        answer(d.id, out)
        return
    }

    if d.kind == READ_REGION {
        out = region_result(d.x, d.y, d.width, d.height, d.background, d.tolerance)
        if out == null {
            fail(d.id, "the region is outside the frame")
            return
        }
        json.object_set_raw(out, "frame", json.from_int(c.frame_count))
        answer(d.id, out)
        return
    }

    if d.kind == READ_GRID {
        cells = d.columns * d.rows
        block = calloc(cells * 4, 8)
        if capture.grid(d.x, d.y, d.width, d.height, d.columns, d.rows,
                             d.background, d.tolerance, block) == 0 {
            free(block)
            fail(d.id, "there is no frame to read")
            return
        }
        rows = json.arr()
        y = 0
        while y < d.rows {
            row = json.arr()
            x = 0
            while x < d.columns {
                at = (y * d.columns + x) * 4
                cell = json.arr()
                span = cells * 4
                json.array_add_raw(cell, json.num(capture.slot_of(block, at, span)))
                json.array_add_raw(cell, json.num(capture.slot_of(block, at + 1, span)))
                json.array_add_raw(cell, json.num(capture.slot_of(block, at + 2, span)))
                json.array_add_raw(cell, json.num(capture.slot_of(block, at + 3, span)))
                json.array_add_raw(row, cell)
                x = x + 1
            }
            json.array_add_raw(rows, row)
            y = y + 1
        }
        free(block)
        out = json.obj()
        json.object_set_raw(out, "columns", json.from_int(d.columns))
        json.object_set_raw(out, "rows", json.from_int(d.rows))
        json.object_set_raw(out, "x", json.from_int(d.x))
        json.object_set_raw(out, "y", json.from_int(d.y))
        json.object_set_raw(out, "width", json.from_int(d.width))
        json.object_set_raw(out, "height", json.from_int(d.height))
        json.object_set_raw(out, "cells", rows)
        json.object_set_raw(out, "frame", json.from_int(c.frame_count))
        answer(d.id, out)
        return
    }

    if d.kind == READ_SKELETON {
        answer(d.id, skeleton_result(d.subject as *Skeleton))
        return
    }

    if d.kind == READ_HOLD {
        if capture.hold_reference() == 0 {
            fail(d.id, "the frame could not be read")
            return
        }
        c.reference_frame = c.frame_count
        out = json.obj()
        json.object_set_raw(out, "frame", json.from_int(c.frame_count))
        answer(d.id, out)
        return
    }

    block = capture_doubles()
    if capture.diff(d.tolerance, block) == 0 {
        free(block)
        fail(d.id, "no held reference, or the frame is a different size than it was")
        return
    }
    out = json.obj()
    json.object_set_raw(out, "changed", json.num(read_double(block, 0)))
    json.object_set_raw(out, "fraction", json.num(read_double(block, 1)))
    json.object_set_raw(out, "max_delta", json.num(read_double(block, 2)))
    json.object_set_raw(out, "pixels", json.num(read_double(block, 3)))
    free(block)
    // Which two frames these are. A hold and a diff sent together are one
    // frame compared with itself, and the answer says so rather than reading
    // as "nothing you did had any effect".
    json.object_set_raw(out, "reference_frame", json.from_int(c.reference_frame))
    json.object_set_raw(out, "frame", json.from_int(c.frame_count))
    answer(d.id, out)
}

context_free(c: *Context) {
    if c == null { return }
    // A read waiting on a frame that never arrived is still in the queue: the
    // context outlives the answer only when the program stops mid-exchange.
    if c.deferred != null {
        count = list.size(c.deferred)
        i = 0
        while i < count {
            d = list.get_raw(c.deferred, i) as *Deferred
            if d != null { heap.free(d) }
            i = i + 1
        }
        list.free(c.deferred)
    }
    heap.free(c)
}

start() -> bool {
    if channel.start() { return true }
    g_error = channel.last_error()
    return false
}

active() -> bool { return channel.active() }

port() -> int { return channel.port() }

stop() { channel.stop() }

ok_envelope(id: int, result: ptr) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "id", json.from_int(id))
    json.object_set_raw(out, "ok", json.boolean(true))
    json.object_set_raw(out, "result", result)
    return out
}

fail(id: int, reason: string) {
    out = json.obj()
    json.object_set_raw(out, "id", json.from_int(id))
    json.object_set_raw(out, "ok", json.boolean(false))
    json.object_set_raw(out, "error", json.str(reason))
    text = json.stringify_raw(out)
    channel.respond(text)
    json.free(out)
}

answer(id: int, result: ptr) {
    out = ok_envelope(id, result)
    text = json.stringify_raw(out)
    channel.respond(text)
    json.free(out)
}

vec3_json(x: float, y: float, z: float) -> ptr {
    out = json.arr()
    json.array_add_raw(out, json.num(x))
    json.array_add_raw(out, json.num(y))
    json.array_add_raw(out, json.num(z))
    return out
}

quat_json(x: float, y: float, z: float, w: float) -> ptr {
    out = json.arr()
    json.array_add_raw(out, json.num(x))
    json.array_add_raw(out, json.num(y))
    json.array_add_raw(out, json.num(z))
    json.array_add_raw(out, json.num(w))
    return out
}

describe(name: string, args: string, summary: string) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "op", json.str(name))
    json.object_set_raw(out, "args", json.str(args))
    json.object_set_raw(out, "summary", json.str(summary))
    return out
}

schema_json() -> string {
    out = help_result()
    text = json.stringify_raw(out)
    json.free(out)
    return text
}

help_result() -> ptr {
    ops = json.arr()
    json.array_add_raw(ops, describe("help", "",
        "This table. Every op, its arguments and what it answers."))
    json.array_add_raw(ops, describe("ping", "",
        "Liveness. Answers immediately, on the frame it was drained."))
    json.array_add_raw(ops, describe("frame.stats", "",
        "frame, fps, delta, viewport, draw calls and instances for the last frame, the mean milliseconds a frame has cost to submit, and on Vulkan the scene split by stage (stages_ms: camdepth, sky, opaque, occlusion, transparent)."))
    json.array_add_raw(ops, describe("camera.get", "",
        "Camera position, orientation, field of view and clip planes."))
    json.array_add_raw(ops, describe("scene.tree", "[detail], [audit]",
        "Every model the renderer holds: index, name, position and visibility. With detail, also its material, texture, parent, world position, triangles and where it lands on screen -- one round trip instead of one per model. With audit, what the surface is made of: its area in metres, its size along each axis, how many ways its faces point, how often its texture repeats across a metre and how many texels that is."))
    json.array_add_raw(ops, describe("render.set", "[normal_strength], [occlusion_strength], [bloom_intensity], [shadows], [ssr], [ssr_road_height], [ssr_strength], [clouds], [cloud_wind], [overcast], [overcast_color]",
        "How hard normal maps push, how much baked occlusion is applied, how strong the bloom is, and whether shadows are cast, for the whole scene. Zero on any strength, or shadows off, is the frame this renderer draws without that -- bloom_intensity of zero is no glow, shadows false is no shadow at all -- which is what makes each one's difference measurable rather than a matter of opinion. The sky's clouds as the share of it they cover (0 none, 1 overcast with holes) with how fast they drift, and the overcast, 0..1, that pulls the sky toward a flat colour ([r, g, b], grey when not given): the sky a weather brings, set by hand so a frame under it can be compared with the clear one."))
    json.array_add_raw(ops, describe("scene.skeleton", "object",
        "Every bone of a skinned model: name, parent, where it is in the world and how it is turned. A skinned mesh stays in its bind pose and its bones carry it, so this is the only thing that says where a figure's hand or foot actually is. Answered at the frame boundary, so it describes a pose that is finished rather than one part way through being built."))
    json.array_add_raw(ops, describe("scene.isolate", "[object]",
        "Show only this model, or show every model again when given no name."))
    json.array_add_raw(ops, describe("model.get", "index",
        "One model in full: transform, bounds, material and mesh counts."))
    json.array_add_raw(ops, describe("light.list", "",
        "Every light: kind, position, direction, colour, intensity and ambient."))
    json.array_add_raw(ops, describe("model.set", "index, [position], [rotation], [scale], [diffuse], [metallic], [roughness], [reflectivity], [alpha], [visible], [casts_shadow], [name]",
        "Change a model. Only the fields present are written; answers with the model as it now is."))
    json.array_add_raw(ops, describe("camera.set", "[position], [look_at], [fov], [near], [far]",
        "Move or reframe the camera."))
    json.array_add_raw(ops, describe("input.set", "[key], [mouse], [button], [axis], [value], [down], [clear]",
        "Press or release a key, mouse button or pad button, hold a pad axis at a value, or clear every injection: what the engine's input reads next frame beside the real devices."))
    json.array_add_raw(ops, describe("input.get", "",
        "Every bound action with its state this frame: down, pressed, released, value."))
    json.array_add_raw(ops, describe("light.set", "[index], [position], [direction], [color], [intensity], [ambient]",
        "Change a light."))
    json.array_add_raw(ops, describe("scene.save", "path, [mesh_directory]",
        "Write the scene to JSON, with generated geometry beside it."))
    json.array_add_raw(ops, describe("scene.load", "path",
        "Replace the scene with one from a file, and reframe the camera as it was saved."))
    json.array_add_raw(ops, describe("frame.capture", "",
        "Read the finished frame into the engine. Answers with its size once it is there."))
    json.array_add_raw(ops, describe("frame.pixel", "x, y",
        "One pixel of the captured frame as r, g, b, a and hex."))
    json.array_add_raw(ops, describe("frame.region", "x, y, width, height, [background], [tolerance]",
        "Mean colour, coverage, and the luminance spread over a rectangle. A flat surface has a stddev near zero; stipple and shadow acne do not."))
    json.array_add_raw(ops, describe("frame.grid", "[x], [y], [width], [height], [columns], [rows], [background], [tolerance]",
        "A window of the frame as a grid of cells, each with its mean colour and how much of it is not the background; the whole frame by default. One answer instead of a round trip a pixel, which is what makes a picture something an agent can read. Given a window no larger than the grid is fine, every cell is one pixel."))
    json.array_add_raw(ops, describe("frame.hold", "",
        "Keep the captured frame as the reference frame.diff compares against."))
    json.array_add_raw(ops, describe("frame.diff", "[tolerance]",
        "Changed pixel count, fraction and largest channel delta against the held reference."))
    json.array_add_raw(ops, describe("world", "",
        "Every entity and the relations between them: blend object, asset, model, mesh, clip, light, camera. One query instead of joining four."))
    json.array_add_raw(ops, describe("trace.model", "id | object | index",
        "Follow one model from its Blender object to the pixels: source, asset, mesh, node, animation, visibility. Names the stage it stopped being right at."))
    json.array_add_raw(ops, describe("explain.model", "id | object | index",
        "Why a model looks the way it does on screen: its material, its texture's mean colour, the light each light and the ambient bring to its top and to the side facing the camera, whether its centre can see the key light or which model is in the way, the exposure, and the pixels it produced beside what it would show fully lit. The verdict names the first stage that accounts for a dark or wrong-coloured look, or says it is as lit."))
    json.array_add_raw(ops, describe("anim.list", "",
        "Every animation bound to a model: clip, playhead, duration, speed and the pose it produced."))
    json.array_add_raw(ops, describe("anim.get", "name | index",
        "One animation in full, including the transform its playhead currently produces."))
    json.array_add_raw(ops, describe("anim.set", "[name | index], [time], [speed], [playing], [looping]",
        "Drive an animation, or every animation at once when no name or index is given. Setting time seeks and reposes together, so a snapshot after it shows that pose."))
    json.array_add_raw(ops, describe("anim.track", "object, times",
        "Where every bone of a skinned model is at each of a list of animation times, in one answer. Each time is posed the way a drawn frame is -- the clips applied, then the scene's own solve on top -- and every bone's world position read, with no frame rendered between them: a path sampled a thousand times over that would otherwise be a thousand round trips. The playheads are left where they were."))
    json.array_add_raw(ops, describe("snapshot", "path",
        "Write the next completed frame to a PNG. Answers once the file exists."))
    json.array_add_raw(ops, describe("frame.pause", "",
        "Hold the simulation still. The scene still renders and can be queried; time and the frame counter stop."))
    json.array_add_raw(ops, describe("frame.resume", "",
        "Let the simulation run again."))
    json.array_add_raw(ops, describe("frame.step", "count",
        "Pause, run exactly count frames, pause again. Answers with stepped_from and stepped."))
    json.array_add_raw(ops, describe("quit", "",
        "Stop the engine's loop and let it shut down normally."))

    out = json.obj()
    json.object_set_raw(out, "protocol", json.str("ae3d-agent/1"))
    json.object_set_raw(out, "ops", ops)
    return out
}

stats_result(c: *Context) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "frame", json.from_int(c.frame_count))
    json.object_set_raw(out, "fps", json.num(c.fps))
    json.object_set_raw(out, "render_ms", json.num(c.render_ms))
    // A frame split by pass, and what it cost in changes of mind. Draw calls,
    // state changes and triangles mean the same thing on every machine, which
    // is what lets a budget be enforced rather than printed; the milliseconds
    // beside them say where the time went when one is exceeded.
    json.object_set_raw(out, "shadow_ms", json.num(c.shadow_ms))
    json.object_set_raw(out, "scene_ms", json.num(c.scene_ms))
    json.object_set_raw(out, "post_ms", json.num(c.post_ms))
    // The scene split by stage, on the backend that stamps it: what the
    // sky, the opaque draws, the occlusion and the transparent draws each
    // cost of the scene figure above, so "the frame is slow" becomes
    // "the clouds are the frame".
    if c.vk_renderer != null {
        stages = json.obj()
        k = 3
        while k < vulkan.STAGE_COUNT {
            json.object_set_raw(stages, vulkan.stage_name(k), json.num(vulkan.renderer_stage_ms(c.vk_renderer as *VKRenderer, k)))
            k = k + 1
        }
        json.object_set_raw(out, "stages_ms", stages)
    }
    json.object_set_raw(out, "cpu_work_ms", json.num(c.cpu_work_ms))
    json.object_set_raw(out, "program_binds", json.from_int(c.program_binds))
    json.object_set_raw(out, "material_binds", json.from_int(c.material_binds))
    json.object_set_raw(out, "texture_binds", json.from_int(c.texture_binds))
    json.object_set_raw(out, "triangles", json.from_int(c.triangles))
    json.object_set_raw(out, "delta", json.num(c.delta))
    json.object_set_raw(out, "width", json.from_int(c.width))
    json.object_set_raw(out, "height", json.from_int(c.height))
    json.object_set_raw(out, "backend", json.str(c.backend))
    json.object_set_raw(out, "device", json.str(c.device))
    json.object_set_raw(out, "draw_calls", json.from_int(c.draw_calls))
    json.object_set_raw(out, "instances", json.from_int(c.instances))
    json.object_set_raw(out, "paused", json.boolean(c.paused))

    // What the renderer is doing, rather than what the program asked for. A
    // scene with no shadows in it and a scene whose shadow map was never built
    // look the same from outside, and this is the difference.
    render = json.obj()
    json.object_set_raw(render, "shadows", json.boolean(c.shadows))
    json.object_set_raw(render, "shadow_map", json.from_int(c.shadow_map))
    json.object_set_raw(render, "lights", json.from_int(c.light_count))
    json.object_set_raw(render, "fog", json.boolean(c.fog_enabled))
    json.object_set_raw(render, "post", json.boolean(c.post_active))
    bloom = 0.0
    if c.vk_renderer != null {
        bloom = vulkan.renderer_bloom_intensity(c.vk_renderer as *VKRenderer)
    } else if c.gl_renderer != null {
        bloom = gl.renderer_bloom_intensity(c.gl_renderer as *GLRenderer)
    }
    json.object_set_raw(render, "bloom_intensity", json.num(bloom))
    // Screen-space reflection is a Vulkan-only pass; on the OpenGL renderer it
    // is never on, so the flag reads false there rather than being absent.
    reflecting = false
    if c.vk_renderer != null {
        reflecting = vulkan.renderer_ssr(c.vk_renderer as *VKRenderer)
    }
    json.object_set_raw(render, "ssr", json.boolean(reflecting))
    json.object_set_raw(out, "render", render)
    return out
}

camera_result(c: *Context) -> ptr {
    out = json.obj()
    if c.camera == null { return out }
    cam = c.camera as *Camera
    json.object_set_raw(out, "position", vec3_json(cam.position.x, cam.position.y, cam.position.z))
    json.object_set_raw(out, "front", vec3_json(cam.front.x, cam.front.y, cam.front.z))
    json.object_set_raw(out, "yaw", json.num(cam.yaw))
    json.object_set_raw(out, "pitch", json.num(cam.pitch))
    json.object_set_raw(out, "fov", json.num(cam.fov))
    json.object_set_raw(out, "near", json.num(cam.near))
    json.object_set_raw(out, "far", json.num(cam.far))
    return out
}

model_count(c: *Context) -> int {
    if c.gl_renderer != null { return gl.renderer_model_count(c.gl_renderer) }
    if c.vk_renderer != null { return vulkan.renderer_model_count(c.vk_renderer) }
    return 0
}

model_at(c: *Context, index: int) -> *Model {
    if c.gl_renderer != null { return gl.renderer_model(c.gl_renderer, index) }
    if c.vk_renderer != null { return vulkan.renderer_model(c.vk_renderer, index) }
    return null
}

model_brief(m: *Model, index: int) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "index", json.from_int(index))
    json.object_set_raw(out, "name", json.str(core.text(m.name)))
    json.object_set_raw(out, "position", vec3_json(m.position.x, m.position.y, m.position.z))
    json.object_set_raw(out, "visible", json.boolean(m.visible))
    return out
}

// Every model, and with detail every model in the depth a sweep needs.
//
// Asking forty models what they are made of and where they are took forty
// round trips, and a round trip costs a frame: the answer cannot be given
// until the frame it describes has been drawn. One call is one frame.
tree_result(c: *Context, detail: bool, audit: bool) -> ptr {
    models = json.arr()
    count = model_count(c)
    i = 0
    while i < count {
        m = model_at(c, i)
        if m != null {
            entry = model_brief(m, i)
            if detail { describe_model(c, m, entry) }
            if audit { audit_model(c, m, entry) }
            json.array_add_raw(models, entry)
        }
        i = i + 1
    }
    out = json.obj()
    json.object_set_raw(out, "count", json.from_int(count))
    json.object_set_raw(out, "models", models)
    return out
}

describe_model(c: *Context, m: *Model, entry: ptr) {
    surface = model_surface(m)
    if surface != null {
        json.object_set_raw(entry, "material", json.str(core.text(surface.name)))
        path = core.text(surface.texture_path)
        if path != "" {
            json.object_set_raw(entry, "texture", json.str(path))
            json.object_set_raw(entry, "texture_loaded",
                                json.boolean(surface.texture_id != 0))
        }
        // A surface's shape, separately from its colour: a normal map that a
        // material names and the renderer never loaded is a wall that is lit
        // as one flat plane, and nothing about the colour says so.
        path = core.text(surface.normal_path)
        if path != "" {
            json.object_set_raw(entry, "normal", json.str(path))
            json.object_set_raw(entry, "normal_loaded",
                                json.boolean(surface.normal_id != 0))
        }
        json.object_set_raw(entry, "diffuse",
            vec3_json(surface.diffuse.x, surface.diffuse.y, surface.diffuse.z))
    }
    parent = core.model_parent(m)
    if parent != null {
        json.object_set_raw(entry, "parent", json.str(core.text(parent.name)))
    }
    world = core.model_world_position(m)
    json.object_set_raw(entry, "world_position", vec3_json(world.x, world.y, world.z))
    // A skinned mesh never moves: its vertices are written in the pose it was
    // bound in and its bones carry it. So its own position is the origin
    // however far it has walked, and the question an agent is really asking --
    // where is it -- is answered by the bones.
    if m.skeleton != null {
        json.object_set_raw(entry, "skinned", json.boolean(true))
        json.object_set_raw(entry, "posed_at",
            vec3_json(m.bounding_center.x, m.bounding_center.y, m.bounding_center.z))
        json.object_set_raw(entry, "bones",
            json.from_int(skin.skeleton_count(m.skeleton as *Skeleton)))
    }
    json.object_set_raw(entry, "triangles", json.from_int(core.mesh_index_count(m.mesh) / 3))

    box = core.vec4(0.0, 0.0, 0.0, 0.0)
    if model_screen_box(c, m, &box) {
        json.object_set_raw(entry, "screen_region",
                            region_json(box.x, box.y, box.z, box.w))
    }
}

// What a surface is made of, as numbers a scene can be judged by rather than
// looked at.
//
// Texel density is the one that decides whether a wall reads as brick or as a
// photograph of brick seen from an inch away, and it is a property of the UVs
// and the geometry together: how many times the image repeats across a metre
// of surface, times how many pixels the image has. Neither the mesh nor the
// image answers it alone, and a screenshot answers it only to an eye.
//
// Distinct face normals stand in for silhouette. A box has six however many
// triangles it is built from, and a shape that reads as a shape has hundreds.
audit_model(c: *Context, m: *Model, entry: ptr) {
    if m.mesh == null { return }
    area = core.mesh_surface_area(m.mesh, m.world_scale)
    uv_area = core.mesh_uv_area(m.mesh)
    json.object_set_raw(entry, "area_m2", json.num(area))
    json.object_set_raw(entry, "planes",
                        json.from_int(core.mesh_distinct_planes(m.mesh, 0.05)))
    json.object_set_raw(entry, "triangles",
                        json.from_int(core.mesh_index_count(m.mesh) / 3))

    repeats = 0.0
    if area > 0.000001 { repeats = core.sqrt_of(uv_area / area) }
    json.object_set_raw(entry, "uv_repeats_per_m", json.num(repeats))

    // Texel density needs the texture's pixel size, which the renderer that
    // loaded it knows -- whichever renderer that is.
    size = core.vec3(0.0, 0.0, 0.0)
    if c.gl_renderer != null {
        size = gl.renderer_material_texture_size(c.gl_renderer as *GLRenderer, model_surface(m))
    } else if c.vk_renderer != null {
        size = vulkan.renderer_material_texture_size(c.vk_renderer as *VKRenderer, model_surface(m))
    }
    if size.x > 0.0 {
        json.object_set_raw(entry, "texture_pixels", json.from_int(size.x as int))
        json.object_set_raw(entry, "texels_per_m", json.num(repeats * size.x))
    }

    // In metres along its own axes, so proportion can be checked as the ratio
    // it is. A bounding radius says how big something is and nothing at all
    // about its shape.
    size = core.mesh_size(m.mesh, m.world_scale)
    json.object_set_raw(entry, "size", vec3_json(size.x, size.y, size.z))
}

find_skeleton(c: *Context, wanted: string) -> ptr {
    count = model_count(c)
    i = 0
    while i < count {
        m = model_at(c, i)
        if m != null && m.skeleton != null && core.text(m.name) == wanted { return m.skeleton }
        i = i + 1
    }
    return null
}

// The pose a drawn frame builds: the clips applied at the playhead the caller
// set, then the scene's per-frame solve on top of them. Kept together because
// reading a pose between the two is reading half of one.
pose_all_at(c: *Context, t: float) {
    registry = c.animations as *Registry
    count = anim.registry_count(registry)
    i = 0
    while i < count {
        b = anim.registry_binding(registry, i)
        if b != null { anim.player_set_time(anim.binding_player(b), t) }
        i = i + 1
    }
    anim.registry_apply(registry)
    if c.on_pose != null { c.on_pose(c.user_data) }
}

// Just the names and world positions, which is all a path through time is made
// of. skeleton_result carries the parent and the rotation too; a track of a
// thousand samples does not want them a thousand times over.
skeleton_positions(s: *Skeleton) -> ptr {
    bones = json.arr()
    count = skin.skeleton_count(s)
    i = 0
    while i < count {
        bone = skin.skeleton_bone(s, i)
        if bone != null {
            core.model_sync_transform(bone)
            at = core.model_world_position(bone)
            entry = json.obj()
            json.object_set_raw(entry, "name", json.str(core.text(bone.name)))
            json.object_set_raw(entry, "world_position", vec3_json(at.x, at.y, at.z))
            json.array_add_raw(bones, entry)
        }
        i = i + 1
    }
    return bones
}

skeleton_result(s: *Skeleton) -> ptr {
    bones = json.arr()
    count = skin.skeleton_count(s)
    i = 0
    while i < count {
        bone = skin.skeleton_bone(s, i)
        if bone != null {
            core.model_sync_transform(bone)
            at = core.model_world_position(bone)
            entry = json.obj()
            json.object_set_raw(entry, "index", json.from_int(i))
            json.object_set_raw(entry, "name", json.str(core.text(bone.name)))
            parent = core.model_parent(bone)
            if parent != null {
                json.object_set_raw(entry, "parent", json.str(core.text(parent.name)))
            }
            json.object_set_raw(entry, "world_position", vec3_json(at.x, at.y, at.z))
            json.object_set_raw(entry, "rotation",
                quat_json(bone.rotation.x, bone.rotation.y, bone.rotation.z, bone.rotation.w))
            json.array_add_raw(bones, entry)
        }
        i = i + 1
    }
    out = json.obj()
    json.object_set_raw(out, "count", json.from_int(count))
    json.object_set_raw(out, "bones", bones)
    return out
}

model_result(m: *Model, index: int) -> ptr {
    out = model_brief(m, index)
    json.object_set_raw(out, "scale", vec3_json(m.scale.x, m.scale.y, m.scale.z))
    json.object_set_raw(out, "rotation", quat_json(m.rotation.x, m.rotation.y, m.rotation.z, m.rotation.w))
    json.object_set_raw(out, "casts_shadow", json.boolean(m.casts_shadow))
    json.object_set_raw(out, "instance_count", json.from_int(core.model_instance_count(m)))
    json.object_set_raw(out, "instanced", json.boolean(m.is_instanced))
    json.object_set_raw(out, "shares_geometry", json.boolean(m.shares_geometry))
    json.object_set_raw(out, "source_path", json.str(core.text(m.source_path)))
    json.object_set_raw(out, "bounding_center",
        vec3_json(m.bounding_center.x, m.bounding_center.y, m.bounding_center.z))
    json.object_set_raw(out, "bounding_radius", json.num(m.bounding_radius))

    if m.mesh != null {
        json.object_set_raw(out, "vertex_count", json.from_int(core.mesh_vertex_count(m.mesh)))
        json.object_set_raw(out, "index_count", json.from_int(core.mesh_index_count(m.mesh)))
    } else {
        json.object_set_raw(out, "mesh", json.boolean(false))
    }
    return out
}

extra_light_count(c: *Context) -> int {
    if c.gl_renderer != null { return gl.renderer_light_count(c.gl_renderer) }
    if c.vk_renderer != null { return vulkan.renderer_light_count(c.vk_renderer) }
    return 0
}

extra_light_at(c: *Context, index: int) -> *Light {
    if c.gl_renderer != null { return gl.renderer_light(c.gl_renderer, index) }
    if c.vk_renderer != null { return vulkan.renderer_light(c.vk_renderer, index) }
    return null
}

light_count(c: *Context) -> int {
    base = 0
    if c.light != null { base = 1 }
    return base + extra_light_count(c)
}

light_at(c: *Context, index: int) -> *Light {
    if index < 0 { return null }
    if c.light != null {
        if index == 0 { return c.light as *Light }
        return extra_light_at(c, index - 1)
    }
    return extra_light_at(c, index)
}

light_result(l: *Light, index: int) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "index", json.from_int(index))
    json.object_set_raw(out, "name", json.str(core.text(l.name)))
    json.object_set_raw(out, "kind", json.from_int(l.kind))
    json.object_set_raw(out, "position", vec3_json(l.position.x, l.position.y, l.position.z))
    json.object_set_raw(out, "direction", vec3_json(l.direction.x, l.direction.y, l.direction.z))
    json.object_set_raw(out, "color", vec3_json(l.color.x, l.color.y, l.color.z))
    json.object_set_raw(out, "intensity", json.num(l.intensity))
    json.object_set_raw(out, "ambient", json.num(l.ambient_strength))
    return out
}

lights_result(c: *Context) -> ptr {
    items = json.arr()
    count = light_count(c)
    i = 0
    while i < count {
        l = light_at(c, i)
        if l != null { json.array_add_raw(items, light_result(l, i)) }
        i = i + 1
    }
    out = json.obj()
    json.object_set_raw(out, "count", json.from_int(count))
    json.object_set_raw(out, "lights", items)
    return out
}

// Every action and what it read at the last poll.
input_result(service: *Input) -> ptr {
    items = json.arr()
    count = input.action_count(service)
    k = 0
    while k < count {
        a = input.action_at(service, k)
        item = json.obj()
        json.object_set_raw(item, "name", json.str(a.name))
        json.object_set_raw(item, "down", json.boolean(a.down))
        json.object_set_raw(item, "pressed", json.boolean(a.down && !a.was_down))
        json.object_set_raw(item, "released", json.boolean(!a.down && a.was_down))
        json.object_set_raw(item, "value", json.num(a.value))
        json.array_add_raw(items, item)
        k = k + 1
    }
    out = json.obj()
    json.object_set_raw(out, "count", json.from_int(count))
    json.object_set_raw(out, "actions", items)
    json.object_set_raw(out, "gamepad", json.boolean(input.gamepad_present(service)))
    return out
}

number_at(node: ptr, name: string, fallback: float) -> float {
    found = json.object_get_raw(node, name)
    if found == null { return fallback }
    return json.get_number(found)
}

has_field(node: ptr, name: string) -> bool {
    return json.object_get_raw(node, name) != null
}

read_vec3(node: ptr, name: string, into: *Vec3) -> bool {
    found = json.object_get_raw(node, name)
    if found == null { return false }
    if json.array_size(found) < 3 { return false }
    into.x = json.get_number(json.array_get_raw(found, 0))
    into.y = json.get_number(json.array_get_raw(found, 1))
    into.z = json.get_number(json.array_get_raw(found, 2))
    return true
}

apply_model_write(m: *Model, request: ptr) {
    v = core.vec3(0.0, 0.0, 0.0)
    if read_vec3(request, "position", &v) { core.model_set_position(m, v.x, v.y, v.z) }
    if read_vec3(request, "scale", &v) { core.model_set_scale(m, v.x, v.y, v.z) }

    found = json.object_get_raw(request, "rotation")
    if found != null && json.array_size(found) >= 4 {
        core.model_set_rotation(m, Quat {
            x: json.get_number(json.array_get_raw(found, 0)),
            y: json.get_number(json.array_get_raw(found, 1)),
            z: json.get_number(json.array_get_raw(found, 2)),
            w: json.get_number(json.array_get_raw(found, 3))
        })
    }
    if read_vec3(request, "diffuse", &v) { core.model_set_diffuse(m, v.x, v.y, v.z) }
    if has_field(request, "metallic") || has_field(request, "roughness") {
        core.model_set_pbr(m,
            number_at(request, "metallic", 0.0),
            number_at(request, "roughness", 0.5))
    }
    if has_field(request, "alpha") { core.model_set_alpha(m, number_at(request, "alpha", 1.0)) }
    if has_field(request, "reflectivity") {
        core.model_set_reflectivity(m, number_at(request, "reflectivity", 0.0))
    }
    if has_field(request, "visible") {
        m.visible = json.get_bool(json.object_get_raw(request, "visible")) == 1
    }
    if has_field(request, "casts_shadow") {
        core.model_set_casts_shadow(m,
            json.get_bool(json.object_get_raw(request, "casts_shadow")) == 1)
    }
    if has_field(request, "name") {
        core.model_set_name(m, json.get_string_raw(json.object_get_raw(request, "name")))
    }
}

apply_camera_write(cam: *Camera, request: ptr) {
    v = core.vec3(0.0, 0.0, 0.0)
    if read_vec3(request, "position", &v) { core.camera_set_position(cam, v) }
    if read_vec3(request, "look_at", &v) { core.camera_look_at(cam, v) }
    if has_field(request, "fov") { core.camera_set_fov(cam, number_at(request, "fov", 45.0)) }
    if has_field(request, "near") { core.camera_set_near(cam, number_at(request, "near", 0.1)) }
    if has_field(request, "far") { core.camera_set_far(cam, number_at(request, "far", 10000.0)) }
}

apply_light_write(l: *Light, request: ptr) {
    v = core.vec3(0.0, 0.0, 0.0)
    if read_vec3(request, "position", &v) { l.position = v }
    if read_vec3(request, "direction", &v) { l.direction = v }
    if read_vec3(request, "color", &v) { l.color = v }
    if has_field(request, "intensity") { l.intensity = number_at(request, "intensity", 1.0) }
    if has_field(request, "ambient") { l.ambient_strength = number_at(request, "ambient", 0.1) }
}

remove_model_from_renderer(c: *Context, m: *Model) {
    if c.gl_renderer != null { gl.renderer_remove_model(c.gl_renderer, m) }
    if c.vk_renderer != null { vulkan.renderer_remove_model(c.vk_renderer, m) }
}

add_model_to_renderer(c: *Context, m: *Model) {
    if c.gl_renderer != null { gl.renderer_add_model(c.gl_renderer, m) }
    if c.vk_renderer != null { vulkan.renderer_add_model(c.vk_renderer, m) }
}

view_from_camera(c: *Context) -> View {
    v = scene.view_defaults()
    if c.camera == null { return v }
    cam = c.camera as *Camera
    v.camera_x = cam.position.x
    v.camera_y = cam.position.y
    v.camera_z = cam.position.z
    v.yaw = cam.yaw
    v.pitch = cam.pitch
    v.fov = cam.fov
    v.near = cam.near
    v.far = cam.far
    return v
}

save_scene(c: *Context, path: string, mesh_directory: string) -> bool {
    models = list.new()
    i = 0
    count = model_count(c)
    while i < count {
        m = model_at(c, i)
        if m != null { list.add_raw(models, m as ptr) }
        i = i + 1
    }

    lights = list.new()
    i = 0
    count = light_count(c)
    while i < count {
        l = light_at(c, i)
        if l != null { list.add_raw(lights, l as ptr) }
        i = i + 1
    }

    attachments = null as ptr
    if c.on_attachments != null { attachments = c.on_attachments(c.user_data) }
    view = view_from_camera(c)
    ok = scene.scene_save(models, lights, attachments, &view, path, mesh_directory)
    scene.attachments_free(attachments)
    list.free(models)
    list.free(lights)
    return ok
}

load_scene(c: *Context, path: string) -> int {
    loaded = scene.scene_load(path)
    if loaded == null { return 0 - 1 }

    while model_count(c) > 0 {
        m = model_at(c, 0)
        if m == null { break }
        remove_model_from_renderer(c, m)
        core.model_free(m)
    }

    i = 0
    count = list.size(loaded)
    while i < count {
        add_model_to_renderer(c, list.get_raw(loaded, i) as *Model)
        i = i + 1
    }
    list.free(loaded)

    if c.camera != null {
        view = scene.scene_load_view(path)
        cam = c.camera as *Camera
        core.camera_set_position(cam, core.vec3(view.camera_x, view.camera_y, view.camera_z))
        core.camera_set_fov(cam, view.fov)
        core.camera_set_near(cam, view.near)
        core.camera_set_far(cam, view.far)
    }
    return count
}

const CAPTURE_SLOTS = 8

capture_doubles() -> ptr {
    return calloc(CAPTURE_SLOTS, 8)
}

read_double(block: ptr, index: int) -> float {
    return capture.slot(block, index)
}

colour_json(block: ptr) -> ptr {
    red = json.get_int(json.num(read_double(block, 0)))
    green = json.get_int(json.num(read_double(block, 1)))
    blue = json.get_int(json.num(read_double(block, 2)))
    out = json.obj()
    json.object_set_raw(out, "r", json.from_int(red))
    json.object_set_raw(out, "g", json.from_int(green))
    json.object_set_raw(out, "b", json.from_int(blue))
    json.object_set_raw(out, "a", json.from_int(json.get_int(json.num(read_double(block, 3)))))
    json.object_set_raw(out, "hex", json.from_int(red * 65536 + green * 256 + blue))
    return out
}

region_result(x: int, y: int, width: int, height: int,
              background: int, tolerance: int) -> ptr {
    block = capture_doubles()
    out = json.obj()
    if capture.region(x, y, width, height, background, tolerance, block) == 0 {
        free(block)
        return null
    }
    json.object_set_raw(out, "x", json.from_int(x))
    json.object_set_raw(out, "y", json.from_int(y))
    json.object_set_raw(out, "width", json.from_int(width))
    json.object_set_raw(out, "height", json.from_int(height))
    json.object_set_raw(out, "mean", vec3_json(read_double(block, 0),
                                               read_double(block, 1),
                                               read_double(block, 2)))
    json.object_set_raw(out, "mean_alpha", json.num(read_double(block, 3)))
    json.object_set_raw(out, "coverage", json.num(read_double(block, 4)))
    json.object_set_raw(out, "pixels", json.num(read_double(block, 5)))
    json.object_set_raw(out, "stddev", json.num(read_double(block, 6)))
    json.object_set_raw(out, "range", json.num(read_double(block, 7)))
    free(block)
    return out
}

// A loaded mesh carries its materials in its groups rather than in the single
// slot a primitive uses, and the first group is what the model is surfaced
// with wherever it has only one.
model_surface(m: *Model) -> *Material {
    if m.material != null { return m.material }
    if core.model_group_count(m) > 0 {
        group = core.model_group(m, 0)
        if group != null { return group.material }
    }
    return null
}

// Where on screen to look for a model, clipped to the frame.
//
// A road sixty metres long has its centre behind the camera while it fills the
// bottom of the picture, so projecting the centre and asking whether that point
// landed in the frame answers no for something plainly there. What can be said
// about such a model is that part of it is in view, and the part of the frame
// to sample is all of it.
model_screen_box(c: *Context, m: *Model, box: *Vec4) -> bool {
    if c.camera == null { return false }
    cam = c.camera as *Camera

    centre = core.camera_world_to_screen(cam, m.bounding_center, c.width, c.height)
    if centre.w <= 0.0001 {
        box.x = 0.0
        box.y = 0.0
        box.z = c.width * 1.0
        box.w = c.height * 1.0
        return true
    }

    edge = core.v3_add(m.bounding_center, core.v3_mul(cam.right, m.bounding_radius))
    projected = core.camera_world_to_screen(cam, edge, c.width, c.height)
    radius = projected.x - centre.x
    if radius < 0.0 { radius = 0.0 - radius }
    if radius < 1.0 { radius = 1.0 }

    left = centre.x - radius
    top = centre.y - radius
    right = centre.x + radius
    bottom = centre.y + radius
    if left < 0.0 { left = 0.0 }
    if top < 0.0 { top = 0.0 }
    if right > c.width * 1.0 { right = c.width * 1.0 }
    if bottom > c.height * 1.0 { bottom = c.height * 1.0 }
    if right <= left || bottom <= top { return false }

    box.x = left
    box.y = top
    box.z = right - left
    box.w = bottom - top
    return true
}

entity(id: string, kind: string, name: string, attrs: ptr) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "id", json.str(id))
    json.object_set_raw(out, "kind", json.str(kind))
    json.object_set_raw(out, "name", json.str(name))
    if attrs != null { json.object_set_raw(out, "attrs", attrs) }
    return out
}

relation(from: string, kind: string, to: string) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "from", json.str(from))
    json.object_set_raw(out, "rel", json.str(kind))
    json.object_set_raw(out, "to", json.str(to))
    return out
}

model_id(index: int) -> string {
    return string.concat("model:", string.from_int(index))
}

world_result(c: *Context) -> ptr {
    entities = json.arr()
    relations = json.arr()

    if c.camera != null {
        cam = c.camera as *Camera
        attrs = json.obj()
        json.object_set_raw(attrs, "position", vec3_json(cam.position.x, cam.position.y, cam.position.z))
        json.object_set_raw(attrs, "fov", json.num(cam.fov))
        json.array_add_raw(entities, entity("camera", "camera", "camera", attrs))
    }

    count = model_count(c)
    i = 0
    while i < count {
        m = model_at(c, i)
        if m != null {
            id = model_id(i)
            attrs = json.obj()
            json.object_set_raw(attrs, "position", vec3_json(m.position.x, m.position.y, m.position.z))
            json.object_set_raw(attrs, "visible", json.boolean(m.visible))
            json.array_add_raw(entities, entity(id, "model", core.text(m.name), attrs))

            if m.mesh != null {
                mesh_id = string.concat("mesh:", string.from_int(i))
                mesh_attrs = json.obj()
                json.object_set_raw(mesh_attrs, "vertices", json.from_int(core.mesh_vertex_count(m.mesh)))
                json.object_set_raw(mesh_attrs, "triangles", json.from_int(core.mesh_index_count(m.mesh) / 3))
                json.array_add_raw(entities, entity(mesh_id, "mesh", "", mesh_attrs))
                json.array_add_raw(relations, relation(id, "has_mesh", mesh_id))
            }
            if c.camera != null { json.array_add_raw(relations, relation("camera", "sees", id)) }

            p = assets.provenance_for(m)
            if p != null {
                blend_id = string.concat("blend:", assets.provenance_id(p))
                asset_id = string.concat("asset:", assets.provenance_id(p))
                blend_attrs = json.obj()
                json.object_set_raw(blend_attrs, "source", json.str(core.text(assets.provenance_source(p))))
                json.array_add_raw(entities,
                    entity(blend_id, "blend_object", core.text(assets.provenance_object(p)), blend_attrs))
                asset_attrs = json.obj()
                json.object_set_raw(asset_attrs, "mesh", json.str(core.text(assets.provenance_mesh_file(p))))
                json.object_set_raw(asset_attrs, "animation", json.str(core.text(assets.provenance_animation_file(p))))
                json.object_set_raw(asset_attrs, "triangles", json.from_int(assets.provenance_expected_triangles(p)))
                json.array_add_raw(entities, entity(asset_id, "asset", "", asset_attrs))
                json.array_add_raw(relations, relation(blend_id, "exported_to", asset_id))
                json.array_add_raw(relations, relation(asset_id, "loaded_as", id))
            }
        }
        i = i + 1
    }

    registry = c.animations as *Registry
    count = anim.registry_count(registry)
    i = 0
    while i < count {
        b = anim.registry_binding(registry, i)
        if b != null {
            player = anim.binding_player(b)
            clip = anim.player_clip(player)
            clip_id = string.concat("clip:", core.text(anim.binding_name(b)))
            attrs = json.obj()
            json.object_set_raw(attrs, "clip", json.str(core.text(anim.clip_name(clip))))
            json.object_set_raw(attrs, "time", json.num(anim.player_time(player)))
            json.object_set_raw(attrs, "duration", json.num(anim.clip_duration(clip)))
            json.object_set_raw(attrs, "playing", json.boolean(anim.player_playing(player)))
            json.array_add_raw(entities,
                entity(clip_id, "clip", core.text(anim.binding_name(b)), attrs))

            driven = anim.binding_model(b)
            target = node_index_of(c, driven)
            if target >= 0 { json.array_add_raw(relations, relation(clip_id, "drives", model_id(target))) }
        }
        i = i + 1
    }

    count = light_count(c)
    i = 0
    while i < count {
        l = light_at(c, i)
        if l != null {
            id = string.concat("light:", string.from_int(i))
            attrs = json.obj()
            json.object_set_raw(attrs, "color", vec3_json(l.color.x, l.color.y, l.color.z))
            json.object_set_raw(attrs, "intensity", json.num(l.intensity))
            json.array_add_raw(entities, entity(id, "light", core.text(l.name), attrs))
            json.array_add_raw(relations, relation(id, "lights", "camera"))
        }
        i = i + 1
    }

    out = json.obj()
    json.object_set_raw(out, "frame", json.from_int(c.frame_count))
    json.object_set_raw(out, "entities", entities)
    json.object_set_raw(out, "relations", relations)
    return out
}

binding_result(b: *Binding, index: int) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "index", json.from_int(index))
    json.object_set_raw(out, "name", json.str(core.text(anim.binding_name(b))))

    p = anim.binding_player(b)
    clip = anim.player_clip(p)
    json.object_set_raw(out, "clip", json.str(core.text(anim.clip_name(clip))))
    json.object_set_raw(out, "time", json.num(anim.player_time(p)))
    json.object_set_raw(out, "duration", json.num(anim.clip_duration(clip)))
    json.object_set_raw(out, "speed", json.num(anim.player_speed(p)))
    json.object_set_raw(out, "playing", json.boolean(anim.player_playing(p)))
    json.object_set_raw(out, "looping", json.boolean(anim.player_looping(p)))
    json.object_set_raw(out, "channels", json.from_int(anim.clip_channel_count(clip)))

    m = anim.binding_model(b)
    if m != null {
        json.object_set_raw(out, "model_position",
            vec3_json(m.position.x, m.position.y, m.position.z))
        json.object_set_raw(out, "model_rotation",
            quat_json(m.rotation.x, m.rotation.y, m.rotation.z, m.rotation.w))
        json.object_set_raw(out, "model_scale",
            vec3_json(m.scale.x, m.scale.y, m.scale.z))
    } else {
        json.object_set_raw(out, "model", json.boolean(false))
    }
    return out
}

anim_list_result(c: *Context) -> ptr {
    items = json.arr()
    registry = c.animations as *Registry
    count = anim.registry_count(registry)
    i = 0
    while i < count {
        b = anim.registry_binding(registry, i)
        if b != null { json.array_add_raw(items, binding_result(b, i)) }
        i = i + 1
    }
    out = json.obj()
    json.object_set_raw(out, "count", json.from_int(count))
    json.object_set_raw(out, "animations", items)
    return out
}

// Applies whatever the request carries to every binding, and answers with how
// many were driven and where they ended up.
drive_all(c: *Context, request: ptr) -> ptr {
    registry = c.animations as *Registry
    count = anim.registry_count(registry)
    i = 0
    while i < count {
        drive_binding(anim.registry_binding(registry, i), request)
        i = i + 1
    }
    out = json.obj()
    json.object_set_raw(out, "animations", json.from_int(count))
    node = json.object_get_raw(request, "time")
    if node != null { json.object_set_raw(out, "time", json.num(json.get_number(node))) }
    return out
}

drive_binding(b: *Binding, request: ptr) {
    if b == null { return }
    p = anim.binding_player(b)

    node = json.object_get_raw(request, "time")
    if node != null {
        anim.player_set_time(p, json.get_number(node))
        anim.apply(p, anim.binding_model(b))
    }
    node = json.object_get_raw(request, "speed")
    if node != null { anim.player_set_speed(p, json.get_number(node)) }
    node = json.object_get_raw(request, "looping")
    if node != null { anim.player_set_looping(p, json.get_bool(node) == 1) }
    node = json.object_get_raw(request, "playing")
    if node != null {
        if json.get_bool(node) == 1 { anim.player_play(p) } else { anim.player_pause(p) }
    }
}

binding_from(c: *Context, request: ptr) -> int {
    registry = c.animations as *Registry
    named = json.object_get_raw(request, "name")
    if named != null { return anim.registry_find(registry, json.get_string_raw(named)) }
    indexed = json.object_get_raw(request, "index")
    if indexed != null { return json.get_int(indexed) }
    return -1
}

stage(name: string, reached: bool, detail: ptr) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "stage", json.str(name))
    json.object_set_raw(out, "reached", json.boolean(reached))
    json.object_set_raw(out, "applicable", json.boolean(true))
    if detail != null { json.object_set_raw(out, "detail", detail) }
    return out
}

not_applicable(name: string, detail: ptr) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "stage", json.str(name))
    json.object_set_raw(out, "reached", json.boolean(false))
    json.object_set_raw(out, "applicable", json.boolean(false))
    if detail != null { json.object_set_raw(out, "detail", detail) }
    return out
}

node_index_of(c: *Context, m: *Model) -> int {
    count = model_count(c)
    i = 0
    while i < count {
        if model_at(c, i) == m { return i }
        i = i + 1
    }
    return 0 - 1
}

binding_index_of(c: *Context, m: *Model) -> int {
    registry = c.animations as *Registry
    count = anim.registry_count(registry)
    i = 0
    while i < count {
        b = anim.registry_binding(registry, i)
        if b != null && anim.binding_model(b) == m { return i }
        i = i + 1
    }
    return 0 - 1
}

visibility_detail(c: *Context, m: *Model, reached: ptr) -> bool {
    if c.camera == null {
        json.object_set_raw(reached, "camera", json.boolean(false))
        return false
    }
    cam = c.camera as *Camera

    frustum = core.frustum_new()
    core.camera_fill_frustum(cam, frustum)
    inside = core.frustum_intersects_sphere(frustum as *Frustum,
                                            m.bounding_center, m.bounding_radius)
    core.frustum_free(frustum)

    screen = core.camera_world_to_screen(cam, m.bounding_center, c.width, c.height)
    in_front = screen.w > 0.0001

    json.object_set_raw(reached, "in_frustum", json.boolean(inside))
    json.object_set_raw(reached, "in_front_of_camera", json.boolean(in_front))
    json.object_set_raw(reached, "bounding_radius", json.num(m.bounding_radius))
    if in_front {
        json.object_set_raw(reached, "screen_x", json.num(screen.x))
        json.object_set_raw(reached, "screen_y", json.num(screen.y))
    }

    // Whether any of it is in the frame, rather than whether its centre is: a
    // model larger than the view has its centre wherever the geometry averages
    // out, which for a road is behind the camera driving down it.
    box = core.vec4(0.0, 0.0, 0.0, 0.0)
    covered = model_screen_box(c, m, &box)
    json.object_set_raw(reached, "on_screen", json.boolean(inside && covered))
    if covered {
        json.object_set_raw(reached, "screen_region",
                            region_json(box.x, box.y, box.z, box.w))
    }
    return inside && covered
}

region_json(x: float, y: float, width: float, height: float) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "x", json.from_int(x as int))
    json.object_set_raw(out, "y", json.from_int(y as int))
    json.object_set_raw(out, "width", json.from_int(width as int))
    json.object_set_raw(out, "height", json.from_int(height as int))
    return out
}

trace_result(c: *Context, m: *Model, p: *Provenance) -> ptr {
    stages = json.arr()
    broke_at = ""

    source = json.obj()
    source_ok = p != null
    if source_ok {
        json.object_set_raw(source, "id", json.str(core.text(assets.provenance_id(p))))
        json.object_set_raw(source, "object", json.str(core.text(assets.provenance_object(p))))
        json.object_set_raw(source, "blend", json.str(core.text(assets.provenance_source(p))))
    } else {
        json.object_set_raw(source, "note",
            json.str("this model was not loaded from a manifest, so it has no Blender source"))
    }
    if source_ok {
        json.array_add_raw(stages, stage("source", true, source))
    } else {
        json.array_add_raw(stages, not_applicable("source", source))
    }

    asset = json.obj()
    asset_ok = true
    if p != null {
        json.object_set_raw(asset, "mesh_file", json.str(core.text(assets.provenance_mesh_file(p))))
        json.object_set_raw(asset, "animation_file",
            json.str(core.text(assets.provenance_animation_file(p))))
        json.object_set_raw(asset, "exported_vertices",
            json.from_int(assets.provenance_expected_vertices(p)))
        json.object_set_raw(asset, "exported_triangles",
            json.from_int(assets.provenance_expected_triangles(p)))
        asset_ok = assets.provenance_mesh_file(p) != ""
    } else {
        asset_ok = false
    }
    if p == null {
        json.object_set_raw(asset, "note",
            json.str("no manifest entry, so there are no exported files to check"))
        json.array_add_raw(stages, not_applicable("asset", asset))
    } else {
        json.array_add_raw(stages, stage("asset", asset_ok, asset))
        if !asset_ok && broke_at == "" { broke_at = "asset" }
    }

    mesh = json.obj()
    mesh_ok = m.mesh != null
    if mesh_ok {
        vertices = core.mesh_vertex_count(m.mesh)
        indices = core.mesh_index_count(m.mesh)
        json.object_set_raw(mesh, "vertex_count", json.from_int(vertices))
        json.object_set_raw(mesh, "index_count", json.from_int(indices))
        json.object_set_raw(mesh, "triangles", json.from_int(indices / 3))
        mesh_ok = vertices > 0 && indices > 0
        if p != null && assets.provenance_expected_triangles(p) > 0 {
            agreed = (indices / 3) == assets.provenance_expected_triangles(p)
            json.object_set_raw(mesh, "matches_export", json.boolean(agreed))
            if !agreed { mesh_ok = false }
        }
    } else {
        json.object_set_raw(mesh, "note", json.str("the model holds no mesh"))
    }
    json.array_add_raw(stages, stage("mesh", mesh_ok, mesh))
    if !mesh_ok && broke_at == "" { broke_at = "mesh" }

    node = json.obj()
    index = node_index_of(c, m)
    node_ok = index >= 0
    json.object_set_raw(node, "index", json.from_int(index))
    json.object_set_raw(node, "visible_flag", json.boolean(m.visible))
    json.object_set_raw(node, "position", vec3_json(m.position.x, m.position.y, m.position.z))
    json.object_set_raw(node, "scale", vec3_json(m.scale.x, m.scale.y, m.scale.z))
    parent = core.model_parent(m)
    if parent != null {
        json.object_set_raw(node, "parent", json.str(core.text(parent.name)))
        world = core.model_world_position(m)
        json.object_set_raw(node, "world_position", vec3_json(world.x, world.y, world.z))
    }

    // What it is surfaced with, and whether the renderer resolved the image the
    // material names. A model drawn in flat white because its texture never
    // loaded looks, from every other stage, exactly like one that did.
    surface = model_surface(m)
    if surface != null {
        material = json.obj()
        json.object_set_raw(material, "name", json.str(core.text(surface.name)))
        json.object_set_raw(material, "diffuse",
                            vec3_json(surface.diffuse.x, surface.diffuse.y, surface.diffuse.z))
        json.object_set_raw(material, "groups",
                            json.from_int(core.model_group_count(m)))
        path = core.text(surface.texture_path)
        json.object_set_raw(material, "texture", json.str(path))
        json.object_set_raw(material, "texture_loaded",
                            json.boolean(surface.texture_id != 0))
        if path != "" && surface.texture_id == 0 {
            node_ok = false
            json.object_set_raw(node, "note",
                json.str("the material names a texture the renderer never loaded"))
        }
        json.object_set_raw(node, "material", material)
    }
    if !node_ok {
        json.object_set_raw(node, "note",
            json.str("the renderer has never been given this model; engine_add_model was not called"))
    }
    if node_ok && !m.visible {
        node_ok = false
        json.object_set_raw(node, "note", json.str("the model is in the scene but marked invisible"))
    }
    json.array_add_raw(stages, stage("node", node_ok, node))
    if !node_ok && broke_at == "" { broke_at = "node" }

    animation = json.obj()
    binding = binding_index_of(c, m)
    animated = binding >= 0
    animation_ok = true
    json.object_set_raw(animation, "bound", json.boolean(animated))
    if animated {
        b = anim.registry_binding(c.animations as *Registry, binding)
        player = anim.binding_player(b)
        clip = anim.player_clip(player)
        json.object_set_raw(animation, "name", json.str(core.text(anim.binding_name(b))))
        json.object_set_raw(animation, "clip", json.str(core.text(anim.clip_name(clip))))
        json.object_set_raw(animation, "time", json.num(anim.player_time(player)))
        json.object_set_raw(animation, "duration", json.num(anim.clip_duration(clip)))
        json.object_set_raw(animation, "playing", json.boolean(anim.player_playing(player)))
        json.object_set_raw(animation, "channels", json.from_int(anim.clip_channel_count(clip)))
        if anim.clip_channel_count(clip) == 0 {
            animation_ok = false
            json.object_set_raw(animation, "note",
                json.str("bound to a clip with no channels, so it drives nothing"))
        }
    } else if p != null && assets.provenance_animation_file(p) != "" {
        animation_ok = false
        json.object_set_raw(animation, "note",
            json.str("the export carries an animation for this object but nothing is playing it"))
    }
    json.array_add_raw(stages, stage("animation", animation_ok, animation))
    if !animation_ok && broke_at == "" { broke_at = "animation" }

    visible = json.obj()
    visible_ok = visibility_detail(c, m, visible)
    json.array_add_raw(stages, stage("visibility", visible_ok, visible))
    if !visible_ok && broke_at == "" { broke_at = "visibility" }

    pixels = json.obj()
    pixels_ok = false
    box = Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
    if capture.width() == 0 {
        json.object_set_raw(pixels, "note", json.str("the frame could not be read"))
        json.array_add_raw(stages, not_applicable("pixels", pixels))
    } else if !model_screen_box(c, m, &box) {
        json.object_set_raw(pixels, "note",
            json.str("the model does not project to the screen, so it covers no pixels"))
        json.array_add_raw(stages, stage("pixels", false, pixels))
        if broke_at == "" { broke_at = "pixels" }
    } else {
        measured = region_result(box.x as int, box.y as int,
                                 box.z as int, box.w as int, 0, 8)
        if measured != null {
            // Read before handing it over. The object takes ownership of what
            // is set on it, and reading the child back out afterwards found
            // nothing: the trace blamed the pixels stage of a model that was
            // plainly drawn, with the coverage it had just measured sitting in
            // the answer it printed.
            found = json.object_get_raw(measured, "coverage")
            if found != null { pixels_ok = json.get_number(found) > 0.0 }
            json.object_set_raw(pixels, "region", measured)
        }
        if !pixels_ok {
            json.object_set_raw(pixels, "note",
                json.str("the model projects here and nothing was drawn in it"))
        }
        json.array_add_raw(stages, stage("pixels", pixels_ok, pixels))
        if !pixels_ok && broke_at == "" { broke_at = "pixels" }
    }

    out = json.obj()
    json.object_set_raw(out, "name", json.str(core.text(m.name)))
    json.object_set_raw(out, "stages", stages)
    if broke_at == "" {
        json.object_set_raw(out, "ok", json.boolean(true))
    } else {
        json.object_set_raw(out, "ok", json.boolean(false))
        json.object_set_raw(out, "broke_at", json.str(broke_at))
    }
    return out
}

// The model a request names: by manifest id, by Blender object, or by the
// renderer's index -- the arguments trace.model and explain.model share.
model_from(c: *Context, request: ptr) -> *Model {
    m = null as *Model
    p = null
    named = json.object_get_raw(request, "id")
    if named != null { p = assets.provenance_by_id(json.get_string_raw(named)) }
    if p == null {
        named = json.object_get_raw(request, "object")
        if named != null { p = assets.provenance_by_object(json.get_string_raw(named)) }
    }
    if p != null { m = assets.provenance_model(p) }
    if m == null {
        indexed = json.object_get_raw(request, "index")
        if indexed != null { m = model_at(c, json.get_int(indexed)) }
    }
    return m
}

// --- explain.model -----------------------------------------------------------
//
// Why a model on screen looks the way it does. trace.model answers whether it
// reached the screen; this answers, once it has, why it is dark or the wrong
// colour there. Each stage carries its numbers -- the material, the texture's
// mean, the light each light brings, whether the key light is blocked, the
// exposure -- and the pixels it produced, and the verdict names the first stage
// whose numbers account for what the pixels show.
//
// The light is worked out as the default shader works it (direct_light and the
// ambient in shaders/module.ae): a light's colour by its temperature, a point
// light's fall-off and the reach past which the shader skips it, a spot light's
// cone, the diffuse over pi and the back fill. Specular, reflections and the
// scene's other effects only add to that, so a model darker than this predicts
// is darker than its lights alone would make it.

// What a stage being off would explain about the look.
const EXPLAINS_DARK = 1
const EXPLAINS_COLOUR = 2
// A texture that never loaded is drawn in white, which can read as right: it
// explains a wrong colour, and a look that only seems fine.
const EXPLAINS_UNSEEN = 3
// A surface that is nearly see-through reads as dark or as not there at all.
const EXPLAINS_CLEAR = 4

// What the pixels show.
const LOOK_AS_LIT = 0
const LOOK_DARK = 1
const LOOK_COLOUR = 2
const LOOK_MISSING = 3
// No frame to read: the stages still say what is off, the pixels cannot say
// whether it shows.
const LOOK_UNMEASURED = 4

// Display luminance, 0..1, under which a model reads as dark whatever it was
// lit to be, and the share of what it would show fully lit under which it
// reads as darker than its lights make it.
const DARK_LUMA = 0.15
const DARK_SHARE = 0.6
// A mean colour whose channels are this far apart reads as coloured.
const TINT = 0.2
// Linear albedo luminance under which a surface is as good as black.
const BLACK_ALBEDO = 0.03
// Direct light, as it multiplies the albedo, under which none reaches.
const DIRECT_MIN = 0.01
const LOW_EXPOSURE = 0.6
// Texels a side read for a texture's mean: 4096 of them is the colour of any
// image to three places, and a 4K map is not read whole to say so.
const TEXTURE_SAMPLES = 64
// The share of a model's projected size read for its colour, about its
// centre: the whole box around it is mostly what is behind it.
const CENTRE_SHARE = 0.35

struct Explanation {
    diffuse: Vec3
    // The diffuse over the texture's mean: what the light multiplies.
    albedo: Vec3
    alpha: float
    metallic: float
    emissive: bool
    has_material: bool
    texture_failed: bool
    texture_known: bool
    texture: Vec3                  // mean texel as the shader reads it; white with none
    // The light arriving, as it multiplies the albedo: onto an upward normal,
    // onto the side facing the camera, and from every direction.
    direct_top: Vec3
    direct_side: Vec3
    ambient: Vec3
    sun_below: bool
    blocker: ptr                   // the model between its centre and the key light
    exposure: float
    measured_ok: bool
    projects: bool
    coverage: float
    measured: Vec3                 // mean display colour about its centre, 0..1
    predicted: Vec3                // what that side would show fully lit, 0..1
    kind: int                      // what the note a stage last gave explains
}

round3(x: float) -> float {
    if x < 0.0 { return 0.0 - round3(0.0 - x) }
    return ((x * 1000.0 + 0.5) as long) as float / 1000.0
}

num3(x: float) -> ptr { return json.num(round3(x)) }

vec3_json3(v: Vec3) -> ptr { return vec3_json(round3(v.x), round3(v.y), round3(v.z)) }

colour_text(v: Vec3) -> string {
    return "(${round3(v.x)}, ${round3(v.y)}, ${round3(v.z)})"
}

luminance(v: Vec3) -> float { return 0.2126 * v.x + 0.7152 * v.y + 0.0722 * v.z }

// How far apart a colour's channels are: zero for a grey.
channel_spread(v: Vec3) -> float {
    high = v.x
    low = v.x
    if v.y > high { high = v.y }
    if v.z > high { high = v.z }
    if v.y < low { low = v.y }
    if v.z < low { low = v.z }
    return high - low
}

strongest_channel(v: Vec3) -> int {
    if v.x >= v.y && v.x >= v.z { return 0 }
    if v.y >= v.z { return 1 }
    return 2
}

// Whether `v` leans the way the material's own colour does: a red material
// drawn red is as authored, not the wrong colour.
leans_like(v: Vec3, material: Vec3) -> bool {
    return channel_spread(material) > 0.1 && strongest_channel(v) == strongest_channel(material)
}

tinted(a: Vec3, b: Vec3) -> Vec3 { return core.vec3(a.x * b.x, a.y * b.y, a.z * b.z) }

// The shader's kelvinToRGB.
kelvin_rgb(kelvin: float) -> Vec3 {
    k = kelvin
    if k < 1000.0 { k = 1000.0 }
    if k > 12000.0 { k = 12000.0 }
    if k < 3000.0 {
        return core.v3_lerp(core.vec3(1.0, 0.4, 0.0), core.vec3(1.0, 0.7, 0.3), (k - 1000.0) / 2000.0)
    }
    if k < 6500.0 {
        return core.v3_lerp(core.vec3(1.0, 0.7, 0.3), core.vec3(1.0, 1.0, 1.0), (k - 3000.0) / 3500.0)
    }
    return core.v3_lerp(core.vec3(1.0, 1.0, 1.0), core.vec3(0.7, 0.8, 1.0), (k - 6500.0) / 5500.0)
}

smooth_step(edge0: float, edge1: float, x: float) -> float {
    if edge1 <= edge0 {
        if x < edge0 { return 0.0 }
        return 1.0
    }
    t = (x - edge0) / (edge1 - edge0)
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    return t * t * (3.0 - 2.0 * t)
}

// One channel through the shader's tone curve and gamma: linear light to
// what the frame holds, 0..1.
displayed(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    mapped = (x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14)
    if mapped > 1.0 { mapped = 1.0 }
    return pow(mapped, 1.0 / 2.2)
}

explain_material(m: *Model, ex: *Explanation) -> ptr {
    detail = json.obj()
    ex.diffuse = core.vec3(1.0, 1.0, 1.0)
    ex.alpha = 1.0
    ex.exposure = 1.0
    surface = model_surface(m)
    if surface == null {
        json.object_set_raw(detail, "note", json.str("no material: drawn in the default white"))
        return detail
    }
    ex.has_material = true
    ex.diffuse = surface.diffuse
    ex.alpha = surface.alpha
    ex.metallic = surface.metallic
    ex.exposure = surface.exposure
    // The shader's own switch: past 10 the material is its own light.
    ex.emissive = surface.exposure > 10.0
    json.object_set_raw(detail, "name", json.str(core.text(surface.name)))
    json.object_set_raw(detail, "diffuse", vec3_json3(surface.diffuse))
    json.object_set_raw(detail, "luminance", num3(luminance(surface.diffuse)))
    json.object_set_raw(detail, "metallic", num3(surface.metallic))
    json.object_set_raw(detail, "roughness", num3(surface.roughness))
    json.object_set_raw(detail, "alpha", num3(surface.alpha))
    json.object_set_raw(detail, "reflectivity", num3(surface.reflectivity))
    json.object_set_raw(detail, "emissive", json.boolean(ex.emissive))
    if core.model_group_count(m) > 1 {
        json.object_set_raw(detail, "groups", json.from_int(core.model_group_count(m)))
    }
    return detail
}

material_note(ex: *Explanation) -> string {
    if !ex.has_material { return "" }
    if ex.alpha < 0.1 {
        ex.kind = EXPLAINS_CLEAR
        return "its alpha is ${round3(ex.alpha)}: it is nearly see-through"
    }
    if luminance(ex.diffuse) < BLACK_ALBEDO {
        ex.kind = EXPLAINS_DARK
        return "its albedo is ${colour_text(ex.diffuse)}, luminance ${round3(luminance(ex.diffuse))}"
    }
    if ex.metallic >= 0.9 {
        ex.kind = EXPLAINS_DARK
        return "it is a metal (metallic ${round3(ex.metallic)}): it has no diffuse colour and shows only what it reflects"
    }
    return ""
}

// What the texture adds: whether one is bound, whether it loaded, and its mean
// colour as the shader reads it. Both renderers upload a texture's bytes as they
// are, so the mean the shader multiplies the albedo by is the bytes over 255.
explain_texture(m: *Model, ex: *Explanation) -> ptr {
    detail = json.obj()
    ex.texture = core.vec3(1.0, 1.0, 1.0)
    ex.texture_known = true
    surface = model_surface(m)
    path = ""
    if surface != null { path = core.text(surface.texture_path) }
    json.object_set_raw(detail, "path", json.str(path))
    if path == "" {
        json.object_set_raw(detail, "bound", json.boolean(false))
        json.object_set_raw(detail, "note",
            json.str("no texture: the material's colour is drawn over the default white"))
        return detail
    }
    json.object_set_raw(detail, "bound", json.boolean(true))
    loaded = surface.texture_id != 0
    json.object_set_raw(detail, "loaded", json.boolean(loaded))
    if !loaded {
        ex.texture_failed = true
        json.object_set_raw(detail, "drawn", json.str("the default white"))
    }
    texture_mean(path, ex, detail)
    // What is drawn is the white the renderer fell back to, whatever the
    // file holds.
    if !loaded { ex.texture = core.vec3(1.0, 1.0, 1.0) }
    return detail
}

// A texture's texels, read again from its file: a renderer uploads them and
// keeps only the handle, so what an image looks like on average is asked of
// the file the material names.
texture_mean(path: string, ex: *Explanation, detail: ptr) {
    image = picture.load(path)
    if image == null {
        ex.texture_known = false
        json.object_set_raw(detail, "mean", json.str("unknown"))
        json.object_set_raw(detail, "note",
            json.str("the file does not decode here, so its texels are not known"))
        return
    }
    width = picture.width(image)
    height = picture.height(image)
    texels = picture.pixels(image)
    json.object_set_raw(detail, "width", json.from_int(width))
    json.object_set_raw(detail, "height", json.from_int(height))
    if texels == null || width <= 0 || height <= 0 {
        picture.dispose(image)
        ex.texture_known = false
        json.object_set_raw(detail, "mean", json.str("unknown"))
        return
    }
    texel = texels as uint8[]
    across = TEXTURE_SAMPLES
    if width < across { across = width }
    down = TEXTURE_SAMPLES
    if height < down { down = height }
    red = 0.0
    green = 0.0
    blue = 0.0
    y = 0
    while y < down {
        row = (y * height + height / 2) / down
        x = 0
        while x < across {
            column = (x * width + width / 2) / across
            at = (row * width + column) * 4
            red = red + (texel[at] as float)
            green = green + (texel[at + 1] as float)
            blue = blue + (texel[at + 2] as float)
            x = x + 1
        }
        y = y + 1
    }
    picture.dispose(image)
    samples = (across * down) as float
    ex.texture = core.vec3(red / samples / 255.0, green / samples / 255.0, blue / samples / 255.0)
    json.object_set_raw(detail, "mean", vec3_json3(ex.texture))
    json.object_set_raw(detail, "luminance", num3(luminance(ex.texture)))
}

texture_note(ex: *Explanation, m: *Model) -> string {
    if ex.texture_failed {
        ex.kind = EXPLAINS_UNSEEN
        surface = model_surface(m)
        return "its texture ${core.text(surface.texture_path)} never loaded; the default white is drawn in its place"
    }
    if !ex.texture_known { return "" }
    if luminance(ex.texture) < BLACK_ALBEDO {
        ex.kind = EXPLAINS_DARK
        return "its texture's mean is ${colour_text(ex.texture)}, luminance ${round3(luminance(ex.texture))}"
    }
    if channel_spread(ex.texture) > TINT && !leans_like(ex.texture, ex.diffuse) {
        ex.kind = EXPLAINS_COLOUR
        return "its texture's mean is ${colour_text(ex.texture)}"
    }
    return ""
}

// Every light at the model's centre, onto its top and onto the side facing the
// camera, and the ambient the key light brings.
explain_light(c: *Context, m: *Model, ex: *Explanation) -> ptr {
    detail = json.obj()
    centre = m.bounding_center
    up = core.vec3(0.0, 1.0, 0.0)
    side = up
    if c.camera != null {
        cam = c.camera as *Camera
        toward = core.v3_sub(cam.position, centre)
        if core.v3_len(toward) > 0.0001 { side = core.v3_normalize(toward) }
    }
    side = facing_normal(c, m, side)
    json.object_set_raw(detail, "side_normal", vec3_json3(side))
    ex.direct_top = core.vec3(0.0, 0.0, 0.0)
    ex.direct_side = core.vec3(0.0, 0.0, 0.0)
    ex.ambient = core.vec3(0.0, 0.0, 0.0)
    lights = json.arr()
    count = light_count(c)
    i = 0
    while i < count {
        l = light_at(c, i)
        if l != null { json.array_add_raw(lights, light_reaching(l, i, centre, up, side, ex)) }
        i = i + 1
    }
    // The ambient is the key light's alone, as the shader has it: lights[0].
    key = light_at(c, 0)
    if key != null {
        ex.ambient = core.v3_mul(tinted(key.color, kelvin_rgb(key.temperature)),
                                 key.ambient_strength * 0.8)
        ex.sun_below = key.mode == core.MODE_DIRECTIONAL && key.direction.y < 0.0
    }
    json.object_set_raw(detail, "lights", lights)
    json.object_set_raw(detail, "direct_top", vec3_json3(ex.direct_top))
    json.object_set_raw(detail, "direct_side", vec3_json3(ex.direct_side))
    json.object_set_raw(detail, "ambient", vec3_json3(ex.ambient))
    json.object_set_raw(detail, "direct_top_luminance", num3(luminance(ex.direct_top)))
    json.object_set_raw(detail, "direct_side_luminance", num3(luminance(ex.direct_side)))
    json.object_set_raw(detail, "ambient_luminance", num3(luminance(ex.ambient)))
    if ex.sun_below { json.object_set_raw(detail, "sun_below_horizon", json.boolean(true)) }
    if ex.emissive {
        json.object_set_raw(detail, "note", json.str("emissive: drawn at its own colour, not shaded by these"))
    }
    return detail
}

// The surface the camera sees at the model's centre: the first of its
// triangles a ray from the eye through the centre meets, its normal turned to
// the eye. A face is lit by the way the face points, not by the direction to
// the camera, and for a cube seen off its axis the two differ by most of the
// sun. The direction to the eye stands in where the ray meets none of them:
// a crowd's instances, a skinned figure away from its bind pose.
facing_normal(c: *Context, m: *Model, fallback: Vec3) -> Vec3 {
    if c.camera == null || m.mesh == null || m.is_instanced { return fallback }
    cam = c.camera as *Camera
    gap = core.v3_sub(m.bounding_center, cam.position)
    length = core.v3_len(gap)
    if length < 0.0001 { return fallback }
    heading = core.v3_mul(gap, 1.0 / length)
    normal = fallback
    nearest = 0.0 - 1.0
    indices = core.mesh_index_count(m.mesh)
    i = 0
    while i + 2 < indices {
        a = core.mat4_transform_point(m.model_matrix, core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i)))
        b = core.mat4_transform_point(m.model_matrix, core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i + 1)))
        d = core.mat4_transform_point(m.model_matrix, core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i + 2)))
        at = raycast.triangle(cam.position, heading, a, b, d)
        if raycast.hit(at) && (nearest < 0.0 || at < nearest) {
            face = core.v3_cross(core.v3_sub(b, a), core.v3_sub(d, a))
            if core.v3_len(face) > 0.0 {
                face = core.v3_normalize(face)
                if core.v3_dot(face, heading) > 0.0 { face = core.v3_neg(face) }
                normal = face
                nearest = at
            }
        }
        i = i + 3
    }
    return normal
}

// One light's part: what arrives onto the top and onto the side facing the
// camera, as it multiplies the albedo, and why it is nothing when it is.
light_reaching(l: *Light, index: int, centre: Vec3, up: Vec3, side: Vec3, ex: *Explanation) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "index", json.from_int(index))
    json.object_set_raw(out, "name", json.str(core.text(l.name)))
    colour = tinted(l.color, kelvin_rgb(l.temperature))
    toward = up
    strength = 1.0
    reaches = true
    note = ""
    if l.mode == core.MODE_DIRECTIONAL {
        json.object_set_raw(out, "mode", json.str("directional"))
        toward = core.v3_normalize(l.direction)
        if toward.y < 0.0 { note = "below the horizon" }
    } else {
        if l.mode == core.MODE_SPOT {
            json.object_set_raw(out, "mode", json.str("spot"))
        } else {
            json.object_set_raw(out, "mode", json.str("point"))
        }
        gap = core.v3_sub(l.position, centre)
        distance = core.v3_len(gap)
        if distance > 0.0001 { toward = core.v3_mul(gap, 1.0 / distance) }
        json.object_set_raw(out, "distance", num3(distance))
        strength = 1.0 / (l.constant_atten + l.linear_atten * distance +
                          l.quadratic_atten * distance * distance)
        // Where the shader stops shading it: the fall-off has left under a
        // sixty-fourth of the light by then.
        if l.quadratic_atten > 0.0 {
            reach = 8.0 / core.sqrt_of(l.quadratic_atten)
            json.object_set_raw(out, "reach", num3(reach))
            if distance > reach {
                reaches = false
                note = "out of reach: ${round3(distance)} m away, its light stops at ${round3(reach)} m"
            }
        }
        if reaches && l.mode == core.MODE_SPOT {
            on_axis = core.v3_dot(core.v3_neg(toward), core.v3_normalize(l.direction))
            if on_axis < l.spot_cos_outer {
                reaches = false
                note = "outside its cone"
            } else {
                strength = strength * smooth_step(l.spot_cos_outer, l.spot_cos_inner, on_axis)
            }
        }
    }
    onto_top = core.vec3(0.0, 0.0, 0.0)
    onto_side = core.vec3(0.0, 0.0, 0.0)
    if reaches {
        radiance = core.v3_mul(colour, l.intensity * strength)
        onto_top = light_onto(radiance, colour, up, toward)
        onto_side = light_onto(radiance, colour, side, toward)
        json.object_set_raw(out, "radiance", num3(luminance(radiance)))
        if note == "" && luminance(radiance) > DIRECT_MIN &&
           core.v3_dot(up, toward) <= 0.0 && core.v3_dot(side, toward) <= 0.0 {
            note = "behind it: it lights neither its top nor the side facing the camera"
        }
    }
    ex.direct_top = core.v3_add(ex.direct_top, onto_top)
    ex.direct_side = core.v3_add(ex.direct_side, onto_side)
    json.object_set_raw(out, "onto_top", num3(luminance(onto_top)))
    json.object_set_raw(out, "onto_side", num3(luminance(onto_side)))
    if note != "" { json.object_set_raw(out, "note", json.str(note)) }
    return out
}

// A light onto one normal: the diffuse over pi where it faces the light, and
// the shader's fill from behind (a fifth of the light's colour, by how far it
// faces away, and not by its strength) where it does not.
light_onto(radiance: Vec3, colour: Vec3, normal: Vec3, toward: Vec3) -> Vec3 {
    facing = core.v3_dot(normal, toward)
    if facing >= 0.0 { return core.v3_mul(radiance, facing / 3.14159265359) }
    return core.v3_mul(colour, (0.0 - facing) * 0.3 * 0.2)
}

light_note(ex: *Explanation) -> string {
    if ex.emissive { return "" }
    ambient = round3(luminance(ex.ambient))
    if luminance(ex.direct_side) < DIRECT_MIN {
        ex.kind = EXPLAINS_DARK
        if luminance(ex.direct_top) >= DIRECT_MIN {
            return "no direct light reaches the side facing the camera (its top takes ${round3(luminance(ex.direct_top))}) and the ambient is ${ambient}"
        }
        if ex.sun_below {
            return "no direct light reaches it, the sun is below the horizon, and the ambient is ${ambient}"
        }
        return "no direct light reaches it and the ambient is ${ambient}"
    }
    // The light's own colour, when it leans away from grey more than the
    // material asks for.
    arriving = core.v3_add(ex.direct_side, ex.ambient)
    brightest = arriving.x
    if arriving.y > brightest { brightest = arriving.y }
    if arriving.z > brightest { brightest = arriving.z }
    if brightest > 0.0 {
        hue = core.v3_mul(arriving, 1.0 / brightest)
        if channel_spread(hue) > TINT * 2.0 && !leans_like(hue, ex.diffuse) {
            ex.kind = EXPLAINS_COLOUR
            return "the light reaching it is ${colour_text(hue)}"
        }
    }
    return ""
}

// Whether the model's centre, and its top, can see the key light: the one
// light the shadow map is drawn for, and the one whose shadow takes every
// light's direct share in the shader. A ray toward it against every other
// model's triangles names what is in the way.
explain_shadow(c: *Context, m: *Model, ex: *Explanation) -> ptr {
    detail = json.obj()
    json.object_set_raw(detail, "shadows", json.boolean(c.shadows))
    key = light_at(c, 0)
    if !c.shadows {
        json.object_set_raw(detail, "note", json.str("shadows are off"))
        return detail
    }
    if key == null {
        json.object_set_raw(detail, "note", json.str("there is no key light to cast one"))
        return detail
    }
    json.object_set_raw(detail, "key_light", json.str(core.text(key.name)))
    centre = m.bounding_center
    top = centre
    if m.mesh != null {
        size = core.mesh_size(m.mesh, m.scale)
        top = core.v3_add(centre, core.vec3(0.0, size.y * 0.49, 0.0))
    }
    through_centre = shadow_blocker(c, m, centre, key)
    through_top = shadow_blocker(c, m, top, key)
    if through_centre != null {
        json.object_set_raw(detail, "centre_blocked_by", json.str(core.text(through_centre.name)))
    } else {
        json.object_set_raw(detail, "centre_blocked_by", json.null_value())
    }
    if through_top != null {
        json.object_set_raw(detail, "top_blocked_by", json.str(core.text(through_top.name)))
    } else {
        json.object_set_raw(detail, "top_blocked_by", json.null_value())
    }
    ex.blocker = through_centre as ptr
    return detail
}

// The nearest model a ray from `origin` toward `key` meets before the light,
// or null. Crowds are left out: their figures are instances the model's own
// matrix does not place.
shadow_blocker(c: *Context, m: *Model, origin: Vec3, key: *Light) -> *Model {
    heading = core.v3_normalize(key.direction)
    far = 0.0 - 1.0
    if key.mode != core.MODE_DIRECTIONAL {
        gap = core.v3_sub(key.position, origin)
        far = core.v3_len(gap)
        if far < 0.0001 { return null }
        heading = core.v3_mul(gap, 1.0 / far)
    }
    nearest = null as *Model
    nearest_at = 0.0
    count = model_count(c)
    i = 0
    while i < count {
        other = model_at(c, i)
        if other != null && other != m && other.visible && other.casts_shadow &&
           other.mesh != null && !other.is_instanced {
            at = raycast.model_mesh(origin, heading, other)
            if raycast.hit(at) && (far < 0.0 || at < far) {
                if nearest == null || at < nearest_at {
                    nearest = other
                    nearest_at = at
                }
            }
        }
        i = i + 1
    }
    return nearest
}

shadow_note(ex: *Explanation) -> string {
    if ex.emissive || ex.blocker == null { return "" }
    // A shadow takes only the direct light; with none arriving there is
    // nothing for it to take.
    if luminance(ex.direct_side) < DIRECT_MIN && luminance(ex.direct_top) < DIRECT_MIN { return "" }
    ex.kind = EXPLAINS_DARK
    blocker = ex.blocker as *Model
    return "in the shadow of ${core.text(blocker.name)}"
}

explain_exposure(c: *Context, ex: *Explanation) -> ptr {
    detail = json.obj()
    json.object_set_raw(detail, "material", num3(ex.exposure))
    json.object_set_raw(detail, "frame", num3(c.frame_exposure))
    json.object_set_raw(detail, "eye_adaptation", json.boolean(c.eye_adaptation))
    json.object_set_raw(detail, "total", num3(exposure_total(c, ex)))
    return detail
}

// The factor the lit colour is scaled by before the tone curve. An emissive
// material's exposure is its strength, a tenth of it being 1.
exposure_total(c: *Context, ex: *Explanation) -> float {
    if ex.emissive { return ex.exposure * 0.1 * c.frame_exposure }
    return ex.exposure * c.frame_exposure
}

exposure_note(c: *Context, ex: *Explanation) -> string {
    total = exposure_total(c, ex)
    if total >= LOW_EXPOSURE { return "" }
    ex.kind = EXPLAINS_DARK
    if c.eye_adaptation && c.frame_exposure < LOW_EXPOSURE {
        return "the eye adaptation has the exposure at ${round3(c.frame_exposure)}"
    }
    return "the exposure is ${round3(total)}"
}

// What the side facing the camera would show with every light reaching it and
// no shadow: the prediction the measured pixels are held against.
predict(c: *Context, ex: *Explanation) {
    arriving = core.v3_add(core.v3_mul(ex.direct_side, 1.0 - ex.metallic), ex.ambient)
    if ex.emissive { arriving = core.vec3(1.0, 1.0, 1.0) }
    linear = core.v3_mul(tinted(ex.albedo, arriving), exposure_total(c, ex))
    ex.predicted = core.vec3(displayed(linear.x), displayed(linear.y), displayed(linear.z))
}

// The pixels: how much of where it projects was drawn, and the mean colour
// about its centre.
explain_pixels(c: *Context, m: *Model, ex: *Explanation) -> ptr {
    detail = json.obj()
    if capture.width() == 0 {
        json.object_set_raw(detail, "note", json.str("the frame could not be read"))
        return detail
    }
    ex.measured_ok = true
    box = Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
    if !model_screen_box(c, m, &box) {
        json.object_set_raw(detail, "note",
            json.str("the model does not project to the screen, so it covers no pixels"))
        return detail
    }
    ex.projects = true
    block = capture_doubles()
    if capture.region(box.x as int, box.y as int, box.z as int, box.w as int, 0, 8, block) == 1 {
        ex.coverage = read_double(block, 4)
    }
    json.object_set_raw(detail, "region", region_json(box.x, box.y, box.z, box.w))
    json.object_set_raw(detail, "coverage", num3(ex.coverage))

    across = box.z
    if box.w < across { across = box.w }
    half = across * CENTRE_SHARE * 0.5
    if half < 0.5 { half = 0.5 }
    middle_x = box.x + box.z * 0.5
    middle_y = box.y + box.w * 0.5
    cam = c.camera as *Camera
    centre = core.camera_world_to_screen(cam, m.bounding_center, c.width, c.height)
    if centre.w > 0.0001 {
        middle_x = centre.x
        middle_y = centre.y
    }
    left = (middle_x - half) as int
    top = (middle_y - half) as int
    size = (half * 2.0) as int
    if size < 1 { size = 1 }
    if capture.region(left, top, size, size, 0, 8, block) == 1 {
        ex.measured = core.vec3(read_double(block, 0), read_double(block, 1), read_double(block, 2))
        json.object_set_raw(detail, "centre", region_json(left as float, top as float,
                                                          size as float, size as float))
    }
    free(block)
    json.object_set_raw(detail, "mean", vec3_json3(ex.measured))
    json.object_set_raw(detail, "luminance", num3(luminance(ex.measured)))
    json.object_set_raw(detail, "predicted", vec3_json3(ex.predicted))
    json.object_set_raw(detail, "predicted_luminance", num3(luminance(ex.predicted)))
    return detail
}

look_of(ex: *Explanation) -> int {
    if !ex.measured_ok { return LOOK_UNMEASURED }
    if !ex.projects || ex.coverage <= 0.0 { return LOOK_MISSING }
    seen = luminance(ex.measured)
    if seen < DARK_LUMA || seen < luminance(ex.predicted) * DARK_SHARE { return LOOK_DARK }
    if channel_spread(ex.measured) > TINT && !leans_like(ex.measured, ex.diffuse) { return LOOK_COLOUR }
    return LOOK_AS_LIT
}

look_name(look: int) -> string {
    if look == LOOK_DARK { return "dark" }
    if look == LOOK_COLOUR { return "wrong colour" }
    if look == LOOK_MISSING { return "missing" }
    if look == LOOK_UNMEASURED { return "unmeasured" }
    return "as lit"
}

// Whether a stage's finding accounts for the look, and the word the verdict
// opens with when it does.
accounts_for(kind: int, look: int) -> bool {
    if kind == EXPLAINS_DARK { return look == LOOK_DARK || look == LOOK_UNMEASURED }
    if kind == EXPLAINS_COLOUR { return look == LOOK_COLOUR || look == LOOK_UNMEASURED }
    if kind == EXPLAINS_UNSEEN {
        return look == LOOK_COLOUR || look == LOOK_AS_LIT || look == LOOK_UNMEASURED
    }
    if kind == EXPLAINS_CLEAR {
        return look == LOOK_DARK || look == LOOK_MISSING || look == LOOK_UNMEASURED
    }
    return false
}

verdict_word(kind: int, look: int) -> string {
    if look == LOOK_MISSING { return "missing" }
    if kind == EXPLAINS_DARK || kind == EXPLAINS_CLEAR { return "dark" }
    return "wrong colour"
}

finding(name: string, flagged: bool, note: string, detail: ptr) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "stage", json.str(name))
    json.object_set_raw(out, "flagged", json.boolean(flagged))
    if flagged { json.object_set_raw(out, "finding", json.str(note)) }
    json.object_set_raw(out, "detail", detail)
    return out
}

explain_result(c: *Context, m: *Model) -> ptr {
    ex = heap.new(Explanation)
    stages = json.arr()
    verdict = ""
    blamed = ""

    // The stages first, then the pixels: the prediction the pixels are held
    // against needs every number above them.
    material = explain_material(m, ex)
    ex.kind = 0
    material_says = material_note(ex)
    material_kind = ex.kind

    texturing = explain_texture(m, ex)
    ex.albedo = tinted(ex.diffuse, ex.texture)
    ex.kind = 0
    texture_says = texture_note(ex, m)
    texture_kind = ex.kind

    lighting = explain_light(c, m, ex)
    ex.kind = 0
    light_says = light_note(ex)
    light_kind = ex.kind

    shadow = explain_shadow(c, m, ex)
    ex.kind = 0
    shadow_says = shadow_note(ex)
    shadow_kind = ex.kind

    exposing = explain_exposure(c, ex)
    ex.kind = 0
    exposure_says = exposure_note(c, ex)
    exposure_kind = ex.kind

    predict(c, ex)
    pixels = explain_pixels(c, m, ex)
    look = look_of(ex)

    // The first stage whose finding accounts for what the pixels show.
    if accounts_for(material_kind, look) {
        verdict = "${verdict_word(material_kind, look)}: ${material_says}"
        blamed = "material"
    } else if accounts_for(texture_kind, look) {
        verdict = "${verdict_word(texture_kind, look)}: ${texture_says}"
        blamed = "texture"
    } else if accounts_for(light_kind, look) {
        verdict = "${verdict_word(light_kind, look)}: ${light_says}"
        blamed = "light"
    } else if accounts_for(shadow_kind, look) {
        verdict = "${verdict_word(shadow_kind, look)}: ${shadow_says}"
        blamed = "shadow"
    } else if accounts_for(exposure_kind, look) {
        verdict = "${verdict_word(exposure_kind, look)}: ${exposure_says}"
        blamed = "exposure"
    } else if look == LOOK_MISSING {
        verdict = "missing: nothing was drawn where it projects; see trace.model"
        blamed = "pixels"
    } else if look == LOOK_DARK || look == LOOK_COLOUR {
        // Honest about it: the look is off and no stage here says why.
        verdict = "${look_name(look)}: no stage accounts for it (luminance ${round3(luminance(ex.measured))}, ${round3(luminance(ex.predicted))} fully lit)"
    } else if look == LOOK_UNMEASURED {
        verdict = "unmeasured: the frame could not be read, and no stage finds anything off"
    } else if material_kind != 0 {
        // A finding the pixels do not bear out is still worth saying: a shadow
        // the geometry says is there and the frame does not show is the
        // renderer's to answer for.
        verdict = "as lit; not shown in the pixels: ${material_says}"
    } else if texture_kind != 0 {
        verdict = "as lit; not shown in the pixels: ${texture_says}"
    } else if light_kind != 0 {
        verdict = "as lit; not shown in the pixels: ${light_says}"
    } else if shadow_kind != 0 {
        verdict = "as lit; not shown in the pixels: ${shadow_says}"
    } else if exposure_kind != 0 {
        verdict = "as lit; not shown in the pixels: ${exposure_says}"
    } else {
        verdict = "as lit"
    }

    json.array_add_raw(stages, finding("material", material_kind != 0, material_says, material))
    json.array_add_raw(stages, finding("texture", texture_kind != 0, texture_says, texturing))
    json.array_add_raw(stages, finding("light", light_kind != 0, light_says, lighting))
    json.array_add_raw(stages, finding("shadow", shadow_kind != 0, shadow_says, shadow))
    json.array_add_raw(stages, finding("exposure", exposure_kind != 0, exposure_says, exposing))
    json.array_add_raw(stages, finding("pixels", false, "", pixels))

    out = json.obj()
    json.object_set_raw(out, "name", json.str(core.text(m.name)))
    json.object_set_raw(out, "stages", stages)
    json.object_set_raw(out, "look", json.str(look_name(look)))
    json.object_set_raw(out, "verdict", json.str(verdict))
    if blamed != "" { json.object_set_raw(out, "blamed", json.str(blamed)) }
    heap.free(ex)
    return out
}

handle(c: *Context, op: string, id: int, request: ptr) -> bool {
    if op == "help"        { answer(id, help_result()) return false }
    if op == "ping"        { answer(id, json.obj()) return false }
    if op == "frame.stats" { answer(id, stats_result(c)) return false }
    if op == "camera.get"  { answer(id, camera_result(c)) return false }
    if op == "scene.tree" {
        node = json.object_get_raw(request, "detail")
        audited = json.object_get_raw(request, "audit")
        answer(id, tree_result(c, node != null && json.get_bool(node) == 1,
                               audited != null && json.get_bool(audited) == 1))
        return false
    }

    // A figure's bones, which are the only part of it that moves.
    //
    // Nothing else can answer this. The skinned mesh sits at the origin in its
    // bind pose, so scene.tree describes a figure standing still; where a foot
    // is, whether it is on the road, and whether it slides while it is there
    // are facts about the bones. Without them an agent can see that a figure
    // is animated and not whether the animation is any good.
    // How hard normal maps push, for the whole scene.
    //
    // Here because a map that is loaded and a map that reaches the picture are
    // different facts, and the only way to tell them apart is to turn it off
    // and see whether anything moved. Zero is the geometry's own normal, which
    // is what the renderer did before it could do this.
    if op == "render.set" {
        node = json.object_get_raw(request, "normal_strength")
        shading = json.object_get_raw(request, "occlusion_strength")
        blooming = json.object_get_raw(request, "bloom_intensity")
        shadowing = json.object_get_raw(request, "shadows")
        reflecting = json.object_get_raw(request, "ssr")
        ssr_road = json.object_get_raw(request, "ssr_road_height")
        ssr_str = json.object_get_raw(request, "ssr_strength")
        clouding = json.object_get_raw(request, "clouds")
        casting = json.object_get_raw(request, "overcast")
        if node == null && shading == null && blooming == null && shadowing == null &&
           reflecting == null && ssr_road == null && ssr_str == null &&
           clouding == null && casting == null {
            fail(id, "render.set needs something to set")
            return false
        }
        out = json.obj()
        // The sky a weather brings, by hand: the clouds' cover and drift,
        // and the overcast's amount and colour, on either backend.
        if clouding != null {
            cover = json.get_number(clouding)
            wind = number_at(request, "cloud_wind", 1.0)
            if c.gl_renderer != null {
                gl.renderer_set_clouds(c.gl_renderer as *GLRenderer, cover, wind)
            }
            if c.vk_renderer != null {
                vulkan.renderer_set_clouds(c.vk_renderer as *VKRenderer, cover, wind)
            }
            json.object_set_raw(out, "clouds", json.num(cover))
            json.object_set_raw(out, "cloud_wind", json.num(wind))
        }
        if casting != null {
            amount = json.get_number(casting)
            tint = core.vec3(0.5, 0.5, 0.5)
            tinted = json.object_get_raw(request, "overcast_color")
            if tinted != null && json.array_size(tinted) >= 3 {
                tint = core.vec3(json.get_number(json.array_get_raw(tinted, 0)),
                                 json.get_number(json.array_get_raw(tinted, 1)),
                                 json.get_number(json.array_get_raw(tinted, 2)))
            }
            if c.gl_renderer != null {
                gl.renderer_set_sky_overcast(c.gl_renderer as *GLRenderer, amount, tint)
            }
            if c.vk_renderer != null {
                vulkan.renderer_set_sky_overcast(c.vk_renderer as *VKRenderer, amount, tint)
            }
            json.object_set_raw(out, "overcast", json.num(amount))
            json.object_set_raw(out, "overcast_color", vec3_json(tint.x, tint.y, tint.z))
        }
        if node != null {
            strength = json.get_number(node)
            if c.gl_renderer != null {
                gl.renderer_set_normal_strength(c.gl_renderer as *GLRenderer, strength)
            }
            if c.vk_renderer != null {
                vulkan.renderer_set_normal_strength(c.vk_renderer as *VKRenderer, strength)
            }
            json.object_set_raw(out, "normal_strength", json.num(strength))
        }
        if shading != null {
            strength = json.get_number(shading)
            if c.gl_renderer != null {
                gl.renderer_set_occlusion_strength(c.gl_renderer as *GLRenderer, strength)
            }
            if c.vk_renderer != null {
                vulkan.renderer_set_occlusion_strength(c.vk_renderer as *VKRenderer, strength)
            }
            json.object_set_raw(out, "occlusion_strength", json.num(strength))
        }
        if blooming != null {
            strength = json.get_number(blooming)
            if c.gl_renderer != null {
                gl.renderer_set_bloom_intensity(c.gl_renderer as *GLRenderer, strength)
            }
            if c.vk_renderer != null {
                vulkan.renderer_set_bloom_intensity(c.vk_renderer as *VKRenderer, strength)
            }
            json.object_set_raw(out, "bloom_intensity", json.num(strength))
        }
        if shadowing != null {
            on = json.get_bool(shadowing) == 1
            if c.gl_renderer != null {
                gl.renderer_set_shadows(c.gl_renderer as *GLRenderer, on)
            }
            if c.vk_renderer != null {
                vulkan.renderer_set_shadows(c.vk_renderer as *VKRenderer, on)
            }
            json.object_set_raw(out, "shadows", json.boolean(on))
        }
        // Screen-space reflection lives on the Vulkan backend (the OpenGL path
        // is a later step), so these apply there and are a no-op on OpenGL.
        if ssr_road != null || ssr_str != null {
            height = 0.0
            if ssr_road != null { height = json.get_number(ssr_road) }
            strength = 0.6
            if ssr_str != null { strength = json.get_number(ssr_str) }
            if c.vk_renderer != null {
                vulkan.renderer_set_ssr_params(c.vk_renderer as *VKRenderer, height, strength)
            }
            json.object_set_raw(out, "ssr_road_height", json.num(height))
            json.object_set_raw(out, "ssr_strength", json.num(strength))
        }
        if reflecting != null {
            on = json.get_bool(reflecting) == 1
            if c.vk_renderer != null {
                vulkan.renderer_set_ssr(c.vk_renderer as *VKRenderer, on)
            }
            json.object_set_raw(out, "ssr", json.boolean(on))
        }
        answer(id, out)
        return false
    }

    if op == "scene.skeleton" {
        named = json.object_get_raw(request, "object")
        if named == null {
            fail(id, "scene.skeleton needs an object")
            return false
        }
        found = find_skeleton(c, json.get_string_raw(named))
        if found == null {
            fail(id, "no skinned model by that name")
            return false
        }
        // Deferred to the frame boundary, like every read about what was
        // drawn. A pose is finished in three steps -- the clips are applied,
        // then whatever poses the figure afterwards runs, then it is drawn --
        // and answering the moment the question arrives can land between two of
        // them. It did: a hand read half a metre from where it was, in one
        // sample out of a thousand, which is exactly the kind of wrong answer
        // that gets believed.
        return defer_skeleton(c, id, found)
    }

    if op == "anim.track" {
        // The whole of a bone's path through a span of the animation, in one
        // answer. scene.skeleton reads one finished pose; asking it once a
        // frame for a thousand frames spends a thousand round trips, each
        // waiting out a frame at the boundary, which is minutes on a software
        // renderer. Here the pose pipeline a drawn frame runs -- the clips
        // applied at the time, then the scene's own solve on top -- is replayed
        // for each requested time and every bone read, without a frame in
        // between. The playheads are put back at the end, so a paused agent
        // finds the pose it left.
        named = json.object_get_raw(request, "object")
        times_node = json.object_get_raw(request, "times")
        if named == null || times_node == null {
            fail(id, "anim.track needs an object and a list of times")
            return false
        }
        skeleton = find_skeleton(c, json.get_string_raw(named))
        if skeleton == null {
            fail(id, "no skinned model by that name")
            return false
        }
        registry = c.animations as *Registry
        bindings = anim.registry_count(registry)
        saved = core.farr_create(bindings)
        b = 0
        while b < bindings {
            core.farr_set(saved, b, anim.player_time(anim.binding_player(anim.registry_binding(registry, b))))
            b = b + 1
        }

        samples = json.arr()
        moments = json.array_size(times_node)
        s = 0
        while s < moments {
            t = json.get_number(json.array_get_raw(times_node, s))
            pose_all_at(c, t)
            entry = json.obj()
            json.object_set_raw(entry, "time", json.num(t))
            json.object_set_raw(entry, "bones", skeleton_positions(skeleton as *Skeleton))
            json.array_add_raw(samples, entry)
            s = s + 1
        }

        // Back to where the agent had it, pose and all.
        b = 0
        while b < bindings {
            anim.player_set_time(anim.binding_player(anim.registry_binding(registry, b)), core.farr_get(saved, b))
            b = b + 1
        }
        core.farr_destroy(saved)
        anim.registry_apply(registry)
        if c.on_pose != null { c.on_pose(c.user_data) }

        out = json.obj()
        json.object_set_raw(out, "object", json.str(json.get_string_raw(named)))
        json.object_set_raw(out, "samples", samples)
        answer(id, out)
        return false
    }

    // Show one model and hide the rest, or show everything again. Measuring a
    // surface means seeing only that surface, and doing it a model at a time
    // was two calls per model per measurement.
    if op == "scene.isolate" {
        named = json.object_get_raw(request, "object")
        wanted = ""
        if named != null { wanted = json.get_string_raw(named) }
        shown = 0
        count = model_count(c)
        i = 0
        while i < count {
            m = model_at(c, i)
            if m != null {
                on = wanted == "" || core.text(m.name) == wanted
                m.visible = on
                if on { shown = shown + 1 }
            }
            i = i + 1
        }
        out = json.obj()
        json.object_set_raw(out, "visible", json.from_int(shown))
        json.object_set_raw(out, "of", json.from_int(count))
        answer(id, out)
        return false
    }

    if op == "model.get" {
        node = json.object_get_raw(request, "index")
        if node == null {
            fail(id, "model.get needs an index")
            return false
        }
        index = json.get_int(node)
        m = model_at(c, index)
        if m == null {
            fail(id, "no model at that index")
            return false
        }
        answer(id, model_result(m, index))
        return false
    }

    if op == "light.list" { answer(id, lights_result(c)) return false }

    if op == "model.set" {
        node = json.object_get_raw(request, "index")
        if node == null {
            fail(id, "model.set needs an index")
            return false
        }
        index = json.get_int(node)
        m = model_at(c, index)
        if m == null {
            fail(id, "no model at that index")
            return false
        }
        apply_model_write(m, request)
        answer(id, model_result(m, index))
        return false
    }

    if op == "input.set" {
        if c.input == null {
            fail(id, "there is no input service")
            return false
        }
        service = c.input as *Input
        down = true
        if has_field(request, "down") { down = json.get_bool(json.object_get_raw(request, "down")) == 1 }
        if has_field(request, "clear") && json.get_bool(json.object_get_raw(request, "clear")) == 1 {
            input.inject_clear(service)
        }
        if has_field(request, "key") { input.inject_key(service, json.get_int(json.object_get_raw(request, "key")), down) }
        if has_field(request, "mouse") { input.inject_mouse(service, json.get_int(json.object_get_raw(request, "mouse")), down) }
        if has_field(request, "button") { input.inject_button(service, json.get_int(json.object_get_raw(request, "button")), down) }
        if has_field(request, "axis") {
            input.inject_pad_axis(service, json.get_int(json.object_get_raw(request, "axis")),
                                  number_at(request, "value", 0.0), down)
        }
        answer(id, input_result(service))
        return false
    }

    if op == "input.get" {
        if c.input == null {
            fail(id, "there is no input service")
            return false
        }
        answer(id, input_result(c.input as *Input))
        return false
    }

    if op == "camera.set" {
        if c.camera == null {
            fail(id, "there is no camera")
            return false
        }
        apply_camera_write(c.camera as *Camera, request)
        answer(id, camera_result(c))
        return false
    }

    if op == "light.set" {
        node = json.object_get_raw(request, "index")
        index = 0
        if node != null { index = json.get_int(node) }
        l = light_at(c, index)
        if l == null {
            fail(id, "no light at that index")
            return false
        }
        apply_light_write(l, request)
        answer(id, light_result(l, index))
        return false
    }

    if op == "scene.save" {
        node = json.object_get_raw(request, "path")
        if node == null {
            fail(id, "scene.save needs a path")
            return false
        }
        path = json.get_string_raw(node)
        directory = "build/"
        where = json.object_get_raw(request, "mesh_directory")
        if where != null { directory = json.get_string_raw(where) }
        if !save_scene(c, path, directory) {
            fail(id, scene.last_error())
            return false
        }
        out = json.obj()
        json.object_set_raw(out, "path", json.str(path))
        json.object_set_raw(out, "models", json.from_int(model_count(c)))
        json.object_set_raw(out, "lights", json.from_int(light_count(c)))
        answer(id, out)
        return false
    }

    if op == "scene.load" {
        node = json.object_get_raw(request, "path")
        if node == null {
            fail(id, "scene.load needs a path")
            return false
        }
        loaded = load_scene(c, json.get_string_raw(node))
        if loaded < 0 {
            fail(id, scene.last_error())
            return false
        }
        out = json.obj()
        json.object_set_raw(out, "models", json.from_int(loaded))
        answer(id, out)
        return false
    }

    if op == "frame.capture" {
        c.want_capture = true
        c.want_deferred = true
        c.pending_capture_id = id
        return true
    }

    if op == "frame.pixel" {
        return defer_read(c, READ_PIXEL, id,
                          json.get_int(json.object_get_raw(request, "x")),
                          json.get_int(json.object_get_raw(request, "y")),
                          0, 0, 0, 0)
    }

    if op == "frame.region" {
        background = 0
        tolerance = 8
        node = json.object_get_raw(request, "background")
        if node != null { background = json.get_int(node) }
        node = json.object_get_raw(request, "tolerance")
        if node != null { tolerance = json.get_int(node) }
        return defer_read(c, READ_REGION, id,
                          json.get_int(json.object_get_raw(request, "x")),
                          json.get_int(json.object_get_raw(request, "y")),
                          json.get_int(json.object_get_raw(request, "width")),
                          json.get_int(json.object_get_raw(request, "height")),
                          background, tolerance)
    }

    // The whole frame, coarsely, in one answer.
    //
    // frame.pixel answers one point and costs a frame to do it, so reading a
    // picture that way is a thousand frames and a thousand round trips. This is
    // what makes the frame legible instead: every cell's mean colour and how
    // much of it is not the background, which is a silhouette an agent can
    // measure and, printed, a picture a person can see.
    if op == "frame.grid" {
        columns = 64
        rows = 36
        background = 0
        tolerance = 10
        node = json.object_get_raw(request, "columns")
        if node != null { columns = json.get_int(node) }
        node = json.object_get_raw(request, "rows")
        if node != null { rows = json.get_int(node) }
        node = json.object_get_raw(request, "background")
        if node != null { background = json.get_int(node) }
        node = json.object_get_raw(request, "tolerance")
        if node != null { tolerance = json.get_int(node) }
        if columns < 1 { columns = 1 }
        if rows < 1 { rows = 1 }
        if columns * rows > GRID_LIMIT {
            fail(id, "that grid is larger than the channel will answer with")
            return false
        }
        // A window, defaulting to the whole frame. Asked for a small one with
        // as many cells as it has pixels, this answers the pixels themselves,
        // which is the difference between seeing that something is wrong and
        // seeing what is wrong with it.
        left = 0
        top = 0
        width = 0
        height = 0
        node = json.object_get_raw(request, "x")
        if node != null { left = json.get_int(node) }
        node = json.object_get_raw(request, "y")
        if node != null { top = json.get_int(node) }
        node = json.object_get_raw(request, "width")
        if node != null { width = json.get_int(node) }
        node = json.object_get_raw(request, "height")
        if node != null { height = json.get_int(node) }
        return defer_grid(c, READ_GRID, id, left, top, width, height,
                          background, tolerance, columns, rows)
    }

    if op == "frame.hold" {
        return defer_read(c, READ_HOLD, id, 0, 0, 0, 0, 0, 0)
    }

    if op == "frame.diff" {
        tolerance = 8
        node = json.object_get_raw(request, "tolerance")
        if node != null { tolerance = json.get_int(node) }
        return defer_read(c, READ_DIFF, id, 0, 0, 0, 0, 0, tolerance)
    }

    if op == "world" { answer(id, world_result(c)) return false }

    if op == "trace.model" {
        m = model_from(c, request)
        if m == null {
            fail(id, "no model by that id, object or index")
            return false
        }
        c.want_capture = true
        c.want_deferred = true
        c.pending_trace_id = id
        c.pending_trace_model = m as ptr
        return true
    }

    // Why a model on screen looks the way it does. Answered from the frame
    // that was on screen, as the trace is: its pixels are half the answer.
    if op == "explain.model" {
        m = model_from(c, request)
        if m == null {
            fail(id, "no model by that id, object or index")
            return false
        }
        c.want_capture = true
        c.want_deferred = true
        c.pending_explain_id = id
        c.pending_explain_model = m as ptr
        return true
    }

    if op == "anim.list" { answer(id, anim_list_result(c)) return false }

    if op == "anim.get" {
        index = binding_from(c, request)
        b = anim.registry_binding(c.animations as *Registry, index)
        if b == null {
            fail(id, "no animation by that name or index")
            return false
        }
        answer(id, binding_result(b, index))
        return false
    }

    if op == "anim.set" {
        // A rig is many clips, one per part, and seeking one of them poses one
        // limb of a figure whose other fifteen are still where they were. With
        // no name and no index, this drives all of them: a character is the
        // thing an agent means when it asks to see a moment.
        if json.object_get_raw(request, "name") == null &&
           json.object_get_raw(request, "index") == null {
            answer(id, drive_all(c, request))
            return false
        }
        index = binding_from(c, request)
        b = anim.registry_binding(c.animations as *Registry, index)
        if b == null {
            fail(id, "no animation by that name or index")
            return false
        }
        drive_binding(b, request)
        answer(id, binding_result(b, index))
        return false
    }

    if op == "snapshot" {
        node = json.object_get_raw(request, "path")
        if node == null {
            fail(id, "snapshot needs a path")
            return false
        }
        c.want_snapshot = string.copy(json.get_string_raw(node))
        c.pending_snapshot_id = id
        return true
    }

    if op == "frame.pause" {
        c.want_pause = true
        answer(id, json.obj())
        return false
    }

    if op == "frame.resume" {
        c.want_resume = true
        answer(id, json.obj())
        return false
    }

    if op == "frame.step" {
        count = 1
        node = json.object_get_raw(request, "count")
        if node != null { count = json.get_int(node) }
        if count < 1 { count = 1 }
        c.want_steps = count
        c.pending_step_id = id
        c.step_from = c.frame_count
        return true
    }

    if op == "quit" {
        c.want_stop = true
        answer(id, json.obj())
        return false
    }

    fail(id, "unknown op; send {\"op\":\"help\"} for the table")
    return false
}

pump(c: *Context) {
    while true {
        line = channel.next_request()
        if line == "" { return }

        request = json.parse_raw(line)
        if request == null {
            fail(0, "not JSON")
            continue
        }

        id = 0
        id_node = json.object_get_raw(request, "id")
        if id_node != null { id = json.get_int(id_node) }

        op_node = json.object_get_raw(request, "op")
        if op_node == null {
            fail(id, "every request needs an op")
            json.free(request)
            continue
        }

        deferred = handle(c, json.get_string_raw(op_node), id, request)
        json.free(request)
        if deferred { return }
    }
}

answer_step(c: *Context) {
    out = stats_result(c)
    json.object_set_raw(out, "stepped_from", json.from_int(c.step_from))
    json.object_set_raw(out, "stepped", json.from_int(c.frame_count - c.step_from))
    answer(c.pending_step_id, out)
    c.pending_step_id = -1
}

answer_capture(c: *Context, ok: bool) {
    if ok {
        out = json.obj()
        json.object_set_raw(out, "width", json.from_int(capture.width()))
        json.object_set_raw(out, "height", json.from_int(capture.height()))
        json.object_set_raw(out, "frame", json.from_int(c.frame_count))
        answer(c.pending_capture_id, out)
    } else {
        fail(c.pending_capture_id, "could not read the frame")
    }
    c.pending_capture_id = -1
}

answer_snapshot(c: *Context, path: string, written: bool) {
    if written {
        out = json.obj()
        json.object_set_raw(out, "path", json.str(path))
        json.object_set_raw(out, "frame", json.from_int(c.frame_count))
        answer(c.pending_snapshot_id, out)
    } else {
        fail(c.pending_snapshot_id, "could not write the snapshot")
    }
    c.pending_snapshot_id = -1
}

is_paused(c: *Context) -> bool { return c.paused }

capture_release() { capture.release() }

capture_frame(width: int, height: int) -> bool {
    return capture.frame(width, height) == 1
}

// The trace and the explanation waiting on this frame's pixels.
answer_pending_trace(c: *Context) {
    if c.pending_trace_id >= 0 {
        m = c.pending_trace_model as *Model
        answer(c.pending_trace_id, trace_result(c, m, assets.provenance_for(m)))
        c.pending_trace_id = -1
        c.pending_trace_model = null
    }
    if c.pending_explain_id >= 0 {
        answer(c.pending_explain_id, explain_result(c, c.pending_explain_model as *Model))
        c.pending_explain_id = -1
        c.pending_explain_model = null
    }
}

capture_adopt(pixels: ptr, width: int, height: int) -> bool {
    return capture.adopt(pixels, width, height) == 1
}

answer_capture_unsupported(c: *Context, reason: string) {
    count = list.size(c.deferred)
    i = 0
    while i < count {
        d = list.get_raw(c.deferred, i) as *Deferred
        fail(d.id, reason)
        heap.free(d)
        i = i + 1
    }
    list.clear(c.deferred)

    if c.pending_capture_id >= 0 {
        fail(c.pending_capture_id, reason)
        c.pending_capture_id = -1
    }
    if c.pending_trace_id >= 0 {
        m = c.pending_trace_model as *Model
        answer(c.pending_trace_id, trace_result(c, m, assets.provenance_for(m)))
        c.pending_trace_id = -1
        c.pending_trace_model = null
    }
    // Everything but the pixels, which the explanation says it could not read.
    if c.pending_explain_id >= 0 {
        answer(c.pending_explain_id, explain_result(c, c.pending_explain_model as *Model))
        c.pending_explain_id = -1
        c.pending_explain_model = null
    }
}
