// Gerstner-wave ocean surface.
//
// The four wave trains live in the model's uniform arrays, so a frame update
// writes scalars only and the wave table is uploaded once.

import std.heap
import ae3d.core
import ae3d.shaders
import ae3d.loader

exports (
    Simulation, MAX_WAVES, RESOLUTION,
    simulation_new, simulation_free, simulation_model, simulation_build,
    simulation_update, simulation_apply,
    simulation_set_color, simulation_set_sky_color, simulation_set_opacity,
    simulation_set_wave_height, simulation_set_amplitude, simulation_amplitude,
    simulation_set_wave_speed, simulation_set_randomness,
    simulation_set_caustics, simulation_set_foam, simulation_set_reflection, simulation_set_shadow,
    simulation_set_wave_scale, simulation_set_sky_texture, simulation_set_shore,
    simulation_set_distortion, simulation_set_normal_strength,
    simulation_adopt, simulation_size,
    simulation_color_r, simulation_color_g, simulation_color_b,
    simulation_sky_r, simulation_sky_g, simulation_sky_b,
    simulation_opacity, simulation_wave_speed, simulation_wave_height,
    simulation_randomness, simulation_caustics_on, simulation_caustics_intensity,
    simulation_caustics_scale, simulation_foam_on, simulation_foam_intensity,
    simulation_reflection, simulation_shadow,
    simulation_distortion, simulation_normal,
    simulation_wave_scale, simulation_sky_path, simulation_shore_fade, simulation_shore_foam
)


const MAX_WAVES = 4
const RESOLUTION = 256

struct Simulation {
    model: ptr
    ocean_size: float
    base_amplitude: float
    // The skybox image the surface reflects, or "" for the computed sky.
    sky_path: string
    // Multiplies every wave's frequency: 1 is the ocean's own table, whose
    // longest wave is 78 km and shortest 8 km -- swells for a sea seen from
    // the air. A shore, or a surface seen from under it, wants waves metres
    // long, which is this at a few hundred.
    wave_scale: float
    elapsed: float

    color_r: float
    color_g: float
    color_b: float
    sky_r: float
    sky_g: float
    sky_b: float

    opacity: float
    wave_speed_multiplier: float
    wave_height: float
    wave_randomness: float

    caustics_enabled: bool
    caustics_intensity: float
    caustics_scale: float

    foam_enabled: bool
    foam_intensity: float

    reflection_intensity: float
    // The shore: how many metres of water hide the bottom, and how many
    // the foam line along the waterline runs out over. Zero means no
    // shore: the surface is one opacity everywhere.
    depth_fade: float
    shore_foam: float
    shadow_strength: float
    distortion_strength: float
    normal_strength: float
}

simulation_new(size: float, amplitude: float) -> *Simulation {
    w = heap.new(Simulation)
    w.ocean_size = size
    w.base_amplitude = amplitude
    w.wave_scale = 1.0
    // Owned: a path handed in is copied, since a scene file's strings go
    // with the file.
    w.sky_path = core.set_owned(null, "")
    w.color_r = 0.06
    w.color_g = 0.22
    w.color_b = 0.45
    w.sky_r = 0.5
    w.sky_g = 0.7
    w.sky_b = 1.0
    w.opacity = 0.85
    w.wave_speed_multiplier = 1.0
    w.wave_height = 1.0
    w.wave_randomness = 0.0
    w.caustics_enabled = false
    w.caustics_intensity = 0.3
    w.caustics_scale = 0.003
    // On at the strength it was hard-coded to, so an ocean written before this
    // looks the way it did.
    w.foam_enabled = true
    w.foam_intensity = 1.0
    w.reflection_intensity = 1.0
    w.depth_fade = 0.0
    w.shore_foam = 0.0
    w.shadow_strength = 0.5
    w.distortion_strength = 0.2
    w.normal_strength = 1.0
    return w
}

simulation_free(w: *Simulation) {
    if w == null { return }
    if w.model != null { core.model_free(w.model as *Model) }
    heap.free(w)
}

simulation_model(w: *Simulation) -> *Model {
    return w.model as *Model
}

// Take over a surface that already exists, instead of building one. A scene
// loads its water as an ordinary model with the wave table and the shader it
// was saved with, and this is what puts a simulation behind it again so it
// animates and the editor's controls reach it.
//
// The surface keeps the geometry it was loaded with: rebuilding it here would
// throw away the mesh the scene just read and replace it with one generated
// from the same numbers, which is slower and not obviously the same thing.
simulation_adopt(w: *Simulation, m: *Model) {
    if w == null { return }
    w.model = m as ptr
    simulation_apply(w)
}

simulation_size(w: *Simulation) -> float { return w.ocean_size }
simulation_color_r(w: *Simulation) -> float { return w.color_r }
simulation_color_g(w: *Simulation) -> float { return w.color_g }
simulation_color_b(w: *Simulation) -> float { return w.color_b }
simulation_sky_r(w: *Simulation) -> float { return w.sky_r }
simulation_sky_g(w: *Simulation) -> float { return w.sky_g }
simulation_sky_b(w: *Simulation) -> float { return w.sky_b }
simulation_opacity(w: *Simulation) -> float { return w.opacity }
simulation_wave_speed(w: *Simulation) -> float { return w.wave_speed_multiplier }
simulation_wave_height(w: *Simulation) -> float { return w.wave_height }
simulation_randomness(w: *Simulation) -> float { return w.wave_randomness }
simulation_caustics_on(w: *Simulation) -> bool { return w.caustics_enabled }
simulation_caustics_intensity(w: *Simulation) -> float { return w.caustics_intensity }
simulation_caustics_scale(w: *Simulation) -> float { return w.caustics_scale }
simulation_reflection(w: *Simulation) -> float { return w.reflection_intensity }
simulation_shadow(w: *Simulation) -> float { return w.shadow_strength }
simulation_distortion(w: *Simulation) -> float { return w.distortion_strength }
simulation_normal(w: *Simulation) -> float { return w.normal_strength }
simulation_wave_scale(w: *Simulation) -> float { return w.wave_scale }
simulation_sky_path(w: *Simulation) -> string { return w.sky_path }
simulation_shore_fade(w: *Simulation) -> float { return w.depth_fade }
simulation_shore_foam(w: *Simulation) -> float { return w.shore_foam }

// Everything the surface is told goes into the uniforms it draws from. Left to
// build time alone, as it was, a setting made after the surface existed changed
// a field nothing read again: the editor's wave, opacity and colour
// controls moved nothing at all. Applying is a handful of uniform writes and
// happens only when something is actually set.
settled(w: *Simulation) {
    if w.model != null { simulation_apply(w) }
}

simulation_set_color(w: *Simulation, red: float, green: float, blue: float) {
    w.color_r = red
    w.color_g = green
    w.color_b = blue
    settled(w)
}

simulation_set_sky_color(w: *Simulation, red: float, green: float, blue: float) {
    w.sky_r = red
    w.sky_g = green
    w.sky_b = blue
    settled(w)
}

// How much of the water is water rather than what is behind it: 1.0 hides
// the bottom, 0.0 is glass. It goes straight into the surface's alpha, and it
// was called transparency, which is the same number read backwards. Every
// caller that set it high to see through the water was making it opaque.
simulation_set_opacity(w: *Simulation, value: float) {
    w.opacity = value
    settled(w)
}

// How high the waves stand, in the units the surface is laid out in. The wave
// table is derived from it, so applying rebuilds the table rather than writing
// a single uniform.
// How much shorter than the ocean's own the waves are: 1 keeps wavelengths
// of kilometres, 400 makes them 20 to 200 metres. Rebuild after changing.
// The skybox image the water reflects -- the same file the scene's skybox
// was made from -- so the sea shows the sky that is actually over it.
// Takes effect on the next build.
simulation_set_sky_texture(w: *Simulation, path: string) {
    w.sky_path = core.set_owned(w.sky_path, path)
    settled(w)
}

// A shore: the water goes clear over ground within `fade` metres of the
// surface, so the sand shows through, and lays foam where the ground is
// within `foam` metres. Needs the scene's depth under the water, which the
// backend captures before the transparent pass on both renderers; the
// surface is kept translucent so it is drawn in that pass.
simulation_set_shore(w: *Simulation, fade: float, foam: float) {
    w.depth_fade = fade
    w.shore_foam = foam
    settled(w)
}

simulation_set_wave_scale(w: *Simulation, value: float) {
    w.wave_scale = value
    settled(w)
}

simulation_set_amplitude(w: *Simulation, value: float) {
    w.base_amplitude = value
    if w.model != null { upload_wave_table(w, w.model as *Model) }
    settled(w)
}

simulation_amplitude(w: *Simulation) -> float { return w.base_amplitude }

// A multiplier over that height, which is what the shader scales the table by.
simulation_set_wave_height(w: *Simulation, value: float) {
    w.wave_height = value
    settled(w)
}

simulation_set_wave_speed(w: *Simulation, value: float) {
    w.wave_speed_multiplier = value
    settled(w)
}

simulation_set_randomness(w: *Simulation, value: float) {
    w.wave_randomness = value
    settled(w)
}

simulation_set_foam(w: *Simulation, enabled: bool, intensity: float) {
    w.foam_enabled = enabled
    w.foam_intensity = intensity
    settled(w)
}

simulation_foam_on(w: *Simulation) -> bool { return w.foam_enabled }
simulation_foam_intensity(w: *Simulation) -> float { return w.foam_intensity }

simulation_set_caustics(w: *Simulation, enabled: bool, intensity: float, scale: float) {
    w.caustics_enabled = enabled
    w.caustics_intensity = intensity
    w.caustics_scale = scale
    settled(w)
}

// How much of the sky and the horizon the surface gives back. This used to be
// called specular and set a uniform the shader never read.
simulation_set_reflection(w: *Simulation, value: float) {
    w.reflection_intensity = value
    settled(w)
}

simulation_set_shadow(w: *Simulation, value: float) {
    w.shadow_strength = value
    settled(w)
}

simulation_set_distortion(w: *Simulation, value: float) {
    w.distortion_strength = value
    settled(w)
}

simulation_set_normal_strength(w: *Simulation, value: float) {
    w.normal_strength = value
    settled(w)
}

// The trains' heights fall off with their length the way a sea's do: the
// shortest at a tenth of the longest. At two fifths it stood at a steepness
// the others never reached, and the sea was that one ridge repeated, with
// the swell underneath it lost.
wave_amplitude(w: *Simulation, index: int) -> float {
    if index == 0 { return w.base_amplitude * 1.2 }
    if index == 1 { return w.base_amplitude * 0.7 }
    if index == 2 { return w.base_amplitude * 0.3 }
    return w.base_amplitude * 0.12
}

wave_frequency(w: *Simulation, index: int) -> float {
    base = 0.0008
    if index == 0 { base = 0.00008 }
    if index == 1 { base = 0.00015 }
    if index == 2 { base = 0.0004 }
    return base * w.wave_scale
}

// Deep-water dispersion: the rate a wave's phase turns is sqrt(g k) for its
// wavenumber k, so a longer wave travels faster and no two of the four
// trains march in lockstep. In radians a second, which is what the shader
// adds per second of time: a 160 m wave turns 0.6 a second (a ten-second
// period), a 16 m one 2.0. The old 0.002 * sqrt(wavelength) was tuned for
// kilometre swells and left waves metres long all but standing still.
wave_speed(w: *Simulation, index: int) -> float {
    k = wave_frequency(w, index)
    return core.sqrt_of(9.81 * k)
}

upload_wave_table(w: *Simulation, m: *Model) {
    directions = core.model_set_uniform_array(m, "waveDirections", MAX_WAVES * 3, true)
    amplitudes = core.model_set_uniform_array(m, "waveAmplitudes", MAX_WAVES, false)
    frequencies = core.model_set_uniform_array(m, "waveFrequencies", MAX_WAVES, false)
    speeds = core.model_set_uniform_array(m, "waveSpeeds", MAX_WAVES, false)
    phases = core.model_set_uniform_array(m, "wavePhases", MAX_WAVES, false)
    steepness = core.model_set_uniform_array(m, "waveSteepness", MAX_WAVES, false)

    i = 0
    while i < MAX_WAVES {
        // The trains fan out around one wind, unevenly: spaced a neat 45
        // degrees apart they crossed into a lattice of crests, an egg box
        // with a foam cap on every bump.
        spread = 0.0
        if i == 1 { spread = 0.0 - 27.0 }
        if i == 2 { spread = 38.0 }
        if i == 3 { spread = 0.0 - 61.0 }
        angle = core.deg_to_rad(17.0 + spread)
        direction = core.v3_normalize(core.vec3(core.cos_of(angle), 0.0, core.sin_of(angle)))

        core.farr_set(directions, i * 3, direction.x)
        core.farr_set(directions, i * 3 + 1, direction.y)
        core.farr_set(directions, i * 3 + 2, direction.z)
        core.farr_set(amplitudes, i, wave_amplitude(w, i))
        core.farr_set(frequencies, i, wave_frequency(w, i))
        core.farr_set(speeds, i, wave_speed(w, i))
        core.farr_set(phases, i, (i * 1.0) * core.PI / 3.0)
        core.farr_set(steepness, i, 0.2 + (i * 1.0) * 0.1)
        i = i + 1
    }
}

simulation_build(w: *Simulation, resolution: int) -> *Model {
    if w.model != null { return w.model as *Model }

    steps = resolution
    if steps <= 0 { steps = RESOLUTION }
    m = loader.water_surface(w.ocean_size, 0.0, 0.0, steps)
    if m == null { return null }

    m.name = "water surface"
    core.model_set_position(m, 0.0, 0.0, 0.0)
    core.model_set_diffuse(m, w.color_r, w.color_g, w.color_b)
    core.model_set_pbr(m, 0.0, 0.4)
    core.model_set_exposure(m, 1.0)
    // The shader writes waterOpacity into its alpha, so the model has to
    // say the same thing: a surface that claims to be opaque is drawn in the
    // opaque pass with depth writes on, and a translucent fragment blended
    // there composites a number of times that depends on depth precision.
    core.model_set_alpha(m, w.opacity)
    core.model_set_shader(m, shaders.water_shader())
    // A sea casts no shadow: the light through it is the caustics, and the
    // shore beside it is sunlit. Left as a caster, the surface put every
    // seabed and every drowned slope into one flat shadow.
    core.model_set_casts_shadow(m, false)

    upload_wave_table(w, m)
    core.model_set_uniform_int(m, "waveCount", MAX_WAVES)
    core.model_set_uniform_float(m, "waveHeightMultiplier", w.wave_height)
    core.model_set_uniform_float(m, "waveRandomness", w.wave_randomness)
    core.model_set_uniform_float(m, "time", 0.0)

    core.model_set_uniform_int(m, "enableShadows", 0)
    core.model_set_uniform_int(m, "enableWaterReflection", 1)
    core.model_set_uniform_int(m, "enableWaterDistortion", 1)
    core.model_set_uniform_int(m, "enableWaterNormalMapping", 1)
    core.model_set_uniform_float(m, "noiseIntensity", 0.0)
    core.model_set_uniform_float(m, "noiseScale", 0.0002)
    core.model_set_uniform_int(m, "noiseOctaves", 3)
    core.model_set_uniform_float(m, "shadowSoftness", 0.3)

    // The fog is the scene's, not the sea's: the surface carried a haze of
    // its own -- a tenth to eight tenths of the ocean's size, sky blue, a
    // third strong -- which overrode whatever the scene set, so a dust storm
    // that buried the island left the sea beside it blue. The scene shader
    // and this one apply the same fog the same way now.

    w.model = m as ptr
    simulation_apply(w)
    return m
}

simulation_apply(w: *Simulation) {
    m = w.model as *Model
    if m == null { return }

    core.model_set_uniform_vec3(m, "waterBaseColor", core.vec3(w.color_r, w.color_g, w.color_b))
    core.model_set_uniform_float(m, "waterOpacity", w.opacity)
    // With a shore the surface has to draw after the ground it reads the
    // depth of, which is the transparent pass: an opaque alpha would put it
    // in the opaque pass, reading its own depth as the bottom.
    drawn_alpha = w.opacity
    if w.depth_fade > 0.0 && drawn_alpha > 0.98 { drawn_alpha = 0.98 }
    core.model_set_alpha(m, drawn_alpha)
    core.model_set_uniform_float(m, "waterDepthFade", w.depth_fade)
    core.model_set_uniform_float(m, "waterShoreFoam", w.shore_foam)
    core.model_set_uniform_float(m, "waveSpeedMultiplier", w.wave_speed_multiplier)
    core.model_set_uniform_float(m, "waveHeightMultiplier", w.wave_height)
    core.model_set_uniform_float(m, "waveRandomness", w.wave_randomness)

    foam = 0
    if w.foam_enabled { foam = 1 }
    core.model_set_uniform_int(m, "enableFoam", foam)
    core.model_set_uniform_float(m, "foamIntensity", w.foam_intensity)

    caustics = 0
    if w.caustics_enabled { caustics = 1 }
    core.model_set_uniform_int(m, "enableCaustics", caustics)
    core.model_set_uniform_float(m, "causticsIntensity", w.caustics_intensity)
    core.model_set_uniform_float(m, "causticsScale", w.caustics_scale)

    core.model_set_uniform_float(m, "waterReflectionIntensity", w.reflection_intensity)
    has_sky = 0
    if w.sky_path != "" {
        core.model_set_texture(m, w.sky_path)
        has_sky = 1
    }
    core.model_set_uniform_int(m, "hasSkyTexture", has_sky)
    core.model_set_uniform_float(m, "shadowIntensity", w.shadow_strength)
    core.model_set_uniform_float(m, "waterDistortionIntensity", w.distortion_strength)
    core.model_set_uniform_float(m, "waterNormalIntensity", w.normal_strength)

    core.model_set_uniform_vec3(m, "skyColor", core.vec3(w.sky_r, w.sky_g, w.sky_b))
    core.model_set_uniform_vec3(m, "horizonColor",
                                core.vec3(w.sky_r * 0.85, w.sky_g * 0.85, w.sky_b * 0.85))
    core.model_set_uniform_float(m, "waterPlaneHeight", m.position.y + 5.0)
    core.model_set_uniform_float(m, "waterLevel", m.position.y)
}

simulation_update(w: *Simulation, delta: float) {
    m = w.model as *Model
    if m == null { return }
    w.elapsed = w.elapsed + delta
    core.model_set_uniform_float(m, "time", w.elapsed)
}
