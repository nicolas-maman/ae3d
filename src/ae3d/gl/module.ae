exports (
    GLRenderer, ProgramSlots, TextureEntry, Skybox,
    skybox_create, skybox_free,
    renderer_new, renderer_free, backend,
    renderer_add_light, renderer_remove_light, renderer_light_count, renderer_light, renderer_model_count, renderer_model,
    renderer_draw_calls, renderer_instance_count,
    renderer_set_clear_color, renderer_set_fxaa, renderer_set_bloom, renderer_set_msaa, renderer_set_taa, renderer_taa,
    renderer_set_render_scale, renderer_render_scale,
    renderer_set_target,
    renderer_set_bloom_params, renderer_set_bloom_intensity, renderer_bloom_intensity,
    renderer_set_post, renderer_set_fog, renderer_fog, renderer_set_clouds, renderer_set_sky_overcast,
    renderer_set_ssao, renderer_ssao,
    renderer_set_shadows, renderer_shadows, renderer_shadow_map, renderer_default_program,
    renderer_set_shadow_distance, renderer_shadow_distance,
    renderer_load_texture, renderer_release_texture, renderer_texture_count,
    renderer_material_texture_size, renderer_set_normal_strength,
    renderer_shadow_ms, renderer_scene_ms, renderer_post_ms, renderer_post_active, device_name,
    renderer_program_binds, renderer_material_binds, renderer_texture_binds,
    renderer_set_occlusion_strength, renderer_set_capture_channel, renderer_set_wetness,
    renderer_frame_pixels, read_pixel, snapshot
)

