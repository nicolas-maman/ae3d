    models: ptr
    lights: ptr
    programs: ptr
    textures: ptr
    frustum: ptr
    skybox: ptr
    target: ptr

    default_program: int
    fxaa_program: int
    bloom_program: int
    passthrough_program: int
    current_program: int
    default_texture: int

    face_culling_state: bool
    depth_test_state: bool
    blend_state: bool
    wireframe_state: bool
    initialized: bool

    last_draw_calls: int
    frame_stamp: int
    shadow_program: int
    shadow_fbo: int
    shadow_map: int
    shadow_depth: int
    shadow_enabled: bool
    shadow_space: Mat4

    clear_r: float
    clear_g: float
    clear_b: float

    enable_fxaa: bool
    enable_bloom: bool
    enable_msaa: bool
    bloom_threshold: float
    bloom_intensity: float

    batches: ptr
    batch_count: int
    shadow_batches: ptr
    shadow_batch_count: int

    bound_material: ptr
    bound_material_set: bool
    bound_texture: int
    bound_instanced: int
    bound_instance_color: int

    post_fbo: int
    post_texture: int
    post_ms_fbo: int
    post_ms_color: int
    post_ms_depth: int
    post_samples: int
    post_width: int
    post_height: int
    post_resolve_reported: bool

    scene_start: float
    scene_time: float
    defaults: ptr
    post_depth: int
    bloom_fbo: int
    bloom_texture: int
    screen_vao: int
    screen_vbo: int
