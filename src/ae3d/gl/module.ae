// OpenGL 4.1 core backend.
//
// Uniform locations are resolved once per program into named slots rather than
// looked up (or hashed) per draw: `ProgramSlots` is filled the first time a
// program is seen and reused for every frame afterwards. Custom per-model
// uniforms cache their own location on the `Uniform` that owns them.
//
// Every struct here holds primitives and raw handles only, so this module never
// depends on another module's struct layout.

import std.list
import std.heap
import std.string
import ae3d.core
import ae3d.platform
import ae3d.rendering
import ae3d.shaders
