const MAX_FBO_DIMENSION = 8192
const SHADOW_SIZE = 2048
const MAX_LIGHTS = 4
const LIGHT_SLOTS = 10

struct ProgramSlots {
    program: int
    frame_stamp: int
    view_projection: int
    model: int
    light_slots: ptr
    light_count: int
    light_position: int
    light_color: int
    light_intensity: int
    light_ambient: int
    light_temperature: int
    light_is_directional: int
    light_space: int
    shadow_map: int
    has_shadow_map: int
    light_direction: int
    light_constant: int
    light_linear: int
    light_quadratic: int
    compat_light_pos: int
    compat_light_color: int
    compat_light_intensity: int
    compat_light_direction: int
    view_pos: int
    diffuse_color: int
    specular_color: int
    metallic: int
    roughness: int
    exposure: int
    material_alpha: int
    texture_sampler: int
    is_instanced: int
    use_instance_color: int
    caustics_time: int
    loaded_names: uint64
    shading_loaded: bool
}

struct TextureEntry {
    path: string
    id: int
    refs: int
    width: int
    height: int
}

// One merged draw: the geometry every member shares, the surface they all have,
// and the matrices that tell the shader where each copy goes.
struct GLBatch {
    vao: int
    material: ptr
    first: ptr
    instances: ptr
    members: ptr
    capacity_bytes: int
    count: int
    stale: bool
}

