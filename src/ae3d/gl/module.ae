// OpenGL 4.1 core backend.
//
// Uniform locations are resolved once per program into named slots rather than
// looked up (or hashed) per draw: `ProgramSlots` is filled the first time a
// program is seen and reused for every frame afterwards. Custom per-model
// uniforms cache their own location on the `Uniform` that owns them.
//
// Every struct here holds primitives and raw handles only, so this module never
// depends on another module's struct layout.

import std.list
import std.heap
import std.string
import std.mem
import std.bytes
import ae3d.core
import ae3d.png
import ae3d.platform
import ae3d.rendering
import ae3d.shaders
import ae3d.skin
import ae3d.posing
import ae3d.geometry
import ae3d.glapi
import ae3d.offscreen

exports (
    GLRenderer, ProgramSlots, TextureEntry, Skybox,
    skybox_create, skybox_free,
    renderer_new, renderer_free, backend,
    renderer_add_light, renderer_remove_light, renderer_light_count, renderer_light, renderer_model_count, renderer_model,
    renderer_draw_calls, renderer_instance_count,
    renderer_set_clear_color, renderer_set_fxaa, renderer_set_bloom, renderer_set_msaa, renderer_set_taa, renderer_taa,
    renderer_set_render_scale, renderer_render_scale,
    renderer_set_target,
    renderer_set_bloom_params, renderer_set_bloom_intensity, renderer_bloom_intensity,
    renderer_set_post, renderer_set_fog, renderer_fog, renderer_set_clouds, renderer_set_sky_overcast,
    renderer_set_ssao, renderer_ssao,
    renderer_set_shadows, renderer_shadows, renderer_shadow_map, renderer_default_program,
    renderer_set_shadow_distance, renderer_shadow_distance,
    renderer_load_texture, renderer_release_texture, renderer_texture_count,
    renderer_material_texture_size, renderer_set_normal_strength,
    renderer_shadow_ms, renderer_scene_ms, renderer_post_ms, renderer_post_active, device_name,
    renderer_program_binds, renderer_material_binds, renderer_texture_binds,
    renderer_set_occlusion_strength, renderer_set_capture_channel, renderer_set_wetness, renderer_set_frame_exposure, renderer_meter,
    renderer_frame_pixels, read_pixel, snapshot, renderer_add_model, renderer_remove_model
)

extern calloc(count: int, size: int) -> ptr
extern ae3d_image_pixels(img: ptr) -> ptr
extern glfwGetCurrentContext() -> ptr
extern strlen(s: ptr) -> int
extern pow(x: float, y: float) -> float
extern ae3d_image_width(img: ptr) -> int
extern ae3d_image_height(img: ptr) -> int
extern free(p: ptr)

extern ae3d_image_load(path: string) -> ptr
extern ae3d_image_fit(img: ptr, limit: int) -> int
extern ae3d_image_width(image: ptr) -> int
extern ae3d_image_height(image: ptr) -> int
extern ae3d_image_solid(width: int, height: int, r: int, g: int, b: int, a: int) -> ptr
extern ae3d_image_free(img: ptr)
extern ae3d_image_error() -> string

// --- pass timers, framebuffers, readback and the meter, in Aether (#398) ---------------------

// A name GL makes (a framebuffer, a renderbuffer, a texture, a query): one.
gl_name(kind: int) -> int {
    out = calloc(1, 4)
    if kind == 0 { glapi.glGenFramebuffers(1, out) }
    if kind == 1 { glapi.glGenRenderbuffers(1, out) }
    if kind == 2 { glapi.glGenTextures(1, out) }
    if kind == 3 { glapi.glGenQueries(1, out) }
    id = (out as int[])[0]
    free(out)
    return id
}

// And one gone.
gl_drop(kind: int, id: int) {
    if id == 0 { return }
    names = calloc(1, 4)
    (names as int[])[0] = id
    if kind == 0 { glapi.glDeleteFramebuffers(1, names) }
    if kind == 1 { glapi.glDeleteRenderbuffers(1, names) }
    if kind == 2 { glapi.glDeleteTextures(1, names) }
    if kind == 3 { glapi.glDeleteQueries(1, names) }
    free(names)
}

const NAME_FRAMEBUFFER = 0
const NAME_RENDERBUFFER = 1
const NAME_TEXTURE = 2
const NAME_QUERY = 3

// A pass costs what the GPU spends on it, and the CPU time around a submit
// is not that number: the driver returns from a draw call long before the
// work is done, so a pass that doubled in cost on the GPU can read as
// unchanged. GL_TIME_ELAPSED brackets the work itself.
//
// The result is read a frame or two later, never in the frame that issued
// it. Asking for it immediately is a stall: the CPU waits for the GPU to
// drain, which both costs the frame time it is trying to measure and
// changes it.
const TIME_ELAPSED = 35007           // 0x88BF
const QUERY_RESULT = 34918           // 0x8866
const QUERY_RESULT_AVAILABLE = 34919 // 0x8867
const TIMER_PASSES = 3
// Deep enough that a result is always read long after the GPU has finished
// with it, so the read never waits.
const TIMER_DEPTH = 3

struct PassTimer {
    ids: ptr                         // int[TIMER_DEPTH * TIMER_PASSES]
    issued: ptr                      // int[TIMER_DEPTH * TIMER_PASSES]
    ms: ptr                          // float[TIMER_PASSES]
    slot: int
    open: bool
}

gl_passtimer_create() -> ptr {
    names = ["glGenQueries", "glDeleteQueries", "glBeginQuery", "glEndQuery", "glGetQueryObjectuiv", "glGetQueryObjectui64v"]
    i = 0
    while i < 6 {
        if !glapi.has(names[i]) { return null }
        i = i + 1
    }
    t = calloc(1, sizeof(PassTimer)) as *PassTimer
    t.ids = calloc(TIMER_DEPTH * TIMER_PASSES, 4)
    t.issued = calloc(TIMER_DEPTH * TIMER_PASSES, 4)
    t.ms = calloc(TIMER_PASSES, 8)
    ids = t.ids as int[]
    k = 0
    while k < TIMER_DEPTH * TIMER_PASSES {
        ids[k] = gl_name(NAME_QUERY)
        k = k + 1
    }
    return t as ptr
}

gl_passtimer_destroy(timer: ptr) {
    if timer == null { return }
    t = timer as *PassTimer
    // Only when a context is current to delete them in. When the window is
    // already gone -- a program that frees its renderer after shutting the
    // engine down, or a test that destroys its offscreen context first --
    // the queries died with the context, and glDeleteQueries against no
    // context segfaults on llvmpipe.
    if glfwGetCurrentContext() != null {
        ids = t.ids as int[]
        k = 0
        while k < TIMER_DEPTH * TIMER_PASSES {
            gl_drop(NAME_QUERY, ids[k])
            k = k + 1
        }
    }
    free(t.ids)
    free(t.issued)
    free(t.ms)
    free(timer)
}

// Moves to the slot this frame will write, collecting what that slot
// measured the last time round. A pass that was not drawn reports nothing
// rather than the last figure it happened to have.
gl_passtimer_frame(timer: ptr) {
    if timer == null { return }
    t = timer as *PassTimer
    t.slot = (t.slot + 1) % TIMER_DEPTH
    ids = t.ids as int[]
    issued = t.issued as int[]
    ms = t.ms as float[]
    ready = calloc(1, 4)
    elapsed = calloc(1, 8)
    pass = 0
    while pass < TIMER_PASSES {
        at = t.slot * TIMER_PASSES + pass
        if issued[at] == 0 {
            ms[pass] = 0.0
        } else {
            issued[at] = 0
            if ids[at] != 0 {
                (ready as int[])[0] = 0
                glapi.glGetQueryObjectuiv(ids[at] as uint32, QUERY_RESULT_AVAILABLE as uint32, ready)
                if (ready as int[])[0] != 0 {
                    glapi.glGetQueryObjectui64v(ids[at] as uint32, QUERY_RESULT as uint32, elapsed)
                    // Nanoseconds. A double carries every integer to 2^53, so
                    // the conversion to milliseconds loses nothing a timer can
                    // measure.
                    ms[pass] = ((elapsed as long[])[0] as float) / 1000000.0
                }
            }
        }
        pass = pass + 1
    }
    free(ready)
    free(elapsed)
}

gl_passtimer_begin(timer: ptr, pass: int) {
    if timer == null || pass < 0 || pass >= TIMER_PASSES { return }
    t = timer as *PassTimer
    if t.open { return }
    at = t.slot * TIMER_PASSES + pass
    id = (t.ids as int[])[at]
    if id == 0 { return }
    glapi.glBeginQuery(TIME_ELAPSED as uint32, id as uint32)
    (t.issued as int[])[at] = 1
    t.open = true
}

gl_passtimer_end(timer: ptr) {
    if timer == null { return }
    t = timer as *PassTimer
    if !t.open { return }
    glapi.glEndQuery(TIME_ELAPSED as uint32)
    t.open = false
}

gl_passtimer_ms(timer: ptr, pass: int) -> float {
    if timer == null || pass < 0 || pass >= TIMER_PASSES { return 0.0 }
    return ((timer as *PassTimer).ms as float[])[pass]
}

gl_fbo_create() -> int { return gl_name(NAME_FRAMEBUFFER) }

gl_fbo_bind(fbo: int) { glapi.glBindFramebuffer(glapi.FRAMEBUFFER as uint32, fbo as uint32) }

gl_fbo_delete(fbo: int) { gl_drop(NAME_FRAMEBUFFER, fbo) }

// A texture of `width` x `height` (at least one each way), empty, sampled
// with `filter` and clamped: what a framebuffer draws into.
target_texture(width: int, height: int, internal: int, format: int, kind: int, filter: int) -> int {
    w = width
    h = height
    if w < 1 { w = 1 }
    if h < 1 { h = 1 }
    texture = gl_name(NAME_TEXTURE)
    glapi.glBindTexture(glapi.TEXTURE_2D as uint32, texture as uint32)
    glapi.glTexImage2D(glapi.TEXTURE_2D as uint32, 0, internal, w, h, 0, format as uint32, kind as uint32, null)
    texture_params(glapi.TEXTURE_2D, glapi.CLAMP_TO_EDGE, false, filter, filter)
    return texture
}

attach_texture(fbo: int, attachment: int, texture: int, level: int) {
    glapi.glBindFramebuffer(glapi.FRAMEBUFFER as uint32, fbo as uint32)
    glapi.glFramebufferTexture2D(glapi.FRAMEBUFFER as uint32, attachment as uint32, glapi.TEXTURE_2D as uint32,
                                 texture as uint32, level)
}

// A renderbuffer of `width` x `height`, `samples` of them a pixel (0: not
// multisampled), attached to `fbo` at `attachment`.
attach_renderbuffer(fbo: int, attachment: int, width: int, height: int, samples: int, internal: int) -> int {
    w = width
    h = height
    if w < 1 { w = 1 }
    if h < 1 { h = 1 }
    rbo = gl_name(NAME_RENDERBUFFER)
    glapi.glBindRenderbuffer(glapi.RENDERBUFFER as uint32, rbo as uint32)
    if samples > 0 {
        glapi.glRenderbufferStorageMultisample(glapi.RENDERBUFFER as uint32, samples, internal as uint32, w, h)
    } else {
        glapi.glRenderbufferStorage(glapi.RENDERBUFFER as uint32, internal as uint32, w, h)
    }
    glapi.glBindFramebuffer(glapi.FRAMEBUFFER as uint32, fbo as uint32)
    glapi.glFramebufferRenderbuffer(glapi.FRAMEBUFFER as uint32, attachment as uint32, glapi.RENDERBUFFER as uint32,
                                    rbo as uint32)
    return rbo
}

gl_fbo_attach_color(fbo: int, width: int, height: int, hdr: int) -> int {
    internal = glapi.RGBA8
    kind = glapi.UNSIGNED_BYTE
    if hdr != 0 {
        internal = glapi.RGBA16F
        kind = glapi.FLOAT
    }
    texture = target_texture(width, height, internal, glapi.RGBA, kind, glapi.LINEAR)
    attach_texture(fbo, glapi.COLOR_ATTACHMENT0, texture, 0)
    return texture
}

// The motion vectors beside the colour: a two-channel half-float texture at
// the framebuffer's second colour attachment, point sampled (a vector is not
// blended between pixels), and its multisampled renderbuffer twin for the
// frame that is drawn multisampled and resolved.
gl_fbo_attach_velocity(fbo: int, width: int, height: int) -> int {
    texture = target_texture(width, height, glapi.RG16F, glapi.RG, glapi.FLOAT, glapi.NEAREST)
    attach_texture(fbo, glapi.COLOR_ATTACHMENT1, texture, 0)
    return texture
}

gl_fbo_attach_velocity_multisample(fbo: int, width: int, height: int, samples: int) -> int {
    return attach_renderbuffer(fbo, glapi.COLOR_ATTACHMENT1, width, height, samples, glapi.RG16F)
}

// How many of the bound framebuffer's colour attachments the draws write,
// from the first: two while the scene is drawn with its motion vectors, one
// for the passes after, whose shaders have no second output.
gl_draw_buffers(count: int) {
    n = count
    if n < 1 { n = 1 }
    if n > 2 { n = 2 }
    buffers = calloc(2, 4)
    (buffers as int[])[0] = glapi.COLOR_ATTACHMENT0
    (buffers as int[])[1] = glapi.COLOR_ATTACHMENT1
    glapi.glDrawBuffers(n, buffers)
    free(buffers)
}

// One colour attachment of the bound framebuffer cleared to a value of its
// own: the motion vectors to zero, whatever the scene's clear colour.
gl_clear_attachment(index: int, r: float, g: float, b: float, a: float) {
    value = calloc(4, 4)
    v = value as f32[]
    v[0] = r as f32
    v[1] = g as f32
    v[2] = b as f32
    v[3] = a as f32
    glapi.glClearBufferfv(glapi.COLOR as uint32, index, value)
    free(value)
}

// Every error GL has queued, gone, so the next glGetError is about what
// follows.
drain_errors() {
    while (glapi.glGetError()) as int != glapi.NO_ERROR { }
}

// The multisample resolve of one colour attachment other than the first:
// read and draw buffers set to it for the blit and put back after.
gl_fbo_resolve_attachment(source: int, destination: int, width: int, height: int, index: int) -> int {
    attachment = glapi.COLOR_ATTACHMENT0 + index
    drain_errors()
    glapi.glBindFramebuffer(glapi.READ_FRAMEBUFFER as uint32, source as uint32)
    glapi.glBindFramebuffer(glapi.DRAW_FRAMEBUFFER as uint32, destination as uint32)
    glapi.glReadBuffer(attachment as uint32)
    glapi.glDrawBuffer(attachment as uint32)
    glapi.glBlitFramebuffer(0, 0, width, height, 0, 0, width, height, glapi.COLOR_BUFFER_BIT as uint32, glapi.NEAREST as uint32)
    status = (glapi.glGetError()) as int
    glapi.glReadBuffer(glapi.COLOR_ATTACHMENT0 as uint32)
    glapi.glDrawBuffer(glapi.COLOR_ATTACHMENT0 as uint32)
    glapi.glBindFramebuffer(glapi.FRAMEBUFFER as uint32, 0)
    return status
}

// A colour texture already made attached as the framebuffer's colour: the
// temporal pass writes its two history textures in turn through the one
// framebuffer.
gl_fbo_set_color(fbo: int, texture: int) {
    attach_texture(fbo, glapi.COLOR_ATTACHMENT0, texture, 0)
}

// A shadow map wants different sampling from a post-processing colour
// buffer: point sampling, because the comparison is done per texel with
// explicit offsets, and an edge clamp so a fragment projecting outside the
// light's view reads the cleared far value rather than wrapping.
//
// The DEPTH attachment, and nothing else: with no colour attachment the
// driver takes its depth-only path, and a depth texture sampled with .r
// gives back what a colour buffer would have held. 32-bit float depth: eight
// bits is 256 steps across the whole light-space box, coarse enough that a
// surface shadows itself. Left in the default NONE compare mode: the lit
// pass does its own comparison with a slope-scaled bias over a 3x3
// neighbourhood, so it wants the stored depth rather than a pass/fail.
gl_fbo_attach_shadow_map(fbo: int, size: int) -> int {
    glapi.glActiveTexture(glapi.TEXTURE0 as uint32)
    texture = target_texture(size, size, glapi.DEPTH_COMPONENT32F, glapi.DEPTH_COMPONENT, glapi.FLOAT, glapi.NEAREST)
    texture_param(glapi.TEXTURE_2D, glapi.TEXTURE_COMPARE_MODE, glapi.NONE)
    attach_texture(fbo, glapi.DEPTH_ATTACHMENT, texture, 0)
    // A framebuffer with no colour attachment is incomplete unless it is told
    // there is no colour to draw or read.
    glapi.glDrawBuffer(glapi.NONE as uint32)
    glapi.glReadBuffer(glapi.NONE as uint32)
    glapi.glBindFramebuffer(glapi.FRAMEBUFFER as uint32, 0)
    return texture
}

// The scene pass renders into multisampled attachments and resolves down
// into the single-sample texture the composite samples: up to four samples,
// or 0 where the context has fewer than two.
gl_max_samples() -> int {
    most = gl_integer(glapi.MAX_SAMPLES, 0, 1)
    if most > 4 { most = 4 }
    if most > 1 { return most }
    return 0
}

gl_fbo_attach_color_multisample(fbo: int, width: int, height: int, samples: int) -> int {
    return attach_renderbuffer(fbo, glapi.COLOR_ATTACHMENT0, width, height, samples, glapi.RGBA8)
}

gl_fbo_attach_depth_multisample(fbo: int, width: int, height: int, samples: int) -> int {
    return attach_renderbuffer(fbo, glapi.DEPTH_STENCIL_ATTACHMENT, width, height, samples, glapi.DEPTH24_STENCIL8)
}

gl_fbo_attach_depth(fbo: int, width: int, height: int) -> int {
    return attach_renderbuffer(fbo, glapi.DEPTH_STENCIL_ATTACHMENT, width, height, 0, glapi.DEPTH24_STENCIL8)
}

gl_renderbuffer_delete(rbo: int) { gl_drop(NAME_RENDERBUFFER, rbo) }

// What the driver made of the blit, rather than leaving a rejected one to
// show up as a black frame. A multisample resolve has more ways to be
// refused than most calls: the two framebuffers have to agree about format
// and size, and drivers differ in how much they will forgive.
gl_fbo_resolve(source: int, destination: int, width: int, height: int) -> int {
    drain_errors()
    glapi.glBindFramebuffer(glapi.READ_FRAMEBUFFER as uint32, source as uint32)
    glapi.glBindFramebuffer(glapi.DRAW_FRAMEBUFFER as uint32, destination as uint32)
    status = (glapi.glCheckFramebufferStatus(glapi.READ_FRAMEBUFFER as uint32)) as int
    if status != glapi.FRAMEBUFFER_COMPLETE {
        glapi.glBindFramebuffer(glapi.FRAMEBUFFER as uint32, 0)
        return status
    }
    glapi.glBlitFramebuffer(0, 0, width, height, 0, 0, width, height, glapi.COLOR_BUFFER_BIT as uint32, glapi.NEAREST as uint32)
    status = (glapi.glGetError()) as int
    glapi.glBindFramebuffer(glapi.FRAMEBUFFER as uint32, 0)
    return status
}

gl_fbo_complete() -> int {
    if (glapi.glCheckFramebufferStatus(glapi.FRAMEBUFFER as uint32)) as int == glapi.FRAMEBUFFER_COMPLETE { return 1 }
    return 0
}

// The scene's depth as drawn so far, copied into a texture the transparent
// pass can read: what a water surface asks to know how much water lies
// between it and the ground. One framebuffer and one depth texture, kept at
// the size of whatever is being drawn into and remade when that changes;
// the copy resolves a multisampled frame to one sample, which for depth
// takes the nearest. The texture, or 0 when the copy failed.
var g_depth_fbo = 0
var g_depth_texture = 0
var g_depth_width = 0
var g_depth_height = 0

gl_scene_depth_capture() -> int {
    x = gl_integer(glapi.VIEWPORT, 0, 4)
    y = gl_integer(glapi.VIEWPORT, 1, 4)
    width = gl_integer(glapi.VIEWPORT, 2, 4)
    height = gl_integer(glapi.VIEWPORT, 3, 4)
    if width < 1 || height < 1 { return 0 }
    source = gl_integer(glapi.DRAW_FRAMEBUFFER_BINDING, 0, 1)
    if g_depth_fbo == 0 { g_depth_fbo = gl_name(NAME_FRAMEBUFFER) }
    if g_depth_texture == 0 || width != g_depth_width || height != g_depth_height {
        gl_drop(NAME_TEXTURE, g_depth_texture)
        glapi.glActiveTexture(glapi.TEXTURE0 as uint32)
        // The same depth-stencil format the frame is drawn with: a blit of
        // depth is refused between formats that differ, and both the window
        // and the post-processing target carry 24 bits of depth with 8 of
        // stencil.
        g_depth_texture = target_texture(width, height, glapi.DEPTH24_STENCIL8, glapi.DEPTH_STENCIL,
                                         glapi.UNSIGNED_INT_24_8, glapi.NEAREST)
        texture_param(glapi.TEXTURE_2D, glapi.TEXTURE_COMPARE_MODE, glapi.NONE)
        attach_texture(g_depth_fbo, glapi.DEPTH_STENCIL_ATTACHMENT, g_depth_texture, 0)
        glapi.glDrawBuffer(glapi.NONE as uint32)
        glapi.glReadBuffer(glapi.NONE as uint32)
        g_depth_width = width
        g_depth_height = height
    }
    drain_errors()
    glapi.glBindFramebuffer(glapi.READ_FRAMEBUFFER as uint32, source as uint32)
    glapi.glBindFramebuffer(glapi.DRAW_FRAMEBUFFER as uint32, g_depth_fbo as uint32)
    glapi.glBlitFramebuffer(x, y, x + width, y + height, 0, 0, width, height, glapi.DEPTH_BUFFER_BIT as uint32,
                            glapi.NEAREST as uint32)
    glapi.glBindFramebuffer(glapi.FRAMEBUFFER as uint32, source as uint32)
    if (glapi.glGetError()) as int != glapi.NO_ERROR { return 0 }
    return g_depth_texture
}

// Packed 0xRRGGBB of one framebuffer pixel, for tests that must prove the
// scene was drawn rather than merely cleared.
gl_read_pixel(x: int, y: int) -> int {
    rgba = calloc(4, 1)
    glapi.glReadPixels(x, y, 1, 1, glapi.RGBA as uint32, glapi.UNSIGNED_BYTE as uint32, rgba)
    packed = (mem.get_uint8(rgba, 0) << 16) | (mem.get_uint8(rgba, 1) << 8) | mem.get_uint8(rgba, 2)
    free(rgba)
    return packed
}

// The frame on screen as RGBA bytes, top row first, in a buffer the caller
// frees: read from whatever framebuffer is bound, which for a windowed
// program between its last draw and its buffer swap is the finished frame.
// GL hands back rows bottom-up and every image format wants them the other
// way, so the copy out walks them backwards.
gl_read_frame(width: int, height: int) -> ptr {
    if width <= 0 || height <= 0 { return null }
    row = width * 4
    pixels = calloc(row * height, 1)
    flipped = calloc(row * height, 1)
    glapi.glPixelStorei(glapi.PACK_ALIGNMENT as uint32, 1)
    glapi.glReadPixels(0, 0, width, height, glapi.RGBA as uint32, glapi.UNSIGNED_BYTE as uint32, pixels)
    y = 0
    while y < height {
        mem.copy_at(flipped, (row * y) as long, pixels, (row * (height - 1 - y)) as long, row as long)
        y = y + 1
    }
    free(pixels)
    return flipped
}

// The frame's light, for the exposure that follows it (#378).
//
// What was drawn, measured: the finished frame copied at its own size into
// a texture (a blit at the same size is also what resolves a multisampled
// framebuffer, which a scaling blit may not read), its mip chain built, and
// the first level no wider than 320 texels read back -- an average of every
// pixel under each texel, fine enough that a lamp or a lit face covering a
// few dozen pixels still fills a texel. The read goes into one of three
// pixel buffers and the one filled two frames ago is mapped, so the CPU
// never waits on the frame it just asked for. The texels are the
// tone-mapped, gamma-encoded frame; `out` gets their mean linear luminance
// and the share of them near white (past 0.8 linear), which is what an
// exposure that follows the frame steers by. A source of -1 reads the
// framebuffer the frame was drawn into. True when `out` holds a
// measurement, false until the first one is back.
const METER_PACKS = 3
const TEXTURE_MAX_LEVEL = 33085       // 0x813D
const READ_FRAMEBUFFER_BINDING = 36010 // 0x8CAA

struct GLMeter {
    texture: int
    framebuffer: int
    level_framebuffer: int
    packs: ptr                       // int[METER_PACKS], pixel pack buffers
    width: int
    height: int
    level: int
    level_width: int
    level_height: int
    index: int
    filled: int
    linear: ptr                      // float[256]: an sRGB byte's linear light
}

var g_meter: ptr = null

the_meter() -> *GLMeter {
    if g_meter == null {
        m = calloc(1, sizeof(GLMeter)) as *GLMeter
        m.packs = calloc(METER_PACKS, 4)
        m.linear = calloc(256, 8)
        table = m.linear as float[]
        i = 0
        while i < 256 {
            v = (i as float) / 255.0
            if v <= 0.04045 { table[i] = v / 12.92 } else { table[i] = pow((v + 0.055) / 1.055, 2.4) }
            i = i + 1
        }
        g_meter = m as ptr
    }
    return g_meter as *GLMeter
}

meter_free(m: *GLMeter) {
    gl_drop(NAME_TEXTURE, m.texture)
    gl_drop(NAME_FRAMEBUFFER, m.framebuffer)
    gl_drop(NAME_FRAMEBUFFER, m.level_framebuffer)
    packs = m.packs as int[]
    if packs[0] != 0 { glapi.glDeleteBuffers(METER_PACKS, m.packs) }
    i = 0
    while i < METER_PACKS {
        packs[i] = 0
        i = i + 1
    }
    m.texture = 0
    m.framebuffer = 0
    m.level_framebuffer = 0
    m.width = 0
    m.height = 0
    m.index = 0
    m.filled = 0
}

meter_make(m: *GLMeter, width: int, height: int) {
    meter_free(m)
    level = 0
    w = width
    h = height
    while w > 320 {
        w = w / 2
        h = h / 2
        if w < 1 { w = 1 }
        if h < 1 { h = 1 }
        level = level + 1
    }
    m.texture = gl_name(NAME_TEXTURE)
    glapi.glBindTexture(glapi.TEXTURE_2D as uint32, m.texture as uint32)
    glapi.glTexImage2D(glapi.TEXTURE_2D as uint32, 0, glapi.RGBA, width, height, 0, glapi.RGBA as uint32,
                       glapi.UNSIGNED_BYTE as uint32, null)
    texture_param(glapi.TEXTURE_2D, TEXTURE_MAX_LEVEL, level)
    glapi.glGenerateMipmap(glapi.TEXTURE_2D as uint32)
    glapi.glBindTexture(glapi.TEXTURE_2D as uint32, 0)
    m.framebuffer = gl_name(NAME_FRAMEBUFFER)
    attach_texture(m.framebuffer, glapi.COLOR_ATTACHMENT0, m.texture, 0)
    m.level_framebuffer = gl_name(NAME_FRAMEBUFFER)
    attach_texture(m.level_framebuffer, glapi.COLOR_ATTACHMENT0, m.texture, level)
    glapi.glGenBuffers(METER_PACKS, m.packs)
    packs = m.packs as int[]
    i = 0
    while i < METER_PACKS {
        glapi.glBindBuffer(glapi.PIXEL_PACK_BUFFER as uint32, packs[i] as uint32)
        glapi.glBufferData(glapi.PIXEL_PACK_BUFFER as uint32, (w * h * 4) as long, null, glapi.STREAM_READ as uint32)
        i = i + 1
    }
    glapi.glBindBuffer(glapi.PIXEL_PACK_BUFFER as uint32, 0)
    m.width = width
    m.height = height
    m.level = level
    m.level_width = w
    m.level_height = h
}

gl_meter(source: int, width: int, height: int, out: ptr) -> int {
    if width < 1 || height < 1 || out == null { return 0 }
    m = the_meter()
    if width != m.width || height != m.height || m.texture == 0 { meter_make(m, width, height) }
    previous_read = gl_integer(READ_FRAMEBUFFER_BINDING, 0, 1)
    previous_draw = gl_integer(glapi.DRAW_FRAMEBUFFER_BINDING, 0, 1)
    // -1: whatever the frame was drawn into, the window or a target.
    from = source
    if from < 0 { from = previous_draw }
    glapi.glBindFramebuffer(glapi.READ_FRAMEBUFFER as uint32, from as uint32)
    glapi.glBindFramebuffer(glapi.DRAW_FRAMEBUFFER as uint32, m.framebuffer as uint32)
    glapi.glBlitFramebuffer(0, 0, width, height, 0, 0, width, height, glapi.COLOR_BUFFER_BIT as uint32, glapi.NEAREST as uint32)
    glapi.glBindTexture(glapi.TEXTURE_2D as uint32, m.texture as uint32)
    glapi.glGenerateMipmap(glapi.TEXTURE_2D as uint32)
    glapi.glBindTexture(glapi.TEXTURE_2D as uint32, 0)
    glapi.glBindFramebuffer(glapi.READ_FRAMEBUFFER as uint32, m.level_framebuffer as uint32)
    glapi.glPixelStorei(glapi.PACK_ALIGNMENT as uint32, 1)
    packs = m.packs as int[]
    glapi.glBindBuffer(glapi.PIXEL_PACK_BUFFER as uint32, packs[m.index] as uint32)
    glapi.glReadPixels(0, 0, m.level_width, m.level_height, glapi.RGBA as uint32, glapi.UNSIGNED_BYTE as uint32, null)
    m.filled = m.filled + 1
    got = 0
    // The one read two frames ago, when there has been one.
    if m.filled >= METER_PACKS {
        ready = (m.index + 1) % METER_PACKS
        glapi.glBindBuffer(glapi.PIXEL_PACK_BUFFER as uint32, packs[ready] as uint32)
        texels = glapi.glMapBuffer(glapi.PIXEL_PACK_BUFFER as uint32, glapi.READ_ONLY as uint32)
        if texels != null {
            table = m.linear as float[]
            count = m.level_width * m.level_height
            sum = 0.0
            white = 0
            i = 0
            while i < count {
                at = i * 4
                luma = 0.2126 * table[mem.get_uint8(texels, at)] + 0.7152 * table[mem.get_uint8(texels, at + 1)] +
                       0.0722 * table[mem.get_uint8(texels, at + 2)]
                sum = sum + luma
                if luma > 0.8 { white = white + 1 }
                i = i + 1
            }
            o = out as float[]
            o[0] = sum / (count as float)
            o[1] = (white as float) / (count as float)
            glapi.glUnmapBuffer(glapi.PIXEL_PACK_BUFFER as uint32)
            got = 1
        }
    }
    glapi.glBindBuffer(glapi.PIXEL_PACK_BUFFER as uint32, 0)
    m.index = (m.index + 1) % METER_PACKS
    glapi.glBindFramebuffer(glapi.READ_FRAMEBUFFER as uint32, previous_read as uint32)
    glapi.glBindFramebuffer(glapi.DRAW_FRAMEBUFFER as uint32, previous_draw as uint32)
    return got
}

// --- programs, uniforms and textures, in Aether (#398) ---------------------------------------

var g_program_log = ""

// Why the last program did not build: the stage and GL's own log.
gl_program_log() -> string { return g_program_log }

// `count` of GL's info log, from `fetch` (the shader's or the program's).
info_log(object: int, length: int, shader: bool) -> string {
    if length <= 1 { return "" }
    buffer = calloc(length + 1, 1)
    if shader {
        glapi.glGetShaderInfoLog(object as uint32, length, null, buffer)
    } else {
        glapi.glGetProgramInfoLog(object as uint32, length, null, buffer)
    }
    text = bytes.string_from_ptr(buffer, length - 1)
    free(buffer)
    return text
}

// One of GL's integers about a shader or a program.
object_integer(object: int, name: int, shader: bool) -> int {
    out = calloc(1, 4)
    if shader {
        glapi.glGetShaderiv(object as uint32, name as uint32, out)
    } else {
        glapi.glGetProgramiv(object as uint32, name as uint32, out)
    }
    value = (out as int[])[0]
    free(out)
    return value
}

// A stage compiled, or 0 with the log saying why.
compile_stage(kind: int, source: string, label: string) -> int {
    shader = (glapi.glCreateShader(kind as uint32)) as int
    sources = calloc(1, 8)
    (sources as ptr[])[0] = glapi.cstr(source)
    glapi.glShaderSource(shader as uint32, 1, sources, null)
    free(sources)
    glapi.glCompileShader(shader as uint32)
    if object_integer(shader, glapi.COMPILE_STATUS, true) == glapi.FALSE {
        length = object_integer(shader, glapi.INFO_LOG_LENGTH, true)
        g_program_log = "${label} shader: ${info_log(shader, length, true)}"
        glapi.glDeleteShader(shader as uint32)
        return 0
    }
    return shader
}

gl_program_create(vertex_src: string, fragment_src: string) -> int {
    g_program_log = ""
    if vertex_src == null || fragment_src == null {
        g_program_log = "missing shader source"
        return 0
    }
    vertex = compile_stage(glapi.VERTEX_SHADER, vertex_src, "vertex")
    if vertex == 0 { return 0 }
    fragment = compile_stage(glapi.FRAGMENT_SHADER, fragment_src, "fragment")
    if fragment == 0 {
        glapi.glDeleteShader(vertex as uint32)
        return 0
    }
    program = (glapi.glCreateProgram()) as int
    glapi.glAttachShader(program as uint32, vertex as uint32)
    glapi.glAttachShader(program as uint32, fragment as uint32)
    glapi.glLinkProgram(program as uint32)
    linked = object_integer(program, glapi.LINK_STATUS, false)
    glapi.glDetachShader(program as uint32, vertex as uint32)
    glapi.glDetachShader(program as uint32, fragment as uint32)
    glapi.glDeleteShader(vertex as uint32)
    glapi.glDeleteShader(fragment as uint32)
    if linked == glapi.FALSE {
        length = object_integer(program, glapi.INFO_LOG_LENGTH, false)
        g_program_log = "link: ${info_log(program, length, false)}"
        glapi.glDeleteProgram(program as uint32)
        return 0
    }
    return program
}

gl_program_delete(program: int) {
    if program != 0 { glapi.glDeleteProgram(program as uint32) }
}

gl_program_use(program: int) { glapi.glUseProgram(program as uint32) }

gl_uniform_location(program: int, name: string) -> int {
    if program == 0 || name == null { return 0 - 1 }
    return glapi.glGetUniformLocation(program as uint32, name)
}

gl_uniform_int(loc: int, v: int) {
    if loc >= 0 { glapi.glUniform1i(loc, v) }
}

gl_uniform_float(loc: int, v: float) {
    if loc >= 0 { glapi.glUniform1f(loc, v as f32) }
}

gl_uniform_vec2(loc: int, x: float, y: float) {
    if loc >= 0 { glapi.glUniform2f(loc, x as f32, y as f32) }
}

gl_uniform_vec3(loc: int, x: float, y: float, z: float) {
    if loc >= 0 { glapi.glUniform3f(loc, x as f32, y as f32, z as f32) }
}

// Sixteen doubles, column-major, as sixteen floats.
gl_uniform_mat4(loc: int, m: ptr) {
    if loc < 0 || m == null { return }
    values = calloc(16, 4)
    from = m as float[]
    to = values as f32[]
    i = 0
    while i < 16 {
        to[i] = from[i] as f32
        i = i + 1
    }
    glapi.glUniformMatrix4fv(loc, 1, glapi.FALSE, values)
    free(values)
}

// A float array (core's ae3d_farr, still C while vulkan.c reads it): its
// values and its count, as the C lays them out.
struct GLFloats {
    values: ptr
    count: int
}

gl_uniform_float_array(loc: int, arr: ptr) {
    if loc < 0 || arr == null { return }
    a = arr as *GLFloats
    glapi.glUniform1fv(loc, a.count, a.values)
}

gl_uniform_vec3_array(loc: int, arr: ptr) {
    if loc < 0 || arr == null { return }
    a = arr as *GLFloats
    glapi.glUniform3fv(loc, a.count / 3, a.values)
}

// A texture name, made and bound to `target`, with byte rows unpadded.
new_texture(target: int) -> int {
    out = calloc(1, 4)
    glapi.glGenTextures(1, out)
    texture = (out as int[])[0]
    free(out)
    glapi.glBindTexture(target as uint32, texture as uint32)
    glapi.glPixelStorei(glapi.UNPACK_ALIGNMENT as uint32, 1)
    return texture
}

texture_param(target: int, name: int, value: int) {
    glapi.glTexParameteri(target as uint32, name as uint32, value)
}

// Wrapping on s and t (and r, for a 3D one), and the filters.
texture_params(target: int, wrap: int, three: bool, mag: int, min: int) {
    texture_param(target, glapi.TEXTURE_WRAP_S, wrap)
    texture_param(target, glapi.TEXTURE_WRAP_T, wrap)
    if three { texture_param(target, glapi.TEXTURE_WRAP_R, wrap) }
    texture_param(target, glapi.TEXTURE_MAG_FILTER, mag)
    texture_param(target, glapi.TEXTURE_MIN_FILTER, min)
}

gl_texture_from_image(img: ptr, srgb: int, mipmap: int) -> int {
    pixels = ae3d_image_pixels(img)
    width = ae3d_image_width(img)
    height = ae3d_image_height(img)
    if pixels == null || width <= 0 || height <= 0 { return 0 }
    texture = new_texture(glapi.TEXTURE_2D)
    internal = glapi.RGBA
    if srgb != 0 { internal = glapi.SRGB8_ALPHA8 }
    glapi.glTexImage2D(glapi.TEXTURE_2D as uint32, 0, internal, width, height, 0, glapi.RGBA as uint32,
                       glapi.UNSIGNED_BYTE as uint32, pixels)
    if mipmap != 0 {
        texture_params(glapi.TEXTURE_2D, glapi.REPEAT, false, glapi.LINEAR, glapi.LINEAR_MIPMAP_LINEAR)
        glapi.glGenerateMipmap(glapi.TEXTURE_2D as uint32)
    } else {
        texture_params(glapi.TEXTURE_2D, glapi.REPEAT, false, glapi.LINEAR, glapi.LINEAR)
    }
    glapi.glBindTexture(glapi.TEXTURE_2D as uint32, 0)
    return texture
}

// A texture from raw RGBA bytes: linear, repeating, no mipmaps. What a
// baked map -- the clouds' weather -- is uploaded as.
gl_texture_rgba(width: int, height: int, rgba: ptr) -> int {
    if rgba == null || width <= 0 || height <= 0 { return 0 }
    texture = new_texture(glapi.TEXTURE_2D)
    glapi.glTexImage2D(glapi.TEXTURE_2D as uint32, 0, glapi.RGBA, width, height, 0, glapi.RGBA as uint32,
                       glapi.UNSIGNED_BYTE as uint32, rgba)
    texture_params(glapi.TEXTURE_2D, glapi.REPEAT, false, glapi.LINEAR, glapi.LINEAR)
    glapi.glBindTexture(glapi.TEXTURE_2D as uint32, 0)
    return texture
}

// A 3D texture, `size` cubed RGBA bytes: linear, repeating on every axis,
// which is what a tileable noise the clouds are shaped by wants.
gl_texture3d_rgba(size: int, rgba: ptr) -> int {
    if rgba == null || size <= 0 { return 0 }
    texture = new_texture(glapi.TEXTURE_3D)
    glapi.glTexImage3D(glapi.TEXTURE_3D as uint32, 0, glapi.RGBA, size, size, size, 0, glapi.RGBA as uint32,
                       glapi.UNSIGNED_BYTE as uint32, rgba)
    texture_params(glapi.TEXTURE_3D, glapi.REPEAT, true, glapi.LINEAR, glapi.LINEAR)
    glapi.glBindTexture(glapi.TEXTURE_3D as uint32, 0)
    return texture
}

gl_texture3d_bind(unit: int, texture: int) {
    glapi.glActiveTexture((glapi.TEXTURE0 + unit) as uint32)
    glapi.glBindTexture(glapi.TEXTURE_3D as uint32, texture as uint32)
}

// A pose bank as a float texture the skinning shader samples per instance.
// The bank is frame-major, bone-major, sixteen floats a bone -- one RGBA32F
// row of `bones * 4` texels a frame -- so its bytes upload straight in with
// no repacking. Nearest, clamped: the shader fetches exact texels by (bone
// column, frame), never filters between them. 32-bit float, since a bone
// matrix carries translations a 16-bit float would round the crowd apart on.
gl_posebank_texture(data: ptr, frames: int, bones: int) -> int {
    if data == null || frames <= 0 || bones <= 0 { return 0 }
    texture = new_texture(glapi.TEXTURE_2D)
    glapi.glTexImage2D(glapi.TEXTURE_2D as uint32, 0, RGBA32F, bones * 4, frames, 0, glapi.RGBA as uint32,
                       glapi.FLOAT as uint32, data)
    texture_params(glapi.TEXTURE_2D, glapi.CLAMP_TO_EDGE, false, glapi.NEAREST, glapi.NEAREST)
    glapi.glBindTexture(glapi.TEXTURE_2D as uint32, 0)
    return texture
}

const RGBA32F = 34836                // GL_RGBA32F, 0x8814

gl_texture_delete(texture: int) {
    if texture == 0 { return }
    names = calloc(1, 4)
    (names as int[])[0] = texture
    glapi.glDeleteTextures(1, names)
    free(names)
}

gl_texture_bind(unit: int, texture: int) {
    glapi.glActiveTexture((glapi.TEXTURE0 + unit) as uint32)
    glapi.glBindTexture(glapi.TEXTURE_2D as uint32, texture as uint32)
}

// --- geometry, attributes and draws, in Aether (#398) ---------------------------------------
//
// What native/gpu/opengl.c's second part was. Strides in bytes: a vertex is
// nine floats (position, uv, normal, baked occlusion), a skin eight (four
// joints, four weights), an instance matrix sixteen, a colour three, a point
// eight (position and scale, colour, phase).

const STRIDE_BYTES = 36
const SKIN_BYTES = 32
const MATRIX_BYTES = 64
const COLOR_BYTES = 12
const POINT_BYTES = 32

// An offset into a bound buffer, as GL takes it: a pointer.
at_byte(n: int) -> ptr { return mem.long_to_ptr(n as long) }

attrib(index: int, size: int, stride: int, offset: int) {
    glapi.glVertexAttribPointer(index as uint32, size, glapi.FLOAT as uint32, glapi.FALSE, stride, at_byte(offset))
    glapi.glEnableVertexAttribArray(index as uint32)
}

attrib_per_instance(index: int, size: int, stride: int, offset: int) {
    glapi.glEnableVertexAttribArray(index as uint32)
    glapi.glVertexAttribPointer(index as uint32, size, glapi.FLOAT as uint32, glapi.FALSE, stride, at_byte(offset))
    glapi.glVertexAttribDivisor(index as uint32, 1)
}

// `bytes` from `data` into buffer `vbo` on `target`, as a whole new store.
buffer_data(target: int, vbo: int, bytes: int, data: ptr, usage: int) {
    glapi.glBindBuffer(target as uint32, vbo as uint32)
    glapi.glBufferData(target as uint32, bytes as long, data, usage as uint32)
}

// Geometry that appears many times is uploaded once and drawn from one set
// of buffers, which is what lets the renderer merge those models into a
// single instanced draw. An entry keeps its own copy of the bytes it was
// built from, so a match is an exact comparison rather than a hash that
// could collide and hand back the wrong mesh.
struct GLGeometry {
    vertices: ptr
    indices: ptr
    vertex_count: int
    index_count: int
    vao: int
    vbo: int
    ebo: int
    instance_vbo: int
    instance_capacity: int
    refs: int
}

var g_geometry: ptr = null         // list of *GLGeometry

geometry_entries() -> ptr {
    if g_geometry == null { g_geometry = list.new() }
    return g_geometry
}

geometry_of(vao: int) -> *GLGeometry {
    entries = geometry_entries()
    i = 0
    while i < list.size(entries) {
        e = list.get_raw(entries, i) as *GLGeometry
        if e.vao == vao && e.refs > 0 { return e }
        i = i + 1
    }
    return null
}

// The VAO the caller should draw with: the cached one when these bytes are
// already up, else a new entry uploaded and its attributes set up once.
gl_geometry_acquire(mesh: ptr) -> int {
    vertices = geometry.mesh_vertex_data(mesh)
    indices = geometry.mesh_index_data(mesh)
    vertex_count = geometry.mesh_vertex_count(mesh)
    index_count = geometry.mesh_index_count(mesh)
    if vertices == null || indices == null || vertex_count <= 0 || index_count <= 0 { return 0 }
    vertex_bytes = vertex_count * STRIDE_BYTES
    index_bytes = index_count * 4
    entries = geometry_entries()
    i = 0
    while i < list.size(entries) {
        e = list.get_raw(entries, i) as *GLGeometry
        if e.refs > 0 && e.vertex_count == vertex_count && e.index_count == index_count &&
           mem.compare(e.vertices, vertices, vertex_bytes as long) == 0 &&
           mem.compare(e.indices, indices, index_bytes as long) == 0 {
            e.refs = e.refs + 1
            return e.vao
        }
        i = i + 1
    }
    e = calloc(1, sizeof(GLGeometry)) as *GLGeometry
    e.vertices = calloc(vertex_bytes, 1)
    e.indices = calloc(index_bytes, 1)
    mem.copy(e.vertices, vertices, vertex_bytes as long)
    mem.copy(e.indices, indices, index_bytes as long)
    e.vertex_count = vertex_count
    e.index_count = index_count
    e.vao = gl_vao_create()
    e.vbo = gl_buffer_create()
    e.ebo = gl_buffer_create()
    e.instance_vbo = gl_buffer_create()
    e.refs = 1
    list.add_raw(entries, e as ptr)
    glapi.glBindVertexArray(e.vao as uint32)
    gl_upload_mesh(mesh, e.vbo, e.ebo)
    gl_setup_vertex_attribs()
    glapi.glBindVertexArray(0)
    return e.vao
}

gl_geometry_instance_vbo(vao: int) -> int {
    e = geometry_of(vao)
    if e == null { return 0 }
    return e.instance_vbo
}

gl_geometry_release(vao: int) {
    e = geometry_of(vao)
    if e == null { return }
    e.refs = e.refs - 1
    if e.refs > 0 { return }
    gl_vao_delete(e.vao)
    gl_buffer_delete(e.vbo)
    gl_buffer_delete(e.ebo)
    gl_buffer_delete(e.instance_vbo)
    entries = geometry_entries()
    i = 0
    while i < list.size(entries) {
        if list.get_raw(entries, i) == e as ptr { list.remove(entries, i); break }
        i = i + 1
    }
    free(e.vertices)
    free(e.indices)
    free(e as ptr)
}

// Only when nothing is holding geometry any more, so a second renderer in
// the same process does not lose the buffers it is still drawing from.
gl_geometry_shutdown() {
    if g_geometry == null { return }
    if list.size(g_geometry) > 0 { return }
    list.free(g_geometry)
    g_geometry = null
}

gl_geometry_instance_capacity(vao: int) -> int {
    e = geometry_of(vao)
    if e == null { return 0 }
    return e.instance_capacity
}

gl_geometry_set_instance_capacity(vao: int, capacity: int) {
    e = geometry_of(vao)
    if e != null { e.instance_capacity = capacity }
}

gl_upload_mesh(mesh: ptr, vbo: int, ebo: int) {
    vertices = geometry.mesh_vertex_data(mesh)
    indices = geometry.mesh_index_data(mesh)
    vertex_count = geometry.mesh_vertex_count(mesh)
    index_count = geometry.mesh_index_count(mesh)
    if vbo != 0 && vertices != null && vertex_count > 0 {
        buffer_data(glapi.ARRAY_BUFFER, vbo, vertex_count * STRIDE_BYTES, vertices, glapi.STATIC_DRAW)
    }
    if ebo != 0 && indices != null && index_count > 0 {
        buffer_data(glapi.ELEMENT_ARRAY_BUFFER, ebo, index_count * 4, indices, glapi.STATIC_DRAW)
    }
}

gl_update_mesh_vertices(mesh: ptr, vbo: int) {
    vertices = geometry.mesh_vertex_data(mesh)
    vertex_count = geometry.mesh_vertex_count(mesh)
    if vbo == 0 || vertices == null || vertex_count <= 0 { return }
    glapi.glBindBuffer(glapi.ARRAY_BUFFER as uint32, vbo as uint32)
    glapi.glBufferSubData(glapi.ARRAY_BUFFER as uint32, 0, (vertex_count * STRIDE_BYTES) as long, vertices)
}

// Joints and weights live in their own buffer on attributes 8 and 9, so a
// mesh that is not skinned uploads nothing extra and reads the stride it
// always read. Slots 0-2 are the vertex, 3-6 the instance matrix and 7 its
// colour.
gl_upload_skin(mesh: ptr, vbo: int) {
    skin = geometry.mesh_skin_data(mesh)
    vertex_count = geometry.mesh_vertex_count(mesh)
    if vbo == 0 || skin == null || vertex_count <= 0 { return }
    buffer_data(glapi.ARRAY_BUFFER, vbo, vertex_count * SKIN_BYTES, skin, glapi.STATIC_DRAW)
    attrib(8, 4, SKIN_BYTES, 0)
    attrib(9, 4, SKIN_BYTES, 16)
}

gl_uniform_mat4v(loc: int, count: int, values: ptr) {
    if loc < 0 || count <= 0 || values == null { return }
    glapi.glUniformMatrix4fv(loc, count, glapi.FALSE, values)
}

gl_setup_vertex_attribs() {
    attrib(0, 3, STRIDE_BYTES, 0)
    attrib(1, 2, STRIDE_BYTES, 12)
    attrib(2, 3, STRIDE_BYTES, 20)
    // Slot 10, because 3-6 carry the instance matrix, 7 its colour and 8-9
    // the skin. Baked occlusion rides with the vertex, so it needs no
    // binding of its own and no pipeline that knows about it.
    attrib(10, 1, STRIDE_BYTES, 32)
}

// A vertex array over buffers that already exist: a proxy mesh's vertices,
// indices and skin with another model's instance matrices, colours and
// phases, for a depth-only draw of that model through the proxy's mesh
// (model_set_depth_proxy). Nothing is uploaded; the attributes are pointed
// at the buffers the two models keep, so the model's instance updates and
// the proxy's mesh both reach this array without a copy.
gl_setup_proxy_vao(vao: int, mesh_vbo: int, mesh_ebo: int, skin_vbo: int,
                        matrix_vbo: int, color_vbo: int, phase_vbo: int) {
    if vao == 0 || mesh_vbo == 0 || mesh_ebo == 0 || matrix_vbo == 0 { return }
    glapi.glBindVertexArray(vao as uint32)
    glapi.glBindBuffer(glapi.ARRAY_BUFFER as uint32, mesh_vbo as uint32)
    gl_setup_vertex_attribs()
    glapi.glBindBuffer(glapi.ELEMENT_ARRAY_BUFFER as uint32, mesh_ebo as uint32)
    if skin_vbo != 0 {
        glapi.glBindBuffer(glapi.ARRAY_BUFFER as uint32, skin_vbo as uint32)
        attrib(8, 4, SKIN_BYTES, 0)
        attrib(9, 4, SKIN_BYTES, 16)
    }
    glapi.glBindBuffer(glapi.ARRAY_BUFFER as uint32, matrix_vbo as uint32)
    matrix_columns()
    if color_vbo != 0 {
        glapi.glBindBuffer(glapi.ARRAY_BUFFER as uint32, color_vbo as uint32)
        attrib_per_instance(7, 3, COLOR_BYTES, 0)
    }
    if phase_vbo != 0 {
        glapi.glBindBuffer(glapi.ARRAY_BUFFER as uint32, phase_vbo as uint32)
        attrib_per_instance(11, 1, 4, 0)
    }
    glapi.glBindVertexArray(0)
}

// The instance matrix's four columns on locations 3 to 6, from the bound
// buffer.
matrix_columns() {
    i = 0
    while i < 4 {
        attrib_per_instance(3 + i, 4, MATRIX_BYTES, i * 16)
        i = i + 1
    }
}

// The crowd's extra instance attribute: one float an instance at location
// 11, the animation phase VERTEX_CROWD reads to pick a pose-bank frame.
// Called after the shared setup, so a crowd draw carries matrices, colours
// and phases and an ordinary instanced draw carries only the first two.
gl_setup_instance_phase(inst: ptr, phase_vbo: int) {
    if geometry.inst_is_points(inst) != 0 { return }
    phases = geometry.inst_phase_data(inst)
    count = geometry.inst_count(inst)
    if count <= 0 || phase_vbo == 0 || phases == null || geometry.inst_has_phases(inst) == 0 { return }
    buffer_data(glapi.ARRAY_BUFFER, phase_vbo, count * 4, phases, glapi.DYNAMIC_DRAW)
    attrib_per_instance(11, 1, 4, 0)
}

// The point layout: eight floats an instance in the one buffer. Location 3
// takes the position and the scale as a vec4, location 7 the colour and 11
// the phase from the same stride; 4 to 6, the matrix's other columns, are
// left disabled and the shader does not read them for a point.
point_attribs() {
    attrib_per_instance(3, 4, POINT_BYTES, 0)
    i = 1
    while i < 4 {
        glapi.glDisableVertexAttribArray((3 + i) as uint32)
        i = i + 1
    }
    attrib_per_instance(7, 3, POINT_BYTES, 16)
    attrib_per_instance(11, 1, POINT_BYTES, 28)
}

gl_setup_instance_attribs(inst: ptr, matrix_vbo: int, color_vbo: int) {
    count = geometry.inst_count(inst)
    if count <= 0 || matrix_vbo == 0 { return }
    if geometry.inst_is_points(inst) != 0 {
        points = geometry.inst_point_data(inst)
        if points == null { return }
        buffer_data(glapi.ARRAY_BUFFER, matrix_vbo, count * POINT_BYTES, points, glapi.DYNAMIC_DRAW)
        point_attribs()
        return
    }
    matrices = geometry.inst_matrix_data(inst)
    if matrices == null { return }
    buffer_data(glapi.ARRAY_BUFFER, matrix_vbo, count * MATRIX_BYTES, matrices, glapi.DYNAMIC_DRAW)
    matrix_columns()
    colors = geometry.inst_color_data(inst)
    if color_vbo != 0 && colors != null && geometry.inst_has_colors(inst) != 0 {
        buffer_data(glapi.ARRAY_BUFFER, color_vbo, count * COLOR_BYTES, colors, glapi.STATIC_DRAW)
        attrib_per_instance(7, 3, COLOR_BYTES, 0)
    }
}

// A batch draws through the shared VAO with the matrices of the models it
// merged. The colour attribute stays disabled, so the generic value set at
// startup supplies white and the shader's per-instance tint is a no-op.
gl_batch_upload(vao: int, instance_vbo: int, inst: ptr, capacity_bytes: int) -> int {
    matrices = geometry.inst_matrix_data(inst)
    count = geometry.inst_count(inst)
    if vao == 0 || instance_vbo == 0 || count <= 0 || matrices == null { return capacity_bytes }
    glapi.glBindVertexArray(vao as uint32)
    glapi.glBindBuffer(glapi.ARRAY_BUFFER as uint32, instance_vbo as uint32)
    wanted = count * MATRIX_BYTES
    capacity = capacity_bytes
    if capacity < wanted {
        glapi.glBufferData(glapi.ARRAY_BUFFER as uint32, wanted as long, matrices, glapi.DYNAMIC_DRAW as uint32)
        capacity = wanted
    } else {
        glapi.glBufferSubData(glapi.ARRAY_BUFFER as uint32, 0, wanted as long, matrices)
    }
    matrix_columns()
    // Set with the batch's own vertex array bound, so it holds whether the
    // driver treats a generic attribute value as context or per-array state.
    glapi.glDisableVertexAttribArray(7)
    glapi.glVertexAttrib3f(7, 1.0 as f32, 1.0 as f32, 1.0 as f32)
    return capacity
}

// Generic attribute values are context state, so one call covers every VAO
// that leaves the per-instance colour array disabled.
gl_set_default_instance_color() {
    glapi.glVertexAttrib3f(7, 1.0 as f32, 1.0 as f32, 1.0 as f32)
}

gl_update_instances(inst: ptr, matrix_vbo: int, capacity_bytes: int) -> int {
    count = geometry.inst_count(inst)
    if count <= 0 || matrix_vbo == 0 { return capacity_bytes }
    data = null as ptr
    needed = 0
    if geometry.inst_is_points(inst) != 0 {
        // The whole stream, position, scale, colour and phase in one: a
        // point's colour and phase have no buffer of their own to refresh.
        data = geometry.inst_point_data(inst)
        needed = count * POINT_BYTES
    } else {
        data = geometry.inst_matrix_data(inst)
        needed = count * MATRIX_BYTES
    }
    if data == null { return capacity_bytes }
    glapi.glBindBuffer(glapi.ARRAY_BUFFER as uint32, matrix_vbo as uint32)
    if needed > capacity_bytes {
        grown = needed + needed / 2
        glapi.glBufferData(glapi.ARRAY_BUFFER as uint32, grown as long, null, glapi.DYNAMIC_DRAW as uint32)
        glapi.glBufferSubData(glapi.ARRAY_BUFFER as uint32, 0, needed as long, data)
        return grown
    }
    glapi.glBufferSubData(glapi.ARRAY_BUFFER as uint32, 0, needed as long, data)
    return capacity_bytes
}

// The colours are uploaded when the model is registered, which is the only
// time they ever were: a colour set afterwards sat in the instance buffer
// and never reached the GPU.
gl_update_instance_colors(inst: ptr, color_vbo: int) {
    if geometry.inst_is_points(inst) != 0 { return }
    colors = geometry.inst_color_data(inst)
    count = geometry.inst_count(inst)
    if count <= 0 || color_vbo == 0 || colors == null || geometry.inst_has_colors(inst) == 0 { return }
    buffer_data(glapi.ARRAY_BUFFER, color_vbo, count * COLOR_BYTES, colors, glapi.DYNAMIC_DRAW)
}

// The per-instance phases each frame -- a crowd's animation advances, so
// unlike colours these change constantly. Just the data; the location-11
// binding was set once at registration.
gl_update_instance_phases(inst: ptr, phase_vbo: int) {
    if geometry.inst_is_points(inst) != 0 { return }
    phases = geometry.inst_phase_data(inst)
    count = geometry.inst_count(inst)
    if count <= 0 || phase_vbo == 0 || phases == null || geometry.inst_has_phases(inst) == 0 { return }
    buffer_data(glapi.ARRAY_BUFFER, phase_vbo, count * 4, phases, glapi.DYNAMIC_DRAW)
}

gl_draw_elements(count: int, byte_offset: int) {
    glapi.glDrawElements(glapi.TRIANGLES as uint32, count, glapi.UNSIGNED_INT as uint32, at_byte(byte_offset))
}

gl_draw_elements_instanced(count: int, byte_offset: int, instances: int) {
    glapi.glDrawElementsInstanced(glapi.TRIANGLES as uint32, count, glapi.UNSIGNED_INT as uint32, at_byte(byte_offset), instances)
}

gl_draw_arrays(first: int, count: int) {
    glapi.glDrawArrays(glapi.TRIANGLES as uint32, first, count)
}

// --- the context's entry points, its version and its renderer (#398) -----------------------

var g_loaded = false
var g_version = ""
var g_renderer = ""

// One of GL's strings (glGetString), as an Aether string.
gl_string(name: int) -> string {
    p = glapi.glGetString(name as uint32)
    if p == null { return "" }
    return bytes.string_from_ptr(p, strlen(p))
}

// Whether the current context has every entry point ae3d calls: 0 when it
// has, or how many it lacks. The version and the renderer are read once.
gl_load() -> int {
    if g_loaded { return 0 }
    missing = glapi.missing()
    if missing == 0 {
        g_version = gl_string(glapi.VERSION)
        g_renderer = gl_string(glapi.RENDERER)
        g_loaded = true
    }
    return missing
}

gl_version() -> string { return g_version }
gl_renderer() -> string { return g_renderer }

// --- the GL state, in Aether (#398) ----------------------------------------------------------
//
// What native/gpu/opengl.c's first page was: the viewport, the clears, the
// depth test, culling, blending, multisampling and wireframe, the viewport's
// size, and the vertex arrays and buffers -- each a call or two into GL
// through ae3d.glapi. The gl_ functions here are this module's own, under
// the renderer's calls (the renderer_ ones) and over glapi's.

gl_error() -> int { return (glapi.glGetError()) as int }

gl_viewport(x: int, y: int, w: int, h: int) { glapi.glViewport(x, y, w, h) }

gl_clear_color(r: float, g: float, b: float, a: float) {
    glapi.glClearColor(r as f32, g as f32, b as f32, a as f32)
}

gl_clear(color: int, depth: int) {
    mask = 0
    if color != 0 { mask = mask | glapi.COLOR_BUFFER_BIT }
    if depth != 0 { mask = mask | glapi.DEPTH_BUFFER_BIT }
    if mask != 0 { glapi.glClear(mask as uint32) }
}

gl_clear_depth(d: float) { glapi.glClearDepth(d) }

gl_set_depth_test(on: int) {
    if on != 0 {
        glapi.glEnable(glapi.DEPTH_TEST as uint32)
        glapi.glDepthFunc(glapi.LEQUAL as uint32)
        glapi.glDepthMask(glapi.TRUE)
    } else {
        glapi.glDisable(glapi.DEPTH_TEST as uint32)
    }
}

gl_set_depth_mask(on: int) {
    if on != 0 { glapi.glDepthMask(glapi.TRUE) } else { glapi.glDepthMask(glapi.FALSE) }
}

gl_set_face_culling(on: int) {
    if on != 0 {
        glapi.glEnable(glapi.CULL_FACE as uint32)
        glapi.glCullFace(glapi.BACK as uint32)
        glapi.glFrontFace(glapi.CCW as uint32)
    } else {
        glapi.glDisable(glapi.CULL_FACE as uint32)
    }
}

gl_set_blend(on: int) {
    if on != 0 {
        glapi.glEnable(glapi.BLEND as uint32)
        glapi.glBlendFunc(glapi.SRC_ALPHA as uint32, glapi.ONE_MINUS_SRC_ALPHA as uint32)
    } else {
        glapi.glDisable(glapi.BLEND as uint32)
    }
}

// What is drawn scales what is there: the occlusion pass darkening the
// opaque scene under it. gl_set_blend(1) puts the ordinary blend back.
gl_set_blend_multiply() {
    glapi.glEnable(glapi.BLEND as uint32)
    glapi.glBlendFunc(glapi.DST_COLOR as uint32, glapi.ZERO as uint32)
}

gl_set_multisample(on: int) {
    if on != 0 { glapi.glEnable(glapi.MULTISAMPLE as uint32) } else { glapi.glDisable(glapi.MULTISAMPLE as uint32) }
}

gl_set_wireframe(on: int) {
    mode = glapi.FILL
    if on != 0 { mode = glapi.LINE }
    glapi.glPolygonMode(glapi.FRONT_AND_BACK as uint32, mode as uint32)
}

// One of GL's integers (glGetIntegerv), the `index`th of what it answers.
gl_integer(name: int, index: int, count: int) -> int {
    out = calloc(count, 4)
    glapi.glGetIntegerv(name as uint32, out)
    value = (out as int[])[index]
    free(out)
    return value
}

gl_viewport_width() -> int { return gl_integer(glapi.VIEWPORT, 2, 4) }
gl_viewport_height() -> int { return gl_integer(glapi.VIEWPORT, 3, 4) }

// The widest texture the context takes, a side.
gl_max_texture_size() -> int { return gl_integer(glapi.MAX_TEXTURE_SIZE, 0, 1) }

// A name GL makes (glGenVertexArrays, glGenBuffers): one, into a word.
gl_vao_create() -> int {
    out = calloc(1, 4)
    glapi.glGenVertexArrays(1, out)
    id = (out as int[])[0]
    free(out)
    return id
}

gl_vao_bind(vao: int) { glapi.glBindVertexArray(vao as uint32) }

gl_vao_delete(vao: int) {
    if vao == 0 { return }
    names = calloc(1, 4)
    (names as int[])[0] = vao
    glapi.glDeleteVertexArrays(1, names)
    free(names)
}

gl_buffer_create() -> int {
    out = calloc(1, 4)
    glapi.glGenBuffers(1, out)
    id = (out as int[])[0]
    free(out)
    return id
}

gl_buffer_delete(buffer: int) {
    if buffer == 0 { return }
    names = calloc(1, 4)
    (names as int[])[0] = buffer
    glapi.glDeleteBuffers(1, names)
    free(names)
}

const MAX_FBO_DIMENSION = 8192
const SHADOW_SIZE = 2048
const MAX_LIGHTS = 16
const LIGHT_SLOTS = 12

struct ProgramSlots {
    program: int
    frame_stamp: int
    view_projection: int
    model: int
    // Last frame's, for the motion vectors, with the frame's nudge and the
    // crowd's step over the frame.
    prev_model: int
    prev_view_projection: int
    jitter: int
    crowd_travel: int
    crowd_phase_step: int
    // The scene depth a water surface reads its shore from.
    scene_depth: int
    has_scene_depth: int
    screen_size: int
    inv_view_projection: int
    // The clouds' shadow: cover, drift and the sun, the same three the sky
    // draws the clouds with.
    cloud_cover: int
    cloud_time: int
    sky_overcast: int
    sky_overcast_color: int
    cloud_sun: int
    light_slots: ptr
    light_count: int
    light_space: int
    shadow_map: int
    has_shadow_map: int
    compat_light_pos: int
    compat_light_color: int
    compat_light_intensity: int
    compat_light_direction: int
    view_pos: int
    view_distance: int
    diffuse_color: int
    specular_color: int
    metallic: int
    roughness: int
    exposure: int
    reflectivity: int
    material_alpha: int
    texture_sampler: int
    is_instanced: int
    instance_points: int
    instance_billboard: int
    use_instance_color: int
    is_skinned: int
    bones: int
    pose_bank: int
    pose_bank_frames: int
    impostor: int
    impostor_cols: int
    impostor_rows: int
    impostor_width: int
    impostor_height: int
    normal_sampler: int
    has_normal_map: int
    normal_strength: int
    occlusion_strength: int
    capture_channel: int
    wetness: int
    frame_exposure: int
    caustics_time: int
    fog_enabled: int
    shadow_direction: int
    shadow_texel_world: int
    enable_shadows: int
    shadow_intensity: int
    shadow_softness: int
    fog_start: int
    fog_end: int
    fog_color: int
    fog_intensity: int
    loaded_names: uint64
    shading_loaded: bool
}

struct TextureEntry {
    path: string
    id: int
    refs: int
    width: int
    height: int
}

// One merged draw: the geometry every member shares, the surface they all have,
// and the matrices that tell the shader where each copy goes.
struct GLBatch {
    vao: int
    material: ptr
    first: ptr
    instances: ptr
    members: ptr
    capacity_bytes: int
    count: int
    stale: bool
}

struct GLRenderer {
    models: ptr
    lights: ptr
    programs: ptr
    textures: ptr
    frustum: ptr
    skybox: ptr
    target: ptr

    default_program: int
    crowd_program: int
    fxaa_program: int
    bloom_program: int
    // Temporal anti-aliasing: the program, two history textures written
    // in turn with a framebuffer each, the frame's count for the jitter
    // sequence, the last frame's view-projection, and whether the history
    // holds a frame yet.
    taa_program: int
    enable_taa: bool
    taa_fbo: int
    taa_texture0: int
    taa_texture1: int
    taa_current: int
    taa_history_valid: bool
    taa_frame: int
    prev_vp: Mat4
    prev_vp_valid: bool
    jitter_x: float
    jitter_y: float
    // Ambient occlusion from the scene's depth: a fullscreen multiply over
    // the opaque pass, on when a scene asks, with how far a thing shadows
    // its neighbours in metres and how dark that goes.
    // The clouds' noise as textures, made with the first sky and kept.
    cloud_shape_texture: int
    cloud_weather_texture: int
    cloud_textures_real: bool      // the noise, not the placeholders
    ssao_program: int
    ssao_enabled: bool
    ssao_radius: float
    ssao_intensity: float
    passthrough_program: int
    current_program: int
    default_texture: int

    face_culling_state: bool
    depth_test_state: bool
    blend_state: bool
    wireframe_state: bool
    initialized: bool

    last_draw_calls: int
    // The passes, timed apart. One number for a frame says it got slower and
    // nothing about where, and the three of them are what a budget is set on.
    last_shadow_ms: float
    last_scene_ms: float
    last_post_ms: float
    pass_timer: ptr
    last_post_active: bool
    last_programs: int
    last_materials: int
    last_textures: int
    frame_stamp: int
    // The scene's depth after the opaque pass, for the transparent pass to
    // read: zero until a frame with a water surface in it captures one.
    scene_depth: int
    shadow_program: int
    crowd_shadow_program: int
    shadow_fbo: int
    shadow_map: int
    shadow_enabled: bool
    shadow_distance: float
    shadow_space: Mat4
    shadow_direction: Vec3
    shadow_texel_world: float
    fog: Fog

    clear_r: float
    clear_g: float
    clear_b: float

    enable_fxaa: bool
    enable_bloom: bool
    enable_msaa: bool
    bloom_threshold: float
    bloom_intensity: float

    batches: ptr
    batch_count: int
    shadow_batches: ptr
    shadow_batch_count: int

    bound_material: ptr
    bound_material_set: bool
    bound_texture: int
    bound_instanced: int
    bound_skinned: int
    bound_normal: int
    // How hard a normal map is allowed to push. One is the map as authored;
    // less flattens it, more exaggerates it. A scene knob rather than a
    // material one, because it is a look and not a surface.
    normal_strength: float
    occlusion_strength: float
    capture_channel: int
    wetness: float
    frame_exposure: float              // the eye adaptation's, 1 when it is off
    bound_instance_color: int

    post_fbo: int
    post_texture: int
    post_ms_fbo: int
    post_ms_color: int
    post_ms_depth: int
    // The motion vectors beside the colour: the texture the temporal pass
    // reads, and its multisampled twin the scene draws into.
    post_velocity: int
    post_ms_velocity: int
    // The last frame's time, for the seconds a crowd's vectors span.
    last_scene_time: float
    frame_seconds: float
    post_samples: int
    post_width: int
    post_height: int
    render_scale: float
    post_resolve_reported: bool

    scene_start: float
    scene_time: float
    // The clouds: how much of the sky they cover (zero is a clear sky and
    // no march), and how fast they drift, as a multiple of scene time.
    cloud_cover: float
    cloud_wind: float
    sky_overcast: float
    sky_overcast_color: Vec3
    defaults: ptr
    post_depth: int
    bloom_fbo: int
    bloom_texture: int
    screen_vao: int
    screen_vbo: int
    screen_mesh: ptr

    screen_width: int
    screen_height: int
    viewport_width: int
    viewport_height: int
}

// The three passes a frame is made of, in the order they run.
const PASS_SHADOW = 0
const PASS_SCENE = 1
const PASS_POST = 2

renderer_new() -> *GLRenderer {
    r = heap.new(GLRenderer)
    r.models = list.new()
    r.lights = list.new()
    r.programs = list.new()
    r.textures = list.new()
    r.frustum = core.frustum_new()
    r.batches = list.new()
    r.batch_count = 0
    r.shadow_batches = list.new()
    r.shadow_batch_count = 0
    // Measured rather than chosen: at 1 a normal map moves the worst pixel
    // by 0.04 and reads as almost nothing; at 4 by 0.16 and reads as
    // plastic. 2.5 is 0.10, which is relief.
    r.normal_strength = 2.5
    r.occlusion_strength = 1.0
    r.capture_channel = 0
    r.wetness = 0.0
    r.frame_exposure = 1.0
    r.bound_normal = 0 - 1
    r.fog = core.fog_none()
    r.clear_r = 0.0
    r.clear_g = 0.0
    r.clear_b = 0.0
    r.enable_msaa = true
    r.render_scale = 1.0
    r.bloom_threshold = 0.8
    r.bloom_intensity = 0.4
    r.ssao_enabled = false
    r.ssao_radius = 3.0
    r.ssao_intensity = 1.0
    r.depth_test_state = true
    r.bound_material = null
    r.bound_material_set = false
    r.bound_texture = 0 - 1
    r.bound_instanced = 0 - 1
    r.bound_normal = 0 - 1
    r.bound_instance_color = 0 - 1
    r.scene_start = platform.time()
    r.scene_time = 0.0
    r.defaults = rendering.defaults_model() as ptr
    return r
}

renderer_free(r: *GLRenderer) {
    if r == null { return }
    renderer_cleanup(r)
    gl_geometry_shutdown()
    if r.models != null { list.free(r.models) }
    if r.lights != null { list.free(r.lights) }
    if r.programs != null {
        count = list.size(r.programs)
        i = 0
        while i < count {
            slots = list.get_raw(r.programs, i) as *ProgramSlots
            if slots != null {
                free(slots.light_slots)
                heap.free(slots)
            }
            i = i + 1
        }
        list.free(r.programs)
    }
    if r.textures != null {
        count = list.size(r.textures)
        i = 0
        while i < count {
            entry = list.get_raw(r.textures, i) as *TextureEntry
            if entry != null { heap.free(entry) }
            i = i + 1
        }
        list.free(r.textures)
    }
    if r.defaults != null { core.model_free(r.defaults as *Model) }
    if r.frustum != null { core.frustum_free(r.frustum) }
    if r.screen_mesh != null { core.mesh_destroy(r.screen_mesh) }
    heap.free(r)
}

backend(r: *GLRenderer) -> Backend {
    return Backend {
        state: r,
        name: "opengl",
        init: renderer_init as fn(ptr, ptr, int, int) -> int,
        render: renderer_render as fn(ptr, ptr, ptr),
        add_model: renderer_add_model as fn(ptr, ptr),
        remove_model: renderer_remove_model as fn(ptr, ptr),
        load_texture: renderer_load_texture as fn(ptr, string) -> int,
        set_skybox: renderer_set_skybox as fn(ptr, ptr),
        update_viewport: renderer_update_viewport as fn(ptr, int, int),
        set_post: renderer_set_post as fn(ptr, int, int, float, float),
        set_render_scale: vtable_set_render_scale as fn(ptr, float) -> float,
        set_clear_color: renderer_set_clear_color as fn(ptr, float, float, float),
        set_fog: renderer_set_fog as fn(ptr, ptr),
        set_shadow_distance: renderer_set_shadow_distance as fn(ptr, float),
        set_shadows: vtable_set_shadows as fn(ptr, int),
        shadows: vtable_shadows as fn(ptr) -> int,
        add_light: renderer_add_light as fn(ptr, ptr),
        remove_light: renderer_remove_light as fn(ptr, ptr),
        draw_calls: renderer_draw_calls as fn(ptr) -> int,
        frame_pixels: renderer_frame_pixels as fn(ptr) -> ptr,
        cleanup: renderer_cleanup as fn(ptr)
    }
}

compile_program(vertex_source: string, fragment_source: string, label: string) -> int {
    program = gl_program_create(vertex_source, fragment_source)
    if program == 0 {
        println("ae3d: ${label} program failed: ${gl_program_log()}")
    }
    return program
}

slots_for(r: *GLRenderer, program: int) -> *ProgramSlots {
    count = list.size(r.programs)
    i = 0
    while i < count {
        existing = list.get_raw(r.programs, i) as *ProgramSlots
        if existing != null && existing.program == program { return existing }
        i = i + 1
    }

    s = heap.new(ProgramSlots)
    s.program = program
    // Never a frame number. Left uninitialised, this matched the current frame
    // often enough to skip the frame's uniforms entirely, and a program whose
    // view-projection was still zero rasterised nothing at all.
    s.frame_stamp = 0 - 1
    s.view_projection = gl_uniform_location(program, "viewProjection")
    s.model = gl_uniform_location(program, "model")
    s.prev_model = gl_uniform_location(program, "prevModel")
    s.prev_view_projection = gl_uniform_location(program, "prevViewProjection")
    s.jitter = gl_uniform_location(program, "jitter")
    s.crowd_travel = gl_uniform_location(program, "crowdTravel")
    s.crowd_phase_step = gl_uniform_location(program, "crowdPhaseStep")
    // One lookup per light per program, done once, because an array of structs
    // gives no guarantee that element locations are contiguous.
    s.light_slots = calloc(MAX_LIGHTS * LIGHT_SLOTS, 4)
    slots_of = s.light_slots as int[]
    n = 0
    while n < MAX_LIGHTS {
        base = n * LIGHT_SLOTS
        slots_of[base] = gl_uniform_location(program, "lights[${n}].position")
        slots_of[base + 1] = gl_uniform_location(program, "lights[${n}].color")
        slots_of[base + 2] = gl_uniform_location(program, "lights[${n}].intensity")
        slots_of[base + 3] = gl_uniform_location(program, "lights[${n}].ambientStrength")
        slots_of[base + 4] = gl_uniform_location(program, "lights[${n}].temperature")
        slots_of[base + 5] = gl_uniform_location(program, "lights[${n}].isDirectional")
        slots_of[base + 6] = gl_uniform_location(program, "lights[${n}].direction")
        slots_of[base + 7] = gl_uniform_location(program, "lights[${n}].constantAtten")
        slots_of[base + 8] = gl_uniform_location(program, "lights[${n}].linearAtten")
        slots_of[base + 9] = gl_uniform_location(program, "lights[${n}].quadraticAtten")
        slots_of[base + 10] = gl_uniform_location(program, "lights[${n}].spotCosOuter")
        slots_of[base + 11] = gl_uniform_location(program, "lights[${n}].spotCosInner")
        n = n + 1
    }
    s.light_count = gl_uniform_location(program, "lightCount")
    s.light_space = gl_uniform_location(program, "lightSpaceMatrix")
    s.shadow_map = gl_uniform_location(program, "shadowMap")
    s.has_shadow_map = gl_uniform_location(program, "hasShadowMap")
    s.compat_light_pos = gl_uniform_location(program, "lightPos")
    s.compat_light_color = gl_uniform_location(program, "lightColor")
    s.compat_light_intensity = gl_uniform_location(program, "lightIntensity")
    s.compat_light_direction = gl_uniform_location(program, "lightDirection")
    s.view_pos = gl_uniform_location(program, "viewPos")
    s.view_distance = gl_uniform_location(program, "viewDistance")
    s.diffuse_color = gl_uniform_location(program, "diffuseColor")
    s.specular_color = gl_uniform_location(program, "specularColor")
    s.metallic = gl_uniform_location(program, "metallic")
    s.roughness = gl_uniform_location(program, "roughness")
    s.exposure = gl_uniform_location(program, "exposure")
    s.reflectivity = gl_uniform_location(program, "reflectivity")
    s.material_alpha = gl_uniform_location(program, "materialAlpha")
    s.texture_sampler = gl_uniform_location(program, "textureSampler")
    s.is_instanced = gl_uniform_location(program, "isInstanced")
    s.instance_points = gl_uniform_location(program, "instancePoints")
    s.instance_billboard = gl_uniform_location(program, "instanceBillboard")
    s.use_instance_color = gl_uniform_location(program, "useInstanceColor")
    s.is_skinned = gl_uniform_location(program, "isSkinned")
    s.bones = gl_uniform_location(program, "bones")
    s.pose_bank = gl_uniform_location(program, "poseBank")
    s.pose_bank_frames = gl_uniform_location(program, "poseBankFrames")
    s.impostor = gl_uniform_location(program, "impostor")
    s.impostor_cols = gl_uniform_location(program, "impostorCols")
    s.impostor_rows = gl_uniform_location(program, "impostorRows")
    s.impostor_width = gl_uniform_location(program, "impostorWidth")
    s.impostor_height = gl_uniform_location(program, "impostorHeight")
    s.scene_depth = gl_uniform_location(program, "sceneDepth")
    s.cloud_cover = gl_uniform_location(program, "cloudCover")
    s.cloud_time = gl_uniform_location(program, "cloudTime")
    s.sky_overcast = gl_uniform_location(program, "skyOvercast")
    s.sky_overcast_color = gl_uniform_location(program, "skyOvercastColor")
    s.cloud_sun = gl_uniform_location(program, "cloudSun")
    s.has_scene_depth = gl_uniform_location(program, "hasSceneDepth")
    s.screen_size = gl_uniform_location(program, "screenSize")
    s.inv_view_projection = gl_uniform_location(program, "invViewProjection")
    s.normal_sampler = gl_uniform_location(program, "normalMap")
    s.has_normal_map = gl_uniform_location(program, "hasNormalMap")
    s.normal_strength = gl_uniform_location(program, "normalStrength")
    s.occlusion_strength = gl_uniform_location(program, "occlusionStrength")
    s.capture_channel = gl_uniform_location(program, "captureChannel")
    s.wetness = gl_uniform_location(program, "wetness")
    s.frame_exposure = gl_uniform_location(program, "frameExposure")
    s.caustics_time = gl_uniform_location(program, "causticsTime")
    s.shadow_direction = gl_uniform_location(program, "shadowDirection")
    s.shadow_texel_world = gl_uniform_location(program, "shadowTexelWorld")
    s.enable_shadows = gl_uniform_location(program, "enableShadows")
    s.shadow_intensity = gl_uniform_location(program, "shadowIntensity")
    s.shadow_softness = gl_uniform_location(program, "shadowSoftness")
    s.fog_enabled = gl_uniform_location(program, "enableFog")
    s.fog_start = gl_uniform_location(program, "fogStart")
    s.fog_end = gl_uniform_location(program, "fogEnd")
    s.fog_color = gl_uniform_location(program, "fogColor")
    s.fog_intensity = gl_uniform_location(program, "fogIntensity")
    s.loaded_names = 0 as uint64
    // Nothing has been written into this program yet, so what it holds is
    // whatever GLSL leaves a uniform at, which is not what a default is.
    s.shading_loaded = false
    list.add_raw(r.programs, s)
    return s
}

set_face_culling(r: *GLRenderer, on: bool) {
    if r.face_culling_state == on { return }
    flag = 0
    if on { flag = 1 }
    gl_set_face_culling(flag)
    r.face_culling_state = on
}

set_depth_test(r: *GLRenderer, on: bool) {
    if r.depth_test_state == on { return }
    flag = 0
    if on { flag = 1 }
    gl_set_depth_test(flag)
    r.depth_test_state = on
}

set_blend(r: *GLRenderer, on: bool) {
    if r.blend_state == on { return }
    flag = 0
    if on { flag = 1 }
    gl_set_blend(flag)
    r.blend_state = on
}

set_wireframe(r: *GLRenderer, on: bool) {
    if r.wireframe_state == on { return }
    flag = 0
    if on { flag = 1 }
    gl_set_wireframe(flag)
    r.wireframe_state = on
}

// Uniforms and the bound texture belong to a program, so what the renderer
// remembers about them is only true while that program stays current.
use_program(r: *GLRenderer, program: int) {
    if r.current_program == program { return }
    // Counted where the change happens, not where it is asked for: a budget on
    // how often the renderer is called is a budget on nothing.
    r.last_programs = r.last_programs + 1
    gl_program_use(program)
    r.current_program = program
    r.bound_material = null
    r.bound_material_set = false
    r.bound_texture = 0 - 1
    r.bound_instanced = 0 - 1
    r.bound_normal = 0 - 1
    r.bound_instance_color = 0 - 1
}

// A material is a pointer, and the same pointer means the same seven uniforms,
// so a run of models sharing one costs a comparison instead of seven uploads.
// A model with no material is a real case, and null is what it looks like, so
// the cache cannot use null to mean nothing has been bound yet. It did, and a
// scene whose first model had no material never had its material uniforms sent
// at all: the surface kept an alpha of zero and never appeared.
// What a group is made of. A group carries its own material only when the file
// it came from gave it one: an OBJ whose mtllib line is commented out, or which
// names a material no mtl defines, produces groups with none. Those fall back
// to the model's own material, which is the only thing a caller can set from
// outside, so model_set_diffuse and its friends reach a loaded model instead of
// being silently dropped for having groups at all.
group_material(m: *Model, group: *MaterialGroup) -> *Material {
    if group == null { return m.material }
    if group.material != null { return group.material }
    return m.material
}

apply_material(r: *GLRenderer, slots: *ProgramSlots, material: *Material) {
    if r.bound_material_set && r.bound_material == material as ptr { return }
    r.last_materials = r.last_materials + 1
    set_material_uniforms(slots, material)
    r.bound_material = material as ptr
    r.bound_material_set = true
}

apply_texture(r: *GLRenderer, slots: *ProgramSlots, texture: int) {
    if r.bound_texture == texture { return }
    r.last_textures = r.last_textures + 1
    gl_texture_bind(0, texture)
    gl_uniform_int(slots.texture_sampler, 0)
    r.bound_texture = texture
}

// Unit 2, because 0 is the colour and 1 is the shadow map.
apply_normal_map(r: *GLRenderer, slots: *ProgramSlots, normal: int) {
    if r.bound_normal == normal { return }
    if normal != 0 {
        gl_texture_bind(2, normal)
        gl_uniform_int(slots.normal_sampler, 2)
    }
    gl_uniform_int(slots.has_normal_map, normal != 0)
    r.bound_normal = normal
}

apply_instancing(r: *GLRenderer, slots: *ProgramSlots, instanced: int) {
    if r.bound_instanced == instanced { return }
    gl_uniform_int(slots.is_instanced, instanced)
    r.bound_instanced = instanced
}

// Whether the instances are points: a position and a scale each, the
// model's own rotation and scale in the model matrix. Sent every draw,
// since it is not part of the instanced cache and a batch is never points.
apply_points(slots: *ProgramSlots, m: *Model) {
    points = 0
    if m.instances != null && geometry.inst_is_points(m.instances) == 1 { points = 1 }
    gl_uniform_int(slots.instance_points, points)
    billboard = 0
    if points == 1 { billboard = m.billboard }
    gl_uniform_int(slots.instance_billboard, billboard)
}

// A model's own instances carry a colour each; a merged draw does not, and its
// members already share one material, so the shader is told to leave the tint
// alone rather than read an attribute nothing filled in.
apply_instance_color(r: *GLRenderer, slots: *ProgramSlots, on: int) {
    if r.bound_instance_color == on { return }
    gl_uniform_int(slots.use_instance_color, on)
    r.bound_instance_color = on
}

// The pose, for a model that has one. A skeleton is asked to bring its palette
// up to date first: it rebuilds only the bones whose world transform changed,
// so a figure standing still uploads the array and computes nothing.
apply_skeleton(r: *GLRenderer, slots: *ProgramSlots, m: *Model) {
    if m.skeleton == null {
        if r.bound_skinned != 0 {
            gl_uniform_int(slots.is_skinned, 0)
            r.bound_skinned = 0
        }
        return
    }
    sk = m.skeleton as *Skeleton
    skin.skeleton_update(sk)
    gl_uniform_int(slots.is_skinned, 1)
    gl_uniform_mat4v(slots.bones, skin.skeleton_count(sk),
                          core.palette_data(skin.skeleton_palette(sk)))
    // Every skinned model carries its own palette, so this cannot be skipped
    // for a second one in the same frame the way a shared uniform could.
    r.bound_skinned = 1
}

// A crowd is posed from its pose bank -- a float texture of baked frames -- on
// texture unit 3, uploaded the first time this model is drawn. VERTEX_CROWD
// reads it by (bone, frame); poseBankFrames lets it turn an instance's phase
// into a frame.
bind_pose_bank(r: *GLRenderer, slots: *ProgramSlots, m: *Model) {
    if m.pose_bank_texture == 0 {
        m.pose_bank_texture = gl_posebank_texture(posing.posebank_data(m.pose_bank), posing.posebank_frames(m.pose_bank), posing.posebank_bones(m.pose_bank))
    }
    gl_texture_bind(3, m.pose_bank_texture)
    gl_uniform_int(slots.pose_bank, 3)
    gl_uniform_int(slots.pose_bank_frames, m.pose_bank_frames)
    // For the motion vectors: how far a figure's walk and its position
    // moved this frame, from the model's walk cycle and the bank's travel.
    travel = 0.0
    step = 0.0
    if m.crowd_walk > 0.0 {
        step = r.frame_seconds / m.crowd_walk
        travel = posing.posebank_travel(m.pose_bank, m.pose_bank_frames) * step
    }
    gl_uniform_float(slots.crowd_travel, travel)
    gl_uniform_float(slots.crowd_phase_step, step)
    // The impostor's atlas grid and size, off for a crowd drawn as itself.
    on = 0
    if core.model_is_impostor(m) { on = 1 }
    gl_uniform_int(slots.impostor, on)
    if on == 1 {
        gl_uniform_int(slots.impostor_cols, m.impostor_cols)
        gl_uniform_int(slots.impostor_rows, m.impostor_rows)
        gl_uniform_float(slots.impostor_width, m.impostor_width)
        gl_uniform_float(slots.impostor_height, m.impostor_height)
    }
}

renderer_init(r: *GLRenderer, window: ptr, width: int, height: int) -> int {
    missing = gl_load()
    if missing != 0 {
        println("ae3d: ${missing} OpenGL entry point(s) unavailable")
        return 0
    }

    println("ae3d: OpenGL ${gl_version()} on ${gl_renderer()}")

    r.screen_width = width
    r.screen_height = height
    r.viewport_width = width
    r.viewport_height = height
    gl_viewport(0, 0, width, height)
    gl_clear_depth(1.0)

    r.default_program = compile_program(shaders.VERTEX_DEFAULT, shaders.FRAGMENT_DEFAULT, "default")
    if r.default_program == 0 { return 0 }
    slots_for(r, r.default_program)

    // The crowd's instanced-skinned program: same lighting as the default, but a
    // vertex stage that poses each instance from the pose bank at its own phase.
    r.crowd_program = compile_program(shaders.VERTEX_CROWD, shaders.FRAGMENT_DEFAULT, "crowd")
    if r.crowd_program == 0 { return 0 }
    slots_for(r, r.crowd_program)

    r.shadow_program = compile_program(shaders.VERTEX_DEPTH, shaders.FRAGMENT_DEPTH, "depth")
    // The crowd's depth pass poses from the pose bank by phase, so it casts a
    // walking shadow, not a bind-pose one. Same fragment (depth only).
    r.crowd_shadow_program = compile_program(shaders.VERTEX_CROWD_DEPTH, shaders.FRAGMENT_DEPTH, "crowd_depth")
    r.fxaa_program = compile_program(shaders.VERTEX_SCREEN, shaders.FRAGMENT_FXAA, "fxaa")
    r.bloom_program = compile_program(shaders.VERTEX_SCREEN, shaders.FRAGMENT_BLOOM, "bloom")
    r.taa_program = compile_program(shaders.VERTEX_SCREEN, shaders.FRAGMENT_TAA, "taa")
    r.ssao_program = compile_program(shaders.VERTEX_SCREEN, shaders.FRAGMENT_SSAO, "ssao")
    r.passthrough_program = compile_program(shaders.VERTEX_SCREEN, shaders.FRAGMENT_PASSTHROUGH, "passthrough")

    r.default_texture = create_default_texture(r)

    // A merged draw leaves the per-instance colour array disabled, so the
    // generic value stands in for it. Without this the shader multiplies every
    // batched surface by black.
    gl_set_default_instance_color()

    gl_set_face_culling(0)
    r.face_culling_state = false
    gl_set_depth_test(1)
    r.depth_test_state = true
    gl_set_blend(1)
    r.blend_state = true
    gl_set_multisample(1)
    r.enable_msaa = true
    gl_set_wireframe(0)
    r.wireframe_state = false

    init_post_processing(r, width, height)

    r.initialized = true
    if r.shadow_enabled { renderer_set_shadows(r, true) }
    return 1
}

create_default_texture(r: *GLRenderer) -> int {
    image = ae3d_image_solid(2, 2, 255, 255, 255, 255)
    if image == null {
        println("ae3d: default texture unavailable: ${ae3d_image_error()}")
        return 0
    }
    id = gl_texture_from_image(image, 0, 0)
    ae3d_image_free(image)
    return id
}

renderer_load_texture(r: *GLRenderer, path: string) -> int {
    if path == "" { return 0 }

    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *TextureEntry
        if entry != null && string.equals(entry.path, path) == 1 {
            entry.refs = entry.refs + 1
            return entry.id
        }
        i = i + 1
    }

    image = core.take_preloaded_image(path)
    if image == null { image = ae3d_image_load(path) }
    if image == null {
        println("ae3d: texture load failed: ${ae3d_image_error()}")
        return 0
    }
    // Larger than the device takes (a 21,600-wide map on a device whose
    // textures stop at 16,384): drawn at the most it has, not refused.
    halvings = ae3d_image_fit(image, gl_max_texture_size())
    if halvings > 0 { println("ae3d: ${path} is larger than this device's textures; halved ${halvings} time(s) to fit") }
    id = gl_texture_from_image(image, 0, 1)
    // Read before the image is released. How many pixels an image has is half
    // of what decides whether a surface carries enough detail to be looked at
    // closely; the other half is how far its UVs stretch, and neither is
    // recoverable from a texture handle afterwards.
    width = ae3d_image_width(image)
    height = ae3d_image_height(image)
    ae3d_image_free(image)
    if id == 0 { return 0 }

    entry = heap.new(TextureEntry)
    texture_entry_set_path(entry, path)
    entry.id = id
    entry.refs = 1
    entry.width = width
    entry.height = height
    list.add_raw(r.textures, entry)
    return id
}

texture_entry_set_path(entry: *TextureEntry, path: string) {
    entry.path = core.set_owned(entry.path, path)
}

renderer_release_texture(r: *GLRenderer, id: int) {
    if id == 0 { return }
    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *TextureEntry
        if entry != null && entry.id == id {
            entry.refs = entry.refs - 1
            if entry.refs <= 0 {
                gl_texture_delete(entry.id)
                list.remove(r.textures, i)
            heap.free(entry)
            }
            return
        }
        i = i + 1
    }
}

// How hard normal maps push, for the whole scene.
renderer_set_normal_strength(r: *GLRenderer, strength: float) {
    if r != null { r.normal_strength = strength }
}

// What the frame is drawn as: 0 the lit picture, 1 every surface's albedo,
// 2 its normals -- what a bake reads back, and a view for finding out why
// a surface lights the way it does.
renderer_set_capture_channel(r: *GLRenderer, channel: int) {
    if r != null { r.capture_channel = channel }
}

// How wet the scene is, 0..1: rain on every surface that faces up.
renderer_set_wetness(r: *GLRenderer, amount: float) {
    if r != null { r.wetness = amount }
}

// The frame's exposure over every material's (eye adaptation; 1 is off).
renderer_set_frame_exposure(r: *GLRenderer, exposure: float) {
    if r != null { r.frame_exposure = exposure }
}

// The finished frame's mean and brightest linear luminance into out[0] and
// out[1], two frames late: false until the first measure is back. Called
// after the frame is drawn, with its framebuffer still bound.
renderer_meter(r: *GLRenderer, out: ptr) -> bool {
    if r == null { return false }
    return gl_meter(0 - 1, r.viewport_width, r.viewport_height, out) == 1
}

renderer_set_occlusion_strength(r: *GLRenderer, strength: float) {
    if r != null { r.occlusion_strength = strength }
}

renderer_texture_count(r: *GLRenderer) -> int {
    return list.size(r.textures)
}

// How big the image behind a material is. Texel density is the texture size
// and the UVs together, so neither alone answers whether a surface carries
// enough detail to be looked at closely.
renderer_material_texture_size(r: *GLRenderer, material: *Material) -> Vec3 {
    if r == null { return core.vec3(0.0, 0.0, 0.0) }
    id = texture_for(r, material)
    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *TextureEntry
        if entry != null && entry.id == id {
            return core.vec3(entry.width * 1.0, entry.height * 1.0, 0.0)
        }
        i = i + 1
    }
    return core.vec3(0.0, 0.0, 0.0)
}

renderer_add_model(r: *GLRenderer, m: *Model) {
    if m == null { return }

    // A model that carries its own instances needs a vertex array of its own,
    // since the instance attributes are part of that state. Everything else
    // goes through the shared cache, so identical geometry is uploaded once and
    // can be merged into one draw later.
    // The geometry cache keys on the vertex array, and joints and weights are
    // not in it: two meshes alike in their vertices and different in their
    // skins would share a vertex array and one of them would be posed by the
    // other's. A skinned mesh takes its own, which costs nothing worth having
    // -- a cache exists for repeated props, and a figure is not one.
    skinned = core.mesh_is_skinned(m.mesh)
    if (m.is_instanced && core.model_instance_count(m) > 0) || skinned {
        m.vao = gl_vao_create()
        gl_vao_bind(m.vao)
        m.vbo = gl_buffer_create()
        m.ebo = gl_buffer_create()
        gl_upload_mesh(m.mesh, m.vbo, m.ebo)
        gl_setup_vertex_attribs()
        m.shares_geometry = false
    } else {
        m.vao = gl_geometry_acquire(m.mesh)
        if m.vao == 0 {
            m.vao = gl_vao_create()
            gl_vao_bind(m.vao)
            m.vbo = gl_buffer_create()
            m.ebo = gl_buffer_create()
            gl_upload_mesh(m.mesh, m.vbo, m.ebo)
            gl_setup_vertex_attribs()
            m.shares_geometry = false
        } else {
            m.vbo = 0
            m.ebo = 0
            m.shares_geometry = true
        }
        gl_vao_bind(m.vao)
    }

    if skinned {
        m.skin_vbo = gl_buffer_create()
        gl_upload_skin(m.mesh, m.skin_vbo)
    }

    if m.is_instanced && core.model_instance_count(m) > 0 {
        m.instance_vbo = gl_buffer_create()
        if core.model_instance_has_colors(m) {
            m.instance_color_vbo = gl_buffer_create()
        }
        gl_setup_instance_attribs(m.instances, m.instance_vbo, m.instance_color_vbo)
        m.instance_vbo_capacity = core.model_instance_count(m) * 64
        m.instances_updated = false
        m.instance_colors_updated = false
        // A crowd (a model carrying a pose bank) also gets the per-instance
        // phase attribute at location 11, so the crowd program can pose each
        // instance from its own frame of the bank.
        if core.model_pose_bank(m) != null {
            m.instance_phase_vbo = gl_buffer_create()
            gl_setup_instance_phase(m.instances, m.instance_phase_vbo)
            m.instance_phases_updated = false
        }
    }

    gl_vao_bind(0)

    // Building a mesh marks it dirty, and what was just uploaded is not an edit
    // waiting to be sent: leaving it set gives every model a private buffer on
    // its first frame and there is nothing left to merge.
    geometry.mesh_clear_dirty(m.mesh)

    core.model_update_matrix(m)
    load_model_textures(r, m)
    core.model_sort_groups_by_texture(m)
    list.add_raw(r.models, m)
}

load_model_textures(r: *GLRenderer, m: *Model) {
    groups = core.model_group_count(m)
    if groups > 0 {
        i = 0
        while i < groups {
            group = core.model_group(m, i)
            if group != null && group.material != null {
                resolve_material_texture(r, group.material)
                resolve_material_normal(r, group.material)
            }
            i = i + 1
        }
        return
    }
    // The normal is resolved here beside the colour rather than left to the
    // first frame that draws the model. A rooftop tank is behind the camera
    // for the whole clip, so a normal loaded lazily at draw time would never
    // load at all -- and a map that is named and never loaded is exactly what
    // the critique looks for.
    if m.material != null {
        resolve_material_texture(r, m.material)
        resolve_material_normal(r, m.material)
    }
}

resolve_material_texture(r: *GLRenderer, material: *Material) {
    material.texture_stale = false
    if core.text(material.texture_path) == "" || material.texture_id != 0 { return }
    id = renderer_load_texture(r, material.texture_path)
    if id == 0 { id = r.default_texture }
    material.texture_id = id
}

// A normal map is loaded through the same cache the colour is, and its absence
// is not a fallback to anything: a surface without one is shaded by the normal
// its geometry has, which is the right answer rather than a flat blue image.
resolve_material_normal(r: *GLRenderer, material: *Material) {
    material.normal_stale = false
    if core.text(material.normal_path) == "" || material.normal_id != 0 { return }
    material.normal_id = renderer_load_texture(r, material.normal_path)
}

normal_for(r: *GLRenderer, material: *Material) -> int {
    if material == null { return 0 }
    if material.normal_stale { resolve_material_normal(r, material) }
    return material.normal_id
}

// The path was changed after this material had already been given a texture, so
// what it is holding is the one it used to want.
refresh_material_texture(r: *GLRenderer, material: *Material) {
    if material.texture_id != 0 && material.texture_id != r.default_texture {
        renderer_release_texture(r, material.texture_id)
    }
    material.texture_id = 0
    resolve_material_texture(r, material)
}

renderer_remove_model(r: *GLRenderer, m: *Model) {
    if m == null { return }

    groups = core.model_group_count(m)
    i = 0
    while i < groups {
        group = core.model_group(m, i)
        if group != null && group.material != null && group.material.texture_id != 0 {
            renderer_release_texture(r, group.material.texture_id)
        }
        i = i + 1
    }
    if m.material != null && m.material.texture_id != 0 {
        renderer_release_texture(r, m.material.texture_id)
    }

    if m.shares_geometry {
        forget_batches(r, m.vao)
        gl_geometry_release(m.vao)
        m.vao = 0
        m.vbo = 0
        m.ebo = 0
        m.shares_geometry = false
    } else {
        forget_batches(r, m.vao)
        if m.vao != 0 { gl_vao_delete(m.vao) ; m.vao = 0 }
        if m.vbo != 0 { gl_buffer_delete(m.vbo) ; m.vbo = 0 }
        if m.ebo != 0 { gl_buffer_delete(m.ebo) ; m.ebo = 0 }
    }
    if m.instance_vbo != 0 {
        gl_buffer_delete(m.instance_vbo)
        m.instance_vbo = 0
        m.instance_vbo_capacity = 0
    }
    if m.instance_color_vbo != 0 {
        gl_buffer_delete(m.instance_color_vbo)
        m.instance_color_vbo = 0
    }
    if m.depth_proxy_vao != 0 { gl_vao_delete(m.depth_proxy_vao) ; m.depth_proxy_vao = 0 }

    count = list.size(r.models)
    i = 0
    while i < count {
        if list.get_raw(r.models, i) == m {
            list.remove(r.models, i)
            return
        }
        i = i + 1
    }
}

renderer_add_light(r: *GLRenderer, light: *Light) {
    list.add_raw(r.lights, light)
}

renderer_light_count(r: *GLRenderer) -> int {
    return list.size(r.lights)
}

renderer_light(r: *GLRenderer, index: int) -> *Light {
    if index < 0 || index >= list.size(r.lights) { return null }
    return list.get_raw(r.lights, index) as *Light
}

renderer_remove_light(r: *GLRenderer, light: *Light) {
    count = list.size(r.lights)
    i = 0
    while i < count {
        if list.get_raw(r.lights, i) == light {
            list.remove(r.lights, i)
            return
        }
        i = i + 1
    }
}

renderer_model_count(r: *GLRenderer) -> int {
    return list.size(r.models)
}

renderer_model(r: *GLRenderer, index: int) -> *Model {
    return list.get_raw(r.models, index) as *Model
}

renderer_draw_calls(r: *GLRenderer) -> int {
    return r.last_draw_calls
}

// What the last frame cost, split by pass, and how much of it was the renderer
// changing its mind about what it was drawing with.
// What drew the frame. A frame cost recorded on one card says nothing about
// the same frame on another, so a benchmark that compares times has to know
// whether it is comparing like with like.
device_name() -> string { return gl_renderer() }

renderer_post_active(r: *GLRenderer) -> bool { return r.last_post_active }
renderer_shadow_ms(r: *GLRenderer) -> float { return r.last_shadow_ms }
renderer_scene_ms(r: *GLRenderer) -> float { return r.last_scene_ms }
renderer_post_ms(r: *GLRenderer) -> float { return r.last_post_ms }
renderer_program_binds(r: *GLRenderer) -> int { return r.last_programs }
renderer_material_binds(r: *GLRenderer) -> int { return r.last_materials }
renderer_texture_binds(r: *GLRenderer) -> int { return r.last_textures }

renderer_instance_count(r: *GLRenderer) -> int {
    total = 0
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.is_instanced { total = total + core.model_instance_count(m) }
        i = i + 1
    }
    return total
}

renderer_set_clear_color(r: *GLRenderer, red: float, green: float, blue: float) {
    r.clear_r = red
    r.clear_g = green
    r.clear_b = blue
}

// The clouds: how much of the sky they cover, and how fast they drift.
renderer_set_clouds(r: *GLRenderer, cover: float, wind: float) {
    r.cloud_cover = cover
    r.cloud_wind = wind
}

renderer_set_sky_overcast(r: *GLRenderer, amount: float, color: Vec3) {
    r.sky_overcast = amount
    r.sky_overcast_color = color
}

flag_int(on: bool) -> int {
    if on { return 1 }
    return 0
}

// The clouds' textures, uploaded from the bytes core bakes once.
// The clouds' textures. The noise behind them is 161 ms of CPU for the
// shape and 5 for the weather (core.cloud_shape_bytes, measured), and
// every sky made them whether the scene had clouds or not -- the whole
// of the 168 ms a scene's sky cost to open in the editor, and the same in
// every program with a sky and no clouds. With no cover the sky shader
// never samples them (cloudsAlong returns before the march), but the
// draw still binds a texture of each kind, so a sky without clouds gets
// two placeholders of the right types -- a 2x2x2 volume and a 1x1 image
// -- and the noise is made the first time the cover is above zero.
ensure_cloud_textures(r: *GLRenderer, real: bool) {
    if r.cloud_textures_real { return }
    if !real {
        if r.cloud_shape_texture == 0 || r.cloud_weather_texture == 0 {
            blank = calloc(2 * 2 * 2 * 4, 1)
            if r.cloud_shape_texture == 0 { r.cloud_shape_texture = gl_texture3d_rgba(2, blank) }
            if r.cloud_weather_texture == 0 { r.cloud_weather_texture = gl_texture_rgba(1, 1, blank) }
            free(blank)
        }
        return
    }
    shape = core.cloud_shape_bytes()
    weather = core.cloud_weather_bytes()
    if shape == null || weather == null { return }
    if r.cloud_shape_texture != 0 { gl_texture_delete(r.cloud_shape_texture) }
    if r.cloud_weather_texture != 0 { gl_texture_delete(r.cloud_weather_texture) }
    r.cloud_shape_texture = gl_texture3d_rgba(core.CLOUD_SHAPE_SIZE, shape)
    r.cloud_weather_texture = gl_texture_rgba(core.CLOUD_WEATHER_SIZE, core.CLOUD_WEATHER_SIZE, weather)
    r.cloud_textures_real = true
}

// Ambient occlusion on or off: `radius` is how far, in metres, a thing
// shadows what stands beside it, `intensity` how dark that shadow goes
// (1.0 is the full occlusion the depth finds, 0 none).
renderer_set_ssao(r: *GLRenderer, on: bool, radius: float, intensity: float) {
    r.ssao_enabled = on
    r.ssao_radius = radius
    r.ssao_intensity = intensity
}

renderer_ssao(r: *GLRenderer) -> bool { return r.ssao_enabled }

renderer_set_fog(r: *GLRenderer, f: *Fog) {
    if f == null { r.fog = core.fog_none() ; return }
    r.fog.color = f.color
    r.fog.start = f.start
    r.fog.end = f.end
    r.fog.intensity = f.intensity
    r.fog.enabled = f.enabled
}

renderer_fog(r: *GLRenderer) -> Fog { return r.fog }

renderer_set_post(r: *GLRenderer, fxaa: int, bloom: int, threshold: float, intensity: float) {
    r.enable_fxaa = fxaa == 1
    r.enable_bloom = bloom == 1
    r.bloom_threshold = threshold
    r.bloom_intensity = intensity
}

// Depth is written to a colour target rather than a depth texture: sampling a
// depth attachment through texture() returns opaque white on this driver
// whatever its filter and compare state, so it cannot be read in the main pass.
//
// Asking for shadows is a setting; building the map is GPU work. Keeping them
// apart lets a program configure the renderer before the context exists, which
// is the order the engine hands its settings down in: renderer_init builds the
// map for whatever was asked for by then.
renderer_set_shadows(r: *GLRenderer, on: bool) {
    r.shadow_enabled = on
    if !on || !r.initialized || r.shadow_fbo != 0 { return }

    r.shadow_fbo = gl_fbo_create()
    r.shadow_map = gl_fbo_attach_shadow_map(r.shadow_fbo, SHADOW_SIZE)
    bind_output(r)
    if r.shadow_map == 0 { r.shadow_enabled = false }
}

renderer_shadows(r: *GLRenderer) -> bool { return r.shadow_enabled }

// The map itself, so a caller can tell "shadows are off" from "shadows are on
// and the map was never built".
renderer_shadow_map(r: *GLRenderer) -> int { return r.shadow_map }

// How far from the camera shadows are drawn. Zero fits the map to the whole
// scene, which is right for a scene that is all of one size and wrong for a
// street: past this, a shadow is not drawn at all rather than drawn badly.
renderer_set_shadow_distance(r: *GLRenderer, metres: float) {
    r.shadow_distance = metres
}

renderer_shadow_distance(r: *GLRenderer) -> float { return r.shadow_distance }

// The light's box has to cover what the camera can see, so it is centred on the
// scene and sized to it rather than to the light.
light_space_matrix(r: *GLRenderer, light: *Light, cam: *Camera) -> Mat4 {
    centre = core.vec3(0.0, 0.0, 0.0)
    radius = 1.0
    shown = 0

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible {
            centre = core.v3_add(centre, m.bounding_center)
            shown = shown + 1
        }
        i = i + 1
    }
    if shown > 0 { centre = core.v3_mul(centre, 1.0 / (shown * 1.0)) }

    // A map fitted to the whole world is a map with nothing left for the things
    // in it: a ground plane ninety metres across pushes the box out until the
    // depth range swallows a figure two metres tall, and the shadow disappears
    // with no error anywhere. A shadow distance fits the box to what the camera
    // can see instead, so how sharp a shadow is stops depending on how big the
    // world is.
    if r.shadow_distance > 0.0 && cam != null {
        centre = core.v3_add(cam.position,
                             core.v3_mul(cam.front, r.shadow_distance * 0.5))
        // Snap the box centre to the shadow map's world-texel grid, so the map
        // covers the same texels frame to frame and only ever shifts by whole
        // texels. Without it the box slides continuously with the camera and the
        // shadow edges crawl and shimmer as you move -- the classic swim. The
        // moon is near enough to straight down that snapping on the world axes
        // stands in for snapping on the light's own.
        texel = r.shadow_distance * 2.0 / (SHADOW_SIZE * 1.0)
        centre = core.vec3(snap_to(centre.x, texel), snap_to(centre.y, texel),
                           snap_to(centre.z, texel))
        return light_box(r, light, centre, r.shadow_distance)
    }

    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible {
            span = core.v3_len(core.v3_sub(m.bounding_center, centre)) + m.bounding_radius
            if span > radius { radius = span }
        }
        i = i + 1
    }

    return light_box(r, light, centre, radius)
}

// Round a coordinate to the nearest multiple of `t`, for either sign.
snap_to(v: float, t: float) -> float {
    if t <= 0.0 { return v }
    n = v / t
    k = 0
    if n >= 0.0 { k = (n + 0.5) as int } else { k = (n - 0.5) as int }
    return (k as float) * t
}

// A light's direction points at the light, the way the shading does it, so the
// way the light travels is the other way about. A point light travels from
// where it is towards what it lights.
light_box(r: *GLRenderer, light: *Light, centre: Vec3, radius: float) -> Mat4 {
    direction = core.v3_mul(core.v3_normalize(light.direction), 0.0 - 1.0)
    if light.mode != core.MODE_DIRECTIONAL {
        direction = core.v3_normalize(core.v3_sub(centre, light.position))
    }
    if core.v3_len(direction) < 0.001 { direction = core.vec3(0.0, 0.0 - 1.0, 0.0) }
    r.shadow_direction = direction
    r.shadow_texel_world = radius * 2.0 / (SHADOW_SIZE * 1.0)

    eye = core.v3_sub(centre, core.v3_mul(direction, radius * 2.0))
    up = core.vec3(0.0, 1.0, 0.0)
    if core.abs_of(direction.y) > 0.99 { up = core.vec3(0.0, 0.0, 1.0) }

    view = core.mat4_look_at(eye, centre, up)
    projection = core.mat4_ortho(0.0 - radius, radius, 0.0 - radius, radius,
                                 0.01, radius * 4.0)
    return core.mat4_mul(projection, view)
}

render_shadow_pass(r: *GLRenderer, light: *Light, cam: *Camera) {
    if !r.shadow_enabled || r.shadow_fbo == 0 || r.shadow_program == 0 || light == null {
        return
    }

    r.shadow_space = light_space_matrix(r, light, cam)

    gl_fbo_bind(r.shadow_fbo)
    gl_viewport(0, 0, SHADOW_SIZE, SHADOW_SIZE)

    // The post pass and the skybox both turn depth writes off, so the state they
    // leave behind would let this pass clear the map and then write nothing.
    set_depth_test(r, true)
    gl_set_depth_mask(1)
    set_blend(r, false)
    set_face_culling(r, false)
    // Depth only: the map has no colour attachment, and depth clears to the far
    // value the lit pass reads as "nothing between here and the light".
    gl_clear(0, 1)

    use_program(r, r.shadow_program)
    space = gl_uniform_location(r.shadow_program, "lightSpaceMatrix")
    model_slot = gl_uniform_location(r.shadow_program, "model")
    instanced_slot = gl_uniform_location(r.shadow_program, "isInstanced")
    points_slot = gl_uniform_location(r.shadow_program, "instancePoints")
    billboard_slot = gl_uniform_location(r.shadow_program, "instanceBillboard")
    view_pos_slot = gl_uniform_location(r.shadow_program, "viewPos")
    gl_uniform_vec3(view_pos_slot, cam.position.x, cam.position.y, cam.position.z)
    skinned_slot = gl_uniform_location(r.shadow_program, "isSkinned")
    bones_slot = gl_uniform_location(r.shadow_program, "bones")
    gl_uniform_mat4(space, &r.shadow_space)

    r.shadow_batch_count = 0
    identity = core.mat4_ident()

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m == null || !m.visible || !m.casts_shadow {
            i = i + 1
            continue
        }
        // The crowd is posed from the pose bank, not a bones palette, so it is
        // drawn in its own sub-pass below with the crowd depth program.
        if core.model_pose_bank(m) != null {
            i = i + 1
            continue
        }
        core.model_sync_transform(m)
        moved = m.shadow_stamp != m.world_stamp
        m.shadow_stamp = m.world_stamp
        if shadow_batchable(m) {
            b = shadow_batch_for(r, m)
            if b.count >= list.size(b.members) {
                list.add_raw(b.members, m as ptr)
                b.stale = true
            } else if list.get_raw(b.members, b.count) != m as ptr {
                list.set(b.members, b.count, m as ptr)
                b.stale = true
            }
            if moved { b.stale = true }
            b.count = b.count + 1
        } else {
            instanced = 0
            if m.is_instanced && core.model_instance_count(m) > 0 { instanced = 1 }
            gl_uniform_int(instanced_slot, instanced)
            points = 0
            if instanced == 1 && geometry.inst_is_points(m.instances) == 1 { points = 1 }
            gl_uniform_int(points_slot, points)
            gl_uniform_int(billboard_slot, points * m.billboard)
            // The same rule as set_model_matrix: an instanced model's
            // transform is already in every instance, so the model matrix
            // goes as the identity or the scale and the rotation are
            // applied twice. Sent as the model's own, every instanced
            // caster threw the shadow of a copy scaled by itself again.
            // A point stream has the model's frame here instead.
            if points == 1 {
                placed = point_frame(m)
                gl_uniform_mat4(model_slot, &placed)
            } else if instanced == 1 {
                gl_uniform_mat4(model_slot, &identity)
            } else {
                gl_uniform_mat4(model_slot, &m.model_matrix)
            }
            pose_depth(skinned_slot, bones_slot, m)
            gl_vao_bind(depth_vao(m))
            draw_depth(r, m, instanced)
        }
        i = i + 1
    }

    i = 0
    while i < r.shadow_batch_count {
        b = list.get_raw(r.shadow_batches, i) as *GLBatch
        if b.count != list.size(b.members) { b.stale = true }
        if b.stale { fill_batch(r, b) }
        first = b.first as *Model
        if b.count == 1 {
            gl_uniform_int(instanced_slot, 0)
            gl_uniform_int(points_slot, 0)
            gl_uniform_mat4(model_slot, &first.model_matrix)
            pose_depth(skinned_slot, bones_slot, first)
            gl_vao_bind(first.vao)
            draw_depth(r, first, 0)
        } else if b.count > 1 {
            gl_uniform_int(instanced_slot, 1)
            gl_uniform_int(points_slot, 0)
            gl_uniform_int(skinned_slot, 0)
            gl_uniform_mat4(model_slot, &identity)
            gl_vao_bind(b.vao)
            if b.stale {
                b.capacity_bytes = gl_batch_upload(b.vao,
                                                        gl_geometry_instance_vbo(b.vao),
                                                        b.instances, b.capacity_bytes)
                b.stale = false
            }
            gl_draw_elements_instanced(core.mesh_index_count(first.mesh), 0, b.count)
            r.last_draw_calls = r.last_draw_calls + 1
        }
        i = i + 1
    }
    render_crowd_shadows(r)

    gl_vao_bind(0)
    bind_output(r)
    gl_viewport(0, 0, r.viewport_width, r.viewport_height)
}

// The crowd's shadow sub-pass: every pose-bank model, posed by its instances'
// phases, written into the same shadow map with the crowd depth program. The
// instance and phase buffers are brought current here (the shadow pass runs
// before the lit pass would upload them) and their dirty flags cleared, so the
// lit pass reuses the same upload. Depth only, so no colour or lighting.
render_crowd_shadows(r: *GLRenderer) {
    if r.crowd_shadow_program == 0 { return }
    bound = 0
    space_loc = 0
    model_loc = 0
    bank_loc = 0
    frames_loc = 0
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        i = i + 1
        if m == null || !m.visible || !m.casts_shadow { continue }
        if core.model_pose_bank(m) == null { continue }
        if !m.is_instanced || core.model_instance_count(m) <= 0 { continue }
        if bound == 0 {
            use_program(r, r.crowd_shadow_program)
            space_loc = gl_uniform_location(r.crowd_shadow_program, "lightSpaceMatrix")
            model_loc = gl_uniform_location(r.crowd_shadow_program, "model")
            bank_loc = gl_uniform_location(r.crowd_shadow_program, "poseBank")
            frames_loc = gl_uniform_location(r.crowd_shadow_program, "poseBankFrames")
            gl_uniform_mat4(space_loc, &r.shadow_space)
            bound = 1
        }
        core.model_sync_transform(m)
        // Bring the per-instance placement and walk phase current, then let the
        // lit pass skip re-uploading the same data this frame.
        if m.instances_updated {
            m.instance_vbo_capacity = gl_update_instances(m.instances, m.instance_vbo,
                                                               m.instance_vbo_capacity)
            m.instances_updated = false
        }
        if m.instance_phases_updated && m.instance_phase_vbo != 0 {
            gl_update_instance_phases(m.instances, m.instance_phase_vbo)
            m.instance_phases_updated = false
        }
        if m.pose_bank_texture == 0 {
            m.pose_bank_texture = gl_posebank_texture(posing.posebank_data(m.pose_bank), posing.posebank_frames(m.pose_bank), posing.posebank_bones(m.pose_bank))
        }
        gl_texture_bind(3, m.pose_bank_texture)
        gl_uniform_int(bank_loc, 3)
        gl_uniform_int(frames_loc, m.pose_bank_frames)
        // The identity, as the lit crowd draw sends: each figure's placement
        // is its instance matrix, built from the model's own scale, and a
        // shadow cast through the model matrix as well was scaled twice.
        crowd_identity = core.mat4_ident()
        gl_uniform_mat4(model_loc, &crowd_identity)
        // Through the proxy's mesh where the model has one: the near tier
        // casts from the far tier's hundred and sixty-eight triangles.
        gl_vao_bind(depth_vao(m))
        gl_draw_elements_instanced(core.mesh_index_count(depth_mesh(m)), 0,
                                        core.model_instance_count(m))
        r.last_draw_calls = r.last_draw_calls + 1
    }
}

// The vertex array a depth-only draw of `m` binds: its own, or one over
// its proxy's mesh and its own instance stream where it has a proxy that
// is registered (model_set_depth_proxy). A vertex array binds a mesh to an
// instance stream, so the proxy needs a second one, made here the first
// time and kept with the model; it is dropped and remade if the proxy's
// buffers are not the ones it was made over.
depth_vao(m: *Model) -> int {
    if m.depth_proxy == null || !m.is_instanced || m.instance_vbo == 0 { return m.vao }
    proxy = m.depth_proxy as *Model
    if proxy.vbo == 0 || proxy.ebo == 0 || proxy.shares_geometry { return m.vao }
    if m.depth_proxy_vao == 0 {
        m.depth_proxy_vao = gl_vao_create()
        gl_setup_proxy_vao(m.depth_proxy_vao, proxy.vbo, proxy.ebo, proxy.skin_vbo,
                                m.instance_vbo, m.instance_color_vbo, m.instance_phase_vbo)
    }
    return m.depth_proxy_vao
}

// The mesh that array draws: the proxy's where the array is the proxy's.
depth_mesh(m: *Model) -> ptr {
    if m.depth_proxy_vao != 0 && m.depth_proxy != null { return (m.depth_proxy as *Model).mesh }
    return m.mesh
}

draw_depth(r: *GLRenderer, m: *Model, instanced: int) {
    indices = core.mesh_index_count(depth_mesh(m))
    if indices == 0 { return }
    if instanced == 1 {
        gl_draw_elements_instanced(indices, 0, core.model_instance_count(m))
    } else {
        gl_draw_elements(indices, 0)
    }
    r.last_draw_calls = r.last_draw_calls + 1
}

renderer_set_fxaa(r: *GLRenderer, on: bool) { r.enable_fxaa = on }

// Temporal anti-aliasing on or off: the projection nudged a fraction of a
// pixel each frame through an eight-frame Halton sequence, and each frame
// folded into a history the temporal pass reprojects by the scene's
// depth. On, the frame goes through the post chain.
renderer_set_taa(r: *GLRenderer, on: bool) {
    r.enable_taa = on
    if !on { r.taa_history_valid = false ; r.prev_vp_valid = false }
}

renderer_taa(r: *GLRenderer) -> bool { return r.enable_taa }

// The Halton sequence: the k-th point of the base, in 0..1.
halton(index: int, base: int) -> float {
    result = 0.0
    f = 1.0 / (base as float)
    i = index
    while i > 0 {
        result = result + f * ((i % base) as float)
        i = i / base
        f = f / (base as float)
    }
    return result
}

// The frame's view-projection: the camera's, nudged this frame's fraction
// of a pixel when the temporal pass is on -- a translation in clip space
// after the projection. The nudge is kept, in texture space, for the pass.
frame_view_projection(r: *GLRenderer, cam: *Camera, width: int, height: int) -> Mat4 {
    vp = core.camera_view_projection(cam)
    r.jitter_x = 0.0
    r.jitter_y = 0.0
    if !r.enable_taa || width <= 0 || height <= 0 { return vp }
    k = r.taa_frame % 8 + 1
    jx = (halton(k, 2) - 0.5) * 2.0 / (width as float)
    jy = (halton(k, 3) - 0.5) * 2.0 / (height as float)
    r.jitter_x = jx * 0.5
    r.jitter_y = jy * 0.5
    return core.mat4_mul(core.mat4_translate(jx, jy, 0.0), vp)
}
renderer_set_bloom(r: *GLRenderer, on: bool) { r.enable_bloom = on }

renderer_set_bloom_intensity(r: *GLRenderer, intensity: float) { r.bloom_intensity = intensity }

renderer_bloom_intensity(r: *GLRenderer) -> float { return r.bloom_intensity }

// Draw the scene at a fraction of the window and let the composite upscale it.
// Cost per frame is dominated by pixels shaded, so 0.5 is a quarter of the work
// -- the difference between a scene a weak GPU can run and one it cannot. The
// window, the depth of field of the projection and the composite are unchanged;
// only the pass that pays per pixel gets smaller.
renderer_set_render_scale(r: *GLRenderer, scale: float) {
    wanted = scale
    if wanted < 0.25 { wanted = 0.25 }
    if wanted > 1.0 { wanted = 1.0 }
    if wanted == r.render_scale { return }
    r.render_scale = wanted
    if r.post_fbo != 0 && r.viewport_width > 0 {
        resize_post_processing(r, r.viewport_width, r.viewport_height)
    }
}

renderer_render_scale(r: *GLRenderer) -> float { return r.render_scale }

// The vtable's form: set it, then report what was kept. The setter clamps to
// the range the post-processing buffer can actually be sized to, so what comes
// back is not always what went in.
vtable_set_render_scale(r: *GLRenderer, scale: float) -> float {
    renderer_set_render_scale(r, scale)
    return r.render_scale
}

renderer_set_bloom_params(r: *GLRenderer, threshold: float, intensity: float) {
    r.bloom_threshold = threshold
    r.bloom_intensity = intensity
}

renderer_set_msaa(r: *GLRenderer, on: bool) {
    r.enable_msaa = on
    flag = 0
    if on { flag = 1 }
    gl_set_multisample(flag)
}

// Reads back one pixel of the default framebuffer as 0xRRGGBB.
read_pixel(x: int, y: int) -> int {
    return gl_read_pixel(x, y)
}

// The bound framebuffer, written out as a PNG. For a windowed program the frame
// is only there between the last draw and the buffer swap, so this has to be
// called in that window.
// The frame on screen, written out as a PNG.
snapshot(path: string, width: int, height: int) -> bool {
    pixels = gl_read_frame(width, height)
    if pixels == null { return false }
    ok = png.write(path, pixels, width, height)
    free(pixels)
    return ok
}

renderer_default_program(r: *GLRenderer) -> int {
    return r.default_program
}

// With a target set the renderer draws into it rather than the window's
// framebuffer, and every place that would return to framebuffer zero returns to
// the target instead.
renderer_set_target(r: *GLRenderer, target: ptr) {
    r.target = target
}

bind_output(r: *GLRenderer) {
    if r.target != null {
        offscreen.target_bind(r.target)
    } else {
        gl_fbo_bind(0)
    }
}

renderer_set_skybox(r: *GLRenderer, skybox: ptr) {
    r.skybox = skybox
    sky = skybox as *Skybox
    if sky != null && sky.texture == 0 {
        renderer_set_clear_color(r, sky.red, sky.green, sky.blue)
    }
}

skybox_create(r: *GLRenderer, path: string) -> *Skybox {
    if path == "" { return core.skybox_solid(0.5, 0.7, 1.0) }

    // The sky drawn from the sun binds the renderer's own default texture,
    // since the shader reads one whether or not it is used.
    procedural = string.equals(path, core.SKY_PROCEDURAL) == 1
    texture = r.default_texture
    if !procedural { texture = renderer_load_texture(r, path) }
    if texture == 0 {
        println("ae3d: skybox texture unavailable, falling back to a solid sky")
        return core.skybox_solid(0.5, 0.7, 1.0)
    }

    sky = core.skybox_solid(0.5, 0.7, 1.0)
    sky.texture = texture
    sky.procedural = procedural
    sky.program = compile_program(shaders.VERTEX_SKYBOX, shaders.FRAGMENT_SKYBOX, "skybox")
    if sky.program == 0 {
        if !procedural { renderer_release_texture(r, texture) }
        sky.texture = 0
        return sky
    }
    sky.u_sky_procedural = gl_uniform_location(sky.program, "skyProcedural")
    sky.u_cloud_weather = gl_uniform_location(sky.program, "cloudWeather")
    sky.u_cloud_shape = gl_uniform_location(sky.program, "cloudShape")
    ensure_cloud_textures(r, r.cloud_cover > 0.0)

    sky.u_view = gl_uniform_location(sky.program, "view")
    sky.u_projection = gl_uniform_location(sky.program, "projection")
    sky.u_prev_view_projection = gl_uniform_location(sky.program, "prevViewProjection")
    sky.u_sampler = gl_uniform_location(sky.program, "skybox")
    sky.u_cloud_cover = gl_uniform_location(sky.program, "cloudCover")
    sky.u_sky_overcast = gl_uniform_location(sky.program, "skyOvercast")
    sky.u_sky_overcast_color = gl_uniform_location(sky.program, "skyOvercastColor")
    sky.u_cloud_time = gl_uniform_location(sky.program, "cloudTime")
    sky.u_cloud_frame = gl_uniform_location(sky.program, "cloudFrame")
    sky.u_cloud_sun = gl_uniform_location(sky.program, "cloudSun")
    sky.u_cloud_sun_color = gl_uniform_location(sky.program, "cloudSunColor")
    sky.u_cloud_eye = gl_uniform_location(sky.program, "viewPos")

    sky.mesh = core.mesh_create()
    core.mesh_push_skybox_cube(sky.mesh, sky.size)

    sky.vao = gl_vao_create()
    gl_vao_bind(sky.vao)
    sky.vbo = gl_buffer_create()
    gl_upload_mesh(sky.mesh, sky.vbo, 0)
    gl_setup_vertex_attribs()
    gl_vao_bind(0)
    return sky
}

skybox_free(r: *GLRenderer, sky: *Skybox) {
    if sky == null { return }
    if sky.vao != 0 { gl_vao_delete(sky.vao) }
    if sky.vbo != 0 { gl_buffer_delete(sky.vbo) }
    if sky.program != 0 { gl_program_delete(sky.program) }
    if sky.texture != 0 && !sky.procedural { renderer_release_texture(r, sky.texture) }
    if sky.mesh != null { core.mesh_destroy(sky.mesh) }
    heap.free(sky)
}


// The sky must sit behind everything, so its translation is stripped from the
// view matrix and it is drawn with depth writes off.
render_skybox(r: *GLRenderer, cam: *Camera, light: *Light) {
    sky = r.skybox as *Skybox
    if sky == null || sky.texture == 0 || sky.vao == 0 { return }

    use_program(r, sky.program)
    gl_uniform_int(sky.u_sky_procedural, flag_int(sky.procedural))
    // The clouds over the image, lit by the scene's key light.
    gl_uniform_float(sky.u_cloud_cover, r.cloud_cover)
    gl_uniform_float(sky.u_sky_overcast, r.sky_overcast)
    gl_uniform_vec3(sky.u_sky_overcast_color, r.sky_overcast_color.x, r.sky_overcast_color.y, r.sky_overcast_color.z)
    gl_uniform_float(sky.u_cloud_time, r.scene_time * r.cloud_wind)
    // The frame for the march's dither only when the temporal pass will
    // fold it; still otherwise.
    cloud_frame = 0
    if r.enable_taa { cloud_frame = r.taa_frame % 64 + 1 }
    gl_uniform_int(sky.u_cloud_frame, cloud_frame)
    gl_uniform_vec3(sky.u_cloud_eye, cam.position.x, cam.position.y, cam.position.z)
    sun = key_light(r.lights, light)
    if sun != null {
        gl_uniform_vec3(sky.u_cloud_sun, sun.direction.x, sun.direction.y, sun.direction.z)
        gl_uniform_vec3(sky.u_cloud_sun_color, sun.color.x * sun.intensity, sun.color.y * sun.intensity, sun.color.z * sun.intensity)
    } else {
        gl_uniform_vec3(sky.u_cloud_sun, 0.0, 1.0, 0.0)
        gl_uniform_vec3(sky.u_cloud_sun_color, 1.0, 1.0, 1.0)
    }

    view = core.camera_view(cam)
    view.m12 = 0.0
    view.m13 = 0.0
    view.m14 = 0.0
    projection = core.camera_projection(cam)

    gl_uniform_mat4(sky.u_view, &view)
    gl_uniform_mat4(sky.u_projection, &projection)
    // Last frame's view, for the sky's motion vector: the camera's turn.
    previous = core.camera_view_projection(cam)
    if r.prev_vp_valid { previous = r.prev_vp }
    gl_uniform_mat4(sky.u_prev_view_projection, &previous)
    gl_uniform_int(sky.u_sampler, 0)

    if r.cloud_cover > 0.0 { ensure_cloud_textures(r, true) }
    gl_set_depth_mask(0)
    gl_texture_bind(0, sky.texture)
    gl_uniform_int(sky.u_cloud_weather, 1)
    gl_texture_bind(1, r.cloud_weather_texture)
    gl_uniform_int(sky.u_cloud_shape, 2)
    gl_texture3d_bind(2, r.cloud_shape_texture)
    r.bound_texture = 0 - 1
    gl_vao_bind(sky.vao)
    gl_draw_arrays(0, 36)
    gl_vao_bind(0)
    gl_set_depth_mask(1)
    r.last_draw_calls = r.last_draw_calls + 1
}

renderer_update_viewport(r: *GLRenderer, width: int, height: int) {
    gl_viewport(0, 0, width, height)
    r.viewport_width = width
    r.viewport_height = height
    if r.target != null { offscreen.target_resize(r.target, width, height) }

    // The scene is drawn into the post buffers before an effect composites it,
    // and they are resized lazily by comparing the viewport against the size
    // recorded here. Recording the new size without resizing them left that
    // comparison always equal, so they stayed the size they were: with FXAA or
    // bloom on, a viewport made smaller drew the frame at the old size and
    // stretched it over the new one, lighting a third of the pixels it should.
    if r.post_fbo != 0 &&
       (r.post_width != scaled_extent(r, width) || r.post_height != scaled_extent(r, height)) {
        resize_post_processing(r, width, height)
    }
}


vtable_shadows(r: *GLRenderer) -> int {
    if renderer_shadows(r) { return 1 }
    return 0
}

vtable_set_shadows(r: *GLRenderer, on: int) {
    renderer_set_shadows(r, on == 1)
}

renderer_frame_pixels(r: *GLRenderer) -> ptr {
    if r.target == null { return null }
    return offscreen.target_pixels_pipelined(r.target)
}

renderer_render(r: *GLRenderer, cam: *Camera, light: *Light) {
    if !r.initialized { return }
    r.last_draw_calls = 0
    // What a frame is made of, counted per frame. Draw calls and state changes
    // are what a scene actually regresses by, and unlike a millisecond they
    // mean the same thing on a workstation and on a runner drawing through
    // llvmpipe -- which is what lets a budget be enforced rather than printed.
    r.last_programs = 0
    r.last_materials = 0
    r.last_textures = 0
    r.frame_stamp = r.frame_stamp + 1
    r.scene_time = platform.time() - r.scene_start
    r.bound_material = null
    r.bound_material_set = false
    r.bound_texture = 0 - 1
    r.bound_instanced = 0 - 1
    r.bound_normal = 0 - 1
    r.bound_instance_color = 0 - 1

    active_light = key_light(r.lights, light)

    // What a pass costs is what the GPU spends on it. The wall time around a
    // submit is the driver taking the work, not doing it, so a pass that
    // doubled on the GPU can read as unchanged; these brackets measure the
    // work. The timer is made on first use because it needs a live context.
    if r.pass_timer == null { r.pass_timer = gl_passtimer_create() }
    gl_passtimer_frame(r.pass_timer)

    gl_passtimer_begin(r.pass_timer, PASS_SHADOW)
    render_shadow_pass(r, active_light, cam)
    gl_passtimer_end(r.pass_timer)

    gl_passtimer_begin(r.pass_timer, PASS_SCENE)
    bind_output(r)
    post_active = begin_post_processing(r)
    r.last_post_active = post_active

    set_wireframe(r, core.debug_enabled())

    // glClear obeys the depth WRITE MASK: with writes off it clears the colour
    // and silently leaves the depth buffer alone. The transparent pass turns
    // them off and the frame ends there, so every frame after the first was
    // depth-tested against the PREVIOUS frame's depths. A still camera hides
    // it, since those depths are the right ones; move, and last frame's
    // geometry rejects this frame's, which is holes punched through whatever
    // was nearer a moment ago. render_shadow_pass already guards its own clear
    // for this reason.
    gl_set_depth_mask(1)
    gl_clear_color(r.clear_r, r.clear_g, r.clear_b, 1.0)
    gl_clear(1, 1)
    // The motion vectors start at zero, whatever the clear colour is.
    if post_active && r.post_velocity != 0 { gl_clear_attachment(1, 0.0, 0.0, 0.0, 0.0) }

    // The seconds since the last frame, for the crowd's motion vectors;
    // a pause or a first frame counts as a short one.
    r.frame_seconds = r.scene_time - r.last_scene_time
    if r.frame_seconds < 0.0 || r.frame_seconds > 0.25 { r.frame_seconds = 0.0 }
    r.last_scene_time = r.scene_time

    set_depth_test(r, core.depth_test())
    if r.skybox != null { render_skybox(r, cam, active_light) }
    set_blend(r, true)
    set_face_culling(r, core.face_culling())

    // Filled from this camera every frame rather than cached behind a flag. The
    // flag was one boolean for the whole program while the frustum it guarded
    // belongs to a renderer, so a second camera drawing after a first was culled
    // against the first camera's frustum: the flag was already clear and nothing
    // refilled. A minimap, a reflection or a second viewport is exactly that.
    // Six planes out of one matrix multiply is not worth a cache.
    if core.frustum_culling() { core.camera_fill_frustum(cam, r.frustum) }

    unjittered = core.camera_view_projection(cam)
    view_projection = frame_view_projection(r, cam, r.post_width, r.post_height)

    draw_opaque(r, &view_projection, active_light, cam)

    // What the opaque pass drew, as depth, for a water surface to read the
    // ground under it by, for the occlusion to shade it from and for the
    // temporal pass to find each pixel's history by. Copied once, only
    // when something will read it.
    r.scene_depth = 0
    if wants_scene_depth(r) || r.ssao_enabled || r.enable_taa { r.scene_depth = gl_scene_depth_capture() }
    if r.ssao_enabled && r.scene_depth != 0 && r.capture_channel == 0 { draw_occlusion(r, cam) }

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        render_model(r, m, &view_projection, active_light, cam, true)
        i = i + 1
    }

    gl_passtimer_end(r.pass_timer)

    gl_passtimer_begin(r.pass_timer, PASS_POST)
    if post_active { resolve_post_processing(r, cam, view_projection, unjittered) }
    r.prev_vp = unjittered
    r.prev_vp_valid = true
    // Every model's matrix of this frame is last frame's now.
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null { core.model_frame_done(m) }
        i = i + 1
    }
    r.taa_frame = r.taa_frame + 1
    gl_passtimer_end(r.pass_timer)

    // Three frames behind, which is what makes the read free: by the time a
    // result is asked for the GPU finished with it long ago.
    r.last_shadow_ms = gl_passtimer_ms(r.pass_timer, PASS_SHADOW)
    r.last_scene_ms = gl_passtimer_ms(r.pass_timer, PASS_SCENE)
    r.last_post_ms = gl_passtimer_ms(r.pass_timer, PASS_POST)
}

// A model can join a merged draw when nothing about it is per-model except
// where it sits: shared geometry, one material, the default program, no
// uniforms of its own and no instances of its own. Transparency is left out on
// purpose, since merging would fix the order those surfaces blend in.
batchable(r: *GLRenderer, m: *Model) -> bool {
    if !core.draw_merging() { return false }
    if m == null || !m.visible || !m.shares_geometry || m.vao == 0 { return false }
    if m.is_instanced && core.model_instance_count(m) > 0 { return false }
    // A skinned figure draws on its own (see the Vulkan renderer's batchable):
    // the merge pass culls by the bind pose's bounds at the origin.
    if m.skeleton != null { return false }
    if core.model_group_count(m) > 0 { return false }
    if core.model_uniform_count(m) > 0 { return false }
    if core.shader_valid(&m.shader) { return false }
    alpha = 1.0
    if m.material != null { alpha = m.material.alpha }
    return alpha >= 0.99
}

// CRITICAL: a pooled batch has to forget a vertex array before it is deleted.
// The pool outlives the models it was built from, it matches a batch to a model
// by comparing vertex array ids, and OpenGL hands the same id out again for the
// next array it creates. So a batch built for geometry that has since been
// released matched its replacement by number, decided it was unchanged, skipped
// the upload and drew from the buffer of the array that is gone. Loading a
// scene holding two models of the same shape crashed inside
// glDrawElementsInstanced every time.
forget_batches(r: *GLRenderer, vao: int) {
    if vao == 0 { return }
    count = list.size(r.batches)
    i = 0
    while i < count {
        b = list.get_raw(r.batches, i) as *GLBatch
        if b != null && b.vao == vao {
            b.vao = 0
            b.material = null
            b.count = 0
            b.capacity_bytes = 0
            b.stale = true
        }
        i = i + 1
    }
    count = list.size(r.shadow_batches)
    i = 0
    while i < count {
        b = list.get_raw(r.shadow_batches, i) as *GLBatch
        if b != null && b.vao == vao {
            b.vao = 0
            b.count = 0
            b.capacity_bytes = 0
            b.stale = true
        }
        i = i + 1
    }
}

batch_for(r: *GLRenderer, m: *Model) -> *GLBatch {
    i = 0
    while i < r.batch_count {
        b = list.get_raw(r.batches, i) as *GLBatch
        if b.vao == m.vao && core.material_equals(b.material as *Material, m.material) {
            return b
        }
        i = i + 1
    }

    if r.batch_count >= list.size(r.batches) {
        fresh = heap.new(GLBatch)
        fresh.instances = geometry.inst_create()
        fresh.members = list.new()
        fresh.capacity_bytes = 0
        fresh.count = 0
        fresh.vao = 0
        fresh.material = null
        fresh.stale = true
        list.add_raw(r.batches, fresh)
    }
    b = list.get_raw(r.batches, r.batch_count) as *GLBatch
    if b.vao != m.vao || b.material != m.material as ptr { b.stale = true }
    b.vao = m.vao
    b.material = m.material as ptr
    b.first = m as ptr
    b.count = 0
    r.batch_count = r.batch_count + 1
    return b
}

// The shadow pass takes its uniform locations straight from the shadow program
// rather than through the slot cache, which is per drawn program; this is the
// same work apply_skeleton does, against those locations.
pose_depth(skinned_slot: int, bones_slot: int, m: *Model) {
    if m.skeleton == null {
        gl_uniform_int(skinned_slot, 0)
        return
    }
    sk = m.skeleton as *Skeleton
    skin.skeleton_update(sk)
    gl_uniform_int(skinned_slot, 1)
    gl_uniform_mat4v(bones_slot, skin.skeleton_count(sk),
                          core.palette_data(skin.skeleton_palette(sk)))
}

// The depth pass only cares about shape, so models that share geometry merge
// whatever their materials are. It also ignores the camera's frustum: a caster
// off screen still throws a shadow onto something on it.
shadow_batchable(m: *Model) -> bool {
    if m == null || !m.visible || !m.casts_shadow || !m.shares_geometry { return false }
    if m.vao == 0 { return false }
    return !(m.is_instanced && core.model_instance_count(m) > 0)
}

shadow_batch_for(r: *GLRenderer, m: *Model) -> *GLBatch {
    i = 0
    while i < r.shadow_batch_count {
        b = list.get_raw(r.shadow_batches, i) as *GLBatch
        if b.vao == m.vao { return b }
        i = i + 1
    }

    if r.shadow_batch_count >= list.size(r.shadow_batches) {
        fresh = heap.new(GLBatch)
        fresh.instances = geometry.inst_create()
        fresh.members = list.new()
        fresh.capacity_bytes = 0
        fresh.count = 0
        fresh.vao = 0
        fresh.first = null
        fresh.stale = true
        list.add_raw(r.shadow_batches, fresh)
    }
    b = list.get_raw(r.shadow_batches, r.shadow_batch_count) as *GLBatch
    if b.vao != m.vao { b.stale = true }
    b.vao = m.vao
    b.first = m as ptr
    b.count = 0
    r.shadow_batch_count = r.shadow_batch_count + 1
    return b
}

// The opaque pass gathers what can be merged and draws each group once, then
// draws whatever could not be merged the way it always was.
draw_opaque(r: *GLRenderer, view_projection: *Mat4, light: *Light, cam: *Camera) {
    r.batch_count = 0

    count = list.size(r.models)
    i = 0
    while i < count {
        refresh_geometry(r, list.get_raw(r.models, i) as *Model)
        i = i + 1
    }

    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if batchable(r, m) {
            core.model_sync_transform(m)
            if core.frustum_culling() &&
               !core.frustum_sphere_visible(r.frustum, m.bounding_center, m.bounding_radius) {
                i = i + 1
                continue
            }
            // Each pass keeps its own mark: the shadow pass runs first and used
            // to clear the flag both of them read, so a model that moved was
            // rebuilt into the shadow batch and left stale in this one.
            moved = m.draw_stamp != m.world_stamp
            m.draw_stamp = m.world_stamp
            b = batch_for(r, m)
            // Rebuilding four hundred matrices and re-uploading them is only
            // worth doing when the group is not what it was: a scene that has
            // not moved keeps the buffer it already sent.
            if b.count >= list.size(b.members) {
                list.add_raw(b.members, m as ptr)
                b.stale = true
            } else if list.get_raw(b.members, b.count) != m as ptr {
                list.set(b.members, b.count, m as ptr)
                b.stale = true
            }
            if moved { b.stale = true }
            b.count = b.count + 1
        } else {
            render_model(r, m, view_projection, light, cam, false)
        }
        i = i + 1
    }

    i = 0
    while i < r.batch_count {
        b = list.get_raw(r.batches, i) as *GLBatch
        if b.count != list.size(b.members) { b.stale = true }
        if b.stale { fill_batch(r, b) }
        if b.count == 1 {
            render_model(r, b.first as *Model, view_projection, light, cam, false)
        } else if b.count > 1 {
            draw_batch(r, b, view_projection, light, cam)
        }
        i = i + 1
    }
}

fill_batch(r: *GLRenderer, b: *GLBatch) {
    while list.size(b.members) > b.count { list.remove(b.members, list.size(b.members) - 1) }
    geometry.inst_resize(b.instances, b.count)
    i = 0
    while i < b.count {
        m = list.get_raw(b.members, i) as *Model
        geometry.inst_set_matrix(b.instances, i, &m.model_matrix)
        i = i + 1
    }
}

draw_batch(r: *GLRenderer, b: *GLBatch, view_projection: *Mat4, light: *Light, cam: *Camera) {
    slots = slots_for(r, r.default_program)
    use_program(r, r.default_program)
    if slots.frame_stamp != r.frame_stamp {
        set_frame_uniforms(r, slots, view_projection, light, r.lights, cam)
        slots.frame_stamp = r.frame_stamp
    }
    bind_shadow_map(r, slots)

    material = b.material as *Material
    apply_material(r, slots, material)
    apply_transparency(r, false)
    apply_texture(r, slots, texture_for(r, material))
    apply_normal_map(r, slots, normal_for(r, material))
    apply_instancing(r, slots, 1)
    gl_uniform_int(slots.instance_points, 0)
    gl_uniform_int(slots.instance_billboard, 0)
    apply_instance_color(r, slots, 0)

    // The shader reads the instanced transform as model * instanceModel, so the
    // group transform has to be identity: a batch's matrices are already the
    // world transforms of the models it merged.
    identity = core.mat4_ident()
    gl_uniform_mat4(slots.model, &identity)
    // Its members stand still: last frame's matrix is this frame's.
    gl_uniform_mat4(slots.prev_model, &identity)

    // A batch's members carry no settings of their own, so the program must not
    // still be holding the ones the model before them asked for.
    apply_shading(r, slots, null, r.default_program)

    gl_vao_bind(b.vao)
    if b.stale {
        b.capacity_bytes = gl_batch_upload(b.vao, gl_geometry_instance_vbo(b.vao),
                                                b.instances, b.capacity_bytes)
        b.stale = false
    }
    gl_draw_elements_instanced(core.mesh_index_count((b.first as *Model).mesh), 0, b.count)
    gl_vao_bind(0)
    r.last_draw_calls = r.last_draw_calls + 1
}

// Whether the model has a surface to draw in this pass. A model split across
// materials can have opaque groups and transparent ones and so take part in
// both; a single-material model takes part in one. Asked before any per-model
// work so a model with nothing in this pass costs a pointer walk rather than a
// transform, a skin fit, a program bind and a set of uniforms it never draws.
model_in_pass(m: *Model, transparent_pass: bool) -> bool {
    groups = core.model_group_count(m)
    if groups > 0 {
        i = 0
        while i < groups {
            group = core.model_group(m, i)
            material = group_material(m, group)
            alpha = 1.0
            if material != null { alpha = material.alpha }
            if (alpha < 0.99) == transparent_pass { return true }
            i = i + 1
        }
        return false
    }
    alpha = 1.0
    if m.material != null { alpha = m.material.alpha }
    return (alpha < 0.99) == transparent_pass
}

// Whether any model draws through the water program: the one shader that
// reads the scene's depth.
wants_scene_depth(r: *GLRenderer) -> bool {
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible && core.shader_valid(&m.shader) && m.shader.kind == core.SHADER_WATER {
            return true
        }
        i = i + 1
    }
    return false
}

// The occlusion over the opaque scene: the depth just captured, read by a
// fullscreen draw that multiplies what is there by how much of the
// hemisphere over each pixel the depth says is filled. Before the
// transparent pass, so the water is not darkened by the ground it hides.
draw_occlusion(r: *GLRenderer, cam: *Camera) {
    if r.ssao_program == 0 || r.screen_vao == 0 { return }
    use_program(r, r.ssao_program)
    gl_texture_bind(1, r.scene_depth)
    r.bound_texture = 0 - 1
    gl_uniform_int(gl_uniform_location(r.ssao_program, "depthTexture"), 1)
    gl_uniform_int(gl_uniform_location(r.ssao_program, "screenTexture"), 0)
    view_projection = core.camera_view_projection(cam)
    inverse = core.mat4_inverse(view_projection)
    gl_uniform_mat4(gl_uniform_location(r.ssao_program, "viewProjection"), &view_projection)
    gl_uniform_mat4(gl_uniform_location(r.ssao_program, "invViewProjection"), &inverse)
    gl_uniform_vec3(gl_uniform_location(r.ssao_program, "viewPos"),
                         cam.position.x, cam.position.y, cam.position.z)
    gl_uniform_vec2(gl_uniform_location(r.ssao_program, "screenSize"),
                         gl_viewport_width() * 1.0, gl_viewport_height() * 1.0)
    gl_uniform_float(gl_uniform_location(r.ssao_program, "ssaoRadius"), r.ssao_radius)
    gl_uniform_float(gl_uniform_location(r.ssao_program, "ssaoIntensity"), r.ssao_intensity)

    set_depth_test(r, false)
    gl_set_depth_mask(0)
    set_wireframe(r, false)
    // AE3D_SSAO_SHOW=1 draws the occlusion itself in place of the scene,
    // for looking at what the pass found.
    if core.env_int("AE3D_SSAO_SHOW", 0) == 1 { gl_set_blend(0) } else { gl_set_blend_multiply() }
    gl_vao_bind(r.screen_vao)
    gl_draw_arrays(0, 6)
    gl_vao_bind(0)
    r.last_draw_calls = r.last_draw_calls + 1

    // The ordinary blend back, whatever the cache says it was.
    gl_set_blend(1)
    r.blend_state = true
    gl_set_depth_mask(1)
    set_depth_test(r, core.depth_test())
    set_wireframe(r, core.debug_enabled())
}

// The scene's depth on texture unit 4 for a program that reads it, with
// what it needs to turn a stored depth back into a world position.
bind_scene_depth(r: *GLRenderer, slots: *ProgramSlots, cam: *Camera) {
    if slots.scene_depth < 0 { return }
    has = 0
    if r.scene_depth != 0 {
        gl_texture_bind(4, r.scene_depth)
        has = 1
    }
    gl_uniform_int(slots.scene_depth, 4)
    gl_uniform_int(slots.has_scene_depth, has)
    gl_uniform_vec2(slots.screen_size, gl_viewport_width() * 1.0, gl_viewport_height() * 1.0)
    inverse = core.mat4_inverse(core.camera_view_projection(cam))
    gl_uniform_mat4(slots.inv_view_projection, &inverse)
}

render_model(r: *GLRenderer, m: *Model, view_projection: *Mat4,
             light: *Light, cam: *Camera, transparent_pass: bool) {
    if m == null || !m.visible { return }
    if !model_in_pass(m, transparent_pass) { return }

    core.model_sync_transform(m)
    // Before the cull, because a skinned mesh's own bounds are the bind pose's
    // and say nothing about where its bones have carried it.
    if m.skeleton != null { skin.skeleton_fit(m.skeleton as *Skeleton, m) }
    // An instanced model is never culled by its own bounds: they describe the
    // one base mesh at its origin, while its instances stand anywhere in the
    // world. Testing that one small sphere threw the whole crowd away the moment
    // the camera looked past its origin -- every zombie vanished on a zoom.
    // The instances cull themselves: the crowd bucket drops the fogged-out ones
    // and the GPU clips the rest.
    spread = m.is_instanced && core.model_instance_count(m) > 0
    if core.frustum_culling() && !spread &&
       !core.frustum_sphere_visible(r.frustum, m.bounding_center, m.bounding_radius) {
        return
    }

    program = r.default_program
    // A crowd -- a model carrying a pose bank -- draws through the crowd
    // program, which poses each instance from the bank at its own phase rather
    // than from the one shared bone uniform.
    is_crowd = core.model_pose_bank(m) != null
    if is_crowd {
        program = r.crowd_program
    } else if core.shader_valid(&m.shader) {
        if !m.shader.compiled {
            m.shader.program = compile_program(m.shader.vertex_source,
                                               m.shader.fragment_source, "model")
            m.shader.compiled = true
        }
        if m.shader.program != 0 { program = m.shader.program }
    }

    slots = slots_for(r, program)
    use_program(r, program)
    if slots.frame_stamp != r.frame_stamp {
        set_frame_uniforms(r, slots, view_projection, light, r.lights, cam)
        slots.frame_stamp = r.frame_stamp
    }
    bind_shadow_map(r, slots)
    bind_scene_depth(r, slots, cam)
    set_model_matrix(slots, m)
    apply_skeleton(r, slots, m)
    apply_shading(r, slots, m, program)
    if is_crowd { bind_pose_bank(r, slots, m) }

    gl_vao_bind(m.vao)

    groups = core.model_group_count(m)
    if groups > 0 {
        i = 0
        while i < groups {
            group = core.model_group(m, i)
            material = group_material(m, group)
            alpha = 1.0
            if material != null { alpha = material.alpha }
            is_transparent = alpha < 0.99

            if is_transparent == transparent_pass {
                apply_material(r, slots, material)
                apply_transparency(r, is_transparent)
                apply_texture(r, slots, texture_for(r, material))
                apply_normal_map(r, slots, normal_for(r, material))
                draw(r, m, slots, group.index_count, group.index_start * 4)
            }
            i = i + 1
        }
    } else {
        alpha = 1.0
        if m.material != null { alpha = m.material.alpha }
        is_transparent = alpha < 0.99

        if is_transparent == transparent_pass {
            apply_material(r, slots, m.material)
            apply_transparency(r, is_transparent)
            apply_texture(r, slots, texture_for(r, m.material))
            apply_normal_map(r, slots, normal_for(r, m.material))
            draw(r, m, slots, core.mesh_index_count(m.mesh), 0)
        }
    }

    gl_vao_bind(0)
}

texture_for(r: *GLRenderer, material: *Material) -> int {
    if material == null { return r.default_texture }
    if material.texture_stale { refresh_material_texture(r, material) }
    if material.texture_id != 0 { return material.texture_id }
    return r.default_texture
}

apply_transparency(r: *GLRenderer, transparent: bool) {
    set_blend(r, true)
    if transparent {
        gl_set_depth_mask(0)
        set_face_culling(r, false)
    } else {
        gl_set_depth_mask(1)
        set_face_culling(r, core.face_culling())
    }
}

draw(r: *GLRenderer, m: *Model, slots: *ProgramSlots, count: int, byte_offset: int) {
    if count <= 0 { return }
    // An instanced model with nothing active draws nothing. It used to fall
    // through to the plain branch and draw one raw copy of the mesh at the
    // origin -- unposed, untinted -- so a crowd tier that emptied left a
    // bind-pose ghost standing at (0,0,0) that appeared and vanished as the
    // tier filled and emptied.
    if m.is_instanced && core.model_instance_count(m) <= 0 { return }
    if m.is_instanced && core.model_instance_count(m) > 0 {
        if m.instances_updated {
            m.instance_vbo_capacity = gl_update_instances(m.instances, m.instance_vbo,
                                                               m.instance_vbo_capacity)
            m.instances_updated = false
        }
        if m.instance_colors_updated {
            gl_update_instance_colors(m.instances, m.instance_color_vbo)
            m.instance_colors_updated = false
        }
        if m.instance_phases_updated && m.instance_phase_vbo != 0 {
            gl_update_instance_phases(m.instances, m.instance_phase_vbo)
            m.instance_phases_updated = false
        }
        apply_instancing(r, slots, 1)
        apply_points(slots, m)
        apply_instance_color(r, slots, 1)
        gl_draw_elements_instanced(count, byte_offset, core.model_instance_count(m))
    } else {
        apply_instancing(r, slots, 0)
        gl_draw_elements(count, byte_offset)
    }
    r.last_draw_calls = r.last_draw_calls + 1
}

// The camera and the light are the same for every model in a frame, and a
// uniform keeps its value until the program is relinked, so they are uploaded
// once per program per frame rather than once per model. Only the model matrix
// actually differs between draws.
set_frame_uniforms(r: *GLRenderer, slots: *ProgramSlots, view_projection: *Mat4,
                   light: *Light, lights: ptr, cam: *Camera) {
    gl_uniform_mat4(slots.view_projection, view_projection)
    // Last frame's view, unjittered, and this frame's nudge: what every
    // scene shader writes its motion vector from.
    previous = core.camera_view_projection(cam)
    if r.prev_vp_valid { previous = r.prev_vp }
    gl_uniform_mat4(slots.prev_view_projection, &previous)
    gl_uniform_vec2(slots.jitter, r.jitter_x, r.jitter_y)
    gl_uniform_vec2(slots.screen_size, r.post_width * 1.0, r.post_height * 1.0)
    gl_uniform_float(slots.normal_strength, r.normal_strength)
    gl_uniform_float(slots.occlusion_strength, r.occlusion_strength)
    gl_uniform_int(slots.capture_channel, r.capture_channel)
    gl_uniform_float(slots.wetness, r.wetness)
    gl_uniform_float(slots.frame_exposure, r.frame_exposure)

    upload_lights(slots, lights, light, cam.position)

    gl_uniform_vec3(slots.view_pos, cam.position.x, cam.position.y, cam.position.z)
    gl_uniform_float(slots.view_distance, core.camera_far(cam))
    gl_uniform_float(slots.caustics_time, r.scene_time)
    gl_uniform_float(slots.cloud_cover, r.cloud_cover)
    gl_uniform_float(slots.cloud_time, r.scene_time * r.cloud_wind)
    gl_uniform_float(slots.sky_overcast, r.sky_overcast)
    gl_uniform_vec3(slots.sky_overcast_color, r.sky_overcast_color.x, r.sky_overcast_color.y, r.sky_overcast_color.z)
    sun = key_light(lights, light)
    if sun != null {
        gl_uniform_vec3(slots.cloud_sun, sun.direction.x, sun.direction.y, sun.direction.z)
    } else {
        gl_uniform_vec3(slots.cloud_sun, 0.0, 1.0, 0.0)
    }

    enabled = 0
    if r.fog.enabled { enabled = 1 }
    gl_uniform_int(slots.fog_enabled, enabled)
    gl_uniform_float(slots.fog_start, r.fog.start)
    gl_uniform_float(slots.fog_end, r.fog.end)
    gl_uniform_vec3(slots.fog_color, r.fog.color.x, r.fog.color.y, r.fog.color.z)
    gl_uniform_float(slots.fog_intensity, r.fog.intensity)
}

// Every light the scene holds, capped at what the shader declares.
//
// The key light goes in slot zero and the registered ones fill what is left.
// It is the one the scene is shadowed by and the one the ambient term comes
// from, so a program that named a key light and then registered a few lamps
// used to lose its key light entirely: the sun went out the moment a street
// lamp was added.
// The key light first, then the registered lights nearest the camera
// until the slots are full: a scene may hold more lights than a frame
// takes, and the ones a pixel can see are the ones near it.
upload_lights(slots: *ProgramSlots, lights: ptr, key: *Light, eye: Vec3) {
    if slots.light_slots == null { return }
    slots_of = slots.light_slots as int[]

    count = 0
    if key != null {
        upload_light(slots_of, 0, key)
        count = 1
    }

    taken = core.nearest_lights(lights, key, eye, MAX_LIGHTS - count)
    i = 0
    while i < list.size(taken) && count < MAX_LIGHTS {
        upload_light(slots_of, count, list.get_raw(taken, i) as *Light)
        count = count + 1
        i = i + 1
    }
    list.free(taken)
    gl_uniform_int(slots.light_count, count)

    first = key_light(lights, key)
    if first != null {
        gl_uniform_vec3(slots.compat_light_pos, first.position.x, first.position.y, first.position.z)
        gl_uniform_vec3(slots.compat_light_color, first.color.x, first.color.y, first.color.z)
        gl_uniform_float(slots.compat_light_intensity, first.intensity)
        gl_uniform_vec3(slots.compat_light_direction, first.direction.x, first.direction.y, first.direction.z)
    }
}

// Whichever light the scene is shadowed and shaded by: the one the caller
// named, or the first it registered when it named none.
key_light(lights: ptr, key: *Light) -> *Light {
    if key != null { return key }
    if lights != null && list.size(lights) > 0 { return list.get_raw(lights, 0) as *Light }
    return null
}

upload_light(slots_of: int[], index: int, l: *Light) {
    if l == null { return }
    base = index * LIGHT_SLOTS
    gl_uniform_vec3(slots_of[base], l.position.x, l.position.y, l.position.z)
    gl_uniform_vec3(slots_of[base + 1], l.color.x, l.color.y, l.color.z)
    gl_uniform_float(slots_of[base + 2], l.intensity)
    gl_uniform_float(slots_of[base + 3], l.ambient_strength)
    gl_uniform_float(slots_of[base + 4], l.temperature)

    kind = 0
    if l.mode == core.MODE_DIRECTIONAL { kind = 1 }
    if l.mode == core.MODE_SPOT { kind = 2 }
    gl_uniform_int(slots_of[base + 5], kind)

    gl_uniform_vec3(slots_of[base + 6], l.direction.x, l.direction.y, l.direction.z)
    gl_uniform_float(slots_of[base + 7], l.constant_atten)
    gl_uniform_float(slots_of[base + 8], l.linear_atten)
    gl_uniform_float(slots_of[base + 9], l.quadratic_atten)
    gl_uniform_float(slots_of[base + 10], l.spot_cos_outer)
    gl_uniform_float(slots_of[base + 11], l.spot_cos_inner)
}

// Unit 1, because unit 0 is the material's own texture and changes per group.
// The active unit is put back to 0 afterwards: the framebuffer attachment
// helpers bind textures on whatever unit is active, so leaving it on 1 lets a
// resize quietly replace the shadow map with a post-processing target.
// Always says which of the two it is. Leaving the light-space matrix unset when
// there is no map left it at zero, and every fragment then divided its
// light-space position by a w of zero.
// The map outlives the setting: turning shadows off leaves the texture where it
// was, and a pass that only asked whether one exists went on sampling the last
// one drawn. Vulkan rewrites the binding to its white texture on the way off,
// so this is also what keeps the two backends showing the same scene.
bind_shadow_map(r: *GLRenderer, slots: *ProgramSlots) {
    if !r.shadow_enabled || r.shadow_map == 0 {
        gl_uniform_int(slots.has_shadow_map, 0)
        return
    }
    gl_uniform_int(slots.has_shadow_map, 1)
    // Turn the shadow term on with the map. The fragment shader gates it behind
    // enableShadows, and only the rendering.Config path and the water module
    // ever set that -- so an engine-API scene (its models made straight from
    // core) bound a shadow map the shader then ignored, and nothing cast a
    // shadow. Default it on, at a readable strength, whenever a real map is
    // bound; a model that wants no shadow still overrides these per draw.
    gl_uniform_int(slots.enable_shadows, 1)
    gl_uniform_float(slots.shadow_intensity, 0.32)
    gl_uniform_float(slots.shadow_softness, 0.35)
    gl_uniform_mat4(slots.light_space, &r.shadow_space)
    gl_uniform_vec3(slots.shadow_direction, r.shadow_direction.x,
                         r.shadow_direction.y, r.shadow_direction.z)
    gl_uniform_float(slots.shadow_texel_world, r.shadow_texel_world)
    gl_texture_bind(1, r.shadow_map)
    gl_uniform_int(slots.shadow_map, 1)
    // Leaves unit zero on the default texture, so the cache that decides
    // whether a model needs its own bound has to be told. Without this a model
    // whose texture matched the one before it kept the default instead: the
    // cache believed the texture was still there and skipped the bind.
    gl_texture_bind(0, r.default_texture)
    r.bound_texture = r.default_texture
}

// CRITICAL: an instanced model's transform is already in every instance.
// model_set_instance_position fills each instance's matrix from the model's own
// scale and rotation, and the shader multiplies the model matrix by the
// instance's, so sending both applied the scale and the rotation twice: a model
// scaled 2.4 drew its instances at 5.76. The merged-batch path has always sent
// identity here for the same reason.
set_model_matrix(slots: *ProgramSlots, m: *Model) {
    sent = m.model_matrix
    if m.is_instanced && core.model_instance_count(m) > 0 {
        // Points carry a position and a scale only: the model's rotation
        // and scale reach the shader here, in the model matrix with its
        // translation taken out, and each point puts its own back.
        if geometry.inst_is_points(m.instances) == 1 {
            sent = point_frame(m)
        } else {
            sent = core.mat4_ident()
        }
    }
    gl_uniform_mat4(slots.model, &sent)
    // And last frame's, for the motion vectors.
    previous = core.model_prev_matrix(m, sent)
    gl_uniform_mat4(slots.prev_model, &previous)
}

// A model's matrix without its translation: what a point instance is
// placed by, before the point's own position is put in the last column.
point_frame(m: *Model) -> Mat4 {
    frame = m.model_matrix
    frame.m12 = 0.0
    frame.m13 = 0.0
    frame.m14 = 0.0
    return frame
}

set_material_uniforms(slots: *ProgramSlots, material: *Material) {
    if material == null {
        gl_uniform_vec3(slots.diffuse_color, 1.0, 1.0, 1.0)
        gl_uniform_vec3(slots.specular_color, 1.0, 1.0, 1.0)
        gl_uniform_float(slots.metallic, 0.0)
        gl_uniform_float(slots.roughness, 0.5)
        gl_uniform_float(slots.exposure, 1.0)
        gl_uniform_float(slots.reflectivity, 0.0)
        gl_uniform_float(slots.material_alpha, 1.0)
        return
    }
    gl_uniform_vec3(slots.diffuse_color, material.diffuse.x, material.diffuse.y, material.diffuse.z)
    gl_uniform_vec3(slots.specular_color, material.specular.x, material.specular.y, material.specular.z)
    gl_uniform_float(slots.metallic, material.metallic)
    gl_uniform_float(slots.roughness, material.roughness)
    gl_uniform_float(slots.exposure, material.exposure)
    gl_uniform_float(slots.reflectivity, material.reflectivity)
    gl_uniform_float(slots.material_alpha, material.alpha)
}

// A mesh edited after the model was registered. The geometry cache hands the
// same buffers to every model built from identical vertices, so a model whose
// vertices have moved has to stop sharing before its new shape goes up, or it
// rewrites the geometry under everything else drawing the old one.
refresh_geometry(r: *GLRenderer, m: *Model) {
    if m.vao == 0 || geometry.mesh_dirty(m.mesh) != 1 { return }

    if m.shares_geometry {
        gl_geometry_release(m.vao)
        m.vao = gl_vao_create()
        gl_vao_bind(m.vao)
        m.vbo = gl_buffer_create()
        m.ebo = gl_buffer_create()
        gl_upload_mesh(m.mesh, m.vbo, m.ebo)
        gl_setup_vertex_attribs()
        m.shares_geometry = false
    } else {
        gl_vao_bind(m.vao)
        gl_upload_mesh(m.mesh, m.vbo, m.ebo)
    }
    geometry.mesh_clear_dirty(m.mesh)
    core.model_recalculate_bounds(m)
}

// A draw has to shade with what its own model asked for and nothing else. The
// program keeps whatever the draw before it wrote, so before a model whose set
// of settings differs from what is loaded, the defaults go in first and wipe
// the difference. Models configured alike agree on the set, which is the common
// case and costs nothing.
apply_shading(r: *GLRenderer, slots: *ProgramSlots, m: *Model, program: int) {
    names = 0 as uint64
    if m != null { names = core.model_uniform_names(m) }
    if !slots.shading_loaded || slots.loaded_names != names {
        set_model_uniforms(r.defaults as *Model, program)
        slots.loaded_names = names
        slots.shading_loaded = true
    }
    if m != null { set_model_uniforms(m, program) }
}

set_model_uniforms(m: *Model, program: int) {
    count = core.model_uniform_count(m)
    i = 0
    while i < count {
        uniform = core.model_uniform(m, i)
        if uniform != null {
            if uniform.cached_program != program {
                uniform.location = gl_uniform_location(program, uniform.name)
                if uniform.location < 0 {
                    indexed = string.concat(uniform.name, "[0]")
                    uniform.location = gl_uniform_location(program, indexed)
                    string.free(indexed)
                }
                uniform.cached_program = program
            }
            if uniform.location >= 0 {
                if uniform.kind == core.UNIFORM_FLOAT {
                    gl_uniform_float(uniform.location, uniform.number)
                } else if uniform.kind == core.UNIFORM_INT {
                    gl_uniform_int(uniform.location, uniform.integer)
                } else if uniform.kind == core.UNIFORM_VEC3 {
                    gl_uniform_vec3(uniform.location, uniform.vector.x,
                                         uniform.vector.y, uniform.vector.z)
                } else if uniform.kind == core.UNIFORM_FLOAT_ARRAY {
                    gl_uniform_float_array(uniform.location, uniform.array)
                } else if uniform.kind == core.UNIFORM_VEC3_ARRAY {
                    gl_uniform_vec3_array(uniform.location, uniform.array)
                }
            }
        }
        i = i + 1
    }
}

init_post_processing(r: *GLRenderer, width: int, height: int) {
    r.post_fbo = gl_fbo_create()
    r.post_texture = gl_fbo_attach_color(r.post_fbo, width, height, 0)
    r.post_velocity = gl_fbo_attach_velocity(r.post_fbo, width, height)
    r.post_depth = gl_fbo_attach_depth(r.post_fbo, width, height)
    if gl_fbo_complete() != 1 {
        println("ae3d: post-processing framebuffer incomplete")
    }
    gl_fbo_bind(0)

    // An effect otherwise runs over a frame with no antialiasing, since the
    // scene goes into this framebuffer rather than the multisampled default.
    r.post_width = width
    r.post_height = height
    r.post_samples = gl_max_samples()
    if r.post_samples > 0 {
        r.post_ms_fbo = gl_fbo_create()
        attach_multisample_post(r, width, height)
    }

    r.bloom_fbo = gl_fbo_create()
    r.bloom_texture = gl_fbo_attach_color(r.bloom_fbo, width / 4, height / 4, 1)
    if gl_fbo_complete() != 1 {
        println("ae3d: bloom framebuffer incomplete")
    }
    gl_fbo_bind(0)

    r.screen_mesh = core.mesh_create()
    core.mesh_push_screen_quad(r.screen_mesh)
    r.screen_vao = gl_vao_create()
    gl_vao_bind(r.screen_vao)
    r.screen_vbo = gl_buffer_create()
    gl_upload_mesh(r.screen_mesh, r.screen_vbo, 0)
    gl_setup_vertex_attribs()
    gl_vao_bind(0)

    if r.post_samples > 0 && !multisample_resolve_works(r) {
        println("ae3d: this driver does not resolve a multisampled framebuffer, effects will run without it")
        drop_multisample_post(r)
    }
}

// The size the scene is actually drawn at, which is the viewport times the
// render scale. Everything downstream of the scene pass -- the composite, the
// window -- stays at full size; only the pass that costs per pixel shrinks.
scaled_extent(r: *GLRenderer, value: int) -> int {
    out = (value * r.render_scale) as int
    if out < 1 { out = 1 }
    return out
}

resize_post_processing(r: *GLRenderer, width: int, height: int) {
    clamped_width = scaled_extent(r, width)
    clamped_height = scaled_extent(r, height)
    if clamped_width > MAX_FBO_DIMENSION { clamped_width = MAX_FBO_DIMENSION }
    if clamped_height > MAX_FBO_DIMENSION { clamped_height = MAX_FBO_DIMENSION }

    if r.post_texture != 0 { gl_texture_delete(r.post_texture) }
    if r.post_velocity != 0 { gl_texture_delete(r.post_velocity) }
    if r.post_depth != 0 { gl_renderbuffer_delete(r.post_depth) }
    if r.bloom_texture != 0 { gl_texture_delete(r.bloom_texture) }

    r.post_width = clamped_width
    r.post_height = clamped_height
    r.post_texture = gl_fbo_attach_color(r.post_fbo, clamped_width, clamped_height, 0)
    r.post_velocity = gl_fbo_attach_velocity(r.post_fbo, clamped_width, clamped_height)
    r.post_depth = gl_fbo_attach_depth(r.post_fbo, clamped_width, clamped_height)
    gl_fbo_bind(0)

    if r.post_ms_fbo != 0 {
        if r.post_ms_color != 0 { gl_renderbuffer_delete(r.post_ms_color) }
        if r.post_ms_velocity != 0 { gl_renderbuffer_delete(r.post_ms_velocity) }
        if r.post_ms_depth != 0 { gl_renderbuffer_delete(r.post_ms_depth) }
        attach_multisample_post(r, clamped_width, clamped_height)
    }

    bloom_width = clamped_width / 4
    bloom_height = clamped_height / 4
    if bloom_width < 1 { bloom_width = 1 }
    if bloom_height < 1 { bloom_height = 1 }
    r.bloom_texture = gl_fbo_attach_color(r.bloom_fbo, bloom_width, bloom_height, 1)
    gl_fbo_bind(0)
    resize_taa(r, clamped_width, clamped_height)
}

// The temporal pass's two history textures at the post buffers' size,
// attached to the one framebuffer in turn as the pass runs. A resize
// empties the history.
resize_taa(r: *GLRenderer, width: int, height: int) {
    if r.taa_fbo == 0 { r.taa_fbo = gl_fbo_create() }
    if r.taa_texture0 != 0 { gl_texture_delete(r.taa_texture0) }
    if r.taa_texture1 != 0 { gl_texture_delete(r.taa_texture1) }
    r.taa_texture0 = gl_fbo_attach_color(r.taa_fbo, width, height, 0)
    r.taa_texture1 = gl_fbo_attach_color(r.taa_fbo, width, height, 0)
    gl_fbo_bind(0)
    r.taa_history_valid = false
    r.taa_current = 0
}

// The temporal pass: this frame (the post buffer) folded into the history
// by the scene's depth and the last frame's view-projection, into the
// other history texture, which the composite then reads and the next
// frame reads back. Returns the texture the composite should read.
draw_taa(r: *GLRenderer, cam: *Camera, view_projection: Mat4, unjittered: Mat4) -> int {
    if !r.enable_taa || r.taa_program == 0 || r.scene_depth == 0 { return r.post_texture }
    // Made the first time the pass runs, at the post buffers' size; a
    // resize of those remakes them.
    if r.taa_fbo == 0 || r.taa_texture0 == 0 || r.taa_texture1 == 0 { resize_taa(r, r.post_width, r.post_height) }
    if r.taa_fbo == 0 || r.taa_texture0 == 0 || r.taa_texture1 == 0 { return r.post_texture }
    into = r.taa_texture0
    history = r.taa_texture1
    if r.taa_current == 1 { into = r.taa_texture1 ; history = r.taa_texture0 }
    gl_fbo_bind(r.taa_fbo)
    gl_fbo_set_color(r.taa_fbo, into)
    gl_viewport(0, 0, r.post_width, r.post_height)
    use_program(r, r.taa_program)
    gl_texture_bind(0, r.post_texture)
    gl_texture_bind(1, r.scene_depth)
    gl_texture_bind(2, history)
    gl_texture_bind(3, r.post_velocity)
    r.bound_texture = 0 - 1
    gl_uniform_int(gl_uniform_location(r.taa_program, "screenTexture"), 0)
    gl_uniform_int(gl_uniform_location(r.taa_program, "depthTexture"), 1)
    gl_uniform_int(gl_uniform_location(r.taa_program, "historyTexture"), 2)
    gl_uniform_int(gl_uniform_location(r.taa_program, "velocityTexture"), 3)
    gl_uniform_vec2(gl_uniform_location(r.taa_program, "screenSize"), r.post_width * 1.0, r.post_height * 1.0)
    blend = 1.0
    if r.taa_history_valid { blend = 0.1 }
    gl_uniform_float(gl_uniform_location(r.taa_program, "taaBlend"), blend)
    gl_vao_bind(r.screen_vao)
    gl_draw_arrays(0, 6)
    gl_vao_bind(0)
    r.last_draw_calls = r.last_draw_calls + 1
    r.taa_history_valid = true
    r.taa_current = 1 - r.taa_current
    return into
}

begin_post_processing(r: *GLRenderer) -> bool {
    // A render scale below 1 is on its own a reason to draw into the offscreen
    // buffer, with or without an effect to run afterwards: resolve_post_processing
    // falls back to the passthrough program, so the composite becomes the upscale.
    if !r.enable_fxaa && !r.enable_bloom && !r.enable_taa && r.render_scale > 0.999 { return false }
    // A capture channel is the surfaces' own numbers: no effect over them.
    if r.capture_channel != 0 && r.render_scale > 0.999 { return false }
    if r.post_fbo == 0 || r.post_texture == 0 || r.screen_vao == 0 { return false }

    width = gl_viewport_width()
    height = gl_viewport_height()
    if width <= 0 || height <= 0 { return false }

    if width != r.viewport_width || height != r.viewport_height {
        r.viewport_width = width
        r.viewport_height = height
        resize_post_processing(r, width, height)
    }

    target_fbo = r.post_fbo
    if r.post_samples > 0 && r.post_ms_fbo != 0 { target_fbo = r.post_ms_fbo }
    gl_fbo_bind(target_fbo)
    if gl_fbo_complete() != 1 {
        bind_output(r)
        return false
    }
    // The scene writes its colour and its motion vectors.
    if r.post_velocity != 0 { gl_draw_buffers(2) }
    // The scene is drawn at the buffer's size, which is the viewport's only when
    // the render scale is 1. resolve_post_processing puts the viewport back.
    gl_viewport(0, 0, r.post_width, r.post_height)
    return true
}

// Some drivers accept a multisample resolve, report no error, and copy nothing.
// Asking once at startup, with a colour that cannot be confused for an empty
// buffer, is the only way to know: the alternative is a black frame every time
// an effect runs. A driver that cannot do it gets the effect chain without
// multisampling rather than nothing at all.
multisample_resolve_works(r: *GLRenderer) -> bool {
    if r.post_ms_fbo == 0 || r.post_fbo == 0 { return false }
    if r.screen_vao == 0 || r.passthrough_program == 0 { return false }

    // Drawn, not just cleared. A driver was found that resolves a buffer it
    // only had to clear and produces nothing from one that was drawn into,
    // which is the case that matters and the one that was coming out black.
    gl_fbo_bind(r.post_ms_fbo)
    gl_viewport(0, 0, r.post_width, r.post_height)
    gl_clear_color(0.0, 0.0, 0.0, 1.0)
    gl_clear(1, 1)
    set_depth_test(r, false)
    gl_set_depth_mask(0)
    set_blend(r, false)
    use_program(r, r.passthrough_program)
    gl_uniform_int(gl_uniform_location(r.passthrough_program, "screenTexture"), 0)
    gl_vao_bind(r.screen_vao)
    gl_texture_bind(0, r.default_texture)
    r.bound_texture = r.default_texture
    gl_draw_arrays(0, 6)
    gl_vao_bind(0)

    refused = gl_fbo_resolve(r.post_ms_fbo, r.post_fbo, r.post_width, r.post_height)
    gl_fbo_bind(r.post_fbo)
    centre = gl_read_pixel(r.post_width / 2, r.post_height / 2)
    gl_fbo_bind(0)

    set_depth_test(r, true)
    gl_set_depth_mask(1)
    set_blend(r, true)
    return refused == 0 && centre == 0xFFFFFF
}

drop_multisample_post(r: *GLRenderer) {
    if r.post_ms_color != 0 { gl_renderbuffer_delete(r.post_ms_color) ; r.post_ms_color = 0 }
    if r.post_ms_velocity != 0 { gl_renderbuffer_delete(r.post_ms_velocity) ; r.post_ms_velocity = 0 }
    if r.post_ms_depth != 0 { gl_renderbuffer_delete(r.post_ms_depth) ; r.post_ms_depth = 0 }
    if r.post_ms_fbo != 0 { gl_fbo_delete(r.post_ms_fbo) ; r.post_ms_fbo = 0 }
    r.post_samples = 0
}

attach_multisample_post(r: *GLRenderer, width: int, height: int) {
    r.post_ms_color = gl_fbo_attach_color_multisample(r.post_ms_fbo, width, height,
                                                           r.post_samples)
    r.post_ms_velocity = gl_fbo_attach_velocity_multisample(r.post_ms_fbo, width, height,
                                                                 r.post_samples)
    r.post_ms_depth = gl_fbo_attach_depth_multisample(r.post_ms_fbo, width, height,
                                                           r.post_samples)
    if gl_fbo_complete() != 1 {
        gl_renderbuffer_delete(r.post_ms_color)
        gl_renderbuffer_delete(r.post_ms_velocity)
        gl_renderbuffer_delete(r.post_ms_depth)
        r.post_ms_color = 0
        r.post_ms_velocity = 0
        r.post_ms_depth = 0
        r.post_samples = 0
    }
    gl_fbo_bind(0)
}

resolve_post_processing(r: *GLRenderer, cam: *Camera, view_projection: Mat4, unjittered: Mat4) {
    // The scene is drawn; the passes after it write the colour alone.
    if r.post_velocity != 0 { gl_draw_buffers(1) }
    if r.post_samples > 0 && r.post_ms_fbo != 0 {
        // The size the buffers were made at, not whatever the viewport says.
        // A resolve of the wrong rectangle leaves the effect reading a frame
        // nothing was written into.
        refused = gl_fbo_resolve(r.post_ms_fbo, r.post_fbo, r.post_width, r.post_height)
        if refused == 0 && r.post_ms_velocity != 0 {
            refused = gl_fbo_resolve_attachment(r.post_ms_fbo, r.post_fbo, r.post_width, r.post_height, 1)
        }
        if refused != 0 && !r.post_resolve_reported {
            println("ae3d: the driver refused the multisample resolve (0x${refused}), effects will run without it")
            r.post_resolve_reported = true
            r.post_samples = 0
        }
    }
    set_depth_test(r, false)
    gl_set_depth_mask(0)
    set_blend(r, false)
    set_wireframe(r, false)
    source = draw_taa(r, cam, view_projection, unjittered)
    bind_output(r)
    // Back to the full frame for the composite: the scene pass may have been
    // drawn smaller, and this is the step that puts it back on the window.
    gl_viewport(0, 0, r.viewport_width, r.viewport_height)

    gl_clear(1, 0)
    gl_vao_bind(r.screen_vao)
    gl_texture_bind(0, source)


    // A texel of the texture being sampled, which is the post buffer, not the
    // window. The two are the same size only at a render scale of 1.
    texel_x = 1.0 / (r.post_width * 1.0)
    texel_y = 1.0 / (r.post_height * 1.0)

    if r.enable_bloom && r.bloom_program != 0 {
        use_program(r, r.bloom_program)
        gl_uniform_int(gl_uniform_location(r.bloom_program, "screenTexture"), 0)
        gl_uniform_vec2(gl_uniform_location(r.bloom_program, "texelSize"), texel_x, texel_y)
        gl_uniform_float(gl_uniform_location(r.bloom_program, "bloomThreshold"), r.bloom_threshold)
        gl_uniform_float(gl_uniform_location(r.bloom_program, "bloomIntensity"), r.bloom_intensity)
    } else if r.enable_fxaa && r.fxaa_program != 0 {
        use_program(r, r.fxaa_program)
        gl_uniform_int(gl_uniform_location(r.fxaa_program, "screenTexture"), 0)
        gl_uniform_vec2(gl_uniform_location(r.fxaa_program, "texelSize"), texel_x, texel_y)
        gl_uniform_float(gl_uniform_location(r.fxaa_program, "edgeThreshold"), 0.125)
        gl_uniform_float(gl_uniform_location(r.fxaa_program, "edgeThresholdMin"), 0.0625)
        gl_uniform_float(gl_uniform_location(r.fxaa_program, "subpixelQuality"), 0.75)
    } else {
        use_program(r, r.passthrough_program)
        gl_uniform_int(gl_uniform_location(r.passthrough_program, "screenTexture"), 0)
    }

    gl_draw_arrays(0, 6)
    gl_vao_bind(0)

    set_depth_test(r, true)
    gl_set_depth_mask(1)
    set_blend(r, true)
}

free_batches(batches: ptr) {
    if batches == null { return }
    i = 0
    while i < list.size(batches) {
        b = list.get_raw(batches, i) as *GLBatch
        if b != null {
            if b.instances != null { geometry.inst_destroy(b.instances) }
            if b.members != null { list.free(b.members) }
            heap.free(b)
        }
        i = i + 1
    }
    list.free(batches)
}

renderer_cleanup(r: *GLRenderer) {
    if r == null { return }

    // The pass timer owns GL query objects, and deleting a GL object needs the
    // context that made it. This runs from engine_shutdown while the context is
    // still current; renderer_free runs later, after the window and its context
    // are gone, so a glDeleteQueries there dereferences a context that no longer
    // exists -- which a desktop driver shrugs off and llvmpipe segfaults on.
    if r.pass_timer != null {
        gl_passtimer_destroy(r.pass_timer)
        r.pass_timer = null
    }
    // The clouds' textures, for the same reason.
    if r.cloud_shape_texture != 0 {
        gl_texture_delete(r.cloud_shape_texture)
        r.cloud_shape_texture = 0
    }
    if r.cloud_weather_texture != 0 {
        gl_texture_delete(r.cloud_weather_texture)
        r.cloud_weather_texture = 0
    }

    free_batches(r.batches)
    free_batches(r.shadow_batches)
    r.batches = null
    r.shadow_batches = null
    r.batch_count = 0
    r.shadow_batch_count = 0

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null {
            // Shared geometry belongs to the cache and is counted, so deleting
            // it here would take a vertex array other models are still drawing
            // from and leave the cache believing it still owns one.
            if m.shares_geometry {
                gl_geometry_release(m.vao)
                m.vao = 0
                m.vbo = 0
                m.ebo = 0
                m.shares_geometry = false
            } else {
                if m.vao != 0 { gl_vao_delete(m.vao) ; m.vao = 0 }
                if m.vbo != 0 { gl_buffer_delete(m.vbo) ; m.vbo = 0 }
                if m.ebo != 0 { gl_buffer_delete(m.ebo) ; m.ebo = 0 }
            }
            if m.instance_vbo != 0 { gl_buffer_delete(m.instance_vbo) ; m.instance_vbo = 0 }
            if m.instance_color_vbo != 0 {
                gl_buffer_delete(m.instance_color_vbo)
                m.instance_color_vbo = 0
            }
            if m.depth_proxy_vao != 0 { gl_vao_delete(m.depth_proxy_vao) ; m.depth_proxy_vao = 0 }
        }
        i = i + 1
    }
    list.clear(r.models)

    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *TextureEntry
        if entry != null {
            gl_texture_delete(entry.id)
            heap.free(entry)
        }
        i = i + 1
    }
    list.clear(r.textures)

    if r.skybox != null { skybox_free(r, r.skybox as *Skybox) ; r.skybox = null }
    if r.default_texture != 0 { gl_texture_delete(r.default_texture) ; r.default_texture = 0 }
    if r.screen_vao != 0 { gl_vao_delete(r.screen_vao) ; r.screen_vao = 0 }
    if r.screen_vbo != 0 { gl_buffer_delete(r.screen_vbo) ; r.screen_vbo = 0 }
    if r.post_texture != 0 { gl_texture_delete(r.post_texture) ; r.post_texture = 0 }
    if r.bloom_texture != 0 { gl_texture_delete(r.bloom_texture) ; r.bloom_texture = 0 }
    if r.post_depth != 0 { gl_renderbuffer_delete(r.post_depth) ; r.post_depth = 0 }
    if r.post_ms_color != 0 { gl_renderbuffer_delete(r.post_ms_color) ; r.post_ms_color = 0 }
    if r.post_ms_velocity != 0 { gl_renderbuffer_delete(r.post_ms_velocity) ; r.post_ms_velocity = 0 }
    if r.post_ms_depth != 0 { gl_renderbuffer_delete(r.post_ms_depth) ; r.post_ms_depth = 0 }
    if r.post_ms_fbo != 0 { gl_fbo_delete(r.post_ms_fbo) ; r.post_ms_fbo = 0 }
    if r.post_fbo != 0 { gl_fbo_delete(r.post_fbo) ; r.post_fbo = 0 }
    if r.bloom_fbo != 0 { gl_fbo_delete(r.bloom_fbo) ; r.bloom_fbo = 0 }
    if r.taa_texture0 != 0 { gl_texture_delete(r.taa_texture0) ; r.taa_texture0 = 0 }
    if r.taa_texture1 != 0 { gl_texture_delete(r.taa_texture1) ; r.taa_texture1 = 0 }
    if r.taa_fbo != 0 { gl_fbo_delete(r.taa_fbo) ; r.taa_fbo = 0 }
    if r.taa_program != 0 { gl_program_delete(r.taa_program) ; r.taa_program = 0 }
    if r.shadow_map != 0 { gl_texture_delete(r.shadow_map) ; r.shadow_map = 0 }
    if r.shadow_fbo != 0 { gl_fbo_delete(r.shadow_fbo) ; r.shadow_fbo = 0 }

    if r.default_program != 0 { gl_program_delete(r.default_program) ; r.default_program = 0 }
    if r.shadow_program != 0 { gl_program_delete(r.shadow_program) ; r.shadow_program = 0 }
    if r.crowd_shadow_program != 0 { gl_program_delete(r.crowd_shadow_program) ; r.crowd_shadow_program = 0 }
    if r.fxaa_program != 0 { gl_program_delete(r.fxaa_program) ; r.fxaa_program = 0 }
    if r.bloom_program != 0 { gl_program_delete(r.bloom_program) ; r.bloom_program = 0 }
    if r.passthrough_program != 0 {
        gl_program_delete(r.passthrough_program)
        r.passthrough_program = 0
    }

    r.initialized = false
}
