const MAX_FBO_DIMENSION = 8192
const SHADOW_SIZE = 2048
const MAX_LIGHTS = 4
const LIGHT_SLOTS = 10

struct ProgramSlots {
    program: int
    frame_stamp: int
    view_projection: int
    model: int
    // Last frame's, for the motion vectors, with the frame's nudge and the
    // crowd's step over the frame.
    prev_model: int
    prev_view_projection: int
    jitter: int
    crowd_travel: int
    crowd_phase_step: int
    // The scene depth a water surface reads its shore from.
    scene_depth: int
    has_scene_depth: int
    screen_size: int
    inv_view_projection: int
    // The clouds' shadow: cover, drift and the sun, the same three the sky
    // draws the clouds with.
    cloud_cover: int
    cloud_time: int
    sky_overcast: int
    sky_overcast_color: int
    cloud_sun: int
    light_slots: ptr
    light_count: int
    light_space: int
    shadow_map: int
    has_shadow_map: int
    compat_light_pos: int
    compat_light_color: int
    compat_light_intensity: int
    compat_light_direction: int
    view_pos: int
    view_distance: int
    diffuse_color: int
    specular_color: int
    metallic: int
    roughness: int
    exposure: int
    reflectivity: int
    material_alpha: int
    texture_sampler: int
    is_instanced: int
    instance_points: int
    instance_billboard: int
    use_instance_color: int
    is_skinned: int
    bones: int
    pose_bank: int
    pose_bank_frames: int
    impostor: int
    impostor_cols: int
    impostor_rows: int
    impostor_width: int
    impostor_height: int
    normal_sampler: int
    has_normal_map: int
    normal_strength: int
    occlusion_strength: int
    capture_channel: int
    wetness: int
    caustics_time: int
    fog_enabled: int
    shadow_direction: int
    shadow_texel_world: int
    enable_shadows: int
    shadow_intensity: int
    shadow_softness: int
    fog_start: int
    fog_end: int
    fog_color: int
    fog_intensity: int
    loaded_names: uint64
    shading_loaded: bool
}

struct TextureEntry {
    path: string
    id: int
    refs: int
    width: int
    height: int
}

// One merged draw: the geometry every member shares, the surface they all have,
// and the matrices that tell the shader where each copy goes.
struct GLBatch {
    vao: int
    material: ptr
    first: ptr
    instances: ptr
    members: ptr
    capacity_bytes: int
    count: int
    stale: bool
}

struct GLRenderer {
    models: ptr
    lights: ptr
    programs: ptr
    textures: ptr
    frustum: ptr
    skybox: ptr
    target: ptr

    default_program: int
    crowd_program: int
    fxaa_program: int
    bloom_program: int
    // Temporal anti-aliasing: the program, two history textures written
    // in turn with a framebuffer each, the frame's count for the jitter
    // sequence, the last frame's view-projection, and whether the history
    // holds a frame yet.
    taa_program: int
    enable_taa: bool
    taa_fbo: int
    taa_texture0: int
    taa_texture1: int
    taa_current: int
    taa_history_valid: bool
    taa_frame: int
    prev_vp: Mat4
    prev_vp_valid: bool
    jitter_x: float
    jitter_y: float
    // Ambient occlusion from the scene's depth: a fullscreen multiply over
    // the opaque pass, on when a scene asks, with how far a thing shadows
    // its neighbours in metres and how dark that goes.
    // The clouds' noise as textures, made with the first sky and kept.
    cloud_shape_texture: int
    cloud_weather_texture: int
    ssao_program: int
    ssao_enabled: bool
    ssao_radius: float
    ssao_intensity: float
    passthrough_program: int
    current_program: int
    default_texture: int

    face_culling_state: bool
    depth_test_state: bool
    blend_state: bool
    wireframe_state: bool
    initialized: bool

    last_draw_calls: int
    // The passes, timed apart. One number for a frame says it got slower and
    // nothing about where, and the three of them are what a budget is set on.
    last_shadow_ms: float
    last_scene_ms: float
    last_post_ms: float
    pass_timer: ptr
    last_post_active: bool
    last_programs: int
    last_materials: int
    last_textures: int
    frame_stamp: int
    // The scene's depth after the opaque pass, for the transparent pass to
    // read: zero until a frame with a water surface in it captures one.
    scene_depth: int
    shadow_program: int
    crowd_shadow_program: int
    shadow_fbo: int
    shadow_map: int
    shadow_enabled: bool
    shadow_distance: float
    shadow_space: Mat4
    shadow_direction: Vec3
    shadow_texel_world: float
    fog: Fog

    clear_r: float
    clear_g: float
    clear_b: float

    enable_fxaa: bool
    enable_bloom: bool
    enable_msaa: bool
    bloom_threshold: float
    bloom_intensity: float

    batches: ptr
    batch_count: int
    shadow_batches: ptr
    shadow_batch_count: int

    bound_material: ptr
    bound_material_set: bool
    bound_texture: int
    bound_instanced: int
    bound_skinned: int
    bound_normal: int
    // How hard a normal map is allowed to push. One is the map as authored;
    // less flattens it, more exaggerates it. A scene knob rather than a
    // material one, because it is a look and not a surface.
    normal_strength: float
    occlusion_strength: float
    capture_channel: int
    wetness: float
    bound_instance_color: int

    post_fbo: int
    post_texture: int
    post_ms_fbo: int
    post_ms_color: int
    post_ms_depth: int
    // The motion vectors beside the colour: the texture the temporal pass
    // reads, and its multisampled twin the scene draws into.
    post_velocity: int
    post_ms_velocity: int
    // The last frame's time, for the seconds a crowd's vectors span.
    last_scene_time: float
    frame_seconds: float
    post_samples: int
    post_width: int
    post_height: int
    render_scale: float
    post_resolve_reported: bool

    scene_start: float
    scene_time: float
    // The clouds: how much of the sky they cover (zero is a clear sky and
    // no march), and how fast they drift, as a multiple of scene time.
    cloud_cover: float
    cloud_wind: float
    sky_overcast: float
    sky_overcast_color: Vec3
    defaults: ptr
    post_depth: int
    bloom_fbo: int
    bloom_texture: int
    screen_vao: int
    screen_vbo: int
    screen_mesh: ptr

    screen_width: int
    screen_height: int
    viewport_width: int
    viewport_height: int
}

// The three passes a frame is made of, in the order they run.
const PASS_SHADOW = 0
const PASS_SCENE = 1
const PASS_POST = 2

renderer_new() -> *GLRenderer {
    r = heap.new(GLRenderer)
    r.models = list.new()
    r.lights = list.new()
    r.programs = list.new()
    r.textures = list.new()
    r.frustum = core.frustum_new()
    r.batches = list.new()
    r.batch_count = 0
    r.shadow_batches = list.new()
    r.shadow_batch_count = 0
    // Measured rather than chosen: at 1 a normal map moves the worst pixel
    // by 0.04 and reads as almost nothing; at 4 by 0.16 and reads as
    // plastic. 2.5 is 0.10, which is relief.
    r.normal_strength = 2.5
    r.occlusion_strength = 1.0
    r.capture_channel = 0
    r.wetness = 0.0
    r.bound_normal = 0 - 1
    r.fog = core.fog_none()
    r.clear_r = 0.0
    r.clear_g = 0.0
    r.clear_b = 0.0
    r.enable_msaa = true
    r.render_scale = 1.0
    r.bloom_threshold = 0.8
    r.bloom_intensity = 0.4
    r.ssao_enabled = false
    r.ssao_radius = 3.0
    r.ssao_intensity = 1.0
    r.depth_test_state = true
    r.bound_material = null
    r.bound_material_set = false
    r.bound_texture = 0 - 1
    r.bound_instanced = 0 - 1
    r.bound_normal = 0 - 1
    r.bound_instance_color = 0 - 1
    r.scene_start = platform.time()
    r.scene_time = 0.0
    r.defaults = rendering.defaults_model() as ptr
    return r
}

renderer_free(r: *GLRenderer) {
    if r == null { return }
    renderer_cleanup(r)
    ae3d_gl_geometry_shutdown()
    if r.models != null { list.free(r.models) }
    if r.lights != null { list.free(r.lights) }
    if r.programs != null {
        count = list.size(r.programs)
        i = 0
        while i < count {
            slots = list.get_raw(r.programs, i) as *ProgramSlots
            if slots != null {
                free(slots.light_slots)
                heap.free(slots)
            }
            i = i + 1
        }
        list.free(r.programs)
    }
    if r.textures != null {
        count = list.size(r.textures)
        i = 0
        while i < count {
            entry = list.get_raw(r.textures, i) as *TextureEntry
            if entry != null { heap.free(entry) }
            i = i + 1
        }
        list.free(r.textures)
    }
    if r.defaults != null { core.model_free(r.defaults as *Model) }
    if r.frustum != null { core.frustum_free(r.frustum) }
    if r.screen_mesh != null { core.mesh_destroy(r.screen_mesh) }
    heap.free(r)
}

backend(r: *GLRenderer) -> Backend {
    return Backend {
        state: r,
        name: "opengl",
        init: renderer_init as fn(ptr, ptr, int, int) -> int,
        render: renderer_render as fn(ptr, ptr, ptr),
        add_model: renderer_add_model as fn(ptr, ptr),
        remove_model: renderer_remove_model as fn(ptr, ptr),
        load_texture: renderer_load_texture as fn(ptr, string) -> int,
        set_skybox: renderer_set_skybox as fn(ptr, ptr),
        update_viewport: renderer_update_viewport as fn(ptr, int, int),
        set_post: renderer_set_post as fn(ptr, int, int, float, float),
        set_render_scale: vtable_set_render_scale as fn(ptr, float) -> float,
        set_clear_color: renderer_set_clear_color as fn(ptr, float, float, float),
        set_fog: renderer_set_fog as fn(ptr, ptr),
        set_shadow_distance: renderer_set_shadow_distance as fn(ptr, float),
        set_shadows: vtable_set_shadows as fn(ptr, int),
        shadows: vtable_shadows as fn(ptr) -> int,
        add_light: renderer_add_light as fn(ptr, ptr),
        remove_light: renderer_remove_light as fn(ptr, ptr),
        draw_calls: renderer_draw_calls as fn(ptr) -> int,
        frame_pixels: renderer_frame_pixels as fn(ptr) -> ptr,
        cleanup: renderer_cleanup as fn(ptr)
    }
}

compile_program(vertex_source: string, fragment_source: string, label: string) -> int {
    program = ae3d_gl_program_create(vertex_source, fragment_source)
    if program == 0 {
        println("ae3d: ${label} program failed: ${ae3d_gl_program_log()}")
    }
    return program
}

slots_for(r: *GLRenderer, program: int) -> *ProgramSlots {
    count = list.size(r.programs)
    i = 0
    while i < count {
        existing = list.get_raw(r.programs, i) as *ProgramSlots
        if existing != null && existing.program == program { return existing }
        i = i + 1
    }

    s = heap.new(ProgramSlots)
    s.program = program
    // Never a frame number. Left uninitialised, this matched the current frame
    // often enough to skip the frame's uniforms entirely, and a program whose
    // view-projection was still zero rasterised nothing at all.
    s.frame_stamp = 0 - 1
    s.view_projection = ae3d_gl_uniform_location(program, "viewProjection")
    s.model = ae3d_gl_uniform_location(program, "model")
    s.prev_model = ae3d_gl_uniform_location(program, "prevModel")
    s.prev_view_projection = ae3d_gl_uniform_location(program, "prevViewProjection")
    s.jitter = ae3d_gl_uniform_location(program, "jitter")
    s.crowd_travel = ae3d_gl_uniform_location(program, "crowdTravel")
    s.crowd_phase_step = ae3d_gl_uniform_location(program, "crowdPhaseStep")
    // One lookup per light per program, done once, because an array of structs
    // gives no guarantee that element locations are contiguous.
    s.light_slots = calloc(MAX_LIGHTS * LIGHT_SLOTS, 4)
    slots_of = s.light_slots as int[]
    n = 0
    while n < MAX_LIGHTS {
        base = n * LIGHT_SLOTS
        slots_of[base] = ae3d_gl_uniform_location(program, "lights[${n}].position")
        slots_of[base + 1] = ae3d_gl_uniform_location(program, "lights[${n}].color")
        slots_of[base + 2] = ae3d_gl_uniform_location(program, "lights[${n}].intensity")
        slots_of[base + 3] = ae3d_gl_uniform_location(program, "lights[${n}].ambientStrength")
        slots_of[base + 4] = ae3d_gl_uniform_location(program, "lights[${n}].temperature")
        slots_of[base + 5] = ae3d_gl_uniform_location(program, "lights[${n}].isDirectional")
        slots_of[base + 6] = ae3d_gl_uniform_location(program, "lights[${n}].direction")
        slots_of[base + 7] = ae3d_gl_uniform_location(program, "lights[${n}].constantAtten")
        slots_of[base + 8] = ae3d_gl_uniform_location(program, "lights[${n}].linearAtten")
        slots_of[base + 9] = ae3d_gl_uniform_location(program, "lights[${n}].quadraticAtten")
        n = n + 1
    }
    s.light_count = ae3d_gl_uniform_location(program, "lightCount")
    s.light_space = ae3d_gl_uniform_location(program, "lightSpaceMatrix")
    s.shadow_map = ae3d_gl_uniform_location(program, "shadowMap")
    s.has_shadow_map = ae3d_gl_uniform_location(program, "hasShadowMap")
    s.compat_light_pos = ae3d_gl_uniform_location(program, "lightPos")
    s.compat_light_color = ae3d_gl_uniform_location(program, "lightColor")
    s.compat_light_intensity = ae3d_gl_uniform_location(program, "lightIntensity")
    s.compat_light_direction = ae3d_gl_uniform_location(program, "lightDirection")
    s.view_pos = ae3d_gl_uniform_location(program, "viewPos")
    s.view_distance = ae3d_gl_uniform_location(program, "viewDistance")
    s.diffuse_color = ae3d_gl_uniform_location(program, "diffuseColor")
    s.specular_color = ae3d_gl_uniform_location(program, "specularColor")
    s.metallic = ae3d_gl_uniform_location(program, "metallic")
    s.roughness = ae3d_gl_uniform_location(program, "roughness")
    s.exposure = ae3d_gl_uniform_location(program, "exposure")
    s.reflectivity = ae3d_gl_uniform_location(program, "reflectivity")
    s.material_alpha = ae3d_gl_uniform_location(program, "materialAlpha")
    s.texture_sampler = ae3d_gl_uniform_location(program, "textureSampler")
    s.is_instanced = ae3d_gl_uniform_location(program, "isInstanced")
    s.instance_points = ae3d_gl_uniform_location(program, "instancePoints")
    s.instance_billboard = ae3d_gl_uniform_location(program, "instanceBillboard")
    s.use_instance_color = ae3d_gl_uniform_location(program, "useInstanceColor")
    s.is_skinned = ae3d_gl_uniform_location(program, "isSkinned")
    s.bones = ae3d_gl_uniform_location(program, "bones")
    s.pose_bank = ae3d_gl_uniform_location(program, "poseBank")
    s.pose_bank_frames = ae3d_gl_uniform_location(program, "poseBankFrames")
    s.impostor = ae3d_gl_uniform_location(program, "impostor")
    s.impostor_cols = ae3d_gl_uniform_location(program, "impostorCols")
    s.impostor_rows = ae3d_gl_uniform_location(program, "impostorRows")
    s.impostor_width = ae3d_gl_uniform_location(program, "impostorWidth")
    s.impostor_height = ae3d_gl_uniform_location(program, "impostorHeight")
    s.scene_depth = ae3d_gl_uniform_location(program, "sceneDepth")
    s.cloud_cover = ae3d_gl_uniform_location(program, "cloudCover")
    s.cloud_time = ae3d_gl_uniform_location(program, "cloudTime")
    s.sky_overcast = ae3d_gl_uniform_location(program, "skyOvercast")
    s.sky_overcast_color = ae3d_gl_uniform_location(program, "skyOvercastColor")
    s.cloud_sun = ae3d_gl_uniform_location(program, "cloudSun")
    s.has_scene_depth = ae3d_gl_uniform_location(program, "hasSceneDepth")
    s.screen_size = ae3d_gl_uniform_location(program, "screenSize")
    s.inv_view_projection = ae3d_gl_uniform_location(program, "invViewProjection")
    s.normal_sampler = ae3d_gl_uniform_location(program, "normalMap")
    s.has_normal_map = ae3d_gl_uniform_location(program, "hasNormalMap")
    s.normal_strength = ae3d_gl_uniform_location(program, "normalStrength")
    s.occlusion_strength = ae3d_gl_uniform_location(program, "occlusionStrength")
    s.capture_channel = ae3d_gl_uniform_location(program, "captureChannel")
    s.wetness = ae3d_gl_uniform_location(program, "wetness")
    s.caustics_time = ae3d_gl_uniform_location(program, "causticsTime")
    s.shadow_direction = ae3d_gl_uniform_location(program, "shadowDirection")
    s.shadow_texel_world = ae3d_gl_uniform_location(program, "shadowTexelWorld")
    s.enable_shadows = ae3d_gl_uniform_location(program, "enableShadows")
    s.shadow_intensity = ae3d_gl_uniform_location(program, "shadowIntensity")
    s.shadow_softness = ae3d_gl_uniform_location(program, "shadowSoftness")
    s.fog_enabled = ae3d_gl_uniform_location(program, "enableFog")
    s.fog_start = ae3d_gl_uniform_location(program, "fogStart")
    s.fog_end = ae3d_gl_uniform_location(program, "fogEnd")
    s.fog_color = ae3d_gl_uniform_location(program, "fogColor")
    s.fog_intensity = ae3d_gl_uniform_location(program, "fogIntensity")
    s.loaded_names = 0 as uint64
    // Nothing has been written into this program yet, so what it holds is
    // whatever GLSL leaves a uniform at, which is not what a default is.
    s.shading_loaded = false
    list.add_raw(r.programs, s)
    return s
}

set_face_culling(r: *GLRenderer, on: bool) {
    if r.face_culling_state == on { return }
    flag = 0
    if on { flag = 1 }
    ae3d_gl_set_face_culling(flag)
    r.face_culling_state = on
}

set_depth_test(r: *GLRenderer, on: bool) {
    if r.depth_test_state == on { return }
    flag = 0
    if on { flag = 1 }
    ae3d_gl_set_depth_test(flag)
    r.depth_test_state = on
}

set_blend(r: *GLRenderer, on: bool) {
    if r.blend_state == on { return }
    flag = 0
    if on { flag = 1 }
    ae3d_gl_set_blend(flag)
    r.blend_state = on
}

set_wireframe(r: *GLRenderer, on: bool) {
    if r.wireframe_state == on { return }
    flag = 0
    if on { flag = 1 }
    ae3d_gl_set_wireframe(flag)
    r.wireframe_state = on
}

// Uniforms and the bound texture belong to a program, so what the renderer
// remembers about them is only true while that program stays current.
use_program(r: *GLRenderer, program: int) {
    if r.current_program == program { return }
    // Counted where the change happens, not where it is asked for: a budget on
    // how often the renderer is called is a budget on nothing.
    r.last_programs = r.last_programs + 1
    ae3d_gl_program_use(program)
    r.current_program = program
    r.bound_material = null
    r.bound_material_set = false
    r.bound_texture = 0 - 1
    r.bound_instanced = 0 - 1
    r.bound_normal = 0 - 1
    r.bound_instance_color = 0 - 1
}

// A material is a pointer, and the same pointer means the same seven uniforms,
// so a run of models sharing one costs a comparison instead of seven uploads.
// A model with no material is a real case, and null is what it looks like, so
// the cache cannot use null to mean nothing has been bound yet. It did, and a
// scene whose first model had no material never had its material uniforms sent
// at all: the surface kept an alpha of zero and never appeared.
// What a group is made of. A group carries its own material only when the file
// it came from gave it one: an OBJ whose mtllib line is commented out, or which
// names a material no mtl defines, produces groups with none. Those fall back
// to the model's own material, which is the only thing a caller can set from
// outside, so model_set_diffuse and its friends reach a loaded model instead of
// being silently dropped for having groups at all.
group_material(m: *Model, group: *MaterialGroup) -> *Material {
    if group == null { return m.material }
    if group.material != null { return group.material }
    return m.material
}

apply_material(r: *GLRenderer, slots: *ProgramSlots, material: *Material) {
    if r.bound_material_set && r.bound_material == material as ptr { return }
    r.last_materials = r.last_materials + 1
    set_material_uniforms(slots, material)
    r.bound_material = material as ptr
    r.bound_material_set = true
}

apply_texture(r: *GLRenderer, slots: *ProgramSlots, texture: int) {
    if r.bound_texture == texture { return }
    r.last_textures = r.last_textures + 1
    ae3d_gl_texture_bind(0, texture)
    ae3d_gl_uniform_int(slots.texture_sampler, 0)
    r.bound_texture = texture
}

// Unit 2, because 0 is the colour and 1 is the shadow map.
apply_normal_map(r: *GLRenderer, slots: *ProgramSlots, normal: int) {
    if r.bound_normal == normal { return }
    if normal != 0 {
        ae3d_gl_texture_bind(2, normal)
        ae3d_gl_uniform_int(slots.normal_sampler, 2)
    }
    ae3d_gl_uniform_int(slots.has_normal_map, normal != 0)
    r.bound_normal = normal
}

apply_instancing(r: *GLRenderer, slots: *ProgramSlots, instanced: int) {
    if r.bound_instanced == instanced { return }
    ae3d_gl_uniform_int(slots.is_instanced, instanced)
    r.bound_instanced = instanced
}

// Whether the instances are points: a position and a scale each, the
// model's own rotation and scale in the model matrix. Sent every draw,
// since it is not part of the instanced cache and a batch is never points.
apply_points(slots: *ProgramSlots, m: *Model) {
    points = 0
    if m.instances != null && ae3d_inst_is_points(m.instances) == 1 { points = 1 }
    ae3d_gl_uniform_int(slots.instance_points, points)
    billboard = 0
    if points == 1 { billboard = m.billboard }
    ae3d_gl_uniform_int(slots.instance_billboard, billboard)
}

// A model's own instances carry a colour each; a merged draw does not, and its
// members already share one material, so the shader is told to leave the tint
// alone rather than read an attribute nothing filled in.
apply_instance_color(r: *GLRenderer, slots: *ProgramSlots, on: int) {
    if r.bound_instance_color == on { return }
    ae3d_gl_uniform_int(slots.use_instance_color, on)
    r.bound_instance_color = on
}

// The pose, for a model that has one. A skeleton is asked to bring its palette
// up to date first: it rebuilds only the bones whose world transform changed,
// so a figure standing still uploads the array and computes nothing.
apply_skeleton(r: *GLRenderer, slots: *ProgramSlots, m: *Model) {
    if m.skeleton == null {
        if r.bound_skinned != 0 {
            ae3d_gl_uniform_int(slots.is_skinned, 0)
            r.bound_skinned = 0
        }
        return
    }
    sk = m.skeleton as *Skeleton
    skin.skeleton_update(sk)
    ae3d_gl_uniform_int(slots.is_skinned, 1)
    ae3d_gl_uniform_mat4v(slots.bones, skin.skeleton_count(sk),
                          core.palette_data(skin.skeleton_palette(sk)))
    // Every skinned model carries its own palette, so this cannot be skipped
    // for a second one in the same frame the way a shared uniform could.
    r.bound_skinned = 1
}

// A crowd is posed from its pose bank -- a float texture of baked frames -- on
// texture unit 3, uploaded the first time this model is drawn. VERTEX_CROWD
// reads it by (bone, frame); poseBankFrames lets it turn an instance's phase
// into a frame.
bind_pose_bank(r: *GLRenderer, slots: *ProgramSlots, m: *Model) {
    if m.pose_bank_texture == 0 {
        m.pose_bank_texture = ae3d_gl_posebank_texture(m.pose_bank)
    }
    ae3d_gl_texture_bind(3, m.pose_bank_texture)
    ae3d_gl_uniform_int(slots.pose_bank, 3)
    ae3d_gl_uniform_int(slots.pose_bank_frames, m.pose_bank_frames)
    // For the motion vectors: how far a figure's walk and its position
    // moved this frame, from the model's walk cycle and the bank's travel.
    travel = 0.0
    step = 0.0
    if m.crowd_walk > 0.0 {
        step = r.frame_seconds / m.crowd_walk
        travel = ae3d_posebank_travel(m.pose_bank, m.pose_bank_frames) * step
    }
    ae3d_gl_uniform_float(slots.crowd_travel, travel)
    ae3d_gl_uniform_float(slots.crowd_phase_step, step)
    // The impostor's atlas grid and size, off for a crowd drawn as itself.
    on = 0
    if core.model_is_impostor(m) { on = 1 }
    ae3d_gl_uniform_int(slots.impostor, on)
    if on == 1 {
        ae3d_gl_uniform_int(slots.impostor_cols, m.impostor_cols)
        ae3d_gl_uniform_int(slots.impostor_rows, m.impostor_rows)
        ae3d_gl_uniform_float(slots.impostor_width, m.impostor_width)
        ae3d_gl_uniform_float(slots.impostor_height, m.impostor_height)
    }
}

renderer_init(r: *GLRenderer, window: ptr, width: int, height: int) -> int {
    missing = ae3d_gl_load()
    if missing != 0 {
        println("ae3d: ${missing} OpenGL entry point(s) unavailable")
        return 0
    }

    println("ae3d: OpenGL ${ae3d_gl_version()} on ${ae3d_gl_renderer()}")

    r.screen_width = width
    r.screen_height = height
    r.viewport_width = width
    r.viewport_height = height
    ae3d_gl_viewport(0, 0, width, height)
    ae3d_gl_clear_depth(1.0)

    r.default_program = compile_program(shaders.VERTEX_DEFAULT, shaders.FRAGMENT_DEFAULT, "default")
    if r.default_program == 0 { return 0 }
    slots_for(r, r.default_program)

    // The crowd's instanced-skinned program: same lighting as the default, but a
    // vertex stage that poses each instance from the pose bank at its own phase.
    r.crowd_program = compile_program(shaders.VERTEX_CROWD, shaders.FRAGMENT_DEFAULT, "crowd")
    if r.crowd_program == 0 { return 0 }
    slots_for(r, r.crowd_program)

    r.shadow_program = compile_program(shaders.VERTEX_DEPTH, shaders.FRAGMENT_DEPTH, "depth")
    // The crowd's depth pass poses from the pose bank by phase, so it casts a
    // walking shadow, not a bind-pose one. Same fragment (depth only).
    r.crowd_shadow_program = compile_program(shaders.VERTEX_CROWD_DEPTH, shaders.FRAGMENT_DEPTH, "crowd_depth")
    r.fxaa_program = compile_program(shaders.VERTEX_SCREEN, shaders.FRAGMENT_FXAA, "fxaa")
    r.bloom_program = compile_program(shaders.VERTEX_SCREEN, shaders.FRAGMENT_BLOOM, "bloom")
    r.taa_program = compile_program(shaders.VERTEX_SCREEN, shaders.FRAGMENT_TAA, "taa")
    r.ssao_program = compile_program(shaders.VERTEX_SCREEN, shaders.FRAGMENT_SSAO, "ssao")
    r.passthrough_program = compile_program(shaders.VERTEX_SCREEN, shaders.FRAGMENT_PASSTHROUGH, "passthrough")

    r.default_texture = create_default_texture(r)

    // A merged draw leaves the per-instance colour array disabled, so the
    // generic value stands in for it. Without this the shader multiplies every
    // batched surface by black.
    ae3d_gl_set_default_instance_color()

    ae3d_gl_set_face_culling(0)
    r.face_culling_state = false
    ae3d_gl_set_depth_test(1)
    r.depth_test_state = true
    ae3d_gl_set_blend(1)
    r.blend_state = true
    ae3d_gl_set_multisample(1)
    r.enable_msaa = true
    ae3d_gl_set_wireframe(0)
    r.wireframe_state = false

    init_post_processing(r, width, height)

    r.initialized = true
    if r.shadow_enabled { renderer_set_shadows(r, true) }
    return 1
}

create_default_texture(r: *GLRenderer) -> int {
    image = ae3d_image_solid(2, 2, 255, 255, 255, 255)
    if image == null {
        println("ae3d: default texture unavailable: ${ae3d_image_error()}")
        return 0
    }
    id = ae3d_gl_texture_from_image(image, 0, 0)
    ae3d_image_free(image)
    return id
}

renderer_load_texture(r: *GLRenderer, path: string) -> int {
    if path == "" { return 0 }

    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *TextureEntry
        if entry != null && string.equals(entry.path, path) == 1 {
            entry.refs = entry.refs + 1
            return entry.id
        }
        i = i + 1
    }

    image = ae3d_image_load(path)
    if image == null {
        println("ae3d: texture load failed: ${ae3d_image_error()}")
        return 0
    }
    id = ae3d_gl_texture_from_image(image, 0, 1)
    // Read before the image is released. How many pixels an image has is half
    // of what decides whether a surface carries enough detail to be looked at
    // closely; the other half is how far its UVs stretch, and neither is
    // recoverable from a texture handle afterwards.
    width = ae3d_image_width(image)
    height = ae3d_image_height(image)
    ae3d_image_free(image)
    if id == 0 { return 0 }

    entry = heap.new(TextureEntry)
    texture_entry_set_path(entry, path)
    entry.id = id
    entry.refs = 1
    entry.width = width
    entry.height = height
    list.add_raw(r.textures, entry)
    return id
}

texture_entry_set_path(entry: *TextureEntry, path: string) {
    entry.path = core.set_owned(entry.path, path)
}

renderer_release_texture(r: *GLRenderer, id: int) {
    if id == 0 { return }
    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *TextureEntry
        if entry != null && entry.id == id {
            entry.refs = entry.refs - 1
            if entry.refs <= 0 {
                ae3d_gl_texture_delete(entry.id)
                list.remove(r.textures, i)
            heap.free(entry)
            }
            return
        }
        i = i + 1
    }
}

// How hard normal maps push, for the whole scene.
renderer_set_normal_strength(r: *GLRenderer, strength: float) {
    if r != null { r.normal_strength = strength }
}

// What the frame is drawn as: 0 the lit picture, 1 every surface's albedo,
// 2 its normals -- what a bake reads back, and a view for finding out why
// a surface lights the way it does.
renderer_set_capture_channel(r: *GLRenderer, channel: int) {
    if r != null { r.capture_channel = channel }
}

// How wet the scene is, 0..1: rain on every surface that faces up.
renderer_set_wetness(r: *GLRenderer, amount: float) {
    if r != null { r.wetness = amount }
}

renderer_set_occlusion_strength(r: *GLRenderer, strength: float) {
    if r != null { r.occlusion_strength = strength }
}

renderer_texture_count(r: *GLRenderer) -> int {
    return list.size(r.textures)
}

// How big the image behind a material is. Texel density is the texture size
// and the UVs together, so neither alone answers whether a surface carries
// enough detail to be looked at closely.
renderer_material_texture_size(r: *GLRenderer, material: *Material) -> Vec3 {
    if r == null { return core.vec3(0.0, 0.0, 0.0) }
    id = texture_for(r, material)
    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *TextureEntry
        if entry != null && entry.id == id {
            return core.vec3(entry.width * 1.0, entry.height * 1.0, 0.0)
        }
        i = i + 1
    }
    return core.vec3(0.0, 0.0, 0.0)
}

renderer_add_model(r: *GLRenderer, m: *Model) {
    if m == null { return }

    // A model that carries its own instances needs a vertex array of its own,
    // since the instance attributes are part of that state. Everything else
    // goes through the shared cache, so identical geometry is uploaded once and
    // can be merged into one draw later.
    // The geometry cache keys on the vertex array, and joints and weights are
    // not in it: two meshes alike in their vertices and different in their
    // skins would share a vertex array and one of them would be posed by the
    // other's. A skinned mesh takes its own, which costs nothing worth having
    // -- a cache exists for repeated props, and a figure is not one.
    skinned = core.mesh_is_skinned(m.mesh)
    if (m.is_instanced && core.model_instance_count(m) > 0) || skinned {
        m.vao = ae3d_gl_vao_create()
        ae3d_gl_vao_bind(m.vao)
        m.vbo = ae3d_gl_buffer_create()
        m.ebo = ae3d_gl_buffer_create()
        ae3d_gl_upload_mesh(m.mesh, m.vbo, m.ebo)
        ae3d_gl_setup_vertex_attribs()
        m.shares_geometry = false
    } else {
        m.vao = ae3d_gl_geometry_acquire(m.mesh)
        if m.vao == 0 {
            m.vao = ae3d_gl_vao_create()
            ae3d_gl_vao_bind(m.vao)
            m.vbo = ae3d_gl_buffer_create()
            m.ebo = ae3d_gl_buffer_create()
            ae3d_gl_upload_mesh(m.mesh, m.vbo, m.ebo)
            ae3d_gl_setup_vertex_attribs()
            m.shares_geometry = false
        } else {
            m.vbo = 0
            m.ebo = 0
            m.shares_geometry = true
        }
        ae3d_gl_vao_bind(m.vao)
    }

    if skinned {
        m.skin_vbo = ae3d_gl_buffer_create()
        ae3d_gl_upload_skin(m.mesh, m.skin_vbo)
    }

    if m.is_instanced && core.model_instance_count(m) > 0 {
        m.instance_vbo = ae3d_gl_buffer_create()
        if core.model_instance_has_colors(m) {
            m.instance_color_vbo = ae3d_gl_buffer_create()
        }
        ae3d_gl_setup_instance_attribs(m.instances, m.instance_vbo, m.instance_color_vbo)
        m.instance_vbo_capacity = core.model_instance_count(m) * 64
        m.instances_updated = false
        m.instance_colors_updated = false
        // A crowd (a model carrying a pose bank) also gets the per-instance
        // phase attribute at location 11, so the crowd program can pose each
        // instance from its own frame of the bank.
        if core.model_pose_bank(m) != null {
            m.instance_phase_vbo = ae3d_gl_buffer_create()
            ae3d_gl_setup_instance_phase(m.instances, m.instance_phase_vbo)
            m.instance_phases_updated = false
        }
    }

    ae3d_gl_vao_bind(0)

    // Building a mesh marks it dirty, and what was just uploaded is not an edit
    // waiting to be sent: leaving it set gives every model a private buffer on
    // its first frame and there is nothing left to merge.
    ae3d_mesh_clear_dirty(m.mesh)

    core.model_update_matrix(m)
    load_model_textures(r, m)
    core.model_sort_groups_by_texture(m)
    list.add_raw(r.models, m)
}

load_model_textures(r: *GLRenderer, m: *Model) {
    groups = core.model_group_count(m)
    if groups > 0 {
        i = 0
        while i < groups {
            group = core.model_group(m, i)
            if group != null && group.material != null {
                resolve_material_texture(r, group.material)
                resolve_material_normal(r, group.material)
            }
            i = i + 1
        }
        return
    }
    // The normal is resolved here beside the colour rather than left to the
    // first frame that draws the model. A rooftop tank is behind the camera
    // for the whole clip, so a normal loaded lazily at draw time would never
    // load at all -- and a map that is named and never loaded is exactly what
    // the critique looks for.
    if m.material != null {
        resolve_material_texture(r, m.material)
        resolve_material_normal(r, m.material)
    }
}

resolve_material_texture(r: *GLRenderer, material: *Material) {
    material.texture_stale = false
    if core.text(material.texture_path) == "" || material.texture_id != 0 { return }
    id = renderer_load_texture(r, material.texture_path)
    if id == 0 { id = r.default_texture }
    material.texture_id = id
}

// A normal map is loaded through the same cache the colour is, and its absence
// is not a fallback to anything: a surface without one is shaded by the normal
// its geometry has, which is the right answer rather than a flat blue image.
resolve_material_normal(r: *GLRenderer, material: *Material) {
    material.normal_stale = false
    if core.text(material.normal_path) == "" || material.normal_id != 0 { return }
    material.normal_id = renderer_load_texture(r, material.normal_path)
}

normal_for(r: *GLRenderer, material: *Material) -> int {
    if material == null { return 0 }
    if material.normal_stale { resolve_material_normal(r, material) }
    return material.normal_id
}

// The path was changed after this material had already been given a texture, so
// what it is holding is the one it used to want.
refresh_material_texture(r: *GLRenderer, material: *Material) {
    if material.texture_id != 0 && material.texture_id != r.default_texture {
        renderer_release_texture(r, material.texture_id)
    }
    material.texture_id = 0
    resolve_material_texture(r, material)
}

renderer_remove_model(r: *GLRenderer, m: *Model) {
    if m == null { return }

    groups = core.model_group_count(m)
    i = 0
    while i < groups {
        group = core.model_group(m, i)
        if group != null && group.material != null && group.material.texture_id != 0 {
            renderer_release_texture(r, group.material.texture_id)
        }
        i = i + 1
    }
    if m.material != null && m.material.texture_id != 0 {
        renderer_release_texture(r, m.material.texture_id)
    }

    if m.shares_geometry {
        forget_batches(r, m.vao)
        ae3d_gl_geometry_release(m.vao)
        m.vao = 0
        m.vbo = 0
        m.ebo = 0
        m.shares_geometry = false
    } else {
        forget_batches(r, m.vao)
        if m.vao != 0 { ae3d_gl_vao_delete(m.vao) ; m.vao = 0 }
        if m.vbo != 0 { ae3d_gl_buffer_delete(m.vbo) ; m.vbo = 0 }
        if m.ebo != 0 { ae3d_gl_buffer_delete(m.ebo) ; m.ebo = 0 }
    }
    if m.instance_vbo != 0 {
        ae3d_gl_buffer_delete(m.instance_vbo)
        m.instance_vbo = 0
        m.instance_vbo_capacity = 0
    }
    if m.instance_color_vbo != 0 {
        ae3d_gl_buffer_delete(m.instance_color_vbo)
        m.instance_color_vbo = 0
    }
    if m.depth_proxy_vao != 0 { ae3d_gl_vao_delete(m.depth_proxy_vao) ; m.depth_proxy_vao = 0 }

    count = list.size(r.models)
    i = 0
    while i < count {
        if list.get_raw(r.models, i) == m {
            list.remove(r.models, i)
            return
        }
        i = i + 1
    }
}

renderer_add_light(r: *GLRenderer, light: *Light) {
    list.add_raw(r.lights, light)
}

renderer_light_count(r: *GLRenderer) -> int {
    return list.size(r.lights)
}

renderer_light(r: *GLRenderer, index: int) -> *Light {
    if index < 0 || index >= list.size(r.lights) { return null }
    return list.get_raw(r.lights, index) as *Light
}

renderer_remove_light(r: *GLRenderer, light: *Light) {
    count = list.size(r.lights)
    i = 0
    while i < count {
        if list.get_raw(r.lights, i) == light {
            list.remove(r.lights, i)
            return
        }
        i = i + 1
    }
}

renderer_model_count(r: *GLRenderer) -> int {
    return list.size(r.models)
}

renderer_model(r: *GLRenderer, index: int) -> *Model {
    return list.get_raw(r.models, index) as *Model
}

renderer_draw_calls(r: *GLRenderer) -> int {
    return r.last_draw_calls
}

// What the last frame cost, split by pass, and how much of it was the renderer
// changing its mind about what it was drawing with.
// What drew the frame. A frame cost recorded on one card says nothing about
// the same frame on another, so a benchmark that compares times has to know
// whether it is comparing like with like.
device_name() -> string { return ae3d_gl_renderer() }

renderer_post_active(r: *GLRenderer) -> bool { return r.last_post_active }
renderer_shadow_ms(r: *GLRenderer) -> float { return r.last_shadow_ms }
renderer_scene_ms(r: *GLRenderer) -> float { return r.last_scene_ms }
renderer_post_ms(r: *GLRenderer) -> float { return r.last_post_ms }
renderer_program_binds(r: *GLRenderer) -> int { return r.last_programs }
renderer_material_binds(r: *GLRenderer) -> int { return r.last_materials }
renderer_texture_binds(r: *GLRenderer) -> int { return r.last_textures }

renderer_instance_count(r: *GLRenderer) -> int {
    total = 0
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.is_instanced { total = total + core.model_instance_count(m) }
        i = i + 1
    }
    return total
}

renderer_set_clear_color(r: *GLRenderer, red: float, green: float, blue: float) {
    r.clear_r = red
    r.clear_g = green
    r.clear_b = blue
}

// The clouds: how much of the sky they cover, and how fast they drift.
renderer_set_clouds(r: *GLRenderer, cover: float, wind: float) {
    r.cloud_cover = cover
    r.cloud_wind = wind
}

renderer_set_sky_overcast(r: *GLRenderer, amount: float, color: Vec3) {
    r.sky_overcast = amount
    r.sky_overcast_color = color
}

flag_int(on: bool) -> int {
    if on { return 1 }
    return 0
}

// The clouds' textures, uploaded from the bytes core bakes once.
ensure_cloud_textures(r: *GLRenderer) {
    if r.cloud_shape_texture == 0 {
        bytes = core.cloud_shape_bytes()
        if bytes != null { r.cloud_shape_texture = ae3d_gl_texture3d_rgba(core.CLOUD_SHAPE_SIZE, bytes) }
    }
    if r.cloud_weather_texture == 0 {
        bytes = core.cloud_weather_bytes()
        if bytes != null { r.cloud_weather_texture = ae3d_gl_texture_rgba(core.CLOUD_WEATHER_SIZE, core.CLOUD_WEATHER_SIZE, bytes) }
    }
}

// Ambient occlusion on or off: `radius` is how far, in metres, a thing
// shadows what stands beside it, `intensity` how dark that shadow goes
// (1.0 is the full occlusion the depth finds, 0 none).
renderer_set_ssao(r: *GLRenderer, on: bool, radius: float, intensity: float) {
    r.ssao_enabled = on
    r.ssao_radius = radius
    r.ssao_intensity = intensity
}

renderer_ssao(r: *GLRenderer) -> bool { return r.ssao_enabled }

renderer_set_fog(r: *GLRenderer, f: *Fog) {
    if f == null { r.fog = core.fog_none() ; return }
    r.fog.color = f.color
    r.fog.start = f.start
    r.fog.end = f.end
    r.fog.intensity = f.intensity
    r.fog.enabled = f.enabled
}

renderer_fog(r: *GLRenderer) -> Fog { return r.fog }

renderer_set_post(r: *GLRenderer, fxaa: int, bloom: int, threshold: float, intensity: float) {
    r.enable_fxaa = fxaa == 1
    r.enable_bloom = bloom == 1
    r.bloom_threshold = threshold
    r.bloom_intensity = intensity
}

// Depth is written to a colour target rather than a depth texture: sampling a
// depth attachment through texture() returns opaque white on this driver
// whatever its filter and compare state, so it cannot be read in the main pass.
//
// Asking for shadows is a setting; building the map is GPU work. Keeping them
// apart lets a program configure the renderer before the context exists, which
// is the order the engine hands its settings down in: renderer_init builds the
// map for whatever was asked for by then.
renderer_set_shadows(r: *GLRenderer, on: bool) {
    r.shadow_enabled = on
    if !on || !r.initialized || r.shadow_fbo != 0 { return }

    r.shadow_fbo = ae3d_gl_fbo_create()
    r.shadow_map = ae3d_gl_fbo_attach_shadow_map(r.shadow_fbo, SHADOW_SIZE)
    bind_output(r)
    if r.shadow_map == 0 { r.shadow_enabled = false }
}

renderer_shadows(r: *GLRenderer) -> bool { return r.shadow_enabled }

// The map itself, so a caller can tell "shadows are off" from "shadows are on
// and the map was never built".
renderer_shadow_map(r: *GLRenderer) -> int { return r.shadow_map }

// How far from the camera shadows are drawn. Zero fits the map to the whole
// scene, which is right for a scene that is all of one size and wrong for a
// street: past this, a shadow is not drawn at all rather than drawn badly.
renderer_set_shadow_distance(r: *GLRenderer, metres: float) {
    r.shadow_distance = metres
}

renderer_shadow_distance(r: *GLRenderer) -> float { return r.shadow_distance }

// The light's box has to cover what the camera can see, so it is centred on the
// scene and sized to it rather than to the light.
light_space_matrix(r: *GLRenderer, light: *Light, cam: *Camera) -> Mat4 {
    centre = core.vec3(0.0, 0.0, 0.0)
    radius = 1.0
    shown = 0

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible {
            centre = core.v3_add(centre, m.bounding_center)
            shown = shown + 1
        }
        i = i + 1
    }
    if shown > 0 { centre = core.v3_mul(centre, 1.0 / (shown * 1.0)) }

    // A map fitted to the whole world is a map with nothing left for the things
    // in it: a ground plane ninety metres across pushes the box out until the
    // depth range swallows a figure two metres tall, and the shadow disappears
    // with no error anywhere. A shadow distance fits the box to what the camera
    // can see instead, so how sharp a shadow is stops depending on how big the
    // world is.
    if r.shadow_distance > 0.0 && cam != null {
        centre = core.v3_add(cam.position,
                             core.v3_mul(cam.front, r.shadow_distance * 0.5))
        // Snap the box centre to the shadow map's world-texel grid, so the map
        // covers the same texels frame to frame and only ever shifts by whole
        // texels. Without it the box slides continuously with the camera and the
        // shadow edges crawl and shimmer as you move -- the classic swim. The
        // moon is near enough to straight down that snapping on the world axes
        // stands in for snapping on the light's own.
        texel = r.shadow_distance * 2.0 / (SHADOW_SIZE * 1.0)
        centre = core.vec3(snap_to(centre.x, texel), snap_to(centre.y, texel),
                           snap_to(centre.z, texel))
        return light_box(r, light, centre, r.shadow_distance)
    }

    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible {
            span = core.v3_len(core.v3_sub(m.bounding_center, centre)) + m.bounding_radius
            if span > radius { radius = span }
        }
        i = i + 1
    }

    return light_box(r, light, centre, radius)
}

// Round a coordinate to the nearest multiple of `t`, for either sign.
snap_to(v: float, t: float) -> float {
    if t <= 0.0 { return v }
    n = v / t
    k = 0
    if n >= 0.0 { k = (n + 0.5) as int } else { k = (n - 0.5) as int }
    return (k as float) * t
}

// A light's direction points at the light, the way the shading does it, so the
// way the light travels is the other way about. A point light travels from
// where it is towards what it lights.
light_box(r: *GLRenderer, light: *Light, centre: Vec3, radius: float) -> Mat4 {
    direction = core.v3_mul(core.v3_normalize(light.direction), 0.0 - 1.0)
    if light.mode != core.MODE_DIRECTIONAL {
        direction = core.v3_normalize(core.v3_sub(centre, light.position))
    }
    if core.v3_len(direction) < 0.001 { direction = core.vec3(0.0, 0.0 - 1.0, 0.0) }
    r.shadow_direction = direction
    r.shadow_texel_world = radius * 2.0 / (SHADOW_SIZE * 1.0)

    eye = core.v3_sub(centre, core.v3_mul(direction, radius * 2.0))
    up = core.vec3(0.0, 1.0, 0.0)
    if core.abs_of(direction.y) > 0.99 { up = core.vec3(0.0, 0.0, 1.0) }

    view = core.mat4_look_at(eye, centre, up)
    projection = core.mat4_ortho(0.0 - radius, radius, 0.0 - radius, radius,
                                 0.01, radius * 4.0)
    return core.mat4_mul(projection, view)
}

render_shadow_pass(r: *GLRenderer, light: *Light, cam: *Camera) {
    if !r.shadow_enabled || r.shadow_fbo == 0 || r.shadow_program == 0 || light == null {
        return
    }

    r.shadow_space = light_space_matrix(r, light, cam)

    ae3d_gl_fbo_bind(r.shadow_fbo)
    ae3d_gl_viewport(0, 0, SHADOW_SIZE, SHADOW_SIZE)

    // The post pass and the skybox both turn depth writes off, so the state they
    // leave behind would let this pass clear the map and then write nothing.
    set_depth_test(r, true)
    ae3d_gl_set_depth_mask(1)
    set_blend(r, false)
    set_face_culling(r, false)
    // Depth only: the map has no colour attachment, and depth clears to the far
    // value the lit pass reads as "nothing between here and the light".
    ae3d_gl_clear(0, 1)

    use_program(r, r.shadow_program)
    space = ae3d_gl_uniform_location(r.shadow_program, "lightSpaceMatrix")
    model_slot = ae3d_gl_uniform_location(r.shadow_program, "model")
    instanced_slot = ae3d_gl_uniform_location(r.shadow_program, "isInstanced")
    points_slot = ae3d_gl_uniform_location(r.shadow_program, "instancePoints")
    billboard_slot = ae3d_gl_uniform_location(r.shadow_program, "instanceBillboard")
    view_pos_slot = ae3d_gl_uniform_location(r.shadow_program, "viewPos")
    ae3d_gl_uniform_vec3(view_pos_slot, cam.position.x, cam.position.y, cam.position.z)
    skinned_slot = ae3d_gl_uniform_location(r.shadow_program, "isSkinned")
    bones_slot = ae3d_gl_uniform_location(r.shadow_program, "bones")
    ae3d_gl_uniform_mat4(space, &r.shadow_space)

    r.shadow_batch_count = 0
    identity = core.mat4_ident()

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m == null || !m.visible || !m.casts_shadow {
            i = i + 1
            continue
        }
        // The crowd is posed from the pose bank, not a bones palette, so it is
        // drawn in its own sub-pass below with the crowd depth program.
        if core.model_pose_bank(m) != null {
            i = i + 1
            continue
        }
        core.model_sync_transform(m)
        moved = m.shadow_stamp != m.world_stamp
        m.shadow_stamp = m.world_stamp
        if shadow_batchable(m) {
            b = shadow_batch_for(r, m)
            if b.count >= list.size(b.members) {
                list.add_raw(b.members, m as ptr)
                b.stale = true
            } else if list.get_raw(b.members, b.count) != m as ptr {
                list.set(b.members, b.count, m as ptr)
                b.stale = true
            }
            if moved { b.stale = true }
            b.count = b.count + 1
        } else {
            instanced = 0
            if m.is_instanced && core.model_instance_count(m) > 0 { instanced = 1 }
            ae3d_gl_uniform_int(instanced_slot, instanced)
            points = 0
            if instanced == 1 && ae3d_inst_is_points(m.instances) == 1 { points = 1 }
            ae3d_gl_uniform_int(points_slot, points)
            ae3d_gl_uniform_int(billboard_slot, points * m.billboard)
            // The same rule as set_model_matrix: an instanced model's
            // transform is already in every instance, so the model matrix
            // goes as the identity or the scale and the rotation are
            // applied twice. Sent as the model's own, every instanced
            // caster threw the shadow of a copy scaled by itself again.
            // A point stream has the model's frame here instead.
            if points == 1 {
                placed = point_frame(m)
                ae3d_gl_uniform_mat4(model_slot, &placed)
            } else if instanced == 1 {
                ae3d_gl_uniform_mat4(model_slot, &identity)
            } else {
                ae3d_gl_uniform_mat4(model_slot, &m.model_matrix)
            }
            pose_depth(skinned_slot, bones_slot, m)
            ae3d_gl_vao_bind(depth_vao(m))
            draw_depth(r, m, instanced)
        }
        i = i + 1
    }

    i = 0
    while i < r.shadow_batch_count {
        b = list.get_raw(r.shadow_batches, i) as *GLBatch
        if b.count != list.size(b.members) { b.stale = true }
        if b.stale { fill_batch(r, b) }
        first = b.first as *Model
        if b.count == 1 {
            ae3d_gl_uniform_int(instanced_slot, 0)
            ae3d_gl_uniform_int(points_slot, 0)
            ae3d_gl_uniform_mat4(model_slot, &first.model_matrix)
            pose_depth(skinned_slot, bones_slot, first)
            ae3d_gl_vao_bind(first.vao)
            draw_depth(r, first, 0)
        } else if b.count > 1 {
            ae3d_gl_uniform_int(instanced_slot, 1)
            ae3d_gl_uniform_int(points_slot, 0)
            ae3d_gl_uniform_int(skinned_slot, 0)
            ae3d_gl_uniform_mat4(model_slot, &identity)
            ae3d_gl_vao_bind(b.vao)
            if b.stale {
                b.capacity_bytes = ae3d_gl_batch_upload(b.vao,
                                                        ae3d_gl_geometry_instance_vbo(b.vao),
                                                        b.instances, b.capacity_bytes)
                b.stale = false
            }
            ae3d_gl_draw_elements_instanced(core.mesh_index_count(first.mesh), 0, b.count)
            r.last_draw_calls = r.last_draw_calls + 1
        }
        i = i + 1
    }
    render_crowd_shadows(r)

    ae3d_gl_vao_bind(0)
    bind_output(r)
    ae3d_gl_viewport(0, 0, r.viewport_width, r.viewport_height)
}

// The crowd's shadow sub-pass: every pose-bank model, posed by its instances'
// phases, written into the same shadow map with the crowd depth program. The
// instance and phase buffers are brought current here (the shadow pass runs
// before the lit pass would upload them) and their dirty flags cleared, so the
// lit pass reuses the same upload. Depth only, so no colour or lighting.
render_crowd_shadows(r: *GLRenderer) {
    if r.crowd_shadow_program == 0 { return }
    bound = 0
    space_loc = 0
    model_loc = 0
    bank_loc = 0
    frames_loc = 0
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        i = i + 1
        if m == null || !m.visible || !m.casts_shadow { continue }
        if core.model_pose_bank(m) == null { continue }
        if !m.is_instanced || core.model_instance_count(m) <= 0 { continue }
        if bound == 0 {
            use_program(r, r.crowd_shadow_program)
            space_loc = ae3d_gl_uniform_location(r.crowd_shadow_program, "lightSpaceMatrix")
            model_loc = ae3d_gl_uniform_location(r.crowd_shadow_program, "model")
            bank_loc = ae3d_gl_uniform_location(r.crowd_shadow_program, "poseBank")
            frames_loc = ae3d_gl_uniform_location(r.crowd_shadow_program, "poseBankFrames")
            ae3d_gl_uniform_mat4(space_loc, &r.shadow_space)
            bound = 1
        }
        core.model_sync_transform(m)
        // Bring the per-instance placement and walk phase current, then let the
        // lit pass skip re-uploading the same data this frame.
        if m.instances_updated {
            m.instance_vbo_capacity = ae3d_gl_update_instances(m.instances, m.instance_vbo,
                                                               m.instance_vbo_capacity)
            m.instances_updated = false
        }
        if m.instance_phases_updated && m.instance_phase_vbo != 0 {
            ae3d_gl_update_instance_phases(m.instances, m.instance_phase_vbo)
            m.instance_phases_updated = false
        }
        if m.pose_bank_texture == 0 {
            m.pose_bank_texture = ae3d_gl_posebank_texture(m.pose_bank)
        }
        ae3d_gl_texture_bind(3, m.pose_bank_texture)
        ae3d_gl_uniform_int(bank_loc, 3)
        ae3d_gl_uniform_int(frames_loc, m.pose_bank_frames)
        // The identity, as the lit crowd draw sends: each figure's placement
        // is its instance matrix, built from the model's own scale, and a
        // shadow cast through the model matrix as well was scaled twice.
        crowd_identity = core.mat4_ident()
        ae3d_gl_uniform_mat4(model_loc, &crowd_identity)
        // Through the proxy's mesh where the model has one: the near tier
        // casts from the far tier's hundred and sixty-eight triangles.
        ae3d_gl_vao_bind(depth_vao(m))
        ae3d_gl_draw_elements_instanced(core.mesh_index_count(depth_mesh(m)), 0,
                                        core.model_instance_count(m))
        r.last_draw_calls = r.last_draw_calls + 1
    }
}

// The vertex array a depth-only draw of `m` binds: its own, or one over
// its proxy's mesh and its own instance stream where it has a proxy that
// is registered (model_set_depth_proxy). A vertex array binds a mesh to an
// instance stream, so the proxy needs a second one, made here the first
// time and kept with the model; it is dropped and remade if the proxy's
// buffers are not the ones it was made over.
depth_vao(m: *Model) -> int {
    if m.depth_proxy == null || !m.is_instanced || m.instance_vbo == 0 { return m.vao }
    proxy = m.depth_proxy as *Model
    if proxy.vbo == 0 || proxy.ebo == 0 || proxy.shares_geometry { return m.vao }
    if m.depth_proxy_vao == 0 {
        m.depth_proxy_vao = ae3d_gl_vao_create()
        ae3d_gl_setup_proxy_vao(m.depth_proxy_vao, proxy.vbo, proxy.ebo, proxy.skin_vbo,
                                m.instance_vbo, m.instance_color_vbo, m.instance_phase_vbo)
    }
    return m.depth_proxy_vao
}

// The mesh that array draws: the proxy's where the array is the proxy's.
depth_mesh(m: *Model) -> ptr {
    if m.depth_proxy_vao != 0 && m.depth_proxy != null { return (m.depth_proxy as *Model).mesh }
    return m.mesh
}

draw_depth(r: *GLRenderer, m: *Model, instanced: int) {
    indices = core.mesh_index_count(depth_mesh(m))
    if indices == 0 { return }
    if instanced == 1 {
        ae3d_gl_draw_elements_instanced(indices, 0, core.model_instance_count(m))
    } else {
        ae3d_gl_draw_elements(indices, 0)
    }
    r.last_draw_calls = r.last_draw_calls + 1
}

renderer_set_fxaa(r: *GLRenderer, on: bool) { r.enable_fxaa = on }

// Temporal anti-aliasing on or off: the projection nudged a fraction of a
// pixel each frame through an eight-frame Halton sequence, and each frame
// folded into a history the temporal pass reprojects by the scene's
// depth. On, the frame goes through the post chain.
renderer_set_taa(r: *GLRenderer, on: bool) {
    r.enable_taa = on
    if !on { r.taa_history_valid = false ; r.prev_vp_valid = false }
}

renderer_taa(r: *GLRenderer) -> bool { return r.enable_taa }

// The Halton sequence: the k-th point of the base, in 0..1.
halton(index: int, base: int) -> float {
    result = 0.0
    f = 1.0 / (base as float)
    i = index
    while i > 0 {
        result = result + f * ((i % base) as float)
        i = i / base
        f = f / (base as float)
    }
    return result
}

// The frame's view-projection: the camera's, nudged this frame's fraction
// of a pixel when the temporal pass is on -- a translation in clip space
// after the projection. The nudge is kept, in texture space, for the pass.
frame_view_projection(r: *GLRenderer, cam: *Camera, width: int, height: int) -> Mat4 {
    vp = core.camera_view_projection(cam)
    r.jitter_x = 0.0
    r.jitter_y = 0.0
    if !r.enable_taa || width <= 0 || height <= 0 { return vp }
    k = r.taa_frame % 8 + 1
    jx = (halton(k, 2) - 0.5) * 2.0 / (width as float)
    jy = (halton(k, 3) - 0.5) * 2.0 / (height as float)
    r.jitter_x = jx * 0.5
    r.jitter_y = jy * 0.5
    return core.mat4_mul(core.mat4_translate(jx, jy, 0.0), vp)
}
renderer_set_bloom(r: *GLRenderer, on: bool) { r.enable_bloom = on }

renderer_set_bloom_intensity(r: *GLRenderer, intensity: float) { r.bloom_intensity = intensity }

renderer_bloom_intensity(r: *GLRenderer) -> float { return r.bloom_intensity }

// Draw the scene at a fraction of the window and let the composite upscale it.
// Cost per frame is dominated by pixels shaded, so 0.5 is a quarter of the work
// -- the difference between a scene a weak GPU can run and one it cannot. The
// window, the depth of field of the projection and the composite are unchanged;
// only the pass that pays per pixel gets smaller.
renderer_set_render_scale(r: *GLRenderer, scale: float) {
    wanted = scale
    if wanted < 0.25 { wanted = 0.25 }
    if wanted > 1.0 { wanted = 1.0 }
    if wanted == r.render_scale { return }
    r.render_scale = wanted
    if r.post_fbo != 0 && r.viewport_width > 0 {
        resize_post_processing(r, r.viewport_width, r.viewport_height)
    }
}

renderer_render_scale(r: *GLRenderer) -> float { return r.render_scale }

// The vtable's form: set it, then report what was kept. The setter clamps to
// the range the post-processing buffer can actually be sized to, so what comes
// back is not always what went in.
vtable_set_render_scale(r: *GLRenderer, scale: float) -> float {
    renderer_set_render_scale(r, scale)
    return r.render_scale
}

renderer_set_bloom_params(r: *GLRenderer, threshold: float, intensity: float) {
    r.bloom_threshold = threshold
    r.bloom_intensity = intensity
}

renderer_set_msaa(r: *GLRenderer, on: bool) {
    r.enable_msaa = on
    flag = 0
    if on { flag = 1 }
    ae3d_gl_set_multisample(flag)
}

// Reads back one pixel of the default framebuffer as 0xRRGGBB.
read_pixel(x: int, y: int) -> int {
    return ae3d_gl_read_pixel(x, y)
}

// The bound framebuffer, written out as a PNG. For a windowed program the frame
// is only there between the last draw and the buffer swap, so this has to be
// called in that window.
snapshot(path: string, width: int, height: int) -> bool {
    return ae3d_gl_snapshot(path, width, height) == 1
}

renderer_default_program(r: *GLRenderer) -> int {
    return r.default_program
}

// With a target set the renderer draws into it rather than the window's
// framebuffer, and every place that would return to framebuffer zero returns to
// the target instead.
renderer_set_target(r: *GLRenderer, target: ptr) {
    r.target = target
}

bind_output(r: *GLRenderer) {
    if r.target != null {
        ae3d_offscreen_bind(r.target)
    } else {
        ae3d_gl_fbo_bind(0)
    }
}

renderer_set_skybox(r: *GLRenderer, skybox: ptr) {
    r.skybox = skybox
    sky = skybox as *Skybox
    if sky != null && sky.texture == 0 {
        renderer_set_clear_color(r, sky.red, sky.green, sky.blue)
    }
}

skybox_create(r: *GLRenderer, path: string) -> *Skybox {
    if path == "" { return core.skybox_solid(0.5, 0.7, 1.0) }

    // The sky drawn from the sun binds the renderer's own default texture,
    // since the shader reads one whether or not it is used.
    procedural = string.equals(path, core.SKY_PROCEDURAL) == 1
    texture = r.default_texture
    if !procedural { texture = renderer_load_texture(r, path) }
    if texture == 0 {
        println("ae3d: skybox texture unavailable, falling back to a solid sky")
        return core.skybox_solid(0.5, 0.7, 1.0)
    }

    sky = core.skybox_solid(0.5, 0.7, 1.0)
    sky.texture = texture
    sky.procedural = procedural
    sky.program = compile_program(shaders.VERTEX_SKYBOX, shaders.FRAGMENT_SKYBOX, "skybox")
    if sky.program == 0 {
        if !procedural { renderer_release_texture(r, texture) }
        sky.texture = 0
        return sky
    }
    sky.u_sky_procedural = ae3d_gl_uniform_location(sky.program, "skyProcedural")
    sky.u_cloud_weather = ae3d_gl_uniform_location(sky.program, "cloudWeather")
    sky.u_cloud_shape = ae3d_gl_uniform_location(sky.program, "cloudShape")
    ensure_cloud_textures(r)

    sky.u_view = ae3d_gl_uniform_location(sky.program, "view")
    sky.u_projection = ae3d_gl_uniform_location(sky.program, "projection")
    sky.u_prev_view_projection = ae3d_gl_uniform_location(sky.program, "prevViewProjection")
    sky.u_sampler = ae3d_gl_uniform_location(sky.program, "skybox")
    sky.u_cloud_cover = ae3d_gl_uniform_location(sky.program, "cloudCover")
    sky.u_sky_overcast = ae3d_gl_uniform_location(sky.program, "skyOvercast")
    sky.u_sky_overcast_color = ae3d_gl_uniform_location(sky.program, "skyOvercastColor")
    sky.u_cloud_time = ae3d_gl_uniform_location(sky.program, "cloudTime")
    sky.u_cloud_sun = ae3d_gl_uniform_location(sky.program, "cloudSun")
    sky.u_cloud_sun_color = ae3d_gl_uniform_location(sky.program, "cloudSunColor")
    sky.u_cloud_eye = ae3d_gl_uniform_location(sky.program, "viewPos")

    sky.mesh = core.mesh_create()
    core.mesh_push_skybox_cube(sky.mesh, sky.size)

    sky.vao = ae3d_gl_vao_create()
    ae3d_gl_vao_bind(sky.vao)
    sky.vbo = ae3d_gl_buffer_create()
    ae3d_gl_upload_mesh(sky.mesh, sky.vbo, 0)
    ae3d_gl_setup_vertex_attribs()
    ae3d_gl_vao_bind(0)
    return sky
}

skybox_free(r: *GLRenderer, sky: *Skybox) {
    if sky == null { return }
    if sky.vao != 0 { ae3d_gl_vao_delete(sky.vao) }
    if sky.vbo != 0 { ae3d_gl_buffer_delete(sky.vbo) }
    if sky.program != 0 { ae3d_gl_program_delete(sky.program) }
    if sky.texture != 0 && !sky.procedural { renderer_release_texture(r, sky.texture) }
    if sky.mesh != null { core.mesh_destroy(sky.mesh) }
    heap.free(sky)
}


// The sky must sit behind everything, so its translation is stripped from the
// view matrix and it is drawn with depth writes off.
render_skybox(r: *GLRenderer, cam: *Camera, light: *Light) {
    sky = r.skybox as *Skybox
    if sky == null || sky.texture == 0 || sky.vao == 0 { return }

    use_program(r, sky.program)
    ae3d_gl_uniform_int(sky.u_sky_procedural, flag_int(sky.procedural))
    // The clouds over the image, lit by the scene's key light.
    ae3d_gl_uniform_float(sky.u_cloud_cover, r.cloud_cover)
    ae3d_gl_uniform_float(sky.u_sky_overcast, r.sky_overcast)
    ae3d_gl_uniform_vec3(sky.u_sky_overcast_color, r.sky_overcast_color.x, r.sky_overcast_color.y, r.sky_overcast_color.z)
    ae3d_gl_uniform_float(sky.u_cloud_time, r.scene_time * r.cloud_wind)
    ae3d_gl_uniform_vec3(sky.u_cloud_eye, cam.position.x, cam.position.y, cam.position.z)
    sun = key_light(r.lights, light)
    if sun != null {
        ae3d_gl_uniform_vec3(sky.u_cloud_sun, sun.direction.x, sun.direction.y, sun.direction.z)
        ae3d_gl_uniform_vec3(sky.u_cloud_sun_color, sun.color.x * sun.intensity, sun.color.y * sun.intensity, sun.color.z * sun.intensity)
    } else {
        ae3d_gl_uniform_vec3(sky.u_cloud_sun, 0.0, 1.0, 0.0)
        ae3d_gl_uniform_vec3(sky.u_cloud_sun_color, 1.0, 1.0, 1.0)
    }

    view = core.camera_view(cam)
    view.m12 = 0.0
    view.m13 = 0.0
    view.m14 = 0.0
    projection = core.camera_projection(cam)

    ae3d_gl_uniform_mat4(sky.u_view, &view)
    ae3d_gl_uniform_mat4(sky.u_projection, &projection)
    // Last frame's view, for the sky's motion vector: the camera's turn.
    previous = core.camera_view_projection(cam)
    if r.prev_vp_valid { previous = r.prev_vp }
    ae3d_gl_uniform_mat4(sky.u_prev_view_projection, &previous)
    ae3d_gl_uniform_int(sky.u_sampler, 0)

    ae3d_gl_set_depth_mask(0)
    ae3d_gl_texture_bind(0, sky.texture)
    ae3d_gl_uniform_int(sky.u_cloud_weather, 1)
    ae3d_gl_texture_bind(1, r.cloud_weather_texture)
    ae3d_gl_uniform_int(sky.u_cloud_shape, 2)
    ae3d_gl_texture3d_bind(2, r.cloud_shape_texture)
    r.bound_texture = 0 - 1
    ae3d_gl_vao_bind(sky.vao)
    ae3d_gl_draw_arrays(0, 36)
    ae3d_gl_vao_bind(0)
    ae3d_gl_set_depth_mask(1)
    r.last_draw_calls = r.last_draw_calls + 1
}

renderer_update_viewport(r: *GLRenderer, width: int, height: int) {
    ae3d_gl_viewport(0, 0, width, height)
    r.viewport_width = width
    r.viewport_height = height
    if r.target != null { ae3d_offscreen_resize(r.target, width, height) }

    // The scene is drawn into the post buffers before an effect composites it,
    // and they are resized lazily by comparing the viewport against the size
    // recorded here. Recording the new size without resizing them left that
    // comparison always equal, so they stayed the size they were: with FXAA or
    // bloom on, a viewport made smaller drew the frame at the old size and
    // stretched it over the new one, lighting a third of the pixels it should.
    if r.post_fbo != 0 &&
       (r.post_width != scaled_extent(r, width) || r.post_height != scaled_extent(r, height)) {
        resize_post_processing(r, width, height)
    }
}


vtable_shadows(r: *GLRenderer) -> int {
    if renderer_shadows(r) { return 1 }
    return 0
}

vtable_set_shadows(r: *GLRenderer, on: int) {
    renderer_set_shadows(r, on == 1)
}

renderer_frame_pixels(r: *GLRenderer) -> ptr {
    if r.target == null { return null }
    return ae3d_offscreen_read_pipelined(r.target)
}

renderer_render(r: *GLRenderer, cam: *Camera, light: *Light) {
    if !r.initialized { return }
    r.last_draw_calls = 0
    // What a frame is made of, counted per frame. Draw calls and state changes
    // are what a scene actually regresses by, and unlike a millisecond they
    // mean the same thing on a workstation and on a runner drawing through
    // llvmpipe -- which is what lets a budget be enforced rather than printed.
    r.last_programs = 0
    r.last_materials = 0
    r.last_textures = 0
    r.frame_stamp = r.frame_stamp + 1
    r.scene_time = platform.time() - r.scene_start
    r.bound_material = null
    r.bound_material_set = false
    r.bound_texture = 0 - 1
    r.bound_instanced = 0 - 1
    r.bound_normal = 0 - 1
    r.bound_instance_color = 0 - 1

    active_light = key_light(r.lights, light)

    // What a pass costs is what the GPU spends on it. The wall time around a
    // submit is the driver taking the work, not doing it, so a pass that
    // doubled on the GPU can read as unchanged; these brackets measure the
    // work. The timer is made on first use because it needs a live context.
    if r.pass_timer == null { r.pass_timer = ae3d_gl_passtimer_create() }
    ae3d_gl_passtimer_frame(r.pass_timer)

    ae3d_gl_passtimer_begin(r.pass_timer, PASS_SHADOW)
    render_shadow_pass(r, active_light, cam)
    ae3d_gl_passtimer_end(r.pass_timer)

    ae3d_gl_passtimer_begin(r.pass_timer, PASS_SCENE)
    bind_output(r)
    post_active = begin_post_processing(r)
    r.last_post_active = post_active

    set_wireframe(r, core.debug_enabled())

    // glClear obeys the depth WRITE MASK: with writes off it clears the colour
    // and silently leaves the depth buffer alone. The transparent pass turns
    // them off and the frame ends there, so every frame after the first was
    // depth-tested against the PREVIOUS frame's depths. A still camera hides
    // it, since those depths are the right ones; move, and last frame's
    // geometry rejects this frame's, which is holes punched through whatever
    // was nearer a moment ago. render_shadow_pass already guards its own clear
    // for this reason.
    ae3d_gl_set_depth_mask(1)
    ae3d_gl_clear_color(r.clear_r, r.clear_g, r.clear_b, 1.0)
    ae3d_gl_clear(1, 1)
    // The motion vectors start at zero, whatever the clear colour is.
    if post_active && r.post_velocity != 0 { ae3d_gl_clear_attachment(1, 0.0, 0.0, 0.0, 0.0) }

    // The seconds since the last frame, for the crowd's motion vectors;
    // a pause or a first frame counts as a short one.
    r.frame_seconds = r.scene_time - r.last_scene_time
    if r.frame_seconds < 0.0 || r.frame_seconds > 0.25 { r.frame_seconds = 0.0 }
    r.last_scene_time = r.scene_time

    set_depth_test(r, core.depth_test())
    if r.skybox != null { render_skybox(r, cam, active_light) }
    set_blend(r, true)
    set_face_culling(r, core.face_culling())

    // Filled from this camera every frame rather than cached behind a flag. The
    // flag was one boolean for the whole program while the frustum it guarded
    // belongs to a renderer, so a second camera drawing after a first was culled
    // against the first camera's frustum: the flag was already clear and nothing
    // refilled. A minimap, a reflection or a second viewport is exactly that.
    // Six planes out of one matrix multiply is not worth a cache.
    if core.frustum_culling() { core.camera_fill_frustum(cam, r.frustum) }

    unjittered = core.camera_view_projection(cam)
    view_projection = frame_view_projection(r, cam, r.post_width, r.post_height)

    draw_opaque(r, &view_projection, active_light, cam)

    // What the opaque pass drew, as depth, for a water surface to read the
    // ground under it by, for the occlusion to shade it from and for the
    // temporal pass to find each pixel's history by. Copied once, only
    // when something will read it.
    r.scene_depth = 0
    if wants_scene_depth(r) || r.ssao_enabled || r.enable_taa { r.scene_depth = ae3d_gl_scene_depth_capture() }
    if r.ssao_enabled && r.scene_depth != 0 && r.capture_channel == 0 { draw_occlusion(r, cam) }

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        render_model(r, m, &view_projection, active_light, cam, true)
        i = i + 1
    }

    ae3d_gl_passtimer_end(r.pass_timer)

    ae3d_gl_passtimer_begin(r.pass_timer, PASS_POST)
    if post_active { resolve_post_processing(r, cam, view_projection, unjittered) }
    r.prev_vp = unjittered
    r.prev_vp_valid = true
    // Every model's matrix of this frame is last frame's now.
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null { core.model_frame_done(m) }
        i = i + 1
    }
    r.taa_frame = r.taa_frame + 1
    ae3d_gl_passtimer_end(r.pass_timer)

    // Three frames behind, which is what makes the read free: by the time a
    // result is asked for the GPU finished with it long ago.
    r.last_shadow_ms = ae3d_gl_passtimer_ms(r.pass_timer, PASS_SHADOW)
    r.last_scene_ms = ae3d_gl_passtimer_ms(r.pass_timer, PASS_SCENE)
    r.last_post_ms = ae3d_gl_passtimer_ms(r.pass_timer, PASS_POST)
}

// A model can join a merged draw when nothing about it is per-model except
// where it sits: shared geometry, one material, the default program, no
// uniforms of its own and no instances of its own. Transparency is left out on
// purpose, since merging would fix the order those surfaces blend in.
batchable(r: *GLRenderer, m: *Model) -> bool {
    if !core.draw_merging() { return false }
    if m == null || !m.visible || !m.shares_geometry || m.vao == 0 { return false }
    if m.is_instanced && core.model_instance_count(m) > 0 { return false }
    if core.model_group_count(m) > 0 { return false }
    if core.model_uniform_count(m) > 0 { return false }
    if core.shader_valid(&m.shader) { return false }
    alpha = 1.0
    if m.material != null { alpha = m.material.alpha }
    return alpha >= 0.99
}

// CRITICAL: a pooled batch has to forget a vertex array before it is deleted.
// The pool outlives the models it was built from, it matches a batch to a model
// by comparing vertex array ids, and OpenGL hands the same id out again for the
// next array it creates. So a batch built for geometry that has since been
// released matched its replacement by number, decided it was unchanged, skipped
// the upload and drew from the buffer of the array that is gone. Loading a
// scene holding two models of the same shape crashed inside
// glDrawElementsInstanced every time.
forget_batches(r: *GLRenderer, vao: int) {
    if vao == 0 { return }
    count = list.size(r.batches)
    i = 0
    while i < count {
        b = list.get_raw(r.batches, i) as *GLBatch
        if b != null && b.vao == vao {
            b.vao = 0
            b.material = null
            b.count = 0
            b.capacity_bytes = 0
            b.stale = true
        }
        i = i + 1
    }
    count = list.size(r.shadow_batches)
    i = 0
    while i < count {
        b = list.get_raw(r.shadow_batches, i) as *GLBatch
        if b != null && b.vao == vao {
            b.vao = 0
            b.count = 0
            b.capacity_bytes = 0
            b.stale = true
        }
        i = i + 1
    }
}

batch_for(r: *GLRenderer, m: *Model) -> *GLBatch {
    i = 0
    while i < r.batch_count {
        b = list.get_raw(r.batches, i) as *GLBatch
        if b.vao == m.vao && core.material_equals(b.material as *Material, m.material) {
            return b
        }
        i = i + 1
    }

    if r.batch_count >= list.size(r.batches) {
        fresh = heap.new(GLBatch)
        fresh.instances = ae3d_inst_create()
        fresh.members = list.new()
        fresh.capacity_bytes = 0
        fresh.count = 0
        fresh.vao = 0
        fresh.material = null
        fresh.stale = true
        list.add_raw(r.batches, fresh)
    }
    b = list.get_raw(r.batches, r.batch_count) as *GLBatch
    if b.vao != m.vao || b.material != m.material as ptr { b.stale = true }
    b.vao = m.vao
    b.material = m.material as ptr
    b.first = m as ptr
    b.count = 0
    r.batch_count = r.batch_count + 1
    return b
}

// The shadow pass takes its uniform locations straight from the shadow program
// rather than through the slot cache, which is per drawn program; this is the
// same work apply_skeleton does, against those locations.
pose_depth(skinned_slot: int, bones_slot: int, m: *Model) {
    if m.skeleton == null {
        ae3d_gl_uniform_int(skinned_slot, 0)
        return
    }
    sk = m.skeleton as *Skeleton
    skin.skeleton_update(sk)
    ae3d_gl_uniform_int(skinned_slot, 1)
    ae3d_gl_uniform_mat4v(bones_slot, skin.skeleton_count(sk),
                          core.palette_data(skin.skeleton_palette(sk)))
}

// The depth pass only cares about shape, so models that share geometry merge
// whatever their materials are. It also ignores the camera's frustum: a caster
// off screen still throws a shadow onto something on it.
shadow_batchable(m: *Model) -> bool {
    if m == null || !m.visible || !m.casts_shadow || !m.shares_geometry { return false }
    if m.vao == 0 { return false }
    return !(m.is_instanced && core.model_instance_count(m) > 0)
}

shadow_batch_for(r: *GLRenderer, m: *Model) -> *GLBatch {
    i = 0
    while i < r.shadow_batch_count {
        b = list.get_raw(r.shadow_batches, i) as *GLBatch
        if b.vao == m.vao { return b }
        i = i + 1
    }

    if r.shadow_batch_count >= list.size(r.shadow_batches) {
        fresh = heap.new(GLBatch)
        fresh.instances = ae3d_inst_create()
        fresh.members = list.new()
        fresh.capacity_bytes = 0
        fresh.count = 0
        fresh.vao = 0
        fresh.first = null
        fresh.stale = true
        list.add_raw(r.shadow_batches, fresh)
    }
    b = list.get_raw(r.shadow_batches, r.shadow_batch_count) as *GLBatch
    if b.vao != m.vao { b.stale = true }
    b.vao = m.vao
    b.first = m as ptr
    b.count = 0
    r.shadow_batch_count = r.shadow_batch_count + 1
    return b
}

// The opaque pass gathers what can be merged and draws each group once, then
// draws whatever could not be merged the way it always was.
draw_opaque(r: *GLRenderer, view_projection: *Mat4, light: *Light, cam: *Camera) {
    r.batch_count = 0

    count = list.size(r.models)
    i = 0
    while i < count {
        refresh_geometry(r, list.get_raw(r.models, i) as *Model)
        i = i + 1
    }

    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if batchable(r, m) {
            core.model_sync_transform(m)
            if core.frustum_culling() &&
               !core.frustum_sphere_visible(r.frustum, m.bounding_center, m.bounding_radius) {
                i = i + 1
                continue
            }
            // Each pass keeps its own mark: the shadow pass runs first and used
            // to clear the flag both of them read, so a model that moved was
            // rebuilt into the shadow batch and left stale in this one.
            moved = m.draw_stamp != m.world_stamp
            m.draw_stamp = m.world_stamp
            b = batch_for(r, m)
            // Rebuilding four hundred matrices and re-uploading them is only
            // worth doing when the group is not what it was: a scene that has
            // not moved keeps the buffer it already sent.
            if b.count >= list.size(b.members) {
                list.add_raw(b.members, m as ptr)
                b.stale = true
            } else if list.get_raw(b.members, b.count) != m as ptr {
                list.set(b.members, b.count, m as ptr)
                b.stale = true
            }
            if moved { b.stale = true }
            b.count = b.count + 1
        } else {
            render_model(r, m, view_projection, light, cam, false)
        }
        i = i + 1
    }

    i = 0
    while i < r.batch_count {
        b = list.get_raw(r.batches, i) as *GLBatch
        if b.count != list.size(b.members) { b.stale = true }
        if b.stale { fill_batch(r, b) }
        if b.count == 1 {
            render_model(r, b.first as *Model, view_projection, light, cam, false)
        } else if b.count > 1 {
            draw_batch(r, b, view_projection, light, cam)
        }
        i = i + 1
    }
}

fill_batch(r: *GLRenderer, b: *GLBatch) {
    while list.size(b.members) > b.count { list.remove(b.members, list.size(b.members) - 1) }
    ae3d_inst_resize(b.instances, b.count)
    i = 0
    while i < b.count {
        m = list.get_raw(b.members, i) as *Model
        ae3d_inst_set_matrix(b.instances, i, &m.model_matrix)
        i = i + 1
    }
}

draw_batch(r: *GLRenderer, b: *GLBatch, view_projection: *Mat4, light: *Light, cam: *Camera) {
    slots = slots_for(r, r.default_program)
    use_program(r, r.default_program)
    if slots.frame_stamp != r.frame_stamp {
        set_frame_uniforms(r, slots, view_projection, light, r.lights, cam)
        slots.frame_stamp = r.frame_stamp
    }
    bind_shadow_map(r, slots)

    material = b.material as *Material
    apply_material(r, slots, material)
    apply_transparency(r, false)
    apply_texture(r, slots, texture_for(r, material))
    apply_normal_map(r, slots, normal_for(r, material))
    apply_instancing(r, slots, 1)
    ae3d_gl_uniform_int(slots.instance_points, 0)
    ae3d_gl_uniform_int(slots.instance_billboard, 0)
    apply_instance_color(r, slots, 0)

    // The shader reads the instanced transform as model * instanceModel, so the
    // group transform has to be identity: a batch's matrices are already the
    // world transforms of the models it merged.
    identity = core.mat4_ident()
    ae3d_gl_uniform_mat4(slots.model, &identity)
    // Its members stand still: last frame's matrix is this frame's.
    ae3d_gl_uniform_mat4(slots.prev_model, &identity)

    // A batch's members carry no settings of their own, so the program must not
    // still be holding the ones the model before them asked for.
    apply_shading(r, slots, null, r.default_program)

    ae3d_gl_vao_bind(b.vao)
    if b.stale {
        b.capacity_bytes = ae3d_gl_batch_upload(b.vao, ae3d_gl_geometry_instance_vbo(b.vao),
                                                b.instances, b.capacity_bytes)
        b.stale = false
    }
    ae3d_gl_draw_elements_instanced(core.mesh_index_count((b.first as *Model).mesh), 0, b.count)
    ae3d_gl_vao_bind(0)
    r.last_draw_calls = r.last_draw_calls + 1
}

// Whether the model has a surface to draw in this pass. A model split across
// materials can have opaque groups and transparent ones and so take part in
// both; a single-material model takes part in one. Asked before any per-model
// work so a model with nothing in this pass costs a pointer walk rather than a
// transform, a skin fit, a program bind and a set of uniforms it never draws.
model_in_pass(m: *Model, transparent_pass: bool) -> bool {
    groups = core.model_group_count(m)
    if groups > 0 {
        i = 0
        while i < groups {
            group = core.model_group(m, i)
            material = group_material(m, group)
            alpha = 1.0
            if material != null { alpha = material.alpha }
            if (alpha < 0.99) == transparent_pass { return true }
            i = i + 1
        }
        return false
    }
    alpha = 1.0
    if m.material != null { alpha = m.material.alpha }
    return (alpha < 0.99) == transparent_pass
}

// Whether any model draws through the water program: the one shader that
// reads the scene's depth.
wants_scene_depth(r: *GLRenderer) -> bool {
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible && core.shader_valid(&m.shader) && m.shader.kind == core.SHADER_WATER {
            return true
        }
        i = i + 1
    }
    return false
}

// The occlusion over the opaque scene: the depth just captured, read by a
// fullscreen draw that multiplies what is there by how much of the
// hemisphere over each pixel the depth says is filled. Before the
// transparent pass, so the water is not darkened by the ground it hides.
draw_occlusion(r: *GLRenderer, cam: *Camera) {
    if r.ssao_program == 0 || r.screen_vao == 0 { return }
    use_program(r, r.ssao_program)
    ae3d_gl_texture_bind(1, r.scene_depth)
    r.bound_texture = 0 - 1
    ae3d_gl_uniform_int(ae3d_gl_uniform_location(r.ssao_program, "depthTexture"), 1)
    ae3d_gl_uniform_int(ae3d_gl_uniform_location(r.ssao_program, "screenTexture"), 0)
    view_projection = core.camera_view_projection(cam)
    inverse = core.mat4_inverse(view_projection)
    ae3d_gl_uniform_mat4(ae3d_gl_uniform_location(r.ssao_program, "viewProjection"), &view_projection)
    ae3d_gl_uniform_mat4(ae3d_gl_uniform_location(r.ssao_program, "invViewProjection"), &inverse)
    ae3d_gl_uniform_vec3(ae3d_gl_uniform_location(r.ssao_program, "viewPos"),
                         cam.position.x, cam.position.y, cam.position.z)
    ae3d_gl_uniform_vec2(ae3d_gl_uniform_location(r.ssao_program, "screenSize"),
                         ae3d_gl_viewport_width() * 1.0, ae3d_gl_viewport_height() * 1.0)
    ae3d_gl_uniform_float(ae3d_gl_uniform_location(r.ssao_program, "ssaoRadius"), r.ssao_radius)
    ae3d_gl_uniform_float(ae3d_gl_uniform_location(r.ssao_program, "ssaoIntensity"), r.ssao_intensity)

    set_depth_test(r, false)
    ae3d_gl_set_depth_mask(0)
    set_wireframe(r, false)
    // AE3D_SSAO_SHOW=1 draws the occlusion itself in place of the scene,
    // for looking at what the pass found.
    if core.env_int("AE3D_SSAO_SHOW", 0) == 1 { ae3d_gl_set_blend(0) } else { ae3d_gl_set_blend_multiply() }
    ae3d_gl_vao_bind(r.screen_vao)
    ae3d_gl_draw_arrays(0, 6)
    ae3d_gl_vao_bind(0)
    r.last_draw_calls = r.last_draw_calls + 1

    // The ordinary blend back, whatever the cache says it was.
    ae3d_gl_set_blend(1)
    r.blend_state = true
    ae3d_gl_set_depth_mask(1)
    set_depth_test(r, core.depth_test())
    set_wireframe(r, core.debug_enabled())
}

// The scene's depth on texture unit 4 for a program that reads it, with
// what it needs to turn a stored depth back into a world position.
bind_scene_depth(r: *GLRenderer, slots: *ProgramSlots, cam: *Camera) {
    if slots.scene_depth < 0 { return }
    has = 0
    if r.scene_depth != 0 {
        ae3d_gl_texture_bind(4, r.scene_depth)
        has = 1
    }
    ae3d_gl_uniform_int(slots.scene_depth, 4)
    ae3d_gl_uniform_int(slots.has_scene_depth, has)
    ae3d_gl_uniform_vec2(slots.screen_size, ae3d_gl_viewport_width() * 1.0, ae3d_gl_viewport_height() * 1.0)
    inverse = core.mat4_inverse(core.camera_view_projection(cam))
    ae3d_gl_uniform_mat4(slots.inv_view_projection, &inverse)
}

render_model(r: *GLRenderer, m: *Model, view_projection: *Mat4,
             light: *Light, cam: *Camera, transparent_pass: bool) {
    if m == null || !m.visible { return }
    if !model_in_pass(m, transparent_pass) { return }

    core.model_sync_transform(m)
    // Before the cull, because a skinned mesh's own bounds are the bind pose's
    // and say nothing about where its bones have carried it.
    if m.skeleton != null { skin.skeleton_fit(m.skeleton as *Skeleton, m) }
    // An instanced model is never culled by its own bounds: they describe the
    // one base mesh at its origin, while its instances stand anywhere in the
    // world. Testing that one small sphere threw the whole crowd away the moment
    // the camera looked past its origin -- every zombie vanished on a zoom.
    // The instances cull themselves: the crowd bucket drops the fogged-out ones
    // and the GPU clips the rest.
    spread = m.is_instanced && core.model_instance_count(m) > 0
    if core.frustum_culling() && !spread &&
       !core.frustum_sphere_visible(r.frustum, m.bounding_center, m.bounding_radius) {
        return
    }

    program = r.default_program
    // A crowd -- a model carrying a pose bank -- draws through the crowd
    // program, which poses each instance from the bank at its own phase rather
    // than from the one shared bone uniform.
    is_crowd = core.model_pose_bank(m) != null
    if is_crowd {
        program = r.crowd_program
    } else if core.shader_valid(&m.shader) {
        if !m.shader.compiled {
            m.shader.program = compile_program(m.shader.vertex_source,
                                               m.shader.fragment_source, "model")
            m.shader.compiled = true
        }
        if m.shader.program != 0 { program = m.shader.program }
    }

    slots = slots_for(r, program)
    use_program(r, program)
    if slots.frame_stamp != r.frame_stamp {
        set_frame_uniforms(r, slots, view_projection, light, r.lights, cam)
        slots.frame_stamp = r.frame_stamp
    }
    bind_shadow_map(r, slots)
    bind_scene_depth(r, slots, cam)
    set_model_matrix(slots, m)
    apply_skeleton(r, slots, m)
    apply_shading(r, slots, m, program)
    if is_crowd { bind_pose_bank(r, slots, m) }

    ae3d_gl_vao_bind(m.vao)

    groups = core.model_group_count(m)
    if groups > 0 {
        i = 0
        while i < groups {
            group = core.model_group(m, i)
            material = group_material(m, group)
            alpha = 1.0
            if material != null { alpha = material.alpha }
            is_transparent = alpha < 0.99

            if is_transparent == transparent_pass {
                apply_material(r, slots, material)
                apply_transparency(r, is_transparent)
                apply_texture(r, slots, texture_for(r, material))
                apply_normal_map(r, slots, normal_for(r, material))
                draw(r, m, slots, group.index_count, group.index_start * 4)
            }
            i = i + 1
        }
    } else {
        alpha = 1.0
        if m.material != null { alpha = m.material.alpha }
        is_transparent = alpha < 0.99

        if is_transparent == transparent_pass {
            apply_material(r, slots, m.material)
            apply_transparency(r, is_transparent)
            apply_texture(r, slots, texture_for(r, m.material))
            apply_normal_map(r, slots, normal_for(r, m.material))
            draw(r, m, slots, core.mesh_index_count(m.mesh), 0)
        }
    }

    ae3d_gl_vao_bind(0)
}

texture_for(r: *GLRenderer, material: *Material) -> int {
    if material == null { return r.default_texture }
    if material.texture_stale { refresh_material_texture(r, material) }
    if material.texture_id != 0 { return material.texture_id }
    return r.default_texture
}

apply_transparency(r: *GLRenderer, transparent: bool) {
    set_blend(r, true)
    if transparent {
        ae3d_gl_set_depth_mask(0)
        set_face_culling(r, false)
    } else {
        ae3d_gl_set_depth_mask(1)
        set_face_culling(r, core.face_culling())
    }
}

draw(r: *GLRenderer, m: *Model, slots: *ProgramSlots, count: int, byte_offset: int) {
    if count <= 0 { return }
    // An instanced model with nothing active draws nothing. It used to fall
    // through to the plain branch and draw one raw copy of the mesh at the
    // origin -- unposed, untinted -- so a crowd tier that emptied left a
    // bind-pose ghost standing at (0,0,0) that appeared and vanished as the
    // tier filled and emptied.
    if m.is_instanced && core.model_instance_count(m) <= 0 { return }
    if m.is_instanced && core.model_instance_count(m) > 0 {
        if m.instances_updated {
            m.instance_vbo_capacity = ae3d_gl_update_instances(m.instances, m.instance_vbo,
                                                               m.instance_vbo_capacity)
            m.instances_updated = false
        }
        if m.instance_colors_updated {
            ae3d_gl_update_instance_colors(m.instances, m.instance_color_vbo)
            m.instance_colors_updated = false
        }
        if m.instance_phases_updated && m.instance_phase_vbo != 0 {
            ae3d_gl_update_instance_phases(m.instances, m.instance_phase_vbo)
            m.instance_phases_updated = false
        }
        apply_instancing(r, slots, 1)
        apply_points(slots, m)
        apply_instance_color(r, slots, 1)
        ae3d_gl_draw_elements_instanced(count, byte_offset, core.model_instance_count(m))
    } else {
        apply_instancing(r, slots, 0)
        ae3d_gl_draw_elements(count, byte_offset)
    }
    r.last_draw_calls = r.last_draw_calls + 1
}

// The camera and the light are the same for every model in a frame, and a
// uniform keeps its value until the program is relinked, so they are uploaded
// once per program per frame rather than once per model. Only the model matrix
// actually differs between draws.
set_frame_uniforms(r: *GLRenderer, slots: *ProgramSlots, view_projection: *Mat4,
                   light: *Light, lights: ptr, cam: *Camera) {
    ae3d_gl_uniform_mat4(slots.view_projection, view_projection)
    // Last frame's view, unjittered, and this frame's nudge: what every
    // scene shader writes its motion vector from.
    previous = core.camera_view_projection(cam)
    if r.prev_vp_valid { previous = r.prev_vp }
    ae3d_gl_uniform_mat4(slots.prev_view_projection, &previous)
    ae3d_gl_uniform_vec2(slots.jitter, r.jitter_x, r.jitter_y)
    ae3d_gl_uniform_vec2(slots.screen_size, r.post_width * 1.0, r.post_height * 1.0)
    ae3d_gl_uniform_float(slots.normal_strength, r.normal_strength)
    ae3d_gl_uniform_float(slots.occlusion_strength, r.occlusion_strength)
    ae3d_gl_uniform_int(slots.capture_channel, r.capture_channel)
    ae3d_gl_uniform_float(slots.wetness, r.wetness)

    upload_lights(slots, lights, light)

    ae3d_gl_uniform_vec3(slots.view_pos, cam.position.x, cam.position.y, cam.position.z)
    ae3d_gl_uniform_float(slots.view_distance, core.camera_far(cam))
    ae3d_gl_uniform_float(slots.caustics_time, r.scene_time)
    ae3d_gl_uniform_float(slots.cloud_cover, r.cloud_cover)
    ae3d_gl_uniform_float(slots.cloud_time, r.scene_time * r.cloud_wind)
    ae3d_gl_uniform_float(slots.sky_overcast, r.sky_overcast)
    ae3d_gl_uniform_vec3(slots.sky_overcast_color, r.sky_overcast_color.x, r.sky_overcast_color.y, r.sky_overcast_color.z)
    sun = key_light(lights, light)
    if sun != null {
        ae3d_gl_uniform_vec3(slots.cloud_sun, sun.direction.x, sun.direction.y, sun.direction.z)
    } else {
        ae3d_gl_uniform_vec3(slots.cloud_sun, 0.0, 1.0, 0.0)
    }

    enabled = 0
    if r.fog.enabled { enabled = 1 }
    ae3d_gl_uniform_int(slots.fog_enabled, enabled)
    ae3d_gl_uniform_float(slots.fog_start, r.fog.start)
    ae3d_gl_uniform_float(slots.fog_end, r.fog.end)
    ae3d_gl_uniform_vec3(slots.fog_color, r.fog.color.x, r.fog.color.y, r.fog.color.z)
    ae3d_gl_uniform_float(slots.fog_intensity, r.fog.intensity)
}

// Every light the scene holds, capped at what the shader declares.
//
// The key light goes in slot zero and the registered ones fill what is left.
// It is the one the scene is shadowed by and the one the ambient term comes
// from, so a program that named a key light and then registered a few lamps
// used to lose its key light entirely: the sun went out the moment a street
// lamp was added.
upload_lights(slots: *ProgramSlots, lights: ptr, key: *Light) {
    if slots.light_slots == null { return }
    slots_of = slots.light_slots as int[]

    count = 0
    if key != null {
        upload_light(slots_of, 0, key)
        count = 1
    }

    held = 0
    if lights != null { held = list.size(lights) }
    i = 0
    while i < held && count < MAX_LIGHTS {
        l = list.get_raw(lights, i) as *Light
        if l != key {
            upload_light(slots_of, count, l)
            count = count + 1
        }
        i = i + 1
    }
    ae3d_gl_uniform_int(slots.light_count, count)

    first = key_light(lights, key)
    if first != null {
        ae3d_gl_uniform_vec3(slots.compat_light_pos, first.position.x, first.position.y, first.position.z)
        ae3d_gl_uniform_vec3(slots.compat_light_color, first.color.x, first.color.y, first.color.z)
        ae3d_gl_uniform_float(slots.compat_light_intensity, first.intensity)
        ae3d_gl_uniform_vec3(slots.compat_light_direction, first.direction.x, first.direction.y, first.direction.z)
    }
}

// Whichever light the scene is shadowed and shaded by: the one the caller
// named, or the first it registered when it named none.
key_light(lights: ptr, key: *Light) -> *Light {
    if key != null { return key }
    if lights != null && list.size(lights) > 0 { return list.get_raw(lights, 0) as *Light }
    return null
}

upload_light(slots_of: int[], index: int, l: *Light) {
    if l == null { return }
    base = index * LIGHT_SLOTS
    ae3d_gl_uniform_vec3(slots_of[base], l.position.x, l.position.y, l.position.z)
    ae3d_gl_uniform_vec3(slots_of[base + 1], l.color.x, l.color.y, l.color.z)
    ae3d_gl_uniform_float(slots_of[base + 2], l.intensity)
    ae3d_gl_uniform_float(slots_of[base + 3], l.ambient_strength)
    ae3d_gl_uniform_float(slots_of[base + 4], l.temperature)

    directional = 0
    if l.mode == core.MODE_DIRECTIONAL { directional = 1 }
    ae3d_gl_uniform_int(slots_of[base + 5], directional)

    ae3d_gl_uniform_vec3(slots_of[base + 6], l.direction.x, l.direction.y, l.direction.z)
    ae3d_gl_uniform_float(slots_of[base + 7], l.constant_atten)
    ae3d_gl_uniform_float(slots_of[base + 8], l.linear_atten)
    ae3d_gl_uniform_float(slots_of[base + 9], l.quadratic_atten)
}

// Unit 1, because unit 0 is the material's own texture and changes per group.
// The active unit is put back to 0 afterwards: the framebuffer attachment
// helpers bind textures on whatever unit is active, so leaving it on 1 lets a
// resize quietly replace the shadow map with a post-processing target.
// Always says which of the two it is. Leaving the light-space matrix unset when
// there is no map left it at zero, and every fragment then divided its
// light-space position by a w of zero.
// The map outlives the setting: turning shadows off leaves the texture where it
// was, and a pass that only asked whether one exists went on sampling the last
// one drawn. Vulkan rewrites the binding to its white texture on the way off,
// so this is also what keeps the two backends showing the same scene.
bind_shadow_map(r: *GLRenderer, slots: *ProgramSlots) {
    if !r.shadow_enabled || r.shadow_map == 0 {
        ae3d_gl_uniform_int(slots.has_shadow_map, 0)
        return
    }
    ae3d_gl_uniform_int(slots.has_shadow_map, 1)
    // Turn the shadow term on with the map. The fragment shader gates it behind
    // enableShadows, and only the rendering.Config path and the water module
    // ever set that -- so an engine-API scene (its models made straight from
    // core) bound a shadow map the shader then ignored, and nothing cast a
    // shadow. Default it on, at a readable strength, whenever a real map is
    // bound; a model that wants no shadow still overrides these per draw.
    ae3d_gl_uniform_int(slots.enable_shadows, 1)
    ae3d_gl_uniform_float(slots.shadow_intensity, 0.32)
    ae3d_gl_uniform_float(slots.shadow_softness, 0.35)
    ae3d_gl_uniform_mat4(slots.light_space, &r.shadow_space)
    ae3d_gl_uniform_vec3(slots.shadow_direction, r.shadow_direction.x,
                         r.shadow_direction.y, r.shadow_direction.z)
    ae3d_gl_uniform_float(slots.shadow_texel_world, r.shadow_texel_world)
    ae3d_gl_texture_bind(1, r.shadow_map)
    ae3d_gl_uniform_int(slots.shadow_map, 1)
    // Leaves unit zero on the default texture, so the cache that decides
    // whether a model needs its own bound has to be told. Without this a model
    // whose texture matched the one before it kept the default instead: the
    // cache believed the texture was still there and skipped the bind.
    ae3d_gl_texture_bind(0, r.default_texture)
    r.bound_texture = r.default_texture
}

// CRITICAL: an instanced model's transform is already in every instance.
// model_set_instance_position fills each instance's matrix from the model's own
// scale and rotation, and the shader multiplies the model matrix by the
// instance's, so sending both applied the scale and the rotation twice: a model
// scaled 2.4 drew its instances at 5.76. The merged-batch path has always sent
// identity here for the same reason.
set_model_matrix(slots: *ProgramSlots, m: *Model) {
    sent = m.model_matrix
    if m.is_instanced && core.model_instance_count(m) > 0 {
        // Points carry a position and a scale only: the model's rotation
        // and scale reach the shader here, in the model matrix with its
        // translation taken out, and each point puts its own back.
        if ae3d_inst_is_points(m.instances) == 1 {
            sent = point_frame(m)
        } else {
            sent = core.mat4_ident()
        }
    }
    ae3d_gl_uniform_mat4(slots.model, &sent)
    // And last frame's, for the motion vectors.
    previous = core.model_prev_matrix(m, sent)
    ae3d_gl_uniform_mat4(slots.prev_model, &previous)
}

// A model's matrix without its translation: what a point instance is
// placed by, before the point's own position is put in the last column.
point_frame(m: *Model) -> Mat4 {
    frame = m.model_matrix
    frame.m12 = 0.0
    frame.m13 = 0.0
    frame.m14 = 0.0
    return frame
}

set_material_uniforms(slots: *ProgramSlots, material: *Material) {
    if material == null {
        ae3d_gl_uniform_vec3(slots.diffuse_color, 1.0, 1.0, 1.0)
        ae3d_gl_uniform_vec3(slots.specular_color, 1.0, 1.0, 1.0)
        ae3d_gl_uniform_float(slots.metallic, 0.0)
        ae3d_gl_uniform_float(slots.roughness, 0.5)
        ae3d_gl_uniform_float(slots.exposure, 1.0)
        ae3d_gl_uniform_float(slots.reflectivity, 0.0)
        ae3d_gl_uniform_float(slots.material_alpha, 1.0)
        return
    }
    ae3d_gl_uniform_vec3(slots.diffuse_color, material.diffuse.x, material.diffuse.y, material.diffuse.z)
    ae3d_gl_uniform_vec3(slots.specular_color, material.specular.x, material.specular.y, material.specular.z)
    ae3d_gl_uniform_float(slots.metallic, material.metallic)
    ae3d_gl_uniform_float(slots.roughness, material.roughness)
    ae3d_gl_uniform_float(slots.exposure, material.exposure)
    ae3d_gl_uniform_float(slots.reflectivity, material.reflectivity)
    ae3d_gl_uniform_float(slots.material_alpha, material.alpha)
}

// A mesh edited after the model was registered. The geometry cache hands the
// same buffers to every model built from identical vertices, so a model whose
// vertices have moved has to stop sharing before its new shape goes up, or it
// rewrites the geometry under everything else drawing the old one.
refresh_geometry(r: *GLRenderer, m: *Model) {
    if m.vao == 0 || ae3d_mesh_dirty(m.mesh) != 1 { return }

    if m.shares_geometry {
        ae3d_gl_geometry_release(m.vao)
        m.vao = ae3d_gl_vao_create()
        ae3d_gl_vao_bind(m.vao)
        m.vbo = ae3d_gl_buffer_create()
        m.ebo = ae3d_gl_buffer_create()
        ae3d_gl_upload_mesh(m.mesh, m.vbo, m.ebo)
        ae3d_gl_setup_vertex_attribs()
        m.shares_geometry = false
    } else {
        ae3d_gl_vao_bind(m.vao)
        ae3d_gl_upload_mesh(m.mesh, m.vbo, m.ebo)
    }
    ae3d_mesh_clear_dirty(m.mesh)
    core.model_recalculate_bounds(m)
}

// A draw has to shade with what its own model asked for and nothing else. The
// program keeps whatever the draw before it wrote, so before a model whose set
// of settings differs from what is loaded, the defaults go in first and wipe
// the difference. Models configured alike agree on the set, which is the common
// case and costs nothing.
apply_shading(r: *GLRenderer, slots: *ProgramSlots, m: *Model, program: int) {
    names = 0 as uint64
    if m != null { names = core.model_uniform_names(m) }
    if !slots.shading_loaded || slots.loaded_names != names {
        set_model_uniforms(r.defaults as *Model, program)
        slots.loaded_names = names
        slots.shading_loaded = true
    }
    if m != null { set_model_uniforms(m, program) }
}

set_model_uniforms(m: *Model, program: int) {
    count = core.model_uniform_count(m)
    i = 0
    while i < count {
        uniform = core.model_uniform(m, i)
        if uniform != null {
            if uniform.cached_program != program {
                uniform.location = ae3d_gl_uniform_location(program, uniform.name)
                if uniform.location < 0 {
                    indexed = string.concat(uniform.name, "[0]")
                    uniform.location = ae3d_gl_uniform_location(program, indexed)
                    string.free(indexed)
                }
                uniform.cached_program = program
            }
            if uniform.location >= 0 {
                if uniform.kind == core.UNIFORM_FLOAT {
                    ae3d_gl_uniform_float(uniform.location, uniform.number)
                } else if uniform.kind == core.UNIFORM_INT {
                    ae3d_gl_uniform_int(uniform.location, uniform.integer)
                } else if uniform.kind == core.UNIFORM_VEC3 {
                    ae3d_gl_uniform_vec3(uniform.location, uniform.vector.x,
                                         uniform.vector.y, uniform.vector.z)
                } else if uniform.kind == core.UNIFORM_FLOAT_ARRAY {
                    ae3d_gl_uniform_float_array(uniform.location, uniform.array)
                } else if uniform.kind == core.UNIFORM_VEC3_ARRAY {
                    ae3d_gl_uniform_vec3_array(uniform.location, uniform.array)
                }
            }
        }
        i = i + 1
    }
}

init_post_processing(r: *GLRenderer, width: int, height: int) {
    r.post_fbo = ae3d_gl_fbo_create()
    r.post_texture = ae3d_gl_fbo_attach_color(r.post_fbo, width, height, 0)
    r.post_velocity = ae3d_gl_fbo_attach_velocity(r.post_fbo, width, height)
    r.post_depth = ae3d_gl_fbo_attach_depth(r.post_fbo, width, height)
    if ae3d_gl_fbo_complete() != 1 {
        println("ae3d: post-processing framebuffer incomplete")
    }
    ae3d_gl_fbo_bind(0)

    // An effect otherwise runs over a frame with no antialiasing, since the
    // scene goes into this framebuffer rather than the multisampled default.
    r.post_width = width
    r.post_height = height
    r.post_samples = ae3d_gl_max_samples()
    if r.post_samples > 0 {
        r.post_ms_fbo = ae3d_gl_fbo_create()
        attach_multisample_post(r, width, height)
    }

    r.bloom_fbo = ae3d_gl_fbo_create()
    r.bloom_texture = ae3d_gl_fbo_attach_color(r.bloom_fbo, width / 4, height / 4, 1)
    if ae3d_gl_fbo_complete() != 1 {
        println("ae3d: bloom framebuffer incomplete")
    }
    ae3d_gl_fbo_bind(0)

    r.screen_mesh = core.mesh_create()
    core.mesh_push_screen_quad(r.screen_mesh)
    r.screen_vao = ae3d_gl_vao_create()
    ae3d_gl_vao_bind(r.screen_vao)
    r.screen_vbo = ae3d_gl_buffer_create()
    ae3d_gl_upload_mesh(r.screen_mesh, r.screen_vbo, 0)
    ae3d_gl_setup_vertex_attribs()
    ae3d_gl_vao_bind(0)

    if r.post_samples > 0 && !multisample_resolve_works(r) {
        println("ae3d: this driver does not resolve a multisampled framebuffer, effects will run without it")
        drop_multisample_post(r)
    }
}

// The size the scene is actually drawn at, which is the viewport times the
// render scale. Everything downstream of the scene pass -- the composite, the
// window -- stays at full size; only the pass that costs per pixel shrinks.
scaled_extent(r: *GLRenderer, value: int) -> int {
    out = (value * r.render_scale) as int
    if out < 1 { out = 1 }
    return out
}

resize_post_processing(r: *GLRenderer, width: int, height: int) {
    clamped_width = scaled_extent(r, width)
    clamped_height = scaled_extent(r, height)
    if clamped_width > MAX_FBO_DIMENSION { clamped_width = MAX_FBO_DIMENSION }
    if clamped_height > MAX_FBO_DIMENSION { clamped_height = MAX_FBO_DIMENSION }

    if r.post_texture != 0 { ae3d_gl_texture_delete(r.post_texture) }
    if r.post_velocity != 0 { ae3d_gl_texture_delete(r.post_velocity) }
    if r.post_depth != 0 { ae3d_gl_renderbuffer_delete(r.post_depth) }
    if r.bloom_texture != 0 { ae3d_gl_texture_delete(r.bloom_texture) }

    r.post_width = clamped_width
    r.post_height = clamped_height
    r.post_texture = ae3d_gl_fbo_attach_color(r.post_fbo, clamped_width, clamped_height, 0)
    r.post_velocity = ae3d_gl_fbo_attach_velocity(r.post_fbo, clamped_width, clamped_height)
    r.post_depth = ae3d_gl_fbo_attach_depth(r.post_fbo, clamped_width, clamped_height)
    ae3d_gl_fbo_bind(0)

    if r.post_ms_fbo != 0 {
        if r.post_ms_color != 0 { ae3d_gl_renderbuffer_delete(r.post_ms_color) }
        if r.post_ms_velocity != 0 { ae3d_gl_renderbuffer_delete(r.post_ms_velocity) }
        if r.post_ms_depth != 0 { ae3d_gl_renderbuffer_delete(r.post_ms_depth) }
        attach_multisample_post(r, clamped_width, clamped_height)
    }

    bloom_width = clamped_width / 4
    bloom_height = clamped_height / 4
    if bloom_width < 1 { bloom_width = 1 }
    if bloom_height < 1 { bloom_height = 1 }
    r.bloom_texture = ae3d_gl_fbo_attach_color(r.bloom_fbo, bloom_width, bloom_height, 1)
    ae3d_gl_fbo_bind(0)
    resize_taa(r, clamped_width, clamped_height)
}

// The temporal pass's two history textures at the post buffers' size,
// attached to the one framebuffer in turn as the pass runs. A resize
// empties the history.
resize_taa(r: *GLRenderer, width: int, height: int) {
    if r.taa_fbo == 0 { r.taa_fbo = ae3d_gl_fbo_create() }
    if r.taa_texture0 != 0 { ae3d_gl_texture_delete(r.taa_texture0) }
    if r.taa_texture1 != 0 { ae3d_gl_texture_delete(r.taa_texture1) }
    r.taa_texture0 = ae3d_gl_fbo_attach_color(r.taa_fbo, width, height, 0)
    r.taa_texture1 = ae3d_gl_fbo_attach_color(r.taa_fbo, width, height, 0)
    ae3d_gl_fbo_bind(0)
    r.taa_history_valid = false
    r.taa_current = 0
}

// The temporal pass: this frame (the post buffer) folded into the history
// by the scene's depth and the last frame's view-projection, into the
// other history texture, which the composite then reads and the next
// frame reads back. Returns the texture the composite should read.
draw_taa(r: *GLRenderer, cam: *Camera, view_projection: Mat4, unjittered: Mat4) -> int {
    if !r.enable_taa || r.taa_program == 0 || r.scene_depth == 0 { return r.post_texture }
    // Made the first time the pass runs, at the post buffers' size; a
    // resize of those remakes them.
    if r.taa_fbo == 0 || r.taa_texture0 == 0 || r.taa_texture1 == 0 { resize_taa(r, r.post_width, r.post_height) }
    if r.taa_fbo == 0 || r.taa_texture0 == 0 || r.taa_texture1 == 0 { return r.post_texture }
    into = r.taa_texture0
    history = r.taa_texture1
    if r.taa_current == 1 { into = r.taa_texture1 ; history = r.taa_texture0 }
    ae3d_gl_fbo_bind(r.taa_fbo)
    ae3d_gl_fbo_set_color(r.taa_fbo, into)
    ae3d_gl_viewport(0, 0, r.post_width, r.post_height)
    use_program(r, r.taa_program)
    ae3d_gl_texture_bind(0, r.post_texture)
    ae3d_gl_texture_bind(1, r.scene_depth)
    ae3d_gl_texture_bind(2, history)
    ae3d_gl_texture_bind(3, r.post_velocity)
    r.bound_texture = 0 - 1
    ae3d_gl_uniform_int(ae3d_gl_uniform_location(r.taa_program, "screenTexture"), 0)
    ae3d_gl_uniform_int(ae3d_gl_uniform_location(r.taa_program, "depthTexture"), 1)
    ae3d_gl_uniform_int(ae3d_gl_uniform_location(r.taa_program, "historyTexture"), 2)
    ae3d_gl_uniform_int(ae3d_gl_uniform_location(r.taa_program, "velocityTexture"), 3)
    ae3d_gl_uniform_vec2(ae3d_gl_uniform_location(r.taa_program, "screenSize"), r.post_width * 1.0, r.post_height * 1.0)
    blend = 1.0
    if r.taa_history_valid { blend = 0.1 }
    ae3d_gl_uniform_float(ae3d_gl_uniform_location(r.taa_program, "taaBlend"), blend)
    ae3d_gl_vao_bind(r.screen_vao)
    ae3d_gl_draw_arrays(0, 6)
    ae3d_gl_vao_bind(0)
    r.last_draw_calls = r.last_draw_calls + 1
    r.taa_history_valid = true
    r.taa_current = 1 - r.taa_current
    return into
}

begin_post_processing(r: *GLRenderer) -> bool {
    // A render scale below 1 is on its own a reason to draw into the offscreen
    // buffer, with or without an effect to run afterwards: resolve_post_processing
    // falls back to the passthrough program, so the composite becomes the upscale.
    if !r.enable_fxaa && !r.enable_bloom && !r.enable_taa && r.render_scale > 0.999 { return false }
    // A capture channel is the surfaces' own numbers: no effect over them.
    if r.capture_channel != 0 && r.render_scale > 0.999 { return false }
    if r.post_fbo == 0 || r.post_texture == 0 || r.screen_vao == 0 { return false }

    width = ae3d_gl_viewport_width()
    height = ae3d_gl_viewport_height()
    if width <= 0 || height <= 0 { return false }

    if width != r.viewport_width || height != r.viewport_height {
        r.viewport_width = width
        r.viewport_height = height
        resize_post_processing(r, width, height)
    }

    target_fbo = r.post_fbo
    if r.post_samples > 0 && r.post_ms_fbo != 0 { target_fbo = r.post_ms_fbo }
    ae3d_gl_fbo_bind(target_fbo)
    if ae3d_gl_fbo_complete() != 1 {
        bind_output(r)
        return false
    }
    // The scene writes its colour and its motion vectors.
    if r.post_velocity != 0 { ae3d_gl_draw_buffers(2) }
    // The scene is drawn at the buffer's size, which is the viewport's only when
    // the render scale is 1. resolve_post_processing puts the viewport back.
    ae3d_gl_viewport(0, 0, r.post_width, r.post_height)
    return true
}

// Some drivers accept a multisample resolve, report no error, and copy nothing.
// Asking once at startup, with a colour that cannot be confused for an empty
// buffer, is the only way to know: the alternative is a black frame every time
// an effect runs. A driver that cannot do it gets the effect chain without
// multisampling rather than nothing at all.
multisample_resolve_works(r: *GLRenderer) -> bool {
    if r.post_ms_fbo == 0 || r.post_fbo == 0 { return false }
    if r.screen_vao == 0 || r.passthrough_program == 0 { return false }

    // Drawn, not just cleared. A driver was found that resolves a buffer it
    // only had to clear and produces nothing from one that was drawn into,
    // which is the case that matters and the one that was coming out black.
    ae3d_gl_fbo_bind(r.post_ms_fbo)
    ae3d_gl_viewport(0, 0, r.post_width, r.post_height)
    ae3d_gl_clear_color(0.0, 0.0, 0.0, 1.0)
    ae3d_gl_clear(1, 1)
    set_depth_test(r, false)
    ae3d_gl_set_depth_mask(0)
    set_blend(r, false)
    use_program(r, r.passthrough_program)
    ae3d_gl_uniform_int(ae3d_gl_uniform_location(r.passthrough_program, "screenTexture"), 0)
    ae3d_gl_vao_bind(r.screen_vao)
    ae3d_gl_texture_bind(0, r.default_texture)
    r.bound_texture = r.default_texture
    ae3d_gl_draw_arrays(0, 6)
    ae3d_gl_vao_bind(0)

    refused = ae3d_gl_fbo_resolve(r.post_ms_fbo, r.post_fbo, r.post_width, r.post_height)
    ae3d_gl_fbo_bind(r.post_fbo)
    centre = ae3d_gl_read_pixel(r.post_width / 2, r.post_height / 2)
    ae3d_gl_fbo_bind(0)

    set_depth_test(r, true)
    ae3d_gl_set_depth_mask(1)
    set_blend(r, true)
    return refused == 0 && centre == 0xFFFFFF
}

drop_multisample_post(r: *GLRenderer) {
    if r.post_ms_color != 0 { ae3d_gl_renderbuffer_delete(r.post_ms_color) ; r.post_ms_color = 0 }
    if r.post_ms_velocity != 0 { ae3d_gl_renderbuffer_delete(r.post_ms_velocity) ; r.post_ms_velocity = 0 }
    if r.post_ms_depth != 0 { ae3d_gl_renderbuffer_delete(r.post_ms_depth) ; r.post_ms_depth = 0 }
    if r.post_ms_fbo != 0 { ae3d_gl_fbo_delete(r.post_ms_fbo) ; r.post_ms_fbo = 0 }
    r.post_samples = 0
}

attach_multisample_post(r: *GLRenderer, width: int, height: int) {
    r.post_ms_color = ae3d_gl_fbo_attach_color_multisample(r.post_ms_fbo, width, height,
                                                           r.post_samples)
    r.post_ms_velocity = ae3d_gl_fbo_attach_velocity_multisample(r.post_ms_fbo, width, height,
                                                                 r.post_samples)
    r.post_ms_depth = ae3d_gl_fbo_attach_depth_multisample(r.post_ms_fbo, width, height,
                                                           r.post_samples)
    if ae3d_gl_fbo_complete() != 1 {
        ae3d_gl_renderbuffer_delete(r.post_ms_color)
        ae3d_gl_renderbuffer_delete(r.post_ms_velocity)
        ae3d_gl_renderbuffer_delete(r.post_ms_depth)
        r.post_ms_color = 0
        r.post_ms_velocity = 0
        r.post_ms_depth = 0
        r.post_samples = 0
    }
    ae3d_gl_fbo_bind(0)
}

resolve_post_processing(r: *GLRenderer, cam: *Camera, view_projection: Mat4, unjittered: Mat4) {
    // The scene is drawn; the passes after it write the colour alone.
    if r.post_velocity != 0 { ae3d_gl_draw_buffers(1) }
    if r.post_samples > 0 && r.post_ms_fbo != 0 {
        // The size the buffers were made at, not whatever the viewport says.
        // A resolve of the wrong rectangle leaves the effect reading a frame
        // nothing was written into.
        refused = ae3d_gl_fbo_resolve(r.post_ms_fbo, r.post_fbo, r.post_width, r.post_height)
        if refused == 0 && r.post_ms_velocity != 0 {
            refused = ae3d_gl_fbo_resolve_attachment(r.post_ms_fbo, r.post_fbo, r.post_width, r.post_height, 1)
        }
        if refused != 0 && !r.post_resolve_reported {
            println("ae3d: the driver refused the multisample resolve (0x${refused}), effects will run without it")
            r.post_resolve_reported = true
            r.post_samples = 0
        }
    }
    set_depth_test(r, false)
    ae3d_gl_set_depth_mask(0)
    set_blend(r, false)
    set_wireframe(r, false)
    source = draw_taa(r, cam, view_projection, unjittered)
    bind_output(r)
    // Back to the full frame for the composite: the scene pass may have been
    // drawn smaller, and this is the step that puts it back on the window.
    ae3d_gl_viewport(0, 0, r.viewport_width, r.viewport_height)

    ae3d_gl_clear(1, 0)
    ae3d_gl_vao_bind(r.screen_vao)
    ae3d_gl_texture_bind(0, source)


    // A texel of the texture being sampled, which is the post buffer, not the
    // window. The two are the same size only at a render scale of 1.
    texel_x = 1.0 / (r.post_width * 1.0)
    texel_y = 1.0 / (r.post_height * 1.0)

    if r.enable_bloom && r.bloom_program != 0 {
        use_program(r, r.bloom_program)
        ae3d_gl_uniform_int(ae3d_gl_uniform_location(r.bloom_program, "screenTexture"), 0)
        ae3d_gl_uniform_vec2(ae3d_gl_uniform_location(r.bloom_program, "texelSize"), texel_x, texel_y)
        ae3d_gl_uniform_float(ae3d_gl_uniform_location(r.bloom_program, "bloomThreshold"), r.bloom_threshold)
        ae3d_gl_uniform_float(ae3d_gl_uniform_location(r.bloom_program, "bloomIntensity"), r.bloom_intensity)
    } else if r.enable_fxaa && r.fxaa_program != 0 {
        use_program(r, r.fxaa_program)
        ae3d_gl_uniform_int(ae3d_gl_uniform_location(r.fxaa_program, "screenTexture"), 0)
        ae3d_gl_uniform_vec2(ae3d_gl_uniform_location(r.fxaa_program, "texelSize"), texel_x, texel_y)
        ae3d_gl_uniform_float(ae3d_gl_uniform_location(r.fxaa_program, "edgeThreshold"), 0.125)
        ae3d_gl_uniform_float(ae3d_gl_uniform_location(r.fxaa_program, "edgeThresholdMin"), 0.0625)
        ae3d_gl_uniform_float(ae3d_gl_uniform_location(r.fxaa_program, "subpixelQuality"), 0.75)
    } else {
        use_program(r, r.passthrough_program)
        ae3d_gl_uniform_int(ae3d_gl_uniform_location(r.passthrough_program, "screenTexture"), 0)
    }

    ae3d_gl_draw_arrays(0, 6)
    ae3d_gl_vao_bind(0)

    set_depth_test(r, true)
    ae3d_gl_set_depth_mask(1)
    set_blend(r, true)
}

free_batches(batches: ptr) {
    if batches == null { return }
    i = 0
    while i < list.size(batches) {
        b = list.get_raw(batches, i) as *GLBatch
        if b != null {
            if b.instances != null { ae3d_inst_destroy(b.instances) }
            if b.members != null { list.free(b.members) }
            heap.free(b)
        }
        i = i + 1
    }
    list.free(batches)
}

renderer_cleanup(r: *GLRenderer) {
    if r == null { return }

    // The pass timer owns GL query objects, and deleting a GL object needs the
    // context that made it. This runs from engine_shutdown while the context is
    // still current; renderer_free runs later, after the window and its context
    // are gone, so a glDeleteQueries there dereferences a context that no longer
    // exists -- which a desktop driver shrugs off and llvmpipe segfaults on.
    if r.pass_timer != null {
        ae3d_gl_passtimer_destroy(r.pass_timer)
        r.pass_timer = null
    }
    // The clouds' textures, for the same reason.
    if r.cloud_shape_texture != 0 {
        ae3d_gl_texture_delete(r.cloud_shape_texture)
        r.cloud_shape_texture = 0
    }
    if r.cloud_weather_texture != 0 {
        ae3d_gl_texture_delete(r.cloud_weather_texture)
        r.cloud_weather_texture = 0
    }

    free_batches(r.batches)
    free_batches(r.shadow_batches)
    r.batches = null
    r.shadow_batches = null
    r.batch_count = 0
    r.shadow_batch_count = 0

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null {
            // Shared geometry belongs to the cache and is counted, so deleting
            // it here would take a vertex array other models are still drawing
            // from and leave the cache believing it still owns one.
            if m.shares_geometry {
                ae3d_gl_geometry_release(m.vao)
                m.vao = 0
                m.vbo = 0
                m.ebo = 0
                m.shares_geometry = false
            } else {
                if m.vao != 0 { ae3d_gl_vao_delete(m.vao) ; m.vao = 0 }
                if m.vbo != 0 { ae3d_gl_buffer_delete(m.vbo) ; m.vbo = 0 }
                if m.ebo != 0 { ae3d_gl_buffer_delete(m.ebo) ; m.ebo = 0 }
            }
            if m.instance_vbo != 0 { ae3d_gl_buffer_delete(m.instance_vbo) ; m.instance_vbo = 0 }
            if m.instance_color_vbo != 0 {
                ae3d_gl_buffer_delete(m.instance_color_vbo)
                m.instance_color_vbo = 0
            }
            if m.depth_proxy_vao != 0 { ae3d_gl_vao_delete(m.depth_proxy_vao) ; m.depth_proxy_vao = 0 }
        }
        i = i + 1
    }
    list.clear(r.models)

    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *TextureEntry
        if entry != null {
            ae3d_gl_texture_delete(entry.id)
            heap.free(entry)
        }
        i = i + 1
    }
    list.clear(r.textures)

    if r.skybox != null { skybox_free(r, r.skybox as *Skybox) ; r.skybox = null }
    if r.default_texture != 0 { ae3d_gl_texture_delete(r.default_texture) ; r.default_texture = 0 }
    if r.screen_vao != 0 { ae3d_gl_vao_delete(r.screen_vao) ; r.screen_vao = 0 }
    if r.screen_vbo != 0 { ae3d_gl_buffer_delete(r.screen_vbo) ; r.screen_vbo = 0 }
    if r.post_texture != 0 { ae3d_gl_texture_delete(r.post_texture) ; r.post_texture = 0 }
    if r.bloom_texture != 0 { ae3d_gl_texture_delete(r.bloom_texture) ; r.bloom_texture = 0 }
    if r.post_depth != 0 { ae3d_gl_renderbuffer_delete(r.post_depth) ; r.post_depth = 0 }
    if r.post_ms_color != 0 { ae3d_gl_renderbuffer_delete(r.post_ms_color) ; r.post_ms_color = 0 }
    if r.post_ms_velocity != 0 { ae3d_gl_renderbuffer_delete(r.post_ms_velocity) ; r.post_ms_velocity = 0 }
    if r.post_ms_depth != 0 { ae3d_gl_renderbuffer_delete(r.post_ms_depth) ; r.post_ms_depth = 0 }
    if r.post_ms_fbo != 0 { ae3d_gl_fbo_delete(r.post_ms_fbo) ; r.post_ms_fbo = 0 }
    if r.post_fbo != 0 { ae3d_gl_fbo_delete(r.post_fbo) ; r.post_fbo = 0 }
    if r.bloom_fbo != 0 { ae3d_gl_fbo_delete(r.bloom_fbo) ; r.bloom_fbo = 0 }
    if r.taa_texture0 != 0 { ae3d_gl_texture_delete(r.taa_texture0) ; r.taa_texture0 = 0 }
    if r.taa_texture1 != 0 { ae3d_gl_texture_delete(r.taa_texture1) ; r.taa_texture1 = 0 }
    if r.taa_fbo != 0 { ae3d_gl_fbo_delete(r.taa_fbo) ; r.taa_fbo = 0 }
    if r.taa_program != 0 { ae3d_gl_program_delete(r.taa_program) ; r.taa_program = 0 }
    if r.shadow_map != 0 { ae3d_gl_texture_delete(r.shadow_map) ; r.shadow_map = 0 }
    if r.shadow_fbo != 0 { ae3d_gl_fbo_delete(r.shadow_fbo) ; r.shadow_fbo = 0 }

    if r.default_program != 0 { ae3d_gl_program_delete(r.default_program) ; r.default_program = 0 }
    if r.shadow_program != 0 { ae3d_gl_program_delete(r.shadow_program) ; r.shadow_program = 0 }
    if r.crowd_shadow_program != 0 { ae3d_gl_program_delete(r.crowd_shadow_program) ; r.crowd_shadow_program = 0 }
    if r.fxaa_program != 0 { ae3d_gl_program_delete(r.fxaa_program) ; r.fxaa_program = 0 }
    if r.bloom_program != 0 { ae3d_gl_program_delete(r.bloom_program) ; r.bloom_program = 0 }
    if r.passthrough_program != 0 {
        ae3d_gl_program_delete(r.passthrough_program)
        r.passthrough_program = 0
    }

    r.initialized = false
}
