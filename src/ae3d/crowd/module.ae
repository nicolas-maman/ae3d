// ae3d crowd: baking a skinned figure's animation into a pose bank.
//
// A skinned draw is posed by one bone palette, set per draw. A crowd cannot be:
// a thousand zombies at a thousand points in the walk would be a thousand
// palettes, and a uniform holds one. So the walk is baked once, here, into a
// bank of `frames` poses -- each a full bone palette sampled at one time in the
// clip -- and every entity later picks a frame by its own phase and is posed
// from that slice. The bank is fixed at `frames` poses however large the crowd
// grows, which is what lets an animated crowd scale the way a static one does.
//
// This module owns the bake and the bank's storage; the instanced-skinned draw
// that samples it is the next phase (#271).

import std.heap
import ae3d.core
import ae3d.horde
import ae3d.anim
import ae3d.skin
import ae3d.ecs
import ae3d.posing

exports (
    posebank_bake, posebank_bake_in_place, posebank_free,
    posebank_frames, posebank_bones, posebank_get, posebank_data,
    posebank_travel, posebank_speed,
    horde_seek,
    CrowdGrid, grid_new, grid_free, horde_separate,
    crowd_wander, crowd_step, crowd_bucket, crowd_tiers, crowd_audit,
    device_crowd_new, device_crowd_free, device_crowd_bind, device_crowd_update, device_crowd_count,
    device_crowd_rays
)

extern ae3d_vk_crowd_create(capacity: int) -> int
extern ae3d_vk_crowd_destroy(handle: int)
extern ae3d_vk_crowd_count(handle: int, tier: int) -> int
extern ae3d_vk_pose_blas_create(mesh: ptr, bank: ptr, frames: int, bones: int) -> int
extern ae3d_vk_pose_blas_destroy(handle: int)
extern ae3d_vk_crowd_set_poses(handle: int, poses: int)
extern ae3d_vk_ray_indirect() -> int


// Bake `frames` evenly spaced poses across `duration` seconds of the clip the
// registry's players carry, into a bank the whole crowd will share. Each frame
// drives every bound player to its time, applies it to the bone, and snapshots
// the skeleton's palette -- the same path the engine poses the live figure by,
// so a baked pose is the pose the figure would strike at that instant. Returns
// null on a bad shape or an allocation failure.
posebank_bake(reg: *Registry, skel: *Skeleton, frames: int, duration: float) -> ptr {
    return posebank_bake_in_place(reg, skel, frames, 0.0, duration, 0 - 1)
}

// The same bake with the figure's travel taken out. A clip authored for a
// hero figure walks it somewhere -- the zombie's clip carries it two metres
// up the street, lunges it another, and walks on -- and that travel lives in
// the root bone. A crowd baked from it drifts: each instance's mesh walks
// off the position the simulation holds it at, metres by the end of the
// clip, and snaps back when the loop restarts. It reads as the whole horde
// teleporting, and no check on the simulated positions can see it, because
// they never moved. `root` names the bone that carries the travel; each
// frame its ground-plane displacement from where it was bound is subtracted
// from every bone, so the pose is struck in place and the crowd's motion is
// the simulation's alone. Height is kept -- the hips rising and falling over
// each step is the walk's weight, not its travel. `root < 0` bakes as is.
//
// `start` and `duration` pick the window of the clip to loop: a hero clip is
// a walk, a lunge and a recovery, and a crowd wants only the walk -- one
// gait cycle, which repeats without a seam -- or every zombie lunges in step
// every few seconds. The build declares the cycle as timeline markers; the
// scene reads them from the manifest and passes the window here.
posebank_bake_in_place(reg: *Registry, skel: *Skeleton, frames: int, start: float,
                       duration: float, root: int) -> ptr {
    if reg == null || skel == null || frames <= 0 { return null }
    bones = skin.skeleton_count(skel)
    if bones <= 0 { return null }

    bank = posing.posebank_create(frames, bones)
    if bank == null { return null }

    bound = core.vec3(0.0, 0.0, 0.0)
    if root >= 0 { bound = skin.skeleton_bind_position(skel, root) }

    // The root's path over the ground, as distance walked: summed frame to
    // frame so it does not care which way the clip was authored to face. One
    // sample past the last frame, at the clip's end, so the step from the last
    // pose back round to the first has a distance too.
    walked = 0.0
    last_x = 0.0
    last_z = 0.0
    k = 0
    while k <= frames {
        // The clip wraps, so the last pose lands just short of the loop point
        // rather than on the duplicate of the first: [0, duration).
        t = start
        if frames > 1 { t = start + (k as float) / (frames as float) * duration }

        n = anim.registry_count(reg)
        i = 0
        while i < n {
            b = anim.registry_binding(reg, i)
            if b != null {
                player = anim.binding_player(b)
                anim.player_set_time(player, t)
                anim.apply(player, anim.binding_model(b))
            }
            i = i + 1
        }

        if root >= 0 {
            hips = skin.skeleton_bone(skel, root)
            core.model_sync_transform(hips)
            travel = core.vec3(hips.model_matrix.m12 - bound.x, 0.0,
                               hips.model_matrix.m14 - bound.z)
            if k > 0 {
                dx = travel.x - last_x
                dz = travel.z - last_z
                walked = walked + core.sqrt_of(dx * dx + dz * dz)
            }
            last_x = travel.x
            last_z = travel.z
            posing.posebank_set_travel(bank, k, walked)
            if k < frames { skin.skeleton_update_shifted(skel, travel) }
        } else if k < frames {
            skin.skeleton_update(skel)
        }
        if k < frames { posing.posebank_capture(bank, k, skin.skeleton_palette(skel)) }
        k = k + 1
    }
    return bank
}

// How far the clip's root had walked by frame k of an in-place bake, and how
// fast it is walking at a phase of it. Zero for a bank baked as authored.
posebank_travel(bank: ptr, frame: int) -> float { return posing.posebank_travel(bank, frame) }
posebank_speed(bank: ptr, phase: float, duration: float) -> float {
    return posing.posebank_speed(bank, phase, duration)
}

posebank_free(bank: ptr) { posing.posebank_destroy(bank) }
posebank_frames(bank: ptr) -> int { return posing.posebank_frames(bank) }
posebank_bones(bank: ptr) -> int { return posing.posebank_bones(bank) }
posebank_get(bank: ptr, frame: int, bone: int, i: int) -> float {
    return posing.posebank_get(bank, frame, bone, i)
}
posebank_data(bank: ptr) -> ptr { return posing.posebank_data(bank) }

// A horde system: steer every live entity's velocity toward a target at a
// common speed, so the crowd flows the same way rather than each wandering off
// on its own -- the cohesion a horde reads as. One linear pass over the position
// and velocity columns, no per-entity dispatch and nothing across the language
// boundary. Pair it with ecs.integrate3 to move the crowd, and (later) a
// separation pass so they spread across the ground instead of collapsing onto
// the target. `arrive` is how close counts as arrived, so an entity on the
// target stops rather than jittering across it.
horde_seek(world: *EcsWorld, position: *Column, velocity: *Column,
           target: core.Vec3, speed: float, arrive: float) {
    slot = 0
    n = ecs.world_slot_count(world)
    while slot < n {
        if ecs.slot_alive(world, slot) {
            p = ecs.column_get3(position, slot)
            d = core.v3_sub(target, p)
            dist = core.v3_len(d)
            if dist > arrive {
                dir = core.v3_mul(d, speed / dist)
                ecs.column_set3(velocity, slot, dir)
            } else {
                ecs.column_set3(velocity, slot, core.vec3(0.0, 0.0, 0.0))
            }
        }
        slot = slot + 1
    }
}

// A uniform spatial grid over the XZ ground, so a horde's separation is O(N)
// rather than every zombie testing every other. `cols` x `cols` cells of
// `cell_size` from the corner (ox, oz), each holding up to `per_cell` entities.
// The grid's arrays and the whole separation pass are ae3d.horde's kernel;
// this is the handle the ECS side keeps.
struct CrowdGrid {
    native: ptr                    // *HordeGrid, ae3d.horde's
    cols: int
    cell_size: float
    ox: float
    oz: float
}

grid_new(cols: int, cell_size: float, ox: float, oz: float, per_cell: int) -> *CrowdGrid {
    if cols <= 0 || cell_size <= 0.0 || per_cell <= 0 { return null }
    g = heap.new(CrowdGrid)
    g.native = horde.grid_new(cols, per_cell) as ptr
    if g.native == null { heap.free(g); return null }
    g.cols = cols
    g.cell_size = cell_size
    g.ox = ox
    g.oz = oz
    return g
}

grid_free(g: *CrowdGrid) {
    if g == null { return }
    if g.native != null { horde.grid_free(g.native as *HordeGrid) }
    heap.free(g)
}

// A horde system: push apart entities closer than `radius`, so the crowd spreads
// across the ground under its target instead of collapsing onto one point. The
// grid is rebuilt from the current positions, then each entity is pushed off the
// neighbours in its own and the eight adjacent cells; `strength` scales the push
// added to the velocity. Pair after horde_seek and before ecs.integrate3.
//
// The whole pass is ae3d.horde's kernel, run straight over the position and
// velocity columns' own buffers -- the crowd is taken as the compact range
// [0, world_slot_count), which is a horde that only spawns.
horde_separate(world: *EcsWorld, position: *Column, velocity: *Column,
               g: *CrowdGrid, radius: float, strength: float) {
    if g == null { return }
    horde.separate(g.native as *HordeGrid, ecs.column_data(position), ecs.column_data(velocity),
                   ecs.world_slot_count(world), g.ox, g.oz, g.cell_size, radius, strength)
}

// The crowd's per-frame motion and its distance sort (ae3d.horde). These run over
// the ECS columns' own buffers (ecs.column_data) rather than the EcsWorld: the
// crowd is the compact range [0, n), a horde that only spawns.

// Point every zombie's velocity along its heading at `speed`, before the
// separation pass adds its shove.
crowd_wander(vel: ptr, yaw: ptr, n: int, speed: float) {
    horde.wander(vel, yaw, n, speed)
}

// Cap the speed, step, bounce off the street's edges (turning the heading so the
// crowd stays in the city), keep it on the road, face it along its heading, and
// advance its walk. Replaces the Aether motion loop.
crowd_step(pos: ptr, vel: ptr, yaw: ptr, phase: ptr, start: int, n: int, dt: float,
           max_speed: float, x0: float, x1: float, z0: float, z1: float,
           road_y: float, walk: float, bank: ptr) {
    horde.step(pos, vel, yaw, phase, start, n, dt, max_speed, x0, x1, z0, z1, road_y, walk, bank)
}

// Sort the crowd into the near and far draw buffers by distance to the camera,
// compacting each into its own run and dropping any zombie past `cull_dist`
// (beyond the fog, so invisible and not worth a draw; pass <= 0 to keep all).
// Returns the near count and writes the far count into far_out[0] -- with the
// cull, near + far no longer sum to n.
// `start` and `n` pick a run of the columns, so a crowd of two figures keeps
// each figure's zombies together and buckets each run into its own tiers.
crowd_bucket(pos: ptr, yaw: ptr, phase: ptr, col: ptr, start: int, n: int, cx: float, cz: float,
             near_dist: float, cull_dist: float, np: ptr, ny: ptr, nph: ptr, ncol: ptr,
             fp: ptr, fy: ptr, fph: ptr, fcol: ptr, far_out: ptr) -> int {
    return horde.bucket(pos, yaw, phase, col, start, n, cx, cz, near_dist, cull_dist,
                        np, ny, nph, ncol, fp, fy, fph, fcol, far_out)
}

// The crowd from `start`, `n` of them, sorted by distance to (cx, cz) into
// three compacted tiers in one pass -- near within near_dist, mid within
// mid_dist, far beyond, each its own position, yaw, phase and colour
// buffers -- with the figures past cull_dist (above zero) dropped. The
// three counts land in counts_out, three doubles. A mid_dist of zero
// leaves the far tier empty; a tier handed null buffers is counted and
// not written. Over the job pool, in the order one thread would write.
crowd_tiers(pos: ptr, yaw: ptr, phase: ptr, col: ptr, start: int, n: int, cx: float, cz: float,
            near_dist: float, mid_dist: float, cull_dist: float,
            np: ptr, ny: ptr, nph: ptr, ncol: ptr,
            mp: ptr, my: ptr, mph: ptr, mcol: ptr,
            fp: ptr, fy: ptr, fph: ptr, fcol: ptr, counts_out: ptr) {
    horde.tiers(pos, yaw, phase, col, start, n, cx, cz, near_dist, mid_dist, cull_dist,
                np, ny, nph, ncol, mp, my, mph, mcol, fp, fy, fph, fcol, counts_out)
}

// The crowd's steps audited against where it stood the frame before
// (`prev`, xyz doubles, which become this frame's positions): out takes
// eight doubles -- the largest step and which figure took it, how many
// stepped further than `limit`, the crowd's z extent, and the first three
// offenders (-1 for none). Over the job pool: a check that runs every
// frame is on the hot path however diagnostic it is.
crowd_audit(pos: ptr, prev: ptr, n: int, limit: float, out: ptr) {
    horde.audit(pos, prev, n, limit, out)
}

// The same sort on the device, for up to `capacity` figures: the CPU's
// part of a frame is then thirty-two bytes a figure converted into a
// mapped buffer, and the matrices, the sort, the compaction and the
// counts are the GPU's. Null when the backend has no compute (OpenGL,
// or Vulkan not up), and the caller keeps crowd_tiers. Bind each tier's
// model with device_crowd_bind, then each frame device_crowd_update says
// which figures and where the camera is; the renderer does the rest.
device_crowd_new(capacity: int) -> *DeviceCrowd {
    if capacity <= 0 { return null }
    handle = ae3d_vk_crowd_create(capacity)
    if handle == 0 { return null }
    dc = heap.new(DeviceCrowd)
    dc.handle = handle
    dc.capacity = capacity
    return dc
}

// How many figures the sort last put in `tier`: the count of the last
// frame the device finished, a frame or two behind. For a diagnostic.
device_crowd_count(dc: *DeviceCrowd, tier: int) -> int {
    if dc == null { return 0 }
    return ae3d_vk_crowd_count(dc.handle, tier)
}

device_crowd_free(dc: *DeviceCrowd) {
    if dc == null { return }
    if dc.poses != 0 { ae3d_vk_pose_blas_destroy(dc.poses) }
    if dc.handle != 0 { ae3d_vk_crowd_destroy(dc.handle) }
    heap.free(dc)
}

// The crowd in the ray-traced scene: `far` (the far tier's skinned model,
// a hundred and sixty-eight triangles) skinned at every frame of `bank`
// into a bottom-level structure each, and from then on the sort writes
// every figure's ray instance -- where it stands, facing as it walks,
// posed at the frame its walk is at -- so the horde shadows by ray with
// the rest of the scene, and leaves the shadow map. False where the
// device does not trace, and the map keeps the crowd.
device_crowd_rays(dc: *DeviceCrowd, far: *Model, bank: ptr) -> bool {
    if dc == null || far == null || bank == null { return false }
    if dc.poses != 0 { return true }
    // The figures are counted on the device as the sort keeps them; a
    // device that cannot build from its own count keeps the crowd in the map.
    if ae3d_vk_ray_indirect() != 1 { return false }
    frames = posing.posebank_frames(bank)
    bones = posing.posebank_bones(bank)
    dc.poses = ae3d_vk_pose_blas_create(core.model_mesh(far), posing.posebank_data(bank), frames, bones)
    if dc.poses == 0 { return false }
    ae3d_vk_crowd_set_poses(dc.handle, dc.poses)
    return true
}

// `m` draws tier `tier` (0 near, 1 mid, 2 far) of the crowd. Two models can
// share a tier -- a body and its clothes over the same figures.
device_crowd_bind(dc: *DeviceCrowd, m: *Model, tier: int) {
    core.model_set_device_crowd(m, dc, tier)
}

// This frame's crowd: `n` figures from `start` of the columns (xyz, yaw,
// phase, rgb doubles), the camera at (cx, cz) on the ground, the tiers'
// bands as crowd_tiers takes them. The sort runs when the frame is drawn.
device_crowd_update(dc: *DeviceCrowd, pos: ptr, yaw: ptr, phase: ptr, col: ptr, start: int, n: int,
                    cx: float, cz: float, near_dist: float, mid_dist: float, cull_dist: float) {
    if dc == null { return }
    dc.pos = pos
    dc.yaw = yaw
    dc.phase = phase
    dc.col = col
    dc.start = start
    dc.count = n
    if dc.count > dc.capacity { dc.count = dc.capacity }
    dc.cx = cx
    dc.cz = cz
    dc.near_dist = near_dist
    dc.mid_dist = mid_dist
    dc.cull_dist = cull_dist
}
