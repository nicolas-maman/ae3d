// Scripts you can assign to an object.
//
// A script is an ordinary Aether source file with Unity's phases in it, by
// Unity's names and with the engine's signatures -- the same functions a
// program hands to engine.script:
//
//     start(state: ptr, go: *GameObject)                 once, when it is attached
//     update(state: ptr, go: *GameObject, delta: float)  every frame
//
// It is compiled into a shared library and opened at runtime, so attaching one
// is a matter of remembering which library answers for which object. That is
// how a MonoBehaviour works in Unity and a script in Godot, and what
// gopher3D's script manager was reaching for. The editor hands a null state
// (a script keeps its own in its globals) and the game object the script
// is attached to; the model is behaviour.object_model(go).
//
// CRITICAL: a script is compiled from the same sources as the host and reaches
// back into it for the runtime, so the two agree about what a Model is only
// while they are built from the same tree. Build scripts with the binary that
// will run them.

import std.list
import std.heap
import std.string
import std.os
import std.dl
import ae3d.core
import ae3d.behaviour

exports (
    Script,
    script_open, script_close, script_start, script_update,
    script_path, script_has_start, library_path, last_error
)

// A loaded script: its library, and its phases resolved once, called
// through their C signatures (the script's state, the game object it is
// on, and for update the frame).
struct Script {
    handle: ptr
    start: ptr                     // the library's start, or null: a script that only moves something has no setup
    update: ptr                    // its update, what makes a library a script
    path: string
}

var g_error = ""

last_error() -> string { return g_error }

// What a loadable library is called on this platform: knowing which
// belongs here rather than in every caller that wants to open one.
library_suffix() -> string {
    platform = os.platform()
    if platform == "windows" { return ".dll" }
    if platform == "darwin" { return ".dylib" }
    return ".so"
}

// Where the library for a named script lives.
library_path(directory: string, name: string) -> string {
    tail = string.concat(name, library_suffix())
    path = string.concat(directory, tail)
    string.free(tail)
    return path
}

// Open a compiled script. Answers null and says why rather than half a script:
// a library with no update in it is a file that is not a script, and a
// caller that gets one back would call into nothing every frame.
script_open(path: string) -> *Script {
    g_error = ""
    if path == "" {
        g_error = "no script path"
        return null
    }
    handle = dl.open_raw(path)
    if handle == null {
        reason = dl.last_error_raw()
        if reason == "" { reason = "the library would not load" }
        g_error = "${path}: ${reason}"
        return null
    }
    update = dl.symbol_raw(handle, "update")
    if update == null {
        dl.close_raw(handle)
        g_error = "${path}: no update in it"
        return null
    }
    s = heap.new(Script)
    s.handle = handle
    s.update = update
    s.start = dl.symbol_raw(handle, "start")
    s.path = path
    return s
}

// CRITICAL: the path is not freed here. A struct owns its string fields and
// heap.free releases them, so freeing it as well is a double free, and this
// aborted on the first script it closed. See docs/writing-aether.md.
script_close(s: *Script) {
    if s == null { return }
    if s.handle != null { dl.close_raw(s.handle) }
    heap.free(s)
}

script_path(s: *Script) -> string {
    if s == null { return "" }
    return s.path
}

// Whether it has anything to do when it is attached. A script that only moves
// something has no setup, and calling a function it does not have would be a
// crash rather than a no-op.
script_has_start(s: *Script) -> bool {
    if s == null { return false }
    return s.start != null
}

script_start(s: *Script, state: ptr, go: *GameObject) {
    if s == null || go == null || s.start == null { return }
    start = s.start as fn(ptr, ptr) -> void
    start(state, go as ptr)
}

script_update(s: *Script, state: ptr, go: *GameObject, delta: float) {
    if s == null || go == null || s.update == null { return }
    update = s.update as fn(ptr, ptr, float) -> void
    update(state, go as ptr, delta)
}
