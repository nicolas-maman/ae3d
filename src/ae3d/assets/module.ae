// The engine end of the Blender pipeline: manifests, exported clips and the
// identity that ties a model in a scene back to the object it came from.
//
// The two halves are a file format apart rather than a shared library,
// because Blender's Python and ae3d's Aether cannot link.

import std.heap
import std.list
import std.string
import std.json
import std.fs
import ae3d.core
import ae3d.anim
import ae3d.loader

exports (
    Entry, Manifest,
    manifest_load, manifest_free, manifest_count, manifest_entry, manifest_find, manifest_find_by_object, manifest_source, manifest_blender,
    manifest_warning_count, manifest_marker, manifest_marker_count, Marker,
    entry_id, entry_material, entry_animation,
    entry_vertices, entry_triangles,
    entry_load_model, entry_load_clip, entry_parent, entry_object, manifest_load_scene,
    entry_load_skeleton, entry_load_bone_clips,
    entry_skeleton, entry_skin,
    clip_load, clip_reference_error, last_error,
    Provenance, provenance_record, provenance_for, provenance_by_id,
    provenance_by_object, provenance_model,
    provenance_id, provenance_object, provenance_source, provenance_mesh_file,
    provenance_animation_file, provenance_expected_vertices,
    provenance_expected_triangles, provenance_forget, provenance_release
)

struct Entry {
    id: string
    object: string
    parent: string
    mesh: string
    material: string
    animation: string
    skeleton: string
    skin: string
    bone_animation: string
    occlusion: string
    vertices: int
    triangles: int
    position: Vec3
    rotation: Quat
    scale: Vec3
}

struct Warning {
    text: string
}

// A timeline marker the Blender build placed: a name and a time in clip
// seconds. What the builder had to say about the animation's structure --
// where a loop begins and ends -- which a scene asks for by name instead
// of knowing.
struct Marker {
    name: string
    time: float
}

struct Manifest {
    directory: string
    source: string
    blender: string
    entries: ptr
    warnings: ptr
    markers: ptr
}

var g_error = ""
var g_error_owned = false

last_error() -> string { return g_error }

set_error(reason: string, detail: string) {
    if g_error_owned { string.free(g_error) }
    g_error = string.concat(reason, detail)
    g_error_owned = true
}

read_json(path: string) -> ptr {
    text, err = fs.read(path)
    if err != "" {
        set_error("cannot read ", path)
        string.free(text)
        return null
    }
    root = json.parse_raw(text)
    string.free(text)
    if root == null { set_error("cannot parse ", path) }
    return root
}

text_field(node: ptr, name: string) -> string {
    if node == null { return "" }
    found = json.object_get_raw(node, name)
    if found == null { return "" }
    return string.copy(json.get_string_raw(found))
}

int_field(node: ptr, name: string, fallback: int) -> int {
    if node == null { return fallback }
    found = json.object_get_raw(node, name)
    if found == null { return fallback }
    return json.get_int(found)
}

directory_of(path: string) -> string {
    cut = 0 - 1
    i = 0
    length = string.length(path)
    while i < length {
        c = string.char_at(path, i)
        if c == 47 || c == 92 { cut = i }
        i = i + 1
    }
    if cut < 0 { return "" }
    return string.substring(path, 0, cut + 1)
}

join(directory: string, name: string) -> string {
    if directory == "" { return string.copy(name) }
    return string.concat(directory, name)
}

manifest_load(path: string) -> *Manifest {
    root = read_json(path)
    if root == null { return null }

    m = heap.new(Manifest)
    m.directory = directory_of(path)
    m.entries = list.new()
    m.warnings = list.new()
    m.markers = list.new()
    m.blender = text_field(root, "blender")
    m.source = ""

    source = json.object_get_raw(root, "source")
    if source != null { m.source = text_field(source, "name") }

    scene = json.object_get_raw(root, "scene")
    if scene != null {
        markers = json.object_get_raw(scene, "markers")
        if markers != null {
            i = 0
            count = json.object_size(markers)
            while i < count {
                key, value, err = json.object_entry(markers, i)
                if err == "" && value != null {
                    mk = heap.new(Marker)
                    mk.name = key
                    mk.time = json.get_number(value)
                    list.add_raw(m.markers, mk as ptr)
                } else {
                    string.free(key)
                }
                string.free(err)
                i = i + 1
            }
        }
    }

    warnings = json.object_get_raw(root, "warnings")
    if warnings != null {
        i = 0
        count = json.array_size(warnings)
        while i < count {
            w = heap.new(Warning)
            w.text = string.copy(json.get_string_raw(json.array_get_raw(warnings, i)))
            list.add_raw(m.warnings, w as ptr)
            i = i + 1
        }
    }

    objects = json.object_get_raw(root, "objects")
    if objects != null {
        i = 0
        count = json.array_size(objects)
        while i < count {
            node = json.array_get_raw(objects, i)
            e = heap.new(Entry)
            e.id = text_field(node, "id")
            e.object = text_field(node, "object")
            e.vertices = int_field(node, "vertices", 0)
            e.triangles = int_field(node, "triangles", 0)
            e.parent = text_field(node, "parent")
            e.mesh = ""
            e.material = ""
            e.animation = ""
            e.skeleton = ""
            e.skin = ""
            e.bone_animation = ""
            e.occlusion = ""
            e.position = core.vec3(0.0, 0.0, 0.0)
            e.rotation = core.quat_ident()
            e.scale = core.vec3(1.0, 1.0, 1.0)
            transform = json.object_get_raw(node, "transform")
            if transform != null {
                location = json.object_get_raw(transform, "location")
                rotation = json.object_get_raw(transform, "rotation")
                scale = json.object_get_raw(transform, "scale")
                if location != null {
                    e.position = core.vec3(component(location, 0), component(location, 1),
                                           component(location, 2))
                }
                if rotation != null {
                    e.rotation = core.quat(component(rotation, 0), component(rotation, 1),
                                           component(rotation, 2), component(rotation, 3))
                }
                if scale != null {
                    e.scale = core.vec3(component(scale, 0), component(scale, 1),
                                        component(scale, 2))
                }
            }
            files = json.object_get_raw(node, "files")
            if files != null {
                e.mesh = text_field(files, "mesh")
                e.material = text_field(files, "material")
                e.animation = text_field(files, "animation")
                e.skeleton = text_field(files, "skeleton")
                e.skin = text_field(files, "skin")
                e.bone_animation = text_field(files, "bone_animation")
                e.occlusion = text_field(files, "occlusion")
            }
            list.add_raw(m.entries, e as ptr)
            i = i + 1
        }
    }

    json.free(root)
    return m
}

manifest_free(m: *Manifest) {
    if m == null { return }
    if m.entries != null {
        i = 0
        count = list.size(m.entries)
        while i < count {
            e = list.get_raw(m.entries, i) as *Entry
            if e != null { heap.free(e) }
            i = i + 1
        }
        list.free(m.entries)
    }
    if m.warnings != null {
        i = 0
        count = list.size(m.warnings)
        while i < count {
            w = list.get_raw(m.warnings, i) as *Warning
            if w != null { heap.free(w) }
            i = i + 1
        }
        list.free(m.warnings)
    }
    if m.markers != null {
        i = 0
        count = list.size(m.markers)
        while i < count {
            mk = list.get_raw(m.markers, i) as *Marker
            if mk != null {
                string.free(mk.name)
                heap.free(mk)
            }
            i = i + 1
        }
        list.free(m.markers)
    }
    heap.free(m)
}

// The time of a named timeline marker, in clip seconds, or `fallback` when
// the build placed none by that name -- so a scene can ask for "gait_end"
// and take the whole clip if the builder had nothing to say.
manifest_marker(m: *Manifest, name: string, fallback: float) -> float {
    if m == null || m.markers == null { return fallback }
    i = 0
    count = list.size(m.markers)
    while i < count {
        mk = list.get_raw(m.markers, i) as *Marker
        if mk != null && mk.name == name { return mk.time }
        i = i + 1
    }
    return fallback
}

manifest_marker_count(m: *Manifest) -> int {
    if m == null || m.markers == null { return 0 }
    return list.size(m.markers)
}

manifest_entry(m: *Manifest, index: int) -> *Entry {
    if m == null { return null }
    if index < 0 || index >= list.size(m.entries) { return null }
    return list.get_raw(m.entries, index) as *Entry
}

manifest_count(m: *Manifest) -> int {
    if m == null { return 0 }
    return list.size(m.entries)
}


manifest_find(m: *Manifest, id: string) -> *Entry {
    if m == null { return null }
    i = 0
    count = list.size(m.entries)
    while i < count {
        e = list.get_raw(m.entries, i) as *Entry
        if e != null && e.id == id { return e }
        i = i + 1
    }
    return null
}

manifest_find_by_object(m: *Manifest, name: string) -> *Entry {
    if m == null { return null }
    i = 0
    count = list.size(m.entries)
    while i < count {
        e = list.get_raw(m.entries, i) as *Entry
        if e != null && e.object == name { return e }
        i = i + 1
    }
    return null
}

manifest_source(m: *Manifest) -> string {
    if m == null { return "" }
    return m.source
}

manifest_blender(m: *Manifest) -> string {
    if m == null { return "" }
    return m.blender
}

manifest_warning_count(m: *Manifest) -> int {
    if m == null { return 0 }
    return list.size(m.warnings)
}


entry_id(e: *Entry) -> string {
    if e == null { return "" }
    return e.id
}

// The name the object had in Blender, which is what a person or an agent will
// call it: the id is a hash, and nobody types a hash.
entry_skeleton(e: *Entry) -> string {
    if e == null { return "" }
    return e.skeleton
}

entry_skin(e: *Entry) -> string {
    if e == null { return "" }
    return e.skin
}

entry_object(e: *Entry) -> string {
    if e == null { return "" }
    return e.object
}



entry_material(e: *Entry) -> string {
    if e == null { return "" }
    return e.material
}

entry_animation(e: *Entry) -> string {
    if e == null { return "" }
    return e.animation
}

entry_vertices(e: *Entry) -> int {
    if e == null { return 0 }
    return e.vertices
}

entry_triangles(e: *Entry) -> int {
    if e == null { return 0 }
    return e.triangles
}

entry_load_model(m: *Manifest, e: *Entry) -> *Model {
    if m == null || e == null || e.mesh == "" {
        set_error("no mesh named for ", "that entry")
        return null
    }
    skin = read_skin_rows(m, e)
    occlusion = read_occlusion(m, e)
    path = join(m.directory, e.mesh)
    model = loader.load_obj_baked(path, false, skin, occlusion)
    string.free(path)
    if skin != null { core.skinrows_destroy(skin) }
    if occlusion != null { core.farr_destroy(occlusion) }
    if model == null {
        set_error("cannot load ", e.mesh)
        return null
    }
    core.model_set_name(model, e.object)
    // The mesh is written in its own space, so this is where the object stops
    // being a shape and becomes a thing standing somewhere.
    core.model_set_position(model, e.position.x, e.position.y, e.position.z)
    core.model_set_rotation(model, e.rotation)
    core.model_set_scale(model, e.scale.x, e.scale.y, e.scale.z)
    provenance_record(model, e.id, e.object, m.source, e.mesh, e.animation,
                      e.vertices, e.triangles)
    return model
}

// The weights the exporter wrote, one row per OBJ position. They are handed to
// the loader rather than written onto a finished mesh: a position becomes as
// many vertices as it has distinct normals and UVs, and which those are is
// something only the load knows.
read_skin_rows(m: *Manifest, e: *Entry) -> ptr {
    if m == null || e == null || e.skin == "" { return null }
    path = join(m.directory, e.skin)
    root = read_json(path)
    string.free(path)
    if root == null {
        set_error("cannot read ", e.skin)
        return null
    }
    node = json.object_get_raw(root, "vertices")
    if node == null {
        json.free(root)
        set_error("no vertices in ", e.skin)
        return null
    }
    count = json.array_size(node)
    rows = core.skinrows_create(count)
    i = 0
    while i < count {
        row = json.array_get_raw(node, i)
        joints = json.object_get_raw(row, "joints")
        weights = json.object_get_raw(row, "weights")
        core.skinrows_set(rows, i,
                          component(joints, 0) as int, component(joints, 1) as int,
                          component(joints, 2) as int, component(joints, 3) as int,
                          component(weights, 0), component(weights, 1),
                          component(weights, 2), component(weights, 3))
        i = i + 1
    }
    json.free(root)
    return rows
}

// How much of the sky each position can see, baked against the whole scene.
// One number a position, handed to the loader for the same reason the weights
// are: a position becomes as many vertices as it has distinct normals and UVs.
read_occlusion(m: *Manifest, e: *Entry) -> ptr {
    if m == null || e == null || e.occlusion == "" { return null }
    path = join(m.directory, e.occlusion)
    root = read_json(path)
    string.free(path)
    if root == null {
        set_error("cannot read ", e.occlusion)
        return null
    }
    node = json.object_get_raw(root, "occlusion")
    if node == null {
        json.free(root)
        set_error("no occlusion in ", e.occlusion)
        return null
    }
    count = json.array_size(node)
    values = core.farr_create(count)
    i = 0
    while i < count {
        core.farr_set(values, i, json.get_number(json.array_get_raw(node, i)))
        i = i + 1
    }
    json.free(root)
    return values
}

// The skeleton the mesh is weighted to: a model per bone, parented as Blender
// had them and placed where the rest pose put them. They are models because
// that is all a bone is here, so a clip drives one and ae3d.ik solves a limb of
// them without knowing they belong to a skin.
//
// Answers the bones in the order the weights index them, for the caller to
// keep: they are the skeleton's to name and nobody's to own.
entry_load_skeleton(m: *Manifest, e: *Entry) -> ptr {
    if m == null || e == null || e.skeleton == "" { return null }
    path = join(m.directory, e.skeleton)
    root = read_json(path)
    string.free(path)
    if root == null {
        set_error("cannot read ", e.skeleton)
        return null
    }
    nodes = json.object_get_raw(root, "bones")
    if nodes == null {
        json.free(root)
        set_error("no bones in ", e.skeleton)
        return null
    }
    bones = list.new()
    count = json.array_size(nodes)
    i = 0
    while i < count {
        node = json.array_get_raw(nodes, i)
        bone = core.model_new()
        core.model_set_name(bone, text_field(node, "name"))
        transform = json.object_get_raw(node, "transform")
        if transform != null {
            location = json.object_get_raw(transform, "location")
            rotation = json.object_get_raw(transform, "rotation")
            scale = json.object_get_raw(transform, "scale")
            core.model_set_position(bone, component(location, 0), component(location, 1),
                                    component(location, 2))
            core.model_set_rotation(bone, core.quat(component(rotation, 0),
                                                    component(rotation, 1),
                                                    component(rotation, 2),
                                                    component(rotation, 3)))
            core.model_set_scale(bone, component(scale, 0), component(scale, 1),
                                 component(scale, 2))
        }
        list.add_raw(bones, bone as ptr)
        i = i + 1
    }
    // Parents after, since the file lists parents first but nothing here
    // depends on that being true.
    i = 0
    while i < count {
        parent_name = text_field(json.array_get_raw(nodes, i), "parent")
        if parent_name != "" {
            j = 0
            while j < count {
                if text_field(json.array_get_raw(nodes, j), "name") == parent_name {
                    core.model_set_parent(list.get_raw(bones, i) as *Model,
                                          list.get_raw(bones, j) as *Model)
                    j = count
                } else {
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    json.free(root)
    return bones
}

// One clip per animated bone, in the order the file lists them. Each is named
// after the bone it drives, so a caller binds them to the models
// entry_load_skeleton answered with by matching names.
entry_load_bone_clips(m: *Manifest, e: *Entry) -> ptr {
    if m == null || e == null || e.bone_animation == "" { return null }
    path = join(m.directory, e.bone_animation)
    root = read_json(path)
    string.free(path)
    if root == null {
        set_error("cannot read ", e.bone_animation)
        return null
    }
    nodes = json.object_get_raw(root, "clips")
    if nodes == null {
        json.free(root)
        set_error("no clips in ", e.bone_animation)
        return null
    }
    clips = list.new()
    count = json.array_size(nodes)
    i = 0
    while i < count {
        clip = clip_from(json.array_get_raw(nodes, i))
        if clip != null { list.add_raw(clips, clip as ptr) }
        i = i + 1
    }
    json.free(root)
    return clips
}

entry_parent(e: *Entry) -> string {
    if e == null { return "" }
    return e.parent
}

// Every object in the manifest, loaded, placed, and hung off whatever it was
// hung off in Blender. The answer is in manifest order, so the caller can walk
// the entries and the models together to bind the clips.
//
// Parenting is a second pass because a child can be named before its parent
// is: the manifest is sorted by object name, not by depth.
manifest_load_scene(m: *Manifest) -> ptr {
    models = list.new()
    if m == null { return models }

    count = list.size(m.entries)
    i = 0
    while i < count {
        e = list.get_raw(m.entries, i) as *Entry
        list.add_raw(models, entry_load_model(m, e) as ptr)
        i = i + 1
    }

    i = 0
    while i < count {
        e = list.get_raw(m.entries, i) as *Entry
        model = list.get_raw(models, i) as *Model
        if model != null && e.parent != "" {
            parent = find_model(m, models, e.parent)
            if parent == null {
                set_error("no parent called ", e.parent)
            } else {
                core.model_set_parent(model, parent)
            }
        }
        i = i + 1
    }
    return models
}

find_model(m: *Manifest, models: ptr, name: string) -> *Model {
    count = list.size(m.entries)
    i = 0
    while i < count {
        e = list.get_raw(m.entries, i) as *Entry
        if e.object == name { return list.get_raw(models, i) as *Model }
        i = i + 1
    }
    return null
}

entry_load_clip(m: *Manifest, e: *Entry) -> *Clip {
    if m == null || e == null || e.animation == "" { return null }
    path = join(m.directory, e.animation)
    clip = clip_load(path)
    string.free(path)
    return clip
}

target_of(name: string) -> int {
    if name == "rotation" { return anim.ROTATION }
    if name == "scale" { return anim.SCALE }
    return anim.TRANSLATION
}

interpolation_of(name: string) -> int {
    if name == "STEP" { return anim.STEP }
    if name == "CUBIC" { return anim.CUBIC }
    return anim.LINEAR
}

component(values: ptr, index: int) -> float {
    if values == null { return 0.0 }
    if index >= json.array_size(values) { return 0.0 }
    return json.get_number(json.array_get_raw(values, index))
}

clip_load(path: string) -> *Clip {
    root = read_json(path)
    if root == null { return null }

    clips = json.object_get_raw(root, "clips")
    if clips == null || json.array_size(clips) == 0 {
        set_error("no clips in ", path)
        json.free(root)
        return null
    }

    clip = clip_from(json.array_get_raw(clips, 0))
    json.free(root)
    return clip
}

// One clip out of one node of a clips array. Object animation carries a single
// clip per file and a skinned mesh carries one per bone, which is the same node
// read the same way.
clip_from(node: ptr) -> *Clip {
    if node == null { return null }
    name = text_field(node, "name")
    clip = anim.clip_new(name)
    string.free(name)

    channels = json.object_get_raw(node, "channels")
    if channels != null {
        i = 0
        count = json.array_size(channels)
        while i < count {
            channel_node = json.array_get_raw(channels, i)
            target = text_field(channel_node, "target")
            mode = text_field(channel_node, "interpolation")
            track = anim.channel_new(target_of(target), interpolation_of(mode))
            string.free(target)
            string.free(mode)

            keys = json.object_get_raw(channel_node, "keys")
            if keys != null {
                k = 0
                key_count = json.array_size(keys)
                while k < key_count {
                    key = json.array_get_raw(keys, k)
                    t = json.get_number(json.object_get_raw(key, "t"))
                    values = json.object_get_raw(key, "v")
                    incoming = json.object_get_raw(key, "in")
                    outgoing = json.object_get_raw(key, "out")
                    anim.channel_add_cubic_key(track, t,
                        component(values, 0), component(values, 1),
                        component(values, 2), component(values, 3),
                        component(incoming, 0), component(incoming, 1),
                        component(incoming, 2), component(incoming, 3),
                        component(outgoing, 0), component(outgoing, 1),
                        component(outgoing, 2), component(outgoing, 3))
                    k = k + 1
                }
            }
            anim.clip_add_channel(clip, track)
            i = i + 1
        }
    }

    return clip
}

struct Provenance {
    model: *Model
    id: string
    object: string
    source: string
    mesh_file: string
    animation_file: string
    expected_vertices: int
    expected_triangles: int
}

// A record outlives the manifest it came from: every caller frees the manifest
// as soon as it has its models, and the trace runs long after. So the records
// live here rather than in the Manifest, and the program that loaded them says
// when they are done with `provenance_release`. A program that never loads a
// manifest never allocates the table.
var g_provenance: ptr = null

provenance_table() -> ptr {
    if g_provenance == null { g_provenance = list.new() }
    return g_provenance
}

provenance_forget(m: *Model) {
    if m == null || g_provenance == null { return }
    i = 0
    count = list.size(g_provenance)
    while i < count {
        p = list.get_raw(g_provenance, i) as *Provenance
        if p != null && p.model == m {
            list.remove(g_provenance, i)
            heap.free(p)
            return
        }
        i = i + 1
    }
}

provenance_release() {
    if g_provenance == null { return }
    i = 0
    count = list.size(g_provenance)
    while i < count {
        p = list.get_raw(g_provenance, i) as *Provenance
        if p != null { heap.free(p) }
        i = i + 1
    }
    list.free(g_provenance)
    g_provenance = null
}

provenance_record(m: *Model, id: string, object: string, source: string,
                  mesh_file: string, animation_file: string,
                  vertices: int, triangles: int) {
    if m == null { return }
    p = heap.new(Provenance)
    p.model = m
    p.id = string.copy(id)
    p.object = string.copy(object)
    p.source = string.copy(source)
    p.mesh_file = string.copy(mesh_file)
    p.animation_file = string.copy(animation_file)
    p.expected_vertices = vertices
    p.expected_triangles = triangles
    list.add_raw(provenance_table(), p as ptr)
}

provenance_for(m: *Model) -> *Provenance {
    if m == null { return null }
    table = provenance_table()
    i = 0
    count = list.size(table)
    while i < count {
        p = list.get_raw(table, i) as *Provenance
        if p != null && p.model == m { return p }
        i = i + 1
    }
    return null
}

provenance_by_id(id: string) -> *Provenance {
    table = provenance_table()
    i = 0
    count = list.size(table)
    while i < count {
        p = list.get_raw(table, i) as *Provenance
        if p != null && p.id == id { return p }
        i = i + 1
    }
    return null
}

provenance_by_object(name: string) -> *Provenance {
    table = provenance_table()
    i = 0
    count = list.size(table)
    while i < count {
        p = list.get_raw(table, i) as *Provenance
        if p != null && p.object == name { return p }
        i = i + 1
    }
    return null
}



provenance_model(p: *Provenance) -> *Model {
    if p == null { return null }
    return p.model
}

provenance_id(p: *Provenance) -> string {
    if p == null { return "" }
    return p.id
}

provenance_object(p: *Provenance) -> string {
    if p == null { return "" }
    return p.object
}

provenance_source(p: *Provenance) -> string {
    if p == null { return "" }
    return p.source
}

provenance_mesh_file(p: *Provenance) -> string {
    if p == null { return "" }
    return p.mesh_file
}

provenance_animation_file(p: *Provenance) -> string {
    if p == null { return "" }
    return p.animation_file
}

provenance_expected_vertices(p: *Provenance) -> int {
    if p == null { return 0 }
    return p.expected_vertices
}

provenance_expected_triangles(p: *Provenance) -> int {
    if p == null { return 0 }
    return p.expected_triangles
}

clip_reference_error(path: string, clip: *Clip) -> float {
    root = read_json(path)
    if root == null { return 0.0 - 1.0 }

    clips = json.object_get_raw(root, "clips")
    if clips == null || json.array_size(clips) == 0 {
        json.free(root)
        return 0.0 - 1.0
    }
    reference = json.object_get_raw(json.array_get_raw(clips, 0), "reference")
    if reference == null {
        json.free(root)
        return 0.0 - 1.0
    }

    worst = 0.0
    channels = anim.clip_channel_count(clip)
    i = 0
    while i < channels {
        track = anim.clip_channel(clip, i)
        rows = json.object_get_raw(reference, target_name(anim.channel_target(track)))
        if rows != null {
            r = 0
            count = json.array_size(rows)
            while r < count {
                row = json.array_get_raw(rows, r)
                t = json.get_number(json.object_get_raw(row, "t"))
                want = json.object_get_raw(row, "v")
                if anim.channel_target(track) == anim.ROTATION {
                    turn = anim.sample_quat(track, t)
                    worst = widest(worst, turn.x - component(want, 0))
                    worst = widest(worst, turn.y - component(want, 1))
                    worst = widest(worst, turn.z - component(want, 2))
                    worst = widest(worst, turn.w - component(want, 3))
                } else {
                    shift = anim.sample_vec3(track, t)
                    worst = widest(worst, shift.x - component(want, 0))
                    worst = widest(worst, shift.y - component(want, 1))
                    worst = widest(worst, shift.z - component(want, 2))
                }
                r = r + 1
            }
        }
        i = i + 1
    }
    json.free(root)
    return worst
}

widest(worst: float, delta: float) -> float {
    if delta < 0.0 { delta = 0.0 - delta }
    if delta > worst { return delta }
    return worst
}

target_name(target: int) -> string {
    if target == anim.ROTATION { return "rotation" }
    if target == anim.SCALE { return "scale" }
    return "translation"
}
