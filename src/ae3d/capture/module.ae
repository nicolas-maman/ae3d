// ae3d.capture -- the frame, held as pixels and summarised (#398).
//
// What the agent channel reads a scene by (#281): the frame read back into
// a buffer (from OpenGL, or adopted from what the Vulkan backend read), then
// asked about -- one pixel, a region's means and coverage, a grid of cell
// means, the difference from a frame held as a reference. The answers are
// small and the frame is not: a 1280x720 region is 3.7 MB of pixels and
// about twenty bytes of answer, and the answer is what an agent asks for.
// It was native/gpu/capture.c; the loops run over the bytes as a uint8
// array, as the C did.
//
// Rows are held top row first, the coordinates the rest of the channel
// reports in; GL hands them back bottom-up, so a read from GL flips them.
//
// Two tools write atlases with it (tools/bake_impostor.ae): a keyed copy of
// the frame's centre square into a cell, and the bleed that pads a cut-out
// edge with its neighbours' colour.

import std.mem
import ae3d.glapi

exports (
    SLOTS, frame, width, height, pixel, region, hold_reference, diff, grid, release, slot, slot_of,
    adopt, bleed, copy_keyed
)

extern calloc(count: int, size: int) -> ptr
extern realloc(p: ptr, size: long) -> ptr
extern free(p: ptr)
extern sqrt(x: float) -> float

// The numbers a region answers with: the mean red, green, blue and alpha,
// the covered share, the pixel count, the luminance's spread and range.
const SLOTS = 8

struct Pixels {
    data: ptr                        // RGBA bytes, top row first
    width: int
    height: int
    capacity: int
}

var g_frame: ptr = null
var g_reference: ptr = null

the_frame() -> *Pixels {
    if g_frame == null { g_frame = calloc(1, sizeof(Pixels)) }
    return g_frame as *Pixels
}

the_reference() -> *Pixels {
    if g_reference == null { g_reference = calloc(1, sizeof(Pixels)) }
    return g_reference as *Pixels
}

// Room for `w` x `h` pixels, kept when there is already room.
reserve(p: *Pixels, w: int, h: int) -> bool {
    wanted = w * h * 4
    if wanted <= 0 { return false }
    if wanted > p.capacity {
        grown = realloc(p.data, wanted as long)
        if grown == null { return false }
        p.data = grown
        p.capacity = wanted
    }
    p.width = w
    p.height = h
    return true
}

// The bound framebuffer's pixels, `w` x `h`, read and flipped top row
// first. GL only: the Vulkan backend reads its own and adopts them.
frame(w: int, h: int) -> int {
    f = the_frame()
    if !reserve(f, w, h) { return 0 }
    glapi.glPixelStorei(glapi.PACK_ALIGNMENT as uint32, 1)
    glapi.glReadPixels(0, 0, w, h, glapi.RGBA as uint32, glapi.UNSIGNED_BYTE as uint32, f.data)
    stride = w * 4
    scratch = calloc(stride, 1)
    top = 0
    bottom = h - 1
    while top < bottom {
        mem.copy_at(scratch, 0, f.data, (top * stride) as long, stride as long)
        mem.copy_at(f.data, (top * stride) as long, f.data, (bottom * stride) as long, stride as long)
        mem.copy_at(f.data, (bottom * stride) as long, scratch, 0, stride as long)
        top = top + 1
        bottom = bottom - 1
    }
    free(scratch)
    return 1
}

// Pixels read elsewhere (the Vulkan backend's readback), held as the frame.
adopt(pixels: ptr, w: int, h: int) -> int {
    if pixels == null { return 0 }
    f = the_frame()
    if !reserve(f, w, h) { return 0 }
    mem.copy(f.data, pixels, (w * h * 4) as long)
    return 1
}

width() -> int { return the_frame().width }
height() -> int { return the_frame().height }

// One pixel's red, green, blue and alpha, 0..255, into `out`.
pixel(x: int, y: int, out: ptr) -> int {
    f = the_frame()
    if f.data == null || x < 0 || y < 0 || x >= f.width || y >= f.height { return 0 }
    b = f.data as uint8[]
    at = (y * f.width + x) * 4
    o = out as float[]
    o[0] = b[at] as float
    o[1] = b[at + 1] as float
    o[2] = b[at + 2] as float
    o[3] = b[at + 3] as float
    return 1
}

absolute(v: int) -> int {
    if v < 0 { return 0 - v }
    return v
}

// Whether a pixel differs from the background by more than `tolerance` in
// any channel.
covers(b: uint8[], at: int, br: int, bg: int, bb: int, tolerance: int) -> bool {
    return absolute(b[at] as int - br) > tolerance || absolute(b[at + 1] as int - bg) > tolerance ||
           absolute(b[at + 2] as int - bb) > tolerance
}

// A region's answer (SLOTS numbers into `out`): its mean colour and alpha,
// 0..1; the share of it not the background (0xRRGGBBAA, within `tolerance`
// a channel); its pixel count; its luminance's standard deviation and
// range, 0..1. Clipped to the frame.
region(x: int, y: int, w: int, h: int, background: int, tolerance: int, out: ptr) -> int {
    f = the_frame()
    if f.data == null { return 0 }
    left = x
    top = y
    rw = w
    rh = h
    if left < 0 {
        rw = rw + left
        left = 0
    }
    if top < 0 {
        rh = rh + top
        top = 0
    }
    if left + rw > f.width { rw = f.width - left }
    if top + rh > f.height { rh = f.height - top }
    if rw <= 0 || rh <= 0 { return 0 }
    br = (background >> 24) & 255
    bg = (background >> 16) & 255
    bb = (background >> 8) & 255
    b = f.data as uint8[]
    sr = 0 as long
    sg = 0 as long
    sb = 0 as long
    sa = 0 as long
    covered = 0 as long
    luma_sum = 0.0
    luma_squares = 0.0
    low = 255
    high = 0
    row = 0
    while row < rh {
        at = ((top + row) * f.width + left) * 4
        column = 0
        while column < rw {
            r = b[at] as int
            g = b[at + 1] as int
            bl = b[at + 2] as int
            luma = (299 * r + 587 * g + 114 * bl) / 1000
            sr = sr + r
            sg = sg + g
            sb = sb + bl
            sa = sa + (b[at + 3] as int)
            luma_sum = luma_sum + (luma as float)
            luma_squares = luma_squares + (luma as float) * (luma as float)
            if luma < low { low = luma }
            if luma > high { high = luma }
            if absolute(r - br) > tolerance || absolute(g - bg) > tolerance || absolute(bl - bb) > tolerance {
                covered = covered + 1
            }
            at = at + 4
            column = column + 1
        }
        row = row + 1
    }
    total = (rw * rh) as float
    o = out as float[]
    o[0] = (sr as float) / total / 255.0
    o[1] = (sg as float) / total / 255.0
    o[2] = (sb as float) / total / 255.0
    o[3] = (sa as float) / total / 255.0
    o[4] = (covered as float) / total
    o[5] = total
    mean = luma_sum / total
    variance = luma_squares / total - mean * mean
    if variance < 0.0 { variance = 0.0 }
    o[6] = sqrt(variance) / 255.0
    o[7] = ((high - low) as float) / 255.0
    return 1
}

// The frame held as the reference a later diff compares against.
hold_reference() -> int {
    f = the_frame()
    if f.data == null { return 0 }
    r = the_reference()
    if !reserve(r, f.width, f.height) { return 0 }
    mem.copy(r.data, f.data, (f.width * f.height * 4) as long)
    return 1
}

// The frame against the reference: how many pixels changed by more than
// `tolerance` in their largest channel, as a count and a share, the largest
// change (0..1) and the pixel count.
diff(tolerance: int, out: ptr) -> int {
    f = the_frame()
    r = the_reference()
    if f.data == null || r.data == null { return 0 }
    if f.width != r.width || f.height != r.height { return 0 }
    a = f.data as uint8[]
    b = r.data as uint8[]
    total = f.width * f.height
    changed = 0
    worst = 0
    i = 0
    while i < total * 4 {
        delta = 0
        c = 0
        while c < 3 {
            d = absolute(a[i + c] as int - b[i + c] as int)
            if d > delta { delta = d }
            c = c + 1
        }
        if delta > tolerance { changed = changed + 1 }
        if delta > worst { worst = delta }
        i = i + 4
    }
    o = out as float[]
    o[0] = changed as float
    o[1] = (changed as float) / (total as float)
    o[2] = (worst as float) / 255.0
    o[3] = total as float
    return 1
}

release() {
    f = the_frame()
    r = the_reference()
    if f.data != null { free(f.data) }
    if r.data != null { free(r.data) }
    f.data = null
    f.width = 0
    f.height = 0
    f.capacity = 0
    r.data = null
    r.width = 0
    r.height = 0
    r.capacity = 0
}

// One number of a block the caller allocated, `count` long: 0 past it. The
// bound used to be eight, how long every block was when it was written; a
// grid is four numbers a cell and read every one past the eighth as zero --
// a whole frame that came back black with nothing to say why.
slot_of(block: ptr, index: int, count: int) -> float {
    if block == null || index < 0 || index >= count { return 0.0 }
    return (block as float[])[index]
}

slot(block: ptr, index: int) -> float { return slot_of(block, index, SLOTS) }

// The frame reduced to a grid of cell means, in one call: a window onto the
// frame (clipped to it) split into `columns` x `rows` cells, four numbers a
// cell into `out` -- red, green, blue and how much of the cell is not the
// background -- so a caller can read the picture or read the shape. Given
// the whole frame and a coarse grid this is a picture; given a small window
// and as many cells as it has pixels it is the pixels themselves.
grid(left: int, top: int, w: int, h: int, columns: int, rows: int, background: int, tolerance: int, out: ptr) -> int {
    f = the_frame()
    if f.data == null || f.width <= 0 || f.height <= 0 { return 0 }
    if columns <= 0 || rows <= 0 || out == null { return 0 }
    x_from = left
    y_from = top
    if x_from < 0 { x_from = 0 }
    if y_from < 0 { y_from = 0 }
    ww = w
    hh = h
    if ww <= 0 || x_from + ww > f.width { ww = f.width - x_from }
    if hh <= 0 || y_from + hh > f.height { hh = f.height - y_from }
    if ww <= 0 || hh <= 0 { return 0 }
    br = (background >> 24) & 255
    bg = (background >> 16) & 255
    bb = (background >> 8) & 255
    b = f.data as uint8[]
    o = out as float[]
    cy = 0
    while cy < rows {
        y0 = y_from + ((cy as long) * hh / rows) as int
        y1 = y_from + (((cy + 1) as long) * hh / rows) as int
        if y1 <= y0 { y1 = y0 + 1 }
        if y1 > f.height { y1 = f.height }
        cx = 0
        while cx < columns {
            x0 = x_from + ((cx as long) * ww / columns) as int
            x1 = x_from + (((cx + 1) as long) * ww / columns) as int
            if x1 <= x0 { x1 = x0 + 1 }
            if x1 > f.width { x1 = f.width }
            sr = 0 as long
            sg = 0 as long
            sb = 0 as long
            covered = 0
            total = 0
            y = y0
            while y < y1 {
                at = (y * f.width + x0) * 4
                x = x0
                while x < x1 {
                    sr = sr + (b[at] as int)
                    sg = sg + (b[at + 1] as int)
                    sb = sb + (b[at + 2] as int)
                    if covers(b, at, br, bg, bb, tolerance) { covered = covered + 1 }
                    total = total + 1
                    at = at + 4
                    x = x + 1
                }
                y = y + 1
            }
            cell = (cy * columns + cx) * 4
            if total <= 0 {
                o[cell] = 0.0
                o[cell + 1] = 0.0
                o[cell + 2] = 0.0
                o[cell + 3] = 0.0
            } else {
                n = total as float
                o[cell] = (sr as float) / n / 255.0
                o[cell + 1] = (sg as float) / n / 255.0
                o[cell + 2] = (sb as float) / n / 255.0
                o[cell + 3] = (covered as float) / n
            }
            cx = cx + 1
        }
        cy = cy + 1
    }
    return 1
}

// The colour of every transparent pixel of an RGBA atlas replaced by the
// average colour of its opaque neighbours, outward pass by pass until no
// transparent pixel is without one: a texture's filter and its mip levels
// blend a cut-out edge with the texels beside it, and if those hold the key
// colour the edge wears a fringe of it. The alpha is left as it was. How
// many pixels were filled.
bleed(atlas: ptr, w: int, h: int) -> int {
    if atlas == null || w <= 0 || h <= 0 { return 0 }
    a = atlas as uint8[]
    filled_block = calloc(w * h, 1)
    filled = filled_block as uint8[]
    i = 0
    while i < w * h {
        if a[i * 4 + 3] > 0 { filled[i] = 1 }
        i = i + 1
    }
    filled_total = 0
    pass = 0
    while pass < w + h {
        changed = 0
        // Marked after the pass, so a pixel filled this pass does not feed
        // its neighbour in the same pass and the colour walks out one ring
        // at a time.
        y = 0
        while y < h {
            x = 0
            while x < w {
                at = y * w + x
                if filled[at] == 0 {
                    sr = 0
                    sg = 0
                    sb = 0
                    n = 0
                    dy = 0 - 1
                    while dy <= 1 {
                        dx = 0 - 1
                        while dx <= 1 {
                            nx = x + dx
                            ny = y + dy
                            if nx >= 0 && ny >= 0 && nx < w && ny < h {
                                near = ny * w + nx
                                if filled[near] == 1 {
                                    sr = sr + (a[near * 4] as int)
                                    sg = sg + (a[near * 4 + 1] as int)
                                    sb = sb + (a[near * 4 + 2] as int)
                                    n = n + 1
                                }
                            }
                            dx = dx + 1
                        }
                        dy = dy + 1
                    }
                    if n > 0 {
                        a[at * 4] = (sr / n) as uint8
                        a[at * 4 + 1] = (sg / n) as uint8
                        a[at * 4 + 2] = (sb / n) as uint8
                        filled[at] = 2
                        changed = changed + 1
                    }
                }
                x = x + 1
            }
            y = y + 1
        }
        if changed == 0 { break }
        i = 0
        while i < w * h {
            if filled[i] == 2 { filled[i] = 1 }
            i = i + 1
        }
        filled_total = filled_total + changed
        pass = pass + 1
    }
    free(filled_block)
    return filled_total
}

// The captured frame's centre square copied into a `cell`-pixel cell of an
// RGBA atlas at (dst_x, dst_y), pixels within `tolerance` of the key colour
// made transparent and every pixel's colour kept -- what
// tools/bake_impostor.ae fills its atlas with, a cell a frame. Point
// sampled, so a window that came out the size it was asked for copies pixel
// for pixel, and one a window system made larger still lands the whole
// picture in the cell. How many pixels were kept, or -1 when the cell would
// not fit.
copy_keyed(atlas: ptr, atlas_width: int, atlas_height: int, dst_x: int, dst_y: int, cell: int,
           kr: int, kg: int, kb: int, tolerance: int) -> int {
    f = the_frame()
    if atlas == null || f.data == null || cell <= 0 { return 0 - 1 }
    if dst_x < 0 || dst_y < 0 || dst_x + cell > atlas_width || dst_y + cell > atlas_height { return 0 - 1 }
    side = f.width
    if f.height < side { side = f.height }
    left = (f.width - side) / 2
    top = (f.height - side) / 2
    src = f.data as uint8[]
    dst = atlas as uint8[]
    kept = 0
    y = 0
    while y < cell {
        x = 0
        while x < cell {
            sx = left + ((x as long) * side / cell) as int
            sy = top + ((y as long) * side / cell) as int
            s = (sy * f.width + sx) * 4
            d = ((dst_y + y) * atlas_width + dst_x + x) * 4
            keyed = absolute(src[s] as int - kr) <= tolerance && absolute(src[s + 1] as int - kg) <= tolerance &&
                    absolute(src[s + 2] as int - kb) <= tolerance
            dst[d] = src[s]
            dst[d + 1] = src[s + 1]
            dst[d + 2] = src[s + 2]
            if keyed {
                dst[d + 3] = 0
            } else {
                dst[d + 3] = 255
                kept = kept + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return kept
}
