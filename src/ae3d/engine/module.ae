// Window, main loop and backend selection.
//
// The engine owns the window and drives one `Backend` vtable, so switching
// between the OpenGL and Vulkan renderers is a constructor argument and nothing
// else in a program changes.

import std.heap
import std.list
import std.string
import ae3d.core
import ae3d.jobs
import ae3d.platform
import ae3d.gl
import ae3d.vk
import ae3d.agent
import ae3d.anim
import ae3d.sky
import ae3d.behaviour
import ae3d.input
import ae3d.scene
import std.os
import std.fs

extern calloc(count: int, size: int) -> ptr
extern ae3d_jobs_start(workers: int) -> int
extern ae3d_jobs_stop()
extern ae3d_jobs_workers() -> int
extern free(block: ptr)

exports (
    Engine, Behaviour,
    behaviour_new, engine_add_behaviour, engine_remove_behaviour, engine_behaviour_count, engine_behaviour,
    engine_add_scene, engine_remove_scene,
    object, script, destroy, running, of, engine_scene, engine_input,
    engine_new, engine_new_with, engine_over, engine_update, engine_free, engine_run, engine_run_at, engine_start, engine_loop, engine_shutdown, engine_jobs,
    engine_stop,
    engine_add_model, engine_remove_model, engine_set_light, engine_light,
    engine_add_light, engine_remove_light,
    engine_camera, engine_window, engine_backend_name,
    engine_set_size, engine_set_title, engine_set_msaa, engine_set_decorated, engine_set_post,
    engine_set_render_scale, engine_set_shadows, engine_shadows, engine_set_fog, engine_fog, engine_set_shadow_distance, engine_shadow_distance,
    engine_set_vsync, engine_set_camera_input, engine_set_fixed_step,
    engine_set_skybox, engine_set_sky, engine_set_clear_color, engine_draw_calls, engine_set_clouds, engine_clouds, engine_cloud_wind, engine_set_sky_overcast, engine_sky_overcast, engine_sky_overcast_color, engine_set_ssao, engine_set_capture_channel, engine_set_wetness, engine_set_taa, engine_taa, engine_set_dlss, engine_dlss, engine_ray_query, engine_set_ray_shadows, engine_ray_shadows, engine_set_sun_size, engine_sun_size, engine_set_ray_occlusion, engine_ray_occlusion, engine_set_lamp_size, engine_set_ssr, engine_load_texture,
    engine_set_time_of_day, engine_time_of_day,
    engine_delta_time, engine_frame_count, engine_fps, engine_set_frame_limit,
    engine_render_ms, engine_render_frames,
    engine_set_debug, engine_set_frustum_culling, engine_set_face_culling,
    engine_add_animation, engine_animations,
    engine_gl_renderer, engine_vk_renderer, engine_mouse_x, engine_mouse_y, engine_mouse_down, engine_key_down,
    engine_set_attachment_provider, engine_remove_attachment_provider, engine_attachments, engine_models, engine_lights, engine_save_scene
)

// A program is written the way a Unity or gopher3D game is: game objects
// in the engine's scene, and scripts on them with Unity's phases, which
// the engine calls. The program never calls a phase itself.
//
//     struct Spinner { speed: float }
//     start(state: ptr, go: *GameObject) { ... }
//     update(state: ptr, go: *GameObject, delta: float) { ... }
//
//     cube = engine.object(e, "Cube", loader.cube(1.0))     // a game object with a mesh
//     engine.script(cube, "Spinner", &spinner, start, update)
//     engine.engine_run(e)
//
// `object` puts the object in the scene and its model in the renderer (at
// start, if the engine is not up yet); `script` is AddComponent. A script
// reaches its engine through engine.of(go) -- the camera, the lights, the
// clock -- or engine.running(), the engine whose loop is running. The
// phases: `start` once on the first frame the object is in the scene,
// `fixed_update` at the fixed step, `update` once a frame, `late_update`
// after every object has updated and before the frame is drawn; a phase
// left null is not taken part in.
//
// Underneath, a behaviour: what the engine's own systems (the scene above,
// the weather) add to take part in the loop, with the engine handed to
// every phase. `state` is the behaviour's own memory.
//
//   start        once, on the first frame after it is added, with the window
//                and the backend up: where a scene is built
//   fixed_update at the fixed step (engine_set_fixed_step), as many times a
//                frame as the frame's time covers, with the step: simulation
//   update       once a frame, with the seconds since the last frame
//   pose         after the clips have been applied and before anything is
//                drawn, on every frame including a held one: inverse
//                kinematics, and whatever else puts a bone where the frame
//                needs it rather than where the clip left it
//   late_update  after the frame is drawn, with the frame's delta: reading
//                the frame back, recording, anything that wants the picture
//
// A phase left null is a phase the behaviour does not take part in. A
// behaviour added while the loop runs starts on the next frame.
var g_running: ptr = null

struct Behaviour {
    name: string
    state: ptr
    start: fn(ptr, *Engine)
    fixed_update: fn(ptr, *Engine, float)
    update: fn(ptr, *Engine, float)
    pose: fn(ptr, *Engine)
    late_update: fn(ptr, *Engine, float)
    started: bool
    enabled: bool
}

struct Engine {
    window: ptr
    camera: ptr
    light: ptr
    backend_state: ptr
    gl_renderer: ptr
    api: int

    backend_init: fn(ptr, ptr, int, int) -> int
    backend_render: fn(ptr, ptr, ptr)
    backend_add_model: fn(ptr, ptr)
    backend_remove_model: fn(ptr, ptr)
    backend_load_texture: fn(ptr, string) -> int
    backend_set_skybox: fn(ptr, ptr)
    backend_set_clear_color: fn(ptr, float, float, float)
    backend_update_viewport: fn(ptr, int, int)
    backend_set_post: fn(ptr, int, int, float, float)
    backend_set_shadows: fn(ptr, int)
    backend_set_fog: fn(ptr, ptr)
    backend_set_shadow_distance: fn(ptr, float)
    backend_add_light: fn(ptr, ptr)
    backend_remove_light: fn(ptr, ptr)
    backend_shadows: fn(ptr) -> int
    backend_set_render_scale: fn(ptr, float) -> float
    backend_cleanup: fn(ptr)
    backend_name: string

    // What takes part in the loop: every Behaviour added to the engine, in
    // the order added. The loop calls their phases; nothing else does.
    behaviours: ptr
    // The engine's scene of game objects (a *Scene), run as a behaviour,
    // and the models made before the backend was up, added at start.
    scene: ptr
    pending_models: ptr

    width: int
    height: int
    msaa: int
    title: string
    decorated: bool
    visible: bool
    vsync: int
    camera_input: bool
    shadows: bool
    shadow_distance: float
    fog: Fog
    // The occlusion, kept here so a scene can ask for it before the backend
    // exists and have it applied when it does.
    ssao_on: bool
    ssao_radius: float
    ssao_intensity: float
    // The post chain and the clear colour as last set, for the scene file.
    post_fxaa: bool
    post_bloom: bool
    post_threshold: float
    post_intensity: float
    clear_color: Vec3
    // The hour the sun is set by, when it is; under zero when the scene
    // lights itself.
    time_of_day: float
    // The sky's clouds and its overcast as last set, so what puts its own
    // weather over them (the weather module) can give them back.
    cloud_cover: float
    cloud_wind: float
    overcast: float
    overcast_color: Vec3
    // An engine over a renderer somebody else made and drives (the
    // editor's): the renderer, the camera and the light are theirs, and
    // engine_free leaves them alone.
    borrowed: bool

    fixed_step: float
    fixed_accumulator: float
    delta_time: float
    // What the frames drawn so far cost to submit, and how many there were.
    // The GPU is not waited on, so this is the CPU's half: the scene walk, the
    // culling, the uniforms and the draw calls, which is the half a scene
    // grows out of and the half a benchmark on a shared runner can trust.
    render_seconds: float
    render_frames: int
    frame_count: int
    fps: float
    fps_window: float
    fps_frames: int

    last_mouse_x: float
    last_mouse_y: float
    first_mouse: bool
    running: bool

    // The agent channel. agent_on is read once a frame and is false in every
    // build that did not ask for the channel, which is what keeps it free.
    agent_on: bool
    agent_ctx: ptr
    animations: ptr
    // The systems that record more of a model than the renderer knows --
    // physics, its bodies -- each answer, when the scene is written, the
    // attachments the file carries beside the models (see engine_save_scene).
    attachment_providers: ptr      // list of *AttachmentProvider, or null
    scene_written: bool            // AE3D_SCENE_OUT was answered, on the first frame
    // The input service (ae3d.input): the actions a game binds, polled
    // once a frame before the updates. The camera's own controls are
    // actions in it, "forward", "strafe", "rise", "sprint" and "look".
    input: ptr
    agent_steps_left: int
    frame_limit: int

    // AE3D_PERF=1: what the run cost, summed over its frames and said at
    // the end -- the device's own time in each pass, the CPU's in
    // submitting, the draws -- so a scene is measured by the same numbers
    // wherever it runs and a change to the engine is a change in them.
    // Temporal anti-aliasing, asked for; applied when the backend is up.
    taa: bool
    // DLSS: the mode asked for (0 off), on Vulkan through Streamline; the
    // runtime is loaded before the backend starts when one is wanted.
    dlss_mode: int
    ray_shadows: bool
    // The sun's size for the rays' penumbra, in degrees; zero is a point.
    sun_size: float
    // Occlusion by ray, asked for: with the rays and the occlusion on, the
    // scene shader traces it and the screen-space pass is skipped.
    ray_occlusion: bool
    // A lamp's size in metres for the rays' lamp shadows; zero keeps the
    // renderer's own.
    lamp_size: float
    // The wet ground's reflection, asked for; applied when the backend is up.
    ssr_on: bool
    ssr_road_height: float
    ssr_strength: float
    perf_on: bool
    perf_frames: int
    perf_shadow_ms: float
    perf_scene_ms: float
    perf_post_ms: float
    perf_cpu_ms: float
    // The behaviours' own time: the fixed updates, the updates, the clips
    // advancing -- the simulation, which at half a million figures is
    // where a frame goes when the device is done in ten milliseconds.
    perf_update_ms: float
    perf_draws: int
    perf_started: float
    perf_stage_ms: ptr
    update_seconds: float
}

// A behaviour with no phases yet: set the ones it takes part in.
//
//   b = engine.behaviour_new("spinning cube", null)
//   b.start = on_start
//   b.update = on_update
//   engine.engine_add_behaviour(e, b)
behaviour_new(name: string, state: ptr) -> *Behaviour {
    b = heap.new(Behaviour)
    b.name = name
    b.state = state
    b.started = false
    b.enabled = true
    return b
}

engine_add_behaviour(e: *Engine, b: *Behaviour) {
    if b == null { return }
    list.add_raw(e.behaviours, b as ptr)
}

engine_remove_behaviour(e: *Engine, b: *Behaviour) {
    count = list.size(e.behaviours)
    i = 0
    while i < count {
        if list.get_raw(e.behaviours, i) == b as ptr {
            list.remove(e.behaviours, i)
            return
        }
        i = i + 1
    }
}

engine_behaviour_count(e: *Engine) -> int { return list.size(e.behaviours) }

engine_behaviour(e: *Engine, index: int) -> *Behaviour {
    if index < 0 || index >= list.size(e.behaviours) { return null }
    return list.get_raw(e.behaviours, index) as *Behaviour
}

// A scene of game objects and components takes part in the loop as one
// behaviour: its components' start, update and fixed_update run when the
// engine's do. The behaviour returned is the handle to remove it by.
engine_add_scene(e: *Engine, scene: *Scene) -> *Behaviour {
    behaviour.scene_set_host(scene, e as ptr)
    b = behaviour_new("scene", scene as ptr)
    b.update = scene_behaviour_update
    b.fixed_update = scene_behaviour_fixed
    engine_add_behaviour(e, b)
    return b
}

// The engine's own scene: what `object` puts objects in.
engine_scene(e: *Engine) -> *Scene { return e.scene as *Scene }

// The engine's input: bind actions on it, read them from any script.
engine_input(e: *Engine) -> *Input { return e.input as *Input }

// The camera's controls as actions, the way every example has flown: WASD
// and the sticks, space and control for up and down, shift to sprint, the
// right mouse button to look. A game rebinds or unbinds them.
default_input() -> *Input {
    i = input.input_new(null)
    input.bind_axis(i, "forward", platform.KEY_W, platform.KEY_S)
    input.bind_pad_axis(i, "forward", input.PAD_LEFT_Y, 0.0 - 1.0)
    input.bind_axis(i, "strafe", platform.KEY_D, platform.KEY_A)
    input.bind_pad_axis(i, "strafe", input.PAD_LEFT_X, 1.0)
    input.bind_axis(i, "rise", platform.KEY_SPACE, platform.KEY_LEFT_CONTROL)
    input.bind_pad_axis(i, "rise", input.PAD_RIGHT_TRIGGER, 1.0)
    input.bind_key(i, "sprint", platform.KEY_LEFT_SHIFT)
    input.bind_key(i, "sprint", platform.KEY_RIGHT_SHIFT)
    input.bind_button(i, "sprint", input.PAD_LEFT_THUMB)
    input.bind_mouse(i, "look", platform.MOUSE_RIGHT)
    input.bind_pad_axis(i, "look_x", input.PAD_RIGHT_X, 1.0)
    input.bind_pad_axis(i, "look_y", input.PAD_RIGHT_Y, 1.0)
    return i
}

// The camera flown by the actions: the heading added up from the axes
// and scaled once, so the diagonal is no faster than an axis; the look
// from the mouse while its button is held, and from the right stick.
fly_camera(e: *Engine, cam: *Camera, delta: float) {
    i = e.input as *Input
    velocity = cam.speed * delta
    if input.held(i, "sprint") { velocity = velocity * 2.5 }
    heading = core.vec3(0.0, 0.0, 0.0)
    heading = core.v3_add(heading, core.v3_mul(cam.front, input.axis(i, "forward")))
    heading = core.v3_add(heading, core.v3_mul(cam.right, input.axis(i, "strafe")))
    heading = core.v3_add(heading, core.v3_mul(cam.world_up, input.axis(i, "rise")))
    core.camera_move(cam, heading, velocity)

    if input.held(i, "look") {
        process_mouse_look(e, cam)
    } else {
        e.first_mouse = true
    }
    turn_x = input.axis(i, "look_x")
    turn_y = input.axis(i, "look_y")
    if turn_x != 0.0 || turn_y != 0.0 {
        // A full deflection turns at a steady rate, whatever the frame.
        core.camera_process_mouse(cam, turn_x * 120.0 * delta, 0.0 - turn_y * 120.0 * delta, true)
    }
}

// A game object in the engine's scene, drawn by `model` (null for an
// object with no mesh -- a game manager, a camera rig). The model is the
// object's from here: freed with it when the scene goes. Into the
// renderer now when the engine is up, else on the first frame.
object(e: *Engine, name: string, model: *Model) -> *GameObject {
    o = behaviour.object_new(name)
    if model != null {
        behaviour.object_set_model(o, model)
        o.owns_model = true
        // The model is known by the object's name -- in the editor, in the
        // scene file, over the agent channel: a crate loaded from
        // Street_Crate0_0.obj and made "Crate" is a crate.
        core.model_set_name(model, name)
        if e.running { e.backend_add_model(e.backend_state, model) }
        else { list.add_raw(e.pending_models, model as ptr) }
    }
    behaviour.scene_add(e.scene as *Scene, o)
    return o
}

// A script on a game object: Unity's AddComponent, with the phases by
// Unity's names. Any phase may be null; the state stays the caller's.
script(o: *GameObject, name: string, state: ptr,
       start: fn(ptr, *GameObject), update: fn(ptr, *GameObject, float),
       fixed_update: fn(ptr, *GameObject, float) = null,
       late_update: fn(ptr, *GameObject, float) = null) -> *Component {
    return behaviour.object_add_script(o, name, state, start, update, fixed_update, late_update)
}

// The object out of the scene and its model out of the renderer, at the
// end of this frame: Unity's Destroy.
destroy(e: *Engine, o: *GameObject) {
    if o == null { return }
    if o.model != null {
        if e.running {
            e.backend_remove_model(e.backend_state, o.model as *Model)
        } else {
            // Not yet uploaded: out of the queue, or the first frame would
            // hand the renderer a model the scene has freed by then.
            pending = list.size(e.pending_models)
            i = 0
            while i < pending {
                if list.get_raw(e.pending_models, i) == o.model {
                    list.remove(e.pending_models, i)
                    pending = 0
                }
                i = i + 1
            }
        }
    }
    behaviour.scene_destroy_later(e.scene as *Scene, o)
}

// The engine whose loop is running, for a script that has no other way to
// it (Unity's singletons); null between runs.
running() -> *Engine { return g_running as *Engine }

// The engine an object's scene is run by.
of(o: *GameObject) -> *Engine {
    if o == null || o.scene == null { return running() }
    host = behaviour.scene_host(o.scene as *Scene)
    if host == null { return running() }
    return host as *Engine
}

engine_remove_scene(e: *Engine, handle: *Behaviour) {
    engine_remove_behaviour(e, handle)
    if handle != null { heap.free(handle) }
}

scene_behaviour_update(state: ptr, e: *Engine, delta: float) {
    behaviour.scene_update(state as *Scene, delta)
    behaviour.scene_late_update(state as *Scene, delta)
}

scene_behaviour_fixed(state: ptr, e: *Engine, step: float) {
    behaviour.scene_fixed_update(state as *Scene, step)
}

// Each phase over every enabled behaviour, in the order they were added; a
// behaviour that has not started starts first, whichever phase reaches it.
run_starts(e: *Engine) {
    count = list.size(e.behaviours)
    i = 0
    while i < count {
        b = list.get_raw(e.behaviours, i) as *Behaviour
        if b != null && b.enabled && !b.started {
            b.started = true
            if b.start != null { b.start(b.state, e) }
        }
        i = i + 1
    }
}

run_fixed_updates(e: *Engine, step: float) {
    run_starts(e)
    count = list.size(e.behaviours)
    i = 0
    while i < count {
        b = list.get_raw(e.behaviours, i) as *Behaviour
        if b != null && b.enabled && b.fixed_update != null { b.fixed_update(b.state, e, step) }
        i = i + 1
    }
}

run_updates(e: *Engine, delta: float) {
    run_starts(e)
    count = list.size(e.behaviours)
    i = 0
    while i < count {
        b = list.get_raw(e.behaviours, i) as *Behaviour
        if b != null && b.enabled && b.update != null { b.update(b.state, e, delta) }
        i = i + 1
    }
}

run_poses(e: *Engine) {
    count = list.size(e.behaviours)
    i = 0
    while i < count {
        b = list.get_raw(e.behaviours, i) as *Behaviour
        if b != null && b.enabled && b.started && b.pose != null { b.pose(b.state, e) }
        i = i + 1
    }
}

run_late_updates(e: *Engine, delta: float) {
    count = list.size(e.behaviours)
    i = 0
    while i < count {
        b = list.get_raw(e.behaviours, i) as *Behaviour
        if b != null && b.enabled && b.started && b.late_update != null { b.late_update(b.state, e, delta) }
        i = i + 1
    }
}

// The agent seeks a pose and wants it solved: the pose phase, from outside
// the loop.
attachments_for_agent(data: ptr) -> ptr {
    return engine_attachments(data as *Engine)
}

poses_for_agent(data: ptr) {
    run_poses(data as *Engine)
}

// An engine on the backend the machine is for: Vulkan, and AE3D_API=opengl
// to run the same program through OpenGL. The explicit choice is
// engine_new_with.
engine_new() -> *Engine {
    return engine_new_with(platform.API_VULKAN)
}

engine_new_with(api: int) -> *Engine {
    api = api_from_env(api)
    if api == platform.API_VULKAN && !vk.available() {
        println("ae3d: no Vulkan driver (${vk.last_error()}), drawing through OpenGL")
        api = platform.API_GL
    }
    e = heap.new(Engine)
    e.behaviours = list.new()
    e.pending_models = list.new()
    e.scene = behaviour.scene_new() as ptr
    engine_add_scene(e, e.scene as *Scene)
    e.input = default_input() as ptr
    e.api = api
    e.width = 1024
    e.height = 768
    e.msaa = 4
    e.title = "ae3d"
    e.decorated = true
    e.visible = true
    e.vsync = 1
    e.camera_input = true
    e.shadows = true
    e.fog = core.fog_none()
    e.ssao_on = false
    e.ssao_radius = 3.0
    e.ssao_intensity = 1.0
    e.time_of_day = 0.0 - 1.0
    e.cloud_wind = 1.0
    e.overcast_color = core.vec3(0.5, 0.5, 0.5)
    e.fixed_step = 1.0 / 60.0
    e.first_mouse = true
    e.frame_limit = frame_limit_from_env()
    e.perf_on = core.env_int("AE3D_PERF", 0) == 1
    e.perf_stage_ms = calloc(vk.STAGE_COUNT, 8)
    e.animations = anim.registry_new() as ptr
    // The job pool the crowd's passes, the weather and the physics run
    // over: a worker for every hardware thread but this one. AE3D_JOBS=n
    // is the thread count, this one included; 1 is this thread alone,
    // which is the measure everything else is against. The renderer's
    // own C loops (the instance packing, float32 work Aether cannot
    // express yet, aether#2134) run on the native pool, sized the same.
    threads = core.env_int("AE3D_JOBS", 0)
    jobs.start(threads)
    ae3d_jobs_start(jobs.workers())

    if api == platform.API_VULKAN {
        vulkan_state = vk.renderer_new()
        e.backend_state = vulkan_state as ptr
        e.gl_renderer = null
        bind_backend(e, vk.backend(vulkan_state))
    } else {
        opengl_state = gl.renderer_new()
        e.backend_state = opengl_state as ptr
        e.gl_renderer = opengl_state as ptr
        bind_backend(e, gl.backend(opengl_state))
    }
    return e
}

// An engine over a renderer that is already up and drawn by somebody else --
// the editor's viewport -- so what is written for the engine (the weather,
// a behaviour) runs in it too. Nothing here opens a window or loops: the
// owner renders, and calls engine_update with the frame's seconds so the
// behaviours step. The settings go straight to the renderer, since it is
// up. The renderer, the camera and the light stay the owner's.
engine_over(renderer: ptr, api: int, camera: *Camera, light: *Light) -> *Engine {
    e = heap.new(Engine)
    e.behaviours = list.new()
    e.pending_models = list.new()
    e.scene = behaviour.scene_new() as ptr
    engine_add_scene(e, e.scene as *Scene)
    e.input = default_input() as ptr
    e.api = api
    e.borrowed = true
    e.width = 1024
    e.height = 768
    e.fog = core.fog_none()
    e.cloud_wind = 1.0
    e.overcast_color = core.vec3(0.5, 0.5, 0.5)
    e.time_of_day = 0.0 - 1.0
    e.fixed_step = 1.0 / 60.0
    e.perf_stage_ms = calloc(vk.STAGE_COUNT, 8)
    e.animations = anim.registry_new() as ptr
    e.camera = camera as ptr
    e.light = light as ptr
    e.backend_state = renderer
    if api == platform.API_VULKAN {
        e.gl_renderer = null
        bind_backend(e, vk.backend(renderer as *VKRenderer))
    } else {
        e.gl_renderer = renderer
        bind_backend(e, gl.backend(renderer as *GLRenderer))
    }
    e.running = true
    return e
}

// One frame of the behaviours, for an engine whose owner runs the loop:
// the starts not yet run, then every update with the frame's seconds.
// One frame of an engine driven from outside (the editor's, over its own
// renderer): the fixed steps the frame's time covers, then the update
// phase, the way the loop runs them -- so physics steps under the editor
// as it steps under a program.
engine_update(e: *Engine, delta: float) {
    e.delta_time = delta
    e.fixed_accumulator = e.fixed_accumulator + delta
    while e.fixed_accumulator >= e.fixed_step {
        e.fixed_accumulator = e.fixed_accumulator - e.fixed_step
        run_fixed_updates(e, e.fixed_step)
    }
    run_updates(e, delta)
    e.frame_count = e.frame_count + 1
}

// AE3D_API=vulkan or AE3D_API=opengl runs a program on that backend whatever
// it asked for, so any scene can be looked at on both without a flag of its
// own. A backend that is not there is reported and the asked-for one kept.
api_from_env(asked: int) -> int {
    wanted = core.text(os.getenv("AE3D_API"))
    if wanted == "vulkan" {
        if !vk.available() {
            println("ae3d: AE3D_API=vulkan but no Vulkan driver: ${vk.last_error()}")
            return asked
        }
        return platform.API_VULKAN
    }
    if wanted == "opengl" || wanted == "gl" { return platform.API_GL }
    return asked
}

// The most simulated time one frame may carry (see engine_loop).
const MAX_FRAME_SECONDS = 0.25

// AE3D_FRAMES caps the loop so any example doubles as a smoke test that
// terminates on its own; unset or zero means run until the window closes.
frame_limit_from_env() -> int {
    return core.env_int("AE3D_FRAMES", 0)
}

// AE3D_WIDTH and AE3D_HEIGHT override the size a program asked for, applied
// here rather than in engine_new so that a program setting its own size does
// not overwrite them.
//
// A software rasteriser costs what it draws, and this engine's fragment shader
// is not a cheap one: the same run at a quarter of the width and a quarter of
// the height does everything it did -- every frame, every draw, every branch of
// the shader -- for a sixteenth of the pixels. That is the difference between
// a smoke test that runs on a runner with no GPU and one that is billed for a
// software rasteriser drawing a million pixels a frame.
size_from_env(e: *Engine) {
    width = core.env_int("AE3D_WIDTH", 0)
    height = core.env_int("AE3D_HEIGHT", 0)
    if width > 0 { e.width = width }
    if height > 0 { e.height = height }
    // AE3D_MSAA=n sets the multisampling (0 for none); DLSS wants none,
    // since a resolved sample has no sub-pixel detail left to reconstruct
    // from, and is the antialiasing itself.
    msaa = core.env_int("AE3D_MSAA", 0 - 1)
    if msaa >= 0 { e.msaa = msaa }
    if core.env_int("AE3D_DLSS", 0) > 0 && msaa < 0 { e.msaa = 0 }
}

// AE3D_HIDDEN keeps the window off the screen. The frame is still drawn --
// same passes, same draws, same pixels -- so everything the agent channel reads
// reads the same; the window simply never appears, never takes focus and never
// reaches the taskbar.
//
// This is what an agent inspecting a scene wants. It is measuring the frame,
// not watching it, and a run that seizes the screen every time cannot be run on
// a machine somebody is using. It is also what a windowed CI runner wants,
// where a dozen examples each flashing up a window is a dozen chances to steal
// focus from the test that is actually running.
hidden_from_env(e: *Engine) {
    if core.env_int("AE3D_HIDDEN", 0) != 0 { e.visible = false }
}

// AE3D_SNAPSHOT writes the last frame of a bounded run to a PNG.
//
// Running an example proves it does not crash and counting its draws proves it
// asked for something. Neither says what came out, and that is the difference
// between an example that renders the scene it is named after and one that
// renders a flat wash of a single colour: both exit zero with the same number
// of draws. The only way to tell them apart is to look at the frame.
snapshot_path(e: *Engine) -> string {
    return core.text(os.getenv("AE3D_SNAPSHOT"))
}

// AE3D_SNAPSHOT_BURST=N writes the last N frames instead of only the last
// one, each to the snapshot path with its frame number spliced in before the
// extension (scene.png -> scene_0057.png). One frame cannot show motion: a
// walk cycle, a jitter, a limb that snaps between poses only appear across
// consecutive frames laid side by side.
snapshot_burst(e: *Engine) -> int {
    n = core.env_int("AE3D_SNAPSHOT_BURST", 1)
    if n < 1 { n = 1 }
    return n
}

// The path a burst frame is written to: the snapshot path with _NNNN before
// its extension. A single snapshot keeps the path as given.
burst_path(path: string, frame: int) -> string {
    n = string.length(path)
    if n > 4 && string.substring(path, n - 4, n) == ".png" {
        stem = string.substring(path, 0, n - 4)
        num = "${frame}"
        while string.length(num) < 4 { num = "0${num}" }
        return "${stem}_${num}.png"
    }
    return "${path}_${frame}"
}

// Taken between the last draw and the buffer swap, which is the only moment a
// windowed program's finished frame is still readable.
write_snapshot(e: *Engine) {
    path = snapshot_path(e)
    if path == "" { return }
    if snapshot_burst(e) > 1 { path = burst_path(path, e.frame_count + 1) }
    if e.api == platform.API_VULKAN {
        if !vk.snapshot(path) {
            println("ae3d: could not capture the Vulkan frame for ${path}")
        }
        return
    }
    width = platform.window_fb_width(e.window)
    height = platform.window_fb_height(e.window)
    if !gl.snapshot(path, width, height) {
        println("ae3d: could not write ${path}")
    }
}

engine_set_frame_limit(e: *Engine, frames: int) {
    e.frame_limit = frames
}

// Binds a player to a model and takes ownership of the player. The clip is not
// taken: one clip drives many players, and freeing it here would pull it out
// from under the others.
//
// The name is what an agent asks for over the channel. An index shifts when the
// scene changes; a name does not.
engine_add_animation(e: *Engine, name: string, p: *Player, m: *Model) -> int {
    return anim.registry_add(e.animations as *Registry, name, p, m)
}

engine_animations(e: *Engine) -> ptr {
    return e.animations
}

bind_backend(e: *Engine, b: Backend) {
    e.backend_init = b.init
    e.backend_render = b.render
    e.backend_add_model = b.add_model
    e.backend_remove_model = b.remove_model
    e.backend_load_texture = b.load_texture
    e.backend_set_skybox = b.set_skybox
    e.backend_set_clear_color = b.set_clear_color
    e.backend_set_post = b.set_post
    e.backend_set_shadows = b.set_shadows
    e.backend_set_fog = b.set_fog
    e.backend_set_shadow_distance = b.set_shadow_distance
    e.backend_add_light = b.add_light
    e.backend_remove_light = b.remove_light
    e.backend_shadows = b.shadows
    e.backend_set_render_scale = b.set_render_scale
    e.backend_update_viewport = b.update_viewport
    e.backend_cleanup = b.cleanup
    e.backend_name = b.name
}

engine_free(e: *Engine) {
    if e == null { return }
    if g_running == e as ptr { g_running = null }
    // The scene's objects, and the models they own, before the behaviours
    // (the scene's runner is one of them). An owned model leaves the
    // renderer the way engine_remove_model takes one out, so its buffers go
    // with it rather than with the device; a model never uploaded has none
    // to release, and the backends know that.
    if e.scene != null {
        scene = e.scene as *Scene
        count = behaviour.scene_count(scene)
        i = 0
        while i < count {
            o = behaviour.scene_object(scene, i)
            if o != null && o.owns_model && o.model != null && e.backend_state != null {
                e.backend_remove_model(e.backend_state, o.model as *Model)
            }
            i = i + 1
        }
        behaviour.scene_free(scene)
        e.scene = null
    }
    if e.pending_models != null { list.free(e.pending_models) ; e.pending_models = null }
    if e.input != null {
        input.input_free(e.input as *Input)
        e.input = null
    }
    if e.animations != null {
        anim.registry_free(e.animations as *Registry)
        e.animations = null
    }
    if e.camera != null && !e.borrowed { core.camera_free(e.camera as *Camera) }
    if e.perf_stage_ms != null { free(e.perf_stage_ms) }
    // The behaviours are the program's: their states are freed by whoever
    // made them; the list and the records the engine made are the engine's.
    if e.behaviours != null {
        count = list.size(e.behaviours)
        i = 0
        while i < count {
            b = list.get_raw(e.behaviours, i) as *Behaviour
            if b != null { heap.free(b) }
            i = i + 1
        }
        list.free(e.behaviours)
        e.behaviours = null
    }
    if e.borrowed {
        heap.free(e)
        return
    }
    if e.api == platform.API_VULKAN {
        vk.renderer_free(e.backend_state as *VKRenderer)
    } else {
        gl.renderer_free(e.backend_state as *GLRenderer)
    }
    ae3d_jobs_stop()
    jobs.stop()
    heap.free(e)
}

// How many worker threads the engine's job pool has beside the calling
// thread: what the crowd's passes are spread over.
engine_jobs(e: *Engine) -> int {
    if e == null { return 0 }
    return jobs.workers()
}

engine_set_size(e: *Engine, width: int, height: int) {
    e.width = width
    e.height = height
}

engine_set_title(e: *Engine, title: string) {
    e.title = title
    if e.window != null { platform.window_set_title(e.window, title) }
}

engine_set_msaa(e: *Engine, samples: int) { e.msaa = samples }

// Post-processing is a backend capability rather than a renderer-specific call,
// so switching backends does not change what a scene looks like.
engine_set_post(e: *Engine, fxaa: bool, bloom: bool, threshold: float, intensity: float) {
    e.post_fxaa = fxaa
    e.post_bloom = bloom
    e.post_threshold = threshold
    e.post_intensity = intensity
    if e.backend_state == null { return }
    fx = 0
    if fxaa { fx = 1 }
    bl = 0
    if bloom { bl = 1 }
    e.backend_set_post(e.backend_state, fx, bl, threshold, intensity)
}
// Shadows are a property of the scene rather than of the moment a program
// happens to ask for them, so this is remembered and applied once the backend
// has a device to build the map on. Both backends drop renderer state at init,
// since the OpenGL map needs a live context and the Vulkan one is wired into
// descriptor sets that init recreates, so a program that configured its engine
// before engine_run was talking to nothing.
engine_set_shadows(e: *Engine, on: bool) {
    e.shadows = on
    if e.running { apply_shadows(e) }
}

// The air the scene is seen through. Kept here rather than set straight
// through, for the same reason shadows are: a backend has no device to hold it
// on until the window is open.
engine_set_fog(e: *Engine, f: Fog) {
    e.fog = f
    if e.running { e.backend_set_fog(e.backend_state, &e.fog) }
}

engine_fog(e: *Engine) -> Fog { return e.fog }

// How far from the camera shadows reach. Zero, the default, fits the shadow
// map to the whole scene; a scene with a horizon in it wants a bound, or the
// map is spread so thin that nothing standing on the ground casts anything.
engine_set_shadow_distance(e: *Engine, metres: float) {
    e.shadow_distance = metres
    if e.running { e.backend_set_shadow_distance(e.backend_state, metres) }
}

engine_shadow_distance(e: *Engine) -> float { return e.shadow_distance }

// What the backend managed rather than what was asked for: a device that could
// not build the map reports false here.
engine_shadows(e: *Engine) -> bool {
    if !e.running { return e.shadows }
    return e.backend_shadows(e.backend_state) == 1
}

apply_shadows(e: *Engine) {
    flag = 0
    if e.shadows { flag = 1 }
    e.backend_set_shadows(e.backend_state, flag)
}

// Draw the scene smaller than the window. The answer is the scale the backend
// adopted rather than the one asked for, so a program stepping down a quality
// ladder is told which rungs exist on the renderer it happens to have got.
engine_set_render_scale(e: *Engine, scale: float) -> float {
    if e.backend_state == null { return 1.0 }
    return e.backend_set_render_scale(e.backend_state, scale)
}

// The two backend capabilities the engine held a hook for and never called.
// Both backends implement them, core exports the skybox constructors, and the
// vtable entries were copied into the Engine at bind time, so everything was
// in place except the call: a program written against the engine surface could
// not put a sky behind its scene or load a texture, whichever backend it ran
// on. The Skybox itself is still made by the backend that will draw it
// (gl.skybox_create / vk.skybox_create), the same way engine_gl_renderer is
// already how a program reaches backend-specific construction.
engine_set_skybox(e: *Engine, skybox: ptr) {
    if e.backend_state == null { return }
    e.backend_set_skybox(e.backend_state, skybox)
}

// A sky from an image, made by whichever backend is drawing and set: one
// call on either backend, so a scene names its sky once instead of asking
// which renderer it got and constructing the sky through that. The backend
// owns the sky it is given and frees it with itself. False when the image
// could not be read.
engine_set_sky(e: *Engine, path: string) -> bool {
    if e.backend_state == null { return false }
    sky = null as ptr
    if e.api == platform.API_VULKAN {
        sky = vk.skybox_create(e.backend_state as *VKRenderer, path) as ptr
    } else {
        sky = gl.skybox_create(e.gl_renderer as *GLRenderer, path) as ptr
    }
    if sky == null { return false }
    engine_set_skybox(e, sky)
    return true
}

// The hour of the day, 0 to 24: the sun goes where that hour puts it, the
// key light takes the sun's direction, colour, strength and fill for that
// hour, and the sky is drawn from the sun in place of an image, so the
// sky, the clouds and the light agree. The key light is the scene's own if
// it has one, made if it has none. Call again to move the sun; a scene
// that sets its own sky after this gets that sky back with the light left
// as the hour set it.
engine_set_time_of_day(e: *Engine, hours: float) {
    e.time_of_day = hours
    light = e.light as *Light
    if light == null {
        light = core.light_directional(core.vec3(0.0, 1.0, 0.0), core.vec3(1.0, 1.0, 1.0), 1.0)
        e.light = light as ptr
    }
    light.direction = sky.sun_direction(hours)
    light.color = sky.sun_color(hours)
    light.intensity = sky.sun_intensity(hours)
    light.ambient_strength = sky.ambient_strength(hours)
    // The haze takes the sky's colour at the horizon, which is what a
    // distance fades into; a fog set for a noon sky was a grey band over a
    // sunset and a bright one over the night.
    if e.fog.enabled {
        e.fog.color = sky.horizon_color(hours)
        if e.running { e.backend_set_fog(e.backend_state, &e.fog) }
    }
    if e.running { engine_set_sky(e, core.SKY_PROCEDURAL) }
}

engine_time_of_day(e: *Engine) -> float { return e.time_of_day }

// The colour behind everything, where no sky or model is: what a scene
// fades to at its horizon.
engine_set_clear_color(e: *Engine, red: float, green: float, blue: float) {
    e.clear_color = core.vec3(red, green, blue)
    if e.backend_state == null { return }
    e.backend_set_clear_color(e.backend_state, red, green, blue)
}

// Clouds over the sky, on either backend: `cover` is how much of the sky
// they take (0 clear, 0.3 a few, 0.8 overcast with holes), `wind` how fast
// they drift as a multiple of scene time. They are marched in the sky
// shader over whatever sky is set, lit by the key light, and throw their
// shadow on the ground through the same coverage the sky draws.
engine_set_clouds(e: *Engine, cover: float, wind: float) {
    e.cloud_cover = cover
    e.cloud_wind = wind
    if e.backend_state == null { return }
    if e.api == platform.API_VULKAN {
        vk.renderer_set_clouds(e.backend_state as *VKRenderer, cover, wind)
    } else {
        gl.renderer_set_clouds(e.gl_renderer as *GLRenderer, cover, wind)
    }
}

// The overcast over the sky: `amount` 0..1 pulls the sky, painted or by
// the hour, toward a flat cast of `color` at the sky's own brightness --
// grey for rain, ochre for a dust storm -- and the clouds, lit by that sky,
// go with it. Zero is the sky as it was.
engine_set_sky_overcast(e: *Engine, amount: float, color: Vec3) {
    e.overcast = amount
    e.overcast_color = color
    if e.backend_state == null { return }
    if e.api == platform.API_VULKAN {
        vk.renderer_set_sky_overcast(e.backend_state as *VKRenderer, amount, color)
    } else {
        gl.renderer_set_sky_overcast(e.gl_renderer as *GLRenderer, amount, color)
    }
}

// The clouds and the overcast as last set, for whatever sets its own over
// them and gives them back.
engine_clouds(e: *Engine) -> float { return e.cloud_cover }
engine_cloud_wind(e: *Engine) -> float { return e.cloud_wind }
engine_sky_overcast(e: *Engine) -> float { return e.overcast }
engine_sky_overcast_color(e: *Engine) -> Vec3 { return e.overcast_color }

// Ambient occlusion from the scene's depth, on either backend: the corners
// and the feet of things go darker by how much stands around them. `radius`
// is the reach of that in metres, `intensity` how dark it goes (1.0 is what
// the depth finds, 0 none).
// What the frame is drawn as: 0 the lit picture, 1 every surface's albedo
// (texture, material and tint, before any light), 2 its world-space
// normals packed 0..1, 3 its motion vectors (a hundred pixels either way
// across the byte, 128 for still). A bake reads its atlases back through
// these, and a look at a scene's normals says why a surface lights the
// way it does.
engine_set_capture_channel(e: *Engine, channel: int) {
    if e.backend_state == null { return }
    if e.api == platform.API_VULKAN {
        vk.renderer_set_capture_channel(e.backend_state as *VKRenderer, channel)
    } else {
        gl.renderer_set_capture_channel(e.gl_renderer as *GLRenderer, channel)
    }
}

// How wet the scene is, 0..1: rain on it. Every surface that faces up goes
// darker, smoother and a mirror at a grazing angle, the way a road does in
// rain; walls hardly, water runs off them. The weather sets it with the
// rain and takes it back with the clear.
// Temporal anti-aliasing: the projection nudged a fraction of a pixel a
// frame through an eight-frame sequence and every frame folded into a
// history found by reprojection, so an edge is supersampled over time and
// the shading's aliasing with it, on both backends. AE3D_TAA=1 turns it
// on in any scene.
engine_set_taa(e: *Engine, on: bool) {
    e.taa = on
    if e.backend_state == null { return }
    if e.api == platform.API_VULKAN {
        vk.renderer_set_taa(e.backend_state as *VKRenderer, on)
    } else {
        gl.renderer_set_taa(e.gl_renderer as *GLRenderer, on)
    }
}

engine_taa(e: *Engine) -> bool { return e.taa }

// DLSS (NVIDIA, through Streamline; Vulkan only) at `mode`: 0 off, 1
// performance, 2 balanced, 3 quality, 4 ultra performance, 5 ultra
// quality, 6 DLAA. The scene is drawn at the render size the mode wants
// and DLSS makes the frame from it, its depth and its motion vectors, in
// the temporal pass's place. Asked for before engine_run (or by
// AE3D_DLSS=n), so the Streamline runtime -- sl.interposer.dll and the
// plugins beside it, from AE3D_STREAMLINE or beside the program -- is
// loaded before Vulkan starts. Returns the mode in force: 0 where DLSS is
// not available, and the frame is drawn as before; engine_dlss_error says
// why.
engine_set_dlss(e: *Engine, mode: int) -> int {
    if mode < 0 { mode = 0 }
    if e.backend_state == null || !e.running {
        e.dlss_mode = mode
        return mode
    }
    if e.api != platform.API_VULKAN { e.dlss_mode = 0 ; return 0 }
    e.dlss_mode = vk.renderer_set_dlss(e.backend_state as *VKRenderer, mode)
    if mode > 0 && e.dlss_mode == 0 {
        println("ae3d: DLSS: ${vk.last_error()}")
    }
    return e.dlss_mode
}

engine_dlss(e: *Engine) -> int { return e.dlss_mode }

// Whether the renderer traces rays (Vulkan with VK_KHR_ray_query).
engine_ray_query(e: *Engine) -> bool {
    if e.backend_state == null || e.api != platform.API_VULKAN { return false }
    return vk.renderer_ray_query(e.backend_state as *VKRenderer)
}

// Shadows by ray, where the renderer traces: a ray toward the sun from
// every lit surface through the scene's acceleration structure, in place
// of the shadow map for the static scene (the map keeps the crowd and the
// skinned, and the two combine). Asked for any time; applied when the
// backend is up; AE3D_RAYS=1 asks on any scene. Nothing changes where the
// device does not trace.
engine_set_ray_shadows(e: *Engine, on: bool) {
    e.ray_shadows = on
    if e.backend_state == null || e.api != platform.API_VULKAN { return }
    vk.renderer_set_ray_shadows(e.backend_state as *VKRenderer, on)
}

engine_ray_shadows(e: *Engine) -> bool { return e.ray_shadows && engine_ray_query(e) }

// The sun's size, as the angle its disc subtends in degrees, for the
// ray-traced shadows' penumbra: zero is a point sun and a hard edge; the
// real sun is about half a degree. AE3D_SUN_SIZE=n sets it from outside, in
// tenths of a degree (5 is the sun).
engine_set_sun_size(e: *Engine, degrees: float) {
    if degrees < 0.0 { degrees = 0.0 }
    e.sun_size = degrees
    if e.backend_state != null && e.api == platform.API_VULKAN {
        vk.renderer_set_sun_size(e.backend_state as *VKRenderer, degrees)
    }
}

engine_sun_size(e: *Engine) -> float { return e.sun_size }

// Occlusion by ray, in the screen-space pass's place, with the same reach
// and strength (engine_set_ssao), where the rays are on and the device
// traces: four rays into the hemisphere over every lit pixel, folded by
// the temporal pass. AE3D_RAY_AO=1 asks for it from outside.
engine_set_ray_occlusion(e: *Engine, on: bool) {
    e.ray_occlusion = on
    if e.backend_state != null && e.api == platform.API_VULKAN {
        vk.renderer_set_ray_occlusion(e.backend_state as *VKRenderer, on)
    }
}

engine_ray_occlusion(e: *Engine) -> bool {
    if !e.ray_occlusion || !e.ssao_on || !engine_ray_shadows(e) { return false }
    return true
}

// Screen-space reflection of the scene in a wet ground plane at
// `road_height` metres, `strength` how much of a mirror it is: a Vulkan
// pass, composited before the bloom so the mirrored lamps bloom with the
// real ones. On OpenGL there is no such pass and this is inert; a wet
// look there is the material's own reflectivity.
//
// Kept here and applied when the backend is up, like the fog and the
// occlusion: set before engine_run it would land in a renderer state the
// backend's start wipes, and the road would stay dry in silence.
engine_set_ssr(e: *Engine, on: bool, road_height: float, strength: float) {
    e.ssr_on = on
    e.ssr_road_height = road_height
    e.ssr_strength = strength
    if e.running { apply_ssr(e) }
}

apply_ssr(e: *Engine) {
    if e.backend_state == null || e.api != platform.API_VULKAN { return }
    vk.renderer_set_ssr_params(e.backend_state as *VKRenderer, e.ssr_road_height, e.ssr_strength)
    vk.renderer_set_ssr(e.backend_state as *VKRenderer, e.ssr_on)
}

// The size of a lamp's face in metres, for the lamp shadows the rays throw
// on Vulkan: with the rays on, every point light shadows what stands
// between it and the surface -- a figure under a street lamp has a shadow
// on the road -- and the size sets how soft. On the map path a lamp has no
// shadow of its own and the key light's stands in.
engine_set_lamp_size(e: *Engine, metres: float) {
    e.lamp_size = metres
    if e.backend_state != null && e.api == platform.API_VULKAN {
        vk.renderer_set_lamp_size(e.backend_state as *VKRenderer, metres)
    }
}

engine_set_wetness(e: *Engine, amount: float) {
    if e.backend_state == null { return }
    if e.api == platform.API_VULKAN {
        vk.renderer_set_wetness(e.backend_state as *VKRenderer, amount)
    } else {
        gl.renderer_set_wetness(e.gl_renderer as *GLRenderer, amount)
    }
}

engine_set_ssao(e: *Engine, on: bool, radius: float, intensity: float) {
    e.ssao_on = on
    e.ssao_radius = radius
    e.ssao_intensity = intensity
    if e.running { apply_ssao(e) }
}

apply_ssao(e: *Engine) {
    if e.backend_state == null { return }
    if e.api == platform.API_VULKAN {
        vk.renderer_set_ssao(e.backend_state as *VKRenderer, e.ssao_on, e.ssao_radius, e.ssao_intensity)
    } else {
        gl.renderer_set_ssao(e.gl_renderer as *GLRenderer, e.ssao_on, e.ssao_radius, e.ssao_intensity)
    }
}

// How many draws the last frame took, from whichever backend drew it.
engine_draw_calls(e: *Engine) -> int {
    if e.backend_state == null { return 0 }
    if e.api == platform.API_VULKAN { return vk.renderer_draw_calls(e.backend_state as *VKRenderer) }
    return gl.renderer_draw_calls(e.gl_renderer as *GLRenderer)
}

// Returns the backend's texture id, or 0 when there is no backend yet or the
// file could not be read. The id is what core.material_set_texture wants.
engine_load_texture(e: *Engine, path: string) -> int {
    if e.backend_state == null { return 0 }
    return e.backend_load_texture(e.backend_state, path)
}

engine_set_decorated(e: *Engine, decorated: bool) { e.decorated = decorated }
engine_set_vsync(e: *Engine, interval: int) { e.vsync = interval }
engine_set_camera_input(e: *Engine, enabled: bool) { e.camera_input = enabled }

// Called as many times a frame as the fixed step fits into it, with the step
// rather than the frame's own delta, which is what a behaviour scene's
// fixed_update wants.
engine_set_fixed_step(e: *Engine, seconds: float) {
    if seconds > 0.0 { e.fixed_step = seconds }
}

engine_set_debug(e: *Engine, on: bool) { core.set_debug(on) }
engine_set_frustum_culling(e: *Engine, on: bool) { core.set_frustum_culling(on) }
engine_set_face_culling(e: *Engine, on: bool) { core.set_face_culling(on) }

engine_camera(e: *Engine) -> *Camera { return e.camera as *Camera }
engine_window(e: *Engine) -> ptr { return e.window }
engine_backend_name(e: *Engine) -> string { return e.backend_name }
engine_gl_renderer(e: *Engine) -> *GLRenderer { return e.gl_renderer as *GLRenderer }
engine_vk_renderer(e: *Engine) -> *VKRenderer { return e.backend_state as *VKRenderer }
engine_delta_time(e: *Engine) -> float { return e.delta_time }
engine_frame_count(e: *Engine) -> int { return e.frame_count }
// Frames a second, over the last half second; before a half second has
// passed, over the run so far, so a short bounded run reports its rate and
// not the zero the window had not filled.
engine_fps(e: *Engine) -> float {
    if e.fps > 0.0 { return e.fps }
    if e.render_seconds > 0.0 && e.frame_count > 0 && e.fps_window > 0.0 {
        return (e.fps_frames * 1.0) / e.fps_window
    }
    return e.fps
}

// The mean cost of submitting a frame, in milliseconds. Answers zero before
// anything has been drawn.
engine_render_ms(e: *Engine) -> float {
    if e == null || e.render_frames == 0 { return 0.0 }
    return e.render_seconds * 1000.0 / (e.render_frames * 1.0)
}

engine_render_frames(e: *Engine) -> int {
    if e == null { return 0 }
    return e.render_frames
}

engine_set_light(e: *Engine, light: *Light) { e.light = light as ptr }

// The key light is the one the scene is lit and shadowed by; these are the
// rest of them. Both renderers have taken several lights since the array went
// into the shader, and the engine could only ever name one, so a street with
// lamps in it could not be lit by them.
engine_add_light(e: *Engine, light: *Light) {
    e.backend_add_light(e.backend_state, light as ptr)
}

engine_remove_light(e: *Engine, light: *Light) {
    e.backend_remove_light(e.backend_state, light as ptr)
}
engine_light(e: *Engine) -> *Light { return e.light as *Light }

// The engine BORROWS a model: it draws it and forgets it when it shuts down,
// and never frees it. Whoever built it frees it, after the engine is gone. The
// renderer releases the list it kept them in and nothing else, which is what
// lets the same model be handed to two backends.
engine_add_model(e: *Engine, m: *Model) {
    e.backend_add_model(e.backend_state, m)
}

engine_remove_model(e: *Engine, m: *Model) {
    e.backend_remove_model(e.backend_state, m)
}

engine_stop(e: *Engine) {
    e.running = false
    if e.window != null { platform.window_close(e.window) }
}

// --- the scene file ------------------------------------------------------------------------------------------

// A system that holds more of a model than the renderer draws: asked, when
// the scene is written, for the attachments (ae3d.scene) it records of the
// models it holds. Physics registers one when it is attached, so a scene
// a program built with bodies opens in the editor with the same bodies.
struct AttachmentProvider {
    answer: fn(ptr) -> ptr         // state -> list of *Attachment, the engine's to free
    state: ptr
}

engine_set_attachment_provider(e: *Engine, answer: fn(ptr) -> ptr, state: ptr) {
    if e.attachment_providers == null { e.attachment_providers = list.new() }
    p = heap.new(AttachmentProvider)
    p.answer = answer
    p.state = state
    list.add_raw(e.attachment_providers, p as ptr)
}

// A system that is going: its provider with it, before its state is freed.
engine_remove_attachment_provider(e: *Engine, state: ptr) {
    if e.attachment_providers == null { return }
    i = 0
    while i < list.size(e.attachment_providers) {
        p = list.get_raw(e.attachment_providers, i) as *AttachmentProvider
        if p.state == state {
            list.remove(e.attachment_providers, i)
            heap.free(p)
        } else {
            i = i + 1
        }
    }
}

// Every provider's attachments in one list, or null when nothing holds
// more than the renderer does. The caller's, freed with
// scene.attachments_free.
engine_attachments(e: *Engine) -> ptr {
    if e.attachment_providers == null { return null }
    out = list.new()
    count = list.size(e.attachment_providers)
    i = 0
    while i < count {
        p = list.get_raw(e.attachment_providers, i) as *AttachmentProvider
        answered = p.answer(p.state)
        if answered != null {
            n = list.size(answered)
            k = 0
            while k < n {
                list.add_raw(out, list.get_raw(answered, k))
                k = k + 1
            }
            list.free(answered)
        }
        i = i + 1
    }
    return out
}

// The models the renderer draws, in its order: the same list the agent
// channel's scene.tree walks. Borrowed; the list is the caller's.
engine_models(e: *Engine) -> ptr {
    out = list.new()
    if e.api == platform.API_VULKAN && e.backend_state != null {
        vkr = e.backend_state as *VKRenderer
        i = 0
        while i < vk.renderer_model_count(vkr) {
            m = vk.renderer_model(vkr, i)
            if m != null { list.add_raw(out, m as ptr) }
            i = i + 1
        }
    } else if e.gl_renderer != null {
        renderer = e.gl_renderer as *GLRenderer
        i = 0
        while i < gl.renderer_model_count(renderer) {
            m = gl.renderer_model(renderer, i)
            if m != null { list.add_raw(out, m as ptr) }
            i = i + 1
        }
    }
    // The scene's objects that hold a transform and nothing to draw --
    // groups, made by engine.object(e, name, null) -- are models the
    // renderer never saw; the file needs them, since what is under one is
    // placed by it.
    scene_objects = behaviour.scene_count(e.scene as *Scene)
    k = 0
    while k < scene_objects {
        o = behaviour.scene_object(e.scene as *Scene, k)
        m = behaviour.object_model(o)
        if m != null && core.mesh_vertex_count(m.mesh) == 0 && scene.index_of_model(out, m) < 0 { list.add_raw(out, m as ptr) }
        k = k + 1
    }
    return out
}

// The scene's light and then the lights added to it, as the scene file
// lists them. Borrowed; the list is the caller's.
engine_lights(e: *Engine) -> ptr {
    out = list.new()
    if e.light != null { list.add_raw(out, e.light) }
    if e.api == platform.API_VULKAN && e.backend_state != null {
        vkr = e.backend_state as *VKRenderer
        i = 0
        while i < vk.renderer_light_count(vkr) {
            l = vk.renderer_light(vkr, i)
            if l != null { list.add_raw(out, l as ptr) }
            i = i + 1
        }
    } else if e.gl_renderer != null {
        renderer = e.gl_renderer as *GLRenderer
        i = 0
        while i < gl.renderer_light_count(renderer) {
            l = gl.renderer_light(renderer, i)
            if l != null { list.add_raw(out, l as ptr) }
            i = i + 1
        }
    }
    return out
}

// The running program's scene as a scene file the editor opens: every
// model the renderer draws, the lights, the camera's view, and what the
// systems record of the models (a body and its collider on each that has
// one). Meshes that came from no file are written beside it, into
// `mesh_directory`. AE3D_SCENE_OUT=path writes it on the first frame,
// once the program's scripts have started -- the scene as the program
// built it, before it moves -- so any example is a scene the editor
// loads and modifies.
engine_save_scene(e: *Engine, path: string, mesh_directory: string) -> bool {
    models = engine_models(e)
    lights = engine_lights(e)
    attachments = engine_attachments(e)
    cam = e.camera as *Camera
    // The view as the program set it: the camera, the sky's hour or its
    // colour, the post chain, the occlusion, the clouds and the overcast.
    view = scene.view_defaults()
    if cam != null {
        view.camera_x = cam.position.x
        view.camera_y = cam.position.y
        view.camera_z = cam.position.z
        view.yaw = cam.yaw
        view.pitch = cam.pitch
        view.fov = cam.fov
        view.near = cam.near
        view.far = cam.far
        view.speed = cam.speed
    }
    view.sky_r = e.clear_color.x
    view.sky_g = e.clear_color.y
    view.sky_b = e.clear_color.z
    view.sky_time = e.time_of_day
    view.fxaa = e.post_fxaa
    view.bloom = e.post_bloom
    view.bloom_threshold = e.post_threshold
    view.bloom_intensity = e.post_intensity
    view.ssao = e.ssao_on
    view.ssao_radius = e.ssao_radius
    view.ssao_intensity = e.ssao_intensity
    view.clouds = e.cloud_cover > 0.0
    view.cloud_cover = e.cloud_cover
    view.overcast = e.overcast
    view.frustum_culling = core.frustum_culling()
    view.face_culling = core.face_culling()
    view.ssr = e.ssr_on
    view.ssr_road_height = e.ssr_road_height
    view.ssr_strength = e.ssr_strength
    view.fog = e.fog.enabled
    view.fog_start = e.fog.start
    view.fog_end = e.fog.end
    view.fog_intensity = e.fog.intensity
    view.fog_r = e.fog.color.x
    view.fog_g = e.fog.color.y
    view.fog_b = e.fog.color.z
    ok = scene.scene_save(models, lights, attachments, &view, path, mesh_directory)
    if !ok { println("ae3d: the scene could not be written to ${path}: ${scene.last_error()}") }
    scene.attachments_free(attachments)
    list.free(models)
    list.free(lights)
    return ok
}

// AE3D_SCENE_OUT=path writes the scene on the first frame, once every
// script has started; the meshes go beside it, in a directory named after
// the file.
scene_out_from_env(e: *Engine) {
    path = core.text(os.getenv("AE3D_SCENE_OUT"))
    if path == "" { return }
    directory = string.concat(path, "_meshes/")
    fs.fs_mkdir_p_raw(directory)
    if engine_save_scene(e, path, directory) {
        println("ae3d: scene written to ${path}")
    }
    string.free(directory)
}

engine_mouse_x(e: *Engine) -> float { return platform.cursor_x(e.window) }
engine_mouse_y(e: *Engine) -> float { return platform.cursor_y(e.window) }
engine_mouse_down(e: *Engine, button: int) -> bool { return platform.mouse_down(e.window, button) }
engine_key_down(e: *Engine, key: int) -> bool { return platform.key_down(e.window, key) }

// One-call path: open the window, initialise the backend, start the
// behaviours, run the loop, then tear everything down. Programs that need to
// interleave their own work can call engine_start / engine_loop /
// engine_shutdown directly. The window goes where the system puts it;
// engine_run_at names a position.
engine_run(e: *Engine) -> bool {
    return engine_run_at(e, 0 - 1, 0 - 1)
}

engine_run_at(e: *Engine, x: int, y: int) -> bool {
    if !engine_start(e, x, y) { return false }
    run_starts(e)
    engine_loop(e)
    engine_shutdown(e)
    return true
}

engine_start(e: *Engine, x: int, y: int) -> bool {
    if !platform.init() {
        println("ae3d: ${platform.error()}")
        return false
    }

    size_from_env(e)
    hidden_from_env(e)

    e.window = platform.window_create(e.width, e.height, e.title,
                                      e.api, e.msaa, e.decorated, e.visible,
                                      32)
    if e.window == null {
        println("ae3d: could not create window: ${platform.error()}")
        platform.shutdown()
        return false
    }
    input.input_set_window(e.input as *Input, e.window)

    if x < 0 || y < 0 {
        platform.window_center(e.window)
    } else {
        platform.window_set_pos(e.window, x, y)
    }

    // AE3D_AGENT is the only thing that turns this on. Unset, agent.start()
    // opens nothing, agent_on stays false, and the frame loop never reaches the
    // channel at all.
    e.agent_on = agent.start()
    if e.agent_on {
        e.agent_ctx = agent.context_new()
    } else {
        if agent.last_error() != "" { println("ae3d: agent channel: ${agent.last_error()}") }
    }

    if e.api != platform.API_VULKAN { platform.window_set_vsync(e.vsync) }

    // DLSS wanted, by the program or by AE3D_DLSS=n: the runtime before
    // the backend, since its interposer has to be the Vulkan loader.
    if core.env_int("AE3D_DLSS", 0) > 0 { e.dlss_mode = core.env_int("AE3D_DLSS", 0) }
    if e.api == platform.API_VULKAN { vk.set_samples(e.msaa) }
    if e.dlss_mode > 0 && e.api == platform.API_VULKAN {
        if !vk.request_dlss(core.text(os.getenv("AE3D_STREAMLINE"))) {
            println("ae3d: DLSS: ${vk.last_error()}")
            e.dlss_mode = 0
        }
    }

    if e.backend_init(e.backend_state, e.window, e.width, e.height) != 1 {
        println("ae3d: ${e.backend_name} backend failed to initialise")
        platform.window_destroy(e.window)
        e.window = null
        platform.shutdown()
        return false
    }

    apply_shadows(e)
    e.backend_set_fog(e.backend_state, &e.fog)
    e.backend_set_shadow_distance(e.backend_state, e.shadow_distance)
    e.camera = core.camera_new(e.width, e.height) as ptr
    platform.window_set_cursor_mode(e.window, platform.CURSOR_NORMAL)
    e.running = true
    g_running = e as ptr
    // What was made before the backend was up.
    pending = list.size(e.pending_models)
    i = 0
    while i < pending {
        e.backend_add_model(e.backend_state, list.get_raw(e.pending_models, i) as *Model)
        i = i + 1
    }
    list.clear(e.pending_models)
    apply_ssao(e)
    // Asked for before the backend was up, or by AE3D_TAA=1.
    if core.env_int("AE3D_TAA", 0) == 1 { e.taa = true }
    if e.taa { engine_set_taa(e, true) }
    if core.env_int("AE3D_RAYS", 0) == 1 { e.ray_shadows = true }
    tenths = core.env_int("AE3D_SUN_SIZE", 0 - 1)
    if tenths >= 0 { e.sun_size = (tenths as float) / 10.0 }
    if e.sun_size > 0.0 { engine_set_sun_size(e, e.sun_size) }
    if core.env_int("AE3D_RAY_AO", 0) == 1 { e.ray_occlusion = true }
    if e.ray_occlusion { engine_set_ray_occlusion(e, true) }
    if e.lamp_size > 0.0 { engine_set_lamp_size(e, e.lamp_size) }
    if e.ssr_on { apply_ssr(e) }
    if e.ray_shadows {
        engine_set_ray_shadows(e, true)
        if engine_ray_query(e) { println("ae3d: shadows by ray") } else { println("ae3d: no ray query on this device; the shadow map stands") }
    }
    if e.dlss_mode > 0 {
        wanted = e.dlss_mode
        e.dlss_mode = 0
        engine_set_dlss(e, wanted)
        if e.dlss_mode > 0 {
            println("ae3d: DLSS on, mode ${e.dlss_mode}")
        } else if !e.taa {
            // Asked for and not there: the frame has no multisampling
            // (an upscaler wants none), so the temporal pass stands in.
            engine_set_taa(e, true)
        }
    }
    // AE3D_CAPTURE=n draws the frame as a capture channel (1 albedo, 2
    // normals, 3 motion), so a snapshot can be read as numbers.
    channel = core.env_int("AE3D_CAPTURE", 0)
    if channel > 0 { engine_set_capture_channel(e, channel) }
    // AE3D_RENDER_SCALE=50 draws the scene at half the window's size (in
    // hundredths), the composite scaling it up.
    scale = core.env_int("AE3D_RENDER_SCALE", 100)
    if scale > 0 && scale < 100 { engine_set_render_scale(e, scale as float / 100.0) }
    if e.time_of_day >= 0.0 { engine_set_sky(e, core.SKY_PROCEDURAL) }
    return true
}

// Fills the channel's view of this frame and answers whatever is queued.
//
// Only ever reached when the channel is on. Everything it reads is a number the
// engine already had, so the work is assembling an answer for a client that
// asked, not gathering anything a frame would otherwise not have gathered.
pump_agent(e: *Engine) {
    c = e.agent_ctx as *Context

    c.camera = e.camera
    c.light = e.light
    c.input = e.input
    c.gl_renderer = e.gl_renderer
    c.animations = e.animations
    c.on_pose = poses_for_agent as fn(ptr)
    c.on_attachments = attachments_for_agent as fn(ptr) -> ptr
    c.user_data = e as ptr
    c.vk_renderer = null
    if e.api == platform.API_VULKAN { c.vk_renderer = e.backend_state }
    c.backend = e.backend_name
    c.frame_count = e.frame_count
    c.fps = e.fps
    c.render_ms = engine_render_ms(e)
    c.shadow_ms = 0.0
    c.scene_ms = 0.0
    c.post_ms = 0.0
    // On OpenGL the render time is already the work: the buffer swap that waits
    // for vsync is timed apart from backend_render. On Vulkan the acquire wait
    // is inside it, so the Vulkan branch below overrides this with the figure
    // measured after that wait.
    c.cpu_work_ms = c.render_ms
    c.post_active = false
    c.device = ""
    if e.api == platform.API_VULKAN {
        c.device = vk.device_name()
    } else {
        c.device = gl.device_name()
    }
    c.program_binds = 0
    c.material_binds = 0
    c.texture_binds = 0
    c.triangles = 0
    if e.gl_renderer != null {
        renderer = e.gl_renderer as *GLRenderer
        c.shadow_ms = gl.renderer_shadow_ms(renderer)
        c.scene_ms = gl.renderer_scene_ms(renderer)
        c.post_ms = gl.renderer_post_ms(renderer)
        c.post_active = gl.renderer_post_active(renderer)
        c.program_binds = gl.renderer_program_binds(renderer)
        c.material_binds = gl.renderer_material_binds(renderer)
        c.texture_binds = gl.renderer_texture_binds(renderer)
        i = 0
        while i < gl.renderer_model_count(renderer) {
            m = gl.renderer_model(renderer, i)
            if m != null && m.visible {
                c.triangles = c.triangles + core.mesh_index_count(m.mesh) / 3
            }
            i = i + 1
        }
    }
    // The same figures from the other backend, so a frame drawn with Vulkan
    // answers what it is made of and what each pass cost, rather than zeros.
    // Triangles and lights are counted the same way; the shadow map is a GL
    // texture handle and has no Vulkan equivalent worth inventing one for.
    if e.api == platform.API_VULKAN && e.backend_state != null {
        vkr = e.backend_state as *VKRenderer
        c.shadow_ms = vk.renderer_shadow_ms(vkr)
        c.scene_ms = vk.renderer_scene_ms(vkr)
        c.post_ms = vk.renderer_post_ms(vkr)
        c.cpu_work_ms = vk.renderer_cpu_work_ms(vkr)
        c.post_active = vk.renderer_post_active(vkr)
        c.program_binds = vk.renderer_program_binds(vkr)
        c.material_binds = vk.renderer_material_binds(vkr)
        i = 0
        while i < vk.renderer_model_count(vkr) {
            m = vk.renderer_model(vkr, i)
            if m != null && m.visible {
                c.triangles = c.triangles + core.mesh_index_count(m.mesh) / 3
            }
            i = i + 1
        }
    }
    c.delta = e.delta_time
    c.width = e.width
    c.height = e.height
    c.draw_calls = 0
    c.shadow_map = 0
    c.light_count = 0
    if e.gl_renderer != null {
        c.draw_calls = gl.renderer_draw_calls(e.gl_renderer)
        c.shadow_map = gl.renderer_shadow_map(e.gl_renderer as *GLRenderer)
        c.light_count = gl.renderer_light_count(e.gl_renderer as *GLRenderer)
    }
    if e.api == platform.API_VULKAN && e.backend_state != null {
        vkr = e.backend_state as *VKRenderer
        c.draw_calls = vk.renderer_draw_calls(vkr)
        c.light_count = vk.renderer_light_count(vkr)
    }
    c.shadows = engine_shadows(e)
    c.fog_enabled = e.fog.enabled

    // A step still owed from an earlier frame is settled before anything new is
    // drained, so a client that pipelined a step and a query gets them in order.
    if e.agent_steps_left > 0 {
        e.agent_steps_left = e.agent_steps_left - 1
        if e.agent_steps_left == 0 {
            // Back to held, which is where the step started. An agent that
            // stepped asked to look at a particular frame, not to be handed
            // back a running engine.
            c.paused = true
            agent.answer_step(c)
        }
        return
    }

    agent.pump(c)

    if c.want_pause {
        c.want_pause = false
        c.paused = true
    }
    if c.want_resume {
        c.want_resume = false
        c.paused = false
    }
    if c.want_steps > 0 {
        c.paused = false
        e.agent_steps_left = c.want_steps
        c.want_steps = 0
    }
    if c.want_stop {
        c.want_stop = false
        engine_stop(e)
    }
}

// A finished frame is only readable between the last draw and the buffer swap.
// Called from there, which is why the agent's snapshot is not taken where the
// rest of its work happens: after the swap the back buffer holds nothing this
// frame put in it, and the file came out empty with an "ok" already sent.
// Whether a frame read is waiting, so the Vulkan capture can be armed before
// the frame that will answer it is drawn.
agent_wants_snapshot(e: *Engine) -> bool {
    if e.agent_ctx == null { return false }
    c = e.agent_ctx as *Context
    return c.pending_snapshot_id >= 0
}

agent_wants_capture(e: *Engine) -> bool {
    if e.agent_ctx == null { return false }
    c = e.agent_ctx as *Context
    return c.want_capture
}

service_agent_capture(e: *Engine) {
    c = e.agent_ctx as *Context
    if !agent.wants_deferred(c) { return }
    agent.clear_deferred(c)
    // A frame of pixels is read back only when a read actually needs it -- a
    // grid, a pixel, a capture. A skeleton read is deferred to the same frame
    // boundary but wants no pixels, so it does not pay for a readback.
    need_pixels = agent.wants_capture(c)
    agent.clear_capture(c)
    captured = false
    if need_pixels {
        if e.api == platform.API_VULKAN {
            // Copied out as the frame was submitted; read it back and hand it
            // to the same capture the OpenGL path fills, so the agent sees the
            // Vulkan frame as numbers exactly as it sees the OpenGL one.
            if vk.capture_ready() {
                pixels = vk.capture_pixels()
                if pixels != null {
                    captured = agent.capture_adopt(pixels, vk.capture_width(),
                                                   vk.capture_height())
                }
            }
        } else {
            width = platform.window_fb_width(e.window)
            height = platform.window_fb_height(e.window)
            captured = agent.capture_frame(width, height)
        }
    }
    if c.pending_capture_id >= 0 { agent.answer_capture(c, captured) }
    agent.answer_pending_trace(c)
    agent.answer_deferred(c)
}

service_agent_snapshot(e: *Engine) {
    c = e.agent_ctx as *Context
    if c.pending_snapshot_id < 0 { return }

    path = c.want_snapshot
    c.want_snapshot = ""
    // On Vulkan the frame was copied out as it was submitted, since the
    // capture was armed for a pending snapshot before backend_render; the
    // answer arrives with the file, the same as on OpenGL.
    if e.api == platform.API_VULKAN {
        agent.answer_snapshot(c, path, vk.snapshot(path))
        string.free(path)
        return
    }
    width = platform.window_fb_width(e.window)
    height = platform.window_fb_height(e.window)
    agent.answer_snapshot(c, path, gl.snapshot(path, width, height))
    string.free(path)
}

// The last frame's costs, added to the run's. The first frames are left
// out: they carry the uploads and the pipeline builds, which are the cost
// of starting and not of a frame.
account_perf(e: *Engine) {
    if e.frame_count <= 10 { e.perf_started = platform.time(); return }
    shadow = 0.0
    scene = 0.0
    post = 0.0
    cpu = 0.0
    if e.api == platform.API_VULKAN {
        vkr = e.backend_state as *VKRenderer
        shadow = vk.renderer_shadow_ms(vkr)
        scene = vk.renderer_scene_ms(vkr)
        post = vk.renderer_post_ms(vkr)
        cpu = vk.renderer_cpu_work_ms(vkr)
        stages = e.perf_stage_ms as float[]
        k = 0
        while k < vk.STAGE_COUNT {
            stages[k] = stages[k] + vk.renderer_stage_ms(vkr, k)
            k = k + 1
        }
    } else {
        glr = e.gl_renderer as *GLRenderer
        shadow = gl.renderer_shadow_ms(glr)
        scene = gl.renderer_scene_ms(glr)
        post = gl.renderer_post_ms(glr)
        cpu = engine_render_ms(e)
    }
    e.perf_frames = e.perf_frames + 1
    e.perf_shadow_ms = e.perf_shadow_ms + shadow
    e.perf_scene_ms = e.perf_scene_ms + scene
    e.perf_post_ms = e.perf_post_ms + post
    e.perf_cpu_ms = e.perf_cpu_ms + cpu
    e.perf_update_ms = e.perf_update_ms + e.update_seconds * 1000.0
    e.perf_draws = e.perf_draws + engine_draw_calls(e)
}

// One line, machine-readable, the same on every backend: what a frame of
// this run cost on the device and on the CPU, on average, past the first ten.
say_perf(e: *Engine) {
    if !e.perf_on || e.perf_frames <= 0 { return }
    n = e.perf_frames * 1.0
    wall = platform.time() - e.perf_started
    fps = 0.0
    if wall > 0.0 { fps = n / wall }
    println("perf backend=${e.backend_name} frames=${e.perf_frames} fps=${fps} gpu_shadow_ms=${e.perf_shadow_ms / n} gpu_scene_ms=${e.perf_scene_ms / n} gpu_post_ms=${e.perf_post_ms / n} cpu_ms=${e.perf_cpu_ms / n} update_ms=${e.perf_update_ms / n} draws=${e.perf_draws / e.perf_frames} width=${e.width} height=${e.height}")
    if e.api == platform.API_VULKAN {
        // The scene's own split, which is where a frame's cost is.
        stages = e.perf_stage_ms as float[]
        line = "perf stages"
        k = 3
        while k < vk.STAGE_COUNT {
            line = "${line} ${vk.stage_name(k)}=${stages[k] / n}"
            k = k + 1
        }
        println(line)
    }
}

engine_shutdown(e: *Engine) {
    // Between runs there is no running engine for a script to find.
    if g_running == e as ptr { g_running = null }
    say_perf(e)
    if e.agent_on {
        agent.capture_release()
        agent.stop()
        agent.context_free(e.agent_ctx as *Context)
        e.agent_ctx = null
        e.agent_on = false
    }
    if e.window == null { return }
    e.backend_cleanup(e.backend_state)
    platform.window_destroy(e.window)
    e.window = null
    platform.shutdown()
}

engine_loop(e: *Engine) {
    cam = e.camera as *Camera
    last_time = platform.time()
    last_width = e.width
    last_height = e.height

    while e.running && !platform.window_should_close(e.window) {
        now = platform.time()
        delta = now - last_time
        last_time = now
        // A stall is not a frame. The frame in which the scripts start
        // spans whatever they load (the street reads its export in it), a
        // window dragged or a debugger held stops the clock for seconds,
        // and handing that to the simulation ran it all at once: the car
        // was thirty metres down the road on the eighth frame. Past a
        // quarter second the world takes a quarter second and the rest is
        // let go, the way every game loop does.
        if delta > MAX_FRAME_SECONDS { delta = MAX_FRAME_SECONDS }

        // A held frame still draws, so the window stays alive and the scene can
        // be queried and snapshotted; it just does not advance. Time stops and
        // the counter stops with it, which is what lets an agent read the same
        // frame twice and get the same answer.
        held = false
        if e.agent_on { held = agent.is_paused(e.agent_ctx as *Context) }
        if held { delta = 0.0 }
        e.delta_time = delta

        e.fps_window = e.fps_window + delta
        e.fps_frames = e.fps_frames + 1
        if e.fps_window >= 0.5 {
            e.fps = (e.fps_frames * 1.0) / e.fps_window
            e.fps_window = 0.0
            e.fps_frames = 0
        }

        width = platform.window_fb_width(e.window)
        height = platform.window_fb_height(e.window)
        if width != last_width || height != last_height {
            if width > 0 && height > 0 {
                e.width = width
                e.height = height
                e.backend_update_viewport(e.backend_state, width, height)
                core.camera_set_aspect(cam, (width * 1.0) / (height * 1.0))
            }
            last_width = width
            last_height = height
        }

        // The input first, so every script in the frame reads the same
        // state and an edge (pressed, released) is between two frames.
        input.poll(e.input as *Input)
        if e.camera_input { fly_camera(e, cam, delta) }

        // The accumulator was drained a step at a time and nothing was called
        // in between, so the fixed step was a number the engine subtracted from
        // itself: a program that set one and waited for it waited forever, and
        // a behaviour scene's fixed_update had to be driven by hand.
        update_started = platform.time()
        if !held {
            e.fixed_accumulator = e.fixed_accumulator + delta
            while e.fixed_accumulator >= e.fixed_step {
                e.fixed_accumulator = e.fixed_accumulator - e.fixed_step
                run_fixed_updates(e, e.fixed_step)
            }
            // With the simulation, not beside it: a held frame freezes the
            // playheads too, or an agent that paused to look at a pose would
            // find a different one each time it asked.
            anim.registry_advance(e.animations as *Registry, delta)
            run_updates(e, delta)
        } else {
            // Frozen, not skipped. on_pose writes to the same local transforms
            // the clips do, so a held frame that did not re-apply them would
            // hand the next solve its own output and the pose would creep
            // while the playhead stood still.
            anim.registry_apply(e.animations as *Registry)
        }

        // The pose phase runs on a held frame too: a pose an agent seeks to
        // is a pose it wants solved, or it is looking at half an answer.
        run_poses(e)
        e.update_seconds = platform.time() - update_started
        // The scene file of the first frame: every script has started and
        // built its objects, and nothing has moved yet.
        if e.frame_count == 0 && !e.scene_written && !held {
            e.scene_written = true
            scene_out_from_env(e)
        }

        // A Vulkan frame is copied out as it is submitted, so any read of it --
        // a snapshot, or an agent grid or pixel read -- has to be armed on this
        // frame, before backend_render records the copy that the servicing
        // below then reads. A snapshot arms on each of the frames it is
        // written on -- the last, or the last N of a burst; an agent capture
        // arms whenever one is waiting.
        shot_frame = e.frame_limit > 0 && e.frame_count + 1 > e.frame_limit - snapshot_burst(e)
        if e.api == platform.API_VULKAN {
            want_shot = shot_frame && snapshot_path(e) != ""
            want_read = e.agent_on && (agent_wants_capture(e) || agent_wants_snapshot(e))
            if want_shot || want_read {
                if !vk.request_capture() { println("ae3d: Vulkan would not arm a capture") }
            }
        }
        render_started = platform.time()
        e.backend_render(e.backend_state, cam, e.light)
        e.render_seconds = e.render_seconds + (platform.time() - render_started)
        e.render_frames = e.render_frames + 1

        run_late_updates(e, delta)

        // Before the swap, because after it the back buffer holds nothing this
        // frame put there.
        if e.frame_limit > 0 && e.frame_count + 1 > e.frame_limit - snapshot_burst(e) {
            write_snapshot(e)
        }
        if e.agent_on {
            service_agent_capture(e)
            service_agent_snapshot(e)
        }

        if e.api != platform.API_VULKAN { platform.window_swap(e.window) }
        platform.poll_events()
        if !held { e.frame_count = e.frame_count + 1 }

        // Last thing in the frame: the numbers a query reports are the finished
        // frame's, and a snapshot taken now is of a frame that exists.
        if e.agent_on { pump_agent(e) }
        if e.perf_on && !held { account_perf(e) }

        if e.frame_limit > 0 && e.frame_count >= e.frame_limit { e.running = false }
    }
}

process_mouse_look(e: *Engine, cam: *Camera) {
    x = platform.cursor_x(e.window)
    y = platform.cursor_y(e.window)

    if e.first_mouse {
        e.last_mouse_x = x
        e.last_mouse_y = y
        e.first_mouse = false
        return
    }

    core.camera_process_mouse(cam, x - e.last_mouse_x, e.last_mouse_y - y, true)
    e.last_mouse_x = x
    e.last_mouse_y = y
}
