// Window, main loop and backend selection.
//
// The engine owns the window and drives one `Backend` vtable, so switching
// between the OpenGL and Vulkan renderers is a constructor argument and nothing
// else in a program changes.

import std.heap
import std.list
import std.string
import ae3d.core
import ae3d.platform
import ae3d.gl
import ae3d.vk
import ae3d.agent
import ae3d.anim
import std.os

exports (
    Engine,
    engine_new, engine_free, engine_run, engine_start, engine_loop, engine_shutdown,
    engine_stop, engine_on_start,
    engine_add_model, engine_remove_model, engine_set_light, engine_light,
    engine_add_light, engine_remove_light,
    engine_camera, engine_window, engine_backend_name,
    engine_set_size, engine_set_title, engine_set_msaa, engine_set_decorated, engine_set_post,
    engine_set_render_scale, engine_set_shadows, engine_shadows, engine_set_fog, engine_fog, engine_set_shadow_distance, engine_shadow_distance,
    engine_set_vsync, engine_set_camera_input, engine_set_fixed_step,
    engine_set_skybox, engine_load_texture,
    engine_delta_time, engine_frame_count, engine_fps, engine_set_frame_limit,
    engine_render_ms, engine_render_frames,
    engine_set_debug, engine_set_frustum_culling, engine_set_face_culling,
    engine_on_update, engine_on_fixed_update, engine_on_render, engine_on_pose,
    engine_set_user_data, engine_user_data,
    engine_add_animation, engine_animations,
    engine_gl_renderer, engine_vk_renderer, engine_mouse_x, engine_mouse_y, engine_mouse_down, engine_key_down
)

struct Engine {
    window: ptr
    camera: ptr
    light: ptr
    backend_state: ptr
    gl_renderer: ptr
    api: int

    backend_init: fn(ptr, ptr, int, int) -> int
    backend_render: fn(ptr, ptr, ptr)
    backend_add_model: fn(ptr, ptr)
    backend_remove_model: fn(ptr, ptr)
    backend_load_texture: fn(ptr, string) -> int
    backend_set_skybox: fn(ptr, ptr)
    backend_update_viewport: fn(ptr, int, int)
    backend_set_post: fn(ptr, int, int, float, float)
    backend_set_shadows: fn(ptr, int)
    backend_set_fog: fn(ptr, ptr)
    backend_set_shadow_distance: fn(ptr, float)
    backend_add_light: fn(ptr, ptr)
    backend_remove_light: fn(ptr, ptr)
    backend_shadows: fn(ptr) -> int
    backend_set_render_scale: fn(ptr, float) -> float
    backend_cleanup: fn(ptr)
    backend_name: string

    on_start: fn(ptr)
    on_update: fn(ptr, float)
    on_fixed_update: fn(ptr, float)
    on_render: fn(ptr, float)
    on_pose: fn(ptr)
    user_data: ptr

    width: int
    height: int
    msaa: int
    title: string
    decorated: bool
    visible: bool
    vsync: int
    camera_input: bool
    shadows: bool
    shadow_distance: float
    fog: Fog

    fixed_step: float
    fixed_accumulator: float
    delta_time: float
    // What the frames drawn so far cost to submit, and how many there were.
    // The GPU is not waited on, so this is the CPU's half: the scene walk, the
    // culling, the uniforms and the draw calls, which is the half a scene
    // grows out of and the half a benchmark on a shared runner can trust.
    render_seconds: float
    render_frames: int
    frame_count: int
    fps: float
    fps_window: float
    fps_frames: int

    last_mouse_x: float
    last_mouse_y: float
    first_mouse: bool
    running: bool

    // The agent channel. agent_on is read once a frame and is false in every
    // build that did not ask for the channel, which is what keeps it free.
    agent_on: bool
    agent_ctx: ptr
    animations: ptr
    agent_steps_left: int
    frame_limit: int
}

engine_new(api: int) -> *Engine {
    e = heap.new(Engine)
    e.api = api
    e.width = 1024
    e.height = 768
    e.msaa = 4
    e.title = "ae3d"
    e.decorated = true
    e.visible = true
    e.vsync = 1
    e.camera_input = true
    e.shadows = true
    e.fog = core.fog_none()
    e.fixed_step = 1.0 / 60.0
    e.first_mouse = true
    e.frame_limit = frame_limit_from_env()
    e.animations = anim.registry_new() as ptr

    if api == platform.API_VULKAN {
        vulkan_state = vk.renderer_new()
        e.backend_state = vulkan_state as ptr
        e.gl_renderer = null
        bind_backend(e, vk.backend(vulkan_state))
    } else {
        opengl_state = gl.renderer_new()
        e.backend_state = opengl_state as ptr
        e.gl_renderer = opengl_state as ptr
        bind_backend(e, gl.backend(opengl_state))
    }
    return e
}

// AE3D_FRAMES caps the loop so any example doubles as a smoke test that
// terminates on its own; unset or zero means run until the window closes.
frame_limit_from_env() -> int {
    return core.env_int("AE3D_FRAMES", 0)
}

// AE3D_WIDTH and AE3D_HEIGHT override the size a program asked for, applied
// here rather than in engine_new so that a program setting its own size does
// not overwrite them.
//
// A software rasteriser costs what it draws, and this engine's fragment shader
// is not a cheap one: the same run at a quarter of the width and a quarter of
// the height does everything it did -- every frame, every draw, every branch of
// the shader -- for a sixteenth of the pixels. That is the difference between
// a smoke test that runs on a runner with no GPU and one that is billed for a
// software rasteriser drawing a million pixels a frame.
size_from_env(e: *Engine) {
    width = core.env_int("AE3D_WIDTH", 0)
    height = core.env_int("AE3D_HEIGHT", 0)
    if width > 0 { e.width = width }
    if height > 0 { e.height = height }
}

// AE3D_HIDDEN keeps the window off the screen. The frame is still drawn --
// same passes, same draws, same pixels -- so everything the agent channel reads
// reads the same; the window simply never appears, never takes focus and never
// reaches the taskbar.
//
// This is what an agent inspecting a scene wants. It is measuring the frame,
// not watching it, and a run that seizes the screen every time cannot be run on
// a machine somebody is using. It is also what a windowed CI runner wants,
// where a dozen examples each flashing up a window is a dozen chances to steal
// focus from the test that is actually running.
hidden_from_env(e: *Engine) {
    if core.env_int("AE3D_HIDDEN", 0) != 0 { e.visible = false }
}

// AE3D_SNAPSHOT writes the last frame of a bounded run to a PNG.
//
// Running an example proves it does not crash and counting its draws proves it
// asked for something. Neither says what came out, and that is the difference
// between an example that renders the scene it is named after and one that
// renders a flat wash of a single colour: both exit zero with the same number
// of draws. The only way to tell them apart is to look at the frame.
snapshot_path(e: *Engine) -> string {
    return core.text(os.getenv("AE3D_SNAPSHOT"))
}

// Taken between the last draw and the buffer swap, which is the only moment a
// windowed program's finished frame is still readable.
write_snapshot(e: *Engine) {
    path = snapshot_path(e)
    if path == "" { return }
    if e.api == platform.API_VULKAN {
        println("ae3d: AE3D_SNAPSHOT needs the OpenGL backend")
        return
    }
    width = platform.window_fb_width(e.window)
    height = platform.window_fb_height(e.window)
    if !gl.snapshot(path, width, height) {
        println("ae3d: could not write ${path}")
    }
}

engine_set_frame_limit(e: *Engine, frames: int) {
    e.frame_limit = frames
}

// Binds a player to a model and takes ownership of the player. The clip is not
// taken: one clip drives many players, and freeing it here would pull it out
// from under the others.
//
// The name is what an agent asks for over the channel. An index shifts when the
// scene changes; a name does not.
engine_add_animation(e: *Engine, name: string, p: *Player, m: *Model) -> int {
    return anim.registry_add(e.animations as *Registry, name, p, m)
}

engine_animations(e: *Engine) -> ptr {
    return e.animations
}

bind_backend(e: *Engine, b: Backend) {
    e.backend_init = b.init
    e.backend_render = b.render
    e.backend_add_model = b.add_model
    e.backend_remove_model = b.remove_model
    e.backend_load_texture = b.load_texture
    e.backend_set_skybox = b.set_skybox
    e.backend_set_post = b.set_post
    e.backend_set_shadows = b.set_shadows
    e.backend_set_fog = b.set_fog
    e.backend_set_shadow_distance = b.set_shadow_distance
    e.backend_add_light = b.add_light
    e.backend_remove_light = b.remove_light
    e.backend_shadows = b.shadows
    e.backend_set_render_scale = b.set_render_scale
    e.backend_update_viewport = b.update_viewport
    e.backend_cleanup = b.cleanup
    e.backend_name = b.name
}

engine_free(e: *Engine) {
    if e == null { return }
    if e.animations != null {
        anim.registry_free(e.animations as *Registry)
        e.animations = null
    }
    if e.camera != null { core.camera_free(e.camera as *Camera) }
    if e.api == platform.API_VULKAN {
        vk.renderer_free(e.backend_state as *VKRenderer)
    } else {
        gl.renderer_free(e.backend_state as *GLRenderer)
    }
    heap.free(e)
}

engine_set_size(e: *Engine, width: int, height: int) {
    e.width = width
    e.height = height
}

engine_set_title(e: *Engine, title: string) {
    e.title = title
    if e.window != null { platform.window_set_title(e.window, title) }
}

engine_set_msaa(e: *Engine, samples: int) { e.msaa = samples }

// Post-processing is a backend capability rather than a renderer-specific call,
// so switching backends does not change what a scene looks like.
engine_set_post(e: *Engine, fxaa: bool, bloom: bool, threshold: float, intensity: float) {
    if e.backend_state == null { return }
    fx = 0
    if fxaa { fx = 1 }
    bl = 0
    if bloom { bl = 1 }
    e.backend_set_post(e.backend_state, fx, bl, threshold, intensity)
}
// Shadows are a property of the scene rather than of the moment a program
// happens to ask for them, so this is remembered and applied once the backend
// has a device to build the map on. Both backends drop renderer state at init,
// since the OpenGL map needs a live context and the Vulkan one is wired into
// descriptor sets that init recreates, so a program that configured its engine
// before engine_run was talking to nothing.
engine_set_shadows(e: *Engine, on: bool) {
    e.shadows = on
    if e.running { apply_shadows(e) }
}

// The air the scene is seen through. Kept here rather than set straight
// through, for the same reason shadows are: a backend has no device to hold it
// on until the window is open.
engine_set_fog(e: *Engine, f: Fog) {
    e.fog = f
    if e.running { e.backend_set_fog(e.backend_state, &e.fog) }
}

engine_fog(e: *Engine) -> Fog { return e.fog }

// How far from the camera shadows reach. Zero, the default, fits the shadow
// map to the whole scene; a scene with a horizon in it wants a bound, or the
// map is spread so thin that nothing standing on the ground casts anything.
engine_set_shadow_distance(e: *Engine, metres: float) {
    e.shadow_distance = metres
    if e.running { e.backend_set_shadow_distance(e.backend_state, metres) }
}

engine_shadow_distance(e: *Engine) -> float { return e.shadow_distance }

// What the backend managed rather than what was asked for: a device that could
// not build the map reports false here.
engine_shadows(e: *Engine) -> bool {
    if !e.running { return e.shadows }
    return e.backend_shadows(e.backend_state) == 1
}

apply_shadows(e: *Engine) {
    flag = 0
    if e.shadows { flag = 1 }
    e.backend_set_shadows(e.backend_state, flag)
}

// Draw the scene smaller than the window. The answer is the scale the backend
// adopted rather than the one asked for, so a program stepping down a quality
// ladder is told which rungs exist on the renderer it happens to have got.
engine_set_render_scale(e: *Engine, scale: float) -> float {
    if e.backend_state == null { return 1.0 }
    return e.backend_set_render_scale(e.backend_state, scale)
}

// The two backend capabilities the engine held a hook for and never called.
// Both backends implement them, core exports the skybox constructors, and the
// vtable entries were copied into the Engine at bind time, so everything was
// in place except the call: a program written against the engine surface could
// not put a sky behind its scene or load a texture, whichever backend it ran
// on. The Skybox itself is still made by the backend that will draw it
// (gl.skybox_create / vk.skybox_create), the same way engine_gl_renderer is
// already how a program reaches backend-specific construction.
engine_set_skybox(e: *Engine, skybox: ptr) {
    if e.backend_state == null { return }
    e.backend_set_skybox(e.backend_state, skybox)
}

// Returns the backend's texture id, or 0 when there is no backend yet or the
// file could not be read. The id is what core.material_set_texture wants.
engine_load_texture(e: *Engine, path: string) -> int {
    if e.backend_state == null { return 0 }
    return e.backend_load_texture(e.backend_state, path)
}

engine_set_decorated(e: *Engine, decorated: bool) { e.decorated = decorated }
engine_set_vsync(e: *Engine, interval: int) { e.vsync = interval }
engine_set_camera_input(e: *Engine, enabled: bool) { e.camera_input = enabled }

// Called as many times a frame as the fixed step fits into it, with the step
// rather than the frame's own delta, which is what a behaviour scene's
// fixed_update wants.
engine_on_fixed_update(e: *Engine, handler: fn(ptr, float)) {
    e.on_fixed_update = handler
}

engine_set_fixed_step(e: *Engine, seconds: float) {
    if seconds > 0.0 { e.fixed_step = seconds }
}

engine_set_debug(e: *Engine, on: bool) { core.set_debug(on) }
engine_set_frustum_culling(e: *Engine, on: bool) { core.set_frustum_culling(on) }
engine_set_face_culling(e: *Engine, on: bool) { core.set_face_culling(on) }

engine_on_start(e: *Engine, handler: fn(ptr)) { e.on_start = handler }
engine_on_update(e: *Engine, handler: fn(ptr, float)) { e.on_update = handler }
engine_on_render(e: *Engine, handler: fn(ptr, float)) { e.on_render = handler }

// Called once the clips have been applied and before anything is drawn, on
// every frame including the ones an agent is holding still: a pose an agent
// seeks to is a pose it wants solved, or it is looking at half an answer.
//
// This is where inverse kinematics goes. A clip is an angle at every joint and
// wherever the foot lands is where it lands; the solve afterwards is what puts
// it on the ground it is actually standing on.
engine_on_pose(e: *Engine, handler: fn(ptr)) { e.on_pose = handler }
engine_set_user_data(e: *Engine, data: ptr) { e.user_data = data }
engine_user_data(e: *Engine) -> ptr { return e.user_data }

engine_camera(e: *Engine) -> *Camera { return e.camera as *Camera }
engine_window(e: *Engine) -> ptr { return e.window }
engine_backend_name(e: *Engine) -> string { return e.backend_name }
engine_gl_renderer(e: *Engine) -> *GLRenderer { return e.gl_renderer as *GLRenderer }
engine_vk_renderer(e: *Engine) -> *VKRenderer { return e.backend_state as *VKRenderer }
engine_delta_time(e: *Engine) -> float { return e.delta_time }
engine_frame_count(e: *Engine) -> int { return e.frame_count }
engine_fps(e: *Engine) -> float { return e.fps }

// The mean cost of submitting a frame, in milliseconds. Answers zero before
// anything has been drawn.
engine_render_ms(e: *Engine) -> float {
    if e == null || e.render_frames == 0 { return 0.0 }
    return e.render_seconds * 1000.0 / (e.render_frames * 1.0)
}

engine_render_frames(e: *Engine) -> int {
    if e == null { return 0 }
    return e.render_frames
}

engine_set_light(e: *Engine, light: *Light) { e.light = light as ptr }

// The key light is the one the scene is lit and shadowed by; these are the
// rest of them. Both renderers have taken several lights since the array went
// into the shader, and the engine could only ever name one, so a street with
// lamps in it could not be lit by them.
engine_add_light(e: *Engine, light: *Light) {
    e.backend_add_light(e.backend_state, light as ptr)
}

engine_remove_light(e: *Engine, light: *Light) {
    e.backend_remove_light(e.backend_state, light as ptr)
}
engine_light(e: *Engine) -> *Light { return e.light as *Light }

// The engine BORROWS a model: it draws it and forgets it when it shuts down,
// and never frees it. Whoever built it frees it, after the engine is gone. The
// renderer releases the list it kept them in and nothing else, which is what
// lets the same model be handed to two backends.
engine_add_model(e: *Engine, m: *Model) {
    e.backend_add_model(e.backend_state, m)
}

engine_remove_model(e: *Engine, m: *Model) {
    e.backend_remove_model(e.backend_state, m)
}

engine_stop(e: *Engine) {
    e.running = false
    if e.window != null { platform.window_close(e.window) }
}

engine_mouse_x(e: *Engine) -> float { return platform.cursor_x(e.window) }
engine_mouse_y(e: *Engine) -> float { return platform.cursor_y(e.window) }
engine_mouse_down(e: *Engine, button: int) -> bool { return platform.mouse_down(e.window, button) }
engine_key_down(e: *Engine, key: int) -> bool { return platform.key_down(e.window, key) }

// One-call path: open the window, initialise the backend, fire `on_start`, run
// the loop, then tear everything down. Programs that need to interleave their
// own work can call engine_start / engine_loop / engine_shutdown directly.
engine_run(e: *Engine, x: int, y: int) -> bool {
    if !engine_start(e, x, y) { return false }
    if e.on_start != null { e.on_start(e.user_data) }
    engine_loop(e)
    engine_shutdown(e)
    return true
}

engine_start(e: *Engine, x: int, y: int) -> bool {
    if !platform.init() {
        println("ae3d: ${platform.error()}")
        return false
    }

    size_from_env(e)
    hidden_from_env(e)

    e.window = platform.window_create(e.width, e.height, e.title,
                                      e.api, e.msaa, e.decorated, e.visible,
                                      32)
    if e.window == null {
        println("ae3d: could not create window: ${platform.error()}")
        platform.shutdown()
        return false
    }

    if x < 0 || y < 0 {
        platform.window_center(e.window)
    } else {
        platform.window_set_pos(e.window, x, y)
    }

    // AE3D_AGENT is the only thing that turns this on. Unset, agent.start()
    // opens nothing, agent_on stays false, and the frame loop never reaches the
    // channel at all.
    e.agent_on = agent.start()
    if e.agent_on {
        e.agent_ctx = agent.context_new()
    } else {
        if agent.last_error() != "" { println("ae3d: agent channel: ${agent.last_error()}") }
    }

    if e.api != platform.API_VULKAN { platform.window_set_vsync(e.vsync) }

    if e.backend_init(e.backend_state, e.window, e.width, e.height) != 1 {
        println("ae3d: ${e.backend_name} backend failed to initialise")
        platform.window_destroy(e.window)
        e.window = null
        platform.shutdown()
        return false
    }

    apply_shadows(e)
    e.backend_set_fog(e.backend_state, &e.fog)
    e.backend_set_shadow_distance(e.backend_state, e.shadow_distance)
    e.camera = core.camera_new(e.width, e.height) as ptr
    platform.window_set_cursor_mode(e.window, platform.CURSOR_NORMAL)
    e.running = true
    return true
}

// Fills the channel's view of this frame and answers whatever is queued.
//
// Only ever reached when the channel is on. Everything it reads is a number the
// engine already had, so the work is assembling an answer for a client that
// asked, not gathering anything a frame would otherwise not have gathered.
pump_agent(e: *Engine) {
    c = e.agent_ctx as *Context

    c.camera = e.camera
    c.light = e.light
    c.gl_renderer = e.gl_renderer
    c.animations = e.animations
    c.vk_renderer = null
    if e.api == platform.API_VULKAN { c.vk_renderer = e.backend_state }
    c.backend = e.backend_name
    c.frame_count = e.frame_count
    c.fps = e.fps
    c.render_ms = engine_render_ms(e)
    c.shadow_ms = 0.0
    c.scene_ms = 0.0
    c.post_ms = 0.0
    c.post_active = false
    c.device = ""
    if e.api == platform.API_VULKAN {
        c.device = vk.device_name()
    } else {
        c.device = gl.device_name()
    }
    c.program_binds = 0
    c.material_binds = 0
    c.texture_binds = 0
    c.triangles = 0
    if e.gl_renderer != null {
        renderer = e.gl_renderer as *GLRenderer
        c.shadow_ms = gl.renderer_shadow_ms(renderer)
        c.scene_ms = gl.renderer_scene_ms(renderer)
        c.post_ms = gl.renderer_post_ms(renderer)
        c.post_active = gl.renderer_post_active(renderer)
        c.program_binds = gl.renderer_program_binds(renderer)
        c.material_binds = gl.renderer_material_binds(renderer)
        c.texture_binds = gl.renderer_texture_binds(renderer)
        i = 0
        while i < gl.renderer_model_count(renderer) {
            m = gl.renderer_model(renderer, i)
            if m != null && m.visible {
                c.triangles = c.triangles + core.mesh_index_count(m.mesh) / 3
            }
            i = i + 1
        }
    }
    // The same figures from the other backend, so a frame drawn with Vulkan
    // answers what it is made of and what each pass cost, rather than zeros.
    // Triangles and lights are counted the same way; the shadow map is a GL
    // texture handle and has no Vulkan equivalent worth inventing one for.
    if e.api == platform.API_VULKAN && e.backend_state != null {
        vkr = e.backend_state as *VKRenderer
        c.shadow_ms = vk.renderer_shadow_ms(vkr)
        c.scene_ms = vk.renderer_scene_ms(vkr)
        c.post_ms = vk.renderer_post_ms(vkr)
        c.post_active = vk.renderer_post_active(vkr)
        c.program_binds = vk.renderer_program_binds(vkr)
        c.material_binds = vk.renderer_material_binds(vkr)
        i = 0
        while i < vk.renderer_model_count(vkr) {
            m = vk.renderer_model(vkr, i)
            if m != null && m.visible {
                c.triangles = c.triangles + core.mesh_index_count(m.mesh) / 3
            }
            i = i + 1
        }
    }
    c.delta = e.delta_time
    c.width = e.width
    c.height = e.height
    c.draw_calls = 0
    c.shadow_map = 0
    c.light_count = 0
    if e.gl_renderer != null {
        c.draw_calls = gl.renderer_draw_calls(e.gl_renderer)
        c.shadow_map = gl.renderer_shadow_map(e.gl_renderer as *GLRenderer)
        c.light_count = gl.renderer_light_count(e.gl_renderer as *GLRenderer)
    }
    if e.api == platform.API_VULKAN && e.backend_state != null {
        vkr = e.backend_state as *VKRenderer
        c.draw_calls = vk.renderer_draw_calls(vkr)
        c.light_count = vk.renderer_light_count(vkr)
    }
    c.shadows = engine_shadows(e)
    c.fog_enabled = e.fog.enabled

    // A step still owed from an earlier frame is settled before anything new is
    // drained, so a client that pipelined a step and a query gets them in order.
    if e.agent_steps_left > 0 {
        e.agent_steps_left = e.agent_steps_left - 1
        if e.agent_steps_left == 0 {
            // Back to held, which is where the step started. An agent that
            // stepped asked to look at a particular frame, not to be handed
            // back a running engine.
            c.paused = true
            agent.answer_step(c)
        }
        return
    }

    agent.pump(c)

    if c.want_pause {
        c.want_pause = false
        c.paused = true
    }
    if c.want_resume {
        c.want_resume = false
        c.paused = false
    }
    if c.want_steps > 0 {
        c.paused = false
        e.agent_steps_left = c.want_steps
        c.want_steps = 0
    }
    if c.want_stop {
        c.want_stop = false
        engine_stop(e)
    }
}

// A finished frame is only readable between the last draw and the buffer swap.
// Called from there, which is why the agent's snapshot is not taken where the
// rest of its work happens: after the swap the back buffer holds nothing this
// frame put in it, and the file came out empty with an "ok" already sent.
service_agent_capture(e: *Engine) {
    c = e.agent_ctx as *Context
    if !c.want_capture { return }
    c.want_capture = false
    if e.api == platform.API_VULKAN {
        agent.answer_capture_unsupported(c,
            "the windowed Vulkan backend has no swapchain readback; use the OpenGL backend, or the editor, which renders offscreen")
        return
    }
    width = platform.window_fb_width(e.window)
    height = platform.window_fb_height(e.window)
    captured = agent.capture_frame(width, height)
    if c.pending_capture_id >= 0 { agent.answer_capture(c, captured) }
    agent.answer_pending_trace(c)
    agent.answer_deferred(c)
}

service_agent_snapshot(e: *Engine) {
    c = e.agent_ctx as *Context
    if c.pending_snapshot_id < 0 { return }

    path = c.want_snapshot
    c.want_snapshot = ""
    if e.api == platform.API_VULKAN {
        agent.answer_snapshot(c, path, false)
        string.free(path)
        return
    }
    width = platform.window_fb_width(e.window)
    height = platform.window_fb_height(e.window)
    agent.answer_snapshot(c, path, gl.snapshot(path, width, height))
    string.free(path)
}

engine_shutdown(e: *Engine) {
    if e.agent_on {
        agent.capture_release()
        agent.stop()
        agent.context_free(e.agent_ctx as *Context)
        e.agent_ctx = null
        e.agent_on = false
    }
    if e.window == null { return }
    e.backend_cleanup(e.backend_state)
    platform.window_destroy(e.window)
    e.window = null
    platform.shutdown()
}

engine_loop(e: *Engine) {
    cam = e.camera as *Camera
    last_time = platform.time()
    last_width = e.width
    last_height = e.height

    while e.running && !platform.window_should_close(e.window) {
        now = platform.time()
        delta = now - last_time
        last_time = now

        // A held frame still draws, so the window stays alive and the scene can
        // be queried and snapshotted; it just does not advance. Time stops and
        // the counter stops with it, which is what lets an agent read the same
        // frame twice and get the same answer.
        held = false
        if e.agent_on { held = agent.is_paused(e.agent_ctx as *Context) }
        if held { delta = 0.0 }
        e.delta_time = delta

        e.fps_window = e.fps_window + delta
        e.fps_frames = e.fps_frames + 1
        if e.fps_window >= 0.5 {
            e.fps = (e.fps_frames * 1.0) / e.fps_window
            e.fps_window = 0.0
            e.fps_frames = 0
        }

        width = platform.window_fb_width(e.window)
        height = platform.window_fb_height(e.window)
        if width != last_width || height != last_height {
            if width > 0 && height > 0 {
                e.width = width
                e.height = height
                e.backend_update_viewport(e.backend_state, width, height)
                core.camera_set_aspect(cam, (width * 1.0) / (height * 1.0))
            }
            last_width = width
            last_height = height
        }

        if e.camera_input {
            core.camera_process_keyboard(cam, e.window, delta)
            if platform.mouse_down(e.window, platform.MOUSE_RIGHT) {
                process_mouse_look(e, cam)
            } else {
                e.first_mouse = true
            }
        }

        // The accumulator was drained a step at a time and nothing was called
        // in between, so the fixed step was a number the engine subtracted from
        // itself: a program that set one and waited for it waited forever, and
        // a behaviour scene's fixed_update had to be driven by hand.
        if !held {
            e.fixed_accumulator = e.fixed_accumulator + delta
            while e.fixed_accumulator >= e.fixed_step {
                e.fixed_accumulator = e.fixed_accumulator - e.fixed_step
                if e.on_fixed_update != null { e.on_fixed_update(e.user_data, e.fixed_step) }
            }
            // With the simulation, not beside it: a held frame freezes the
            // playheads too, or an agent that paused to look at a pose would
            // find a different one each time it asked.
            anim.registry_advance(e.animations as *Registry, delta)
            if e.on_update != null { e.on_update(e.user_data, delta) }
        } else {
            // Frozen, not skipped. on_pose writes to the same local transforms
            // the clips do, so a held frame that did not re-apply them would
            // hand the next solve its own output and the pose would creep
            // while the playhead stood still.
            anim.registry_apply(e.animations as *Registry)
        }

        if e.on_pose != null { e.on_pose(e.user_data) }

        render_started = platform.time()
        e.backend_render(e.backend_state, cam, e.light)
        e.render_seconds = e.render_seconds + (platform.time() - render_started)
        e.render_frames = e.render_frames + 1

        if e.on_render != null { e.on_render(e.user_data, delta) }

        // Before the swap, because after it the back buffer holds nothing this
        // frame put there.
        if e.frame_limit > 0 && e.frame_count + 1 >= e.frame_limit {
            write_snapshot(e)
        }
        if e.agent_on {
            service_agent_capture(e)
            service_agent_snapshot(e)
        }

        if e.api != platform.API_VULKAN { platform.window_swap(e.window) }
        platform.poll_events()
        if !held { e.frame_count = e.frame_count + 1 }

        // Last thing in the frame: the numbers a query reports are the finished
        // frame's, and a snapshot taken now is of a frame that exists.
        if e.agent_on { pump_agent(e) }

        if e.frame_limit > 0 && e.frame_count >= e.frame_limit { e.running = false }
    }
}

process_mouse_look(e: *Engine, cam: *Camera) {
    x = platform.cursor_x(e.window)
    y = platform.cursor_y(e.window)

    if e.first_mouse {
        e.last_mouse_x = x
        e.last_mouse_y = y
        e.first_mouse = false
        return
    }

    core.camera_process_mouse(cam, x - e.last_mouse_x, e.last_mouse_y - y, true)
    e.last_mouse_x = x
    e.last_mouse_y = y
}
