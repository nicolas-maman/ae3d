// Game objects and components: the shape Unity and gopher3D gave a scene.
//
// A game object is a named thing in the scene with a transform (the model
// that draws it, or one made for it) and a list of components. A script is
// a component with Unity's phases, named as Unity names them, over a state
// of its own:
//
//     struct Spinner { speed: float }
//
//     start(state: ptr, go: *GameObject) { ... }              // once, first frame
//     update(state: ptr, go: *GameObject, delta: float) { ... } // every frame
//
//     cube = engine.object(e, "Cube", loader.cube(1.0))
//     engine.script(cube, "Spinner", &spinner, start, update)
//
// Every phase gets the script's state and the object it is on, the way a
// MonoBehaviour has `this` and `gameObject`; `fixed_update` runs at the
// engine's fixed step and `late_update` after every update, as in Unity.
// A component is a vtable of these over its state pointer, which is how
// Aether expresses what Go did with an interface and Unity with a class.
// A game object keeps no transform of its own: it points at the model that
// already owns one, so there is no per-frame copy back and forth between
// two copies of the same position.

import std.list
import std.heap
import std.string
import ae3d.core

exports (
    Component, GameObject, Scene,
    KIND_MESH, KIND_SCRIPT, KIND_RENDERER, KIND_COLLIDER, KIND_LIGHT,
    KIND_CAMERA, KIND_WATER, KIND_VOXEL, KIND_CUSTOM,
    component_new, component_free, component_enabled, component_set_enabled,
    component_set_name, object_set_name, object_set_tag,
    component_owner, component_state,
    object_new, object_free, object_add_component, object_add_script, object_component,
    object_component_count, object_find_component, object_remove_component,
    object_set_model, object_model, object_active, object_set_active,
    object_position, object_set_position, object_translate,
    object_rotation, object_set_rotation, object_scale, object_set_scale,
    object_world_position, object_world_rotation, object_set_world_position, object_set_world_rotation, object_transform,
    object_forward, object_up, object_right,
    scene_new, scene_free, scene_add, scene_remove, scene_detach, scene_destroy_later,
    scene_find, scene_find_by_tag, scene_count, scene_object,
    scene_update, scene_fixed_update, scene_late_update, scene_clear,
    object_scene, scene_host, scene_set_host
)

const KIND_MESH = 0
const KIND_SCRIPT = 1
const KIND_RENDERER = 2
const KIND_COLLIDER = 3
const KIND_LIGHT = 4
const KIND_CAMERA = 5
const KIND_WATER = 6
const KIND_VOXEL = 7
const KIND_CUSTOM = 8

struct Component {
    state: ptr
    owner: ptr
    name: string
    kind: int
    enabled: bool
    started: bool

    // The phases, Unity's, each handed the state and the object it is on.
    awake: fn(ptr, *GameObject)
    start: fn(ptr, *GameObject)
    update: fn(ptr, *GameObject, float)
    fixed_update: fn(ptr, *GameObject, float)
    late_update: fn(ptr, *GameObject, float)
    destroy: fn(ptr, *GameObject)
}

struct GameObject {
    name: string
    tag: string
    model: ptr
    components: ptr
    active: bool
    started: bool
    owns_model: bool
    // The scene it was added to, so a script can reach the scene and,
    // through it, whatever runs the scene (the engine).
    scene: ptr
}

struct Scene {
    objects: ptr
    pending_destroy: ptr
    // Whoever runs this scene -- the engine -- for a script that asks.
    host: ptr
}

component_new(name: string, kind: int, state: ptr) -> *Component {
    c = heap.new(Component)
    component_set_name(c, name)
    c.kind = kind
    c.state = state
    c.enabled = true
    return c
}

component_set_name(c: *Component, name: string) {
    c.name = core.set_owned(c.name, name)
}

component_free(c: *Component) {
    if c == null { return }
    heap.free(c)
}

component_enabled(c: *Component) -> bool { return c.enabled }
component_set_enabled(c: *Component, on: bool) { c.enabled = on }
component_owner(c: *Component) -> *GameObject { return c.owner as *GameObject }
component_state(c: *Component) -> ptr { return c.state }

object_new(name: string) -> *GameObject {
    o = heap.new(GameObject)
    object_set_name(o, name)
    o.components = list.new()
    o.active = true
    return o
}

object_set_name(o: *GameObject, name: string) {
    o.name = core.set_owned(o.name, name)
}

object_set_tag(o: *GameObject, tag: string) {
    o.tag = core.set_owned(o.tag, tag)
}

object_free(o: *GameObject) {
    if o == null { return }
    if o.components != null {
        count = list.size(o.components)
        i = 0
        while i < count {
            c = list.get_raw(o.components, i) as *Component
            if c != null {
                if c.destroy != null { c.destroy(c.state, o) }
                component_free(c)
            }
            i = i + 1
        }
        list.free(o.components)
    }
    if o.owns_model && o.model != null { core.model_free(o.model as *Model) }
    heap.free(o)
}

// An object with no model still needs somewhere to keep a transform, so it gets
// an empty one it owns and frees. An object handed a model borrows it.
object_set_model(o: *GameObject, m: *Model) {
    if o.owns_model && o.model != null { core.model_free(o.model as *Model) }
    o.model = m as ptr
    o.owns_model = false
}

object_model(o: *GameObject) -> *Model {
    return o.model as *Model
}

// The model that holds the object's transform: its own, or an empty one
// made for it -- an object with nothing to draw (a group) still has a
// place, and what is parented to it is placed by it.
object_transform(o: *GameObject) -> *Model { return ensure_transform(o) }

ensure_transform(o: *GameObject) -> *Model {
    if o.model == null {
        // A transform and nothing to draw -- a group -- is a model too,
        // one the renderer never sees; it carries the object's name, so
        // the scene file and the editor know the group by it.
        m = core.model_new()
        core.model_set_name(m, core.text(o.name))
        o.model = m as ptr
        o.owns_model = true
    }
    return o.model as *Model
}

object_active(o: *GameObject) -> bool { return o.active }
object_set_active(o: *GameObject, on: bool) { o.active = on }

// Adding a component is not a decision about whether it runs. component_new
// already enables it, so the default is unchanged; what is gone is the line
// that re-enabled one the caller had deliberately switched off before adding.
object_add_component(o: *GameObject, c: *Component) {
    c.owner = o as ptr
    list.add_raw(o.components, c)
    if c.awake != null { c.awake(c.state, o) }
}

// A script on the object, Unity's AddComponent: its state, and its phases
// by Unity's names -- `start` once before its first update, `update`
// every frame, `fixed_update` at the fixed step, `late_update` after every
// object has updated. Any may be null. The component made is returned, to
// disable or remove; the state stays the caller's.
object_add_script(o: *GameObject, name: string, state: ptr,
                  start: fn(ptr, *GameObject), update: fn(ptr, *GameObject, float),
                  fixed_update: fn(ptr, *GameObject, float) = null,
                  late_update: fn(ptr, *GameObject, float) = null) -> *Component {
    c = component_new(name, KIND_SCRIPT, state)
    c.start = start
    c.update = update
    c.fixed_update = fixed_update
    c.late_update = late_update
    object_add_component(o, c)
    return c
}

object_scene(o: *GameObject) -> *Scene { return o.scene as *Scene }
scene_host(s: *Scene) -> ptr { return s.host }
scene_set_host(s: *Scene, host: ptr) { s.host = host }

object_component_count(o: *GameObject) -> int {
    return list.size(o.components)
}

object_component(o: *GameObject, index: int) -> *Component {
    return list.get_raw(o.components, index) as *Component
}

object_find_component(o: *GameObject, kind: int) -> *Component {
    count = list.size(o.components)
    i = 0
    while i < count {
        c = list.get_raw(o.components, i) as *Component
        if c != null && c.kind == kind { return c }
        i = i + 1
    }
    return null
}

object_remove_component(o: *GameObject, c: *Component) {
    count = list.size(o.components)
    i = 0
    while i < count {
        if list.get_raw(o.components, i) == c {
            if c.destroy != null { c.destroy(c.state, o) }
            list.remove(o.components, i)
            component_free(c)
            return
        }
        i = i + 1
    }
}

object_position(o: *GameObject) -> Vec3 {
    return ensure_transform(o).position
}

object_set_position(o: *GameObject, position: Vec3) {
    m = ensure_transform(o)
    core.model_set_position(m, position.x, position.y, position.z)
}

object_translate(o: *GameObject, delta: Vec3) {
    m = ensure_transform(o)
    moved = core.v3_add(m.position, delta)
    core.model_set_position(m, moved.x, moved.y, moved.z)
}

object_rotation(o: *GameObject) -> Quat {
    return ensure_transform(o).rotation
}

object_set_rotation(o: *GameObject, rotation: Quat) {
    core.model_set_rotation(ensure_transform(o), rotation)
}

// Where the object is in the world, under whatever it is parented to:
// what physics reads and writes, since a body lives in the world and an
// object may live in a group. For an object with no parent these are
// the local ones. A parent's scale is not undone: a group is at unit
// scale, and a body under a scaled parent is not a case this serves.
object_world_position(o: *GameObject) -> Vec3 {
    return core.model_world_position(ensure_transform(o))
}

object_world_rotation(o: *GameObject) -> Quat {
    m = ensure_transform(o)
    core.model_sync_transform(m)
    return m.world_rotation
}

object_set_world_position(o: *GameObject, position: Vec3) {
    m = ensure_transform(o)
    parent = core.model_parent(m)
    if parent == null {
        core.model_set_position(m, position.x, position.y, position.z)
        return
    }
    core.model_sync_transform(parent)
    local = core.quat_apply(core.quat_conjugate(parent.world_rotation), core.v3_sub(position, parent.world_position))
    core.model_set_position(m, local.x, local.y, local.z)
}

object_set_world_rotation(o: *GameObject, rotation: Quat) {
    m = ensure_transform(o)
    parent = core.model_parent(m)
    if parent == null {
        core.model_set_rotation(m, rotation)
        return
    }
    core.model_sync_transform(parent)
    core.model_set_rotation(m, core.quat_normalize(core.quat_mul(core.quat_conjugate(parent.world_rotation), rotation)))
}

object_scale(o: *GameObject) -> Vec3 {
    return ensure_transform(o).scale
}

object_set_scale(o: *GameObject, scale: Vec3) {
    m = ensure_transform(o)
    core.model_set_scale(m, scale.x, scale.y, scale.z)
}

object_forward(o: *GameObject) -> Vec3 {
    return core.quat_apply(ensure_transform(o).rotation, core.vec3(0.0, 0.0, 0.0 - 1.0))
}

object_up(o: *GameObject) -> Vec3 {
    return core.quat_apply(ensure_transform(o).rotation, core.vec3(0.0, 1.0, 0.0))
}

object_right(o: *GameObject) -> Vec3 {
    return core.quat_apply(ensure_transform(o).rotation, core.vec3(1.0, 0.0, 0.0))
}

scene_new() -> *Scene {
    s = heap.new(Scene)
    s.objects = list.new()
    s.pending_destroy = list.new()
    return s
}

scene_free(s: *Scene) {
    if s == null { return }
    scene_clear(s)
    if s.objects != null { list.free(s.objects) }
    if s.pending_destroy != null { list.free(s.pending_destroy) }
    heap.free(s)
}

scene_add(s: *Scene, o: *GameObject) {
    o.scene = s as ptr
    list.add_raw(s.objects, o)
}

scene_remove(s: *Scene, o: *GameObject) {
    count = list.size(s.objects)
    i = 0
    while i < count {
        if list.get_raw(s.objects, i) == o {
            list.remove(s.objects, i)
            object_free(o)
            return
        }
        i = i + 1
    }
}

// The object out of the scene and kept: the caller holds it, to put back
// with scene_add -- an editor's undo of a delete. False when it was not in
// this scene.
scene_detach(s: *Scene, o: *GameObject) -> bool {
    count = list.size(s.objects)
    i = 0
    while i < count {
        if list.get_raw(s.objects, i) == o {
            list.remove(s.objects, i)
            o.scene = null
            return true
        }
        i = i + 1
    }
    return false
}

scene_destroy_later(s: *Scene, o: *GameObject) {
    list.add_raw(s.pending_destroy, o)
}

scene_find(s: *Scene, name: string) -> *GameObject {
    count = list.size(s.objects)
    i = 0
    while i < count {
        o = list.get_raw(s.objects, i) as *GameObject
        if o != null && string.equals(o.name, name) == 1 { return o }
        i = i + 1
    }
    return null
}

scene_find_by_tag(s: *Scene, tag: string, out: ptr) -> int {
    found = 0
    count = list.size(s.objects)
    i = 0
    while i < count {
        o = list.get_raw(s.objects, i) as *GameObject
        if o != null && string.equals(core.text(o.tag), tag) == 1 {
            list.add_raw(out, o)
            found = found + 1
        }
        i = i + 1
    }
    return found
}

scene_count(s: *Scene) -> int {
    return list.size(s.objects)
}

scene_object(s: *Scene, index: int) -> *GameObject {
    return list.get_raw(s.objects, index) as *GameObject
}

drain_destroyed(s: *Scene) {
    pending = list.size(s.pending_destroy)
    if pending == 0 { return }
    i = 0
    while i < pending {
        o = list.get_raw(s.pending_destroy, i) as *GameObject
        if o != null { scene_remove(s, o) }
        i = i + 1
    }
    list.clear(s.pending_destroy)
}

scene_update(s: *Scene, delta: float) {
    drain_destroyed(s)

    count = list.size(s.objects)
    i = 0
    while i < count {
        o = list.get_raw(s.objects, i) as *GameObject
        if o != null && o.active {
            components = list.size(o.components)
            j = 0
            while j < components {
                c = list.get_raw(o.components, j) as *Component
                if c != null && c.enabled {
                    if !c.started {
                        if c.start != null { c.start(c.state, o) }
                        c.started = true
                    }
                    if c.update != null { c.update(c.state, o, delta) }
                }
                j = j + 1
            }
            o.started = true
        }
        i = i + 1
    }
}

scene_fixed_update(s: *Scene, delta: float) {
    count = list.size(s.objects)
    i = 0
    while i < count {
        o = list.get_raw(s.objects, i) as *GameObject
        if o != null && o.active {
            components = list.size(o.components)
            j = 0
            while j < components {
                c = list.get_raw(o.components, j) as *Component
                if c != null && c.enabled && c.fixed_update != null {
                    c.fixed_update(c.state, o, delta)
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

// After every object's update: the phase a camera that follows a
// character runs in, once the character has moved.
scene_late_update(s: *Scene, delta: float) {
    count = list.size(s.objects)
    i = 0
    while i < count {
        o = list.get_raw(s.objects, i) as *GameObject
        if o != null && o.active {
            components = list.size(o.components)
            j = 0
            while j < components {
                c = list.get_raw(o.components, j) as *Component
                if c != null && c.enabled && c.started && c.late_update != null {
                    c.late_update(c.state, o, delta)
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

scene_clear(s: *Scene) {
    count = list.size(s.objects)
    i = 0
    while i < count {
        o = list.get_raw(s.objects, i) as *GameObject
        if o != null { object_free(o) }
        i = i + 1
    }
    list.clear(s.objects)
    list.clear(s.pending_destroy)
}
