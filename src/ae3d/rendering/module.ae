// Presets for the advanced shading features the default fragment shader exposes.
//
// A config is a plain value: build one from a preset, adjust what you want, and
// apply it to a model. Applying writes the model's custom uniforms, so two models
// in the same scene can run different settings through the same program.

import std.list
import ae3d.core

exports (
    Config,
    default_config, high_quality_config, performance_config, voxel_config,
    apply, apply_all, unset_config, defaults_model
)

struct Config {
    clearcoat: bool
    clearcoat_roughness: float
    clearcoat_intensity: float
    sheen: bool
    sheen_r: float
    sheen_g: float
    sheen_b: float
    sheen_roughness: float
    transmission: bool
    transmission_factor: float

    multiple_scattering: bool
    energy_conservation: bool
    image_based_lighting: bool
    ibl_intensity: float

    perlin_noise: bool
    noise_scale: float
    noise_octaves: int
    noise_intensity: float

    advanced_shadows: bool
    shadow_intensity: float
    shadow_softness: float

    volumetric_lighting: bool
    volumetric_intensity: float
    volumetric_steps: int
    volumetric_scattering: float

    global_illumination: bool
    gi_intensity: float
    gi_bounces: int

    caustics: bool
    caustics_intensity: float
    caustics_scale: float
    caustics_speed: float
    caustics_water_level: float
    caustics_depth: float

    bloom: bool
    bloom_threshold: float
    bloom_intensity: float

}

default_config() -> Config {
    return Config {
        clearcoat: false,
        clearcoat_roughness: 0.1,
        clearcoat_intensity: 0.5,
        sheen: false,
        sheen_r: 1.0,
        sheen_g: 1.0,
        sheen_b: 1.0,
        sheen_roughness: 0.5,
        transmission: false,
        transmission_factor: 0.0,

        multiple_scattering: true,
        energy_conservation: true,
        image_based_lighting: true,
        ibl_intensity: 1.0,

        perlin_noise: true,
        noise_scale: 0.0002,
        noise_octaves: 3,
        noise_intensity: 0.05,

        advanced_shadows: true,
        shadow_intensity: 0.08,
        shadow_softness: 0.2,

        volumetric_lighting: false,
        volumetric_intensity: 0.5,
        volumetric_steps: 16,
        volumetric_scattering: 0.1,

        global_illumination: false,
        gi_intensity: 0.5,
        gi_bounces: 2,

        caustics: false,
        caustics_intensity: 0.6,
        caustics_scale: 0.05,
        caustics_speed: 0.35,
        caustics_water_level: 0.0,
        caustics_depth: 12.0,

        bloom: true,
        bloom_threshold: 1.0,
        bloom_intensity: 0.3
    }
}

high_quality_config() -> Config {
    c = default_config()
    c.clearcoat = true
    c.sheen = true
    c.volumetric_lighting = true
    c.global_illumination = true
    c.gi_bounces = 3
    c.volumetric_steps = 32
    c.noise_octaves = 5
    c.shadow_softness = 0.35
    return c
}

performance_config() -> Config {
    c = default_config()
    c.clearcoat = false
    c.sheen = false
    c.transmission = false
    c.multiple_scattering = false
    c.image_based_lighting = false
    c.perlin_noise = false
    c.advanced_shadows = false
    c.volumetric_lighting = false
    c.global_illumination = false
    c.bloom = false
    return c
}

// Voxel worlds are lit flat surfaces in bulk: the occlusion between blocks
// is what sells the depth (the scene's, from engine_set_ssao, and the sky
// each corner sees, baked into the mesh), and surface noise on a cube face
// only shimmers.
voxel_config() -> Config {
    c = default_config()
    c.perlin_noise = false
    c.noise_intensity = 0.0
    c.clearcoat = false
    c.sheen = false
    c.volumetric_lighting = false
    c.bloom = false
    return c
}

flag(value: bool) -> int {
    if value { return 1 }
    return 0
}

apply(m: *Model, c: Config) {
    if m == null { return }

    core.model_set_uniform_int(m, "enableClearcoat", flag(c.clearcoat))
    core.model_set_uniform_float(m, "clearcoatRoughness", c.clearcoat_roughness)
    core.model_set_uniform_float(m, "clearcoatIntensity", c.clearcoat_intensity)

    core.model_set_uniform_int(m, "enableSheen", flag(c.sheen))
    core.model_set_uniform_vec3(m, "sheenColor", core.vec3(c.sheen_r, c.sheen_g, c.sheen_b))
    core.model_set_uniform_float(m, "sheenRoughness", c.sheen_roughness)

    core.model_set_uniform_int(m, "enableTransmission", flag(c.transmission))
    core.model_set_uniform_float(m, "transmissionFactor", c.transmission_factor)

    core.model_set_uniform_int(m, "enableMultipleScattering", flag(c.multiple_scattering))
    core.model_set_uniform_int(m, "enableEnergyConservation", flag(c.energy_conservation))
    core.model_set_uniform_int(m, "enableImageBasedLighting", flag(c.image_based_lighting))
    core.model_set_uniform_float(m, "iblIntensity", c.ibl_intensity)

    core.model_set_uniform_int(m, "enablePerlinNoise", flag(c.perlin_noise))
    core.model_set_uniform_float(m, "noiseScale", c.noise_scale)
    core.model_set_uniform_int(m, "noiseOctaves", c.noise_octaves)
    core.model_set_uniform_float(m, "noiseIntensity", c.noise_intensity)

    core.model_set_uniform_int(m, "enableShadows", flag(c.advanced_shadows))
    core.model_set_uniform_float(m, "shadowIntensity", c.shadow_intensity)
    core.model_set_uniform_float(m, "shadowSoftness", c.shadow_softness)

    core.model_set_uniform_int(m, "enableVolumetricLighting", flag(c.volumetric_lighting))
    core.model_set_uniform_float(m, "volumetricIntensity", c.volumetric_intensity)
    core.model_set_uniform_int(m, "volumetricSteps", c.volumetric_steps)
    core.model_set_uniform_float(m, "volumetricScattering", c.volumetric_scattering)

    core.model_set_uniform_int(m, "enableGlobalIllumination", flag(c.global_illumination))
    core.model_set_uniform_float(m, "giIntensity", c.gi_intensity)
    core.model_set_uniform_int(m, "giBounces", c.gi_bounces)

    core.model_set_uniform_int(m, "enableCaustics", flag(c.caustics))
    core.model_set_uniform_float(m, "causticsIntensity", c.caustics_intensity)
    core.model_set_uniform_float(m, "causticsScale", c.caustics_scale)
    core.model_set_uniform_float(m, "causticsSpeed", c.caustics_speed)
    core.model_set_uniform_float(m, "causticsWaterLevel", c.caustics_water_level)
    core.model_set_uniform_float(m, "causticsDepth", c.caustics_depth)

    core.model_set_uniform_int(m, "enableBloom", flag(c.bloom))
    core.model_set_uniform_float(m, "bloomThreshold", c.bloom_threshold)
    core.model_set_uniform_float(m, "bloomIntensity", c.bloom_intensity)

}

// What the shader starts from with nothing set: every feature off. This is what
// a model that asked for nothing has always looked like, and a renderer resets
// to it so that a model which asked for nothing keeps looking that way whatever
// the model beside it asked for.
unset_config() -> Config {
    c = default_config()
    c.clearcoat = false
    c.clearcoat_roughness = 0.0
    c.clearcoat_intensity = 0.0
    c.sheen = false
    c.sheen_r = 0.0
    c.sheen_g = 0.0
    c.sheen_b = 0.0
    c.sheen_roughness = 0.0
    c.transmission = false
    c.transmission_factor = 0.0
    c.multiple_scattering = false
    c.energy_conservation = false
    c.image_based_lighting = true
    c.ibl_intensity = 1.0
    c.perlin_noise = false
    c.noise_scale = 0.0
    c.noise_octaves = 0
    c.noise_intensity = 0.0
    c.advanced_shadows = true
    // NOT zero. Every other field here is a feature turned off, but these two
    // are how a shadow looks: the intensity is how much of the direct light
    // a shadow lets through (the sky's fill is never shadowed), and a
    // softness of zero puts all nine taps of the 3x3 on one texel. A model
    // nobody configured was getting hard-edged holes cut out of it.
    c.shadow_intensity = 0.08
    c.shadow_softness = 0.2
    c.volumetric_lighting = false
    c.volumetric_intensity = 0.0
    c.volumetric_steps = 0
    c.volumetric_scattering = 0.0
    c.global_illumination = false
    c.gi_intensity = 0.0
    c.gi_bounces = 0
    c.caustics = false
    c.caustics_intensity = 0.0
    c.caustics_scale = 0.0
    c.caustics_speed = 0.0
    c.caustics_water_level = 0.0
    c.caustics_depth = 0.0
    c.bloom = false
    c.bloom_threshold = 0.0
    c.bloom_intensity = 0.0
    return c
}

// A model carrying the unset settings and nothing else. A renderer draws it into
// the program's uniforms to wipe what the model before it asked for.
defaults_model() -> *Model {
    m = core.model_new()
    apply(m, unset_config())
    return m
}

apply_all(models: ptr, c: Config) {
    count = list.size(models)
    i = 0
    while i < count {
        apply(list.get_raw(models, i) as *Model, c)
        i = i + 1
    }
}
