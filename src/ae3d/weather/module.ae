// The weather: rain, snow, dust and storm over any scene.
//
//   w = weather.weather_new(e)                  // in start, once the engine is up
//   weather.weather_set(w, weather.STORM, 0.8)  // a kind and how hard, 0..1
//   weather.weather_set_wind(w, core.vec3(1.0, 0.0, 0.3), 12.0)
//
// The weather is a behaviour the engine runs, so a scene sets it and forgets
// it: every frame the particles step and wrap around the camera, the wind
// blows them, a storm throws its lightning. The particles are point instances
// -- a position, a scale, a colour and a phase each, streamed the way the
// sand's grains are -- stepped in C (native/ae3d_weather.c), so a hundred
// thousand drops are a fraction of a millisecond of the frame. Rain streaks
// are a thin box falling fast; snow a small one drifting and swaying; dust a
// sphere the size of a fist carried by the wind through a haze. A storm is
// rain with a harder wind, heavier cloud, and lightning: a flash of the key
// light for a few frames every several seconds, at the storm's own beat.
//
// What the weather takes from the scene it gives back: the fog and the cloud
// cover it sets are restored by weather_set(w, CLEAR, 0), and the key light's
// intensity by the end of every flash.
import std.heap
import ae3d.core
import ae3d.jobs
import ae3d.png
import ae3d.engine
import ae3d.loader

exports (
    Weather, CLEAR, RAIN, SNOW, DUST, STORM,
    weather_new, weather_free, weather_set, weather_set_wind, weather_relight, weather_kind,
    weather_intensity, weather_particle_count, weather_flashing, weather_step, weather_particle
)

extern ae3d_image_register(name: string, rgba: ptr, width: int, height: int) -> int
extern cos(x: float) -> float
extern sin(x: float) -> float

// --- the particles ---------------------------------------------------------------------------------------------
//
// Rain, snow and dust are point instances -- a position a particle,
// streamed to the GPU every frame the way the sand's grains are -- and
// the step that moves them is one pass over a packed xyz array: fall,
// drift with the wind, a sway for the flakes, and a wrap that keeps
// every particle inside a box that travels with the camera, so the
// weather is wherever the eye is and costs the same however big the
// world. A hundred thousand drops are a sine and a cosine each, a
// millisecond on one core and a fraction over the engine's pool.

const TWO_PI = 6.283185307

// A cheap, deterministic hash to 0..1 for scattering: 32-bit arithmetic
// carried in a long, masked to stay unsigned.
hash01(n: long) -> float {
    m = 4294967295 as long
    x = n & m
    x = x ^ (x >> 16)
    x = (x * (2146121005 as long)) & m
    x = x ^ (x >> 15)
    x = (x * (2221713035 as long)) & m
    x = x ^ (x >> 16)
    return (x as float) / 4294967296.0
}

// Scatters `count` particles through the box of half-extents around a
// centre; `phases` (may be null) get a phase each for the sway. `seed`
// tells one system's scatter from another's.
scatter(xyz: ptr, phases: ptr, count: int, centre: Vec3, half_x: float, half_y: float, half_z: float, seed: int) {
    if xyz == null || count <= 0 { return }
    p = xyz as float[]
    ph = phases as float[]
    i = 0
    while i < count {
        n = (((i as long) * (2654435761 as long)) + (seed as long)) & (4294967295 as long)
        p[i * 3] = centre.x + (hash01(n) * 2.0 - 1.0) * half_x
        p[i * 3 + 1] = centre.y + (hash01(n + (1 as long)) * 2.0 - 1.0) * half_y
        p[i * 3 + 2] = centre.z + (hash01(n + (2 as long)) * 2.0 - 1.0) * half_z
        if phases != null { ph[i] = hash01(n + (3 as long)) * TWO_PI }
        i = i + 1
    }
}

// One step's constants, shared by the pass's blocks.
struct WeatherStepJob {
    xyz: ptr
    phases: ptr
    dt: float
    fall: float
    wind: Vec3
    sway: float
    time: float
    centre: Vec3
    half_x: float
    half_y: float
    half_z: float
}

// A block of particles: each falls at `fall` metres a second, drifts
// with the wind, sways sideways at its own phase (a flake's flutter, a
// drop's none), and is wrapped back into the box: one leaving the
// bottom comes in at the top at a fresh x and z, one leaving a side
// comes in at the other.
step_block(start: int, end: int, worker: int, context: ptr) {
    j = context as *WeatherStepJob
    p = j.xyz as float[]
    ph = j.phases as float[]
    dt = j.dt
    time = j.time
    i = start
    while i < end {
        phase = 0.0
        if j.phases != null { phase = ph[i] }
        sx = j.sway * cos(time * 1.7 + phase) * dt
        sz = j.sway * sin(time * 1.3 + phase * 1.31) * dt
        x = p[i * 3] + j.wind.x * dt + sx
        y = p[i * 3 + 1] + (j.wind.y - j.fall) * dt
        z = p[i * 3 + 2] + j.wind.z * dt + sz
        if y < j.centre.y - j.half_y {
            n = (((i as long) * (2246822519 as long)) + ((time * 1000.0) as long)) & (4294967295 as long)
            y = y + 2.0 * j.half_y
            x = j.centre.x + (hash01(n) * 2.0 - 1.0) * j.half_x
            z = j.centre.z + (hash01(n + (1 as long)) * 2.0 - 1.0) * j.half_z
        } else if y > j.centre.y + j.half_y {
            y = y - 2.0 * j.half_y
        }
        if x < j.centre.x - j.half_x { x = x + 2.0 * j.half_x } else if x > j.centre.x + j.half_x { x = x - 2.0 * j.half_x }
        if z < j.centre.z - j.half_z { z = z + 2.0 * j.half_z } else if z > j.centre.z + j.half_z { z = z - 2.0 * j.half_z }
        p[i * 3] = x
        p[i * 3 + 1] = y
        p[i * 3 + 2] = z
        i = i + 1
    }
}

// One step of `dt` seconds over the engine's pool; `time` is the clock the sway runs on.
step_particles(xyz: ptr, phases: ptr, count: int, dt: float, fall: float, wind: Vec3, sway: float, time: float,
               centre: Vec3, half_x: float, half_y: float, half_z: float) {
    if xyz == null || count <= 0 { return }
    job = WeatherStepJob { xyz: xyz, phases: phases, dt: dt, fall: fall, wind: wind, sway: sway, time: time,
                    centre: centre, half_x: half_x, half_y: half_y, half_z: half_z }
    jobs.parallel_for(step_block, count, 8192, (&job) as ptr)
}
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern sin(x: float) -> float

const CLEAR = 0
const RAIN = 1
const SNOW = 2
const DUST = 3
const STORM = 4

// The most particles any kind uses at full intensity; the streams are
// sized to it once and drawn to the count the intensity asks for.
const MAX_PARTICLES = 120000

struct Weather {
    engine: ptr
    kind: int
    intensity: float
    wind_dir: Vec3
    wind_speed: float
    // The particle stream: the model that draws it, the positions and the
    // sway phases it is stepped from, and how many are drawn.
    particles: ptr
    xyz: ptr
    phases: ptr
    count: int
    // The box around the camera the particles live in.
    half_x: float
    half_y: float
    half_z: float
    clock: float
    // The storm's lightning: seconds to the next flash, and frames of the
    // one under way.
    next_flash: float
    flash_left: int
    light_intensity: float
    // What the scene had before the weather came, to give back: its fog,
    // its clouds and its overcast, and its key light's intensity, which the
    // weather dims. Taken when the weather comes over a clear scene, given
    // back when it clears.
    had_fog: Fog
    had_clouds: float
    had_cloud_wind: float
    had_overcast: float
    had_overcast_color: Vec3
    had_light: float
    behaviour: ptr
}

weather_new(e: *Engine) -> *Weather {
    w = heap.new(Weather)
    w.engine = e as ptr
    w.kind = CLEAR
    w.intensity = 0.0
    w.wind_dir = core.vec3(1.0, 0.0, 0.2)
    w.wind_speed = 3.0
    w.count = 0
    w.half_x = 40.0
    w.half_y = 25.0
    w.half_z = 40.0
    w.clock = 0.0
    w.next_flash = 4.0
    w.flash_left = 0
    w.light_intensity = 0.0 - 1.0
    take_sky(w)
    w.had_light = 0.0 - 1.0
    w.xyz = calloc(MAX_PARTICLES * 3, 8)
    w.phases = calloc(MAX_PARTICLES, 8)
    // One model for the stream: a quad drawn as a billboard turned to the
    // eye, whose model scale makes it a streak, a flake or a mote. A drop
    // is a streak stood upright and spun to face the eye; a flake and a
    // mote face it fully.
    m = quad()
    core.model_set_texture(m, soft_disc())
    core.model_set_casts_shadow(m, false)
    core.model_set_exposure(m, 1.0)
    core.model_enable_instancing(m, MAX_PARTICLES)
    core.model_enable_point_instancing(m)
    core.model_enable_instance_colors(m)
    // Added with its whole stream counted, since a renderer sets up an
    // instanced model's buffers from the count it has when it is added;
    // then drawn to none until there is weather.
    m.visible = false
    engine.engine_add_model(e, m)
    core.model_set_instance_draw_count(m, 0)
    w.particles = m as ptr
    b = engine.behaviour_new("weather", w as ptr)
    b.update = on_update
    engine.engine_add_behaviour(e, b)
    w.behaviour = b as ptr
    return w
}

weather_free(w: *Weather) {
    if w == null { return }
    if w.behaviour != null { engine.engine_remove_behaviour(w.engine as *Engine, w.behaviour as *Behaviour) }
    if w.particles != null {
        engine.engine_remove_model(w.engine as *Engine, w.particles as *Model)
        core.model_free(w.particles as *Model)
    }
    if w.xyz != null { free(w.xyz) }
    if w.phases != null { free(w.phases) }
    heap.free(w)
}

weather_kind(w: *Weather) -> int { return w.kind }
weather_intensity(w: *Weather) -> float { return w.intensity }
weather_particle_count(w: *Weather) -> int { return w.count }
weather_flashing(w: *Weather) -> bool { return w.flash_left > 0 }

weather_set_wind(w: *Weather, direction: Vec3, speed: float) {
    w.wind_dir = core.v3_normalize(direction)
    w.wind_speed = speed
}

// The kind and its intensity, 0..1: the particle count, their size and
// colour, the fog and the cloud cover follow from it.
weather_set(w: *Weather, kind: int, intensity: float) {
    e = w.engine as *Engine
    m = w.particles as *Model
    w.kind = kind
    w.intensity = core.clampf(intensity, 0.0, 1.0)
    end_flash(w)
    light = engine.engine_light(e)
    if light != null {
        if w.had_light < 0.0 { w.had_light = light.intensity }
        light.intensity = w.had_light
    }
    if kind == CLEAR || w.intensity <= 0.0 {
        was_clear = w.count == 0
        w.kind = CLEAR
        w.count = 0
        core.model_set_instance_draw_count(m, 0)
        m.visible = false
        // The scene's own sky back, unless there was no weather to have
        // taken it, in which case the sky as set now is the scene's.
        if was_clear { take_sky(w) }
        engine.engine_set_fog(e, w.had_fog)
        engine.engine_set_clouds(e, w.had_clouds, w.had_cloud_wind)
        engine.engine_set_sky_overcast(e, w.had_overcast, w.had_overcast_color)
        engine.engine_set_wetness(e, 0.0)
        return
    }
    // Over a clear scene: the sky as it is now is what to give back.
    if w.count == 0 { take_sky(w) }
    // The ground under the weather: wet in rain, wetter in a storm, dry
    // under snow and dust.
    wetness = 0.0
    if kind == RAIN { wetness = 0.5 + 0.5 * w.intensity }
    if kind == STORM { wetness = 1.0 }
    engine.engine_set_wetness(e, wetness)
    // The sun under the weather: dimmed by the cloud that brings it.
    if light != null { light.intensity = w.had_light * dim_of(w) }
    at = eye(e)
    if kind == RAIN || kind == STORM {
        w.count = (20000.0 + 80000.0 * w.intensity) as int
        w.half_x = 45.0
        w.half_y = 22.0
        w.half_z = 45.0
        // A streak: a finger thin, half a metre long, pale and translucent
        // against the sky, glowing a little so the light does not paint it
        // the colour of the ground.
        core.model_set_scale(m, 0.02, 0.5, 1.0)
        core.model_set_billboard(m, 1)
        core.model_matte(m, 0.70, 0.76, 0.86)
        core.model_set_alpha(m, 0.4)
        fog_end = 2600.0 - 1500.0 * w.intensity
        if kind == STORM { fog_end = 1800.0 - 1200.0 * w.intensity }
        // The fog is the colour the overcast sky comes to at the horizon,
        // so the sea's far edge meets the sky without a band between them.
        haze = core.vec3(0.54, 0.57, 0.62)
        if kind == STORM { haze = core.vec3(0.35, 0.37, 0.41) }
        engine.engine_set_fog(e, core.fog_distance(30.0, fog_end, haze, 1.0))
        cover = 0.75 + 0.25 * w.intensity
        if kind == STORM { cover = 1.0 }
        engine.engine_set_clouds(e, cover, 2.0 + 3.0 * w.intensity)
        // The sky goes to the grey of a wet day, darker in a storm.
        grey = core.vec3(0.62, 0.65, 0.70)
        if kind == STORM { grey = core.vec3(0.40, 0.42, 0.47) }
        engine.engine_set_sky_overcast(e, 0.55 + 0.45 * w.intensity, grey)
    }
    if kind == SNOW {
        w.count = (8000.0 + 50000.0 * w.intensity) as int
        w.half_x = 35.0
        w.half_y = 18.0
        w.half_z = 35.0
        core.model_set_scale(m, 0.045, 0.045, 1.0)
        core.model_set_billboard(m, 2)
        core.model_matte(m, 0.96, 0.97, 1.0)
        core.model_set_alpha(m, 0.85)
        engine.engine_set_fog(e, core.fog_distance(15.0, 2200.0 - 1400.0 * w.intensity, core.vec3(0.72, 0.74, 0.78), 1.0))
        engine.engine_set_clouds(e, 0.7 + 0.3 * w.intensity, 1.0)
        engine.engine_set_sky_overcast(e, 0.6 + 0.4 * w.intensity, core.vec3(0.78, 0.80, 0.84))
    }
    if kind == DUST {
        w.count = (15000.0 + 45000.0 * w.intensity) as int
        w.half_x = 50.0
        w.half_y = 14.0
        w.half_z = 50.0
        core.model_set_scale(m, 0.12, 0.12, 1.0)
        core.model_set_billboard(m, 2)
        core.model_matte(m, 0.76, 0.62, 0.42)
        core.model_set_alpha(m, 0.3)
        // The storm's haze: the world goes ochre and short, sky and all.
        engine.engine_set_fog(e, core.fog_distance(5.0, 900.0 - 720.0 * w.intensity, core.vec3(0.66, 0.52, 0.34), 1.0))
        engine.engine_set_clouds(e, 0.4 + 0.4 * w.intensity, 3.0)
        engine.engine_set_sky_overcast(e, 0.5 + 0.5 * w.intensity, core.vec3(0.80, 0.62, 0.40))
    }
    if w.count > MAX_PARTICLES { w.count = MAX_PARTICLES }
    scatter(w.xyz, w.phases, w.count, at, w.half_x, w.half_y, w.half_z, kind * 977 + 13)
    core.model_set_instance_draw_count(m, w.count)
    core.model_set_instance_positions(m, w.xyz, w.count)
    m.visible = true
}

on_update(state: ptr, e: *Engine, delta: float) {
    weather_step(state as *Weather, delta)
}

// How much of the sun the weather leaves.
dim_of(w: *Weather) -> float {
    if w.kind == RAIN { return 1.0 - 0.45 * w.intensity }
    if w.kind == STORM { return 1.0 - 0.7 * w.intensity }
    if w.kind == SNOW { return 1.0 - 0.35 * w.intensity }
    if w.kind == DUST { return 1.0 - 0.5 * w.intensity }
    return 1.0
}

// The scene set its key light under the weather -- an editor's row, the
// hour of the day -- so the light's intensity now is the scene's own, and
// the weather dims it from there and gives that back when it clears.
weather_relight(w: *Weather) {
    light = engine.engine_light(w.engine as *Engine)
    if light == null { return }
    w.had_light = light.intensity
    if w.kind == CLEAR { return }
    end_flash(w)
    light.intensity = w.had_light * dim_of(w)
}

// The scene's sky as it stands: its fog, its clouds and its overcast.
take_sky(w: *Weather) {
    e = w.engine as *Engine
    w.had_fog = engine.engine_fog(e)
    w.had_clouds = engine.engine_clouds(e)
    w.had_cloud_wind = engine.engine_cloud_wind(e)
    w.had_overcast = engine.engine_sky_overcast(e)
    w.had_overcast_color = engine.engine_sky_overcast_color(e)
}

// The particle's picture: a soft disc, its alpha falling off from the
// centre to nothing at the edge, so a flake is a dot and a streak a line
// with soft ends rather than a square. Made once, from the engine's own
// numbers, and registered as a texture by name.
const DISC = 32
soft_disc() -> string {
    name = "ae3d://weather/soft_disc"
    pixels = calloc(DISC * DISC, 4)
    y = 0
    while y < DISC {
        x = 0
        while x < DISC {
            dx = ((x as float) + 0.5) / (DISC as float) - 0.5
            dy = ((y as float) + 0.5) / (DISC as float) - 0.5
            r = core.sqrt_of(dx * dx + dy * dy) * 2.0
            a = 1.0 - r * r
            if a < 0.0 { a = 0.0 }
            png.rgba_set(pixels, y * DISC + x, 1.0, 1.0, 1.0, a)
            x = x + 1
        }
        y = y + 1
    }
    ok = ae3d_image_register(name, pixels, DISC, DISC) == 1
    free(pixels)
    if !ok { return "" }
    return name
}

// A unit quad in the XY plane facing +Z, one metre across, centred: what
// the billboard turns to the eye.
quad() -> *Model {
    m = core.model_new()
    facing = core.vec3(0.0, 0.0, 1.0)
    core.mesh_reserve(m.mesh, 4, 6)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 0.5, 0.0 - 0.5, 0.0), 0.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.5, 0.0 - 0.5, 0.0), 1.0, 0.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.5, 0.5, 0.0), 1.0, 1.0, facing)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - 0.5, 0.5, 0.0), 0.0, 1.0, facing)
    core.mesh_push_triangle(m.mesh, 0, 1, 2)
    core.mesh_push_triangle(m.mesh, 0, 2, 3)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// Where particle `index` is now, for a program that reads the weather back.
weather_particle(w: *Weather, index: int) -> Vec3 {
    if index < 0 || index >= w.count { return core.vec3(0.0, 0.0, 0.0) }
    xyz = w.xyz as float[]
    return core.vec3(xyz[index * 3], xyz[index * 3 + 1], xyz[index * 3 + 2])
}

// Where the eye is and where it looks: the engine's camera, which exists
// once the engine runs; before that, the origin looking down -Z.
eye(e: *Engine) -> Vec3 {
    cam = engine.engine_camera(e)
    if cam == null { return core.vec3(0.0, 0.0, 0.0) }
    return cam.position
}

gaze(e: *Engine) -> Vec3 {
    cam = engine.engine_camera(e)
    if cam == null { return core.vec3(0.0, 0.0, 0.0 - 1.0) }
    return cam.front
}

// The frame's step: the particles fall and wrap around the camera, and a
// storm keeps its lightning. The engine's loop calls it through the
// weather's behaviour; a test calls it by hand.
weather_step(w: *Weather, delta: float) {
    e = w.engine as *Engine
    if w.kind == CLEAR || w.count == 0 { return }
    w.clock = w.clock + delta
    // The box rides ahead of the camera, so what falls in front of the eye
    // is dense and what falls behind it is not drawn.
    centre = core.v3_add(eye(e), core.v3_mul(gaze(e), w.half_z * 0.45))
    fall = 9.0
    sway = 0.0
    wind = core.v3_mul(w.wind_dir, w.wind_speed)
    if w.kind == STORM { fall = 14.0 ; wind = core.v3_mul(w.wind_dir, w.wind_speed * 1.8) }
    if w.kind == SNOW { fall = 1.1 ; sway = 0.7 }
    if w.kind == DUST { fall = 0.25 ; sway = 1.2 }
    step_particles(w.xyz, w.phases, w.count, delta, fall, wind, sway, w.clock, centre, w.half_x, w.half_y, w.half_z)
    core.model_set_instance_positions(w.particles as *Model, w.xyz, w.count)

    if w.kind == STORM { lightning(w, e, delta) }
}

// A flash: the key light thrown up for a few frames, its return to what it
// was staggered over two so the flash reads as a flicker rather than a
// step, then the next some seconds off at the storm's own beat.
lightning(w: *Weather, e: *Engine, delta: float) {
    light = engine.engine_light(e)
    if light == null { return }
    if w.flash_left > 0 {
        w.flash_left = w.flash_left - 1
        if w.flash_left == 0 {
            end_flash(w)
        } else if w.flash_left == 1 {
            light.intensity = w.light_intensity * 3.0
        }
        return
    }
    w.next_flash = w.next_flash - delta
    if w.next_flash > 0.0 { return }
    w.light_intensity = light.intensity
    light.intensity = light.intensity * (8.0 + 6.0 * w.intensity)
    w.flash_left = 3
    // Three to nine seconds between flashes, closer the harder it storms,
    // from the clock rather than a random, so a run is repeatable.
    w.next_flash = 3.0 + (1.0 - w.intensity) * 4.0 + 2.0 * (0.5 + 0.5 * sin(w.clock * 7.3))
}

end_flash(w: *Weather) {
    if w.light_intensity < 0.0 { return }
    light = engine.engine_light(w.engine as *Engine)
    if light != null && w.flash_left >= 0 { light.intensity = w.light_intensity }
    w.light_intensity = 0.0 - 1.0
    w.flash_left = 0
}
