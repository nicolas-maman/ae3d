// Saving and loading scenes.
//
// A scene is JSON: transforms, materials and where each model's geometry comes
// from. A model loaded from a file records its path and is reloaded through the
// OBJ loader; a procedural one, a voxel world or a meshed field, writes its
// geometry to a compressed binary mesh beside the scene, because regenerating it
// is neither cheap nor guaranteed to reproduce the same thing.

import std.list
import std.heap
import std.fs
import std.json
import std.string
import ae3d.core
import ae3d.loader
import ae3d.shaders
import ae3d.water
import ae3d.voxel
import ae3d.terrain

exports (
    scene_save, scene_load, scene_load_lights, scene_load_attachments,
    scene_load_view, view_defaults, View, Attachment, attachment_new,
    attachment_model, attachment_component, attachment_script, attachment_water,
    attachment_world,
    attachments_free, scene_free, last_error
)

// What is attached to a model besides its mesh and material: which kind of
// thing it is, the behaviour running on it, and the water simulation driving
// it. Gopher3D's scene file carries the same idea as a list of components with
// a type and a category; this is that, typed, and matched to its model by the
// model itself so the two cannot drift apart.
//
// One list rather than one per kind: water, scripts and light markers are all
// "something attached to this model", and a parameter per kind is three of the
// same thing.
struct Attachment {
    model: ptr
    component: string
    script: string
    water: ptr
    world: ptr
}

// What a scene records besides its models and lights: where the camera stood,
// what the sky was, and the render settings in force. Gopher3D's scene file
// carries all three and ae3d's carried none, so a saved scene came back framed
// somewhere else, under a different sky, with the post chain off.
struct View {
    camera_x: float
    camera_y: float
    camera_z: float
    yaw: float
    pitch: float
    fov: float
    near: float
    far: float
    speed: float

    sky_r: float
    sky_g: float
    sky_b: float

    fxaa: bool
    bloom: bool
    bloom_threshold: float
    bloom_intensity: float
    // Screen-space reflection of the scene in wet ground: on the Vulkan
    // backend, inert on OpenGL, carried by the scene either way so a scene
    // authored with it comes back with it.
    ssr: bool
    ssr_road_height: float
    ssr_strength: float
    // Clouds over the sky, marched by either backend: whether, and how
    // much of the sky they cover.
    clouds: bool
    cloud_cover: float
    face_culling: bool
    frustum_culling: bool
}

extern ae3d_meshfile_save(path: string, mesh: ptr, instances: ptr) -> int
extern ae3d_meshfile_load(path: string) -> ptr
extern ae3d_meshfile_mesh(handle: ptr) -> ptr
extern ae3d_meshfile_instances(handle: ptr) -> ptr
extern ae3d_meshfile_release(handle: ptr)
extern ae3d_meshfile_error() -> string
extern ae3d_mesh_destroy(mesh: ptr)
extern ae3d_inst_destroy(instances: ptr)
extern ae3d_inst_count(instances: ptr) -> int
extern ae3d_farr_count(arr: ptr) -> int
extern ae3d_farr_get(arr: ptr, i: int) -> float
extern ae3d_farr_set(arr: ptr, i: int, v: float)

var g_error = ""
var g_error_owned = false

last_error() -> string {
    return g_error
}

set_error(reason: string, detail: string) {
    if g_error_owned { string.free(g_error) }
    g_error = string.concat(reason, detail)
    g_error_owned = true
}

vec3_json(v: Vec3) -> ptr {
    out = json.arr()
    json.array_add_raw(out, json.num(v.x))
    json.array_add_raw(out, json.num(v.y))
    json.array_add_raw(out, json.num(v.z))
    return out
}

quat_json(q: Quat) -> ptr {
    out = json.arr()
    json.array_add_raw(out, json.num(q.x))
    json.array_add_raw(out, json.num(q.y))
    json.array_add_raw(out, json.num(q.z))
    json.array_add_raw(out, json.num(q.w))
    return out
}

// A model's own uniforms are where every shading setting lives, so a scene that
// leaves them out loads back looking nothing like the one that was saved. The
// array uniforms go too: they were skipped on the reasoning that the simulation
// that owns them rebuilds them, but a loaded scene has no simulation, so a
// water surface came back with no wave table at all.
// A scene is what the renderer draws, and half of that is how it is lit.
light_json(l: *Light) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "name", json.str(core.text(l.name)))
    json.object_set_raw(out, "mode", json.from_int(l.mode))
    json.object_set_raw(out, "kind", json.from_int(l.kind))
    json.object_set_raw(out, "position", vec3_json(l.position))
    json.object_set_raw(out, "direction", vec3_json(l.direction))
    json.object_set_raw(out, "color", vec3_json(l.color))
    json.object_set_raw(out, "intensity", json.num(l.intensity))
    json.object_set_raw(out, "ambient", json.num(l.ambient_strength))
    json.object_set_raw(out, "temperature", json.num(l.temperature))
    json.object_set_raw(out, "constant", json.num(l.constant_atten))
    json.object_set_raw(out, "linear", json.num(l.linear_atten))
    json.object_set_raw(out, "quadratic", json.num(l.quadratic_atten))
    return out
}

load_light(node: ptr) -> *Light {
    if node == null { return null }
    l = core.light_new()
    core.light_set_name(l, field_string(node, "name"))
    l.mode = field_int(node, "mode", core.MODE_DIRECTIONAL)
    l.kind = field_int(node, "kind", core.LIGHT_STATIC)
    l.position = vec3_of(json.object_get_raw(node, "position"))
    l.direction = vec3_of(json.object_get_raw(node, "direction"))
    l.color = vec3_of(json.object_get_raw(node, "color"))
    l.intensity = field_number(node, "intensity", 1.0)
    l.ambient_strength = field_number(node, "ambient", 0.15)
    l.temperature = field_number(node, "temperature", 5500.0)
    l.constant_atten = field_number(node, "constant", 1.0)
    l.linear_atten = field_number(node, "linear", 0.0)
    l.quadratic_atten = field_number(node, "quadratic", 0.0)
    return l
}

// The lights a scene was saved with, or null where it has none. Files written
// before scenes carried lights simply have none, and the caller keeps whatever
// it was already lighting with.
// What was attached to the models a scene was just loaded, in the same order.
// Read separately from scene_load for the same reason the lights are: a caller
// that only wants models asks for models and gets them.
//
// One record per model that has anything attached, and none for the rest. Free
// the list with attachments_free; the simulations in it belong to the caller.
scene_load_attachments(path: string, models: ptr) -> ptr {
    if models == null { return null }
    root = read_root(path)
    if root == null { return null }

    entries = json.object_get_raw(root, "models")
    if entries == null {
        json.free(root)
        return null
    }

    attachments = list.new()
    count = json.array_size(entries)
    if count > list.size(models) { count = list.size(models) }
    i = 0
    while i < count {
        entry = json.array_get_raw(entries, i)
        m = list.get_raw(models, i) as *Model
        component = field_string(entry, "component")
        script = field_string(entry, "script")
        sim = null as *Simulation
        node = json.object_get_raw(entry, "water")
        if node != null {
            w = water.simulation_new(field_number(node, "ocean_size", 1000.0),
                                     field_number(node, "base_amplitude", 1.0))
            colour = json.object_get_raw(node, "color")
            water.simulation_set_color(w, number_at(colour, 0),
                                       number_at(colour, 1), number_at(colour, 2))
            sky = json.object_get_raw(node, "sky_color")
            water.simulation_set_sky_color(w, number_at(sky, 0),
                                           number_at(sky, 1), number_at(sky, 2))
            water.simulation_set_opacity(w, field_number(node, "opacity", 0.85))
            water.simulation_set_wave_speed(w, field_number(node, "wave_speed", 1.0))
            water.simulation_set_wave_height(w, field_number(node, "wave_height", 1.0))
            water.simulation_set_randomness(w, field_number(node, "wave_randomness", 0.0))
            water.simulation_set_caustics(w, field_bool(node, "caustics", false),
                                          field_number(node, "caustics_intensity", 0.3),
                                          field_number(node, "caustics_scale", 0.003))
            water.simulation_set_foam(w, field_bool(node, "foam", true),
                                      field_number(node, "foam_intensity", 1.0))
            water.simulation_set_reflection(w, field_number(node, "reflection", 1.0))
            water.simulation_set_shadow(w, field_number(node, "shadow", 0.5))
            water.simulation_set_distortion(w, field_number(node, "distortion", 0.2))
            water.simulation_set_normal_strength(w, field_number(node, "normal_strength", 1.0))
            water.simulation_set_wave_scale(w, field_number(node, "wave_scale", 1.0))
            water.simulation_set_shore(w, field_number(node, "shore_fade", 0.0),
                                       field_number(node, "shore_foam", 0.0))
            sky_image = field_string(node, "sky_texture")
            if sky_image != "" { water.simulation_set_sky_texture(w, sky_image) }
            water.simulation_adopt(w, m)
            sim = w
        }
        world = null as *World
        vox = json.object_get_raw(entry, "voxel")
        if vox != null {
            world = voxel.world_new(field_int(vox, "size_x", 48),
                                    field_int(vox, "size_z", 48),
                                    field_int(vox, "max_height", 28),
                                    field_number(vox, "voxel_size", 4.0))
            if world != null {
                terrain.fill_seeded(world, field_int(vox, "seed", 0) as long,
                                    field_int(vox, "biome", terrain.PLAINS))
            }
        }

        if component != "" || script != "" || sim != null || world != null {
            list.add_raw(attachments,
                         attachment_new(m, component, script, sim, world) as ptr)
        }
        i = i + 1
    }
    json.free(root)
    return attachments
}

// Where the camera stood, what the sky was, and the render settings in force.
// A file written before scenes carried them gets the defaults, so an old scene
// opens the way it always did rather than at the origin under a black sky.
scene_load_view(path: string) -> View {
    v = view_defaults()
    root = read_root(path)
    if root == null { return v }

    node = json.object_get_raw(root, "view")
    if node == null {
        json.free(root)
        return v
    }

    position = json.object_get_raw(node, "position")
    if position != null {
        v.camera_x = number_at(position, 0)
        v.camera_y = number_at(position, 1)
        v.camera_z = number_at(position, 2)
    }
    v.yaw = field_number(node, "yaw", v.yaw)
    v.pitch = field_number(node, "pitch", v.pitch)
    v.fov = field_number(node, "fov", v.fov)
    v.near = field_number(node, "near", v.near)
    v.far = field_number(node, "far", v.far)
    v.speed = field_number(node, "speed", v.speed)

    sky = json.object_get_raw(node, "skybox")
    if sky != null {
        colour = json.object_get_raw(sky, "color")
        if colour != null {
            v.sky_r = number_at(colour, 0)
            v.sky_g = number_at(colour, 1)
            v.sky_b = number_at(colour, 2)
        }
    }

    render = json.object_get_raw(node, "rendering")
    if render != null {
        v.fxaa = field_bool(render, "fxaa", v.fxaa)
        v.bloom = field_bool(render, "bloom", v.bloom)
        v.bloom_threshold = field_number(render, "bloom_threshold", v.bloom_threshold)
        v.bloom_intensity = field_number(render, "bloom_intensity", v.bloom_intensity)
        v.ssr = field_bool(render, "ssr", v.ssr)
        v.ssr_road_height = field_number(render, "ssr_road_height", v.ssr_road_height)
        v.ssr_strength = field_number(render, "ssr_strength", v.ssr_strength)
        v.clouds = field_bool(render, "clouds", v.clouds)
        v.cloud_cover = field_number(render, "cloud_cover", v.cloud_cover)
        v.face_culling = field_bool(render, "face_culling", v.face_culling)
        v.frustum_culling = field_bool(render, "frustum_culling", v.frustum_culling)
    }
    json.free(root)
    return v
}

scene_load_lights(path: string) -> ptr {
    root = read_root(path)
    if root == null { return null }

    entries = json.object_get_raw(root, "lights")
    if entries == null {
        json.free(root)
        return null
    }

    lights = list.new()
    count = json.array_size(entries)
    i = 0
    while i < count {
        l = load_light(json.array_get_raw(entries, i))
        if l != null { list.add_raw(lights, l) }
        i = i + 1
    }
    json.free(root)
    return lights
}

// A voxel world as what it takes to fill one again, rather than as its grid.
// The mesh is already written beside the scene, so this is what makes the world
// EDITABLE again: six numbers reproduce it exactly, where the grid they replace
// is a megabyte and a half for a world of any size.
//
// That holds while every world comes from a generator. The day voxels can be
// edited by hand, a world that was edited is no longer what its seed makes, and
// the grid has to be written instead.
world_json(w: *World) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "size_x", json.from_int(voxel.world_size_x(w)))
    json.object_set_raw(out, "size_z", json.from_int(voxel.world_size_z(w)))
    json.object_set_raw(out, "max_height", json.from_int(voxel.world_max_height(w)))
    json.object_set_raw(out, "voxel_size", json.num(voxel.world_voxel_size(w)))
    json.object_set_raw(out, "seed", json.from_int(voxel.world_origin_seed(w) as int))
    json.object_set_raw(out, "biome", json.from_int(voxel.world_origin_kind(w)))
    return out
}

// A water surface's simulation, written onto the model entry it drives. The
// mesh already round-trips; this is the state that decides how it moves and
// what it looks like, and without it a loaded surface was a mesh with no
// simulation behind it: static, and with none of the editor's controls
// reaching it.
water_json(w: *Simulation) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "ocean_size", json.num(water.simulation_size(w)))
    json.object_set_raw(out, "base_amplitude", json.num(water.simulation_amplitude(w)))
    colour = json.arr()
    json.array_add_raw(colour, json.num(water.simulation_color_r(w)))
    json.array_add_raw(colour, json.num(water.simulation_color_g(w)))
    json.array_add_raw(colour, json.num(water.simulation_color_b(w)))
    json.object_set_raw(out, "color", colour)
    sky = json.arr()
    json.array_add_raw(sky, json.num(water.simulation_sky_r(w)))
    json.array_add_raw(sky, json.num(water.simulation_sky_g(w)))
    json.array_add_raw(sky, json.num(water.simulation_sky_b(w)))
    json.object_set_raw(out, "sky_color", sky)
    json.object_set_raw(out, "opacity", json.num(water.simulation_opacity(w)))
    json.object_set_raw(out, "wave_speed", json.num(water.simulation_wave_speed(w)))
    json.object_set_raw(out, "wave_height", json.num(water.simulation_wave_height(w)))
    json.object_set_raw(out, "wave_randomness", json.num(water.simulation_randomness(w)))
    json.object_set_raw(out, "caustics", json.boolean(water.simulation_caustics_on(w)))
    json.object_set_raw(out, "caustics_intensity", json.num(water.simulation_caustics_intensity(w)))
    json.object_set_raw(out, "caustics_scale", json.num(water.simulation_caustics_scale(w)))
    json.object_set_raw(out, "foam", json.boolean(water.simulation_foam_on(w)))
    json.object_set_raw(out, "foam_intensity", json.num(water.simulation_foam_intensity(w)))
    json.object_set_raw(out, "reflection", json.num(water.simulation_reflection(w)))
    json.object_set_raw(out, "shadow", json.num(water.simulation_shadow(w)))
    json.object_set_raw(out, "distortion", json.num(water.simulation_distortion(w)))
    json.object_set_raw(out, "normal_strength", json.num(water.simulation_normal(w)))
    json.object_set_raw(out, "wave_scale", json.num(water.simulation_wave_scale(w)))
    json.object_set_raw(out, "shore_fade", json.num(water.simulation_shore_fade(w)))
    json.object_set_raw(out, "shore_foam", json.num(water.simulation_shore_foam(w)))
    json.object_set_raw(out, "sky_texture", json.str(water.simulation_sky_path(w)))
    return out
}

// The two names are COPIED. A reader takes them from the parsed document and
// the document is freed before the caller looks at them, so borrowing here
// hands back two pointers into released memory.
attachment_new(m: *Model, component: string, script: string,
               w: *Simulation, world: *World) -> *Attachment {
    a = heap.new(Attachment)
    a.model = m as ptr
    a.component = string.copy(component)
    a.script = string.copy(script)
    a.water = w as ptr
    a.world = world as ptr
    return a
}

attachment_model(a: *Attachment) -> *Model { return a.model as *Model }
attachment_component(a: *Attachment) -> string { return a.component }
attachment_script(a: *Attachment) -> string { return a.script }
attachment_water(a: *Attachment) -> *Simulation { return a.water as *Simulation }
attachment_world(a: *Attachment) -> *World { return a.world as *World }

// The records themselves, not what they point at: a simulation handed back by
// scene_load_attachments belongs to the caller and outlives the list.
attachments_free(attachments: ptr) {
    if attachments == null { return }
    count = list.size(attachments)
    i = 0
    while i < count {
        // heap.free releases the two names with it; releasing them by hand
        // first is the double free docs/string_ownership.md warns about.
        heap.free(list.get_raw(attachments, i) as *Attachment)
        i = i + 1
    }
    list.free(attachments)
}

// What is attached to this model, or null. Matched by the model itself rather
// than by position in a list, so the two cannot drift apart.
attachment_for(attachments: ptr, m: *Model) -> *Attachment {
    if attachments == null { return null }
    count = list.size(attachments)
    i = 0
    while i < count {
        a = list.get_raw(attachments, i) as *Attachment
        if a != null && a.model == m as ptr { return a }
        i = i + 1
    }
    return null
}

view_defaults() -> View {
    return View {
        camera_x: 0.0, camera_y: 0.0, camera_z: 0.0,
        yaw: 0.0 - 90.0, pitch: 0.0, fov: 45.0,
        near: 0.1, far: 10000.0, speed: 100.0,
        sky_r: 0.0, sky_g: 0.0, sky_b: 0.0,
        fxaa: false, bloom: false,
        bloom_threshold: 1.0, bloom_intensity: 1.0,
        ssr: false, ssr_road_height: 0.0, ssr_strength: 0.6,
        clouds: false, cloud_cover: 0.4,
        face_culling: false, frustum_culling: false
    }
}

view_json(v: *View) -> ptr {
    out = json.obj()
    position = json.arr()
    json.array_add_raw(position, json.num(v.camera_x))
    json.array_add_raw(position, json.num(v.camera_y))
    json.array_add_raw(position, json.num(v.camera_z))
    json.object_set_raw(out, "position", position)
    json.object_set_raw(out, "yaw", json.num(v.yaw))
    json.object_set_raw(out, "pitch", json.num(v.pitch))
    json.object_set_raw(out, "fov", json.num(v.fov))
    json.object_set_raw(out, "near", json.num(v.near))
    json.object_set_raw(out, "far", json.num(v.far))
    json.object_set_raw(out, "speed", json.num(v.speed))

    sky = json.obj()
    colour = json.arr()
    json.array_add_raw(colour, json.num(v.sky_r))
    json.array_add_raw(colour, json.num(v.sky_g))
    json.array_add_raw(colour, json.num(v.sky_b))
    json.object_set_raw(sky, "color", colour)
    json.object_set_raw(out, "skybox", sky)

    render = json.obj()
    json.object_set_raw(render, "fxaa", json.boolean(v.fxaa))
    json.object_set_raw(render, "bloom", json.boolean(v.bloom))
    json.object_set_raw(render, "bloom_threshold", json.num(v.bloom_threshold))
    json.object_set_raw(render, "bloom_intensity", json.num(v.bloom_intensity))
    json.object_set_raw(render, "ssr", json.boolean(v.ssr))
    json.object_set_raw(render, "ssr_road_height", json.num(v.ssr_road_height))
    json.object_set_raw(render, "ssr_strength", json.num(v.ssr_strength))
    json.object_set_raw(render, "clouds", json.boolean(v.clouds))
    json.object_set_raw(render, "cloud_cover", json.num(v.cloud_cover))
    json.object_set_raw(render, "face_culling", json.boolean(v.face_culling))
    json.object_set_raw(render, "frustum_culling", json.boolean(v.frustum_culling))
    json.object_set_raw(out, "rendering", render)
    return out
}

uniforms_json(m: *Model) -> ptr {
    out = json.arr()
    count = core.model_uniform_count(m)
    i = 0
    while i < count {
        u = core.model_uniform(m, i)
        if u != null {
            entry = json.obj()
            json.object_set_raw(entry, "name", json.str(u.name))
            json.object_set_raw(entry, "kind", json.from_int(u.kind))
            if u.array != null {
                values = json.arr()
                n = ae3d_farr_count(u.array)
                k = 0
                while k < n {
                    json.array_add_raw(values, json.num(ae3d_farr_get(u.array, k)))
                    k = k + 1
                }
                json.object_set_raw(entry, "values", values)
            } else if u.kind == core.UNIFORM_FLOAT {
                json.object_set_raw(entry, "value", json.num(u.number))
            } else if u.kind == core.UNIFORM_INT {
                json.object_set_raw(entry, "value", json.from_int(u.integer))
            } else if u.kind == core.UNIFORM_VEC3 {
                json.object_set_raw(entry, "value", vec3_json(u.vector))
            }
            json.array_add_raw(out, entry)
        }
        i = i + 1
    }
    return out
}

// A named shader rebuilt from the kind the scene recorded. An unknown kind
// gets no shader rather than a wrong one: a file written by a newer version
// names a shader this build does not have, and drawing it with something else
// would be a silent substitution.
shader_for(kind: int) -> Shader {
    if kind == core.SHADER_WATER { return shaders.water_shader() }
    return core.shader_new("", "")
}

load_uniforms(m: *Model, node: ptr) {
    if node == null { return }
    count = json.array_size(node)
    i = 0
    while i < count {
        entry = json.array_get_raw(node, i)
        if entry != null {
            name = field_string(entry, "name")
            kind = field_int(entry, "kind", core.UNIFORM_FLOAT)
            values = json.object_get_raw(entry, "values")
            value = json.object_get_raw(entry, "value")
            if name != "" && values != null {
                n = json.array_size(values)
                into = core.model_set_uniform_array(m, name, n,
                                                    kind == core.UNIFORM_VEC3_ARRAY)
                k = 0
                while k < n {
                    ae3d_farr_set(into, k, number_at(values, k))
                    k = k + 1
                }
            } else if name != "" && value != null {
                if kind == core.UNIFORM_FLOAT {
                    core.model_set_uniform_float(m, name, json.get_number(value))
                } else if kind == core.UNIFORM_INT {
                    core.model_set_uniform_int(m, name, json.get_int(value))
                } else if kind == core.UNIFORM_VEC3 {
                    core.model_set_uniform_vec3(m, name, vec3_of(value))
                }
            }
        }
        i = i + 1
    }
}

number_at(node: ptr, index: int) -> float {
    element = json.array_get_raw(node, index)
    if element == null { return 0.0 }
    return json.get_number(element)
}

vec3_of(node: ptr) -> Vec3 {
    if node == null || json.array_size(node) < 3 { return core.vec3(0.0, 0.0, 0.0) }
    return core.vec3(number_at(node, 0), number_at(node, 1), number_at(node, 2))
}

quat_of(node: ptr) -> Quat {
    if node == null || json.array_size(node) < 4 { return core.quat_ident() }
    return core.quat(number_at(node, 0), number_at(node, 1),
                     number_at(node, 2), number_at(node, 3))
}

// Read and parse a scene file. Three readers open the same file for different
// parts of it, and each one used to spell this out again.
read_root(path: string) -> ptr {
    text, err = fs.read(path)
    if err != "" {
        set_error("cannot read ", path)
        string.free(text)
        return null
    }
    root = json.parse_raw(text)
    string.free(text)
    if root == null { set_error("cannot parse ", path) }
    return root
}

field_bool(node: ptr, name: string, fallback: bool) -> bool {
    value = json.object_get_raw(node, name)
    if value == null { return fallback }
    return json.get_bool(value) == 1
}

field_number(node: ptr, name: string, fallback: float) -> float {
    child = json.object_get_raw(node, name)
    if child == null { return fallback }
    return json.get_number(child)
}

field_int(node: ptr, name: string, fallback: int) -> int {
    child = json.object_get_raw(node, name)
    if child == null { return fallback }
    return json.get_int(child)
}

field_string(node: ptr, name: string) -> string {
    child = json.object_get_raw(node, name)
    if child == null { return "" }
    return json.get_string_raw(child)
}

material_json(m: *Material) -> ptr {
    out = json.obj()
    json.object_set_raw(out, "diffuse", vec3_json(m.diffuse))
    json.object_set_raw(out, "specular", vec3_json(m.specular))
    json.object_set_raw(out, "metallic", json.num(m.metallic))
    json.object_set_raw(out, "roughness", json.num(m.roughness))
    json.object_set_raw(out, "exposure", json.num(m.exposure))
    json.object_set_raw(out, "alpha", json.num(m.alpha))
    json.object_set_raw(out, "reflectivity", json.num(m.reflectivity))
    json.object_set_raw(out, "texture_path", json.str(core.text(m.texture_path)))
    json.object_set_raw(out, "normal_path", json.str(core.text(m.normal_path)))
    json.object_set_raw(out, "name", json.str(core.text(m.name)))
    return out
}

apply_material(m: *Model, node: ptr) {
    if node == null { return }
    core.model_ensure_material(m)
    material = m.material

    material.diffuse = vec3_of(json.object_get_raw(node, "diffuse"))
    material.specular = vec3_of(json.object_get_raw(node, "specular"))
    material.metallic = field_number(node, "metallic", 0.0)
    material.roughness = field_number(node, "roughness", 0.5)
    material.exposure = field_number(node, "exposure", 1.0)
    material.alpha = field_number(node, "alpha", 1.0)
    material.reflectivity = field_number(node, "reflectivity", 0.0)

    texture = field_string(node, "texture_path")
    if texture != "" { core.material_set_texture_path(material, texture) }
    // The normal map went the same way as the colour texture: a material
    // saved with one came back flat, and the editor could not say why.
    normal = field_string(node, "normal_path")
    if normal != "" { core.material_set_normal_path(material, normal) }
}

mesh_file_for(directory: string, index: int) -> string {
    suffix = string.concat(string.from_int(index), ".mesh")
    name = string.concat("model_", suffix)
    string.free(suffix)
    path = string.concat(directory, name)
    string.free(name)
    return path
}

// A model that came from a file records only its path. Anything else has its
// geometry written out, because it cannot be reconstructed from the scene alone.
scene_save(models: ptr, lights: ptr, attachments: ptr, view: *View,
           path: string, mesh_directory: string) -> bool {
    if models == null { set_error("nothing to save to ", path) ; return false }

    root = json.obj()
    json.object_set_raw(root, "version", json.from_int(1))
    entries = json.arr()

    count = list.size(models)
    i = 0
    while i < count {
        m = list.get_raw(models, i) as *Model
        if m != null {
            entry = json.obj()
            json.object_set_raw(entry, "name", json.str(core.text(m.name)))
            json.object_set_raw(entry, "position", vec3_json(m.position))
            json.object_set_raw(entry, "scale", vec3_json(m.scale))
            json.object_set_raw(entry, "rotation", quat_json(m.rotation))
            json.object_set_raw(entry, "instanced", json.boolean(m.is_instanced))
            json.object_set_raw(entry, "visible", json.boolean(m.visible))
            json.object_set_raw(entry, "casts_shadow", json.boolean(m.casts_shadow))
            json.object_set_raw(entry, "uniforms", uniforms_json(m))
            attached = attachment_for(attachments, m)
            if attached != null {
                if attached.component != "" {
                    json.object_set_raw(entry, "component", json.str(attached.component))
                }
                if attached.script != "" {
                    json.object_set_raw(entry, "script", json.str(attached.script))
                }
                sim = attachment_water(attached)
                if sim != null { json.object_set_raw(entry, "water", water_json(sim)) }
                world = attachment_world(attached)
                if world != null { json.object_set_raw(entry, "voxel", world_json(world)) }
            }
            // Which shader draws it, for the named ones. The source text is not
            // written: a scene is not the place to carry a copy of the GLSL, and
            // a named kind is exactly what the backend picks its pipeline by.
            // Without this a water surface loaded back as an ordinary mesh, so
            // it was drawn by the default shader with the whole wave table sat
            // on it unread.
            if core.shader_valid(&m.shader) && m.shader.kind != core.SHADER_CUSTOM {
                json.object_set_raw(entry, "shader", json.from_int(m.shader.kind))
            }

            if m.material != null {
                json.object_set_raw(entry, "material", material_json(m.material))
            }

            if core.text(m.source_path) != "" {
                json.object_set_raw(entry, "source_path", json.str(m.source_path))
            } else {
                mesh_path = mesh_file_for(mesh_directory, i)
                if ae3d_meshfile_save(mesh_path, m.mesh, m.instances) != 1 {
                    set_error("cannot write the mesh: ", ae3d_meshfile_error())
                    string.free(mesh_path)
                    json.free(root)
                    return false
                }
                json.object_set_raw(entry, "mesh_file", json.str(mesh_path))
                string.free(mesh_path)
            }

            json.array_add_raw(entries, entry)
        }
        i = i + 1
    }

    json.object_set_raw(root, "models", entries)

    if lights != null {
        beams = json.arr()
        count = list.size(lights)
        i = 0
        while i < count {
            l = list.get_raw(lights, i) as *Light
            if l != null { json.array_add_raw(beams, light_json(l)) }
            i = i + 1
        }
        json.object_set_raw(root, "lights", beams)
    }

    if view != null { json.object_set_raw(root, "view", view_json(view)) }

    text = json.stringify_raw(root)
    json.free(root)

    err = fs.write(path, text)
    string.free(text)
    if err != "" {
        set_error("cannot write ", path)
        return false
    }
    return true
}

scene_load(path: string) -> ptr {
    content, read_error = fs.read(path)
    if read_error != "" {
        set_error("cannot read ", path)
        string.free(content)
        return null
    }

    root = json.parse_raw(content)
    string.free(content)
    if root == null {
        set_error("cannot parse ", path)
        return null
    }

    entries = json.object_get_raw(root, "models")
    if entries == null {
        set_error("no models in ", path)
        json.free(root)
        return null
    }

    models = list.new()
    count = json.array_size(entries)
    i = 0
    while i < count {
        entry = json.array_get_raw(entries, i)
        if entry != null {
            m = load_entry(entry)
            if m != null { list.add_raw(models, m) }
        }
        i = i + 1
    }

    json.free(root)

    // A file that listed models and produced none did not load: the reason is
    // whatever the last entry failed with, and handing back an empty list looks
    // exactly like a scene that was saved empty. What it can build, it keeps,
    // so one model missing its mesh does not lose the rest.
    if count > 0 && list.size(models) == 0 {
        list.free(models)
        return null
    }
    return models
}

load_entry(entry: ptr) -> *Model {
    source = field_string(entry, "source_path")
    mesh_file = field_string(entry, "mesh_file")

    m = null as *Model
    if source != "" {
        m = loader.load_obj(source, false)
        if m == null {
            set_error("cannot reload ", source)
            return null
        }
    } else if mesh_file != "" {
        handle = ae3d_meshfile_load(mesh_file)
        if handle == null {
            set_error("cannot read the mesh: ", ae3d_meshfile_error())
            return null
        }
        m = core.model_new()
        ae3d_mesh_destroy(m.mesh)
        m.mesh = ae3d_meshfile_mesh(handle)
        m.instances = ae3d_meshfile_instances(handle)
        if m.instances != null && ae3d_inst_count(m.instances) > 0 {
            m.is_instanced = true
            m.instances_updated = true
        }
        ae3d_meshfile_release(handle)
    } else {
        set_error("entry has neither a source path nor a mesh file", "")
        return null
    }

    name = field_string(entry, "name")
    if name != "" { core.model_set_name(m, name) }

    m.position = vec3_of(json.object_get_raw(entry, "position"))
    m.scale = vec3_of(json.object_get_raw(entry, "scale"))
    m.rotation = quat_of(json.object_get_raw(entry, "rotation"))

    visible = json.object_get_raw(entry, "visible")
    m.visible = true
    if visible != null { m.visible = json.get_bool(visible) == 1 }

    casts = json.object_get_raw(entry, "casts_shadow")
    m.casts_shadow = true
    if casts != null { m.casts_shadow = json.get_bool(casts) == 1 }

    load_uniforms(m, json.object_get_raw(entry, "uniforms"))
    shader_kind = json.object_get_raw(entry, "shader")
    if shader_kind != null {
        core.model_set_shader(m, shader_for(json.get_int(shader_kind)))
    }

    apply_material(m, json.object_get_raw(entry, "material"))

    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

scene_free(models: ptr) {
    if models == null { return }
    count = list.size(models)
    i = 0
    while i < count {
        m = list.get_raw(models, i) as *Model
        if m != null { core.model_free(m) }
        i = i + 1
    }
    list.free(models)
}
