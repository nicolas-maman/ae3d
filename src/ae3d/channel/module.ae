// The agent channel's transport: a loopback socket, newline-delimited JSON
// both ways, and nothing at all in a frame when AE3D_AGENT is unset.
//
// ae3d.agent is what a request means; this is how it arrives and how the
// answer leaves. A thread of the channel's own waits on the socket --
// accepts a client, reads what it sends, cuts it into lines -- and hands
// each line to the frame through a ring: the thread writes a slot and then
// moves the tail, the frame takes slots up to the tail and moves the head,
// each index written by one side only. The engine drains the ring at one
// point in its frame (agent.pump), and an idle drain is two atomic loads:
// no lock, no syscall. Reading the socket from the frame instead cost a
// poll a frame -- 0.9 microseconds on Windows, 27 on macOS's CI runner.
//
// Answers are written from the frame, on the socket the thread reads, and
// the thread is what closes it when the client goes -- so a close must
// never land under a write. Two atomics settle it: the frame raises
// `writing` and then looks at `attached`; the thread lowers `attached` and
// then waits for `writing` to fall before it closes. Both are sequentially
// consistent, so either the frame sees the client gone and does not write,
// or the thread sees the write and waits it out. A second client while one
// is attached is told so and closed.
//
// Stopping asks the thread to finish and waits for it; every wait of the
// thread's is bounded (POLL_MS), so it notices within one. It was C once
// (native/agent/channel.c), for want of a std.tcp that could listen on
// loopback only, poll a listener and set TCP_NODELAY (aether#2136).
//
// Loopback only. The channel is a debugging surface with no authentication
// of any kind; ae3d.probe, the asking side, connects to 127.0.0.1 too.
//
// AE3D_AGENT_RECORD names a file the whole session is written to as it
// happens: every request as it is taken and every answer as it goes, a
// line each -- "in", or "out", the milliseconds since the channel opened,
// and the line itself -- flushed as it is written, so a session a program
// died in is on disk up to its last word. ae3d.replay reads it back and
// asks a running program the same questions (tools/agent_replay.ae), so a
// change that alters what the pipeline sees is found by replaying a
// session that went right.

import std.bytes
import std.fs
import std.mem
import std.os
import std.string
import std.tcp
import std.worker
import aephysics.native

exports (
    start, active, port, next_request, respond, stop, last_error
)

extern malloc(size: long) -> ptr
extern realloc(p: ptr, size: long) -> ptr
extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern memcpy(dst: ptr, src: ptr, n: long) -> ptr
extern fopen(path: string, mode: string) -> ptr
extern fputs(text: string, f: ptr) -> int
extern fflush(f: ptr) -> int
extern fclose(f: ptr) -> int

const CHUNK = 4096
const MOST = 4194304               // a request longer than this is a protocol fault, and the client goes
const SLOTS = 256                  // requests in flight between the thread and the frame
const POLL_MS = 100                // the longest the thread waits before looking at `stopping`

// What the thread and the frame share. The ints are atomics, touched only
// through native.atomic_*; each has one writer.
struct ChannelShared {
    head: int                      // written by the frame: the next slot it takes
    tail: int                      // written by the thread: one past the last slot it filled
    attached: int                  // written by the thread: a client is there to answer
    writing: int                   // written by the frame: an answer is going out
    stopping: int                  // written by the frame: finish now
}

var g_shared: ptr = null           // *ChannelShared
var g_slots: ptr = null            // ptr[SLOTS]: each a line, [length: 8 bytes][bytes]
var g_exited: ptr = null           // semaphore the thread signals on its way out
var g_server: ptr = null           // the listening socket, while the channel is open
var g_client: ptr = null           // the attached client; set by the thread before `attached`
var g_port = 0
var g_error = ""
var g_record: ptr = null           // the session's file (AE3D_AGENT_RECORD), or null
var g_opened_ns: long = 0          // when the channel opened, for the record's times

// The thread's own: bytes received past the last complete line.
var g_pending: ptr = null
var g_used = 0
var g_capacity = 0
var g_chunk: ptr = null            // a std.bytes buffer: a received chunk's bytes, a string's not being addressable

shared() -> *ChannelShared { return g_shared as *ChannelShared }

active() -> bool { return g_server != null }

port() -> int { return g_port }

last_error() -> string { return g_error }

// Opens the channel if AE3D_AGENT asks for it: a port number, or "auto"
// for one the system picks. False with no error when it is unset; false
// with the reason when it cannot open. The port is printed, and written
// to AE3D_AGENT_PORT_FILE when that is set, for a tool that started the
// program to find it.
start() -> bool {
    g_error = ""
    if g_server != null { return true }
    // Unset is null, not "": every program said AE3D_AGENT was not a port
    // number when it was not set at all.
    spec = os.getenv("AE3D_AGENT")
    if spec == null || spec == "" { return false }
    requested = 0
    if spec != "auto" {
        parsed, parse_error = string.to_int(spec)
        requested = parsed
        if parse_error != "" || requested <= 0 || requested > 65535 {
            g_error = "AE3D_AGENT must be a port number or \"auto\""
            return false
        }
    }
    server = tcp.tcp_listen_on_raw("127.0.0.1", requested)
    if server == null {
        g_error = "cannot listen on 127.0.0.1:${requested}"
        return false
    }
    g_shared = calloc(1, sizeof(ChannelShared))
    g_slots = calloc(SLOTS, 8)
    g_exited = native.semaphore_new(0)
    g_capacity = 8192
    g_pending = malloc(g_capacity as long)
    g_used = 0
    g_server = server
    g_port = tcp.tcp_server_port_raw(server)
    if !worker.run_detached(| _c: ptr | { serve() }) {
        g_error = "cannot start the channel's thread"
        tcp.tcp_server_close(server)
        g_server = null
        release()
        return false
    }
    println("ae3d: agent channel on 127.0.0.1:${g_port}")
    g_opened_ns = os.now_monotonic_ns()
    record_path = os.getenv("AE3D_AGENT_RECORD")
    if record_path != null && record_path != "" {
        g_record = fopen(record_path, "w")
        if g_record == null { println("ae3d: cannot write the session to ${record_path}") }
    }
    port_file = os.getenv("AE3D_AGENT_PORT_FILE")
    if port_file != null && port_file != "" { fs.write(port_file, "${g_port}\n") }
    return true
}

// The next request, or "" when none has arrived whole.
next_request() -> string {
    if g_server == null { return "" }
    s = shared()
    head = native.atomic_load((&s.head) as ptr)
    if head == native.atomic_load((&s.tail) as ptr) { return "" }
    slots = g_slots as ptr[]
    block = slots[head % SLOTS]
    slots[head % SLOTS] = null
    length = (block as int[])[0]
    line = bytes.string_from_ptr(block + 8, length)
    free(block)
    native.atomic_store((&s.head) as ptr, head + 1)
    record("in", line)
    return line
}

// A line of the session, when one is being recorded: which way it went,
// when, and what it said.
record(way: string, line: string) {
    if g_record == null { return }
    elapsed = (os.now_monotonic_ns() - g_opened_ns) / 1000000
    fputs("${way} ${elapsed} ", g_record)
    fputs(line, g_record)
    fputs("\n", g_record)
    fflush(g_record)
}

// One answer, and its terminator in the same write: a terminator sent on
// its own would wait on the acknowledgement of the line before it.
respond(line: string) {
    if g_server == null { return }
    record("out", line)
    s = shared()
    native.atomic_store((&s.writing) as ptr, 1)
    if native.atomic_load((&s.attached) as ptr) == 0 {
        native.atomic_store((&s.writing) as ptr, 0)
        return
    }
    whole = string.concat(line, "\n")
    total = string.length(whole)
    sent, err = tcp.write_n(g_client, whole, total)
    // A short write is the kernel's buffer full: the rest, until it is all
    // gone or the client is.
    offset = sent
    while err == "" && offset < total && sent > 0 {
        rest = string.substring(whole, offset, total)
        sent, err = tcp.write_n(g_client, rest, total - offset)
        offset = offset + sent
        string.free(rest)
    }
    string.free(whole)
    native.atomic_store((&s.writing) as ptr, 0)
}

stop() {
    if g_server == null { return }
    s = shared()
    native.atomic_store((&s.stopping) as ptr, 1)
    native.semaphore_wait(g_exited)
    tcp.tcp_server_close(g_server)
    g_server = null
    g_port = 0
    if g_record != null { fclose(g_record) }
    g_record = null
    release()
}

release() {
    if g_slots != null {
        slots = g_slots as ptr[]
        i = 0
        while i < SLOTS {
            if slots[i] != null { free(slots[i]) }
            i = i + 1
        }
        free(g_slots)
    }
    g_slots = null
    if g_shared != null { free(g_shared) }
    g_shared = null
    if g_exited != null { native.semaphore_free(g_exited) }
    g_exited = null
    if g_pending != null { free(g_pending) }
    g_pending = null
    g_used = 0
    g_capacity = 0
    if g_chunk != null { bytes.free(g_chunk) }
    g_chunk = null
}

// --- the thread ------------------------------------------------------------------------------------------------------

stopping() -> bool { return native.atomic_load((&shared().stopping) as ptr) != 0 }

serve() {
    while !stopping() {
        if g_client == null {
            if tcp.tcp_server_poll_raw(g_server, POLL_MS) > 0 { attach() }
            continue
        }
        refuse_others()
        if tcp.tcp_poll_raw(g_client, POLL_MS) <= 0 { continue }
        // The client went, or broke the protocol. What it sent before is
        // still on the ring.
        if !take_lines() { detach() }
    }
    detach()
    native.semaphore_signal(g_exited, 1)
}

attach() {
    client = tcp.tcp_accept_raw(g_server)
    if client == null { return }
    tcp.tcp_set_nodelay_raw(client, 1)
    g_client = client
    g_used = 0
    native.atomic_store((&shared().attached) as ptr, 1)
}

// No more answers to this client; once one already going out is done, the
// socket closes.
detach() {
    if g_client == null { return }
    s = shared()
    native.atomic_store((&s.attached) as ptr, 0)
    while native.atomic_load((&s.writing) as ptr) != 0 { native.yield_thread() }
    tcp.tcp_close(g_client)
    g_client = null
}

// A client that connected while one is attached is told so and closed.
refuse_others() {
    while tcp.tcp_server_poll_raw(g_server, 0) > 0 {
        client = tcp.tcp_accept_raw(g_server)
        if client == null { return }
        refusal = "{\"ok\":false,\"error\":\"another client is attached\"}\n"
        tcp.write_n(client, refusal, string.length(refusal))
        tcp.tcp_close(client)
    }
}

// One read's worth into the pending bytes, and every complete line in them
// onto the ring. False when the client has closed or sent a line too long.
take_lines() -> bool {
    if g_used + CHUNK > g_capacity {
        wanted = g_capacity * 2
        while wanted < g_used + CHUNK { wanted = wanted * 2 }
        if wanted > MOST { return false }
        g_pending = realloc(g_pending, wanted as long)
        g_capacity = wanted
    }
    chunk, got, err = tcp.read_n(g_client, CHUNK)
    if err == "timeout" { return true }
    if err != "" || got <= 0 { return false }
    if g_chunk == null { g_chunk = bytes.new(CHUNK) }
    bytes.copy_from_string(g_chunk, 0, chunk, got)
    memcpy(g_pending + g_used, bytes.data(g_chunk), got as long)
    g_used = g_used + got
    while true {
        length = line_length()
        if length < 0 { return true }
        if length > 0 { hand_over(length) }
        consume_line(length)
    }
    return true
}

// The first pending line into a block of its own, onto the ring. A full
// ring -- a client far ahead of the frame -- waits for the frame.
hand_over(length: int) {
    s = shared()
    tail = native.atomic_load((&s.tail) as ptr)
    while tail - native.atomic_load((&s.head) as ptr) >= SLOTS {
        if stopping() { return }
        native.yield_thread()
    }
    block = malloc((8 + length) as long)
    (block as int[])[0] = length
    memcpy(block + 8, g_pending, length as long)
    (g_slots as ptr[])[tail % SLOTS] = block
    native.atomic_store((&s.tail) as ptr, tail + 1)
}

// The length of the first complete line in the pending bytes, a carriage
// return before its terminator excluded; -1 when there is none.
line_length() -> int {
    i = 0
    while i < g_used {
        if mem.get_uint8(g_pending, i) == 10 {
            length = i
            if length > 0 && mem.get_uint8(g_pending, length - 1) == 13 { length = length - 1 }
            return length
        }
        i = i + 1
    }
    return 0 - 1
}

// The first line and its terminator off the front of the pending bytes.
consume_line(length: int) {
    end = length
    while end < g_used && mem.get_uint8(g_pending, end) != 10 { end = end + 1 }
    if end < g_used { end = end + 1 }
    mem.copy(g_pending, g_pending + end, (g_used - end) as long)
    g_used = g_used - end
}
