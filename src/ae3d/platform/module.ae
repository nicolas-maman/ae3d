// Window, input and timing. Thin binding over the GLFW layer in native/.

exports (
    API_GL, API_VULKAN,
    CURSOR_NORMAL, CURSOR_HIDDEN, CURSOR_DISABLED,
    KEY_SPACE, KEY_0, KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9,
    KEY_A, KEY_B, KEY_C, KEY_D, KEY_E, KEY_F, KEY_G, KEY_H, KEY_I, KEY_J, KEY_K,
    KEY_L, KEY_M, KEY_N, KEY_O, KEY_P, KEY_Q, KEY_R, KEY_S, KEY_T, KEY_U, KEY_V,
    KEY_W, KEY_X, KEY_Y, KEY_Z,
    KEY_ESCAPE, KEY_ENTER, KEY_TAB, KEY_RIGHT, KEY_LEFT, KEY_DOWN, KEY_UP,
    KEY_F1, KEY_F2, KEY_F3, KEY_F4, KEY_F5, KEY_LEFT_SHIFT, KEY_LEFT_CONTROL,
    KEY_LEFT_ALT, KEY_RIGHT_SHIFT, KEY_RIGHT_CONTROL,
    MOUSE_LEFT, MOUSE_RIGHT, MOUSE_MIDDLE,
    init, shutdown, error,
    window_create, window_destroy, window_should_close, window_close,
    window_swap, window_make_current, window_set_vsync,
    window_width, window_height, window_fb_width, window_fb_height,
    window_set_pos, window_center, window_set_title, window_set_cursor_mode,
    monitor_width, monitor_height, poll_events, time,
    key_down, mouse_down, cursor_x, cursor_y, scroll_delta
)

extern ae3d_platform_init() -> int
extern ae3d_platform_shutdown()
extern ae3d_platform_error() -> string
extern ae3d_window_create(width: int, height: int, title: string,
                          api: int, msaa: int, decorated: int, depth_bits: int) -> ptr
extern ae3d_window_destroy(win: ptr)
extern ae3d_window_should_close(win: ptr) -> int
extern ae3d_window_close(win: ptr)
extern ae3d_window_swap(win: ptr)
extern ae3d_window_make_current(win: ptr)
extern ae3d_window_set_vsync(interval: int)
extern ae3d_window_width(win: ptr) -> int
extern ae3d_window_height(win: ptr) -> int
extern ae3d_window_fb_width(win: ptr) -> int
extern ae3d_window_fb_height(win: ptr) -> int
extern ae3d_window_set_pos(win: ptr, x: int, y: int)
extern ae3d_window_center(win: ptr)
extern ae3d_window_set_title(win: ptr, title: string)
extern ae3d_window_set_cursor_mode(win: ptr, mode: int)
extern ae3d_monitor_width() -> int
extern ae3d_monitor_height() -> int
extern ae3d_poll_events()
extern ae3d_time() -> float
extern ae3d_key_down(win: ptr, key: int) -> int
extern ae3d_mouse_down(win: ptr, button: int) -> int
extern ae3d_cursor_x(win: ptr) -> float
extern ae3d_cursor_y(win: ptr) -> float
extern ae3d_scroll_delta(win: ptr) -> float

const API_GL = 0
const API_VULKAN = 1

const CURSOR_NORMAL = 0
const CURSOR_HIDDEN = 1
const CURSOR_DISABLED = 2

const KEY_SPACE = 32
const KEY_0 = 48
const KEY_1 = 49
const KEY_2 = 50
const KEY_3 = 51
const KEY_4 = 52
const KEY_5 = 53
const KEY_6 = 54
const KEY_7 = 55
const KEY_8 = 56
const KEY_9 = 57
const KEY_A = 65
const KEY_B = 66
const KEY_C = 67
const KEY_D = 68
const KEY_E = 69
const KEY_F = 70
const KEY_G = 71
const KEY_H = 72
const KEY_I = 73
const KEY_J = 74
const KEY_K = 75
const KEY_L = 76
const KEY_M = 77
const KEY_N = 78
const KEY_O = 79
const KEY_P = 80
const KEY_Q = 81
const KEY_R = 82
const KEY_S = 83
const KEY_T = 84
const KEY_U = 85
const KEY_V = 86
const KEY_W = 87
const KEY_X = 88
const KEY_Y = 89
const KEY_Z = 90
const KEY_ESCAPE = 256
const KEY_ENTER = 257
const KEY_TAB = 258
const KEY_RIGHT = 262
const KEY_LEFT = 263
const KEY_DOWN = 264
const KEY_UP = 265
const KEY_F1 = 290
const KEY_F2 = 291
const KEY_F3 = 292
const KEY_F4 = 293
const KEY_F5 = 294
const KEY_LEFT_SHIFT = 340
const KEY_LEFT_CONTROL = 341
const KEY_LEFT_ALT = 342
const KEY_RIGHT_SHIFT = 344
const KEY_RIGHT_CONTROL = 345

const MOUSE_LEFT = 0
const MOUSE_RIGHT = 1
const MOUSE_MIDDLE = 2

init() -> bool {
    return ae3d_platform_init() == 1
}

shutdown() {
    ae3d_platform_shutdown()
}

error() -> string {
    return ae3d_platform_error()
}

window_create(width: int, height: int, title: string,
              api: int, msaa: int, decorated: bool, depth_bits: int) -> ptr {
    flag = 0
    if decorated { flag = 1 }
    return ae3d_window_create(width, height, title, api, msaa, flag, depth_bits)
}

window_destroy(win: ptr) {
    ae3d_window_destroy(win)
}

window_should_close(win: ptr) -> bool {
    return ae3d_window_should_close(win) == 1
}

window_close(win: ptr) {
    ae3d_window_close(win)
}

window_swap(win: ptr) {
    ae3d_window_swap(win)
}

window_make_current(win: ptr) {
    ae3d_window_make_current(win)
}

window_set_vsync(interval: int) {
    ae3d_window_set_vsync(interval)
}

window_width(win: ptr) -> int {
    return ae3d_window_width(win)
}

window_height(win: ptr) -> int {
    return ae3d_window_height(win)
}

window_fb_width(win: ptr) -> int {
    return ae3d_window_fb_width(win)
}

window_fb_height(win: ptr) -> int {
    return ae3d_window_fb_height(win)
}

window_set_pos(win: ptr, x: int, y: int) {
    ae3d_window_set_pos(win, x, y)
}

window_center(win: ptr) {
    ae3d_window_center(win)
}

window_set_title(win: ptr, title: string) {
    ae3d_window_set_title(win, title)
}

window_set_cursor_mode(win: ptr, mode: int) {
    ae3d_window_set_cursor_mode(win, mode)
}

monitor_width() -> int {
    return ae3d_monitor_width()
}

monitor_height() -> int {
    return ae3d_monitor_height()
}

poll_events() {
    ae3d_poll_events()
}

time() -> float {
    return ae3d_time()
}

key_down(win: ptr, key: int) -> bool {
    return ae3d_key_down(win, key) == 1
}

mouse_down(win: ptr, button: int) -> bool {
    return ae3d_mouse_down(win, button) == 1
}

cursor_x(win: ptr) -> float {
    return ae3d_cursor_x(win)
}

cursor_y(win: ptr) -> float {
    return ae3d_cursor_y(win)
}

scroll_delta(win: ptr) -> float {
    return ae3d_scroll_delta(win)
}
