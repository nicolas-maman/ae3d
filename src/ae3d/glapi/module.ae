// ae3d.glapi -- the OpenGL entry points ae3d calls, from Aether (#398).
//
// Each is resolved the first time it is called, through the resolver the
// C side has always used (native/gpu/opengl_api.c: the process first, then
// the window system's), and called through the pointer from then on. The
// list is the one native/gpu/opengl_api.h names for the C that still draws
// with GL; as the renderer's C moves here, this is what it calls, and when
// the last of it has moved the C list goes and this is the only one.
//
// Types as the header has them: GLenum, GLuint and GLbitfield are uint32,
// GLint and GLsizei int, GLboolean an int (0 or 1), GLfloat f32, GLdouble a
// float, GLsizeiptr and GLintptr long, and every pointer a ptr. A command
// the context does not have is null and crashes when called: ae3d_gl_load
// has already refused a context missing any of them.

extern ae3d_gl_proc(name: string) -> ptr
// The bytes of a string, as C takes them. A call through a function pointer
// hands a string over as it is -- a heap string is a header in front of its
// bytes -- where an extern call passes the bytes: this is the conversion the
// compiler makes at an extern, done by hand (a plain C string passes
// through unchanged).
extern aether_string_data(s: string) -> ptr @c_import

cstr(s: string) -> ptr { return (aether_string_data(s)) as ptr }

// Whether the context has a command at all (the timer queries are 3.3's).
has(name: string) -> bool { return ae3d_gl_proc(name) != null }

exports (
    cstr,
    has,
    FALSE,
    TRUE,
    NO_ERROR,
    POINTS,
    LINES,
    TRIANGLES,
    DEPTH_BUFFER_BIT,
    STENCIL_BUFFER_BIT,
    COLOR_BUFFER_BIT,
