var p_glGetString: ptr = null
glGetString(name: uint32) -> ptr {
    if p_glGetString == null { p_glGetString = ae3d_gl_proc("glGetString") }
    f = p_glGetString as fn(uint32) -> ptr
    return f(name)
}

