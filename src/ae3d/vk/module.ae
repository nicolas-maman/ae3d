extern ae3d_vk_live_shadow_targets() -> int
// The size ae3d_vk.c builds the shadow image at.
const SHADOW_SIZE = 2048

extern ae3d_vk_shadow_begin() -> int
extern ae3d_vk_shadow_draw(mesh: int, instances: int, instance_count: int)
extern ae3d_vk_shadow_end()
extern ae3d_vk_set_post(fxaa: int, bloom: int, threshold: float, intensity: float)
extern ae3d_vk_post_active() -> int
extern ae3d_vk_draw_calls() -> int
extern ae3d_vk_mesh_shared(handle: int) -> int
extern ae3d_vk_pass_ms(pass: int) -> float
extern ae3d_vk_pipeline_binds() -> int
extern ae3d_vk_set_binds() -> int
extern ae3d_vk_sample_count() -> int
extern ae3d_vk_offscreen_pixels() -> ptr
extern ae3d_vk_request_capture() -> int
extern ae3d_vk_capture_ready() -> int
extern ae3d_vk_capture_pixels() -> ptr
extern ae3d_vk_capture_width() -> int
extern ae3d_vk_capture_height() -> int
