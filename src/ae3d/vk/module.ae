// Vulkan backend.
//
// Feature for feature with the OpenGL backend, and running the same lighting
// model: the Vulkan shaders are generated from the OpenGL ones, so there is one
// source for the PBR pass rather than two that drift.
//
// The loader is opened at runtime, so a program built with this backend still
// starts where no driver exists: available() reports false and says why.

import std.list
import std.heap
import std.string
import ae3d.core
import ae3d.vkscene

exports (
    VKRenderer,
    renderer_new, renderer_free, backend,
    available, device_name, last_error,
    renderer_model_count, renderer_draw_calls, renderer_set_clear_color,
    renderer_load_texture, renderer_release_texture, renderer_sample_count, renderer_set_post,
    renderer_set_shadows, renderer_shadows, renderer_add_light, renderer_remove_light,
    skybox_create, skybox_free,
    offscreen_pixels, offscreen_width, offscreen_height
)

extern ae3d_vk_available() -> int
extern ae3d_vk_device_name() -> string
extern ae3d_vk_last_error() -> string
extern ae3d_vk_init(win: ptr, width: int, height: int) -> int
extern ae3d_vk_shutdown()
extern ae3d_vk_resize(width: int, height: int)
extern ae3d_vk_frame_begin(r: float, g: float, b: float, a: float) -> int
extern ae3d_vk_frame_end() -> int
extern ae3d_vk_upload_mesh(mesh: ptr) -> int
extern ae3d_vk_upload_instances(instances: ptr) -> int
extern ae3d_vk_free_mesh(handle: int)
extern ae3d_vk_texture_create(width: int, height: int, rgba: ptr) -> int
extern ae3d_vk_texture_destroy(handle: int)
extern ae3d_vk_scene_set_float(offset: int, value: float)
extern ae3d_vk_scene_set_int(offset: int, value: int)
extern ae3d_vk_scene_set_vec3(offset: int, x: float, y: float, z: float)
extern ae3d_vk_scene_set_mat4(offset: int, m: ptr)
extern ae3d_vk_scene_set_clip_mat4(offset: int, m: ptr)
extern ae3d_vk_set_blend(on: int)
extern ae3d_vk_draw(mesh: int, texture: int, instances: int, instance_count: int)
extern ae3d_vk_draw_sky(mesh: int, texture: int)
extern ae3d_vk_set_screen_quad(mesh: int)
extern ae3d_vk_set_shadows(on: int)
extern ae3d_vk_shadows() -> int
extern ae3d_vk_shadow_begin() -> int
extern ae3d_vk_shadow_draw(mesh: int, instances: int, instance_count: int)
extern ae3d_vk_shadow_end()
extern ae3d_vk_set_post(fxaa: int, bloom: int, threshold: float, intensity: float)
extern ae3d_vk_post_active() -> int
extern ae3d_vk_draw_calls() -> int
extern ae3d_vk_sample_count() -> int
extern ae3d_vk_offscreen_pixels() -> ptr
extern ae3d_vk_scene_offset(name: string) -> int
extern ae3d_vk_scene_set_float_array(offset: int, handle: ptr)
extern ae3d_vk_scene_set_vec3_array(offset: int, handle: ptr)
extern ae3d_vk_set_program(program: int)
extern ae3d_vk_program_count() -> int
extern ae3d_vk_offscreen_width() -> int
extern ae3d_vk_offscreen_height() -> int
extern ae3d_image_load(path: string) -> ptr
extern ae3d_image_free(img: ptr)
extern ae3d_image_width(img: ptr) -> int
extern ae3d_image_height(img: ptr) -> int
extern ae3d_image_pixels(img: ptr) -> ptr
extern ae3d_image_error() -> string

// Named apart from the OpenGL backend's equivalent: struct names are global
// across every imported module, so two backends cannot both call it the same
// thing.
struct VulkanTexture {
    path: string
    handle: int
    refs: int
}

struct VKRenderer {
    models: ptr
    lights: ptr
    textures: ptr
    frustum: ptr
    skybox: ptr
    shadow_space: Mat4
    screen_mesh: ptr
    screen_handle: int
    initialized: bool
    last_draw_calls: int
    clear_r: float
    clear_g: float
    clear_b: float
}

available() -> bool {
    return ae3d_vk_available() == 1
}

device_name() -> string {
    return ae3d_vk_device_name()
}

last_error() -> string {
    return ae3d_vk_last_error()
}

renderer_sample_count() -> int {
    return ae3d_vk_sample_count()
}

// Valid after a frame has been rendered offscreen; the buffer belongs to the
// renderer and the next frame overwrites it.
offscreen_pixels() -> ptr {
    return ae3d_vk_offscreen_pixels()
}

offscreen_width() -> int {
    return ae3d_vk_offscreen_width()
}

offscreen_height() -> int {
    return ae3d_vk_offscreen_height()
}

renderer_new() -> *VKRenderer {
    r = heap.new(VKRenderer)
    r.models = list.new()
    r.lights = list.new()
    r.textures = list.new()
    r.frustum = core.frustum_new()
    r.shadow_space = core.mat4_ident()
    return r
}

renderer_free(r: *VKRenderer) {
    if r == null { return }
    if r.initialized { renderer_cleanup(r) }
    if r.models != null { list.free(r.models) }
    if r.lights != null { list.free(r.lights) }
    if r.textures != null {
        count = list.size(r.textures)
        i = 0
        while i < count {
            entry = list.get_raw(r.textures, i) as *VulkanTexture
            if entry != null {
            heap.free(entry)
            }
            i = i + 1
        }
        list.free(r.textures)
    }
    if r.frustum != null { core.frustum_free(r.frustum) }
    heap.free(r)
}

backend(r: *VKRenderer) -> Backend {
    return Backend {
        state: r,
        name: "vulkan",
        init: renderer_init as fn(ptr, ptr, int, int) -> int,
        render: renderer_render as fn(ptr, ptr, ptr),
        add_model: renderer_add_model as fn(ptr, ptr),
        remove_model: renderer_remove_model as fn(ptr, ptr),
        load_texture: renderer_load_texture as fn(ptr, string) -> int,
        set_skybox: renderer_set_skybox as fn(ptr, ptr),
        update_viewport: renderer_update_viewport as fn(ptr, int, int),
        set_post: renderer_set_post as fn(ptr, int, int, float, float),
        set_clear_color: renderer_set_clear_color as fn(ptr, float, float, float),
        set_shadows: vtable_set_shadows as fn(ptr, int),
        add_light: renderer_add_light as fn(ptr, ptr),
        remove_light: renderer_remove_light as fn(ptr, ptr),
        draw_calls: renderer_draw_calls as fn(ptr) -> int,
        frame_pixels: vtable_frame_pixels as fn(ptr) -> ptr,
        cleanup: renderer_cleanup as fn(ptr)
    }
}

renderer_init(r: *VKRenderer, window: ptr, width: int, height: int) -> int {
    if ae3d_vk_available() != 1 {
        println("ae3d: no Vulkan driver (${ae3d_vk_last_error()})")
        return 0
    }
    if ae3d_vk_init(window, width, height) != 1 {
        println("ae3d: Vulkan init failed (${ae3d_vk_last_error()})")
        return 0
    }
    println("ae3d: Vulkan on ${ae3d_vk_device_name()}, ${ae3d_vk_sample_count()}x MSAA")
    r.initialized = true

    r.screen_mesh = core.mesh_create()
    core.mesh_push_screen_quad(r.screen_mesh)
    r.screen_handle = ae3d_vk_upload_mesh(r.screen_mesh)
    ae3d_vk_set_screen_quad(r.screen_handle)
    return 1
}

renderer_add_light(r: *VKRenderer, light: *Light) {
    list.add_raw(r.lights, light)
}

renderer_remove_light(r: *VKRenderer, light: *Light) {
    count = list.size(r.lights)
    i = 0
    while i < count {
        if list.get_raw(r.lights, i) == light {
            list.remove(r.lights, i)
            return
        }
        i = i + 1
    }
}

vtable_set_shadows(r: *VKRenderer, on: int) {
    renderer_set_shadows(r, on == 1)
}

vtable_frame_pixels(r: *VKRenderer) -> ptr {
    return ae3d_vk_offscreen_pixels()
}

renderer_set_shadows(r: *VKRenderer, on: bool) {
    flag = 0
    if on { flag = 1 }
    ae3d_vk_set_shadows(flag)
}

renderer_shadows(r: *VKRenderer) -> bool {
    return ae3d_vk_shadows() == 1
}

// The same box the OpenGL backend builds, from the same scene, so the two
// backends light and shadow a scene identically.
light_space_matrix(r: *VKRenderer, light: *Light) -> Mat4 {
    centre = core.vec3(0.0, 0.0, 0.0)
    radius = 1.0
    shown = 0

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible {
            centre = core.v3_add(centre, m.bounding_center)
            shown = shown + 1
        }
        i = i + 1
    }
    if shown > 0 { centre = core.v3_mul(centre, 1.0 / (shown * 1.0)) }

    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible {
            span = core.v3_len(core.v3_sub(m.bounding_center, centre)) + m.bounding_radius
            if span > radius { radius = span }
        }
        i = i + 1
    }

    direction = core.v3_normalize(light.direction)
    if light.mode != core.MODE_DIRECTIONAL {
        direction = core.v3_normalize(core.v3_sub(centre, light.position))
    }
    if core.v3_len(direction) < 0.001 { direction = core.vec3(0.0, 0.0 - 1.0, 0.0) }

    eye = core.v3_sub(centre, core.v3_mul(direction, radius * 2.0))
    up = core.vec3(0.0, 1.0, 0.0)
    if core.abs_of(direction.y) > 0.99 { up = core.vec3(0.0, 0.0, 1.0) }

    view = core.mat4_look_at(eye, centre, up)
    projection = core.mat4_ortho(0.0 - radius, radius, 0.0 - radius, radius,
                                 0.01, radius * 4.0)
    return core.mat4_mul(projection, view)
}

render_shadow_pass(r: *VKRenderer, light: *Light) {
    if light == null || ae3d_vk_shadows() != 1 { return }

    r.shadow_space = light_space_matrix(r, light)
    ae3d_vk_scene_set_clip_mat4(vkscene.OFF_LIGHTSPACEMATRIX, &r.shadow_space)
    if ae3d_vk_shadow_begin() != 1 { return }

    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null && m.visible && m.casts_shadow && m.vbo != 0 {
            if m.is_dirty {
                core.model_update_matrix(m)
                m.is_dirty = false
            }
            instances = 0
            if m.is_instanced { instances = core.model_instance_count(m) }
            ae3d_vk_scene_set_mat4(vkscene.OFF_MODEL, &m.model_matrix)
            instanced = 0
            if instances > 0 { instanced = 1 }
            ae3d_vk_scene_set_int(vkscene.OFF_ISINSTANCED, instanced)
            ae3d_vk_shadow_draw(m.vbo, m.instance_vbo, instances)
        }
        i = i + 1
    }
    ae3d_vk_shadow_end()
}

renderer_set_post(r: *VKRenderer, fxaa: int, bloom: int, threshold: float, intensity: float) {
    ae3d_vk_set_post(fxaa, bloom, threshold, intensity)
}

renderer_set_skybox(r: *VKRenderer, skybox: ptr) {
    r.skybox = skybox
    sky = skybox as *Skybox
    if sky != null && sky.texture == 0 {
        renderer_set_clear_color(r, sky.red, sky.green, sky.blue)
    }
}

skybox_create(r: *VKRenderer, path: string) -> *Skybox {
    if path == "" { return core.skybox_solid(0.5, 0.7, 1.0) }

    texture = renderer_load_texture(r, path)
    if texture == 0 {
        println("ae3d: skybox texture unavailable, falling back to a solid sky")
        return core.skybox_solid(0.5, 0.7, 1.0)
    }

    sky = core.skybox_solid(0.5, 0.7, 1.0)
    sky.texture = texture
    sky.mesh = core.mesh_create()
    core.mesh_push_skybox_cube(sky.mesh, sky.size)
    sky.vbo = ae3d_vk_upload_mesh(sky.mesh)
    return sky
}

skybox_free(r: *VKRenderer, sky: *Skybox) {
    if sky == null { return }
    if sky.vbo != 0 { ae3d_vk_free_mesh(sky.vbo) }
    if sky.texture != 0 { renderer_release_texture(r, sky.texture) }
    if sky.mesh != null { core.mesh_destroy(sky.mesh) }
    heap.free(sky)
}

// The sky sits behind everything, so the camera's translation is stripped from
// the view matrix and the shader pushes it to the far plane.
draw_skybox(r: *VKRenderer, cam: *Camera) {
    sky = r.skybox as *Skybox
    if sky == null || sky.texture == 0 || sky.vbo == 0 { return }

    view = core.camera_view(cam)
    view.m12 = 0.0
    view.m13 = 0.0
    view.m14 = 0.0
    projection = core.camera_projection(cam)

    ae3d_vk_scene_set_mat4(vkscene.OFF_VIEW, &view)
    ae3d_vk_scene_set_clip_mat4(vkscene.OFF_PROJECTION, &projection)
    ae3d_vk_draw_sky(sky.vbo, sky.texture)
}

renderer_load_texture(r: *VKRenderer, path: string) -> int {
    if path == "" { return 0 }

    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *VulkanTexture
        if entry != null && string.equals(entry.path, path) == 1 {
            entry.refs = entry.refs + 1
            return entry.handle
        }
        i = i + 1
    }

    image = ae3d_image_load(path)
    if image == null {
        println("ae3d: texture load failed: ${ae3d_image_error()}")
        return 0
    }
    handle = ae3d_vk_texture_create(ae3d_image_width(image), ae3d_image_height(image),
                                    ae3d_image_pixels(image))
    ae3d_image_free(image)
    if handle == 0 { return 0 }

    entry = heap.new(VulkanTexture)
    texture_entry_set_path(entry, path)
    entry.handle = handle
    entry.refs = 1
    list.add_raw(r.textures, entry)
    return handle
}

texture_entry_set_path(entry: *VulkanTexture, path: string) {
    entry.path = core.set_owned(entry.path, path)
}

renderer_release_texture(r: *VKRenderer, handle: int) {
    if handle == 0 { return }
    count = list.size(r.textures)
    i = 0
    while i < count {
        entry = list.get_raw(r.textures, i) as *VulkanTexture
        if entry != null && entry.handle == handle {
            entry.refs = entry.refs - 1
            if entry.refs <= 0 {
                ae3d_vk_texture_destroy(entry.handle)
                list.remove(r.textures, i)
            heap.free(entry)
            }
            return
        }
        i = i + 1
    }
}

renderer_add_model(r: *VKRenderer, m: *Model) {
    if m == null || !r.initialized { return }

    handle = ae3d_vk_upload_mesh(m.mesh)
    if handle == 0 {
        println("ae3d: Vulkan mesh upload failed (${ae3d_vk_last_error()})")
        return
    }
    m.vbo = handle

    if m.is_instanced && core.model_instance_count(m) > 0 {
        m.instance_vbo = ae3d_vk_upload_instances(m.instances)
    }

    resolve_textures(r, m)
    list.add_raw(r.models, m)
}

resolve_textures(r: *VKRenderer, m: *Model) {
    groups = core.model_group_count(m)
    if groups > 0 {
        i = 0
        while i < groups {
            group = core.model_group(m, i)
            if group != null && group.material != null { resolve_one(r, group.material) }
            i = i + 1
        }
        return
    }
    if m.material != null { resolve_one(r, m.material) }
}

resolve_one(r: *VKRenderer, material: *Material) {
    if core.text(material.texture_path) == "" || material.texture_id != 0 { return }
    material.texture_id = renderer_load_texture(r, material.texture_path)
}

renderer_remove_model(r: *VKRenderer, m: *Model) {
    if m == null { return }
    if m.vbo != 0 { ae3d_vk_free_mesh(m.vbo) ; m.vbo = 0 }
    if m.instance_vbo != 0 { ae3d_vk_free_mesh(m.instance_vbo) ; m.instance_vbo = 0 }

    count = list.size(r.models)
    i = 0
    while i < count {
        if list.get_raw(r.models, i) == m {
            list.remove(r.models, i)
            return
        }
        i = i + 1
    }
}

// The same uniforms the OpenGL renderer sets, written into the block the
// generated shader reads.
// The staging block keeps its contents between draws, so anything the whole
// frame shares is written once here rather than once per model.
// Every program keeps its own copy of the block, so what the whole frame shares
// is written into each of them.
set_frame_uniforms(r: *VKRenderer, light: *Light, cam: *Camera) {
    programs = ae3d_vk_program_count()
    i = 0
    while i < programs {
        ae3d_vk_set_program(i)
        write_frame_uniforms(r, light, cam)
        i = i + 1
    }
    ae3d_vk_set_program(core.SHADER_CUSTOM)
}

write_frame_uniforms(r: *VKRenderer, light: *Light, cam: *Camera) {
    ae3d_vk_scene_set_vec3(vkscene.OFF_VIEWPOS, cam.position.x, cam.position.y, cam.position.z)
    upload_lights(r, light)
    ae3d_vk_scene_set_clip_mat4(vkscene.OFF_LIGHTSPACEMATRIX, &r.shadow_space)

    // The water program predates the light array and reads one light from flat
    // names, the same four the OpenGL backend fills for it.
    first = light
    if list.size(r.lights) > 0 { first = list.get_raw(r.lights, 0) as *Light }
    if first != null {
        ae3d_vk_scene_set_vec3(vkscene.OFF_LIGHTPOS, first.position.x, first.position.y,
                               first.position.z)
        ae3d_vk_scene_set_vec3(vkscene.OFF_LIGHTCOLOR, first.color.x, first.color.y,
                               first.color.z)
        ae3d_vk_scene_set_float(vkscene.OFF_LIGHTINTENSITY, first.intensity)
        ae3d_vk_scene_set_vec3(vkscene.OFF_LIGHTDIRECTION, first.direction.x,
                               first.direction.y, first.direction.z)
    }
}

set_scene_uniforms(r: *VKRenderer, m: *Model) {
    ae3d_vk_scene_set_mat4(vkscene.OFF_MODEL, &m.model_matrix)

    instanced = 0
    if m.is_instanced && core.model_instance_count(m) > 0 { instanced = 1 }
    ae3d_vk_scene_set_int(vkscene.OFF_ISINSTANCED, instanced)

    set_model_uniforms(m)
}

// The same array the OpenGL backend fills, at the offsets the generator derived
// from the one shader source, so the two cannot disagree about the layout.
upload_lights(r: *VKRenderer, key: *Light) {
    count = list.size(r.lights)
    if count > vkscene.MAX_LIGHTS { count = vkscene.MAX_LIGHTS }

    i = 0
    while i < count {
        upload_light(i, list.get_raw(r.lights, i) as *Light)
        i = i + 1
    }

    if count == 0 && key != null {
        upload_light(0, key)
        count = 1
    }
    ae3d_vk_scene_set_int(vkscene.OFF_LIGHTCOUNT, count)
}

upload_light(index: int, l: *Light) {
    if l == null { return }
    base = index * vkscene.LIGHT_STRIDE
    ae3d_vk_scene_set_vec3(base + vkscene.LIGHT_POSITION, l.position.x, l.position.y, l.position.z)
    ae3d_vk_scene_set_vec3(base + vkscene.LIGHT_COLOR, l.color.x, l.color.y, l.color.z)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_INTENSITY, l.intensity)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_AMBIENTSTRENGTH, l.ambient_strength)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_TEMPERATURE, l.temperature)

    directional = 0
    if l.mode == core.MODE_DIRECTIONAL { directional = 1 }
    ae3d_vk_scene_set_int(base + vkscene.LIGHT_ISDIRECTIONAL, directional)

    ae3d_vk_scene_set_vec3(base + vkscene.LIGHT_DIRECTION, l.direction.x, l.direction.y, l.direction.z)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_CONSTANTATTEN, l.constant_atten)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_LINEARATTEN, l.linear_atten)
    ae3d_vk_scene_set_float(base + vkscene.LIGHT_QUADRATICATTEN, l.quadratic_atten)
}

// A model's own uniforms, written straight into the block. The offset is
// resolved from the name once and kept on the uniform; a name the block has no
// member for stays at -1 and is skipped for the life of the model.
set_model_uniforms(m: *Model) {
    count = core.model_uniform_count(m)
    i = 0
    while i < count {
        uniform = core.model_uniform(m, i)
        if uniform != null {
            if uniform.block_offset == 0 - 2 {
                uniform.block_offset = ae3d_vk_scene_offset(uniform.name)
            }
            if uniform.block_offset >= 0 {
                if uniform.kind == core.UNIFORM_FLOAT {
                    ae3d_vk_scene_set_float(uniform.block_offset, uniform.number)
                } else if uniform.kind == core.UNIFORM_INT {
                    ae3d_vk_scene_set_int(uniform.block_offset, uniform.integer)
                } else if uniform.kind == core.UNIFORM_VEC3 {
                    ae3d_vk_scene_set_vec3(uniform.block_offset, uniform.vector.x,
                                           uniform.vector.y, uniform.vector.z)
                } else if uniform.kind == core.UNIFORM_FLOAT_ARRAY {
                    ae3d_vk_scene_set_float_array(uniform.block_offset, uniform.array)
                } else if uniform.kind == core.UNIFORM_VEC3_ARRAY {
                    ae3d_vk_scene_set_vec3_array(uniform.block_offset, uniform.array)
                }
            }
        }
        i = i + 1
    }
}

set_material_uniforms(material: *Material) {
    if material == null {
        ae3d_vk_scene_set_vec3(vkscene.OFF_DIFFUSECOLOR, 1.0, 1.0, 1.0)
        ae3d_vk_scene_set_vec3(vkscene.OFF_SPECULARCOLOR, 1.0, 1.0, 1.0)
        ae3d_vk_scene_set_float(vkscene.OFF_SHININESS, 32.0)
        ae3d_vk_scene_set_float(vkscene.OFF_METALLIC, 0.0)
        ae3d_vk_scene_set_float(vkscene.OFF_ROUGHNESS, 0.5)
        ae3d_vk_scene_set_float(vkscene.OFF_EXPOSURE, 1.0)
        ae3d_vk_scene_set_float(vkscene.OFF_MATERIALALPHA, 1.0)
        return
    }
    ae3d_vk_scene_set_vec3(vkscene.OFF_DIFFUSECOLOR, material.diffuse.x, material.diffuse.y, material.diffuse.z)
    ae3d_vk_scene_set_vec3(vkscene.OFF_SPECULARCOLOR, material.specular.x, material.specular.y, material.specular.z)
    ae3d_vk_scene_set_float(vkscene.OFF_SHININESS, material.shininess)
    ae3d_vk_scene_set_float(vkscene.OFF_METALLIC, material.metallic)
    ae3d_vk_scene_set_float(vkscene.OFF_ROUGHNESS, material.roughness)
    ae3d_vk_scene_set_float(vkscene.OFF_EXPOSURE, material.exposure)
    ae3d_vk_scene_set_float(vkscene.OFF_MATERIALALPHA, material.alpha)
}

renderer_render(r: *VKRenderer, cam: *Camera, light: *Light) {
    if !r.initialized { return }

    active_light = light
    if list.size(r.lights) > 0 { active_light = list.get_raw(r.lights, 0) as *Light }

    if ae3d_vk_frame_begin(r.clear_r, r.clear_g, r.clear_b, 1.0) != 1 { return }

    render_shadow_pass(r, active_light)
    set_frame_uniforms(r, active_light, cam)
    draw_skybox(r, cam)

    view_projection = core.camera_view_projection(cam)
    programs = ae3d_vk_program_count()
    i = 0
    while i < programs {
        ae3d_vk_set_program(i)
        ae3d_vk_scene_set_clip_mat4(vkscene.OFF_VIEWPROJECTION, &view_projection)
        i = i + 1
    }
    ae3d_vk_set_program(core.SHADER_CUSTOM)

    if core.frustum_culling() && core.frustum_dirty() {
        core.camera_fill_frustum(cam, r.frustum)
        core.clear_frustum_dirty()
    }

    count = list.size(r.models)
    pass = 0
    while pass < 2 {
        i = 0
        while i < count {
            m = list.get_raw(r.models, i) as *Model
            draw_model(r, m, pass == 1)
            i = i + 1
        }
        pass = pass + 1
    }

    r.last_draw_calls = ae3d_vk_draw_calls()
    ae3d_vk_frame_end()
}

draw_model(r: *VKRenderer, m: *Model, transparent_pass: bool) {
    if m == null || !m.visible || m.vbo == 0 { return }

    if core.frustum_culling() &&
       !core.frustum_sphere_visible(r.frustum, m.bounding_center, m.bounding_radius) {
        return
    }

    if m.is_dirty {
        core.model_update_matrix(m)
        m.is_dirty = false
    }

    instances = 0
    if m.is_instanced { instances = core.model_instance_count(m) }

    alpha = 1.0
    if m.material != null { alpha = m.material.alpha }
    is_transparent = alpha < 0.99
    if is_transparent != transparent_pass { return }

    program = core.SHADER_CUSTOM
    if core.shader_valid(&m.shader) { program = m.shader.kind }
    ae3d_vk_set_program(program)

    set_scene_uniforms(r, m)
    blend = 0
    if is_transparent { blend = 1 }
    ae3d_vk_set_blend(blend)

    groups = core.model_group_count(m)
    if groups > 0 {
        i = 0
        while i < groups {
            group = core.model_group(m, i)
            if group != null {
                set_material_uniforms(group.material)
                texture = 0
                if group.material != null { texture = group.material.texture_id }
                ae3d_vk_draw(m.vbo, texture, m.instance_vbo, instances)
            }
            i = i + 1
        }
        return
    }

    set_material_uniforms(m.material)
    texture = 0
    if m.material != null { texture = m.material.texture_id }
    ae3d_vk_draw(m.vbo, texture, m.instance_vbo, instances)
}

renderer_update_viewport(r: *VKRenderer, width: int, height: int) {
    if r.initialized { ae3d_vk_resize(width, height) }
}

renderer_cleanup(r: *VKRenderer) {
    if r == null || !r.initialized { return }
    if r.skybox != null { skybox_free(r, r.skybox as *Skybox) ; r.skybox = null }
    if r.screen_handle != 0 { ae3d_vk_free_mesh(r.screen_handle) ; r.screen_handle = 0 }
    if r.screen_mesh != null { core.mesh_destroy(r.screen_mesh) ; r.screen_mesh = null }
    count = list.size(r.models)
    i = 0
    while i < count {
        m = list.get_raw(r.models, i) as *Model
        if m != null {
            if m.vbo != 0 { ae3d_vk_free_mesh(m.vbo) ; m.vbo = 0 }
            if m.instance_vbo != 0 { ae3d_vk_free_mesh(m.instance_vbo) ; m.instance_vbo = 0 }
        }
        i = i + 1
    }
    list.clear(r.models)
    ae3d_vk_shutdown()
    r.initialized = false
}

renderer_model_count(r: *VKRenderer) -> int {
    return list.size(r.models)
}

renderer_draw_calls(r: *VKRenderer) -> int {
    return r.last_draw_calls
}

renderer_set_clear_color(r: *VKRenderer, red: float, green: float, blue: float) {
    r.clear_r = red
    r.clear_g = green
    r.clear_b = blue
}
