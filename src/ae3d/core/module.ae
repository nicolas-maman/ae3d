// ae3d core: linear algebra, scene types, camera and the backend vtable.
//
// Matrices are column-major and stored flat as m0..m15 with index = col * 4 + row,
// the layout OpenGL and Vulkan both consume without transposition. A Mat4 is
// therefore 16 contiguous doubles, so `&mat` is a valid `const double *` for the
// native uniform and instance-matrix entry points.
//
// Vertex data never crosses into Aether as float32. A model owns a native mesh
// handle (interleaved position/uv/normal, 8 floats per vertex) and, when
// instanced, a native instance handle holding the per-instance matrices. Aether
// drives them through `ae3d.mesh`; the GPU reads them without a conversion pass.
//
// Math, scene and camera types share one module: they reference each other by
// value and every backend needs all three, which is the same grouping gopher3D
// keeps them in.

import std.list
import std.heap
import std.os
import std.string
import ae3d.platform

exports (
    mesh_push_skybox_cube, skybox_solid, skybox_set_color, skybox_texture,
    Vec2, Vec3, Vec4, Quat, Mat4, vec2, vec3, vec4, quat, v3_add, v3_sub, v3_mul, v3_div,
    v3_neg, v3_dot, v3_cross, v3_len, v3_len_sq, v3_normalize, v3_distance, v3_lerp, v3_eq,
    v3_zero, v4_from_v3, v4_xyz, quat_ident, quat_rotate, quat_mul, quat_apply,
    quat_normalize, quat_len, quat_is_zero, quat_from_euler, quat_mat4, mat4_ident,
    mat4_zero, mat4_mul, mat4_mul_v4, mat4_transform_point, mat4_translate, mat4_scale,
    mat4_perspective, mat4_ortho, mat4_look_at, mat4_inverse, mat4_transpose, mat4_col,
    mat4_at, deg_to_rad, rad_to_deg, clampf, lerpf, PI, TWO_PI, HALF_PI, sin_of, cos_of,
    tan_of, atan2_of, sqrt_of, abs_of, Material, MaterialGroup, Model, Light, Shader,
    Backend, Uniform, LIGHT_STATIC, LIGHT_DYNAMIC, MODE_POINT, MODE_DIRECTIONAL, MODE_SPOT,
    UNIFORM_FLOAT, UNIFORM_INT, UNIFORM_VEC3, UNIFORM_FLOAT_ARRAY, UNIFORM_VEC3_ARRAY,
    env_int, material_new, material_default, material_clone, material_equals, material_free,
    model_new, model_free,
    model_clone, model_set_casts_shadow,
    model_set_position, model_set_scale, model_set_rotation, model_rotate,
    model_update_matrix, model_recalculate_bounds, model_mark_dirty, model_set_diffuse,
    model_set_specular, model_set_pbr, model_set_exposure, model_set_alpha,
    model_set_texture, model_set_shader, model_set_name, model_set_source_path,
    material_set_texture_path, material_set_name, light_set_name, camera_set_name, text,
    set_owned, model_metallic, model_plastic, model_rough_metal,
    model_polished_metal, model_matte, model_glossy, model_glass, model_transparent_plastic,
    model_add_group, model_group, model_group_count, model_sort_groups_by_texture,
    model_own_material,
    model_ensure_material, model_set_uniform_float, model_set_uniform_int,
    model_set_uniform_vec3, model_set_uniform_array, model_uniform_count, model_uniform,
    model_enable_instancing, model_set_instance_position, model_set_instance_color,
    model_enable_instance_colors, model_set_instance_positions, model_set_instance_colors,
    model_instance_count, model_remove_instance, light_new, light_directional, light_point,
    light_warm, light_cool, light_sun, light_free, shader_new, shader_named, shader_valid,
    SHADER_CUSTOM, SHADER_WATER, debug_enabled,
    set_debug, frustum_culling, set_frustum_culling, face_culling, set_face_culling,
    depth_test, set_depth_test, next_model_id, backend_init, backend_render,
    backend_add_model, backend_remove_model, backend_load_texture, backend_set_skybox,
    backend_update_viewport, backend_set_post, backend_set_clear_color, backend_set_shadows,
    backend_add_light, backend_remove_light, backend_draw_calls, backend_frame_pixels,
    backend_cleanup, Camera, Plane, Frustum, camera_new,
    camera_free, camera_update_projection, camera_set_fov, camera_set_near, camera_set_far,
    camera_set_aspect, camera_set_position, camera_set_speed, camera_view,
    camera_projection, camera_view_projection, camera_world_to_screen, camera_process_keyboard,
    camera_process_mouse, camera_look_at, camera_update_vectors, camera_frustum,
    frustum_intersects_sphere, plane_distance, camera_screen_to_world, frustum_dirty,
    mark_frustum_dirty, clear_frustum_dirty
)

