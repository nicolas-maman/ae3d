// Proves the OpenGL backend actually rasterises geometry: it renders a lit cube
// filling the middle of the frame, reads the centre pixel back off the
// framebuffer, and fails if that pixel is still the clear colour.

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import ae3d.loader

var g_engine: ptr = null
var g_centre = 0
var g_corner = 0
var g_draw_calls = 0
var g_fixed_calls = 0
var g_fixed_delta = 0.0

// engine_add_model does not take ownership: there is an engine_remove_model,
// and every other suite frees the models it made. Held so main can.
var g_cube: ptr = null

// Everything main allocated, released on every way out of it rather than only
// the one that reaches the bottom. The three early returns were each losing an
// engine and a light, and nothing said so because the leak check skipped every
// suite that uses ae3d.engine.
teardown(e: *Engine, light: *Light) {
    core.light_free(light)
    engine.engine_free(e)
    // After the engine, because freeing the renderer is what releases the GPU
    // handles the model was given.
    if g_cube != null {
        core.model_free(g_cube as *Model)
        g_cube = null
    }
}

on_start(state: ptr, e: *Engine) {
    cube = loader.cube(1.0)
    core.model_set_scale(cube, 40.0, 40.0, 40.0)
    core.model_matte(cube, 0.9, 0.2, 0.15)
    engine.engine_add_model(e, cube)
    g_cube = cube as ptr

    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 120.0))
}

// The engine drained its fixed-step accumulator a step at a time and called
// nothing in between, so a program that set a step and waited for it waited
// forever.
on_fixed(state: ptr, e: *Engine, step: float) {
    g_fixed_calls = g_fixed_calls + 1
    g_fixed_delta = step
}

on_render(state: ptr, e: *Engine, delta: float) {
    width = platform.window_fb_width(engine.engine_window(e))
    height = platform.window_fb_height(engine.engine_window(e))
    g_centre = gl.read_pixel(width / 2, height / 2)
    g_corner = gl.read_pixel(2, 2)
    g_draw_calls = gl.renderer_draw_calls(engine.engine_gl_renderer(e))
}

main() {
    // An OpenGL test by design: it reads the frame through gl.read_pixel.
    e = engine.engine_new_with(platform.API_GL)
    engine.engine_set_size(e, 640, 480)
    engine.engine_set_title(e, "ae3d render test")
    engine.engine_set_frame_limit(e, 8)
    engine.engine_set_fixed_step(e, 1.0 / 240.0)
    engine.engine_set_camera_input(e, false)

    light = core.light_sun(core.vec3(0.0, 0.0, 1.0))
    engine.engine_set_light(e, light)
    program = engine.behaviour_new("render test", null)
    program.start = on_start
    program.fixed_update = on_fixed
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)

    // A machine with no display cannot be asked to open one. That is a fact
    // about where this is running, not something the renderer got wrong.
    if !engine.engine_run(e) {
        println("render: SKIP no window available")
        teardown(e, light)
        return
    }

    failures = 0
    if g_fixed_calls < 1 {
        println("render: FAIL the fixed step was never called")
        teardown(e, light)
        return
    }
    if core.abs_of(g_fixed_delta - 1.0 / 240.0) > 0.000001 {
        println("render: FAIL the fixed step arrived as ${g_fixed_delta}, not the step that was set")
        teardown(e, light)
        return
    }

    if g_draw_calls < 1 {
        println("render: FAIL no draw calls were issued")
        failures = failures + 1
    }
    if g_corner != 0 {
        println("render: FAIL background pixel is ${g_corner}, expected the clear colour")
        failures = failures + 1
    }
    if g_centre == 0 {
        println("render: FAIL centre pixel is still the clear colour, nothing was rasterised")
        failures = failures + 1
    }

    if failures == 0 {
        println("render: all checks passed (centre=${g_centre} draw_calls=${g_draw_calls})")
    }

    teardown(e, light)
}
