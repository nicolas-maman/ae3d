// A shadow has to appear where the light is blocked, and only there.
//
// A sphere floats over a ground plane with the light overhead. The scene is
// rendered with shadows off and on, and the two frames compared row by row: some
// band of rows must darken, and the rest of the frame must not. Rendering twice
// and measuring the difference is what separates a real depth test from a
// decorative one.
//
// The OpenGL path reads back through a pair of buffers, so the frame just drawn
// is the second read rather than the first. The target hands back the same
// buffer on every read, so a frame is summed before the next render overwrites
// it rather than held as a pointer.
frame_of(backend: *Backend) -> ptr {
    core.backend_frame_pixels(backend)
    return core.backend_frame_pixels(backend)
}

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vk
import ae3d.offscreen
import ae3d.loader
import ae3d.rendering

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

const WIDTH = 320
const HEIGHT = 240

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

luma(pixels: ptr, x: int, y: int) -> int {
    index = (y * WIDTH + x) * 4
    return mem.get_byte(pixels, index) +
           mem.get_byte(pixels, index + 1) +
           mem.get_byte(pixels, index + 2)
}

column_total(pixels: ptr, x: int) -> int {
    total = 0
    y = 0
    while y < HEIGHT {
        total = total + luma(pixels, x, y)
        y = y + 1
    }
    return total
}

// How many rows are measurably darker than the frame they are compared with.
darkened(pixels: ptr, lit: int[]) -> int {
    rows = 0
    y = 0
    while y < HEIGHT {
        if lit[y] - row_total(pixels, y) > WIDTH * 4 { rows = rows + 1 }
        y = y + 1
    }
    return rows
}

row_total(pixels: ptr, y: int) -> int {
    total = 0
    x = 0
    while x < WIDTH {
        total = total + luma(pixels, x, y)
        x = x + 1
    }
    return total
}

// Everything here goes through the vtable, so the same checks run against
// whichever renderer is handed in. Shadows are the newest thing both backends
// do and the one most likely to diverge, and only one of them was ever asked
// these questions directly: the other was covered by a comparison between the
// two, which passes just as well when both are wrong in the same way.
run_checks(backend: *Backend, name: string) {
    core.backend_set_clear_color(backend, 0.0, 0.0, 0.0)

    ground = loader.plane(24, 16.0)
    core.model_set_position(ground, 0.0 - 192.0, 0.0, 0.0 - 192.0)
    core.model_matte(ground, 0.85, 0.85, 0.85)
    core.backend_add_model(backend, ground)

    blocker = loader.sphere(1.0, 32, 24)
    core.model_set_scale(blocker, 30.0, 30.0, 30.0)
    core.model_set_position(blocker, 0.0, 130.0, 0.0)
    core.model_matte(blocker, 0.8, 0.3, 0.2)
    core.backend_add_model(backend, blocker)

    // The ground is left UNCONFIGURED on purpose. Every check below used to run
    // on a model that had been handed a shadow_intensity, so the values a model
    // gets when nobody configures it were never asked anything: they were zero,
    // which is not "no shadow" but a shadow that multiplies the surface to
    // black, and a softness of zero put all nine taps of the 3x3 on one texel.
    config = rendering.default_config()
    config.advanced_shadows = true
    config.shadow_intensity = 0.25
    config.shadow_softness = 1.0
    rendering.apply(blocker, config)

    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 150.0, 260.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))

    light = core.light_sun(core.vec3(0.0, 1.0, 0.0))
    light.ambient_strength = 0.35

    core.backend_render(backend, cam, light)
    lit = frame_of(backend)
    if lit == null { println("shadows: SKIP no pixels") ; return }

    rows_store = calloc(HEIGHT, 4)
    rows_lit = rows_store as int[]
    total_lit = 0
    y = 0
    while y < HEIGHT {
        rows_lit[y] = row_total(lit, y)
        total_lit = total_lit + rows_lit[y]
        y = y + 1
    }

    core.backend_set_shadows(backend, true)
    check("${name} the shadow map was created", core.backend_shadows(backend))

    core.backend_render(backend, cam, light)

    shadowed = frame_of(backend)

    // A shadow darkens what the light was reaching; it does not cut a hole in
    // it. Counted against the unshadowed frame rather than against black,
    // because the scene clears to black and the background is not the ground.
    holed = 0
    hy = 0
    while hy < HEIGHT {
        hx = 0
        while hx < WIDTH {
            if luma(lit, hx, hy) > 40 && luma(shadowed, hx, hy) < 12 {
                holed = holed + 1
            }
            hx = hx + 1
        }
        hy = hy + 1
    }
    if holed > 0 {
        println("  ${name}: ${holed} lit pixel(s) fell to black under the shadow")
    }
    check("${name} the shadow darkens rather than cutting a hole", holed == 0)
    if shadowed == null { println("shadows: SKIP no pixels") ; return }

    darkened_rows = 0
    deepest = 0
    first_row = 0 - 1
    last_row = 0 - 1
    total_shadow = 0
    y = 0
    while y < HEIGHT {
        now = row_total(shadowed, y)
        total_shadow = total_shadow + now
        drop = rows_lit[y] - now
        if drop > WIDTH * 4 {
            darkened_rows = darkened_rows + 1
            if first_row < 0 { first_row = y }
            last_row = y
        }
        if drop > deepest { deepest = drop }
        y = y + 1
    }

    check("${name} the frame darkens when shadows are on", total_shadow < total_lit)
    check("${name} the shadow lands on some rows, not the whole frame",
          darkened_rows > 4 && darkened_rows < HEIGHT * 3 / 4)
    // Rows the shadow never reaches prove it is cast rather than a global dim.
    check("${name} rows outside the shadow are untouched", darkened_rows < HEIGHT / 2)
    check("${name} the darkest row drops substantially", deepest > WIDTH * 12)

    println("  ${name}: frame ${total_lit} -> ${total_shadow}, ${darkened_rows} of ${HEIGHT} rows darkened (${first_row}..${last_row}), deepest row drop ${deepest}")

    // Everything above holds just as well for a shadow cast towards the light
    // as away from it: the same rows darken either way. A sun off to one side
    // is what tells them apart, and it is the whole of what a shadow is for.
    side = core.light_sun(core.vec3(1.0, 0.85, 0.0))
    side.ambient_strength = 0.35

    core.backend_set_shadows(backend, false)
    core.backend_render(backend, cam, side)
    side_lit = frame_of(backend)
    if side_lit == null { println("shadows: SKIP no pixels") ; return }

    columns_store = calloc(WIDTH, 4)
    columns_lit = columns_store as int[]
    x = 0
    while x < WIDTH {
        columns_lit[x] = column_total(side_lit, x)
        x = x + 1
    }

    core.backend_set_shadows(backend, true)
    core.backend_render(backend, cam, side)
    side_shadowed = frame_of(backend)
    if side_shadowed == null { println("shadows: SKIP no pixels") ; return }

    away_drop = 0
    towards_drop = 0
    x = 0
    while x < WIDTH {
        drop = columns_lit[x] - column_total(side_shadowed, x)
        if drop < 0 { drop = 0 }
        if x < WIDTH / 2 { away_drop = away_drop + drop }
        if x >= WIDTH / 2 { towards_drop = towards_drop + drop }
        x = x + 1
    }

    check("${name} the shadow falls away from the light, not towards it",
          away_drop > towards_drop * 3)
    println("  ${name}: sun to the right: ${away_drop} darkened to its left, ${towards_drop} to its right")

    free(columns_store)

    // A world is not all one size. The map is fitted to every model in the
    // scene, so a ground plane wide enough to reach a horizon spreads it until
    // the depth comparison swallows anything standing on it -- the shadow does
    // not get softer, it stops existing, and nothing says so. A shadow distance
    // fits the map to what the camera can see instead.
    horizon = loader.plane(60, 64.0)
    core.model_set_position(horizon, 0.0 - 1920.0, 0.0 - 1.0, 0.0 - 1920.0)
    core.model_matte(horizon, 0.8, 0.8, 0.8)
    core.backend_add_model(backend, horizon)

    // Small, the way a figure is small against a street: three ten-thousandths
    // of the world it stands in.
    post = loader.cube(9.0)
    core.model_set_position(post, 0.0 - 26.0, 12.0, 96.0)
    core.model_matte(post, 0.7, 0.25, 0.2)
    core.backend_add_model(backend, post)
    blocker.visible = false

    core.backend_set_shadows(backend, false)
    core.backend_render(backend, cam, light)
    plain = frame_of(backend)
    if plain == null { println("shadows: SKIP no pixels") ; return }
    y = 0
    while y < HEIGHT {
        rows_lit[y] = row_total(plain, y)
        y = y + 1
    }

    core.backend_set_shadows(backend, true)
    core.backend_render(backend, cam, light)
    wide = frame_of(backend)
    if wide == null { println("shadows: SKIP no pixels") ; return }
    wide_rows = darkened(wide, rows_lit)

    core.backend_set_shadow_distance(backend, 260.0)
    core.backend_render(backend, cam, light)
    bounded = frame_of(backend)
    if bounded == null { println("shadows: SKIP no pixels") ; return }
    bounded_rows = darkened(bounded, rows_lit)

    println("  ${name}: a nine-unit post in a world 3840 across darkens ${wide_rows} rows fitted to the scene, ${bounded_rows} bounded to 260")
    check("${name} a shadow distance keeps a small shadow in a large world",
          bounded_rows > 2 && bounded_rows > wide_rows * 2)

    core.backend_set_shadow_distance(backend, 0.0)
    blocker.visible = true
    core.backend_remove_model(backend, post)
    core.backend_remove_model(backend, horizon)
    core.model_free(post)
    core.model_free(horizon)

    core.light_free(side)
    free(rows_store)
        core.backend_remove_model(backend, ground)
    core.backend_remove_model(backend, blocker)
    core.model_free(ground)
    core.model_free(blocker)
    core.camera_free(cam)
    core.light_free(light)
}

main() {
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("shadows: SKIP no OpenGL context")
        return
    }

    renderer = gl.renderer_new()
    gl_pass = gl.backend(renderer)
    if !core.backend_init(&gl_pass, context, WIDTH, HEIGHT) {
        println("shadows: SKIP the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    run_checks(&gl_pass, "opengl")
    core.backend_cleanup(&gl_pass)
    offscreen.target_destroy(target)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)

    if !vk.available() {
        println("shadows: no Vulkan driver (${vk.last_error()}), checked OpenGL only")
    } else {
        vk_renderer = vk.renderer_new()
        vk_pass = vk.backend(vk_renderer)
        if !core.backend_init(&vk_pass, null, WIDTH, HEIGHT) {
            println("shadows: SKIP Vulkan would not start (${vk.last_error()})")
        } else {
            run_checks(&vk_pass, "vulkan")
            core.backend_cleanup(&vk_pass)
        }
        vk.renderer_free(vk_renderer)
    }

    if failures == 0 {
        println("shadows: all checks passed")
    } else {
        println("shadows: ${failures} failure(s)")
    }
}
