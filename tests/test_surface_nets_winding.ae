// A surface-nets mesh must wind its triangles the way its normals point: the
// normal a vertex carries comes from the field's gradient and is outward by
// construction, so a triangle whose geometric normal points the other way is
// a face the renderer will cull from the side it is seen from. The terrain
// example showed the symptom -- hills you could see through to the backs of
// the hills behind them -- and this holds every axis's quads to it. No GPU.

import ae3d.core
import ae3d.noise
import ae3d.voxel
import ae3d.loader
import ae3d.raycast

extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)

const GRID = 160
const HEIGHT = 64
const CELL = 6.0

var failures = 0

check_true(name: string, ok: bool) {
    if !ok {
        println("FAIL ${name}")
        failures = failures + 1
    }
}

// How many triangles agree with their vertices' normals, per dominant axis of
// the geometric normal, so a wrong flip on one axis is named.
agreement(m: *Model, axis: int) -> float {
    mesh = m.mesh
    count = core.mesh_index_count(mesh)
    agreed = 0
    seen = 0
    t = 0
    while t + 2 < count {
        i0 = core.mesh_index_at(mesh, t)
        i1 = core.mesh_index_at(mesh, t + 1)
        i2 = core.mesh_index_at(mesh, t + 2)
        p0 = core.mesh_position(mesh, i0)
        p1 = core.mesh_position(mesh, i1)
        p2 = core.mesh_position(mesh, i2)
        geometric = core.v3_cross(core.v3_sub(p1, p0), core.v3_sub(p2, p0))
        carried = core.v3_add(core.v3_add(core.mesh_normal(mesh, i0), core.mesh_normal(mesh, i1)),
                              core.mesh_normal(mesh, i2))
        ax = core.abs_of(geometric.x)
        ay = core.abs_of(geometric.y)
        az = core.abs_of(geometric.z)
        dominant = 0
        if ay >= ax && ay >= az { dominant = 1 }
        if az > ax && az > ay { dominant = 2 }
        if dominant == axis && core.v3_len(geometric) > 0.000000001 {
            seen = seen + 1
            if core.v3_dot(geometric, carried) > 0.0 { agreed = agreed + 1 }
            else if seen - agreed <= 6 {
                c = core.v3_mul(core.v3_add(core.v3_add(p0, p1), p2), 1.0 / 3.0)
                println("    disagrees at (${c.x}, ${c.y}, ${c.z}) geometric (${geometric.x}, ${geometric.y}, ${geometric.z})")
            }
        }
        t = t + 3
    }
    if seen == 0 { return 1.0 }
    println("  axis ${axis}: ${agreed} of ${seen} triangles wound with their normals")
    return (agreed as float) / (seen as float)
}

main() {
    // The convention, checked on shapes the renderer is known to draw with
    // back faces culled: a plane wound the loader's way and a sphere.
    plane = loader.plane(4, 1.0)
    check_true("loader.plane winds with its normals (the convention)", agreement(plane, 1) > 0.99)
    ball = loader.sphere(1.0, 12, 8)
    check_true("loader.sphere winds with its normals", agreement(ball, 0) > 0.99 && agreement(ball, 1) > 0.99 && agreement(ball, 2) > 0.99)
    core.model_free(plane)
    core.model_free(ball)

    world = voxel.world_new(GRID, GRID, HEIGHT, CELL)
    check_true("the field allocates", voxel.world_sdf_enable(world))
    field = noise.perlin_new(4242)
    x = 0
    while x < GRID {
        z = 0
        while z < GRID {
            // Hills steep enough that every axis carries faces.
            // The terrain example's own field.
            sample = noise.fbm2(field, (x as float) * 0.022, (z as float) * 0.022, 5, 0.5)
            ridged = noise.ridge(field, (x as float) * 0.006, 0.0, (z as float) * 0.006, 3, 0.5)
            h = 12.0 + (sample + 1.0) * 0.5 * 22.0 + ridged * 16.0
            y = 0
            while y < HEIGHT {
                value = (y as float) - h
                // Closed on every side, as the example closes it, so a
                // closed surface is what the mesher owes: no open edges.
                if y == 0 || x == 0 || z == 0 || x == GRID - 1 || z == GRID - 1 { value = 1.0 }
                voxel.world_sdf_set(world, x, y, z, value)
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
    noise.perlin_free(field)

    surface = voxel.world_build_surface(world)
    check_true("the field produces a surface", surface != null)
    if surface != null {
        // No triangle spans more than a couple of cells: a quad stitched to
        // the wrong cell's vertex reaches across the volume.
        mesh = surface.mesh
        long_edges = 0
        shown = 0
        t = 0
        while t + 2 < core.mesh_index_count(mesh) {
            p0 = core.mesh_position(mesh, core.mesh_index_at(mesh, t))
            p1 = core.mesh_position(mesh, core.mesh_index_at(mesh, t + 1))
            p2 = core.mesh_position(mesh, core.mesh_index_at(mesh, t + 2))
            reach = core.v3_len(core.v3_sub(p1, p0))
            if core.v3_len(core.v3_sub(p2, p0)) > reach { reach = core.v3_len(core.v3_sub(p2, p0)) }
            if core.v3_len(core.v3_sub(p2, p1)) > reach { reach = core.v3_len(core.v3_sub(p2, p1)) }
            if reach > CELL * 3.0 {
                long_edges = long_edges + 1
                if shown < 5 {
                    println("    long triangle ${reach}m: (${p0.x}, ${p0.y}, ${p0.z}) (${p1.x}, ${p1.y}, ${p1.z}) (${p2.x}, ${p2.y}, ${p2.z})")
                    shown = shown + 1
                }
            }
            t = t + 3
        }
        println("  ${long_edges} triangles reach further than three cells")
        // A vertex on the top of a hill, and the normal it carries.
        i = 0
        top = 0
        top_y = 0.0 - 1.0
        while i < core.mesh_vertex_count(mesh) {
            at = core.mesh_position(mesh, i)
            if at.y > top_y { top_y = at.y; top = i }
            i = i + 1
        }
        n = core.mesh_normal(mesh, top)
        println("  the highest vertex sits at ${top_y} m and carries the normal (${n.x}, ${n.y}, ${n.z})")
        check_true("the highest vertex's normal points up", n.y > 0.5)
        check_true("no triangle reaches across the volume", long_edges == 0)

        // What the example's low camera sees through the hill: every triangle
        // along its ray through the hole, nearest first, with whether the
        // ray meets its front or its back. (Mesh space: the example sinks the
        // mesh by 193 m, so the camera rises by it here.)
        origin = core.vec3(0.0 - 170.0, 22.0 + 193.0, 0.0 - 120.0)
        aim = core.v3_normalize(core.v3_sub(core.vec3(420.0, 45.0 + 193.0, 420.0), origin))
        hits = 0
        t = 0
        while t + 2 < core.mesh_index_count(mesh) {
            i0 = core.mesh_index_at(mesh, t)
            i1 = core.mesh_index_at(mesh, t + 1)
            i2 = core.mesh_index_at(mesh, t + 2)
            p0 = core.mesh_position(mesh, i0)
            p1 = core.mesh_position(mesh, i1)
            p2 = core.mesh_position(mesh, i2)
            d = raycast.triangle(origin, aim, p0, p1, p2)
            if d > 0.0 && hits < 8 {
                facing = core.v3_dot(core.v3_cross(core.v3_sub(p1, p0), core.v3_sub(p2, p0)), aim)
                side = "front"
                if facing > 0.0 { side = "back" }
                println("    ray hits ${side} face at ${d}m, y ${p0.y}")
                hits = hits + 1
            }
            t = t + 3
        }
        println("  ${hits} triangles on the ray")

        // Open edges: an edge with one triangle on it is the rim of a hole.
        // Counted by hashing each undirected edge into a table sized to the
        // index count and keeping a count per slot; collisions only ever
        // make this undercount, never invent a hole.
        slots = core.mesh_index_count(mesh) * 2
        table = calloc(slots, 4)
        keys = calloc(slots, 8)
        counts = table as int[]
        edge_keys = keys as float[]
        open = 0
        t = 0
        while t + 2 < core.mesh_index_count(mesh) {
            e = 0
            while e < 3 {
                a = core.mesh_index_at(mesh, t + e)
                b = core.mesh_index_at(mesh, t + (e + 1) % 3)
                lo = a
                hi = b
                if b < a { lo = b; hi = a }
                key = (lo as float) * 1000003.0 + (hi as float)
                slot = ((lo * 2654435761 + hi * 40503) & 0x7FFFFFFF) % slots
                probes = 0
                while probes < 64 && counts[slot] != 0 && edge_keys[slot] != key {
                    slot = (slot + 1) % slots
                    probes = probes + 1
                }
                if counts[slot] == 0 { edge_keys[slot] = key }
                counts[slot] = counts[slot] + 1
                e = e + 1
            }
            t = t + 3
        }
        inland_open = 0
        i = 0
        while i < slots {
            if counts[i] == 1 {
                open = open + 1
                // Which are not on the grid's rim: those are holes.
                lo = (edge_keys[i] / 1000003.0) as int
                at = core.mesh_position(mesh, lo)
                margin = CELL * 0.0
                if at.x > margin && at.z > margin &&
                   at.x < (GRID as float) * CELL - margin && at.z < (GRID as float) * CELL - margin {
                    inland_open = inland_open + 1
                    if inland_open <= 6 { println("    open edge inland at (${at.x}, ${at.y}, ${at.z})") }
                }
            }
            i = i + 1
        }
        println("  ${inland_open} of them inland")
        free(table)
        free(keys)
        println("  ${open} open edges (a closed surface has none)")
        check_true("the surface is closed", open == 0)
        check_true("the x faces wind with their normals", agreement(surface, 0) > 0.98)
        check_true("the y faces wind with their normals", agreement(surface, 1) > 0.98)
        check_true("the z faces wind with their normals", agreement(surface, 2) > 0.98)
        core.model_free(surface)
    }
    voxel.world_free(world)

    if failures == 0 {
        println("surface nets winding: all checks passed")
    } else {
        println("surface nets winding: ${failures} failure(s)")
    }
}
