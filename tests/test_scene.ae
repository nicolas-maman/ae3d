// Ray casting maths and the component lifecycle, both headless.

import std.list
import std.string
import ae3d.core
import ae3d.behaviour
import ae3d.raycast
import ae3d.loader
import ae3d.rendering

var failures = 0
var awake_calls = 0
var start_calls = 0
var update_calls = 0
var fixed_calls = 0
var destroy_calls = 0

check(name: string, got: float, want: float) {
    if core.abs_of(got - want) > 0.00001 {
        println("FAIL ${name}: got ${got} want ${want}")
        failures = failures + 1
    }
}

check_true(name: string, condition: bool) {
    if !condition {
        println("FAIL ${name}")
        failures = failures + 1
    }
}

check_int(name: string, got: int, want: int) {
    if got != want {
        println("FAIL ${name}: got ${got} want ${want}")
        failures = failures + 1
    }
}

spin_awake(state: ptr) { awake_calls = awake_calls + 1 }
spin_start(state: ptr) { start_calls = start_calls + 1 }
spin_update(state: ptr, delta: float) { update_calls = update_calls + 1 }
spin_fixed(state: ptr, delta: float) { fixed_calls = fixed_calls + 1 }
spin_destroy(state: ptr) { destroy_calls = destroy_calls + 1 }

var second_destroy_calls = 0
second_destroy(state: ptr) { second_destroy_calls = second_destroy_calls + 1 }

test_raycast() {
    origin = core.vec3(0.0, 0.0, 10.0)
    forward = core.vec3(0.0, 0.0, 0.0 - 1.0)

    // A unit sphere at the origin is first touched five units along the ray.
    check("sphere front", raycast.sphere(origin, forward, core.vec3(0.0, 0.0, 0.0), 5.0), 5.0)
    check_true("sphere miss",
               !raycast.hit(raycast.sphere(origin, core.vec3(0.0, 1.0, 0.0),
                                           core.vec3(0.0, 0.0, 0.0), 5.0)))

    point = raycast.point_at(origin, forward, 5.0)
    check("point z", point.z, 5.0)

    // Triangle straddling the origin in the z = 0 plane.
    distance = raycast.triangle(origin, forward,
                                core.vec3(0.0 - 1.0, 0.0 - 1.0, 0.0),
                                core.vec3(1.0, 0.0 - 1.0, 0.0),
                                core.vec3(0.0, 1.0, 0.0))
    check("triangle hit", distance, 10.0)

    behind = raycast.triangle(core.vec3(0.0, 0.0, 0.0 - 10.0), forward,
                              core.vec3(0.0 - 1.0, 0.0 - 1.0, 0.0),
                              core.vec3(1.0, 0.0 - 1.0, 0.0),
                              core.vec3(0.0, 1.0, 0.0))
    check_true("triangle behind ray", !raycast.hit(behind))

    edge = raycast.triangle(core.vec3(5.0, 5.0, 10.0), forward,
                            core.vec3(0.0 - 1.0, 0.0 - 1.0, 0.0),
                            core.vec3(1.0, 0.0 - 1.0, 0.0),
                            core.vec3(0.0, 1.0, 0.0))
    check_true("triangle outside", !raycast.hit(edge))

    cube = loader.cube(2.0)
    core.model_set_position(cube, 0.0, 0.0, 0.0)
    check("mesh hit", raycast.model_mesh(origin, forward, cube), 9.0)
    check_true("mesh miss",
               !raycast.hit(raycast.model_mesh(core.vec3(50.0, 50.0, 10.0), forward, cube)))

    // A model that turns has to take its bounds with it. A mesh built around
    // its own origin keeps the same bounding sphere however it is turned, but
    // one built off to a side does not: a floor laid out from a corner swings
    // its whole body across the world. The mesh test gives up early on that
    // sphere, so bounds left behind by a rotation are a pick that silently
    // misses, and they used to be refreshed only where culling was on.
    floor = loader.plane(4, 10.0)
    core.model_rotate(floor, 0.0, 90.0, 0.0)
    check_true("a rotated model can still be picked",
               raycast.hit(raycast.model_mesh(core.vec3(15.0, 20.0, 0.0 - 15.0),
                                              core.vec3(0.0, 0.0 - 1.0, 0.0), floor)))
    core.model_free(floor)

    core.model_free(cube)
}

// A speed is a speed whichever way it points. Scaling each held key separately
// gave a camera holding two of them the speed of both at once, so the diagonal
// was forty one percent faster than the axis.
test_camera_speed() {
    c = core.camera_new(800, 600)
    core.camera_set_position(c, core.vec3(0.0, 0.0, 0.0))

    core.camera_move(c, c.front, 100.0)
    along = core.v3_len(c.position)

    core.camera_set_position(c, core.vec3(0.0, 0.0, 0.0))
    core.camera_move(c, core.v3_add(c.front, c.right), 100.0)
    diagonal = core.v3_len(c.position)

    check("one direction", along, 100.0)
    check("two directions at once", diagonal, 100.0)

    core.camera_set_position(c, core.vec3(0.0, 0.0, 0.0))
    core.camera_move(c, core.v3_add(c.front, core.v3_mul(c.front, 0.0 - 1.0)), 100.0)
    check_true("opposite directions cancel", core.v3_len(c.position) < 0.0001)

    core.camera_free(c)
}

// A number typed into an inspector field can reach values a slider's range
// never could, and three of the camera's take part in a division inside
// mat4_perspective: a fov of 0 or 180, a near plane at or behind the eye, and
// a near equal to the far. Any of them fills the projection with infinities,
// and every frame after that is empty with nothing on screen to say why. The
// setters refuse them, and what this checks is that the camera is still usable
// afterwards, not merely that a field did not change.
finite(v: float) -> bool {
    if v != v { return false }
    return core.abs_of(v) < 1000000000.0
}

projection_is_finite(c: *Camera) -> bool {
    p = core.camera_projection(c)
    return finite(p.m0) && finite(p.m5) && finite(p.m10) && finite(p.m14)
}

test_camera_limits() {
    c = core.camera_new(800, 600)
    core.camera_set_near(c, 0.5)
    core.camera_set_far(c, 900.0)

    check_true("a sane camera projects finitely", projection_is_finite(c))

    core.camera_set_near(c, 0.0)
    check("a near plane at the eye is refused", c.near, 0.5)
    core.camera_set_near(c, 0.0 - 4.0)
    check("a near plane behind the eye is refused", c.near, 0.5)
    // The one that divides by zero: near - far is the denominator, so a near
    // equal to the far is not merely a strange camera, it is an infinite
    // matrix. Checked here rather than at the end, because a later attempt
    // moves the planes apart again and hides it.
    core.camera_set_near(c, 900.0)
    check("a near plane at the far plane is refused", c.near, 0.5)
    check_true("a near plane at the far plane leaves the projection finite",
               projection_is_finite(c))
    core.camera_set_near(c, 1200.0)
    check("a near plane beyond the far plane is refused", c.near, 0.5)

    core.camera_set_far(c, 0.5)
    check("a far plane at the near plane is refused", core.camera_far(c), 900.0)
    core.camera_set_far(c, 0.0 - 10.0)
    check("a far plane behind the eye is refused", core.camera_far(c), 900.0)

    // Read rather than assumed: the point is that the value did not move, not
    // what the default happens to be.
    kept_fov = c.fov
    core.camera_set_fov(c, 0.0)
    check("a fov of nothing is refused", c.fov, kept_fov)
    core.camera_set_fov(c, 180.0)
    check("a fov of half a turn is refused", c.fov, kept_fov)

    check_true("the projection survived every refusal", projection_is_finite(c))

    // The guards must not have shut the door on legal values.
    core.camera_set_near(c, 2.0)
    check("a legal near plane still lands", c.near, 2.0)
    core.camera_set_far(c, 4000.0)
    check("a legal far plane still lands", core.camera_far(c), 4000.0)
    core.camera_set_fov(c, 90.0)
    check("a legal fov still lands", c.fov, 90.0)
    check_true("and it still projects finitely", projection_is_finite(c))

    core.camera_free(c)
}

test_components() {
    scene = behaviour.scene_new()
    object = behaviour.object_new("spinner")
    behaviour.object_set_tag(object, "actor")

    component = behaviour.component_new("spin", behaviour.KIND_SCRIPT, null)
    component.awake = spin_awake as fn(ptr)
    component.start = spin_start as fn(ptr)
    component.update = spin_update as fn(ptr, float)
    component.fixed_update = spin_fixed as fn(ptr, float)
    component.destroy = spin_destroy as fn(ptr)

    behaviour.object_add_component(object, component)
    check_int("awake on add", awake_calls, 1)
    check_int("start deferred", start_calls, 0)

    behaviour.scene_add(scene, object)
    behaviour.scene_update(scene, 0.016)
    check_int("start once", start_calls, 1)
    check_int("update once", update_calls, 1)

    behaviour.scene_update(scene, 0.016)
    check_int("start still once", start_calls, 1)
    check_int("update twice", update_calls, 2)

    behaviour.scene_fixed_update(scene, 0.016)
    check_int("fixed once", fixed_calls, 1)

    behaviour.component_set_enabled(component, false)
    behaviour.scene_update(scene, 0.016)
    check_int("disabled component skipped", update_calls, 2)
    behaviour.component_set_enabled(component, true)

    // The transform lives on the model, so reading it back through the object
    // must show exactly what was written, with no copy in between.
    behaviour.object_set_position(object, core.vec3(3.0, 4.0, 5.0))
    position = behaviour.object_position(object)
    check("object position x", position.x, 3.0)
    check("object position z", position.z, 5.0)

    behaviour.object_translate(object, core.vec3(1.0, 0.0, 0.0))
    check("object translate", behaviour.object_position(object).x, 4.0)

    behaviour.object_set_rotation(object, core.quat_rotate(core.deg_to_rad(90.0),
                                                           core.vec3(0.0, 1.0, 0.0)))
    forward = behaviour.object_forward(object)
    check("object forward x", forward.x, 0.0 - 1.0)

    check_true("find by name", behaviour.scene_find(scene, "spinner") == object)
    check_true("missing name", behaviour.scene_find(scene, "absent") == null)
    check_true("find component",
               behaviour.object_find_component(object, behaviour.KIND_SCRIPT) == component)
    check_int("scene count", behaviour.scene_count(scene), 1)

    // The rest of the transform, read back the same way position was. up and
    // right come out of the same rotation forward does, so a quarter turn about
    // y leaves up alone and swings right onto -z, which is the axis forward
    // just left: forward went to -x, and -x cross +y is -z.
    up = behaviour.object_up(object)
    check("object up y", up.y, 1.0)
    right = behaviour.object_right(object)
    check("object right z", right.z, 0.0 - 1.0)
    check_true("up is untouched by a turn about itself",
               core.abs_of(up.x) < 0.0001 && core.abs_of(up.z) < 0.0001)

    turned = behaviour.object_rotation(object)
    check_true("rotation reads back what was set", core.abs_of(turned.w - 0.70710678) < 0.0001)

    behaviour.object_set_scale(object, core.vec3(2.0, 3.0, 4.0))
    scaled = behaviour.object_scale(object)
    check("object scale x", scaled.x, 2.0)
    check("object scale z", scaled.z, 4.0)

    // An inactive object is skipped whole, components and all.
    behaviour.object_set_active(object, false)
    check_true("active reads back", !behaviour.object_active(object))
    before_inactive = update_calls
    behaviour.scene_update(scene, 0.016)
    check_int("inactive object skipped", update_calls, before_inactive)
    behaviour.object_set_active(object, true)

    check_true("component owner is the object",
               behaviour.component_owner(component) == object)
    check_true("component reports enabled", behaviour.component_enabled(component))

    check_int("one component", behaviour.object_component_count(object), 1)
    check_true("component by index",
               behaviour.object_component(object, 0) == component)

    // A component disabled before it is added must stay disabled. Adding one is
    // not a decision about whether it runs.
    quiet = behaviour.component_new("quiet", behaviour.KIND_CUSTOM, null)
    quiet.update = spin_update as fn(ptr, float)
    quiet.destroy = second_destroy as fn(ptr)
    behaviour.component_set_enabled(quiet, false)
    behaviour.object_add_component(object, quiet)
    check_true("a component added disabled stays disabled",
               !behaviour.component_enabled(quiet))

    check_int("two components", behaviour.object_component_count(object), 2)
    behaviour.object_remove_component(object, quiet)
    check_int("component removed", behaviour.object_component_count(object), 1)
    check_int("removing a component destroys it", second_destroy_calls, 1)

    // The object borrows a model rather than owning one, so freeing the object
    // must leave the model alone. The leak check is what proves the other half.
    borrowed = core.model_new()
    holder = behaviour.object_new("holder")
    behaviour.object_set_model(holder, borrowed)
    check_true("model reads back", behaviour.object_model(holder) == borrowed)
    behaviour.object_free(holder)
    core.model_set_position(borrowed, 1.0, 2.0, 3.0)
    check("the borrowed model outlived its object", borrowed.position.y, 2.0)
    core.model_free(borrowed)

    check_true("scene by index", behaviour.scene_object(scene, 0) == object)

    tagged = list.new()
    check_int("find by tag", behaviour.scene_find_by_tag(scene, "actor", tagged), 1)
    check_true("the tagged object is the one", list.get_raw(tagged, 0) == object)
    check_int("no match for an absent tag",
              behaviour.scene_find_by_tag(scene, "nobody", tagged), 0)
    list.free(tagged)

    behaviour.scene_destroy_later(scene, object)
    behaviour.scene_update(scene, 0.016)
    check_int("scene emptied", behaviour.scene_count(scene), 0)
    check_int("destroy called", destroy_calls, 1)

    behaviour.scene_free(scene)
}

uniform_named(m: *Model, name: string) -> *Uniform {
    count = core.model_uniform_count(m)
    i = 0
    while i < count {
        u = core.model_uniform(m, i)
        if u != null && string.equals(u.name, name) == 1 { return u }
        i = i + 1
    }
    return null
}

test_rendering_config() {
    m = loader.cube(1.0)

    rendering.apply(m, rendering.default_config())
    first_count = core.model_uniform_count(m)
    check_true("config wrote uniforms", first_count > 20)

    ssao = uniform_named(m, "enableSSAO")
    check_true("ssao present", ssao != null)
    check_int("ssao on by default", ssao.integer, 1)

    samples = uniform_named(m, "ssaoSampleCount")
    check_int("default sample count", samples.integer, 12)

    sheen = uniform_named(m, "sheenColor")
    check_true("sheen colour is a vector", sheen.kind == core.UNIFORM_VEC3)
    check("sheen colour r", sheen.vector.x, 1.0)

    // Applying a second config must overwrite in place, not append a duplicate
    // set that the renderer would then upload twice.
    rendering.apply(m, rendering.performance_config())
    check_int("uniforms replaced not appended", core.model_uniform_count(m), first_count)
    check_int("ssao off for performance", uniform_named(m, "enableSSAO").integer, 0)
    check_int("bloom off for performance", uniform_named(m, "enableBloom").integer, 0)

    rendering.apply(m, rendering.high_quality_config())
    check_int("ssao back on", uniform_named(m, "enableSSAO").integer, 1)
    check_int("high quality sample count", uniform_named(m, "ssaoSampleCount").integer, 24)
    check_int("clearcoat on", uniform_named(m, "enableClearcoat").integer, 1)

    rendering.apply(m, rendering.voxel_config())
    check_int("voxel noise off", uniform_named(m, "enablePerlinNoise").integer, 0)
    check("voxel occlusion raised", uniform_named(m, "ssaoIntensity").number, 0.45)

    core.model_free(m)
}

main() {
    test_raycast()
    test_camera_speed()
    test_camera_limits()
    test_components()
    test_rendering_config()

    if failures == 0 {
        println("scene: all checks passed")
    } else {
        println("scene: ${failures} failure(s)")
    }
}
