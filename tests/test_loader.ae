// The OBJ/MTL loader against the real model files.

import std.fs
import std.string
import ae3d.core
import ae3d.loader

extern clock_ns() -> long

var failures = 0

record_failure(reason: string) {
    println("FAIL ${reason}")
    failures = failures + 1
}

check_true(name: string, condition: bool) {
    if !condition { record_failure(name) }
}

load(path: string) -> *Model {
    m = loader.load_obj(path, false)
    if m == null { record_failure("${path}: ${loader.last_error()}") }
    return m
}

test_triangle() {
    m = load("resources/obj/Triangle.obj")
    if m == null { return }
    check_true("triangle has 3 vertices", core.mesh_vertex_count(m.mesh) == 3)
    check_true("triangle has 3 indices", core.mesh_index_count(m.mesh) == 3)
    core.model_free(m)
}

test_cube() {
    m = load("resources/obj/Cube.obj")
    if m == null { return }
    // A cube authored with per-face normals cannot share corners across faces,
    // so the unified buffer holds more than the eight geometric corners.
    check_true("cube vertices", core.mesh_vertex_count(m.mesh) >= 8)
    check_true("cube is 12 triangles", core.mesh_index_count(m.mesh) == 36)

    lowest = 1000.0
    highest = 0.0 - 1000.0
    i = 0
    while i < core.mesh_vertex_count(m.mesh) {
        p = core.mesh_position(m.mesh, i)
        if p.x < lowest { lowest = p.x }
        if p.x > highest { highest = p.x }
        i = i + 1
    }
    check_true("cube spans both signs on x", lowest < 0.0 && highest > 0.0)

    // Every index must address a real vertex.
    vertices = core.mesh_vertex_count(m.mesh)
    bad = 0
    i = 0
    while i < core.mesh_index_count(m.mesh) {
        index = core.mesh_index_at(m.mesh, i)
        if index < 0 || index >= vertices { bad = bad + 1 }
        i = i + 1
    }
    check_true("cube indices in range", bad == 0)

    core.model_free(m)
}

test_sphere() {
    started = clock_ns()
    m = load("resources/obj/Sphere.obj")
    if m == null { return }
    elapsed = (clock_ns() - started) / 1000000

    vertices = core.mesh_vertex_count(m.mesh)
    indices = core.mesh_index_count(m.mesh)
    check_true("sphere loaded geometry", vertices > 1000 && indices > 3000)
    check_true("sphere triangulated", indices % 3 == 0)

    // The model is a displaced sphere, not a perfect one, so the test is that
    // every vertex sits in a shell around the origin rather than on one radius.
    nearest = 100000.0
    furthest = 0.0
    i = 0
    while i < vertices {
        length = core.v3_len(core.mesh_position(m.mesh, i))
        if length < nearest { nearest = length }
        if length > furthest { furthest = length }
        i = i + 1
    }
    check_true("sphere is hollow", nearest > furthest * 0.8)
    check_true("sphere is centred", furthest > 1.0)

    println("  Sphere.obj: ${vertices} vertices, ${indices} indices in ${elapsed} ms")
    core.model_free(m)
}

test_earth() {
    started = clock_ns()
    m = load("resources/obj/Earth/Earth.obj")
    if m == null { return }
    elapsed = (clock_ns() - started) / 1000000

    groups = core.model_group_count(m)
    check_true("earth has material groups", groups > 1)

    // The groups must tile the index buffer exactly, with no gap and no overlap.
    covered = 0
    previous_end = 0
    ordered = true
    i = 0
    while i < groups {
        g = core.model_group(m, i)
        if g.index_start != previous_end { ordered = false }
        previous_end = g.index_start + g.index_count
        covered = covered + g.index_count
        i = i + 1
    }
    check_true("groups are contiguous", ordered)
    check_true("groups cover every index", covered == core.mesh_index_count(m.mesh))

    named = 0
    i = 0
    while i < groups {
        g = core.model_group(m, i)
        if g.material != null { named = named + 1 }
        i = i + 1
    }
    check_true("groups resolved their materials", named == groups)

    // A copy keeps the groups, on materials of its own: a scene of many
    // props from one file is copies of the file's model, and a copy that
    // lost its groups drew every one with its first material.
    copy = core.model_clone(m)
    check_true("a copy keeps the material groups", core.model_group_count(copy) == groups)
    own = true
    i = 0
    while i < core.model_group_count(copy) {
        g = core.model_group(copy, i)
        original = core.model_group(m, i)
        if g.material == null || g.material == original.material { own = false }
        if g.index_start != original.index_start || g.index_count != original.index_count { own = false }
        i = i + 1
    }
    check_true("a copy's groups are its own materials over the same indices", own)
    core.model_free(copy)

    println("  Earth.obj: ${core.mesh_vertex_count(m.mesh)} vertices, ${groups} material groups in ${elapsed} ms")
    core.model_free(m)
}

test_missing() {
    m = loader.load_obj("resources/obj/does_not_exist.obj", false)
    check_true("missing file returns null", m == null)
    check_true("missing file reports why", loader.last_error() != "")
}

// A flat primitive whose triangles wind the wrong way is invisible under face
// culling, so every one of them is checked for an upward normal.
faces_up(m: *Model, name: string) {
    indices = core.mesh_index_count(m.mesh)
    if indices == 0 { record_failure("${name} has no triangles") ; return }

    downward = 0
    i = 0
    while i + 2 < indices {
        a = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i))
        b = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i + 1))
        c = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i + 2))
        normal = core.v3_cross(core.v3_sub(b, a), core.v3_sub(c, a))
        if normal.y <= 0.0 { downward = downward + 1 }
        i = i + 3
    }
    check_true("${name} winds upward", downward == 0)
}

test_primitive_winding() {
    plane = loader.plane(6, 10.0)
    faces_up(plane, "plane")
    core.model_free(plane)

    quad = loader.quad(20.0, 20.0)
    faces_up(quad, "quad")
    core.model_free(quad)

    surface = loader.water_surface(100.0, 0.0, 0.0, 16)
    faces_up(surface, "water surface")
    core.model_free(surface)
}

// A closed primitive's triangles must all face away from its centre, or half of
// it disappears under culling. A sphere's pole rings are degenerate by
// construction, their normal is zero and they rasterise to nothing, so they are
// counted separately rather than allowed as a tolerance.
outward_count(m: *Model, name: string) {
    indices = core.mesh_index_count(m.mesh)
    inward = 0
    degenerate = 0

    i = 0
    while i + 2 < indices {
        a = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i))
        b = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i + 1))
        c = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i + 2))
        normal = core.v3_cross(core.v3_sub(b, a), core.v3_sub(c, a))
        if core.v3_len(normal) < 0.000001 {
            degenerate = degenerate + 1
        } else {
            centre = core.v3_mul(core.v3_add(core.v3_add(a, b), c), 1.0 / 3.0)
            if core.v3_dot(normal, centre) <= 0.0 { inward = inward + 1 }
        }
        i = i + 3
    }
    check_true("${name} winds outward", inward == 0)
    if inward != 0 {
        println("    ${inward} inward, ${degenerate} degenerate of ${indices / 3}")
    }
}

test_closed_winding() {
    cube = loader.cube(2.0)
    outward_count(cube, "cube")
    core.model_free(cube)

    sphere = loader.sphere(1.0, 24, 16)
    outward_count(sphere, "sphere")
    core.model_free(sphere)
}

// An OBJ whose vertices are `values` (space-separated) as x, with y and z
// zero, in triangles of three, loaded back.
load_numbers(path: string, values: string) -> *Model {
    fields = string.split(values, " ")
    count = string.array_size(fields)
    text = ""
    i = 0
    while i < count {
        text = "${text}v ${string.array_get(fields, i)} 0 0
"
        i = i + 1
    }
    i = 0
    while i + 2 < count {
        text = "${text}f ${i + 1} ${i + 2} ${i + 3}
"
        i = i + 3
    }
    string.array_free(fields)
    fs.write(path, text)
    return load(path)
}

// The loader reads a number of fifteen significant digits or fewer, with a
// power of ten within 10^22 either way, without a string (Clinger's fast
// path), and must read it exactly as strtod does. Each value here is set
// against its twin: the same number padded with zeros past fifteen digits,
// which the fast path declines and the parser reads. Zeros, signs, a bare
// point on either side, exponents at and past the edge, and more digits than
// fit are all there.
test_number_fast_path() {
    fs.mkdir_p("build/loader_numbers")
    plain = load_numbers("build/loader_numbers/plain.obj",
        "0.1 -0.1 1 -0 -0.0 0.000001 123456.789 3.14159265358979 1e22 1e-22 1.5e-22 7.0E-10 +2.5 .5 5. -.25 1e23 1e-23 9007199254740993 000000000000000000001.5 0.30000000000000004 -1234.5678e3 2.5e+2 100 0.017453292519943295 42 -7e-3")
    padded = load_numbers("build/loader_numbers/padded.obj",
        "0.10000000000000000 -0.10000000000000000 1.0000000000000000 -0.0000000000000000 -0.00000000000000000 0.0000010000000000000000 123456.7890000000000000000 3.141592653589790000000000000 1.0000000000000000e22 1.0000000000000000e-22 1.50000000000000000e-22 7.00000000000000000E-10 +2.50000000000000000 .50000000000000000 5.0000000000000000 -.250000000000000000 1.0000000000000000e23 1.0000000000000000e-23 9007199254740993.0000000000000000 000000000000000000001.50000000000000000 0.300000000000000040000000000000000 -1234.56780000000000000000e3 2.50000000000000000e+2 100.0000000000000000 0.0174532925199432950000000000000000 42.0000000000000000 -7.0000000000000000e-3")
    if plain == null || padded == null { return }
    count = core.mesh_vertex_count(plain.mesh)
    check_true("every number is a vertex", count == 27 && core.mesh_vertex_count(padded.mesh) == count)
    i = 0
    while i < count {
        a = core.mesh_position(plain.mesh, i).x
        b = core.mesh_position(padded.mesh, i).x
        if a != b { record_failure("number ${i}: fast path read ${a}, the parser ${b}") }
        i = i + 1
    }
    core.model_free(plain)
    core.model_free(padded)

    // What the fast path must decline and leave to the parser: a stray
    // character, a hex float, an infinity, an exponent with no digits. Each
    // is what the parser makes of it, and 0 where it makes nothing -- values
    // a float holds exactly, so the mesh's own precision does not blur them.
    odd = "1.5x 0x1p3 inf 1e 1e+ --1 . 2 4.25"
    declined = load_numbers("build/loader_numbers/declined.obj", odd)
    if declined == null { return }
    fields = string.split(odd, " ")
    i = 0
    while i < string.array_size(fields) {
        text = string.array_get(fields, i)
        wanted, err = string.to_double(text)
        if err != "" { wanted = 0.0 }
        got = core.mesh_position(declined.mesh, i).x
        if got != wanted { record_failure("\"${text}\": read ${got}, the parser makes ${wanted}") }
        i = i + 1
    }
    string.array_free(fields)
    core.model_free(declined)
}

main() {
    test_triangle()
    test_cube()
    test_sphere()
    test_earth()
    test_missing()
    test_primitive_winding()
    test_closed_winding()
    test_number_fast_path()

    if failures == 0 {
        println("loader: all checks passed")
    } else {
        println("loader: ${failures} failure(s)")
    }
}
