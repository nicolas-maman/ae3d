// Frustum culling must not change what is seen.
//
// Skipping a draw is only safe where the thing drawn could not have appeared,
// so the frame has to come out byte for byte the same whether culling is on or
// off, while the count of draws actually falls. Nothing checked either half: a
// culler that dropped something visible and a culler that dropped nothing would
// both have gone unnoticed, and the bounds it reads are worked out from a
// model's transform, so a mesh built off to one side is where it goes wrong.

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vk
import ae3d.offscreen
import ae3d.loader

const WIDTH = 224
const HEIGHT = 168
const PIXELS = WIDTH * HEIGHT * 4

var failures = 0

check_true(name: string, ok: bool) {
    if !ok {
        println("FAIL ${name}")
        failures = failures + 1
    }
}

// The OpenGL path reads back through a pair of buffers, so the frame just drawn
// is the second read rather than the first.
capture(backend: *Backend, cam: *Camera, light: *Light, into: ptr) -> int {
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    pixels = core.backend_frame_pixels(backend)
    i = 0
    while i < PIXELS {
        mem.set_byte(into, i, mem.get_byte(pixels, i))
        i = i + 1
    }
    return core.backend_draw_calls(backend)
}

differing_bytes(a: ptr, b: ptr) -> int {
    count = 0
    i = 0
    while i < PIXELS {
        if mem.get_byte(a, i) != mem.get_byte(b, i) { count = count + 1 }
        i = i + 1
    }
    return count
}

place(backend: *Backend, x: float, y: float, z: float, red: float) -> *Model {
    m = loader.sphere(1.0, 20, 16)
    core.model_set_scale(m, 16.0, 16.0, 16.0)
    core.model_set_position(m, x, y, z)
    // Each one its own colour, so no two can be merged into a single draw and
    // the count says how many survived the cull.
    core.model_set_diffuse(m, red, 0.4, 0.5)
    core.backend_add_model(backend, m)
    return m
}

run_checks(backend: *Backend, name: string) {
    core.backend_set_clear_color(backend, 0.0, 0.0, 0.0)

    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 150.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    core.camera_set_far(cam, 4000.0)
    light = core.light_sun(core.vec3(0.3, 0.8, 0.5))

    seen = place(backend, 0.0 - 30.0, 0.0, 0.0, 0.9)
    also_seen = place(backend, 30.0, 0.0, 0.0, 0.5)
    // Half off the left edge: its middle is outside the view and only its near
    // side reaches in, which is the case a culler working from a sphere that is
    // too small gets wrong.
    straddling = place(backend, 0.0 - 90.0, 0.0, 0.0, 0.8)

    // Far off to either side and far behind: nothing the camera can reach.
    away_left = place(backend, 0.0 - 1400.0, 0.0, 0.0, 0.7)
    away_right = place(backend, 1400.0, 0.0, 0.0, 0.3)
    behind = place(backend, 0.0, 0.0, 900.0, 0.6)

    // A floor built from a corner rather than around its middle, turned so that
    // its body swings across the world. Its bounds have to swing with it or the
    // culler drops a floor that fills half the view.
    floor = loader.plane(6, 24.0)
    core.model_set_position(floor, 0.0, 0.0 - 40.0, 0.0)
    core.model_rotate(floor, 0.0, 180.0, 0.0)
    core.model_set_diffuse(floor, 0.2, 0.7, 0.4)
    core.backend_add_model(backend, floor)

    open = calloc(PIXELS, 1)
    culled = calloc(PIXELS, 1)

    core.set_frustum_culling(false)
    without = capture(backend, cam, light, open)

    core.set_frustum_culling(true)
    with = capture(backend, cam, light, culled)

    println("  ${name}: ${without} draws open, ${with} culled")
    check_true("${name} culling draws less", with < without)
    check_true("${name} culling changes nothing that is seen",
               differing_bytes(open, culled) == 0)

    // Turn to face what was behind the camera. It has to come back.
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 1100.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 900.0))

    core.set_frustum_culling(false)
    turned_open = capture(backend, cam, light, open)
    core.set_frustum_culling(true)
    turned_culled = capture(backend, cam, light, culled)

    check_true("${name} what the camera turns to face is drawn", turned_culled > 0)
    check_true("${name} turning to face it changes nothing either",
               differing_bytes(open, culled) == 0)
    check_true("${name} and something is still culled", turned_culled < turned_open)

    // Two cameras in one program, which is what a minimap, a reflection or a
    // second viewport is. Neither is moved between the renders: the whole point
    // is that a camera that has not changed still has to be culled against its
    // own frustum, not against whichever camera drew last.
    //
    // Checked by the same property as everything above, applied to the second
    // camera: culling must not change what it sees. Counting its draws is not
    // enough, because the objects the first camera's frustum keeps are in the
    // second camera's view as well, so a frame culled against the wrong
    // frustum is still not an empty one.
    other = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_far(other, 4000.0)
    core.camera_set_position(other, core.vec3(0.0, 0.0, 1100.0))
    core.camera_look_at(other, core.vec3(0.0, 0.0, 900.0))

    // `cam` is still turned to face the far object from the check above, so
    // point it back at the origin. Neither camera is touched after this.
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 150.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))

    core.set_frustum_culling(true)
    capture(backend, cam, light, culled)
    second_culled = capture(backend, other, light, culled)

    core.set_frustum_culling(false)
    second_open = capture(backend, other, light, open)

    check_true("${name} the second camera draws something", second_open > 0)
    check_true("${name} a second camera is culled against its own frustum",
               differing_bytes(open, culled) == 0)
    check_true("${name} and its own frustum still culls something",
               second_culled < second_open)

    core.camera_free(other)

    free(open)
    free(culled)

    core.set_frustum_culling(false)
    core.backend_remove_model(backend, straddling)
    core.model_free(straddling)
    core.backend_remove_model(backend, seen)
    core.backend_remove_model(backend, also_seen)
    core.backend_remove_model(backend, away_left)
    core.backend_remove_model(backend, away_right)
    core.backend_remove_model(backend, behind)
    core.backend_remove_model(backend, floor)
    core.model_free(seen)
    core.model_free(also_seen)
    core.model_free(away_left)
    core.model_free(away_right)
    core.model_free(behind)
    core.model_free(floor)
    core.camera_free(cam)
    core.light_free(light)
}

main() {
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("culling: SKIP no OpenGL context")
        return
    }

    renderer = gl.renderer_new()
    gl_pass = gl.backend(renderer)
    if !core.backend_init(&gl_pass, context, WIDTH, HEIGHT) {
        println("culling: SKIP the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    run_checks(&gl_pass, "opengl")
    core.backend_cleanup(&gl_pass)
    offscreen.target_destroy(target)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)

    if !vk.available() {
        println("culling: no Vulkan driver (${vk.last_error()}), checked OpenGL only")
    } else {
        vk_renderer = vk.renderer_new()
        vk_pass = vk.backend(vk_renderer)
        if !core.backend_init(&vk_pass, null, WIDTH, HEIGHT) {
            println("culling: SKIP Vulkan would not start (${vk.last_error()})")
        } else {
            run_checks(&vk_pass, "vulkan")
            core.backend_cleanup(&vk_pass)
        }
        vk.renderer_free(vk_renderer)
    }

    if failures == 0 {
        println("culling: all checks passed")
    } else {
        println("culling: ${failures} failure(s)")
    }
}
