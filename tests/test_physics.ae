// Physics through the engine: the seam between aephysics and the scene.
//
// A crate with a Rigidbody and a box collider falls onto a slab and comes
// to rest on it, its game object moved by the world every fixed step (the
// object's transform is the body's); a kinematic slab moved by the game
// carries the world with it; a sphere fired at a crate knocks it; a
// ragdoll is twelve objects that fall with their bones; and freeing the
// physics leaves the scene's objects and no bodies. The scene file
// carries the bodies: a crate made from a scene record falls like the
// one made by hand, and the world written as a scene reads back with a
// record on every body.
import ae3d.core
import ae3d.scene
import std.list
import std.string
import std.fs
import std.heap
import ae3d.platform
import ae3d.engine
import ae3d.behaviour
import ae3d.loader
import ae3d.physics
import ae3d.skin
import aephysics.math
import aephysics.dynamics
import aephysics.hull

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

var failures = 0

check_true(name: string, ok: bool) {
    if !ok {
        println("physics: FAIL ${name}")
        failures = failures + 1
    }
}

check_near(name: string, got: float, want: float, tolerance: float) {
    if core.abs_of(got - want) > tolerance {
        println("physics: FAIL ${name}: got ${got} want ${want}")
        failures = failures + 1
    }
}

struct Fixture {
    crate: ptr                     // *GameObject
    lift: ptr                      // the kinematic slab
    rider: ptr                     // the crate on it
    target: ptr                    // the crate the ball hits
    ball: ptr
    ragdoll: ptr                   // *Ragdoll
    stander: ptr                   // *Ragdoll, sprung upright
    hull_crate: ptr                // a crate collided as its own model's hull
    victim: ptr                    // *Ragdoll, the figure the car hits, wearing a rig
    rig: ptr                       // *Skeleton, the rig it wears
    victim_start_z: float
    victim_walked_z: float         // the pelvis, when the rig had walked it half a metre
    vehicle: ptr                   // *Vehicle
    car: ptr                       // its chassis object
    car_start_x: float
    head_start_y: float
    steps: int
    fired: bool
    hits: int                      // hit events the car's body reported
    crate_body_matched: bool       // every step, the object's position was the body's
    spec_crate: ptr                // a crate given its body by a scene record
    grouped: ptr                   // a crate under a group object a hundred metres out
    scene_written: bool            // the world was written as a scene on its first frame
}

// A humanoid rig the pipeline's shape: a root turned as Blender's are,
// and a bone model per joint, parented and placed as a standing figure's,
// with the children the bones point at. Nothing is weighted to it here;
// what is checked is that the ragdoll carries it.
rig_bone(rig: *Skeleton, name: string, parent: *Model, x: float, y: float, z: float) -> *Model {
    m = core.model_new()
    core.model_set_name(m, name)
    core.model_set_position(m, x, y, z)
    if parent != null { core.model_set_parent(m, parent) }
    skin.skeleton_add(rig, m)
    return m
}

humanoid_rig() -> *Skeleton {
    rig = skin.skeleton_new()
    root = rig_bone(rig, "Root", null, 0.0, 0.0, 0.0)
    hips = rig_bone(rig, "Hips", root, 0.0, 1.0, 0.0)
    spine = rig_bone(rig, "Spine", hips, 0.0, 0.13, 0.0)
    chest = rig_bone(rig, "Chest", spine, 0.0, 0.26, 0.0)
    neck = rig_bone(rig, "Neck", chest, 0.0, 0.22, 0.0)
    rig_bone(rig, "Head", neck, 0.0, 0.09, 0.0)
    shoulder_l = rig_bone(rig, "ShoulderL", chest, 0.17, 0.14, 0.0)
    elbow_l = rig_bone(rig, "ElbowL", shoulder_l, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristL", elbow_l, 0.0, 0.0 - 0.26, 0.0)
    shoulder_r = rig_bone(rig, "ShoulderR", chest, 0.0 - 0.17, 0.14, 0.0)
    elbow_r = rig_bone(rig, "ElbowR", shoulder_r, 0.0, 0.0 - 0.29, 0.0)
    rig_bone(rig, "WristR", elbow_r, 0.0, 0.0 - 0.26, 0.0)
    thigh_l = rig_bone(rig, "ThighL", hips, 0.1, 0.0 - 0.07, 0.0)
    knee_l = rig_bone(rig, "KneeL", thigh_l, 0.0, 0.0 - 0.44, 0.0)
    ankle_l = rig_bone(rig, "AnkleL", knee_l, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeL", ankle_l, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    thigh_r = rig_bone(rig, "ThighR", hips, 0.0 - 0.1, 0.0 - 0.07, 0.0)
    knee_r = rig_bone(rig, "KneeR", thigh_r, 0.0, 0.0 - 0.44, 0.0)
    ankle_r = rig_bone(rig, "AnkleR", knee_r, 0.0, 0.0 - 0.42, 0.0)
    rig_bone(rig, "ToeR", ankle_r, 0.0, 0.0 - 0.05, 0.0 - 0.15)
    skin.skeleton_bind(rig)
    return rig
}

// A rig and its bones' models, which the ragdoll wore but does not own.
rig_free(rig: *Skeleton) {
    if rig == null { return }
    i = 0
    while i < skin.skeleton_count(rig) {
        core.model_free(skin.skeleton_bone(rig, i))
        i = i + 1
    }
    skin.skeleton_free(rig)
}

ball_hull_verts(h: *HullData) -> int {
    if h == null { return 0 }
    return h.vertex_count
}

// A wheel object: a dynamic body with a sphere collider, as the vehicle wants it.
wheel(e: *Engine, name: string, position: Vec3) -> *GameObject {
    w = engine.object(e, name, loader.sphere(0.35, 10, 6))
    behaviour.object_set_position(w, position)
    physics.rigidbody(w, physics.DYNAMIC)
    physics.sphere_collider(w, 0.35, physics.material(1.0, 0.0), 250.0)
    return w
}

start(state: ptr, e: *Engine) {
    s = state as *Fixture
    physics.attach(e)
    ground = engine.object(e, "Ground", loader.cube(1.0))
    behaviour.object_set_position(ground, core.vec3(0.0, 0.0 - 0.5, 0.0))
    physics.box_collider(ground, core.vec3(40.0, 0.5, 40.0), physics.material(0.6, 0.0))
    check_true("a collider without a Rigidbody makes a static one", physics.rigidbody_of(ground) != null && physics.rigidbody_of(ground).kind == physics.STATIC)

    // Beside the car's lane down x = 0: four seconds in, the car reaches
    // the origin.
    crate = engine.object(e, "Crate", loader.cube(1.0))
    behaviour.object_set_position(crate, core.vec3(0.0 - 5.0, 3.0, 0.0 - 5.0))
    rb = physics.rigidbody(crate, physics.DYNAMIC)
    check_true("a Rigidbody is a component of its object", physics.rigidbody_of(crate) == rb)
    physics.box_collider(crate, core.vec3(0.5, 0.5, 0.5), physics.material(0.6, 0.0))
    s.crate = crate as ptr

    // The same crate from the scene file's record of one.
    sc = engine.object(e, "Spec crate", loader.cube(1.0))
    behaviour.object_set_position(sc, core.vec3(6.0, 3.0, 6.0))
    spec = scene.physics_spec_new("dynamic", "box", 0.6, 0.0, 1.0)
    check_true("a body comes from a scene record", physics.apply_spec(sc, spec) != null)
    heap.free(spec)
    s.spec_crate = sc as ptr

    // A crate under a group: the group stands a hundred metres out, the
    // crate three metres up in the group's frame. The body lives in the
    // world, so it falls where the group is, and its object stays a
    // child with a local transform.
    group = engine.object(e, "Far group", null)
    behaviour.object_set_position(group, core.vec3(100.0, 0.0, 0.0))
    grouped = engine.object(e, "Grouped crate", loader.cube(1.0))
    core.model_set_parent(behaviour.object_model(grouped), behaviour.object_model(group))
    behaviour.object_set_position(grouped, core.vec3(0.0, 3.0, 0.0))
    physics.rigidbody(grouped, physics.DYNAMIC)
    physics.box_collider(grouped, core.vec3(0.5, 0.5, 0.5), physics.material(0.6, 0.0))
    check_near("a grouped crate's body starts where the group puts it", dynamics.body_get_position(physics.rigidbody_body(physics.rigidbody_of(grouped))).x, 100.0, 0.001)
    s.grouped = grouped as ptr
    // Under a slab of its own, a hundred metres out.
    far_ground = engine.object(e, "Far ground", loader.cube(1.0))
    behaviour.object_set_position(far_ground, core.vec3(100.0, 0.0 - 0.5, 0.0))
    physics.box_collider(far_ground, core.vec3(5.0, 0.5, 5.0), physics.material(0.6, 0.0))

    lift = engine.object(e, "Lift", loader.cube(1.0))
    behaviour.object_set_position(lift, core.vec3(10.0, 0.5, 0.0))
    physics.rigidbody(lift, physics.KINEMATIC)
    physics.box_collider(lift, core.vec3(2.0, 0.5, 2.0), physics.material(0.6, 0.0))
    s.lift = lift as ptr
    rider = engine.object(e, "Rider", loader.cube(1.0))
    behaviour.object_set_position(rider, core.vec3(10.0, 1.5, 0.0))
    physics.rigidbody(rider, physics.DYNAMIC)
    physics.box_collider(rider, core.vec3(0.5, 0.5, 0.5), physics.material(0.6, 0.0))
    s.rider = rider as ptr

    target = engine.object(e, "Target", loader.cube(1.0))
    behaviour.object_set_position(target, core.vec3(0.0 - 10.0, 0.5, 0.0))
    physics.rigidbody(target, physics.DYNAMIC)
    physics.box_collider(target, core.vec3(0.5, 0.5, 0.5), physics.material(0.6, 0.0))
    s.target = target as ptr
    ball = engine.object(e, "Ball", loader.sphere(0.5, 12, 8))
    behaviour.object_set_position(ball, core.vec3(0.0 - 10.0, 0.5, 0.0 - 6.0))
    physics.rigidbody(ball, physics.DYNAMIC)
    physics.sphere_collider(ball, 0.5, physics.material(0.6, 0.0), 4.0)
    s.ball = ball as ptr

    // A standing figure: sprung upright to the ground, its joints held stiffly.
    stander = physics.ragdoll(e, "Stander", core.vec3(0.0 - 20.0, 0.02, 8.0), 8.0, 8.0, 1.0)
    physics.ragdoll_stand(stander, physics.rigidbody_of(ground), 25.0, 1.0)
    check_true("a ragdoll sprung upright is standing", physics.ragdoll_is_standing(stander))
    s.stander = stander as ptr

    // A crate collided as the hull of its own drawn cube, at the model's scale.
    hc = engine.object(e, "Hull crate", loader.cube(1.0))
    behaviour.object_set_scale(hc, core.vec3(1.0, 0.6, 1.0))
    behaviour.object_set_position(hc, core.vec3(0.0 - 20.0, 3.0, 0.0 - 8.0))
    physics.rigidbody(hc, physics.DYNAMIC)
    check_true("a convex collider comes from the model", physics.convex_collider_of_model(hc, physics.material(0.6, 0.0)).index1 != 0)
    s.hull_crate = hc as ptr
    // A drawn mesh with more corners than a hull holds -- a sphere of 32
    // by 24, seven hundred vertices, far past the hull's 128 edges -- still
    // gives a hull: the tightest one of a vertex budget the builder takes.
    // The street's bevelled crates were such meshes, and had no collider.
    ball_model = loader.sphere(1.0, 32, 24)
    ball_hull = physics.hull_of_mesh(core.model_mesh(ball_model), core.vec3(1.0, 1.0, 1.0))
    check_true("a mesh past the hull's limits still gives a hull (${ball_hull_verts(ball_hull)} vertices)", ball_hull != null && ball_hull.vertex_count >= 8 && ball_hull.vertex_count <= 128)
    // Both the caller's: the hull was never given to a collider.
    if ball_hull != null { hull.destroy_hull(ball_hull) }
    core.model_free(ball_model)

    // A car: a chassis box on four sphere wheels, driven forward from a standstill.
    car = engine.object(e, "Car", loader.cube(1.0))
    behaviour.object_set_scale(car, core.vec3(1.6, 0.5, 3.6))
    behaviour.object_set_position(car, core.vec3(0.0, 0.7, 20.0))
    rb = physics.rigidbody(car, physics.DYNAMIC)
    physics.box_collider(car, core.vec3(0.8, 0.25, 1.8), physics.material(0.5, 0.0), 250.0)
    physics.rigidbody_enable_hit_events(rb, true)
    wheels_block = calloc(physics.WHEEL_COUNT, 8)
    wheels = wheels_block as ptr[]
    mounts_block = calloc(physics.WHEEL_COUNT, sizeof(Vec3))
    mounts = mounts_block as Vec3[]
    mounts[0] = core.vec3(0.0 - 0.9, 0.0 - 0.35, 0.0 - 1.2)
    mounts[1] = core.vec3(0.9, 0.0 - 0.35, 0.0 - 1.2)
    mounts[2] = core.vec3(0.0 - 0.9, 0.0 - 0.35, 1.2)
    mounts[3] = core.vec3(0.9, 0.0 - 0.35, 1.2)
    i = 0
    while i < physics.WHEEL_COUNT {
        wheels[i] = wheel(e, "Wheel ${i}", core.v3_add(core.vec3(0.0, 0.7, 20.0), mounts[i])) as ptr
        i = i + 1
    }
    v = physics.vehicle(car, wheels_block, mounts_block, 3.0, 0.8, 0.12, 600.0, 30.0, 0.5)
    check_true("a vehicle from a chassis and four wheels", v != null && physics.vehicle_chassis(v) == rb)
    free(wheels_block)
    free(mounts_block)
    s.vehicle = v as ptr
    s.car = car as ptr
    s.car_start_x = 0.0
    // A standing figure in the car's way, twelve metres on.
    victim = physics.ragdoll(e, "Victim", core.vec3(0.0, 0.02, 14.0), 8.0, 8.0, 1.0)
    physics.ragdoll_stand(victim, physics.rigidbody_of(ground), 25.0, 1.0)
    // Wearing a rig: a skeleton named as the pipeline names one, bone
    // models parented as a figure's are, and the ragdoll driving it.
    rig = humanoid_rig()
    check_true("a ragdoll dresses in a rig named as the pipeline names one", physics.ragdoll_dress(victim, rig))
    hips = skin.skeleton_bone(rig, skin.skeleton_find(rig, "Hips"))
    pelvis = behaviour.object_position(physics.ragdoll_bone(victim, 0))
    check_near("dressed, the rig's hips are on the ragdoll's pelvis", core.v3_len(core.v3_sub(core.model_world_position(hips), pelvis)), 0.0, 0.02)
    head = skin.skeleton_bone(rig, skin.skeleton_find(rig, "Head"))
    check_true("and its head is up (${core.model_world_position(head).y})", core.model_world_position(head).y > 1.5)
    s.victim = victim as ptr
    s.rig = rig as ptr
    // And the rig drives the ragdoll: the figure is walked toward the car
    // by its rig's root, its bodies following through their anchors.
    check_true("a dressed ragdoll follows its rig", physics.ragdoll_follow(victim))
    s.victim_start_z = behaviour.object_position(physics.ragdoll_bone(victim, 0)).z

    r = physics.ragdoll(e, "Ragdoll", core.vec3(20.0, 2.0, 0.0), 5.0, 1.0, 0.7)
    check_true("a ragdoll is twelve objects", r != null && physics.ragdoll_bone(r, 11) != null)
    check_true("a ragdoll's bone objects are in the scene", behaviour.scene_find(engine.engine_scene(e), "Ragdoll/neck") == physics.ragdoll_bone(r, 3))
    s.ragdoll = r as ptr
    s.head_start_y = behaviour.object_position(physics.ragdoll_bone(r, 3)).y
    s.crate_body_matched = true
}

// Four seconds of the world, however fast or slow the frames come: the run
// ends on the fixed step's count, not the frame's, so a runner that draws
// three hundred frames a second and one that draws thirty step the same.
const STEPS = 240

fixed_update(state: ptr, e: *Engine, step: float) {
    s = state as *Fixture
    s.steps = s.steps + 1
    if s.steps >= STEPS { engine.engine_stop(e) }
    // The lift rises a metre a second; the game moves the object, the world follows.
    lift = s.lift as *GameObject
    behaviour.object_set_position(lift, core.v3_add(behaviour.object_position(lift), core.vec3(0.0, step, 0.0)))
    if s.steps == 30 && s.fired == false {
        physics.rigidbody_set_velocity(physics.rigidbody_of(s.ball as *GameObject), core.vec3(0.0, 0.0, 12.0))
        s.fired = true
    }
    // The rig walks its figure toward the car, a centimetre a step, for
    // as long as the ragdoll follows it; the fiftieth step notes where the
    // pelvis has got to.
    if s.rig != null && physics.ragdoll_is_following(s.victim as *Ragdoll) {
        root = skin.skeleton_bone(s.rig as *Skeleton, skin.skeleton_find(s.rig as *Skeleton, "Root"))
        core.model_set_position(root, root.position.x, root.position.y, root.position.z - 0.01)
        if s.steps == 50 { s.victim_walked_z = behaviour.object_position(physics.ragdoll_bone(s.victim as *Ragdoll, 0)).z }
    }
    // Full throttle, straight on; what the car strikes is counted.
    if s.vehicle != null {
        physics.vehicle_drive(s.vehicle as *Vehicle, 1.0, 0.0, 0.0)
        p = physics.of(e)
        n = physics.hit_event_count(p)
        i = 0
        while i < n {
            hit = physics.hit_event(p, i)
            r = physics.ragdoll_of_shape(p, hit.shape_id_a)
            if r == null { r = physics.ragdoll_of_shape(p, hit.shape_id_b) }
            if r != null && physics.ragdoll_is_standing(r) { physics.ragdoll_release(r); s.hits = s.hits + 1 }
            i = i + 1
        }
    }
}

late_update(state: ptr, e: *Engine, delta: float) {
    s = state as *Fixture
    if s.scene_written == false {
        // The world as the program built it, written the way AE3D_SCENE_OUT
        // writes any program's.
        fs.fs_mkdir_p_raw("build/physics_scene/")
        s.scene_written = engine.engine_save_scene(e, "build/physics_scene/scene.json", "build/physics_scene/")
        check_true("the world was written as a scene", s.scene_written)
    }
    crate = s.crate as *GameObject
    rb = physics.rigidbody_of(crate)
    body = dynamics.body_get_position(physics.rigidbody_body(rb))
    object = behaviour.object_position(crate)
    if core.abs_of(body.y - object.y) > 0.000001 { s.crate_body_matched = false }
}

// The scene written on the first frame reads back with a physics record
// on the crate, and one on every object that had a body.
check_scene_file(crate: *GameObject) {
    loaded = scene.scene_load("build/physics_scene/scene.json")
    check_true("the written scene loads", loaded != null)
    if loaded == null { return }
    back = scene.scene_load_attachments("build/physics_scene/scene.json", loaded)
    check_true("the written scene carries attachments", back != null)
    recorded = 0
    crate_recorded = false
    bones_written = 0
    grouped_parented = false
    i = 0
    while i < list.size(loaded) {
        m = list.get_raw(loaded, i) as *Model
        if string.contains(core.text(m.name), "/") == 1 { bones_written = bones_written + 1 }
        if string.equals(core.text(m.name), "Grouped crate") == 1 {
            parent = core.model_parent(m)
            grouped_parented = parent != null && string.equals(core.text(parent.name), "Far group") == 1
        }
        i = i + 1
    }
    if back != null {
        n = list.size(back)
        i = 0
        while i < n {
            a = list.get_raw(back, i) as *Attachment
            spec = scene.attachment_physics(a)
            if spec != null {
                recorded = recorded + 1
                m = scene.attachment_model(a)
                if string.equals(core.text(m.name), "Crate") == 1 {
                    crate_recorded = spec.body == "dynamic" && spec.collider == "box" && core.abs_of(spec.friction - 0.6) < 0.0001
                }
            }
            i = i + 1
        }
        scene.attachments_free(back)
    }
    // The ground, three crates, the far slab, the lift, its rider, the
    // target, the ball, the hull crate, the car and its four wheels:
    // fifteen bodies with colliders on a model of their own. A ragdoll's
    // bones are the ragdoll's, internal, and not in the file at all.
    check_true("every body on a model was recorded (${recorded})", recorded == 15)
    check_true("no ragdoll bone was written", bones_written == 0)
    check_true("the grouped crate's entry names its group as its parent", grouped_parented)
    check_true("the crate's record is its body and collider", crate_recorded)
    scene.scene_free(loaded)
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 320, 240)
    engine.engine_set_title(e, "ae3d physics test")
    engine.engine_set_camera_input(e, false)
    // The fixed step is a sixtieth; the frames run as fast as they can and the
    // world takes as many steps as their time covers, and stops the run at
    // STEPS of them. The frame limit is a backstop for a frame that never
    // covers a step.
    engine.engine_set_fixed_step(e, 1.0 / 60.0)
    engine.engine_set_frame_limit(e, 100000)
    light = core.light_sun(core.vec3(0.3, 0.8, 0.5))
    engine.engine_set_light(e, light)
    scene = Fixture { crate: null, lift: null, rider: null, target: null, ball: null, ragdoll: null, stander: null, hull_crate: null, victim: null, rig: null, victim_start_z: 0.0, victim_walked_z: 0.0,
                      vehicle: null, car: null, car_start_x: 0.0, head_start_y: 0.0, steps: 0, fired: false, hits: 0, crate_body_matched: false, spec_crate: null, grouped: null, scene_written: false }
    b = engine.behaviour_new("scene", (&scene) as ptr)
    b.start = start
    b.fixed_update = fixed_update
    b.late_update = late_update
    engine.engine_add_behaviour(e, b)

    if !engine.engine_run(e) {
        println("physics: SKIP no window available")
        core.light_free(light)
        engine.engine_free(e)
        rig_free(scene.rig as *Skeleton)
        return
    }

    p = physics.of(e)
    check_true("the physics is the engine's", p != null)
    check_true("the world stepped as often as the fixed step ran (${physics.physics_step_count(p)}, ${scene.steps})", physics.physics_step_count(p) == scene.steps && scene.steps == STEPS)
    crate_y = behaviour.object_position(scene.crate as *GameObject).y
    check_near("the crate fell onto the slab and rests on it", crate_y, 0.5, 0.02)
    check_true("the crate's object followed its body every frame", scene.crate_body_matched)
    check_true("the crate is asleep at rest", physics.rigidbody_is_awake(physics.rigidbody_of(scene.crate as *GameObject)) == false)
    grouped_world = behaviour.object_world_position(scene.grouped as *GameObject)
    grouped_local = behaviour.object_position(scene.grouped as *GameObject)
    check_near("the grouped crate fell where the group is, in the world", grouped_world.x, 100.0, 0.02)
    check_near("and rests on the far slab", grouped_world.y, 0.5, 0.02)
    check_near("its object is still the group's child, at a local place", grouped_local.x, 0.0, 0.02)
    spec_crate_y = behaviour.object_position(scene.spec_crate as *GameObject).y
    check_near("the crate made from a scene record fell and rests like it", spec_crate_y, 0.5, 0.02)
    crate_spec = physics.spec_of(scene.crate as *GameObject)
    check_true("a body answers its scene record", crate_spec != null)
    if crate_spec != null {
        check_true("the record's body kind is the body's", crate_spec.body == "dynamic")
        check_true("the record's collider is the one put on it", crate_spec.collider == "box")
        check_near("the record's friction is the material's", crate_spec.friction, 0.6, 0.0001)
        heap.free(crate_spec)
    }
    hull_spec = physics.spec_of(scene.hull_crate as *GameObject)
    check_true("a hull collider is recorded as one", hull_spec != null && hull_spec.collider == "hull")
    if hull_spec != null { heap.free(hull_spec) }
    check_scene_file(scene.crate as *GameObject)
    lift_y = behaviour.object_position(scene.lift as *GameObject).y
    rider_y = behaviour.object_position(scene.rider as *GameObject).y
    check_true("the kinematic lift rose (${lift_y})", lift_y > 1.4)
    check_near("the rider rode the lift", rider_y - lift_y, 1.0, 0.05)
    target_z = behaviour.object_position(scene.target as *GameObject).z
    check_true("the ball knocked the target crate along (${target_z})", target_z > 0.5)
    head_y = behaviour.object_position(physics.ragdoll_bone(scene.ragdoll as *Ragdoll, 3)).y
    check_true("the ragdoll fell (${scene.head_start_y} -> ${head_y})", head_y < scene.head_start_y - 1.0 && head_y > 0.0)
    stander_head_y = behaviour.object_position(physics.ragdoll_bone(scene.stander as *Ragdoll, 3)).y
    check_true("the sprung ragdoll is still standing after four seconds (${stander_head_y})", stander_head_y > 1.2 && physics.ragdoll_is_standing(scene.stander as *Ragdoll))
    hull_crate_y = behaviour.object_position(scene.hull_crate as *GameObject).y
    check_near("the crate collided as its own scaled hull rests on its half height", hull_crate_y, 0.3, 0.03)
    car_z = behaviour.object_position(scene.car as *GameObject).z
    check_true("the car drove forward on its wheel joints (${car_z})", car_z < 20.0 - 4.0)
    car_x = behaviour.object_position(scene.car as *GameObject).x
    check_true("and straight (${car_x})", core.abs_of(car_x) < 1.0)
    check_true("the car's hits were reported and the figure in its way let go (${scene.hits})", scene.hits >= 1)
    rig = scene.rig as *Skeleton
    victim = scene.victim as *Ragdoll
    hips = skin.skeleton_bone(rig, skin.skeleton_find(rig, "Hips"))
    pelvis = behaviour.object_position(physics.ragdoll_bone(victim, 0))
    check_true("following its rig, the figure walked with it (pelvis z ${scene.victim_start_z} -> ${scene.victim_walked_z} in fifty steps)",
               scene.victim_walked_z < scene.victim_start_z - 0.35 && scene.victim_walked_z > scene.victim_start_z - 0.65)
    check_true("struck, it stopped following", physics.ragdoll_is_following(victim) == false)
    check_near("struck, the rig's hips still ride the ragdoll's pelvis", core.v3_len(core.v3_sub(core.model_world_position(hips), pelvis)), 0.0, 0.02)
    head = skin.skeleton_bone(rig, skin.skeleton_find(rig, "Head"))
    neck = behaviour.object_position(physics.ragdoll_bone(victim, 3))
    // Where the head is after the strike depends on how many steps the
    // frames covered on this machine; that it is where the ragdoll's neck
    // is does not.
    check_true("and its head is with the ragdoll's neck (${core.model_world_position(head).y} against the neck body at ${neck.y})",
               core.abs_of(core.model_world_position(head).y - neck.y) < 0.45)
    physics.vehicle_free(scene.vehicle as *Vehicle)

    bodies_before = physics.physics_body_count(p)
    // The stander's twelve anchors stand with it; the victim's went with its release.
    check_true("the bodies are counted (${bodies_before})", bodies_before == 9 + 12 + 24 + 1 + 5 + 12)
    physics.physics_free(p)
    check_true("freed: no physics on the engine", physics.of(e) == null)
    check_true("freed: the objects are still the scene's", behaviour.scene_find(engine.engine_scene(e), "Crate") == scene.crate as *GameObject)
    check_true("freed: the objects have no Rigidbody left on them", physics.rigidbody_of(scene.crate as *GameObject) == null)

    core.light_free(light)
    engine.engine_free(e)
    rig_free(scene.rig as *Skeleton)
    if failures == 0 {
        println("physics: all checks passed (${scene.steps} fixed steps)")
    } else {
        println("physics: ${failures} failure(s)")
    }
}
