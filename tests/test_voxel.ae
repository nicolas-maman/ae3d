// Voxel storage, palette and the exposed-face rule that decides what is drawn.

import ae3d.core
import ae3d.voxel
import ae3d.loader

var failures = 0

record_failure(reason: string) {
    println("FAIL ${reason}")
    failures = failures + 1
}

check_int(name: string, got: int, want: int) {
    if got != want { record_failure("${name}: got ${got} want ${want}") }
}

check_true(name: string, condition: bool) {
    if !condition { record_failure(name) }
}

fill_solid(w: *VoxelWorld, size: int) {
    x = 0
    while x < size {
        y = 0
        while y < size {
            z = 0
            while z < size {
                voxel.world_set(w, x, y, z, voxel.STONE)
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
}

test_storage() {
    w = voxel.world_new(4, 4, 4, 1.0)
    check_true("world allocated", w != null)

    check_int("starts empty", voxel.world_active_count(w), 0)
    check_true("empty is not solid", !voxel.world_solid(w, 1, 1, 1))

    voxel.world_set(w, 1, 2, 3, voxel.GRASS)
    check_int("one active", voxel.world_active_count(w), 1)
    check_int("reads back", voxel.world_get(w, 1, 2, 3), voxel.GRASS)
    check_true("is solid", voxel.world_solid(w, 1, 2, 3))

    // Setting the same value again must not double-count.
    voxel.world_set(w, 1, 2, 3, voxel.GRASS)
    check_int("idempotent set", voxel.world_active_count(w), 1)

    voxel.world_set(w, 1, 2, 3, voxel.DIRT)
    check_int("replace keeps count", voxel.world_active_count(w), 1)
    check_int("replaced value", voxel.world_get(w, 1, 2, 3), voxel.DIRT)

    voxel.world_set(w, 1, 2, 3, voxel.EMPTY)
    check_int("clearing decrements", voxel.world_active_count(w), 0)

    // Out of bounds is ignored on write and empty on read.
    voxel.world_set(w, 0 - 1, 0, 0, voxel.STONE)
    voxel.world_set(w, 99, 0, 0, voxel.STONE)
    voxel.world_set(w, 0, 99, 0, voxel.STONE)
    check_int("out of bounds ignored", voxel.world_active_count(w), 0)
    check_int("out of bounds reads empty", voxel.world_get(w, 0 - 5, 0, 0), voxel.EMPTY)
    check_true("bounds check", !voxel.world_in_bounds(w, 4, 0, 0))
    check_true("in bounds", voxel.world_in_bounds(w, 3, 3, 3))

    voxel.world_fill_column(w, 2, 2, 3, voxel.SAND)
    check_int("column filled", voxel.world_active_count(w), 3)
    check_int("column top", voxel.world_get(w, 2, 2, 2), voxel.SAND)
    check_true("column stops", !voxel.world_solid(w, 2, 3, 2))

    voxel.world_clear(w)
    check_int("cleared", voxel.world_active_count(w), 0)
    check_true("cleared cells", !voxel.world_solid(w, 2, 0, 2))

    voxel.world_free(w)
}

test_visibility() {
    // A solid 3x3x3 block hides exactly its centre voxel.
    w = voxel.world_new(3, 3, 3, 1.0)
    fill_solid(w, 3)
    check_int("solid block active", voxel.world_active_count(w), 27)
    check_int("centre hidden", voxel.world_visible_count(w), 26)
    voxel.world_free(w)

    // A 5x5x5 block hides its inner 3x3x3.
    big = voxel.world_new(5, 5, 5, 1.0)
    fill_solid(big, 5)
    check_int("large block active", voxel.world_active_count(big), 125)
    check_int("interior hidden", voxel.world_visible_count(big), 125 - 27)
    voxel.world_free(big)

    // A single voxel is entirely exposed.
    one = voxel.world_new(3, 3, 3, 1.0)
    voxel.world_set(one, 1, 1, 1, voxel.STONE)
    check_int("lone voxel visible", voxel.world_visible_count(one), 1)
    voxel.world_free(one)
}

test_build() {
    w = voxel.world_new(3, 3, 3, 2.0)
    fill_solid(w, 3)

    base = loader.cube(2.0)
    model = voxel.world_build(w, base)
    check_true("model built", model != null)
    check_int("instances match visible", core.model_instance_count(model), 26)
    check_true("model is instanced", model.is_instanced)

    core.model_free(model)
    voxel.world_free(w)
}

test_palette() {
    w = voxel.world_new(2, 2, 2, 1.0)

    grass = voxel.palette_color(w, voxel.GRASS)
    check_true("default grass is green", grass.y > grass.x && grass.y > grass.z)

    voxel.palette_set(w, voxel.GRASS, 1.0, 0.0, 0.0)
    overridden = voxel.palette_color(w, voxel.GRASS)
    check_true("override applied", overridden.x == 1.0 && overridden.y == 0.0)

    voxel.palette_set(w, voxel.GRASS, 0.0, 0.0, 1.0)
    replaced = voxel.palette_color(w, voxel.GRASS)
    check_true("override replaced in place", replaced.z == 1.0)

    voxel.palette_reset(w)
    restored = voxel.palette_color(w, voxel.GRASS)
    check_true("reset restores the default", restored.y > restored.x)

    unknown = voxel.palette_color(w, 999)
    check_true("unknown id is grey", unknown.x == unknown.y && unknown.y == unknown.z)

    voxel.world_free(w)
}

// A sphere is the cleanest thing to check a surface mesher against: every
// vertex it produces should land on the sphere it was given.
test_surface_nets() {
    size = 24
    radius = 8.0
    centre = 11.5

    w = voxel.world_new(size, size, size, 1.0)
    check_true("sdf enabled", voxel.world_sdf_enable(w))

    x = 0
    while x < size {
        y = 0
        while y < size {
            z = 0
            while z < size {
                offset = core.vec3((x * 1.0) - centre, (y * 1.0) - centre, (z * 1.0) - centre)
                voxel.world_sdf_set(w, x, y, z, core.v3_len(offset) - radius)
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }

    m = voxel.world_build_surface(w)
    check_true("surface built", m != null)
    if m == null { voxel.world_free(w) ; return }

    vertices = core.mesh_vertex_count(m.mesh)
    indices = core.mesh_index_count(m.mesh)
    check_true("surface has geometry", vertices > 200 && indices > 600)
    check_true("surface is triangulated", indices % 3 == 0)

    // Every normal has to point out of the solid, and a sphere is the one shape
    // where that is unambiguous: away from the centre. The builder negated the
    // field's gradient, so every surface it made faced into the ground and was
    // lit by nothing but ambient. Nothing caught it because a normal that is
    // exactly backwards still produces geometry, still triangulates, and still
    // renders: it renders dark.
    inward = 0
    i = 0
    while i < vertices {
        position = core.mesh_position(m.mesh, i)
        normal = core.mesh_normal(m.mesh, i)
        outward = core.vec3(position.x - centre, position.y - centre, position.z - centre)
        if core.v3_dot(normal, outward) <= 0.0 { inward = inward + 1 }
        i = i + 1
    }
    check_int("every surface normal points out of the solid", inward, 0)

    // Cells are offset half a step from the samples they interpolate.
    cell_centre = centre - 0.5
    worst = 0.0
    i = 0
    while i < vertices {
        p = core.mesh_position(m.mesh, i)
        offset = core.vec3(p.x - cell_centre, p.y - cell_centre, p.z - cell_centre)
        error = core.abs_of(core.v3_len(offset) - radius)
        if error > worst { worst = error }
        i = i + 1
    }
    check_true("vertices lie on the sphere", worst < 1.0)

    bad = 0
    i = 0
    while i < indices {
        index = core.mesh_index_at(m.mesh, i)
        if index < 0 || index >= vertices { bad = bad + 1 }
        i = i + 1
    }
    check_true("surface indices in range", bad == 0)

    // Normals point outward, away from the centre.
    inward = 0
    i = 0
    while i < indices {
        a = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i))
        b = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i + 1))
        c = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i + 2))
        face = core.v3_cross(core.v3_sub(b, a), core.v3_sub(c, a))
        middle = core.v3_mul(core.v3_add(core.v3_add(a, b), c), 1.0 / 3.0)
        outward = core.vec3(middle.x - cell_centre, middle.y - cell_centre, middle.z - cell_centre)
        if core.v3_dot(face, outward) < 0.0 { inward = inward + 1 }
        i = i + 3
    }
    check_true("faces wind outward", inward * 20 < indices / 3)

    println("  surface nets: ${vertices} vertices, ${indices / 3} triangles, worst radial error ${worst}")

    core.model_free(m)
    voxel.world_free(w)
}

// The voxel-derived field smooths a blocky world rather than reproducing it.
test_surface_from_voxels() {
    w = voxel.world_new(12, 12, 12, 1.0)
    fill_solid(w, 8)
    check_true("field derived", voxel.world_sdf_from_voxels(w))
    check_true("solid reads inside", voxel.world_sdf_get(w, 2, 2, 2) < 0.0)
    check_true("empty reads outside", voxel.world_sdf_get(w, 10, 10, 10) > 0.0)

    m = voxel.world_build_surface(w)
    check_true("blocky surface built", m != null)
    if m != null {
        check_true("blocky surface has geometry", core.mesh_vertex_count(m.mesh) > 0)
        core.model_free(m)
    }
    voxel.world_free(w)
}

extern ae3d_mesh_occlusion(mesh: ptr, index: int) -> float
extern ae3d_image_load(path: string) -> ptr
extern ae3d_image_free(img: ptr)
extern ae3d_image_pixels(img: ptr) -> ptr
extern ae3d_image_width(img: ptr) -> int

channel(pixels: ptr, index: int) -> int {
    bytes = pixels as byte[]
    return (bytes[index] as int) & 255
}

// The face mesh: only the faces that show, wound outward, with the sky each
// corner sees baked in and the kinds told apart through the palette image.
test_face_mesh() {
    w = voxel.world_new(6, 6, 6, 2.0)
    if w == null { record_failure("face mesh world"); return }

    // Two voxels side by side on the floor: twelve faces less the two that
    // touch; the ground under the world counts as solid, so no undersides.
    voxel.world_set(w, 1, 0, 1, voxel.GRASS)
    voxel.world_set(w, 2, 0, 1, voxel.SAND)
    m = voxel.world_build_mesh(w)
    if m == null { record_failure("face mesh builds"); voxel.world_free(w); return }
    check_int("two voxels show eight faces", core.mesh_index_count(m.mesh) / 6, 8)
    check_int("four corners a face", core.mesh_vertex_count(m.mesh), 32)

    // Every triangle faces the way its vertices' normal says: the winding's
    // own normal agrees with the stored one.
    wrong = 0
    i = 0
    while i < core.mesh_index_count(m.mesh) {
        a = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i))
        b = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i + 1))
        c = core.mesh_position(m.mesh, core.mesh_index_at(m.mesh, i + 2))
        wound = core.v3_cross(core.v3_sub(b, a), core.v3_sub(c, a))
        stored = core.mesh_normal(m.mesh, core.mesh_index_at(m.mesh, i))
        if core.v3_dot(wound, stored) <= 0.0 { wrong = wrong + 1 }
        i = i + 3
    }
    check_int("every triangle winds outward", wrong, 0)

    // Out in the open every corner sees the whole sky, except where a side
    // face meets the ground the world stands on: the two top faces' eight
    // corners and the six sides' twelve upper corners are open, the twelve
    // lower ones have the ground beside them.
    open_corners = 0
    v = 0
    while v < core.mesh_vertex_count(m.mesh) {
        if ae3d_mesh_occlusion(m.mesh, v) > 0.99 { open_corners = open_corners + 1 }
        v = v + 1
    }
    check_int("corners in the open see the sky", open_corners, 20)
    core.model_free(m)

    // A voxel on a floor of others: the corners of its side faces that meet
    // the floor are crowded by it and darker than the ones at its top.
    voxel.world_clear(w)
    x = 0
    while x < 6 {
        z = 0
        while z < 6 {
            voxel.world_set(w, x, 0, z, voxel.DIRT)
            z = z + 1
        }
        x = x + 1
    }
    voxel.world_set(w, 3, 1, 3, voxel.STONE)
    m = voxel.world_build_mesh(w)
    if m == null { record_failure("stone on a floor builds"); voxel.world_free(w); return }
    low = 1.0
    high = 0.0
    v = 0
    while v < core.mesh_vertex_count(m.mesh) {
        seen = ae3d_mesh_occlusion(m.mesh, v)
        if seen < low { low = seen }
        if seen > high { high = seen }
        v = v + 1
    }
    check_true("a corner against the floor is darker (${low})", low < 0.9)
    check_true("a corner in the open is lit (${high})", high > 0.99)

    // The palette is an image the model is textured with, one column a kind,
    // and reads back as the world's colours.
    name = voxel.world_palette_texture(w)
    check_true("palette image registered", name != "")
    img = ae3d_image_load(name)
    if img == null {
        record_failure("palette image loads")
    } else {
        width = ae3d_image_width(img)
        cell = width / voxel.PALETTE_KINDS
        sand = voxel.palette_color(w, voxel.SAND)
        at = (voxel.SAND * cell + cell / 2) * 4
        px = ae3d_image_pixels(img)
        red_ok = channel(px, at) == ((sand.x * 255.0 + 0.5) as int)
        blue_ok = channel(px, at + 2) == ((sand.z * 255.0 + 0.5) as int)
        check_true("sand column is the sand colour", red_ok && blue_ok)
        ae3d_image_free(img)
    }
    core.model_free(m)
    voxel.world_free(w)
}

// A column's height, read and set: what the sculpting brush works in. Raised,
// the new cells take the kind that was the top, so grass stays grass; lowered,
// the cells above are cleared and what was buried is the top.
test_columns() {
    w = voxel.world_new(4, 4, 12, 1.0)
    if w == null { record_failure("no world for the columns"); return }
    check_int("an empty column is nought tall", voxel.world_column_height(w, 1, 1), 0)
    voxel.world_fill_column(w, 1, 1, 3, voxel.DIRT)
    voxel.world_set(w, 1, 2, 1, voxel.GRASS)
    check_int("a column is one past its top", voxel.world_column_height(w, 1, 1), 3)
    voxel.world_set_column_height(w, 1, 1, 6)
    check_int("raised to six", voxel.world_column_height(w, 1, 1), 6)
    check_int("the new top is what the old top was", voxel.world_get(w, 1, 5, 1), voxel.GRASS)
    check_int("and the cells between too", voxel.world_get(w, 1, 3, 1), voxel.GRASS)
    voxel.world_set_column_height(w, 1, 1, 2)
    check_int("lowered to two", voxel.world_column_height(w, 1, 1), 2)
    check_int("what was buried is the top", voxel.world_get(w, 1, 1, 1), voxel.DIRT)
    check_int("above it is air", voxel.world_get(w, 1, 2, 1), voxel.EMPTY)
    voxel.world_set_column_height(w, 2, 2, 2)
    check_int("an empty column grows as dirt", voxel.world_get(w, 2, 1, 2), voxel.DIRT)
    voxel.world_set_column_height(w, 1, 1, 40)
    check_int("clamped to the world's height", voxel.world_column_height(w, 1, 1), 12)
    voxel.world_set_column_height(w, 9, 9, 3)
    check_int("out of bounds is left alone", voxel.world_column_height(w, 9, 9), 0)
    voxel.world_free(w)
}

main() {
    test_face_mesh()
    test_columns()
    test_storage()
    test_visibility()
    test_build()
    test_palette()
    test_surface_nets()
    test_surface_from_voxels()

    if failures == 0 {
        println("voxel: all checks passed")
    } else {
        println("voxel: ${failures} failure(s)")
    }
}
