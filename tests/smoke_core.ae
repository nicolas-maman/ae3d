import ae3d.shaders
import ae3d.core

main() {
    m = core.model_new()
    core.model_set_position(m, 1.0, 2.0, 3.0)
    core.model_set_diffuse(m, 0.5, 0.6, 0.7)
    c = core.camera_new(1200, 800)
    l = core.light_sun(core.vec3(0.3, 0.8, 0.5))
    s = shaders.default_shader()
    f = core.camera_frustum(c)
    hit = core.frustum_intersects_sphere(&f, core.vec3(0.0, 0.0, 0.0), 1.0)
    println("model=${m.id} aspect=${c.aspect} light=${l.temperature} shader_ok=${s.vertex_source != ""} inview=${hit}")
    core.model_free(m)
    core.light_free(l)
    core.camera_free(c)
}
