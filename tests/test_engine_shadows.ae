// Shadows asked for through the engine surface have to reach the frame.
//
// ae3d#231: every shadow the engine could draw was drawn by something else.
// The renderers build their map inside the "turn shadows on" setter, and the
// engine never called it, so a program written against ae3d.engine rendered
// shadowless whatever it asked for -- the editor and the backend suites call
// the backend directly and never noticed. Rendering the same scene twice
// through the engine and comparing the two frames is the only thing that would
// have caught it: with no shadow map the two are identical.
//
// The sun is off to one side, so the shadow lands on one half of the frame and
// the other half is the control. A global dim would move both.

import std.mem
import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import ae3d.loader

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern ae3d_capture_frame(width: int, height: int) -> int
extern ae3d_capture_region(x: int, y: int, width: int, height: int,
                           background: int, tolerance: int, out: ptr) -> int
extern ae3d_capture_slot(block: ptr, index: int) -> float

const WIDTH = 480
const HEIGHT = 360

var g_checks = 0
var g_failures = 0

var g_ground: ptr = null
var g_blocker: ptr = null

var g_default_on = false
var g_reported_off = true
var g_measured = 0

// Mean brightness of the two halves, with shadows on and then off.
var g_shadowed_left = 0.0
var g_shadowed_right = 0.0
var g_lit_left = 0.0
var g_lit_right = 0.0
// The next frame, shadows still off: how far the frame moves by itself.
var g_again_left = 0.0
var g_again_right = 0.0

check(name: string, condition: bool) {
    g_checks = g_checks + 1
    if condition {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        g_failures = g_failures + 1
    }
}

half_brightness(block: ptr, x: int) -> float {
    if ae3d_capture_region(x, 0, WIDTH / 2, HEIGHT, 0, 0, block) == 0 { return 0.0 }
    return (ae3d_capture_slot(block, 0) +
            ae3d_capture_slot(block, 1) +
            ae3d_capture_slot(block, 2)) / 3.0
}

on_start(state: ptr, e: *Engine) {

    ground = loader.plane(24, 16.0)
    core.model_set_position(ground, 0.0 - 192.0, 0.0, 0.0 - 192.0)
    core.model_matte(ground, 0.85, 0.85, 0.85)
    engine.engine_add_model(e, ground)
    g_ground = ground as ptr

    blocker = loader.sphere(1.0, 32, 24)
    core.model_set_scale(blocker, 30.0, 30.0, 30.0)
    core.model_set_position(blocker, 0.0, 130.0, 0.0)
    core.model_matte(blocker, 0.8, 0.3, 0.2)
    engine.engine_add_model(e, blocker)
    g_blocker = blocker as ptr

    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0, 150.0, 260.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))

    // Before anything was rendered, and without the program having asked: an
    // engine lights its scenes with shadows unless told otherwise.
    g_default_on = engine.engine_shadows(e)
}

on_render(state: ptr, e: *Engine, delta: float) {
    frame = engine.engine_frame_count(e)

    // Past the first frames, whose picture is still settling (#394: on
    // llvmpipe the whole frame came out 0.06 brighter at frame 2 than at
    // frame 4, both halves, and a test comparing the two frames' halves
    // read that as the shadow going the wrong way).
    if frame != 4 && frame != 8 && frame != 9 { return }
    if ae3d_capture_frame(WIDTH, HEIGHT) == 0 { return }

    block = calloc(8, 8)
    if frame == 4 {
        g_shadowed_left = half_brightness(block, 0)
        g_shadowed_right = half_brightness(block, WIDTH / 2)
        engine.engine_set_shadows(e, false)
        g_reported_off = engine.engine_shadows(e)
    } else if frame == 8 {
        g_lit_left = half_brightness(block, 0)
        g_lit_right = half_brightness(block, WIDTH / 2)
    } else {
        g_again_left = half_brightness(block, 0)
        g_again_right = half_brightness(block, WIDTH / 2)
    }
    g_measured = g_measured + 1
    free(block)
}

main() {
    // An OpenGL test by design: it reads the frame through ae3d_capture_frame.
    e = engine.engine_new_with(platform.API_GL)
    engine.engine_set_size(e, WIDTH, HEIGHT)
    engine.engine_set_title(e, "ae3d engine shadows test")
    engine.engine_set_frame_limit(e, 10)
    engine.engine_set_camera_input(e, false)
    engine.engine_set_vsync(e, 0)

    // Off to the right and low, so what it casts lands to the left of the
    // blocker rather than under it.
    light = core.light_sun(core.vec3(1.0, 0.85, 0.0))
    light.ambient_strength = 0.35
    engine.engine_set_light(e, light)

    program = engine.behaviour_new("shadows test", null)
    program.start = on_start
    program.late_update = on_render
    engine.engine_add_behaviour(e, program)

    if !engine.engine_run(e) {
        println("engine shadows: SKIP no window")
        core.light_free(light)
        engine.engine_free(e)
        return
    }

    if g_measured < 3 {
        println("engine shadows: SKIP no readable frames")
        core.light_free(light)
        engine.engine_free(e)
        return
    }

    check("shadows are on by default", g_default_on)
    check("turning them off is reported", !g_reported_off)

    // The shadow falls on the left half. What it does is how much the left
    // half gains on the right when shadows go off: anything that moves the
    // whole frame -- a first frame still settling, a driver's own drift --
    // moves both halves alike and cancels out of it.
    shadow_effect = (g_lit_left - g_lit_right) - (g_shadowed_left - g_shadowed_right)
    // And how far the frame moves by itself, two frames in a row with
    // nothing changed between them.
    drift = (g_again_left - g_again_right) - (g_lit_left - g_lit_right)
    if drift < 0.0 { drift = 0.0 - drift }

    println("  left half ${g_shadowed_left} shadowed vs ${g_lit_left} lit, right half ${g_shadowed_right} vs ${g_lit_right}; effect ${shadow_effect}, drift ${drift}")

    // A shadow takes the sun's light and leaves the sky's fill, so the half
    // it falls on darkens by the sun's share of a few pixels, not by a
    // third of everything.
    check("the engine's frame darkens where the shadow falls", shadow_effect > 0.002)
    check("by more than the frame moves by itself", shadow_effect > drift * 3.0)

    core.light_free(light)
    engine.engine_free(e)
    if g_ground != null { core.model_free(g_ground as *Model) }
    if g_blocker != null { core.model_free(g_blocker as *Model) }

    if g_failures == 0 {
        println("engine shadows: all checks passed (${g_checks})")
    } else {
        println("engine shadows: ${g_failures} of ${g_checks} checks failed")
    }
}
