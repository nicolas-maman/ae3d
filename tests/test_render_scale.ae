// Drawing the scene smaller than the window it lands on.
//
// Cost per frame is dominated by pixels shaded, so rendering the scene at half
// the window and letting the composite upscale it is a quarter of the work. It
// is what a weak GPU needs to run a scene a strong one runs comfortably, and it
// is worth exactly nothing if it quietly changes what the frame contains.
//
// So the checks are: the frame that comes out is still the full size, still has
// the same picture in it, and a scale of 1 is genuinely a no-op rather than
// approximately one.

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vk
import ae3d.offscreen
import ae3d.loader

const WIDTH = 256
const HEIGHT = 192

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

frame_total(pixels: ptr) -> int {
    total = 0
    i = 0
    while i < WIDTH * HEIGHT {
        index = i * 4
        total = total + mem.get_byte(pixels, index) +
                mem.get_byte(pixels, index + 1) +
                mem.get_byte(pixels, index + 2)
        i = i + 1
    }
    return total
}

// How far the lit part of the frame reaches. A composite that failed to upscale
// would leave the scene in one corner, which the totals alone would not catch.
lit_extent(pixels: ptr) -> int {
    right = 0
    x = 0
    while x < WIDTH {
        y = 0
        while y < HEIGHT {
            index = (y * WIDTH + x) * 4
            level = mem.get_byte(pixels, index) + mem.get_byte(pixels, index + 1) +
                    mem.get_byte(pixels, index + 2)
            if level > 40 && x > right { right = x }
            y = y + 1
        }
        x = x + 1
    }
    return right
}

main() {
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("render_scale: SKIP no OpenGL context")
        return
    }

    renderer = gl.renderer_new()
    backend = gl.backend(renderer)
    if !core.backend_init(&backend, context, WIDTH, HEIGHT) {
        println("render_scale: SKIP the OpenGL backend would not initialise")
        return
    }

    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    gl.renderer_set_clear_color(renderer, 0.0, 0.0, 0.0)

    ball = loader.sphere(1.0, 32, 24)
    core.model_set_scale(ball, 40.0, 40.0, 40.0)
    core.model_matte(ball, 0.9, 0.85, 0.8)
    core.backend_add_model(&backend, ball)

    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 130.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))

    key = core.light_directional(core.vec3(0.0, 0.0, 0.0 - 1.0),
                                 core.vec3(1.0, 1.0, 1.0), 2.5)
    key.ambient_strength = 0.3
    gl.renderer_add_light(renderer, key)

    check("a fresh renderer draws at full size", gl.renderer_render_scale(renderer) == 1.0)

    core.backend_render(&backend, cam, key)
    pixels = offscreen.target_pixels(target)
    if pixels == null { println("render_scale: SKIP no pixels") ; return }
    full = frame_total(pixels)
    full_reach = lit_extent(pixels)

    // A scale of 1 has to be the same frame, not nearly the same one: it is the
    // path every existing scene takes, and this feature is not allowed to cost
    // them anything.
    gl.renderer_set_render_scale(renderer, 1.0)
    core.backend_render(&backend, cam, key)
    again = frame_total(offscreen.target_pixels(target))
    check("a scale of 1 leaves the frame exactly alone", again == full)

    gl.renderer_set_render_scale(renderer, 0.5)
    check("the scale that was asked for is the scale that is kept",
          gl.renderer_render_scale(renderer) == 0.5)
    core.backend_render(&backend, cam, key)
    half_pixels = offscreen.target_pixels(target)
    half = frame_total(half_pixels)
    half_reach = lit_extent(half_pixels)

    check("half scale still draws something", half > full / 4)

    // The scene is sampled more coarsely, so the frame is not identical. It is
    // the same picture: the same light over the same area, within the error a
    // half-resolution sample of a curved edge makes.
    drift = half - full
    if drift < 0 { drift = 0 - drift }
    check("half scale is the same picture, not a different one", drift < full / 10)

    // The composite has to put it back over the whole frame. If it did not, the
    // scene would sit in a corner at half size and the totals above would still
    // look plausible.
    spread = half_reach - full_reach
    if spread < 0 { spread = 0 - spread }
    check("half scale is upscaled to fill the frame", spread <= 3)

    println("  full ${full} reaching ${full_reach}px, half ${half} reaching ${half_reach}px")

    // Out of range is clamped rather than obeyed: a scale of zero is a divide by
    // zero waiting to happen and a scale above 1 is a request to render more
    // pixels than the window has, which is not what this is for.
    gl.renderer_set_render_scale(renderer, 0.0)
    check("a scale below the floor is clamped", gl.renderer_render_scale(renderer) == 0.25)
    gl.renderer_set_render_scale(renderer, 4.0)
    check("a scale above 1 is clamped", gl.renderer_render_scale(renderer) == 1.0)

    // Through the vtable, which is how a scene that does not know its renderer
    // reaches this. The answer is the scale adopted rather than the one asked
    // for: a backend that cannot draw smaller than its window answers 1.0, and
    // a caller stepping down a quality ladder needs to be able to tell a rung
    // that helped from one that did nothing at all.
    adopted = core.backend_set_render_scale(&backend, 0.5)
    check("the backend reports the scale it adopted", adopted == 0.5)
    check("and the renderer agrees with what the backend reported",
          gl.renderer_render_scale(renderer) == adopted)

    impossible = core.backend_set_render_scale(&backend, 8.0)
    check("an impossible request comes back as what was really used",
          impossible == 1.0 && gl.renderer_render_scale(renderer) == 1.0)

    core.backend_cleanup(&backend)
    offscreen.target_destroy(target)
    offscreen.context_destroy(context)
    core.model_free(ball)
    gl.renderer_free(renderer)
    core.camera_free(cam)
    core.light_free(key)

    vulkan_checks()

    if failures == 0 {
        println("render_scale: all checks passed")
    } else {
        println("render_scale: ${failures} failure(s)")
    }
}

// The same on Vulkan: the scene drawn into targets of the scaled size and
// the composite putting it over the whole frame. Read back through the
// backend, the frame after the draw (the readback is a frame behind).
vk_frame(backend: *Backend, cam: *Camera, key: *Light) -> ptr {
    core.backend_render(backend, cam, key)
    core.backend_render(backend, cam, key)
    return core.backend_frame_pixels(backend)
}

vulkan_checks() {
    if !vk.available() {
        println("  vulkan: no driver (${vk.last_error()}), checked OpenGL only")
        return
    }
    renderer = vk.renderer_new()
    backend = vk.backend(renderer)
    if !core.backend_init(&backend, null, WIDTH, HEIGHT) {
        println("  vulkan: would not start (${vk.last_error()}), checked OpenGL only")
        vk.renderer_free(renderer)
        return
    }
    core.backend_set_clear_color(&backend, 0.0, 0.0, 0.0)
    ball = loader.sphere(1.0, 32, 24)
    core.model_set_scale(ball, 40.0, 40.0, 40.0)
    core.model_matte(ball, 0.9, 0.85, 0.8)
    core.backend_add_model(&backend, ball)
    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 130.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    key = core.light_directional(core.vec3(0.0, 0.0, 0.0 - 1.0), core.vec3(1.0, 1.0, 1.0), 2.5)
    key.ambient_strength = 0.3

    pixels = vk_frame(&backend, cam, key)
    if pixels == null { println("  vulkan: SKIP no pixels") ; return }
    full = frame_total(pixels)
    full_reach = lit_extent(pixels)

    adopted = core.backend_set_render_scale(&backend, 0.5)
    check("vulkan adopts half scale", adopted == 0.5)
    half_pixels = vk_frame(&backend, cam, key)
    half = frame_total(half_pixels)
    half_reach = lit_extent(half_pixels)
    check("vulkan half scale still draws something", half > full / 4)
    drift = half - full
    if drift < 0 { drift = 0 - drift }
    check("vulkan half scale is the same picture, not a different one", drift < full / 10)
    spread = half_reach - full_reach
    if spread < 0 { spread = 0 - spread }
    check("vulkan half scale is upscaled to fill the frame", spread <= 3)
    println("  vulkan full ${full} reaching ${full_reach}px, half ${half} reaching ${half_reach}px")

    back = core.backend_set_render_scale(&backend, 1.0)
    check("vulkan back to full", back == 1.0)
    again = frame_total(vk_frame(&backend, cam, key))
    drift = again - full
    if drift < 0 { drift = 0 - drift }
    check("vulkan back at full scale the frame is the first one again", drift < full / 100)
    clamped = core.backend_set_render_scale(&backend, 8.0)
    check("vulkan an impossible request comes back as what was really used", clamped == 1.0)

    core.backend_cleanup(&backend)
    core.model_free(ball)
    vk.renderer_free(renderer)
    core.camera_free(cam)
    core.light_free(key)
}
