// Temporal anti-aliasing: an edge supersampled over frames, and a picture
// that holds still.
//
// A thin bright bar, tilted so its edges cut across the pixel grid, over a
// black scene, on both backends. Drawn plain, an edge is a staircase of steps
// between black and white with a few in-between pixels from the
// multisampling. Drawn with the temporal pass for a dozen frames -- the
// projection nudged a fraction of a pixel a frame and each frame folded
// into the history -- the same edge is graded finer: more in-between
// pixels, the same amount of light overall (the pass moves nothing, it
// only averages), and a frame the same as the one before it once the
// history has filled. Off again, the plain picture comes back.

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.loader

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern memcpy(dst: ptr, src: ptr, bytes: int) -> ptr

const WIDTH = 320
const HEIGHT = 240

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

// The frame just drawn, copied out: the target hands back one buffer.
frame(backend: *Backend, cam: *Camera, light: *Light) -> ptr {
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    pixels = core.backend_frame_pixels(backend)
    kept = calloc(WIDTH * HEIGHT, 4)
    memcpy(kept, pixels, WIDTH * HEIGHT * 4)
    return kept
}

luma(pixels: ptr, i: int) -> int {
    return mem.get_byte(pixels, i * 4) + mem.get_byte(pixels, i * 4 + 1) + mem.get_byte(pixels, i * 4 + 2)
}

// How many pixels are neither the black nor the white: the edge's ramp.
between(pixels: ptr) -> int {
    count = 0
    i = 0
    while i < WIDTH * HEIGHT {
        l = luma(pixels, i)
        if l > 100 && l < 620 { count = count + 1 }
        i = i + 1
    }
    return count
}

total(pixels: ptr) -> int {
    sum = 0
    i = 0
    while i < WIDTH * HEIGHT {
        sum = sum + luma(pixels, i)
        i = i + 1
    }
    return sum
}

// The sum of every pixel's difference between two frames.
difference(a: ptr, b: ptr) -> int {
    sum = 0
    i = 0
    while i < WIDTH * HEIGHT * 4 {
        d = mem.get_byte(a, i) - mem.get_byte(b, i)
        if d < 0 { d = 0 - d }
        sum = sum + d
        i = i + 1
    }
    return sum
}

set_taa(gl_r: *GLRenderer, vk_r: *VKRenderer, on: bool) {
    if gl_r != null { gl.renderer_set_taa(gl_r, on) }
    if vk_r != null { vulkan.renderer_set_taa(vk_r, on) }
}

taa_on(gl_r: *GLRenderer, vk_r: *VKRenderer) -> bool {
    if gl_r != null { return gl.renderer_taa(gl_r) }
    return vulkan.renderer_taa(vk_r)
}

run_checks(backend: *Backend, name: string, gl_r: *GLRenderer, vk_r: *VKRenderer) {
    pass = backend
    core.backend_set_clear_color(pass, 0.0, 0.0, 0.0)

    // A long thin bar, tilted, glowing white on its own so no light shapes it.
    bar = loader.cube(1.0)
    core.model_set_scale(bar, 60.0, 0.5, 0.5)
    core.model_set_rotation(bar, core.quat_rotate(0.12, core.vec3(0.0, 0.0, 1.0)))
    core.model_set_position(bar, 0.0, 0.0, 0.0)
    core.model_set_diffuse(bar, 1.0, 1.0, 1.0)
    core.model_set_exposure(bar, 12.0)
    core.backend_add_model(pass, bar)

    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 40.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.0, 1.0, 0.0))

    plain = frame(pass, cam, light)
    plain_between = between(plain)
    plain_total = total(plain)
    check("${name} the plain bar has an edge", plain_between > 50 && plain_total > 100000)

    set_taa(gl_r, vk_r, true)
    check("${name} the temporal pass turns on", taa_on(gl_r, vk_r))
    i = 0
    settled = null
    last = null
    while i < 12 {
        if last != null { free(last) }
        last = settled
        settled = frame(pass, cam, light)
        i = i + 1
    }
    taa_between = between(settled)
    taa_total = total(settled)
    drift = difference(settled, last)
    println("  ${name}: in-between pixels ${plain_between} plain, ${taa_between} temporal; light ${plain_total} -> ${taa_total}; frame-to-frame ${drift}")
    // The multisampling already grades the edge over a pixel; the eight
    // nudges within a pixel grade it finer, and a little wider.
    check("${name} the edge is graded finer: more in-between pixels", taa_between > plain_between * 11 / 10)
    // Held on software Vulkan too. llvmpipe lost a tenth of the light here
    // (#334) while its multisampled pipelines were drawn in render passes
    // they were not compatible with, which a GPU forgave and it did not; with
    // the passes made compatible (#405) it keeps the light as a GPU does.
    check("${name} the same light overall: the pass averages, it does not move", taa_total > plain_total * 9 / 10 && taa_total < plain_total * 11 / 10)
    // Each frame folds a new nudge in, so the ramp breathes a little: under
    // a level a channel over the frame.
    check("${name} the picture holds still once the history has filled", drift < WIDTH * HEIGHT * 4)

    // A camera on the move: the history is found by reprojection, so a
    // pan leaves no trail. Panned a little a frame for a dozen frames, the
    // bar under the temporal pass carries the light a plain frame at the
    // same place carries, and no more in-between pixels than the still one.
    i = 0
    while i < 12 {
        core.camera_set_position(cam, core.vec3(0.03 * ((i + 1) as float), 0.0, 40.0))
        core.camera_look_at(cam, core.vec3(0.03 * ((i + 1) as float), 0.0, 0.0))
        if last != null { free(last) }
        last = settled
        settled = frame(pass, cam, light)
        i = i + 1
    }
    set_taa(gl_r, vk_r, false)
    core.backend_render(pass, cam, light)
    moved_plain = frame(pass, cam, light)
    println("  ${name}: on the move, in-between pixels ${between(settled)}; light ${total(moved_plain)} plain, ${total(settled)} temporal")
    check("${name} a panning camera leaves no trail", between(settled) < taa_between * 2 && total(settled) > total(moved_plain) * 9 / 10 && total(settled) < total(moved_plain) * 11 / 10)
    free(moved_plain)

    core.camera_set_position(cam, core.vec3(0.0, 0.0, 40.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    core.backend_render(pass, cam, light)
    back = frame(pass, cam, light)
    check("${name} off again, the plain picture comes back", difference(back, plain) < WIDTH * HEIGHT / 4)

    free(plain)
    free(settled)
    if last != null { free(last) }
    free(back)
    core.backend_remove_model(pass, bar)
    core.model_free(bar)
    core.camera_free(cam)
    core.light_free(light)
}

main() {
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("taa: SKIP no OpenGL context")
        return
    }
    renderer = gl.renderer_new()
    gl_pass = gl.backend(renderer)
    if !core.backend_init(&gl_pass, context, WIDTH, HEIGHT) {
        println("taa: SKIP the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    run_checks(&gl_pass, "opengl", renderer, null)
    core.backend_cleanup(&gl_pass)
    offscreen.target_destroy(target)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)

    if !vulkan.available() {
        println("taa: no Vulkan driver (${vulkan.last_error()}), checked OpenGL only")
    } else {
        vk_renderer = vulkan.renderer_new()
        vk_pass = vulkan.backend(vk_renderer)
        if !core.backend_init(&vk_pass, null, WIDTH, HEIGHT) {
            println("taa: SKIP Vulkan would not start (${vulkan.last_error()})")
        } else {
            run_checks(&vk_pass, "vulkan", null, vk_renderer)
            core.backend_cleanup(&vk_pass)
        }
        vulkan.renderer_free(vk_renderer)
    }

    if failures == 0 {
        println("taa: all checks passed")
    } else {
        println("taa: ${failures} failure(s)")
    }
}
