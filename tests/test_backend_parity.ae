// The two backends must draw the same scene the same way.
//
// Both render the same models, camera and light offscreen at the same size, and
// the frames are compared pixel by pixel across every feature the renderers
// share: PBR materials, textures, the skybox, and each post-processing pass.
// Anything that makes the Vulkan path a different renderer rather than the same
// one, a wrong uniform offset, a flipped clip axis, a material that does not
// reach the shader, an effect wired to the wrong pipeline, moves pixels and
// fails here.

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vk
import ae3d.offscreen
import ae3d.loader
import ae3d.rendering
import ae3d.water
import ae3d.voxel
import ae3d.noise
import std.os
import std.string

const WIDTH = 256
const HEIGHT = 192
const INSTANCES = 24
const TEXTURE = "resources/obj/Earth/Albedo.jpg"

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)
extern memcpy(dst: ptr, src: ptr, bytes: int) -> ptr
extern ae3d_png_write(path: string, rgba: ptr, width: int, height: int) -> int

// AE3D_PARITY_DUMP=<dir> writes both backends' frame of every case there, so
// a case that fails can be looked at instead of guessed at.
dump_frames(name: string, gl_pixels: ptr, vk_pixels: ptr) {
    dir = core.text(os.getenv("AE3D_PARITY_DUMP"))
    if dir == "" { return }
    stem = string.replace_all(string.replace_all(name, " ", "_"), ",", "")
    ae3d_png_write("${dir}/${stem}_gl.png", gl_pixels, WIDTH, HEIGHT)
    ae3d_png_write("${dir}/${stem}_vk.png", vk_pixels, WIDTH, HEIGHT)
}

var failures = 0

record_failure(reason: string) {
    println("FAIL ${reason}")
    failures = failures + 1
}

check_true(name: string, condition: bool) {
    if !condition { record_failure(name) }
}

channel(pixels: ptr, index: int) -> int {
    return mem.get_byte(pixels, index)
}

// Comparing the two backends says they agree. It does not say either of them
// did anything: a post pass that quietly copied its input through would look
// exactly like one that worked, on both sides at once. This is what the frame
// adds up to, so an effect can be asked to change it.
frame_total(pixels: ptr) -> long {
    total = 0 as long
    i = 0
    while i < WIDTH * HEIGHT * 4 {
        total = total + (channel(pixels, i) as long)
        i = i + 1
    }
    return total
}

// A row of small spheres across the front of the scene, each scaled by the
// model and tinted its own colour: placed by a matrix each, or as points.
point_spheres(as_points: bool) -> *Model {
    m = loader.sphere(1.0, 12, 8)
    core.model_set_scale(m, 5.0, 5.0, 5.0)
    core.model_set_diffuse(m, 0.9, 0.9, 0.9)
    core.model_enable_instancing(m, 6)
    core.model_enable_instance_colors(m)
    if as_points { core.model_enable_point_instancing(m) }
    xyz = calloc(6 * 3, 8)
    rgb = calloc(6 * 3, 8)
    positions = xyz as float[]
    tints = rgb as float[]
    i = 0
    while i < 6 {
        positions[i * 3] = (i as float) * 16.0 - 40.0
        positions[i * 3 + 1] = 0.0 - 30.0
        positions[i * 3 + 2] = 60.0
        tints[i * 3] = 0.3 + (i as float) * 0.12
        tints[i * 3 + 1] = 0.9 - (i as float) * 0.1
        tints[i * 3 + 2] = 0.4
        i = i + 1
    }
    core.model_set_instance_positions(m, xyz, 6)
    core.model_set_instance_colors(m, rgb, 6)
    free(xyz)
    free(rgb)
    return m
}

// A polished metal sphere and a textured one, so one frame exercises the
// lighting model and the sampler at the same time.
build_scene(pass_backend: *Backend) -> {
    metal = loader.sphere(1.0, 32, 24)
    core.model_set_scale(metal, 24.0, 24.0, 24.0)
    core.model_set_position(metal, 0.0 - 34.0, 0.0, 0.0)
    core.model_polished_metal(metal, 0.85, 0.45, 0.20)
    core.backend_add_model(pass_backend, metal)

    // An instanced grid and a transparent panel: instancing takes a different
    // vertex-input path and transparency a different pipeline, so neither is
    // covered by drawing one opaque model.
    grid = loader.cube(1.0)
    core.model_set_scale(grid, 9.0, 9.0, 9.0)
    core.model_set_diffuse(grid, 0.2, 0.8, 0.4)
    core.model_enable_instancing(grid, INSTANCES)
    positions = calloc(INSTANCES * 3, 8)
    xyz = positions as float[]
    i = 0
    while i < INSTANCES {
        xyz[i * 3] = ((i % 8) * 1.0) * 20.0 - 70.0
        xyz[i * 3 + 1] = ((i / 8) * 1.0) * 22.0 - 44.0
        xyz[i * 3 + 2] = 40.0
        i = i + 1
    }
    core.model_set_instance_positions(grid, positions, INSTANCES)
    free(positions)
    core.backend_add_model(pass_backend, grid)

    glass = loader.cube(1.0)
    core.model_set_scale(glass, 30.0, 22.0, 0.5)
    core.model_set_position(glass, 0.0, 18.0, 70.0)
    core.model_set_diffuse(glass, 0.3, 0.5, 1.0)
    core.model_set_alpha(glass, 0.45)
    core.backend_add_model(pass_backend, glass)

    textured = loader.sphere(1.0, 32, 24)
    core.model_set_scale(textured, 24.0, 24.0, 24.0)
    core.model_set_position(textured, 34.0, 0.0, 0.0)
    core.model_set_texture(textured, TEXTURE)
    core.backend_add_model(pass_backend, textured)

    return metal, textured, grid, glass
}

// The editor's terrain, at a size that fits the test's frame: the same seeded
// field, so both backends are handed identical geometry.
build_voxels() -> *World {
    world = voxel.world_new(24, 24, 20, 4.0)
    if world == null { return null }
    field = noise.perlin_new(20260903)
    if field == null {
        voxel.world_free(world)
        return null
    }
    x = 0
    while x < voxel.world_size_x(world) {
        z = 0
        while z < voxel.world_size_z(world) {
            sample = noise.fbm2(field, (x * 1.0) * 0.05, (z * 1.0) * 0.05, 4, 0.5)
            height = (((sample + 1.0) * 0.5) * 12.0 + 3.0) as int
            y = 0
            while y < height {
                kind = voxel.STONE
                if y == height - 1 { kind = voxel.GRASS }
                if y > height - 4 && y != height - 1 { kind = voxel.DIRT }
                voxel.world_set(world, x, y, z, kind)
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
    noise.perlin_free(field)
    return world
}

// Every configuration is compared the same way: the two rasterisers differ in
// sample positions and resolve, so exact equality is not the bar. A shared
// lighting model and matching transforms are, and those show up as a small
// share of differing channels and near-identical lit coverage.
// How many pixels each backend lit, at whatever size the frame is now: after a
// resize the two can only be compared over the part of the buffer both filled.
compare_size(name: string, gl_pixels: ptr, vk_pixels: ptr, width: int, height: int) {
    lit_gl = 0
    lit_vk = 0
    i = 0
    while i < width * height * 4 {
        if channel(gl_pixels, i) > 12 { lit_gl = lit_gl + 1 }
        if channel(vk_pixels, i) > 12 { lit_vk = lit_vk + 1 }
        i = i + 4
    }
    check_true("${name}: opengl drew something", lit_gl > 200)
    check_true("${name}: vulkan drew something", lit_vk > 200)
    spread = lit_gl - lit_vk
    if spread < 0 { spread = 0 - spread }
    check_true("${name}: both cover the same area", spread * 10 < lit_gl)
    println("  ${name}: opengl lit ${lit_gl}, vulkan lit ${lit_vk}")
}

// The mean of one channel over the frame, in 0..255.
channel_mean(pixels: ptr, channel: int) -> int {
    total = 0.0
    i = 0
    while i < WIDTH * HEIGHT {
        total = total + (mem.get_byte(pixels, i * 4 + channel) as float)
        i = i + 1
    }
    return (total / ((WIDTH * HEIGHT) as float)) as int
}

compare(name: string, gl_pixels: ptr, vk_pixels: ptr) -> int {
    return compare_within(name, gl_pixels, vk_pixels, 2)
}

// The same, allowing `percent` of the channels to differ: for a feature
// read off the frame itself rather than off a uniform, where the two
// backends' anti-aliasing puts every silhouette a pixel apart.
compare_within(name: string, gl_pixels: ptr, vk_pixels: ptr, percent: int) -> int {
    dump_frames(name, gl_pixels, vk_pixels)
    lit_gl = 0
    lit_vk = 0
    worst = 0
    total = 0
    differing = 0
    brightness = 0

    y = 0
    while y < HEIGHT {
        x = 0
        while x < WIDTH {
            // OpenGL reads back top-down after the flip; Vulkan renders with y
            // already pointing down, so the same row index is the same row.
            index = (y * WIDTH + x) * 4
            i = 0
            while i < 3 {
                a = channel(gl_pixels, index + i)
                b = channel(vk_pixels, index + i)
                if a > 12 { lit_gl = lit_gl + 1 }
                if b > 12 { lit_vk = lit_vk + 1 }
                brightness = brightness + b
                difference = a - b
                if difference < 0 { difference = 0 - difference }
                if difference > worst { worst = difference }
                if difference > 8 { differing = differing + 1 }
                total = total + 1
                i = i + 1
            }
            x = x + 1
        }
        y = y + 1
    }

    sum_r_gl = 0
    sum_g_gl = 0
    sum_b_gl = 0
    sum_r_vk = 0
    sum_g_vk = 0
    sum_b_vk = 0
    y = 0
    while y < HEIGHT {
        x = 0
        while x < WIDTH {
            index = (y * WIDTH + x) * 4
            sum_r_gl = sum_r_gl + channel(gl_pixels, index)
            sum_g_gl = sum_g_gl + channel(gl_pixels, index + 1)
            sum_b_gl = sum_b_gl + channel(gl_pixels, index + 2)
            sum_r_vk = sum_r_vk + channel(vk_pixels, index)
            sum_g_vk = sum_g_vk + channel(vk_pixels, index + 1)
            sum_b_vk = sum_b_vk + channel(vk_pixels, index + 2)
            x = x + 1
        }
        y = y + 1
    }
    check_true("${name}: opengl drew something", lit_gl > 2000)
    check_true("${name}: vulkan drew something", lit_vk > 2000)

    coverage = lit_gl - lit_vk
    if coverage < 0 { coverage = 0 - coverage }
    check_true("${name}: both cover the same area", coverage * 20 < lit_gl)
    check_true("${name}: frames agree", differing * 100 < total * percent)

    println("  ${name}: opengl lit ${lit_gl}, vulkan lit ${lit_vk}, ${differing} of ${total} channels differ, worst ${worst}")
    return brightness
}

main() {
    if !vk.available() {
        println("parity: SKIP no Vulkan driver (${vk.last_error()})")
        return
    }

    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(70.0, 60.0, 110.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    light = core.light_sun(core.vec3(0.3, 0.6, 0.8))
    // Enough ambient that every model is above the lit threshold, so coverage
    // measures what is on screen rather than what happens to face the sun.
    light.ambient_strength = 0.55

    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("parity: SKIP no OpenGL context")
        return
    }

    gl_renderer = gl.renderer_new()
    opengl_pass = gl.backend(gl_renderer)
    check_true("opengl started", core.backend_init(&opengl_pass, context, WIDTH, HEIGHT))
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(gl_renderer, target)
    gl.renderer_set_clear_color(gl_renderer, 0.0, 0.0, 0.0)
    gl_metal, gl_textured, gl_grid, gl_glass = build_scene(&opengl_pass)

    vk_renderer = vk.renderer_new()
    vulkan_pass = vk.backend(vk_renderer)
    // A loader without a device behind it reports itself available and then
    // fails to start. There is nothing to compare on a machine like that, and
    // nothing wrong with the renderer either.
    if !core.backend_init(&vulkan_pass, null, WIDTH, HEIGHT) {
        println("parity: SKIP Vulkan would not start (${vk.last_error()})")
        return
    }
    vk.renderer_set_clear_color(vk_renderer, 0.0, 0.0, 0.0)
    vk_metal, vk_textured, vk_grid, vk_glass = build_scene(&vulkan_pass)

    check_true("vulkan target size", vk.offscreen_width() == WIDTH && vk.offscreen_height() == HEIGHT)

    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    gl_pixels = offscreen.target_pixels(target)
    vk_pixels = vk.offscreen_pixels()
    check_true("opengl produced pixels", gl_pixels != null)
    check_true("vulkan produced pixels", vk_pixels != null)
    if gl_pixels == null || vk_pixels == null { return }
    compare("materials, textures, instancing and transparency", gl_pixels, vk_pixels)

    gl_sky = gl.skybox_create(gl_renderer, TEXTURE)
    vk_sky = vk.skybox_create(vk_renderer, TEXTURE)
    check_true("skybox textures loaded",
               core.skybox_texture(gl_sky) != 0 && core.skybox_texture(vk_sky) != 0)
    // Rendered here rather than read from whatever the last comparison left in
    // the buffer, so what follows is measured against this scene and no other.
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    bare_gl = frame_total(offscreen.target_pixels(target))
    bare_vk = frame_total(vk.offscreen_pixels())

    core.backend_set_skybox(&opengl_pass, gl_sky as ptr)
    core.backend_set_skybox(&vulkan_pass, vk_sky as ptr)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    compare("skybox", offscreen.target_pixels(target), vk.offscreen_pixels())
    check_true("the skybox reaches the opengl frame",
               frame_total(offscreen.target_pixels(target)) != bare_gl)
    check_true("the skybox reaches the vulkan frame",
               frame_total(vk.offscreen_pixels()) != bare_vk)

    // Clouds over the sky, marched in the sky shader, and their shadow on
    // the ground through the same coverage field: the one sky feature that
    // is computed rather than sampled, so the one that could differ.
    // An overcast, since the frame is small and looks mostly at the ground:
    // at a fair-weather cover the strip of sky it sees can fall between
    // two clouds, and then there is nothing to compare.
    sky_gl = frame_total(offscreen.target_pixels(target))
    gl.renderer_set_clouds(gl_renderer, 0.9, 1.0)
    vk.renderer_set_clouds(vk_renderer, 0.9, 1.0)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    compare_within("clouds over the skybox", offscreen.target_pixels(target), vk.offscreen_pixels(), 4)
    check_true("the clouds reach the frame", frame_total(offscreen.target_pixels(target)) != sky_gl)
    gl.renderer_set_clouds(gl_renderer, 0.0, 1.0)
    vk.renderer_set_clouds(vk_renderer, 0.0, 1.0)

    // The sky drawn from the sun in place of the image, at the hour the
    // key light says: the same sky on both, and not the image's.
    gl_sun_sky = gl.skybox_create(gl_renderer, core.SKY_PROCEDURAL)
    vk_sun_sky = vk.skybox_create(vk_renderer, core.SKY_PROCEDURAL)
    check_true("a sky drawn from the sun is a sky", gl_sun_sky.procedural && vk_sun_sky.procedural)
    core.backend_set_skybox(&opengl_pass, gl_sun_sky as ptr)
    core.backend_set_skybox(&vulkan_pass, vk_sun_sky as ptr)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    sun_sky_lit = compare("the sky drawn from the sun", offscreen.target_pixels(target), vk.offscreen_pixels())
    check_true("the sky drawn from the sun is not the image", sun_sky_lit != sky_gl)
    core.backend_set_skybox(&opengl_pass, gl_sky as ptr)
    core.backend_set_skybox(&vulkan_pass, vk_sky as ptr)
    gl.skybox_free(gl_renderer, gl_sun_sky)
    vk.skybox_free(vk_renderer, vk_sun_sky)

    // The occlusion: a fullscreen multiply over the opaque pass, from the
    // scene's depth, which each backend captures its own way (a blit of the
    // draw buffer's depth, a prepass into a depth image). Both must find
    // the same corners, and it must darken: a pass that draws nothing would
    // agree perfectly.
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    open_gl = frame_total(offscreen.target_pixels(target))
    open_vk = frame_total(vk.offscreen_pixels())
    // A reach of fifteen metres: the cubes stand eleven apart, and a
    // reach of three would find nothing between them to shadow.
    gl.renderer_set_ssao(gl_renderer, true, 15.0, 1.0)
    vk.renderer_set_ssao(vk_renderer, true, 15.0, 1.0)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    compare_within("occlusion over the scene", offscreen.target_pixels(target), vk.offscreen_pixels(), 4)
    println("  occlusion: opengl ${open_gl} -> ${frame_total(offscreen.target_pixels(target))}, vulkan ${open_vk} -> ${frame_total(vk.offscreen_pixels())}")
    check_true("the occlusion darkens the opengl frame", frame_total(offscreen.target_pixels(target)) < open_gl)
    check_true("the occlusion darkens the vulkan frame", frame_total(vk.offscreen_pixels()) < open_vk)
    gl.renderer_set_ssao(gl_renderer, false, 15.0, 1.0)
    vk.renderer_set_ssao(vk_renderer, false, 15.0, 1.0)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)

    // Instances as points: the same spheres placed by a matrix each and by
    // a point each must draw the same picture, on each backend and between
    // them, since the point pipelines are a second vertex layout and a
    // branch in the vertex shader that nothing else exercises.
    point_pixels = calloc(WIDTH * HEIGHT * 4, 1)
    gl_matrices = point_spheres(false)
    vk_matrices = point_spheres(false)
    core.backend_add_model(&opengl_pass, gl_matrices)
    core.backend_add_model(&vulkan_pass, vk_matrices)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    matrices_lit = compare("spheres placed by matrices", offscreen.target_pixels(target), vk.offscreen_pixels())
    memcpy(point_pixels, offscreen.target_pixels(target), WIDTH * HEIGHT * 4)
    core.backend_remove_model(&opengl_pass, gl_matrices)
    core.backend_remove_model(&vulkan_pass, vk_matrices)
    core.model_free(gl_matrices)
    core.model_free(vk_matrices)
    gl_points = point_spheres(true)
    vk_points = point_spheres(true)
    core.backend_add_model(&opengl_pass, gl_points)
    core.backend_add_model(&vulkan_pass, vk_points)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    points_lit = compare("spheres placed by points", offscreen.target_pixels(target), vk.offscreen_pixels())
    compare("points against matrices", point_pixels, offscreen.target_pixels(target))
    check_true("the spheres are in the frame", matrices_lit != sky_gl && points_lit != sky_gl)
    core.backend_remove_model(&opengl_pass, gl_points)
    core.backend_remove_model(&vulkan_pass, vk_points)
    core.model_free(gl_points)
    core.model_free(vk_points)
    free(point_pixels)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)

    plain_gl = frame_total(offscreen.target_pixels(target))
    plain_vk = frame_total(vk.offscreen_pixels())

    core.backend_set_post(&opengl_pass, true, false, 0.8, 0.4)
    core.backend_set_post(&vulkan_pass, true, false, 0.8, 0.4)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    compare("fxaa", offscreen.target_pixels(target), vk.offscreen_pixels())
    check_true("fxaa changes the opengl frame",
               frame_total(offscreen.target_pixels(target)) != plain_gl)
    check_true("fxaa changes the vulkan frame",
               frame_total(vk.offscreen_pixels()) != plain_vk)

    core.backend_set_post(&opengl_pass, false, true, 0.8, 0.4)
    core.backend_set_post(&vulkan_pass, false, true, 0.8, 0.4)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    compare("bloom", offscreen.target_pixels(target), vk.offscreen_pixels())
    check_true("bloom changes the opengl frame",
               frame_total(offscreen.target_pixels(target)) != plain_gl)
    check_true("bloom changes the vulkan frame",
               frame_total(vk.offscreen_pixels()) != plain_vk)

    // Shadows are the newest thing both backends do, and the one most likely to
    // diverge: two depth passes, two light-space matrices, two samplers.
    core.backend_set_post(&opengl_pass, false, false, 0.8, 0.4)
    core.backend_set_post(&vulkan_pass, false, false, 0.8, 0.4)
    gl.renderer_set_shadows(gl_renderer, true)
    vk.renderer_set_shadows(vk_renderer, true)
    check_true("both backends report shadows on",
               gl.renderer_shadows(gl_renderer) && vk.renderer_shadows(vk_renderer))
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    one_light = compare("shadows", offscreen.target_pixels(target), vk.offscreen_pixels())

    // Lights reach a renderer through the vtable, and the Vulkan side had a
    // list nothing could add to, so a second light changed the OpenGL frame and
    // left the Vulkan one alone.
    fill = core.light_point(core.vec3(0.0 - 6.0, 4.0, 8.0), core.vec3(1.0, 0.85, 0.6), 6.0, 120.0)
    core.backend_add_light(&opengl_pass, light)
    core.backend_add_light(&vulkan_pass, light)
    core.backend_add_light(&opengl_pass, fill)
    core.backend_add_light(&vulkan_pass, fill)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    // A bright lamp in the key light's shadow: the shadow map's edge is a
    // pixel apart between the backends, and the lamp's light, cut by the
    // shadow like every light's, makes that pixel a bright one on one
    // side; so this case is allowed more than the usual disagreement.
    two_lights = compare_within("two lights", offscreen.target_pixels(target), vk.offscreen_pixels(), 5)
    check_true("the second light reaches Vulkan", two_lights > one_light + one_light / 50)

    core.backend_remove_light(&opengl_pass, fill)
    core.backend_remove_light(&vulkan_pass, fill)
    core.light_free(fill)

    // A shading preset is nothing but per-model custom uniforms, which the
    // Vulkan renderer used to drop on the floor.
    preset = rendering.high_quality_config()
    rendering.apply(gl_metal, preset)
    rendering.apply(vk_metal, preset)
    rendering.apply(gl_textured, preset)
    rendering.apply(vk_textured, preset)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    preset_lit = compare("shading preset", offscreen.target_pixels(target), vk.offscreen_pixels())
    check_true("the preset reaches Vulkan", preset_lit != two_lights)

    // Culling decides which triangles of every model survive, and which models
    // are exempt: a transparent surface is never culled, because you see
    // through it to its own far side. The Vulkan pipelines were built with
    // culling off whatever the scene asked for, and culling the transparent
    // pass once it was on moved 463196 units of the frame that OpenGL leaves
    // alone. Nothing here should differ from the frame before it.
    core.set_face_culling(true)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    compare("back faces culled", offscreen.target_pixels(target), vk.offscreen_pixels())
    core.set_face_culling(false)

    // A Gerstner ocean is its own program on both backends, driven by a wave
    // table that arrives as array uniforms. It is the one model whose geometry
    // the shader itself moves, so a frame of it has to be compared after the
    // simulation has run rather than at rest.
    gl_sim = water.simulation_new(120.0, 3.0)
    vk_sim = water.simulation_new(120.0, 3.0)
    gl_ocean = water.simulation_build(gl_sim, 48)
    vk_ocean = water.simulation_build(vk_sim, 48)
    core.model_set_position(gl_ocean, 0.0, 0.0 - 26.0, 0.0)
    core.model_set_position(vk_ocean, 0.0, 0.0 - 26.0, 0.0)
    core.backend_add_model(&opengl_pass, gl_ocean)
    core.backend_add_model(&vulkan_pass, vk_ocean)

    step = 0
    while step < 12 {
        water.simulation_update(gl_sim, 0.05)
        water.simulation_update(vk_sim, 0.05)
        step = step + 1
    }
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    ocean_lit = compare("gerstner ocean", offscreen.target_pixels(target), vk.offscreen_pixels())
    check_true("the ocean changes the frame", ocean_lit != preset_lit)

    // The sea under an overcast: the surface reflects the sky the sky
    // shader draws, pulled toward the overcast's grey, on both backends
    // alike -- the water program reads the overcast through its own
    // uniforms on OpenGL and through the shared block on Vulkan.
    gl.renderer_set_sky_overcast(gl_renderer, 0.9, core.vec3(0.62, 0.65, 0.70))
    vk.renderer_set_sky_overcast(vk_renderer, 0.9, core.vec3(0.62, 0.65, 0.70))
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    gl_grey = channel_mean(offscreen.target_pixels(target), 2) - channel_mean(offscreen.target_pixels(target), 0)
    compare("ocean under an overcast", offscreen.target_pixels(target), vk.offscreen_pixels())
    gl.renderer_set_sky_overcast(gl_renderer, 0.0, core.vec3(0.5, 0.5, 0.5))
    vk.renderer_set_sky_overcast(vk_renderer, 0.0, core.vec3(0.5, 0.5, 0.5))
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    gl_blue = channel_mean(offscreen.target_pixels(target), 2) - channel_mean(offscreen.target_pixels(target), 0)
    check_true("the overcast greys the sea's reflection (blue over red ${gl_grey} against ${gl_blue})", gl_grey < gl_blue - 2)

    // A shore: the surface reads the scene's depth under it, captured after
    // the opaque pass on both backends, and goes clear over the cubes that
    // stand in it with foam where they break the surface. The one water
    // feature that reads a frame back rather than a uniform, so the one
    // most likely to differ between the two.
    // A shelf eight metres under the surface across the view, so the
    // shallows are a broad region and not the rim of a few cubes.
    gl_shelf = loader.cube(1.0)
    vk_shelf = loader.cube(1.0)
    core.model_set_scale(gl_shelf, 400.0, 2.0, 400.0)
    core.model_set_scale(vk_shelf, 400.0, 2.0, 400.0)
    core.model_set_position(gl_shelf, 0.0, 0.0 - 35.0, 0.0)
    core.model_set_position(vk_shelf, 0.0, 0.0 - 35.0, 0.0)
    core.model_set_diffuse(gl_shelf, 0.8, 0.7, 0.5)
    core.model_set_diffuse(vk_shelf, 0.8, 0.7, 0.5)
    core.backend_add_model(&opengl_pass, gl_shelf)
    core.backend_add_model(&vulkan_pass, vk_shelf)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    shelf_lit = compare("a shelf under the ocean", offscreen.target_pixels(target), vk.offscreen_pixels())
    water.simulation_set_shore(gl_sim, 12.0, 8.0)
    water.simulation_set_shore(vk_sim, 12.0, 8.0)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    // Read off the frame's depth, which the two backends resolve from their
    // own anti-aliasing: every silhouette that meets the water is a pixel
    // apart, so this case is allowed twice the usual disagreement.
    shore_lit = compare_within("shore from the scene depth", offscreen.target_pixels(target), vk.offscreen_pixels(), 4)
    check_true("the shore changes the frame", shore_lit != shelf_lit)
    water.simulation_set_shore(gl_sim, 0.0, 0.0)
    water.simulation_set_shore(vk_sim, 0.0, 0.0)
    core.backend_remove_model(&opengl_pass, gl_shelf)
    core.backend_remove_model(&vulkan_pass, vk_shelf)
    core.model_free(gl_shelf)
    core.model_free(vk_shelf)

    // The editor runs shadows, an ocean and FXAA together, which is the
    // combination that put the water program's uniforms under the composite.
    core.backend_set_post(&opengl_pass, true, false, 0.8, 0.4)
    core.backend_set_post(&vulkan_pass, true, false, 0.8, 0.4)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    compare("ocean through fxaa", offscreen.target_pixels(target), vk.offscreen_pixels())

    // Resizing with a composite running rebuilds the Vulkan target and destroys
    // the post-processing texture with it. Descriptor sets are cached per
    // texture, so a set handed out before the resize named an image that no
    // longer existed and the frame came back as noise. Resizing away and back
    // leaves the frame comparable with the one before it.
    core.backend_update_viewport(&opengl_pass, WIDTH / 2, HEIGHT / 2)
    core.backend_update_viewport(&vulkan_pass, WIDTH / 2, HEIGHT / 2)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    core.backend_update_viewport(&opengl_pass, WIDTH, HEIGHT)
    core.backend_update_viewport(&vulkan_pass, WIDTH, HEIGHT)
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    compare("after a resize", offscreen.target_pixels(target), vk.offscreen_pixels())

    // The same resize with both composites running. The scene is drawn into
    // buffers of its own before an effect composites it, and OpenGL left those
    // the size they used to be: the frame came back drawn small and stretched
    // over the viewport, which lit a third of the pixels Vulkan did. Nothing
    // caught it because every resize here had the composites switched off.
    core.backend_set_post(&opengl_pass, true, true, 0.8, 0.4)
    core.backend_set_post(&vulkan_pass, true, true, 0.8, 0.4)
    core.backend_update_viewport(&opengl_pass, WIDTH / 2, HEIGHT / 2)
    core.backend_update_viewport(&vulkan_pass, WIDTH / 2, HEIGHT / 2)
    offscreen.target_resize(target, WIDTH / 2, HEIGHT / 2)
    core.camera_set_aspect(cam, (WIDTH * 0.5) / (HEIGHT * 0.5))
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    compare_size("a resize with the composites running",
                 offscreen.target_pixels(target), vk.offscreen_pixels(),
                 WIDTH / 2, HEIGHT / 2)

    core.backend_update_viewport(&opengl_pass, WIDTH, HEIGHT)
    core.backend_update_viewport(&vulkan_pass, WIDTH, HEIGHT)
    offscreen.target_resize(target, WIDTH, HEIGHT)
    core.camera_set_aspect(cam, (WIDTH * 1.0) / (HEIGHT * 1.0))
    core.backend_render(&opengl_pass, cam, light)
    core.backend_render(&vulkan_pass, cam, light)
    core.backend_set_post(&opengl_pass, false, false, 0.8, 0.4)
    core.backend_set_post(&vulkan_pass, false, false, 0.8, 0.4)

    // A rebuild makes a fresh shadow target, so the one it replaced has to be
    // gone. Piling another one up leaks a whole image, its memory, two views, a
    // depth image with its own memory, a sampler and a framebuffer, which no
    // frame ever looks different for.
    check_true("a resize replaces the shadow target rather than adding one",
               vk.live_shadow_targets() == 1)

    core.backend_set_post(&opengl_pass, false, false, 0.8, 0.4)
    core.backend_set_post(&vulkan_pass, false, false, 0.8, 0.4)

    // A voxel chunk: one instanced draw of thousands of cubes, each carrying its
    // own colour in the instance buffer. It is the densest geometry the engine
    // produces and the only thing that uses the per-instance colour attribute.
    gl_world = build_voxels()
    vk_world = build_voxels()
    gl_chunk = voxel.world_build(gl_world, loader.cube(4.0))
    vk_chunk = voxel.world_build(vk_world, loader.cube(4.0))
    if gl_chunk != null && vk_chunk != null {
        core.model_set_position(gl_chunk, 0.0 - 40.0, 0.0 - 40.0, 0.0 - 40.0)
        core.model_set_position(vk_chunk, 0.0 - 40.0, 0.0 - 40.0, 0.0 - 40.0)
        core.backend_add_model(&opengl_pass, gl_chunk)
        core.backend_add_model(&vulkan_pass, vk_chunk)
        core.backend_render(&opengl_pass, cam, light)
        core.backend_render(&vulkan_pass, cam, light)
        compare("voxel chunk", offscreen.target_pixels(target), vk.offscreen_pixels())
        core.backend_remove_model(&opengl_pass, gl_chunk)
        core.backend_remove_model(&vulkan_pass, vk_chunk)
        core.model_free(gl_chunk)
        core.model_free(vk_chunk)
    }
    voxel.world_free(gl_world)
    voxel.world_free(vk_world)

    core.backend_remove_model(&opengl_pass, gl_ocean)
    core.backend_remove_model(&vulkan_pass, vk_ocean)
    water.simulation_free(gl_sim)
    water.simulation_free(vk_sim)

    // How many draws a backend needs is its own business, and the OpenGL one
    // merges models that share geometry into a single instanced call. What has
    // to hold is that neither backend reached the same picture by skipping
    // geometry, so merging may only ever take the count down.
    gl_draws = core.backend_draw_calls(&opengl_pass)
    vk_draws = core.backend_draw_calls(&vulkan_pass)
    check_true("both backends drew the scene", gl_draws > 0 && vk_draws > 0)
    check_true("merging only ever removes draws", gl_draws <= vk_draws)

    core.backend_cleanup(&opengl_pass)
    core.backend_cleanup(&vulkan_pass)
    offscreen.target_destroy(target)
    offscreen.context_destroy(context)

    core.model_free(gl_metal)
    core.model_free(gl_textured)
    core.model_free(gl_grid)
    core.model_free(gl_glass)
    core.model_free(vk_metal)
    core.model_free(vk_textured)
    core.model_free(vk_grid)
    core.model_free(vk_glass)

    gl.renderer_free(gl_renderer)
    vk.renderer_free(vk_renderer)
    core.camera_free(cam)
    core.light_free(light)

    if failures == 0 {
        println("parity: all checks passed")
    } else {
        println("parity: ${failures} failure(s)")
    }
}
