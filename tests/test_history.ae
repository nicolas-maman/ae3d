// Undo and redo, exercised rather than asserted.

import ae3d.history

extern calloc(count: int, size: int) -> ptr
extern free(p: ptr)

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

main() {
    h = history.history_new()
    subject = h as ptr
    other = calloc(1, 8)

    check("a fresh history has nothing to undo", history.history_depth(h) == 0)
    check("undo on an empty history yields nothing", history.history_undo(h) == null)

    history.history_record(h, history.STEP_PROPERTY, subject, 0, 0.0, 12.0)
    history.history_record(h, history.STEP_PROPERTY, subject, 0, 12.0, 34.0)
    check("consecutive edits to one property are one step", history.history_depth(h) == 1)

    top = history.history_top(h)
    check("the step spans the whole adjustment", top.before == 0.0 && top.after == 34.0)

    history.history_record(h, history.STEP_PROPERTY, subject, 1, 5.0, 6.0)
    check("a different property opens a new step", history.history_depth(h) == 2)

    // A drag that has finished does not go on collecting whatever comes next.
    // Without this, letting go of a slider and taking hold of it again extends
    // the step the first drag opened, and undo steps back past both.
    history.history_close(h)
    history.history_record(h, history.STEP_PROPERTY, subject, 1, 3.0, 4.0)
    check("a finished edit closes its step", history.history_depth(h) == 3)
    history.history_record(h, history.STEP_PROPERTY, subject, 1, 4.0, 5.0)
    check("the edit after it still coalesces", history.history_depth(h) == 3)

    step = history.history_undo(h)
    check("undo hands back the newest step", step.slot == 1 && step.before == 3.0)
    check("undo moves the step to the redo stack", history.history_depth(h) == 2)
    check("the redo stack holds it", history.history_redo_depth(h) == 1)

    again = history.history_redo(h)
    check("redo hands the same step back", again.slot == 1 && again.after == 5.0)
    check("redo returns it to the undo stack", history.history_depth(h) == 3)

    history.history_undo(h)
    history.history_record(h, history.STEP_ADD, subject, 0, 0.0, 0.0)
    check("recording after an undo drops the redo stack", history.history_redo_depth(h) == 0)

    // A step per property, past the cap, to prove the oldest are dropped rather
    // than the history growing without bound.
    i = 0
    while i < 200 {
        history.history_record(h, history.STEP_PROPERTY, subject, i + 10, 0.0, i * 1.0)
        i = i + 1
    }
    check("the history is capped", history.history_depth(h) == 64)

    newest = history.history_top(h)
    check("the newest step survives the cap", newest.slot == 209)

    history.history_clear(h)
    check("clear empties both stacks",
          history.history_depth(h) == 0 && history.history_redo_depth(h) == 0)

    // A parent step carries the parents before and after; steps recorded
    // in a group undo together, and one outside it does not.
    parent_a = calloc(1, 8)
    parent_b = calloc(1, 8)
    history.history_record(h, history.STEP_PROPERTY, subject, 3, 1.0, 2.0)
    history.history_close(h)
    history.history_group_begin(h)
    history.history_record(h, history.STEP_ADD, parent_b, 0, 0.0, 0.0)
    history.history_record_parent(h, subject, parent_a, parent_b)
    history.history_record_parent(h, other, null, parent_b)
    history.history_group_end(h)
    check("a group's steps are recorded one each", history.history_depth(h) == 4)
    step = history.history_undo(h)
    check("the last step of the group comes first", step.kind == history.STEP_PARENT && step.subject == other && step.from == null && step.to == parent_b)
    check("and says the group goes on", history.history_undo_group(h, step.group))
    second = history.history_undo(h)
    check("the parent step reads its parents", second.kind == history.STEP_PARENT && second.from == parent_a && second.to == parent_b)
    check("the group goes on to its add", history.history_undo_group(h, step.group))
    history.history_undo(h)
    check("and ends before the step outside it", !history.history_undo_group(h, step.group))
    check("the step outside the group is still there", history.history_depth(h) == 1)
    redone = history.history_redo(h)
    check("redo hands the group's first step back", redone.kind == history.STEP_ADD && history.history_redo_group(h, redone.group))
    free(parent_a)
    free(parent_b)

    // A rename owns its names, and letters typed one at a time are one step.
    history.history_clear(h)
    history.history_record_name(h, subject, "cube", "cub")
    history.history_record_name(h, subject, "cub", "cu")
    history.history_record_name(h, subject, "cu", "cup")
    check("letters typed into a name are one step", history.history_depth(h) == 1)
    named = history.history_top(h)
    check("the step spans the whole rename", named.kind == history.STEP_NAME && named.name_from == "cube" && named.name_to == "cup")
    history.history_close(h)
    history.history_record_name(h, subject, "cup", "mug")
    check("a rename after a close is a step of its own", history.history_depth(h) == 2)

    history.history_free(h)

    if failures == 0 {
        println("history: all checks passed")
    } else {
        println("history: ${failures} failure(s)")
    }
}
