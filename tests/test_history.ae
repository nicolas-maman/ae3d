// Undo and redo, exercised rather than asserted.

import ae3d.history

var failures = 0

check(name: string, ok: bool) {
    if ok {
        println("  ok   ${name}")
    } else {
        println("  FAIL ${name}")
        failures = failures + 1
    }
}

main() {
    h = history.history_new()
    subject = h as ptr

    check("a fresh history has nothing to undo", history.history_depth(h) == 0)
    check("undo on an empty history yields nothing", history.history_undo(h) == null)

    history.history_record(h, history.STEP_PROPERTY, subject, 0, 0.0, 12.0)
    history.history_record(h, history.STEP_PROPERTY, subject, 0, 12.0, 34.0)
    check("consecutive edits to one property are one step", history.history_depth(h) == 1)

    top = history.history_top(h)
    check("the step spans the whole adjustment", top.before == 0.0 && top.after == 34.0)

    history.history_record(h, history.STEP_PROPERTY, subject, 1, 5.0, 6.0)
    check("a different property opens a new step", history.history_depth(h) == 2)

    step = history.history_undo(h)
    check("undo hands back the newest step", step.slot == 1 && step.before == 5.0)
    check("undo moves the step to the redo stack", history.history_depth(h) == 1)
    check("the redo stack holds it", history.history_redo_depth(h) == 1)

    again = history.history_redo(h)
    check("redo hands the same step back", again.slot == 1 && again.after == 6.0)
    check("redo returns it to the undo stack", history.history_depth(h) == 2)

    history.history_undo(h)
    history.history_record(h, history.STEP_ADD, subject, 0, 0.0, 0.0)
    check("recording after an undo drops the redo stack", history.history_redo_depth(h) == 0)

    // A step per property, past the cap, to prove the oldest are dropped rather
    // than the history growing without bound.
    i = 0
    while i < 200 {
        history.history_record(h, history.STEP_PROPERTY, subject, i + 10, 0.0, i * 1.0)
        i = i + 1
    }
    check("the history is capped", history.history_depth(h) == 64)

    newest = history.history_top(h)
    check("the newest step survives the cap", newest.slot == 209)

    history.history_clear(h)
    check("clear empties both stacks",
          history.history_depth(h) == 0 && history.history_redo_depth(h) == 0)

    history.history_free(h)

    if failures == 0 {
        println("history: all checks passed")
    } else {
        println("history: ${failures} failure(s)")
    }
}
