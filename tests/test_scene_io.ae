// Scene round-trip: a file-backed model, a procedural model, and an instanced
// one with per-instance colours.

import std.list
import std.fs
import std.file
import std.string
import ae3d.core
import ae3d.scene
import ae3d.loader
import ae3d.voxel
import ae3d.rendering
import ae3d.water
import ae3d.terrain

extern ae3d_farr_count(arr: ptr) -> int
extern ae3d_farr_get(arr: ptr, i: int) -> float

var failures = 0

record_failure(reason: string) {
    println("FAIL ${reason}")
    failures = failures + 1
}

check_true(name: string, condition: bool) {
    if !condition { record_failure(name) }
}

check_near(name: string, got: float, want: float) {
    if core.abs_of(got - want) > 0.0001 { record_failure("${name}: got ${got} want ${want}") }
}

check_int(name: string, got: int, want: int) {
    if got != want { record_failure("${name}: got ${got} want ${want}") }
}

find(m: *Model, name: string) -> *Uniform {
    count = core.model_uniform_count(m)
    i = 0
    while i < count {
        u = core.model_uniform(m, i)
        if u != null && u.name == name { return u }
        i = i + 1
    }
    return null
}

uniform_number(m: *Model, name: string) -> float {
    u = find(m, name)
    if u == null { return 0.0 - 1.0 }
    return u.number
}

uniform_integer(m: *Model, name: string) -> int {
    u = find(m, name)
    if u == null { return 0 - 1 }
    return u.integer
}

uniform_vector(m: *Model, name: string) -> Vec3 {
    u = find(m, name)
    if u == null { return core.vec3(0.0, 0.0, 0.0) }
    return u.vector
}

uniform_array_count(m: *Model, name: string) -> int {
    u = find(m, name)
    if u == null || u.array == null { return 0 - 1 }
    return ae3d_farr_count(u.array)
}

uniform_array_at(m: *Model, name: string, index: int) -> float {
    u = find(m, name)
    if u == null || u.array == null { return 0.0 - 1.0 }
    return ae3d_farr_get(u.array, index)
}

// A scene dropped two things a water surface is made of: the shader that draws
// it, and every array uniform. The arrays were skipped on the reasoning that
// the simulation rebuilds them, but a loaded scene has no simulation, so the
// surface came back as a default-shaded mesh with no wave table.
//
// Contents, not counts: an array restored as the right length full of zeroes
// is a flat sea, and a count check passes on it.
water_roundtrip() {
    directory = "build/scene_water/"
    fs.mkdir_p(directory)
    path = "build/scene_water/scene.json"

    sim = water.simulation_new(40.0, 1.0)
    surface = water.simulation_build(sim, 16)
    if surface == null {
        record_failure("water surface could not be built")
        return
    }

    models = list.new()
    list.add_raw(models, surface as ptr)
    lights = list.new()

    want_kind = surface.shader.kind
    want_uniforms = core.model_uniform_count(surface)
    want_waves = uniform_array_count(surface, "waveFrequencies")
    want_first = uniform_array_at(surface, "waveFrequencies", 0)
    check_true("the surface starts with a wave table", want_waves > 0)
    check_true("the wave table starts with a frequency", want_first != 0.0)

    if !scene.scene_save(models, lights, null, null, path, directory) {
        record_failure("water scene did not save: ${scene.last_error()}")
        return
    }
    loaded = scene.scene_load(path)
    if loaded == null {
        record_failure("water scene did not load: ${scene.last_error()}")
        return
    }
    check_int("water model count", list.size(loaded), 1)
    if list.size(loaded) == 1 {
        back = list.get_raw(loaded, 0) as *Model
        check_true("the surface keeps a shader", core.shader_valid(&back.shader))
        check_int("the surface keeps its shader kind", back.shader.kind, want_kind)
        check_int("the surface keeps every uniform",
                  core.model_uniform_count(back), want_uniforms)
        check_int("the wave table comes back whole",
                  uniform_array_count(back, "waveFrequencies"), want_waves)
        check_near("the wave table comes back with its values",
                   uniform_array_at(back, "waveFrequencies", 0), want_first)
        core.model_free(back)
    }
    list.free(loaded)

    water.simulation_free(sim)
    list.free(models)
    list.free(lights)
}

// The simulation behind a surface, and the view the scene was framed in. A
// scene that keeps the mesh and loses these loads back static, unlit by the
// post chain, and pointing somewhere else.
components_roundtrip() {
    directory = "build/scene_components/"
    fs.mkdir_p(directory)
    path = "build/scene_components/scene.json"

    sim = water.simulation_new(1234.0, 3.5)
    surface = water.simulation_build(sim, 16)
    if surface == null {
        record_failure("water surface could not be built")
        return
    }
    water.simulation_set_color(sim, 0.11, 0.22, 0.33)
    water.simulation_set_opacity(sim, 0.61)
    water.simulation_set_wave_height(sim, 0.77)
    water.simulation_set_caustics(sim, true, 0.44, 0.0055)
    water.simulation_set_foam(sim, false, 0.37)
    water.simulation_set_shadow(sim, 0.29)
    water.simulation_set_wave_scale(sim, 250.0)
    water.simulation_set_shore(sim, 9.0, 3.0)
    water.simulation_set_sky_texture(sim, "resources/sky/desert.png")

    models = list.new()
    list.add_raw(models, surface as ptr)
    attachments = list.new()
    list.add_raw(attachments, scene.attachment_new(surface, "water", "spin", sim, null) as ptr)
    lights = list.new()

    view = scene.view_defaults()
    view.camera_x = 12.0
    view.camera_y = 34.0
    view.camera_z = 56.0
    view.yaw = 0.0 - 33.0
    view.pitch = 12.5
    view.fov = 62.0
    view.far = 4321.0
    view.sky_r = 0.2
    view.sky_g = 0.4
    view.sky_b = 0.6
    view.fxaa = true
    view.bloom = true
    view.bloom_intensity = 1.75
    view.frustum_culling = true
    view.ssao = true
    view.ssao_radius = 7.5
    view.ssao_intensity = 0.8
    view.sky_time = 17.25
    view.overcast = 0.35
    view.weather_kind = 4
    view.weather_intensity = 0.9
    view.wind_heading = 135.0
    view.wind_speed = 12.5

    if !scene.scene_save(models, lights, attachments, &view, path, directory) {
        record_failure("component scene did not save: ${scene.last_error()}")
        return
    }
    loaded = scene.scene_load(path)
    if loaded == null {
        record_failure("component scene did not load: ${scene.last_error()}")
        return
    }

    restored = null as *Simulation
    back = scene.scene_load_attachments(path, loaded)
    check_true("the scene carries what was attached", back != null)
    if back != null {
        check_int("one attachment came back", list.size(back), 1)
        if list.size(back) == 1 {
            a = list.get_raw(back, 0) as *Attachment
            check_true("the component kind came back",
                       string.equals(scene.attachment_component(a), "water") == 1)
            check_true("the script came back",
                       string.equals(scene.attachment_script(a), "spin") == 1)
            w = scene.attachment_water(a)
            check_near("ocean size", water.simulation_size(w), 1234.0)
            check_near("base amplitude", water.simulation_amplitude(w), 3.5)
            check_near("colour red", water.simulation_color_r(w), 0.11)
            check_near("colour blue", water.simulation_color_b(w), 0.33)
            check_near("opacity", water.simulation_opacity(w), 0.61)
            check_near("wave height", water.simulation_wave_height(w), 0.77)
            check_true("caustics stayed on", water.simulation_caustics_on(w))
            check_near("caustics intensity", water.simulation_caustics_intensity(w), 0.44)
            check_near("caustics scale", water.simulation_caustics_scale(w), 0.0055)
            check_near("shadow", water.simulation_shadow(w), 0.29)
            check_near("wave scale", water.simulation_wave_scale(w), 250.0)
            check_near("shore fade", water.simulation_shore_fade(w), 9.0)
            check_near("shore foam", water.simulation_shore_foam(w), 3.0)
            check_true("sky image", water.simulation_sky_path(w) == "resources/sky/desert.png")
            check_true("foam stayed off", !water.simulation_foam_on(w))
            check_near("foam intensity", water.simulation_foam_intensity(w), 0.37)
            // Bound to the surface it drives, or it animates nothing.
            check_true("the simulation adopted the loaded surface",
                       water.simulation_model(w) == list.get_raw(loaded, 0) as *Model)
            // Freed last: it owns the surface it adopted, and the sweep below
            // would otherwise release that model a second time.
            restored = w
        }
        scene.attachments_free(back)
    }

    seen = scene.scene_load_view(path)
    check_near("camera x", seen.camera_x, 12.0)
    check_near("camera y", seen.camera_y, 34.0)
    check_near("camera z", seen.camera_z, 56.0)
    check_near("yaw", seen.yaw, 0.0 - 33.0)
    check_near("pitch", seen.pitch, 12.5)
    check_near("fov", seen.fov, 62.0)
    check_near("far", seen.far, 4321.0)
    check_near("sky green", seen.sky_g, 0.4)
    check_true("fxaa stayed on", seen.fxaa)
    check_true("bloom stayed on", seen.bloom)
    check_near("bloom intensity", seen.bloom_intensity, 1.75)
    check_true("frustum culling stayed on", seen.frustum_culling)
    check_true("occlusion stayed on", seen.ssao)
    check_near("the hour the sun is set by", seen.sky_time, 17.25)
    check_near("occlusion reach", seen.ssao_radius, 7.5)
    check_near("occlusion strength", seen.ssao_intensity, 0.8)
    check_near("the overcast", seen.overcast, 0.35)
    check_true("the weather's kind, by name", seen.weather_kind == 4)
    check_near("how hard", seen.weather_intensity, 0.9)
    check_near("the wind's heading", seen.wind_heading, 135.0)
    check_near("the wind's speed", seen.wind_speed, 12.5)

    // A file with no view at all opens the way it always did, rather than at
    // the origin under a black sky.
    plain = scene.view_defaults()
    older = scene.scene_load_view("build/scene_roundtrip/scene.json")
    check_near("a scene with no view keeps the default fov", older.fov, plain.fov)
    check_near("a scene with no view keeps the default far", older.far, plain.far)

    // The restored simulation owns the surface it adopted; every other loaded
    // model is this test's to release.
    adopted = null as *Model
    if restored != null { adopted = water.simulation_model(restored) }
    i = 0
    while i < list.size(loaded) {
        m = list.get_raw(loaded, i) as *Model
        if m != null && m != adopted { core.model_free(m) }
        i = i + 1
    }
    if restored != null { water.simulation_free(restored) }
    list.free(loaded)
    list.free(models)
    scene.attachments_free(attachments)
    list.free(lights)
    water.simulation_free(sim)
}

// A voxel world is carried as what it takes to fill one again, so the world
// that comes back has to be the SAME world, voxel for voxel, and not merely a
// world of the same size.
voxel_roundtrip() {
    directory = "build/scene_voxel/"
    fs.mkdir_p(directory)
    path = "build/scene_voxel/scene.json"

    world = voxel.world_new(24, 24, 20, 3.5)
    if world == null {
        record_failure("no voxel world")
        return
    }
    terrain.fill_seeded(world, 4242, terrain.MOUNTAINS)
    // Then sculpted: a hill raised at one corner and a hollow dug at the
    // other, which the seed does not make and the file has to carry.
    voxel.world_set_column_height(world, 3, 4, voxel.world_column_height(world, 3, 4) + 5)
    voxel.world_set_column_height(world, 20, 19, 1)
    hill = voxel.world_column_height(world, 3, 4)
    before = voxel.world_active_count(world)
    before_visible = voxel.world_visible_count(world)

    base = loader.cube(3.5)
    chunk = voxel.world_build(world, base)
    if chunk == null {
        record_failure("voxel chunk would not build")
        return
    }

    models = list.new()
    list.add_raw(models, chunk as ptr)
    attachments = list.new()
    list.add_raw(attachments,
                 scene.attachment_new(chunk, "voxel", "", null, world) as ptr)
    lights = list.new()
    view = scene.view_defaults()

    if !scene.scene_save(models, lights, attachments, &view, path, directory) {
        record_failure("voxel scene did not save: ${scene.last_error()}")
        return
    }
    loaded = scene.scene_load(path)
    if loaded == null {
        record_failure("voxel scene did not load: ${scene.last_error()}")
        return
    }

    back = scene.scene_load_attachments(path, loaded)
    check_true("the scene carries its voxel world", back != null)
    if back != null && list.size(back) == 1 {
        a = list.get_raw(back, 0) as *Attachment
        w = scene.attachment_world(a)
        check_true("a world came back", w != null)
        if w != null {
            check_int("size x", voxel.world_size_x(w), 24)
            check_int("size z", voxel.world_size_z(w), 24)
            check_int("height", voxel.world_max_height(w), 20)
            check_near("voxel size", voxel.world_voxel_size(w), 3.5)
            // The same seed and the same biome, so the same voxels: a world
            // rebuilt from the wrong ones has a plausible count and is a
            // different landscape.
            check_int("the same voxels came back", voxel.world_active_count(w), before)
            check_int("the same faces are exposed", voxel.world_visible_count(w), before_visible)
            check_int("it remembers its biome", voxel.world_origin_kind(w), terrain.MOUNTAINS)
            check_int("the raised hill came back", voxel.world_column_height(w, 3, 4), hill)
            check_int("the dug hollow came back", voxel.world_column_height(w, 20, 19), 1)
            voxel.world_free(w)
        }
        scene.attachments_free(back)
    }

    i = 0
    while i < list.size(loaded) {
        m = list.get_raw(loaded, i) as *Model
        if m != null { core.model_free(m) }
        i = i + 1
    }
    list.free(loaded)
    core.model_free(chunk)
    voxel.world_free(world)
    list.free(models)
    scene.attachments_free(attachments)
    list.free(lights)
}

main() {
    directory = "build/scene_roundtrip/"
    fs.mkdir_p(directory)
    scene_path = "build/scene_roundtrip/scene.json"

    models = list.new()

    // A model that came from a file records its path and reloads through the
    // loader, so its geometry is not written out.
    loaded = loader.load_obj("resources/obj/Cube.obj", false)
    check_true("source model loaded", loaded != null)
    if loaded == null { return }
    core.model_set_position(loaded, 3.0, 4.0, 5.0)
    core.model_set_scale(loaded, 2.0, 2.0, 2.0)
    core.model_set_rotation(loaded, core.quat_rotate(core.deg_to_rad(30.0),
                                                      core.vec3(0.0, 1.0, 0.0)))
    core.model_glossy(loaded, 0.2, 0.6, 0.9)
    core.model_set_alpha(loaded, 0.75)
    core.model_set_reflectivity(loaded, 0.6)
    core.material_set_normal_path(loaded.material, "resources/textures/sand_normal.png")
    // Every shading setting lives in a model's own uniforms, and a model told
    // not to cast a shadow says so in a flag of its own. A scene that saves
    // neither loads back looking nothing like the one that was saved.
    shading = rendering.high_quality_config()
    shading.gi_intensity = 0.42
    shading.caustics = true
    shading.sheen_g = 0.25
    rendering.apply(loaded, shading)
    core.model_set_casts_shadow(loaded, false)
    list.add_raw(models, loaded)

    // A procedural model has no source, so its geometry is written beside the
    // scene and must come back byte for byte.
    generated = loader.sphere(1.0, 16, 12)
    core.model_set_position(generated, 0.0 - 7.0, 1.0, 0.0)
    core.model_matte(generated, 0.9, 0.3, 0.1)
    list.add_raw(models, generated)

    // An instanced model carries its matrices and colours through the same file.
    world = voxel.world_new(4, 4, 4, 2.0)
    x = 0
    while x < 4 {
        y = 0
        while y < 4 {
            z = 0
            while z < 4 {
                voxel.world_set(world, x, y, z, voxel.GRASS)
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
    blocks = voxel.world_build(world, loader.cube(2.0))
    check_true("instanced model built", blocks != null)
    list.add_raw(models, blocks)

    // A second model from the same file: the file is read once and both
    // come back, each with its own transform and its own mesh.
    twin = loader.load_obj("resources/obj/Cube.obj", false)
    core.model_set_position(twin, 30.0, 0.0, 0.0)
    core.model_matte(twin, 0.1, 0.1, 0.1)
    list.add_raw(models, twin)

    source_vertices = core.mesh_vertex_count(generated.mesh)
    source_indices = core.mesh_index_count(generated.mesh)
    source_instances = core.model_instance_count(blocks)

    // A scene is what the renderer draws, and half of that is how it is lit.
    lights = list.new()
    sun = core.light_sun(core.vec3(0.3, 0.8, 0.5))
    sun.intensity = 2.75
    sun.ambient_strength = 0.42
    sun.color = core.vec3(0.9, 0.8, 0.6)
    core.light_set_name(sun, "key")
    list.add_raw(lights, sun)

    if !scene.scene_save(models, lights, null, null, scene_path, directory) {
        record_failure("saved: ${scene.last_error()}")
    }
    check_true("scene file exists", fs.exists(scene_path) == 1)

    restored = scene.scene_load(scene_path)
    check_true("loaded", restored != null)
    if restored == null {
        println("  ${scene.last_error()}")
        return
    }
    check_int("model count", list.size(restored), 4)
    if list.size(restored) == 4 {
        back_twin = list.get_raw(restored, 3) as *Model
        first = list.get_raw(restored, 0) as *Model
        check_near("the second model from the file keeps its own position", back_twin.position.x, 30.0)
        check_near("and its own material", back_twin.material.diffuse.x, 0.1)
        check_near("the first keeps its own", first.material.diffuse.x, 0.2)
        check_true("the two have meshes of their own", back_twin.mesh != first.mesh)
        check_int("with the same vertices", core.mesh_vertex_count(back_twin.mesh), core.mesh_vertex_count(first.mesh))
    }

    beams = scene.scene_load_lights(scene_path)
    check_true("the scene came back with its lights", beams != null)
    if beams != null {
        check_int("light count", list.size(beams), 1)
        back_sun = list.get_raw(beams, 0) as *Light
        check_near("light intensity", back_sun.intensity, 2.75)
        check_near("light ambient", back_sun.ambient_strength, 0.42)
        check_near("light colour g", back_sun.color.y, 0.8)
        check_near("light direction y", back_sun.direction.y, sun.direction.y)
        check_true("light name", back_sun.name == "key")
        core.light_free(back_sun)
        list.free(beams)
    }

    back_loaded = list.get_raw(restored, 0) as *Model
    check_near("position x", back_loaded.position.x, 3.0)
    check_near("position z", back_loaded.position.z, 5.0)
    check_near("scale y", back_loaded.scale.y, 2.0)
    check_near("rotation y", back_loaded.rotation.y, loaded.rotation.y)
    check_near("alpha", back_loaded.material.alpha, 0.75)
    check_near("diffuse b", back_loaded.material.diffuse.z, 0.9)
    check_near("reflectivity came back", back_loaded.material.reflectivity, 0.6)
    check_true("normal map path came back",
               core.text(back_loaded.material.normal_path) == "resources/textures/sand_normal.png")
    check_true("name round-tripped", back_loaded.name == "Cube.obj")
    check_near("a setting came back", uniform_number(back_loaded, "giIntensity"), 0.42)
    check_int("a switch came back", uniform_integer(back_loaded, "enableCaustics"), 1)
    check_near("a colour came back", uniform_vector(back_loaded, "sheenColor").y, 0.25)
    check_true("not casting a shadow came back", !back_loaded.casts_shadow)
    check_true("reloaded from its source", core.mesh_vertex_count(back_loaded.mesh) ==
                                            core.mesh_vertex_count(loaded.mesh))

    back_generated = list.get_raw(restored, 1) as *Model
    check_int("procedural vertices", core.mesh_vertex_count(back_generated.mesh), source_vertices)
    check_int("procedural indices", core.mesh_index_count(back_generated.mesh), source_indices)
    check_near("procedural position x", back_generated.position.x, 0.0 - 7.0)

    // Geometry must survive the float32 round trip exactly.
    worst = 0.0
    i = 0
    while i < source_vertices {
        before = core.mesh_position(generated.mesh, i)
        after = core.mesh_position(back_generated.mesh, i)
        error = core.v3_len(core.v3_sub(before, after))
        if error > worst { worst = error }
        i = i + 1
    }
    check_true("procedural geometry is identical", worst == 0.0)

    mismatched = 0
    i = 0
    while i < source_indices {
        if core.mesh_index_at(generated.mesh, i) != core.mesh_index_at(back_generated.mesh, i) {
            mismatched = mismatched + 1
        }
        i = i + 1
    }
    check_int("procedural indices are identical", mismatched, 0)

    back_blocks = list.get_raw(restored, 2) as *Model
    check_true("instancing survived", back_blocks.is_instanced)
    check_int("instance count", core.model_instance_count(back_blocks), source_instances)

    scene.scene_free(restored)
    list.free(models)
    list.free(lights)
    core.light_free(sun)
    core.model_free(loaded)
    core.model_free(generated)
    core.model_free(blocks)
    core.model_free(twin)
    voxel.world_free(world)

    // A file that lists models and produces none did not load, whatever it says
    // about itself: handing back an empty list looks exactly like a scene that
    // was saved empty, and the reason would go unread.
    broken_path = "build/scene_roundtrip/broken.json"
    handle, open_err = file.open(broken_path, "w")
    if handle == null {
        record_failure("cannot write the broken scene: ${open_err}")
    } else {
        text = "{\"version\":1,\"models\":[{\"name\":\"gone\",\"mesh_file\":\"build/scene_roundtrip/not_here.mesh\"}]}"
        file.file_write_raw(handle, text, string.length(text))
        file.file_close(handle)
        check_true("a scene whose models cannot be built is refused",
                   scene.scene_load(broken_path) == null)
    }

    // What it can build, it keeps: one model missing its mesh does not lose the
    // rest of the scene.
    partial_path = "build/scene_roundtrip/partial.json"
    original, read_err = fs.read(scene_path)
    if read_err != "" {
        record_failure("cannot read the saved scene: ${read_err}")
    } else {
        broken_entry = "{\"name\":\"gone\",\"mesh_file\":\"build/scene_roundtrip/not_here.mesh\"},"
        with_broken = string.concat("\"models\":[", broken_entry)
        patched = string.replace(original, "\"models\":[", with_broken)
        string.free(with_broken)
        write_err = fs.write(partial_path, patched)
        string.free(patched)
        if write_err != "" {
            record_failure("cannot write the partial scene: ${write_err}")
        } else {
            partial = scene.scene_load(partial_path)
            check_true("a scene keeps the models it can build", partial != null)
            if partial != null {
                check_int("partial model count", list.size(partial), 4)
                i = 0
                while i < list.size(partial) {
                    core.model_free(list.get_raw(partial, i) as *Model)
                    i = i + 1
                }
                list.free(partial)
            }
        }
    }
    string.free(original)

    water_roundtrip()
    components_roundtrip()
    voxel_roundtrip()

    if failures == 0 {
        println("scene io: all checks passed")
    } else {
        println("scene io: ${failures} failure(s)")
    }
}
