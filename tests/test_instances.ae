// An instance that moves or changes colour has to reach the GPU.
//
// The buffer holding every instance's transform and colour is uploaded when the
// model is registered with a renderer. Something has to send it again when it
// changes, or a particle system draws its first frame forever and a voxel world
// cannot recolour a block. Both backends had a hole here and neither was
// noticed: the suites draw instanced geometry and never move it.

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.vk
import ae3d.offscreen
import ae3d.loader

const WIDTH = 176
const HEIGHT = 132
const PIXELS = WIDTH * HEIGHT * 4
const COPIES = 4

var failures = 0

check_true(name: string, ok: bool) {
    if !ok {
        println("FAIL ${name}")
        failures = failures + 1
    }
}

check_int(name: string, got: int, want: int) {
    if got != want {
        println("FAIL ${name}: got ${got} want ${want}")
        failures = failures + 1
    }
}

// The OpenGL path reads back through a pair of buffers, so the frame just drawn
// is the second read rather than the first.
frame_total(backend: *Backend, cam: *Camera, light: *Light) -> int {
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    pixels = core.backend_frame_pixels(backend)
    total = 0
    i = 0
    while i < PIXELS {
        total = total + mem.get_byte(pixels, i)
        i = i + 1
    }
    return total
}

// Pixels where red clearly beats blue. One instance is red and the rest are
// blue, so this counts the red one and nothing else. A sum over the whole frame
// cannot do that: a colour landing on the wrong instance moves the same bytes
// somewhere else and the total barely shifts.
red_pixels(backend: *Backend, cam: *Camera, light: *Light) -> int {
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    pixels = core.backend_frame_pixels(backend)
    found = 0
    i = 0
    while i < WIDTH * HEIGHT {
        offset = i * 4
        r = mem.get_byte(pixels, offset)
        b = mem.get_byte(pixels, offset + 2)
        if r > 60 && r > b + 40 { found = found + 1 }
        i = i + 1
    }
    return found
}

run_checks(backend: *Backend, name: string) {
    core.backend_set_clear_color(backend, 0.0, 0.0, 0.0)

    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 0.0, 95.0))
    light = core.light_sun(core.vec3(0.3, 0.8, 0.5))

    cubes = loader.cube(6.0)
    check_true("${name} instancing is available", core.model_enable_instancing(cubes, COPIES))
    check_true("${name} instance colours are available", core.model_enable_instance_colors(cubes))
    i = 0
    while i < COPIES {
        core.model_set_instance_position(cubes, i,
            core.vec3(0.0 - 24.0 + (i * 1.0) * 16.0, 0.0, 0.0))
        core.model_set_instance_color(cubes, i, 0.9, 0.2, 0.2)
        i = i + 1
    }
    core.backend_add_model(backend, cubes)

    red = frame_total(backend, cam, light)
    check_true("${name} the instances were drawn", red > 0)

    i = 0
    while i < COPIES {
        core.model_set_instance_color(cubes, i, 0.1, 0.3, 0.95)
        i = i + 1
    }
    blue = frame_total(backend, cam, light)
    check_true("${name} a colour change reaches the frame", blue != red)

    i = 0
    while i < COPIES {
        core.model_set_instance_position(cubes, i,
            core.vec3(0.0 - 24.0 + (i * 1.0) * 16.0, 18.0, 0.0))
        i = i + 1
    }
    moved = frame_total(backend, cam, light)
    check_true("${name} a move reaches the frame", moved != blue)

    // And nothing keeps re-sending it: drawing the same instances again has to
    // give the same frame.
    settled = frame_total(backend, cam, light)
    check_true("${name} an unchanged stream draws the same", settled == moved)

    // Removing an instance shifts every colour after it down one. The matrices
    // shift too, and only the matrices were being sent again, so on OpenGL each
    // surviving instance kept wearing the colour of the one before it. Nothing
    // caught it, because the instanced suites only ever added instances.
    i = 0
    while i < COPIES {
        core.model_set_instance_position(cubes, i,
            core.vec3(0.0 - 24.0 + (i * 1.0) * 16.0, 0.0, 0.0))
        if i == 0 {
            core.model_set_instance_color(cubes, i, 0.95, 0.05, 0.05)
        } else {
            core.model_set_instance_color(cubes, i, 0.05, 0.05, 0.95)
        }
        i = i + 1
    }
    check_true("${name} the one red instance is on screen",
               red_pixels(backend, cam, light) > 0)

    core.model_remove_instance(cubes, 0)
    check_int("${name} the instance count dropped", core.model_instance_count(cubes),
              COPIES - 1)
    check_true("${name} removing the red instance takes its colour with it",
               red_pixels(backend, cam, light) == 0)

    core.backend_remove_model(backend, cubes)
    core.model_free(cubes)
    core.camera_free(cam)
    core.light_free(light)
}

main() {
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("instances: SKIP no OpenGL context")
        return
    }

    renderer = gl.renderer_new()
    gl_pass = gl.backend(renderer)
    if !core.backend_init(&gl_pass, context, WIDTH, HEIGHT) {
        println("instances: SKIP the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    run_checks(&gl_pass, "opengl")
    core.backend_cleanup(&gl_pass)
    offscreen.target_destroy(target)
    gl.renderer_free(renderer)
    offscreen.context_destroy(context)

    if !vk.available() {
        println("instances: no Vulkan driver (${vk.last_error()}), checked OpenGL only")
    } else {
        vk_renderer = vk.renderer_new()
        vk_pass = vk.backend(vk_renderer)
        if !core.backend_init(&vk_pass, null, WIDTH, HEIGHT) {
            println("instances: SKIP Vulkan would not start (${vk.last_error()})")
        } else {
            run_checks(&vk_pass, "vulkan")
            core.backend_cleanup(&vk_pass)
        }
        vk.renderer_free(vk_renderer)
    }

    if failures == 0 {
        println("instances: all checks passed")
    } else {
        println("instances: ${failures} failure(s)")
    }
}
