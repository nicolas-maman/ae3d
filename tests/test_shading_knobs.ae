// Every shading setting has to change the picture.
//
// Settings are uploaded by name, and a name the shader does not read is a knob
// that turns nothing: the config carried eight of them, some wired to public
// setters, and no test could tell. Each check here renders a scene twice, once
// with a setting at its preset value and once moved, and the two frames have to
// differ. A setting that changes nothing is a setting that does nothing.

import std.mem
import ae3d.core
import ae3d.gl
import ae3d.offscreen
import ae3d.loader
import ae3d.rendering
import ae3d.water

const WIDTH = 200
const HEIGHT = 150

var failures = 0

struct Scene {
    backend: *Backend
    camera: *Camera
    light: *Light
    ball: *Model
    ground: *Model
}

frame_sum(pixels: ptr) -> int {
    total = 0
    i = 0
    while i < WIDTH * HEIGHT * 4 {
        total = total + mem.get_byte(pixels, i)
        i = i + 1
    }
    return total
}

// The target hands back the frame before the one just drawn, so the read that
// matters is the second one.
render(s: *Scene, c: Config) -> int {
    rendering.apply(s.ball, c)
    rendering.apply(s.ground, c)
    core.backend_render(s.backend, s.camera, s.light)
    core.backend_frame_pixels(s.backend)
    return frame_sum(core.backend_frame_pixels(s.backend))
}

check_changes(s: *Scene, name: string, base: int, moved: Config) {
    after = render(s, moved)
    if after == base {
        println("FAIL ${name} changes nothing")
        failures = failures + 1
    }
}

// The water program has its own settings, and three of them were wired to a
// public setter and read by nothing at all.
water_frame(backend: *Backend, cam: *Camera, light: *Light, sim: *Simulation) -> int {
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    return frame_sum(core.backend_frame_pixels(backend))
}

// A tenth of a percent, which is a thousand times the drift between two renders
// of the same scene and a small fraction of what any of these settings does.
// In floats: a frame sum is tens of millions, and a change of a fifth of
// it times a thousand is past what an int holds, so the check that a big
// change moved the frame came back false for being too big.
moved(after: int, before: int) -> bool {
    drift = (after - before) as float
    if drift < 0.0 { drift = 0.0 - drift }
    return drift * 1000.0 > (before as float)
}

check_water(backend: *Backend, cam: *Camera, bright: *Light) {
    // The surface multiplies what it gathers by the light, and the scene above
    // asks for six suns: under those, every water pixel is already white and
    // nothing anyone turns can show.
    light = core.light_sun(core.vec3(0.6, 0.9, 0.4))
    light.intensity = 1.0

    sim = water.simulation_new(6000.0, 20.0)
    // Waves hundreds of metres long, as a sea has: the table's own
    // kilometre swells at twenty metres are a plain with no slope to foam on.
    water.simulation_set_wave_scale(sim, 30.0)
    water.simulation_set_color(sim, 0.06, 0.22, 0.45)
    water.simulation_set_sky_color(sim, 0.5, 0.7, 1.0)
    surface = water.simulation_build(sim, 64)
    if surface == null {
        println("FAIL the water surface would not build")
        failures = failures + 1
        return
    }
    core.model_set_position(surface, 0.0, 0.0 - 60.0, 0.0)
    core.backend_add_model(backend, surface)

    // Every one of these is set through the simulation and has to reach the
    // surface without anyone asking twice: they used to write a field that was
    // read at build time and never again.
    base = water_frame(backend, cam, light, sim)


    // Off rather than past full: the mirror's strength is clamped to one,
    // and six of it is the one the base already has.
    water.simulation_set_reflection(sim, 0.0)
    if !moved(water_frame(backend, cam, light, sim), base) {
        println("FAIL water reflection changes nothing")
        failures = failures + 1
    }
    water.simulation_set_reflection(sim, 1.0)

    water.simulation_set_distortion(sim, 12.0)
    if water_frame(backend, cam, light, sim) == base {
        println("FAIL water distortion changes nothing")
        failures = failures + 1
    }
    water.simulation_set_distortion(sim, 0.2)

    water.simulation_set_normal_strength(sim, 0.0)
    if water_frame(backend, cam, light, sim) == base {
        println("FAIL water normal strength changes nothing")
        failures = failures + 1
    }
    water.simulation_set_normal_strength(sim, 1.0)

    // How high the waves stand, which the wave table is derived from, so it is
    // not one uniform going out but the table being rebuilt.
    // Not merely different: two renders of the same water differ by a hundred
    // parts in ten million on this driver, so a setting has to move the frame
    // by more than that to have done anything.
    water.simulation_set_amplitude(sim, 90.0)
    if !moved(water_frame(backend, cam, light, sim), base) {
        println("FAIL water amplitude changes nothing")
        failures = failures + 1
    }
    water.simulation_set_amplitude(sim, 20.0)

    // Foam was three constants in the shading with no way in, so a caller could
    // not turn it down for a still lake or up for a rough sea.
    foam_on = water_frame(backend, cam, light, sim)
    water.simulation_set_foam(sim, false, 1.0)
    if !moved(water_frame(backend, cam, light, sim), foam_on) {
        println("FAIL water foam cannot be turned off")
        failures = failures + 1
    }
    water.simulation_set_foam(sim, true, 8.0)
    if !moved(water_frame(backend, cam, light, sim), foam_on) {
        println("FAIL water foam intensity changes nothing")
        failures = failures + 1
    }
    water.simulation_set_foam(sim, true, 1.0)

    // Foam has to survive a rougher sea. It used to be measured against the sum
    // of the wave amplitudes, which is what the water reaches only where all
    // four crest together: past twice the default amplitude no pixel ever
    // cleared the bar and foam disappeared entirely, which is backwards.
    water.simulation_set_amplitude(sim, 80.0)
    heavy_on = water_frame(backend, cam, light, sim)
    water.simulation_set_foam(sim, false, 1.0)
    if water_frame(backend, cam, light, sim) == heavy_on {
        println("FAIL foam vanishes on a rough sea")
        failures = failures + 1
    }
    water.simulation_set_foam(sim, true, 1.0)
    water.simulation_set_amplitude(sim, 20.0)

    water.simulation_set_opacity(sim, 0.2)
    if water_frame(backend, cam, light, sim) == base {
        println("FAIL water opacity changes nothing")
        failures = failures + 1
    }
    water.simulation_set_opacity(sim, 0.85)
    settled = water_frame(backend, cam, light, sim)


    // The scene's fog reaches the water. The surface used to carry a haze of
    // its own that overrode whatever the scene set, so a dust storm that
    // buried the island left the sea beside it blue; and before that a local
    // of the fog colour's name hid the uniform, so the surface faded into a
    // shade nobody chose.
    fog = core.fog_distance(1.0, 40.0, core.vec3(1.0, 0.2, 0.05), 1.0)
    core.backend_set_fog(backend, &fog)
    core.backend_render(backend, cam, light)
    core.backend_frame_pixels(backend)
    if frame_sum(core.backend_frame_pixels(backend)) == settled {
        println("FAIL the scene's fog does not reach the water")
        failures = failures + 1
    }
    clear_air = core.fog_none()
    core.backend_set_fog(backend, &clear_air)

    core.backend_remove_model(backend, surface)
    water.simulation_free(sim)
    core.light_free(light)
}

// Counts pixels where blue clearly beats red. The scene's ground and ball are
// both warm, so a check counting red would be satisfied by what is already
// there: the first version of this check passed with the fix removed, because
// the ball alone cleared its threshold.
blue_pixels(pixels: ptr) -> int {
    found = 0
    i = 0
    while i < WIDTH * HEIGHT {
        offset = i * 4
        r = mem.get_byte(pixels, offset)
        b = mem.get_byte(pixels, offset + 2)
        if b > 90 && b > r + 50 { found = found + 1 }
        i = i + 1
    }
    return found
}

count_blue(pass: *Backend, cam: *Camera, light: *Light) -> int {
    core.backend_render(pass, cam, light)
    core.backend_frame_pixels(pass)
    return blue_pixels(core.backend_frame_pixels(pass))
}

// A model loaded from a file is drawn group by group, and a group carries a
// material only when the file gave it one: an OBJ whose mtllib line is
// commented out, or which names a material no mtl defines, produces groups with
// none. Those were drawn white, and the model's own material, which is the only
// one a caller can set from outside, was never consulted. So every colour set
// on a loaded model was silently dropped, and the models example rendered a
// gold sphere and a blue cube in the same cream.
//
// Measured as a difference rather than a total, so what is already in the scene
// cannot answer for the model under test.
check_group_without_material(pass: *Backend, cam: *Camera, light: *Light) {
    before = count_blue(pass, cam, light)

    m = loader.sphere(1.0, 24, 18)
    core.model_set_scale(m, 44.0, 44.0, 44.0)
    core.model_set_position(m, 0.0, 26.0, 0.0)

    // The shape a loader leaves behind: one group covering the whole mesh, with
    // no material of its own.
    core.model_add_group(m, null, 0, core.mesh_index_count(m.mesh))
    core.model_set_diffuse(m, 0.05, 0.1, 0.95)
    core.backend_add_model(pass, m)

    after = count_blue(pass, cam, light)

    if after - before < 200 {
        println("FAIL a colour set on a model whose group has no material never reaches the frame (${before} blue pixels before, ${after} after)")
        failures = failures + 1
    }

    core.backend_remove_model(pass, m)
    core.model_free(m)
}

main() {
    context = offscreen.context_create(WIDTH, HEIGHT)
    if context == null {
        println("shading knobs: SKIP no OpenGL context")
        return
    }

    renderer = gl.renderer_new()
    pass = gl.backend(renderer)
    if !core.backend_init(&pass, context, WIDTH, HEIGHT) {
        println("shading knobs: SKIP the OpenGL backend would not initialise")
        return
    }
    target = offscreen.target_create(WIDTH, HEIGHT)
    gl.renderer_set_target(renderer, target)
    gl.renderer_set_clear_color(renderer, 0.05, 0.07, 0.1)
    core.backend_set_shadows(&pass, true)

    // An ordinary scene, a few hundred units across. Every setting has to show
    // here: fading a feature out by how far the camera can see rather than by a
    // count of world units is what makes that true of volumetric lighting. The
    // light is strong because a surface has to gather more than it can keep
    // before energy conservation has anything to conserve.
    ground = loader.plane(24, 24.0)
    core.model_set_position(ground, 0.0 - 276.0, 0.0 - 40.0, 0.0 - 276.0)
    core.model_set_diffuse(ground, 0.7, 0.68, 0.62)
    core.backend_add_model(&pass, ground)

    ball = loader.sphere(1.0, 32, 24)
    core.model_set_scale(ball, 42.0, 42.0, 42.0)
    core.model_set_position(ball, 0.0, 26.0, 0.0)
    core.model_set_diffuse(ball, 0.75, 0.35, 0.3)
    core.model_set_pbr(ball, 0.2, 0.35)
    core.backend_add_model(&pass, ball)

    cam = core.camera_new(WIDTH, HEIGHT)
    core.camera_set_position(cam, core.vec3(0.0, 150.0, 260.0))
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    core.camera_set_far(cam, 1200.0)
    light = core.light_sun(core.vec3(0.6, 0.9, 0.4))
    light.intensity = 6.0

    scene = Scene {
        backend: &pass,
        camera: cam,
        light: light,
        ball: ball,
        ground: ground
    }

    base_config = rendering.default_config()
    base = render(&scene, base_config)

    c = base_config
    c.clearcoat = true
    c.clearcoat_intensity = 1.0
    check_changes(&scene, "clearcoat", base, c)

    c = base_config
    c.sheen = true
    c.sheen_r = 1.0
    c.sheen_g = 0.4
    c.sheen_b = 0.1
    check_changes(&scene, "sheen", base, c)

    c = base_config
    c.transmission = true
    c.transmission_factor = 0.9
    check_changes(&scene, "transmission", base, c)

    c = base_config
    c.multiple_scattering = false
    check_changes(&scene, "multiple scattering", base, c)

    c = base_config
    c.energy_conservation = false
    check_changes(&scene, "energy conservation", base, c)

    c = base_config
    c.image_based_lighting = false
    check_changes(&scene, "image based lighting", base, c)

    c = base_config
    c.ibl_intensity = 4.0
    check_changes(&scene, "image based lighting strength", base, c)

    c = base_config
    c.perlin_noise = true
    c.noise_scale = 0.05
    c.noise_intensity = 1.0
    check_changes(&scene, "procedural noise", base, c)

    c = base_config
    c.advanced_shadows = false
    check_changes(&scene, "receiving shadows", base, c)

    c = base_config
    c.shadow_intensity = 1.0
    check_changes(&scene, "shadow strength", base, c)

    c = base_config
    c.shadow_softness = 8.0
    check_changes(&scene, "shadow softness", base, c)

    c = base_config
    c.volumetric_lighting = true
    c.volumetric_intensity = 4.0
    check_changes(&scene, "volumetric lighting", base, c)

    c = base_config
    c.global_illumination = true
    c.gi_intensity = 3.0
    check_changes(&scene, "global illumination", base, c)

    c = base_config
    c.caustics = true
    c.caustics_water_level = 200.0
    c.caustics_depth = 400.0
    c.caustics_intensity = 2.0
    c.caustics_scale = 0.05
    check_changes(&scene, "caustics", base, c)

    c = base_config
    c.bloom = true
    c.bloom_threshold = 0.1
    c.bloom_intensity = 3.0
    check_changes(&scene, "bloom", base, c)

    // Not a config setting, but the same kind of promise: a material's specular
    // colour is what a dielectric reflects, and it was read by nothing.
    core.model_set_specular(ball, 0.1, 0.9, 0.2)
    if render(&scene, base_config) == base {
        println("FAIL specular colour changes nothing")
        failures = failures + 1
    }
    core.model_set_specular(ball, 1.0, 1.0, 1.0)

    // Rain on the scene: the ground, which faces up, goes darker and a
    // mirror at a grazing angle; the sphere's sides hardly change.
    gl.renderer_set_wetness(renderer, 1.0)
    if !moved(render(&scene, base_config), base) {
        println("FAIL wetness changes nothing")
        failures = failures + 1
    }
    gl.renderer_set_wetness(renderer, 0.0)

    check_water(&pass, cam, light)

    check_group_without_material(&pass, cam, light)

    core.backend_cleanup(&pass)
    offscreen.target_destroy(target)
    offscreen.context_destroy(context)
    core.model_free(ball)
    core.model_free(ground)
    gl.renderer_free(renderer)
    core.camera_free(cam)
    core.light_free(light)

    if failures == 0 {
        println("shading knobs: all checks passed, every setting changes the picture")
    } else {
        println("shading knobs: ${failures} setting(s) do nothing")
    }
}
