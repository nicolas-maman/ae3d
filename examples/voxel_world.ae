// Perlin terrain drawn as one instanced draw call, with a colour per voxel type.
//
//   ./build.sh examples/voxel_world.ae && ./build/voxel_world

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.behaviour
import ae3d.noise
import ae3d.voxel
import ae3d.rendering
import ae3d.water
import ae3d.sky

extern clock_ns() -> long

// Four times the voxels of the first cut: the same 768 m of ground at two
// metres a voxel instead of four, and twice the height to carve it in.
const WORLD_X = 384
const WORLD_Z = 384
const WORLD_HEIGHT = 96
const VOXEL_SIZE = 2.0
// The lowest ground is sand, and the sand is a shore: a sea lies at this
// many voxels up.
const SEA_VOXELS = 15
// The sun as tools/make_sky.ae painted it into the desert sky, and the
// haze that sky has at its horizon.
const SUN_X = 0.0 - 0.263
const SUN_Y = 0.581
const SUN_Z = 0.0 - 0.770
const HAZE_R = 0.86
const HAZE_G = 0.80
const HAZE_B = 0.70

var g_sea: ptr = null

var g_world: ptr = null

layer_at(height: int, y: int) -> int {
    if y == height - 1 {
        if height < SEA_VOXELS + 3 { return voxel.SAND }
        if height > 46 { return voxel.STONE }
        return voxel.GRASS
    }
    if y > height - 9 { return voxel.DIRT }
    return voxel.STONE
}

// One noise lookup per column rather than per voxel: the terrain is a height
// field, so sampling it once and filling downward is the whole difference
// between a fast build and a slow one.
build_terrain(world: *World) {
    field = noise.perlin_new(20260902)
    if field == null { return }

    x = 0
    while x < voxel.world_size_x(world) {
        z = 0
        while z < voxel.world_size_z(world) {
            sample = noise.fbm2(field, (x * 1.0) * 0.009, (z * 1.0) * 0.009, 6, 0.5)
            ridged = noise.ridge(field, (x * 1.0) * 0.002, 0.0, (z * 1.0) * 0.002, 3, 0.5)
            normalised = (sample + 1.0) * 0.5
            land = 8.0 + normalised * 52.0 + ridged * 28.0
            // An island: the land falls away toward the world's edges, under
            // the sea, so the block is not a cake cut square at its sides.
            dx = (x as float) - (WORLD_X as float) * 0.5
            dz = (z as float) - (WORLD_Z as float) * 0.5
            shore = core.sqrt_of(dx * dx + dz * dz) / ((WORLD_X as float) * 0.5)
            keep = 1.0 - (shore - 0.60) / 0.36
            if keep > 1.0 { keep = 1.0 }
            if keep < 0.0 { keep = 0.0 }
            keep = keep * keep * (3.0 - 2.0 * keep)
            height = (4.0 + (land - 4.0) * keep) as int
            if height < 1 { height = 1 }
            if height > WORLD_HEIGHT { height = WORLD_HEIGHT }

            y = 0
            while y < height {
                voxel.world_set(world, x, y, z, layer_at(height, y))
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }

    plant_forest(world, field)
    noise.perlin_free(field)
}

// Trees on the grass: a trunk of wood and a crown of leaves, where a slow
// noise says the woods are and a fast hash says which columns in them get
// one, so they stand in clumps with clearings and not on a grid. Each is
// built from the column's own height, the crown a blunt cone over a
// canopy three wide, in voxels. Nothing on sand, stone or a slope that
// falls more than a voxel a step: trees keep to the flats.
plant_forest(world: *World, field: *Perlin) {
    planted = 0
    x = 3
    while x < voxel.world_size_x(world) - 3 {
        z = 3
        while z < voxel.world_size_z(world) - 3 {
            woods = noise.fbm2(field, (x * 1.0) * 0.02 + 40.0, (z * 1.0) * 0.02 + 40.0, 3, 0.5)
            if woods > 0.05 {
                pick = column_pick(x, z)
                density = 0.04 + (woods - 0.05) * 0.16
                if pick < density {
                    height = column_height(world, x, z)
                    grassy = height > 0 && voxel.world_get(world, x, height - 1, z) == voxel.GRASS
                    if grassy && column_flat(world, x, z, height) {
                        plant_tree(world, x, height, z, 4 + ((pick * 1000.0) as int) % 3)
                        planted = planted + 1
                    }
                }
            }
            z = z + 1
        }
        x = x + 1
    }
    println("forest: ${planted} trees")
}

// A number in 0..1 for the column, the same every run, unrelated to its
// neighbours': an integer hash, folded to a fraction.
column_pick(x: int, z: int) -> float {
    h = (x * 374761393 + z * 668265263) as uint64
    h = (h ^ (h >> 13)) * (1274126177 as uint64)
    h = h ^ (h >> 16)
    return ((h & (1023 as uint64)) as float) / 1024.0
}

column_height(world: *World, x: int, z: int) -> int {
    y = voxel.world_max_height(world) - 1
    while y >= 0 {
        if voxel.world_get(world, x, y, z) != voxel.EMPTY { return y + 1 }
        y = y - 1
    }
    return 0
}

column_flat(world: *World, x: int, z: int, height: int) -> bool {
    dx = 0 - 1
    while dx <= 1 {
        dz = 0 - 1
        while dz <= 1 {
            other = column_height(world, x + dx, z + dz)
            if other > height + 1 || other < height - 1 { return false }
            dz = dz + 1
        }
        dx = dx + 1
    }
    return true
}

plant_tree(world: *World, x: int, ground: int, z: int, trunk: int) {
    y = 0
    while y < trunk {
        voxel.world_set(world, x, ground + y, z, voxel.WOOD)
        y = y + 1
    }
    // The crown: two wide layers, then one, then the tip.
    layer = 0
    while layer < 4 {
        reach = 2
        if layer >= 2 { reach = 1 }
        if layer == 3 { reach = 0 }
        dx = 0 - reach
        while dx <= reach {
            dz = 0 - reach
            while dz <= reach {
                corner = (dx == reach || dx == 0 - reach) && (dz == reach || dz == 0 - reach)
                if !(corner && reach == 2) {
                    ly = ground + trunk - 1 + layer
                    if !(dx == 0 && dz == 0 && layer == 0) {
                        voxel.world_set(world, x + dx, ly, z + dz, voxel.LEAF)
                    }
                }
                dz = dz + 1
            }
            dx = dx + 1
        }
        layer = layer + 1
    }
}

// The hour the scene is lit at: a morning, the trees throwing long shadows by default, AE3D_TIME=HHMM
// for another, and AE3D_TIME=-1 for the painted sky and the scene's own light.
scene_hour() -> float {
    hhmm = core.env_int("AE3D_TIME", 930)
    if hhmm < 0 { return 0.0 - 1.0 }
    return ((hhmm / 100) as float) + ((hhmm % 100) as float) / 60.0
}

start(state: ptr, go: *GameObject) {
    e = engine.of(go)

    world = voxel.world_new(WORLD_X, WORLD_Z, WORLD_HEIGHT, VOXEL_SIZE)
    if world == null {
        println("could not allocate the voxel world")
        return
    }
    voxel.world_set_base_height(world, 0.0 - (SEA_VOXELS as float) * VOXEL_SIZE)

    started = clock_ns()
    build_terrain(world)
    generated = clock_ns()

    // The faces that show, as one mesh, each corner carrying the sky it
    // can see: a cliff foot is darker than a terrace lip, which the
    // instanced cubes could not say.
    model = voxel.world_build_mesh(world)
    built = clock_ns()

    if model == null {
        println("could not build the voxel model")
        voxel.world_free(world)
        return
    }

    println("voxels: ${voxel.world_active_count(world)} solid, ${core.mesh_index_count(model.mesh) / 6} faces")
    println("terrain ${(generated - started) / 1000000} ms, mesh ${(built - generated) / 1000000} ms")

    // The shader's noise across the blocks, so a hillside of one grass is
    // not one flat green.
    config = rendering.default_config()
    config.perlin_noise = true
    config.noise_scale = 0.06
    config.noise_intensity = 0.5
    rendering.apply(model, config)
    engine.engine_add_model(e, model)
    g_world = world as ptr

    // The sea, lapping at the sand: the water surface lies at y = 0 whatever
    // its model is told, so the world was built with its floor lowered to
    // put the shore at it.
    sea = water.simulation_new(6000.0, 0.8)
    water.simulation_set_wave_scale(sea, 300.0)
    water.simulation_set_color(sea, 0.03, 0.16, 0.24)
    water.simulation_set_sky_color(sea, 0.50, 0.64, 0.80)
    water.simulation_set_reflection(sea, 0.55)
    if scene_hour() >= 0.0 {
        // The water mirrors the sky drawn from the sun: its colours, since
        // there is no image to reflect.
        overhead = sky.zenith_color(scene_hour())
        rim = sky.horizon_color(scene_hour())
        water.simulation_set_sky_color(sea, (overhead.x + rim.x) * 0.5, (overhead.y + rim.y) * 0.5, (overhead.z + rim.z) * 0.5)
    } else {
        water.simulation_set_sky_texture(sea, "resources/sky/desert.png")
    }
    // A shore: clear over the sand within a few metres of the surface, foam
    // along the waterline.
    water.simulation_set_shore(sea, 9.0, 3.0)
    water.simulation_set_opacity(sea, 0.96)
    water.simulation_set_foam(sea, true, 0.3)
    ocean = water.simulation_build(sea, water.RESOLUTION)
    if ocean != null {
        core.model_set_position(ocean, (WORLD_X as float) * VOXEL_SIZE * 0.5, 0.0,
                                (WORLD_Z as float) * VOXEL_SIZE * 0.5)
        engine.engine_add_model(e, ocean)
    }
    g_sea = sea as ptr

    engine.engine_set_clear_color(e, HAZE_R, HAZE_G, HAZE_B)
    // The sky drawn from the sun at the scene's hour, with the light set to
    // agree with it; or the painted sky, with AE3D_TIME=-1.
    if scene_hour() >= 0.0 {
        engine.engine_set_time_of_day(e, scene_hour())
    } else {
        engine.engine_set_sky(e, "resources/sky/desert.png")
    }
    // Clouds over the sky, drifting, their shadows crossing the ground.
    engine.engine_set_clouds(e, 0.38, 1.0)

    // Low over the near corner, so the block stands against the sky and the
    // sun rakes across the terraces of the terrain.
    // AE3D_CAMX/Y/Z and AE3D_AIMX/Y/Z (metres) put the camera elsewhere,
    // for looking at one thing closely.
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(core.env_int("AE3D_CAMX", 40) as float,
                                            core.env_int("AE3D_CAMY", 70) as float,
                                            core.env_int("AE3D_CAMZ", 0 - 30) as float))
    core.camera_set_speed(cam, 400.0)
    core.camera_set_far(cam, 20000.0)
    core.camera_look_at(cam, core.vec3(core.env_int("AE3D_AIMX", 420) as float,
                                       core.env_int("AE3D_AIMY", 45) as float,
                                       core.env_int("AE3D_AIMZ", 400) as float))
}

update(state: ptr, go: *GameObject, delta: float) {
    sea = g_sea as *Simulation
    if sea == null { return }
    water.simulation_update(sea, delta)
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d - voxel world")
    engine.engine_set_face_culling(e, true)
    engine.engine_set_frustum_culling(e, true)

    // The sun where the painted sky has it (tools/make_sky.ae), and its
    // shadows on the terrain; haze toward the far side of the world.
    // The sun and the sky's fill, in hundredths: AE3D_SUN=100 AE3D_AMBIENT=22
    // sweep the light without a rebuild.
    light = core.light_directional(core.vec3(SUN_X, SUN_Y, SUN_Z),
                                   core.vec3(1.0, 0.94, 0.82),
                                   core.env_int("AE3D_SUN", 100) as float / 100.0)
    light.ambient_strength = core.env_int("AE3D_AMBIENT", 22) as float / 100.0
    engine.engine_set_light(e, light)
    // The occlusion between the blocks and under the trees, from the
    // scene's depth; the sky each corner sees is baked into the mesh.
    engine.engine_set_ssao(e, core.env_int("AE3D_SSAO", 1) == 1, 4.0, 1.0)
    engine.engine_set_shadow_distance(e, 500.0)
    engine.engine_set_fog(e, core.fog_distance(900.0, 4000.0,
                                               core.vec3(HAZE_R, HAZE_G, HAZE_B), 0.85))
    game = engine.object(e, "Game", null)
    engine.script(game, "voxel world", null, start, update)

    engine.engine_run(e)

    println("voxel world: ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps, ${engine.engine_draw_calls(e)} draw calls")

    world = g_world as *World
    if world != null { voxel.world_free(world) }
    sea = g_sea as *Simulation
    if sea != null { water.simulation_free(sea) }
    core.light_free(light)
    engine.engine_free(e)
}
