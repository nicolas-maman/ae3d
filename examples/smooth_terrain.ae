// The same Perlin terrain as the voxel demo, meshed with surface nets instead of
// drawn as cubes: one vertex per cell that straddles the surface, so the result
// is smooth rather than a staircase.
//
//   ./build.sh examples/smooth_terrain.ae && ./build/smooth_terrain

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.noise
import ae3d.voxel
import ae3d.rendering
import ae3d.water
import ae3d.sky
import ae3d.weather
import std.os
import std.string

extern clock_ns() -> long
extern pow(x: float, y: float) -> float
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)
extern ae3d_image_register(name: string, rgba: ptr, width: int, height: int) -> int
extern ae3d_rgba_set(rgba: ptr, index: int, r: float, g: float, b: float, a: float)

const WORLD_X = 160
const WORLD_Z = 160
const WORLD_HEIGHT = 64
const CELL = 6.0

// The sea the terrain stands in, so it is an island and not a slab in the
// air: the water surface lies at y = 0 whatever its model is told, so the
// terrain is lowered until the sea cuts it this far above its lowest point.
// And the sun where the painted sky has it (tools/make_sky.ae).
const SEA_DEPTH = 34.0
const SUN_X = 0.0 - 0.263
const SUN_Y = 0.581
const SUN_Z = 0.0 - 0.770
const HAZE_R = 0.86
const HAZE_G = 0.80
const HAZE_B = 0.70

var g_world: ptr = null
var g_weather: ptr = null
var g_surface: ptr = null
var g_sea: ptr = null

// The land's height at a point of the grid, in cells, continuous in x and z
// so the albedo can read it between the columns the field is filled at.
land_height(field: *Perlin, x: float, z: float) -> float {
    sample = noise.fbm2(field, x * 0.022, z * 0.022, 5, 0.5)
    ridged = noise.ridge(field, x * 0.006, 0.0, z * 0.006, 3, 0.5)
    // Gullies and knolls a few cells across, so the flanks are ground and
    // not one smooth slope; deeper where the ridge is, as erosion is.
    detail = noise.fbm2(field, x * 0.11 + 3.0, z * 0.11, 3, 0.5) * (1.5 + ridged * 2.0)
    height = 8.0 + (sample + 1.0) * 0.5 * 30.0 + ridged * 26.0 + detail
    // An island: the land falls away toward the grid's edges, so its rim --
    // and the walls the field closes the volume with -- lie under the sea
    // rather than standing as a cliff at the edge of the world. A dome, not
    // a plateau: the fall starts at the middle, so the island has a massif
    // and flanks instead of a mesa with a rim.
    dx = x - (WORLD_X as float) * 0.5
    dz = z - (WORLD_Z as float) * 0.5
    shore = core.sqrt_of(dx * dx + dz * dz) / ((WORLD_X as float) * 0.5)
    if shore > 0.95 { shore = 0.95 }
    keep = 0.5 + 0.5 * core.cos_of(shore / 0.95 * 3.14159265)
    // Eased at the foot, so the land runs out under the sea as a shelf and
    // the shore is shallows and a beach, not a wall the water stops at.
    keep = pow(keep, 0.6)
    return 6.0 + (height - 6.0) * keep
}

// The field is the signed height above the terrain, so it is negative under the
// surface and zero exactly on it, which is what the mesher interpolates against.
build_field(world: *World) {
    field = noise.perlin_new(4242)
    if field == null { return }

    x = 0
    while x < WORLD_X {
        z = 0
        while z < WORLD_Z {
            height = land_height(field, x as float, z as float)

            y = 0
            while y < WORLD_HEIGHT {
                value = (y * 1.0) - height
                // The volume closed: outside on the boundary rows puts a
                // floor and walls one cell in, under the sea, so the island
                // is a solid and not a sheet.
                if y == 0 || x == 0 || z == 0 || x == WORLD_X - 1 || z == WORLD_Z - 1 {
                    value = 1.0
                }
                voxel.world_sdf_set(world, x, y, z, value)
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }

    noise.perlin_free(field)
}

const ALBEDO_SIZE = 1024

// What the island is made of, painted from its own height and slope: sand
// at the waterline, grass on the flats, rock where the ground is steep and
// scrub up high, the borders mottled by noise so no contour is a line.
// The mesher's UVs run x/cells and z/cells across the grid, so a texel of
// this is a spot of the island, and the image goes to the model through the
// image layer's registry with nothing written to disk. `sea` is the sea
// level in cells of the field.
bake_albedo(sea: float) -> string {
    pixels = calloc(ALBEDO_SIZE * ALBEDO_SIZE * 4, 1)
    if pixels == null { return "" }
    field = noise.perlin_new(4242)
    mottle = noise.perlin_new(9090)
    if field == null || mottle == null { free(pixels); return "" }
    step = (WORLD_X as float) / (ALBEDO_SIZE as float)

    row = 0
    while row < ALBEDO_SIZE {
        z = ((row as float) + 0.5) * step
        column = 0
        while column < ALBEDO_SIZE {
            x = ((column as float) + 0.5) * step
            h = land_height(field, x, z)
            // Metres above the sea and metres of rise per metre of run.
            above = (h - sea) * CELL
            rise = core.sqrt_of((land_height(field, x + 0.5, z) - land_height(field, x - 0.5, z)) *
                                (land_height(field, x + 0.5, z) - land_height(field, x - 0.5, z)) +
                                (land_height(field, x, z + 0.5) - land_height(field, x, z - 0.5)) *
                                (land_height(field, x, z + 0.5) - land_height(field, x, z - 0.5)))
            wobble = noise.fbm2(mottle, x * 0.15, z * 0.15, 3, 0.5)
            fine = noise.fbm2(mottle, x * 2.6 + 7.0, z * 2.6, 4, 0.5)

            // Grass, lighter where it is thin and darker in the hollows.
            r = 0.34 + wobble * 0.08 + fine * 0.05
            g = 0.52 + wobble * 0.10 + fine * 0.06
            b = 0.18 + wobble * 0.04
            // Scrub up high: the grass goes yellow and sparse.
            high = (above - 95.0) / 40.0 + wobble * 0.5
            if high < 0.0 { high = 0.0 }
            if high > 1.0 { high = 1.0 }
            r = r + (0.44 - r) * high
            g = g + (0.40 - g) * high
            b = b + (0.20 - b) * high
            // Rock where it is steep.
            rocky = (rise - 1.15) / 0.45 + wobble * 0.35
            if rocky < 0.0 { rocky = 0.0 }
            if rocky > 1.0 { rocky = 1.0 }
            rock = 0.42 + fine * 0.10
            r = r + (rock * 1.02 - r) * rocky
            g = g + (rock * 0.98 - g) * rocky
            b = b + (rock * 0.90 - b) * rocky
            // Sand at the waterline, and wet sand just under it.
            sandy = 1.0 - (above - 2.0) / 5.0 + wobble * 0.6
            if sandy < 0.0 { sandy = 0.0 }
            if sandy > 1.0 { sandy = 1.0 }
            sand = 0.78 + fine * 0.08
            if above < 0.0 { sand = 0.55 }
            r = r + (sand * 0.98 - r) * sandy
            g = g + (sand * 0.90 - g) * sandy
            b = b + (sand * 0.68 - b) * sandy

            ae3d_rgba_set(pixels, row * ALBEDO_SIZE + column, r, g, b, 1.0)
            column = column + 1
        }
        row = row + 1
    }

    name = "ae3d://island-albedo"
    ok = ae3d_image_register(name, pixels, ALBEDO_SIZE, ALBEDO_SIZE) == 1
    noise.perlin_free(field)
    noise.perlin_free(mottle)
    free(pixels)
    if !ok { return "" }
    return name
}

// The hour the scene is lit at: an hour before sunset by default, AE3D_TIME=HHMM
// for another, and AE3D_TIME=-1 for the painted sky and the scene's own light.
scene_hour() -> float {
    hhmm = core.env_int("AE3D_TIME", 1700)
    if hhmm < 0 { return 0.0 - 1.0 }
    return ((hhmm / 100) as float) + ((hhmm % 100) as float) / 60.0
}

on_start(state: ptr, e: *Engine) {

    world = voxel.world_new(WORLD_X, WORLD_Z, WORLD_HEIGHT, CELL)
    if world == null || !voxel.world_sdf_enable(world) {
        println("could not allocate the field")
        return
    }

    started = clock_ns()
    build_field(world)
    filled = clock_ns()

    surface = voxel.world_build_surface(world)
    meshed = clock_ns()

    if surface == null {
        println("the field produced no surface")
        voxel.world_free(world)
        return
    }

    core.model_matte(surface, 1.0, 1.0, 1.0)
    core.model_set_pbr(surface, 0.0, 0.9)
    config = rendering.default_config()
    config.perlin_noise = true
    config.noise_scale = 0.03
    config.noise_intensity = 0.25
    rendering.apply(surface, config)
    engine.engine_add_model(e, surface)

    // The sea around it. The world is 960 m across and the surface reaches
    // well past that, so the island sits in open water to the horizon.
    sea = water.simulation_new(12000.0, 1.2)
    // Waves tens of metres long, moving as such waves move, not the ocean's
    // own kilometre swells, which from a shore stand still.
    water.simulation_set_wave_scale(sea, 250.0)
    water.simulation_set_color(sea, 0.03, 0.12, 0.20)
    water.simulation_set_sky_color(sea, 0.56, 0.70, 0.86)
    // Less than a mirror: at a grazing look every crest gave the sky back
    // as a white band, and the sea read as stripes.
    water.simulation_set_reflection(sea, 0.6)
    // What it mirrors: the painted sky itself, not a flat sky colour.
    if scene_hour() >= 0.0 {
        // The water mirrors the sky drawn from the sun: its colours, since
        // there is no image to reflect.
        overhead = sky.zenith_color(scene_hour())
        rim = sky.horizon_color(scene_hour())
        water.simulation_set_sky_color(sea, (overhead.x + rim.x) * 0.5, (overhead.y + rim.y) * 0.5, (overhead.z + rim.z) * 0.5)
    } else {
        water.simulation_set_sky_texture(sea, "resources/sky/desert.png")
    }
    // A shore: clear over the sand within a few metres of the surface, foam
    // along the waterline.
    water.simulation_set_shore(sea, 9.0, 3.0)
    water.simulation_set_normal_strength(sea, 1.6)
    water.simulation_set_foam(sea, true, 0.3)
    // Opaque enough that the drowned slopes do not show through as a shadow
    // of the island under the island.
    water.simulation_set_opacity(sea, 0.97)
    ocean = water.simulation_build(sea, water.RESOLUTION)
    if ocean != null {
        core.model_set_position(ocean, (WORLD_X as float) * CELL * 0.5, 0.0,
                                (WORLD_Z as float) * CELL * 0.5)
        engine.engine_add_model(e, ocean)
    }
    g_sea = sea as ptr

    g_world = world as ptr
    g_surface = surface as ptr

    lowest = 1000000.0
    highest = 0.0 - 1000000.0
    v = 0
    while v < core.mesh_vertex_count(surface.mesh) {
        at = core.mesh_position(surface.mesh, v)
        py = at.y
        // The lowest land: not the floor the field closes the volume with,
        // and not the walls at its edges, which run from the floor up.
        edge = CELL * 2.5
        inland = at.x > edge && at.z > edge &&
                 at.x < (WORLD_X as float) * CELL - edge && at.z < (WORLD_Z as float) * CELL - edge
        if inland && py > CELL * 1.5 && py < lowest { lowest = py }
        if py > highest { highest = py }
        v = v + 1
    }
    core.model_set_position(surface, 0.0, 0.0 - (lowest + SEA_DEPTH), 0.0)
    // The island's colours, from the same field, now the sea level is known.
    albedo = bake_albedo((lowest + SEA_DEPTH) / CELL)
    if albedo != "" { core.model_set_texture(surface, albedo) }
    println("surface: ${core.mesh_vertex_count(surface.mesh)} vertices, ${core.mesh_index_count(surface.mesh) / 3} triangles, ${highest - lowest} m of relief, ${SEA_DEPTH} m of it under the sea")
    println("field ${(filled - started) / 1000000} ms, mesh ${(meshed - filled) / 1000000} ms")

    engine.engine_set_clear_color(e, HAZE_R, HAZE_G, HAZE_B)
    engine.engine_set_post(e, true, false, 0.8, 0.4)
    // The sky drawn from the sun at the scene's hour, with the light set to
    // agree with it; or the painted sky, with AE3D_TIME=-1.
    if scene_hour() >= 0.0 {
        engine.engine_set_time_of_day(e, scene_hour())
    } else {
        engine.engine_set_sky(e, "resources/sky/desert.png")
    }
    // Clouds over the sky, drifting, their shadows crossing the ground.
    engine.engine_set_clouds(e, 0.38, 1.0)

    // From over the water on the island's sunlit side, low enough that it
    // stands against the sky and the sea runs out to the horizon under it.
    // AE3D_CAMX/Y/Z and AE3D_AIMX/Y/Z (metres) put it elsewhere.
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(core.env_int("AE3D_CAMX", 1150) as float,
                                            core.env_int("AE3D_CAMY", 45) as float,
                                            core.env_int("AE3D_CAMZ", 0 - 60) as float))
    core.camera_set_speed(cam, 500.0)
    core.camera_set_far(cam, 30000.0)
    core.camera_look_at(cam, core.vec3(core.env_int("AE3D_AIMX", 480) as float,
                                       core.env_int("AE3D_AIMY", 80) as float,
                                       core.env_int("AE3D_AIMZ", 480) as float))
    // The weather, over everything: AE3D_WEATHER=rain|snow|dust|storm and
    // AE3D_WEATHER_LEVEL=0..100 for how hard, off by default.
    w = weather.weather_new(e)
    g_weather = w as ptr
    wanted = os.getenv("AE3D_WEATHER")
    if wanted != null {
        kind = weather.CLEAR
        if string.equals(wanted, "rain") == 1 { kind = weather.RAIN }
        if string.equals(wanted, "snow") == 1 { kind = weather.SNOW }
        if string.equals(wanted, "dust") == 1 { kind = weather.DUST }
        if string.equals(wanted, "storm") == 1 { kind = weather.STORM }
        weather.weather_set_wind(w, core.vec3(0.0 - 0.6, 0.0, 0.8), 6.0)
        weather.weather_set(w, kind, core.env_int("AE3D_WEATHER_LEVEL", 70) as float / 100.0)
    }
}

on_update(state: ptr, e: *Engine, delta: float) {
    sea = g_sea as *Simulation
    if sea == null { return }
    water.simulation_update(sea, delta)
}

main() {
    e = engine.engine_new()
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d - smooth terrain")
    engine.engine_set_face_culling(e, true)

    // The sun and the sky's fill, in hundredths: AE3D_SUN=100 AE3D_AMBIENT=22
    // sweep the light without a rebuild.
    light = core.light_directional(core.vec3(SUN_X, SUN_Y, SUN_Z),
                                   core.vec3(1.0, 0.94, 0.82),
                                   core.env_int("AE3D_SUN", 100) as float / 100.0)
    light.ambient_strength = core.env_int("AE3D_AMBIENT", 22) as float / 100.0
    engine.engine_set_light(e, light)
    // The occlusion between the island's folds, from the scene's depth.
    engine.engine_set_ssao(e, core.env_int("AE3D_SSAO", 1) == 1, 6.0, 1.0)
    engine.engine_set_shadow_distance(e, 700.0)
    engine.engine_set_fog(e, core.fog_distance(1500.0, 9000.0,
                                               core.vec3(HAZE_R, HAZE_G, HAZE_B), 0.9))
    program = engine.behaviour_new("smooth terrain", null)
    program.start = on_start
    program.update = on_update
    engine.engine_add_behaviour(e, program)

    engine.engine_run(e)

    println("smooth terrain: ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps, ${engine.engine_draw_calls(e)} draw calls")

    surface = g_surface as *Model
    if surface != null { core.model_free(surface) }
    world = g_world as *World
    if world != null { voxel.world_free(world) }
    sea = g_sea as *Simulation
    if sea != null { water.simulation_free(sea) }
    core.light_free(light)
    if g_weather != null { weather.weather_free(g_weather as *Weather) }
    engine.engine_free(e)
}
