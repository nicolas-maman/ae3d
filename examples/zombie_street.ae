// A zombie walking up a street at dusk, and attacking.
//
// Authored in Blender by tools/blender/make_zombie_street.py, exported through
// tools/blender/ae3d_export.py, and loaded here straight from the manifest:
// meshes, textures, placement, the parent chain and one animation clip per
// moving part.
//
// The zombie is rigid parts on a parent chain, not a skinned mesh: ae3d has no
// skinning (ae3d#192), so the hierarchy is what holds the joints together.
// Every clip is a local rotation about a joint, exactly as it was keyed.
//
//   AE3D_AGENT=7911 ./build/zombie_street
//   python3 tools/ae3d_agent.py --port 7911 anim.set name=Zombie_ArmUpperR time=3.2
//   python3 tools/ae3d_agent.py --port 7911 trace.model name=Zombie_Head

import std.heap
import std.list
import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import ae3d.assets
import ae3d.anim
import ae3d.ik

const MANIFEST = "resources/blender/zombie_street/manifest.json"
const SKY = "resources/sky/dusk.png"

// Blender is Z-up and ae3d is Y-up, so the street's Blender Y became ae3d -Z:
// the far terrace stands at negative z, the near one at positive, and the road
// is the corridor between them.
const SKY_R = 0.075
const SKY_G = 0.088
const SKY_B = 0.125

var g_lamps: ptr = null
var g_sky: *Skybox = null
var g_key: *Light = null

// The limbs the solve runs on, and what the clips leave for it to correct.
// Filled at load: a file-scope value has to be a constant here.
var g_leg_l: *Limb = null
var g_leg_r: *Limb = null
var g_arm_r: *Limb = null
var g_arm_l: *Limb = null

// The road, and how far the ankle sits above the sole standing on it.
const GROUND = 0.0
const ANKLE = 0.085
// How much of its own lift a foot has to give up before it stops being planted.
const STEP_BAND = 0.07
const SAMPLES = 96

// What the zombie is walking at. Out of reach for most of the street, which is
// what keeps the arm straight and pointing; inside it at the end of the lunge,
// where the hand closes on it exactly.
const VICTIM_X = 0.0 - 2.72
const VICTIM_Y = 1.2
const VICTIM_Z = 0.33

struct Limb {
    root: *Model
    mid: *Model
    tip: *Model
    lowest: float
}

// engine_add_model borrows, and a Player borrows its clip: both outlive the
// engine and are released after it.
var g_models: ptr = null
var g_clips: ptr = null

main() {
    e = engine.engine_new(platform.API_GL)
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d: a zombie, on a street")
    engine.engine_set_camera_input(e, true)
    engine.engine_set_post(e, true, true, 1.35, 0.4)
    engine.engine_set_fog(e, core.fog_distance(5.0, 40.0,
                                               core.vec3(SKY_R, SKY_G, SKY_B), 0.95))
    // The street runs ninety metres and the zombie is under two. Fitting the
    // shadow map to the whole of it leaves nothing for the figure standing in
    // the middle, so the map is fitted to what the camera can see instead.
    engine.engine_set_shadow_distance(e, 18.0)
    engine.engine_set_user_data(e, e as ptr)
    engine.engine_on_start(e, on_start)

    if !engine.engine_run(e, -1, -1) {
        println("zombie_street: no window")
        engine.engine_free(e)
        return
    }
    engine.engine_free(e)
    // After the engine: freeing the renderer is what releases the GPU handles
    // the models were given, and the registry is what frees the players that
    // read the clips.
    free_scene()
    assets.provenance_release()
    free_lamps()
}

free_scene() {
    if g_models != null {
        i = 0
        count = list.size(g_models)
        while i < count {
            model = list.get_raw(g_models, i) as *Model
            if model != null { core.model_free(model) }
            i = i + 1
        }
        list.free(g_models)
        g_models = null
    }
    if g_clips != null {
        i = 0
        count = list.size(g_clips)
        while i < count {
            clip = list.get_raw(g_clips, i) as *Clip
            if clip != null { anim.clip_free(clip) }
            i = i + 1
        }
        list.free(g_clips)
        g_clips = null
    }
}

on_start(data: ptr) {
    e = data as *Engine

    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.35, 1.34, 1.55))
    core.camera_look_at(cam, core.vec3(0.0 - 3.5, 1.1, 0.0 - 0.2))

    // A street this narrow is in the shade of its own terrace long before dusk
    // is over, so the light that shapes it is the lamp overhead rather than
    // what is left of the sun. The key light is the one the scene is shadowed
    // by, so the lamp is the key light and the sun is a fill: the shadow the
    // zombie throws is the one cast up the road by the lamp it is walking
    // under.
    g_lamps = list.new()
    g_key = lamp_at(0.0)
    g_key.ambient_strength = 0.12
    engine.engine_set_light(e, g_key)

    dusk = core.light_directional(core.vec3(0.0 - 0.30, 0.62, 0.72),
                                  core.vec3(0.34, 0.42, 0.68), 0.75)
    engine.engine_add_light(e, dusk)
    list.add_raw(g_lamps, dusk as ptr)

    engine.engine_add_light(e, lamp_at(0.0 - 14.0))
    engine.engine_add_light(e, lamp_at(14.0))

    // A sky rather than a colour: the blue band at the horizon is what the far
    // end of the street fades into, and the fog is set to meet it.
    renderer = engine.engine_gl_renderer(e)
    if renderer != null {
        gl.renderer_set_clear_color(renderer as *GLRenderer, SKY_R, SKY_G, SKY_B)
        g_sky = gl.skybox_create(renderer as *GLRenderer, SKY)
        engine.engine_set_skybox(e, g_sky as ptr)
    }

    m = assets.manifest_load(MANIFEST)
    if m == null {
        println("zombie_street: ${assets.last_error()}")
        println("zombie_street: run ./scripts/export_assets.sh to build the assets")
        return
    }

    models = assets.manifest_load_scene(m)
    g_models = models
    g_clips = list.new()
    animated = 0
    count = assets.manifest_count(m)
    i = 0
    while i < count {
        model = list.get_raw(models, i) as *Model
        if model != null {
            engine.engine_add_model(e, model)
            entry = assets.manifest_entry(m, i)
            clip = assets.entry_load_clip(m, entry)
            if clip != null {
                list.add_raw(g_clips, clip as ptr)
                engine.engine_add_animation(e, assets.entry_object(entry),
                                            anim.player_new(clip), model)
                animated = animated + 1
            }
        }
        i = i + 1
    }

    g_leg_l = limb_of(e, models, m, "Zombie_LegUpperL", "Zombie_LegLowerL", "Zombie_FootL")
    g_leg_r = limb_of(e, models, m, "Zombie_LegUpperR", "Zombie_LegLowerR", "Zombie_FootR")
    g_arm_r = limb_of(e, models, m, "Zombie_ArmUpperR", "Zombie_ArmLowerR", "Zombie_HandR")
    g_arm_l = limb_of(e, models, m, "Zombie_ArmUpperL", "Zombie_ArmLowerL", "Zombie_HandL")
    engine.engine_on_pose(e, solve_pose)

    println("zombie_street: ${count} objects from ${assets.manifest_source(m)}, ${animated} animated")
    println("zombie_street: the clips leave the feet at ${g_leg_l.lowest} and ${g_leg_r.lowest} above the road")
    assets.manifest_free(m)
}

limb_of(e: *Engine, models: ptr, m: *Manifest, root: string, mid: string,
        tip: string) -> *Limb {
    limb = heap.new(Limb)
    limb.root = model_named(models, m, root)
    limb.mid = model_named(models, m, mid)
    limb.tip = model_named(models, m, tip)
    limb.lowest = lowest_of(e, limb.tip)
    return limb
}

model_named(models: ptr, m: *Manifest, name: string) -> *Model {
    count = assets.manifest_count(m)
    i = 0
    while i < count {
        if assets.entry_object(assets.manifest_entry(m, i)) == name {
            return list.get_raw(models, i) as *Model
        }
        i = i + 1
    }
    return null
}

// The lowest the clips ever put this part, which is where its own step touches
// down. Read off the animation rather than assumed: a clip is a set of angles,
// and the floor it was drawn against is not in them.
lowest_of(e: *Engine, part: *Model) -> float {
    if part == null { return 0.0 }
    registry = engine.engine_animations(e) as *Registry
    if registry == null { return 0.0 }

    duration = 0.0
    bound = anim.registry_count(registry)
    i = 0
    while i < bound {
        length = anim.clip_duration(anim.player_clip(
            anim.binding_player(anim.registry_binding(registry, i))))
        if length > duration { duration = length }
        i = i + 1
    }
    if duration <= 0.0 { return core.model_world_position(part).y }

    lowest = core.model_world_position(part).y
    step = 0
    while step <= SAMPLES {
        pose_at(registry, duration * (step * 1.0) / (SAMPLES * 1.0))
        height = core.model_world_position(part).y
        if height < lowest { lowest = height }
        step = step + 1
    }
    pose_at(registry, 0.0)
    return lowest
}

pose_at(registry: *Registry, time: float) {
    count = anim.registry_count(registry)
    i = 0
    while i < count {
        binding = anim.registry_binding(registry, i)
        player = anim.binding_player(binding)
        anim.player_set_time(player, time)
        anim.apply(player, anim.binding_model(binding))
        i = i + 1
    }
}

// What the clips leave out. A walk is a set of angles that happened to look
// right against the floor it was drawn on; on this road the feet float a
// hand's width above it and wander up and down by half that again as the hips
// bob. The solve puts each foot on the road for the part of the stride it is
// standing on, and leaves the swing alone.
//
// The arm is the other direction the question runs in: it reaches for
// something at a place, and the solver says whether it got there. Out of range
// it straightens towards it, which is the shape of a zombie walking at you;
// in range the hand lands on it.
solve_pose(data: ptr) {
    victim = core.vec3(VICTIM_X, VICTIM_Y, VICTIM_Z)
    // Both hands go for it. The far one trails, which is what makes the near
    // one read as the one doing the reaching.
    plant(g_leg_l)
    plant(g_leg_r)
    reach(g_arm_r, victim)
    reach(g_arm_l, core.v3_add(victim, core.vec3(0.0 - 0.22, 0.0 - 0.16, 0.34)))
}

plant(limb: *Limb) {
    if limb == null { return }
    if limb.root == null || limb.mid == null || limb.tip == null { return }
    at = core.model_world_position(limb.tip)
    lift = at.y - limb.lowest
    if lift > STEP_BAND { return }

    planted = 1.0 - lift / STEP_BAND
    on_road = core.vec3(at.x, GROUND + ANKLE, at.z)
    target = core.v3_lerp(at, on_road, planted)
    knee = core.v3_add(core.model_world_position(limb.mid), core.vec3(2.0, 0.0, 0.0))
    ik.solve_two_bone(limb.root, limb.mid, limb.tip, target, knee)
}

reach(limb: *Limb, target: Vec3) {
    if limb == null { return }
    if limb.root == null || limb.mid == null || limb.tip == null { return }
    shoulder = core.model_world_position(limb.root)
    elbow = core.v3_add(shoulder, core.vec3(0.0 - 1.0, 0.0 - 1.2, 1.6))
    ik.solve_two_bone(limb.root, limb.mid, limb.tip, target, elbow)
}

// Sodium light, under the lamp head the exported scene put at this x. Its range
// is short enough that the pools of light on the road stay separate.
lamp_at(x: float) -> *Light {
    lamp = core.light_point(core.vec3(x, 4.25, 0.0 - 2.94),
                            core.vec3(1.0, 0.74, 0.44), 1.35, 12.0)
    list.add_raw(g_lamps, lamp as ptr)
    return lamp
}

free_lamps() {
    if g_lamps == null { return }
    i = 0
    count = list.size(g_lamps)
    while i < count {
        core.light_free(list.get_raw(g_lamps, i) as *Light)
        i = i + 1
    }
    list.free(g_lamps)
    g_lamps = null
}
