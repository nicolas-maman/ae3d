// A horde flooding the lit street: the zombie_street environment -- its
// buildings, its lamps, its wet road and dusk sky -- with a crowd of the real
// zombie marching down the road toward the camera, each a decimated LOD instance
// posed by the shared pose bank. The street is the quality bar; this puts a
// horde into it.
//
//     AE3D_CROWD=3000 ./build/zombie_city

import std.list
import std.string
import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import ae3d.assets
import ae3d.loader
import ae3d.anim
import ae3d.skin
import ae3d.crowd
import ae3d.ecs

const MANIFEST = "resources/blender/zombie_street/manifest.json"
const SKY = "resources/sky/dusk.png"
const SKY_R = 0.075
const SKY_G = 0.088
const SKY_B = 0.125
const FRAMES = 48
const LOD_CELL = 0.09
// A small crowd by default so the scene is inspectable -- a zombie fills enough
// pixels to judge its mesh, pose, shadow and lighting. Scale up with AE3D_CROWD.
const CROWD_DEFAULT = 400

// The road runs along x; Blender Y became ae3d -Z, so the carriageway sits at
// about z = -2.94. The street block is tiled along x into a longer city, and the
// crowd is a real horde inside it -- it seeks a target that drifts along the
// street and shoves apart from itself, so it surges and mills and never leaves
// the street. Nothing teleports, because nothing is ever recycled.
const BLOCK_LEN = 84.0   // the block's ground slab, Street_Ground: x -36..48
const BLOCK_CX = 6.0     // its centre; the road and the mirror axis sit here
const ROAD_LEN = 68.0    // the road mesh is authored 68m; stretched to the block
const TILES = 7          // blocks along the street, centred on the middle one
const STREET_X0 = 0.0 - 280.0
const STREET_X1 = 290.0
const ROAD_Z0 = 0.0 - 5.4    // the street corridor the horde is held to, between
const ROAD_Z1 = 4.4          // the far terrace and the near, so it clips no wall
const ROAD_Y = 0.16
const SPEED = 1.4            // how fast a zombie shambles
const SEP_RADIUS = 1.05      // it shoves apart from anything closer than this
const SEP_STRENGTH = 2.0     // gently, so the pack spreads without flinging
const MAX_SPEED = 2.0        // capped, so a shove can never fling a zombie and pop it

// Distance LOD: the zombies close to the camera are drawn from a detailed model,
// the ones far off from a cheap one, so most of a city-sized crowd costs almost
// nothing and the count can climb. A zombie within NEAR_DIST of the camera is
// near; beyond it, far.
const LOD_NEAR = 0.0    // near tier keeps the full mesh (0 = no decimation)
// The far tier is the whole crowd's GPU cost: a far zombie is ~200 tris at
// cell 0.24, and there are hundreds of thousands of them, so the far draw is
// the frame's biggest single load. A far zombie is metres off and fog-dimmed,
// where its silhouette is all that reads, so decimating it harder -- ~116 tris
// at 0.5 -- is invisible in the scene and lifts a quarter-million crowd from
// 30 to 38fps. Below ~100 tris the bone-aware clustering bottoms out and there
// is nothing more to win. AE3D_LODFAR (hundredths of the cell) tunes it live.
const LOD_FAR = 0.5
// At the inspectable count every zombie is drawn from the full mesh: the whole
// street sits inside the near band, so nothing ever swaps to the decimated
// far model. A swap at a fixed distance is a silhouette pop, and when the
// camera zooms, dozens cross the line at once -- it read as the crowd
// teleporting. AE3D_NEAR pulls the band in when the count needs the far tier.
const NEAR_DIST = 600.0
// The crowd fills the whole street, but the fog swallows it by ~150m, so a
// zombie past this is invisible however many there are. Culling it from the
// draw there -- for free, in the bucket that already has its distance -- means
// the count can climb without the far tier drawing the ~three-quarters of the
// street no one can see. Set a touch beyond the fog so nothing pops at its
// edge. AE3D_CULL (metres, 0 = keep all) tunes it live.
const CULL_DIST = 160.0

var g_scene: ptr = null
var g_lamps: ptr = null
var g_sky: *Skybox = null
var g_near_body: *Model = null    // detailed body + clothes, for zombies close by
var g_near_clothes: *Model = null
var g_far_body: *Model = null     // cheap body only, for the ones far off
var g_bank: ptr = null
var g_world: *EcsWorld = null
var g_pos: *Column = null
var g_vel: *Column = null
var g_phase: *Column = null
var g_yaw: *Column = null     // per-zombie heading about Y; also its facing
var g_grid: *HordeGrid = null
// Per-tier compacted buffers, filled each frame by bucketing the crowd by
// distance to the camera. Sized to the whole count -- a tier may hold all of it.
var g_color: *Column = null   // a fixed muted tint per zombie, for variety
var g_nb_pos: *Column = null
var g_nb_yaw: *Column = null
var g_nb_phase: *Column = null
var g_nb_col: *Column = null
var g_fb_pos: *Column = null
var g_fb_yaw: *Column = null
var g_fb_phase: *Column = null
var g_fb_col: *Column = null
var g_count = CROWD_DEFAULT
var g_walk = 1.0
var g_near_dist = NEAR_DIST   // AE3D_NEAR overrides, a knob for the LOD sweep
var g_cull_dist = CULL_DIST   // AE3D_CULL overrides; 0 keeps the whole crowd
var g_farcount: *Column = null   // one slot the native bucket writes the far count into
// Separation is the crowd's heaviest pass, so it runs every SEP_INTERVAL
// frames rather than every frame -- see the note at its call site. AE3D_SEPN
// overrides (1 = every frame, 0 = never).
// Every frame. Running it every other frame at double strength made each
// zombie's speed alternate frame to frame -- a shimmer you could see up close.
// At the inspectable count that costs nothing; AE3D_SEPN throttles it at scale.
const SEP_INTERVAL = 1
var g_sepn = SEP_INTERVAL
var g_frame = 0

var g_seed = 0x2f6a41b3
next_random() -> float {
    g_seed = (g_seed * 1103515245 + 12345) & 0x7FFFFFFF
    return (g_seed as float) / 2147483647.0
}

entry_named(m: *Manifest, name: string) -> *Entry {
    count = assets.manifest_count(m)
    i = 0
    while i < count {
        entry = assets.manifest_entry(m, i)
        if assets.entry_object(entry) == name { return entry }
        i = i + 1
    }
    return null
}

lamp_at(x: float) -> *Light {
    lamp = core.light_point(core.vec3(x, 4.25, 0.0 - 2.94),
                            core.vec3(1.0, 0.74, 0.42), 4.5, 22.0)
    list.add_raw(g_lamps, lamp as ptr)
    return lamp
}

bake_zombie(m: *Manifest, entry: *Entry) -> ptr {
    bones = assets.entry_load_skeleton(m, entry)
    if bones == null { return null }
    skel = skin.skeleton_new()
    i = 0
    while i < list.size(bones) {
        skin.skeleton_add(skel, list.get_raw(bones, i) as *Model)
        i = i + 1
    }
    skin.skeleton_bind(skel)
    clips = assets.entry_load_bone_clips(m, entry)
    reg = anim.registry_new()
    duration = 0.0
    i = 0
    while clips != null && i < list.size(clips) {
        clip = list.get_raw(clips, i) as *Clip
        index = skin.skeleton_find(skel, anim.clip_name(clip))
        if index >= 0 {
            anim.registry_add(reg, anim.clip_name(clip), anim.player_new(clip),
                              skin.skeleton_bone(skel, index))
            d = anim.clip_duration(clip)
            if d > duration { duration = d }
        }
        i = i + 1
    }
    if clips != null { list.free(clips) }
    if duration <= 0.0 { duration = 1.0 }
    g_walk = duration
    bank = crowd.posebank_bake(reg, skel, FRAMES, duration)
    anim.registry_free(reg)
    skin.skeleton_free(skel)
    i = 0
    while i < list.size(bones) {
        core.model_free(list.get_raw(bones, i) as *Model)
        i = i + 1
    }
    list.free(bones)
    return bank
}

// Wire a figure as an instanced, pose-bank-posed crowd, reserving room for the
// whole count -- a distance tier fills it with as many as fall in its band each
// frame. `cell > 0` first decimates the mesh to a crowd LOD at that cell; `cell
// <= 0` keeps the full mesh, which the near tier needs: the body and the clothes
// are two coincident meshes, and decimating them independently pulls their
// vertices apart so the skin pokes through the cloth in patches. Only the far
// tier, metres off and fogged, can afford the decimation. Returns the tri count.
setup_crowd(model: *Model, cell: float) -> int {
    if cell > 0.0 {
        src = core.model_mesh(model)
        lod = core.mesh_decimate(src, cell)
        if lod != null { core.model_set_mesh(model, lod) }
    }
    // Dead flesh and damp cloth, not wet plastic: kill the specular and roughen
    // the surface so the lamps do not smear an oily highlight across every
    // zombie. Keeps the texture; only the shine goes.
    core.model_set_specular(model, 0.03, 0.03, 0.03)
    core.model_set_pbr(model, 0.0, 0.95)
    core.model_enable_instancing(model, g_count)
    core.model_set_pose_bank(model, g_bank, FRAMES)
    core.model_enable_instance_phases(model)
    core.model_enable_instance_colors(model)
    return core.mesh_index_count(core.model_mesh(model)) / 3
}

// The small street clutter -- bins, crates, sacks, bollards, benches. There are
// far more of these than buildings, and the horde hides them anyway, so a tiled
// city drops them: fewer models a block means the renderer can afford more
// blocks, which is what spreads the crowd thin.
is_prop(name: string) -> bool {
    return string.contains(name, "Bin") == 1 || string.contains(name, "Crate") == 1 ||
           string.contains(name, "Sack") == 1 || string.contains(name, "Bollard") == 1 ||
           string.contains(name, "Bench") == 1
}

// One copy of the street environment, shifted `off_x` down the road, added to
// the engine. The figure objects and the small clutter are left out; only the
// root models are shifted, so the parented trim and glass ride along on their
// shells. Lamp heads and lit windows glow; the road is wet.
add_tile(e: *Engine, m: *Manifest, off_x: float, flip: bool) -> ptr {
    models = assets.manifest_load_scene(m)
    count = assets.manifest_count(m)
    i = 0
    while i < count {
        name = assets.entry_object(assets.manifest_entry(m, i))
        model = list.get_raw(models, i) as *Model
        if model != null && string.contains(name, "Zombie") == 0 && !is_prop(name) {
            if core.model_parent(model) == null {
                // Every other block is mirrored along the street (its root
                // positions reflected about the block centre; the parented trim
                // rides along), so the terrace order alternates and the city
                // does not read as one block copied down the road. The block is
                // centred at BLOCK_CX, not 0: reflecting about 0 slid every
                // mirrored block 12m along the road and opened a gap at each seam.
                wp = core.model_world_position(model)
                nx = wp.x + off_x
                if flip { nx = off_x + (2.0 * BLOCK_CX - wp.x) }
                core.model_set_position(model, nx, wp.y, wp.z)
            }
            // The road and its kerbs are authored 68m long inside an 84m block,
            // so tiled at the block's pitch every seam was 16m of missing road.
            // Stretch them along the street to the block's full length; they then
            // meet the next block's exactly, and the tarmac stretches 23% --
            // nothing the eye picks out.
            if string.contains(name, "Street_Road") == 1 || string.contains(name, "Kerb") == 1 {
                core.model_set_scale(model, BLOCK_LEN / ROAD_LEN, 1.0, 1.0)
            }
            if string.contains(name, "LampHead") == 1 { core.model_set_exposure(model, 16.0) }
            else if string.contains(name, "_Lit") == 1 {
                // Vary which rooms are lit, and how brightly, per block -- so the
                // night skyline is not the same block copied down the street.
                // Some go dark (exposure 0, a room with the light off).
                if next_random() < 0.65 { core.model_set_exposure(model, 8.0 + next_random() * 8.0) }
                else { core.model_set_exposure(model, 0.0) }
            }
            // A damp road, not a mirror. At 0.8 the lamps smeared one huge
            // highlight across the tarmac that slid with every step of the
            // camera -- it read as the light itself moving. A modest sheen keeps
            // the wet look and stays put.
            if string.contains(name, "Road") == 1 || string.contains(name, "Ground") == 1 {
                core.model_set_reflectivity(model, 0.3)
            }
            engine.engine_add_model(e, model)
        }
        i = i + 1
    }
    return models
}

on_start(data: ptr) {
    e = data as *Engine
    g_count = core.env_int("AE3D_CROWD", CROWD_DEFAULT)
    g_near_dist = core.env_int("AE3D_NEAR", NEAR_DIST as int) as float
    g_cull_dist = core.env_int("AE3D_CULL", CULL_DIST as int) as float
    g_sepn = core.env_int("AE3D_SEPN", SEP_INTERVAL)

    // A camera down at the road, looking back along it so the horde walks out of
    // the far dark toward the lamps and the viewer.
    cam = engine.engine_camera(e)
    core.camera_set_far(cam, 300.0)
    // AE3D_VIEW picks the camera, a debug knob for judging the scene from more
    // than one angle: 0 elevated down the street, 1 side-on across the road,
    // 2 low in the middle of the horde.
    view = core.env_int("AE3D_VIEW", 0)
    if view == 1 {
        core.camera_set_position(cam, core.vec3(6.0, 1.7, 4.5))
        core.camera_look_at(cam, core.vec3(0.0, 0.9, 0.0 - 3.0))
    } else if view == 2 {
        core.camera_set_position(cam, core.vec3(0.0, 0.9, 0.0 - 1.0))
        core.camera_look_at(cam, core.vec3(0.0 - 12.0, 0.9, 0.0 - 3.2))
    } else if view == 3 {
        // A free camera for sweeps: AE3D_CAMX/Y/Z place it (metres), looking
        // down the street. Used to verify the crowd from many positions --
        // a single still cannot show a zombie vanishing on a zoom.
        cx = core.env_int("AE3D_CAMX", 40) as float
        cy = core.env_int("AE3D_CAMY", 3) as float
        cz = core.env_int("AE3D_CAMZ", 2) as float
        core.camera_set_position(cam, core.vec3(cx, cy, cz))
        core.camera_look_at(cam, core.vec3(cx - 30.0, 0.7, 0.0 - 2.9))
    } else {
        core.camera_set_position(cam, core.vec3(STREET_X1 + 3.0, 3.6, 2.6))
        core.camera_look_at(cam, core.vec3(0.0 - 18.0, 0.7, 0.0 - 2.9))
    }

    // The lamp is the key light the street is shadowed by; the sun is a dusk
    // fill. Same lighting the reference street uses.
    g_lamps = list.new()
    // Moonlight is the key: a directional lights and shadows the whole city, so
    // a street of blocks reads, not just the pool under one lamp. Only four
    // lights survive to the shader, so the other three are warm lamp accents
    // near the middle -- the far blocks fall to the moon and the fog.
    // Moonlight rakes low across the street rather than dropping from overhead,
    // so a figure throws a long shadow that reads, not a puddle under its feet.
    // Kept the key light and its ambient held down, so the shadow it casts is a
    // real darkening and not filled back in.
    moon = core.light_directional(core.vec3(0.0 - 0.58, 0.0 - 0.52, 0.30),
                                  core.vec3(0.66, 0.74, 0.96), 3.0)
    moon.ambient_strength = 0.26
    engine.engine_set_light(e, moon)
    list.add_raw(g_lamps, moon as ptr)
    if core.env_int("AE3D_NOLAMPS", 0) == 0 {
        engine.engine_add_light(e, lamp_at(0.0))
        engine.engine_add_light(e, lamp_at(0.0 - 14.0))
        engine.engine_add_light(e, lamp_at(14.0))
    }

    renderer = engine.engine_gl_renderer(e)
    if renderer != null {
        gl.renderer_set_clear_color(renderer, SKY_R, SKY_G, SKY_B)
        g_sky = gl.skybox_create(renderer, SKY)
        engine.engine_set_skybox(e, g_sky as ptr)
    }

    m = assets.manifest_load(MANIFEST)
    if m == null {
        println("zombie_city: ${assets.last_error()}")
        return
    }

    // The city: the street block tiled along its length. TILES copies, centred
    // on the middle one, so the crowd floods a run of blocks into the fog.
    t = 0
    half = (TILES - 1) / 2
    while t < TILES {
        off = (t - half) as float * BLOCK_LEN
        tile = add_tile(e, m, off, t % 2 == 1)
        if t == 0 { g_scene = tile }
        t = t + 1
    }

    // The ground the city stands on. The street block is a strip of road and
    // pavement with buildings on it and nothing else: seen from anywhere but
    // straight down the road, the blocks were islands in a black void, with
    // void between neighbouring buildings and void under your feet where the
    // strip ended. One wide, dark, matte plane just under road level, so every
    // gap reads as ground -- an alley, a yard, the earth -- and the city holds
    // together as one place. Below the road so the road still draws on top.
    ground = loader.plane(2, 900.0)
    core.model_set_position(ground, 0.0, ROAD_Y - 0.08, 0.0 - 2.9)
    core.model_set_diffuse(ground, 0.075, 0.072, 0.068)
    core.model_set_specular(ground, 0.02, 0.02, 0.02)
    core.model_set_pbr(ground, 0.0, 0.98)
    engine.engine_add_model(e, ground)

    // The crowd. The real zombie loaded twice for the two distance tiers, plus
    // its clothes for the near one; all posed by the one baked bank.
    entry = entry_named(m, "Zombie_Body")
    if entry == null { println("zombie_city: no Zombie_Body"); assets.manifest_free(m); return }
    g_bank = bake_zombie(m, entry)
    g_near_body = assets.entry_load_model(m, entry)
    g_far_body = assets.entry_load_model(m, entry)
    if g_bank == null || g_near_body == null || g_far_body == null {
        println("zombie_city: load failed"); assets.manifest_free(m); return
    }
    clothes_entry = entry_named(m, "Zombie_Clothes")
    if clothes_entry != null { g_near_clothes = assets.entry_load_model(m, clothes_entry) }

    g_world = ecs.world_new(g_count)
    g_pos = ecs.column_new(g_count, 3)
    g_vel = ecs.column_new(g_count, 3)
    g_phase = ecs.column_new(g_count, 1)
    g_yaw = ecs.column_new(g_count, 1)
    g_color = ecs.column_new(g_count, 3)
    g_nb_pos = ecs.column_new(g_count, 3)
    g_nb_yaw = ecs.column_new(g_count, 1)
    g_nb_phase = ecs.column_new(g_count, 1)
    g_nb_col = ecs.column_new(g_count, 3)
    g_fb_pos = ecs.column_new(g_count, 3)
    g_fb_yaw = ecs.column_new(g_count, 1)
    g_fb_phase = ecs.column_new(g_count, 1)
    g_fb_col = ecs.column_new(g_count, 3)
    g_farcount = ecs.column_new(1, 1)
    i = 0
    while i < g_count {
        ent = ecs.entity_create(g_world)
        slot = ecs.entity_index(ent)
        x = STREET_X0 + next_random() * (STREET_X1 - STREET_X0)
        z = ROAD_Z0 + next_random() * (ROAD_Z1 - ROAD_Z0)
        ecs.column_set3(g_pos, slot, core.vec3(x, ROAD_Y, z))
        ecs.column_set(g_phase, slot, 0, next_random())
        // A heading roughly along the street, spread wide, so the crowd wanders
        // and mills rather than converging on a point -- which is what fills a
        // city and leaves most of it far from the camera and cheap to draw.
        down = 0.0
        if next_random() < 0.5 { down = 3.1415926 }
        ecs.column_set(g_yaw, slot, 0, down + (next_random() - 0.5) * 1.8)
        // A muted tint per zombie -- some greener, some greyer, some paler and
        // some darker -- so the horde is not one flat colour. It multiplies the
        // skin and cloth texture, so keep it in the dead-flesh range: green the
        // top channel, blue held lowest and narrow, so none tint blue or purple.
        tr = 0.50 + next_random() * 0.35
        tg = 0.55 + next_random() * 0.35
        tb = 0.40 + next_random() * 0.22
        ecs.column_set3(g_color, slot, core.vec3(tr, tg, tb))
        i = i + 1
    }
    // The spatial grid the separation runs on, sized to hold the whole street.
    span = STREET_X1 - STREET_X0 + 40.0
    cols = (span / SEP_RADIUS) as int + 2
    g_grid = crowd.grid_new(cols, SEP_RADIUS, STREET_X0 - 20.0, 0.0 - span * 0.5, 10)

    near_tris = setup_crowd(g_near_body, LOD_NEAR)
    cloth_tris = 0
    if g_near_clothes != null { cloth_tris = setup_crowd(g_near_clothes, LOD_NEAR) }
    far_cell = core.env_int("AE3D_LODFAR", (LOD_FAR * 100.0) as int) as float / 100.0
    far_tris = setup_crowd(g_far_body, far_cell)
    engine.engine_add_model(e, g_near_body)
    if g_near_clothes != null { engine.engine_add_model(e, g_near_clothes) }
    engine.engine_add_model(e, g_far_body)

    assets.manifest_free(m)
    log_scene(e, cam, near_tris, cloth_tris, far_tris)
}

// Dump the whole scene so it is debuggable without guessing: the crowd, the
// tiers and their triangle budgets, every light with its real values, the
// shadow and fog envelope, and the camera. Printed once at start-up; grep
// "[diag]" for it.
log_scene(e: *Engine, cam: *Camera, near_tris: int, cloth_tris: int, far_tris: int) {
    println("zombie_city[diag] ================ SCENE ================")
    println("zombie_city[diag] crowd: ${g_count} zombies (AE3D_CROWD), sep every ${g_sepn} frame(s)")
    println("zombie_city[diag] tiers: near ${near_tris}+${cloth_tris} tris (full mesh), far ${far_tris} tris; ${FRAMES} pose bank")
    println("zombie_city[diag] LOD: near<${g_near_dist}m detailed, beyond far; cull ${g_cull_dist}m")
    println("zombie_city[diag] city: ${TILES} blocks, block ${BLOCK_LEN}m, street x[${STREET_X0}..${STREET_X1}], road z[${ROAD_Z0}..${ROAD_Z1}] y=${ROAD_Y}")
    cp = cam.position
    println("zombie_city[diag] camera: pos(${cp.x}, ${cp.y}, ${cp.z}) view=${core.env_int("AE3D_VIEW", 0)} far=300")
    println("zombie_city[diag] shadow: distance ${core.env_int("AE3D_SHADOWDIST", 48)}m, size 2048; fog 12..150m")
    n = list.size(g_lamps)
    i = 0
    while i < n {
        L = list.get_raw(g_lamps, i) as *Light
        if L != null {
            c = L.color
            if L.mode == core.MODE_DIRECTIONAL {
                d = L.direction
                println("zombie_city[diag] light ${i}: DIRECTIONAL dir(${d.x}, ${d.y}, ${d.z}) rgb(${c.x}, ${c.y}, ${c.z}) intensity ${L.intensity} ambient ${L.ambient_strength}")
            } else {
                p = L.position
                println("zombie_city[diag] light ${i}: POINT pos(${p.x}, ${p.y}, ${p.z}) rgb(${c.x}, ${c.y}, ${c.z}) intensity ${L.intensity}")
            }
        }
        i = i + 1
    }
    println("zombie_city[diag] ======================================")
}

on_update(data: ptr, delta: float) {
    if g_near_body == null { return }
    e = data as *Engine
    cam = engine.engine_camera(e)

    // The whole per-frame crowd update is native now (crowd/module.ae -> C):
    // point each velocity along its heading, shove neighbours apart, step and
    // bounce and advance the walk, then sort by distance to the camera into the
    // near and far draw buffers. At a city's worth of zombies the Aether loops
    // this replaces were the wall, not the GPU.
    crowd.crowd_wander(ecs.column_data(g_vel), ecs.column_data(g_yaw), g_count, SPEED)
    // Separation is the crowd's heaviest pass by far -- a full grid rebuild and
    // neighbour scan over every zombie, ~two thirds of the sim at half a
    // million. But a zombie drifts only centimetres a frame, so the pack does
    // not re-cram between frames; running the shove every Nth frame and scaling
    // it up to keep the same steady push is invisible and reclaims most of it.
    g_frame = g_frame + 1
    if g_grid != null && g_sepn > 0 && g_frame % g_sepn == 0 {
        crowd.horde_separate(g_world, g_pos, g_vel, g_grid, SEP_RADIUS,
                             SEP_STRENGTH * (g_sepn as float))
    }
    crowd.crowd_step(ecs.column_data(g_pos), ecs.column_data(g_vel), ecs.column_data(g_yaw),
                     ecs.column_data(g_phase), g_count, delta, MAX_SPEED,
                     STREET_X0, STREET_X1, ROAD_Z0, ROAD_Z1, ROAD_Y, g_walk)
    nn = crowd.crowd_bucket(ecs.column_data(g_pos), ecs.column_data(g_yaw), ecs.column_data(g_phase),
                            ecs.column_data(g_color), g_count, cam.position.x, cam.position.z, g_near_dist, g_cull_dist,
                            ecs.column_data(g_nb_pos), ecs.column_data(g_nb_yaw), ecs.column_data(g_nb_phase), ecs.column_data(g_nb_col),
                            ecs.column_data(g_fb_pos), ecs.column_data(g_fb_yaw), ecs.column_data(g_fb_phase), ecs.column_data(g_fb_col),
                            ecs.column_data(g_farcount))
    // The cull drops the fogged-out zombies, so far is what the bucket counted,
    // not the leftover of n.
    nf = ecs.column_get(g_farcount, 0, 0) as int

    upload_tier(g_near_body, g_nb_pos, g_nb_yaw, g_nb_phase, g_nb_col, nn)
    if g_near_clothes != null { upload_tier(g_near_clothes, g_nb_pos, g_nb_yaw, g_nb_phase, g_nb_col, nn) }
    upload_tier(g_far_body, g_fb_pos, g_fb_yaw, g_fb_phase, g_fb_col, nf)
}

upload_tier(model: *Model, pos: *Column, yaw: *Column, phase: *Column, col: *Column, count: int) {
    core.model_set_instance_draw_count(model, count)
    core.model_set_instance_positions_yaw(model, ecs.column_data(pos),
                                          ecs.column_data(yaw), count)
    core.model_set_instance_phases(model, ecs.column_data(phase), count)
    core.model_set_instance_colors(model, ecs.column_data(col), count)
}

main() {
    e = engine.engine_new(platform.API_GL)
    engine.engine_set_size(e, 1280, 720)
    engine.engine_set_title(e, "ae3d - zombie city")
    engine.engine_set_face_culling(e, true)
    engine.engine_set_camera_input(e, true)
    engine.engine_set_post(e, true, true, 0.85, 0.85)
    engine.engine_set_fog(e, core.fog_distance(12.0, 150.0,
                                               core.vec3(SKY_R, SKY_G, SKY_B), 0.95))
    // A wide shadow box. A small one slides with the camera, so shadows at its
    // edge appear and vanish as you move -- the shadows seemed to follow the
    // camera. 48m keeps the whole visible street in one stable, texel-snapped
    // region; 2048 texels over it is still ~2cm a texel.
    engine.engine_set_shadow_distance(e, core.env_int("AE3D_SHADOWDIST", 48) as float)
    engine.engine_set_frustum_culling(e, true)
    engine.engine_set_user_data(e, e as ptr)
    engine.engine_on_start(e, on_start as fn(ptr))
    engine.engine_on_update(e, on_update as fn(ptr, float))

    engine.engine_run(e, 0 - 1, 0 - 1)

    draws = 0
    renderer = engine.engine_gl_renderer(e)
    if renderer != null { draws = gl.renderer_draw_calls(renderer) }
    println("zombie_city: ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps, ${draws} draws")
}
