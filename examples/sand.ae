// Sand in a desert: a million grains under gravity, settling on a heap of
// sand that is itself a heightfield, under the desert sky and sun the engine
// wrote for itself (tools/make_sky.ae), with dunes at the horizon.
//
// Hold the left button and the probe under the cursor ploughs the heap: the
// sand under it is pushed out into a rim, the rim slides down to the angle
// sand holds, and the grains lying there are shoved aside and fall back.
// Drag it and it cuts a furrow. The ground point comes from a ray cast
// through the camera.
//
//   ./build.sh examples/sand.ae && ./build/sand

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.loader
import ae3d.raycast
import ae3d.rendering
import ae3d.noise

extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)
extern ae3d_ptr_offset(p: ptr, bytes: long) -> ptr

const GRAINS = 1000000
const GRAVITY = 0.0 - 240.0
const FRICTION = 0.86
const BOUNCE = 0.28

// The sun as tools/make_sky.ae painted it into the sky: azimuth -1.9 and
// elevation 0.42, which the light points at, so the shadows fall away from
// the sun that is actually in the frame.
const SUN_X = 0.0 - 0.263
const SUN_Y = 0.581
const SUN_Z = 0.0 - 0.770
// The haze the sky has at its horizon, which the far dunes fade into.
const HAZE_R = 0.86
const HAZE_G = 0.80
const HAZE_B = 0.70
// The desert around the pile: a plain of sand the grains fall on, and dunes
// from there to the horizon. The plain is flat out to FLAT and the dunes
// rise beyond it, over a field DESERT across.
const FLAT = 1400.0
const DESERT = 14000.0
// The grains do not collide with each other, so on a flat floor they lie
// one deep in a rug. What a pile of sand looks like is what the grains
// settle *on*: a heap of sand, a heightfield HEAP_SPAN across at HEAP_CELLS
// a side, that starts as a cone at sand's angle of repose (HEAP_H high over
// HEAP_R out from the middle) and is dug into from there. Every grain
// treats it as its ground, and it is drawn under them in sand.
const HEAP_R = 420.0
const HEAP_H = 200.0
const HEAP_SPAN = 1400.0
const HEAP_CELLS = 140
// The slope loose sand holds, as a rise over a run: about thirty degrees.
// Steeper than that and it slides, which is what shapes a rim.
const REPOSE = 0.58
// The probe: a ball this far across that pushes the sand out of its way.
const PROBE_R = 70.0

// The grains in two tiers. Every grain lives in one array, the moving ones
// packed at its front and the settled ones behind them, and a grain that
// comes to rest is swapped to the back while one the probe disturbs is
// swapped to the front. The front is a model uploaded every frame; the
// back is a model uploaded now and then, when its membership has changed.
// Once the pile has settled that is a few thousand matrices a frame in
// place of a million, and the frame is the draw and nothing else.
var g_model: ptr = null          // the moving grains
var g_settled_model: ptr = null  // the ones at rest
var g_active = GRAINS            // [0, g_active) move
var g_settled_dirty = false
var g_settled_age = 0
var g_position: ptr = null
var g_velocity: ptr = null
var g_tint: ptr = null
var g_seed = 24681357
var g_settled = 0
var g_heap: ptr = null          // HEAP_CELLS * HEAP_CELLS heights, metres
var g_heap_model: ptr = null
var g_heap_changed = false
var g_probe: ptr = null
var g_dig_x = 0.0

next_random() -> float {
    g_seed = (g_seed * 1103515245 + 12345) & 0x7FFFFFFF
    return (g_seed * 1.0) / 2147483647.0
}

seed_grains() {
    position = g_position as float[]
    velocity = g_velocity as float[]
    tint = g_tint as float[]

    i = 0
    while i < GRAINS {
        slot = i * 3
        // Poured over the heap: a disc of grains, denser toward the middle,
        // dropped from a column of heights so the fall lasts.
        angle = next_random() * 6.2831853
        reach = HEAP_R * 1.15 * core.sqrt_of(next_random())
        position[slot] = core.cos_of(angle) * reach
        position[slot + 1] = HEAP_H + 40.0 + next_random() * 900.0
        position[slot + 2] = core.sin_of(angle) * reach
        velocity[slot] = 0.0
        velocity[slot + 1] = 0.0
        velocity[slot + 2] = 0.0
        // No two grains the same colour: the pile reads as sand, not as one
        // paint poured over spheres. Ochre to pale, a few dark.
        shade = 0.78 + next_random() * 0.30
        if next_random() < 0.06 { shade = 0.45 + next_random() * 0.2 }
        tint[slot] = shade
        tint[slot + 1] = shade * (0.84 + next_random() * 0.06)
        tint[slot + 2] = shade * (0.60 + next_random() * 0.08)
        i = i + 1
    }
}

// A plain of sand under the pile, tiled from the engine's own sand texture:
// a quad `size` across with its texture repeating every `metres`.
sand_floor(size: float, metres: float) -> *Model {
    m = core.model_new()
    up = core.vec3(0.0, 1.0, 0.0)
    core.mesh_reserve(m.mesh, 4, 6)
    half = size * 0.5
    reps = size / metres
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - half, 0.0, 0.0 - half), 0.0, 0.0, up)
    core.mesh_push_vertex(m.mesh, core.vec3(half, 0.0, 0.0 - half), reps, 0.0, up)
    core.mesh_push_vertex(m.mesh, core.vec3(half, 0.0, half), reps, reps, up)
    core.mesh_push_vertex(m.mesh, core.vec3(0.0 - half, 0.0, half), 0.0, reps, up)
    core.mesh_push_triangle(m.mesh, 0, 2, 1)
    core.mesh_push_triangle(m.mesh, 0, 3, 2)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// Dunes: a heightfield over the whole desert, flat where the pile forms and
// rising from there to the horizon, ridged the way wind leaves sand.
dunes(cells: int) -> *Model {
    m = core.model_new()
    dune_noise = noise.perlin_new(7719)
    core.mesh_reserve(m.mesh, cells * cells, (cells - 1) * (cells - 1) * 6)
    step = DESERT / ((cells - 1) as float)
    up = core.vec3(0.0, 1.0, 0.0)
    i = 0
    while i < cells {
        j = 0
        while j < cells {
            x = (i as float) * step - DESERT * 0.5
            z = (j as float) * step - DESERT * 0.5
            d = core.sqrt_of(x * x + z * z)
            // Nothing inside the plain, easing up over the next stretch so
            // the first dunes are low and the floor meets them without a lip.
            rise = (d - FLAT) / 2400.0
            if rise < 0.0 { rise = 0.0 }
            if rise > 1.0 { rise = 1.0 }
            rise = rise * rise * (3.0 - 2.0 * rise)
            broad = noise.fbm2(dune_noise, x * 0.00022, z * 0.00022, 4, 0.5)
            ridged = noise.ridge(dune_noise, x * 0.0006, 0.0, z * 0.0006, 3, 0.5)
            dune_h = (broad * 520.0 + ridged * 160.0 - 180.0) * rise
            if dune_h < 0.0 { dune_h = dune_h * 0.15 }
            core.mesh_push_vertex(m.mesh, core.vec3(x, dune_h, z),
                                  (i as float) * 0.6, (j as float) * 0.6, up)
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < cells - 1 {
        j = 0
        while j < cells - 1 {
            near_l = i * cells + j
            near_r = near_l + 1
            far_l = (i + 1) * cells + j
            far_r = far_l + 1
            core.mesh_push_triangle(m.mesh, near_l, far_r, far_l)
            core.mesh_push_triangle(m.mesh, near_l, near_r, far_r)
            j = j + 1
        }
        i = i + 1
    }
    core.mesh_recalculate_normals(m.mesh)
    noise.perlin_free(dune_noise)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// The heap as it starts: a cone eased at its foot and its crown.
heap_init() {
    heights = g_heap as float[]
    i = 0
    while i < HEAP_CELLS {
        j = 0
        while j < HEAP_CELLS {
            x = cell_x(i)
            z = cell_x(j)
            r = core.sqrt_of(x * x + z * z)
            h = 0.0
            if r < HEAP_R {
                t = 1.0 - r / HEAP_R
                h = HEAP_H * t * t * (3.0 - 2.0 * t)
            }
            heights[i * HEAP_CELLS + j] = h
            j = j + 1
        }
        i = i + 1
    }
}

cell_size() -> float { return HEAP_SPAN / ((HEAP_CELLS - 1) as float) }
cell_x(i: int) -> float { return (i as float) * cell_size() - HEAP_SPAN * 0.5 }

// The ground a grain lands on: the heap, read between its cells, and the
// plain past its edge.
heap(x: float, z: float) -> float {
    fx = (x + HEAP_SPAN * 0.5) / cell_size()
    fz = (z + HEAP_SPAN * 0.5) / cell_size()
    if fx < 0.0 || fz < 0.0 || fx >= (HEAP_CELLS - 1) as float || fz >= (HEAP_CELLS - 1) as float { return 0.0 }
    i = fx as int
    j = fz as int
    tx = fx - (i as float)
    tz = fz - (j as float)
    heights = g_heap as float[]
    at = i * HEAP_CELLS + j
    low = heights[at] * (1.0 - tz) + heights[at + 1] * tz
    high = heights[at + HEAP_CELLS] * (1.0 - tz) + heights[at + HEAP_CELLS + 1] * tz
    return low * (1.0 - tx) + high * tx
}

// The heap as a mesh in sand, one vertex a cell, its texture repeating
// every ninety metres like the plain's so the two meet without a seam.
heap_mesh() -> *Model {
    m = core.model_new()
    core.mesh_reserve(m.mesh, HEAP_CELLS * HEAP_CELLS, (HEAP_CELLS - 1) * (HEAP_CELLS - 1) * 6)
    up = core.vec3(0.0, 1.0, 0.0)
    heights = g_heap as float[]
    i = 0
    while i < HEAP_CELLS {
        j = 0
        while j < HEAP_CELLS {
            x = cell_x(i)
            z = cell_x(j)
            core.mesh_push_vertex(m.mesh, core.vec3(x, heights[i * HEAP_CELLS + j], z),
                                  x / 90.0, z / 90.0, up)
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < HEAP_CELLS - 1 {
        j = 0
        while j < HEAP_CELLS - 1 {
            near_l = i * HEAP_CELLS + j
            near_r = near_l + 1
            far_l = (i + 1) * HEAP_CELLS + j
            far_r = far_l + 1
            core.mesh_push_triangle(m.mesh, near_l, far_r, far_l)
            core.mesh_push_triangle(m.mesh, near_l, near_r, far_r)
            j = j + 1
        }
        i = i + 1
    }
    core.mesh_recalculate_normals(m.mesh)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// The heights back into the mesh after a dig, and the normals with them.
heap_refresh() {
    m = g_heap_model as *Model
    if m == null || !g_heap_changed { return }
    heights = g_heap as float[]
    i = 0
    while i < HEAP_CELLS {
        j = 0
        while j < HEAP_CELLS {
            at = i * HEAP_CELLS + j
            core.mesh_set_position(m.mesh, at, core.vec3(cell_x(i), heights[at], cell_x(j)))
            j = j + 1
        }
        i = i + 1
    }
    core.mesh_recalculate_normals(m.mesh)
    g_heap_changed = false
}

// Sand slides: where a cell stands higher over a neighbour than the slope
// sand holds, some of the difference moves down, a quarter a pass so four
// neighbours never overdraw a cell. A few passes a frame keep a fresh rim
// running down to a slope rather than standing as a wall.
heap_relax(passes: int) {
    heap_relax_window(1, 1, HEAP_CELLS - 2, HEAP_CELLS - 2, passes)
}

// The same over one window of cells, which is how the ground around the
// probe gets enough passes to reach its slope while the rest of the heap,
// which is not moving, gets one.
heap_relax_window(i0: int, j0: int, i1: int, j1: int, passes: int) {
    heights = g_heap as float[]
    hold = REPOSE * cell_size()
    if i0 < 1 { i0 = 1 }
    if j0 < 1 { j0 = 1 }
    if i1 > HEAP_CELLS - 2 { i1 = HEAP_CELLS - 2 }
    if j1 > HEAP_CELLS - 2 { j1 = HEAP_CELLS - 2 }
    pass = 0
    while pass < passes {
        i = i0
        while i <= i1 {
            j = j0
            while j <= j1 {
                at = i * HEAP_CELLS + j
                h = heights[at]
                k = 0
                while k < 4 {
                    other = at + 1
                    if k == 1 { other = at - 1 }
                    if k == 2 { other = at + HEAP_CELLS }
                    if k == 3 { other = at - HEAP_CELLS }
                    drop = h - heights[other] - hold
                    if drop > 0.0 {
                        moved = drop * 0.25
                        heights[at] = heights[at] - moved
                        heights[other] = heights[other] + moved
                        h = heights[at]
                        g_heap_changed = true
                    }
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
        pass = pass + 1
    }
}

// The probe pushed into the heap at (cx, cz): a ball sunk a third of the way
// into whatever sand is there. The sand inside it goes out to a rim around
// it, the same volume, so the heap is moved and not deleted; relaxation then
// lets the rim slump. The grains inside are shoved out to its edge, up and
// away, and fall back on whatever is there now.
dig(cx: float, cz: float) {
    heights = g_heap as float[]
    size = cell_size()
    reach = (PROBE_R * 2.2 / size) as int + 1
    ci = ((cx + HEAP_SPAN * 0.5) / size) as int
    cj = ((cz + HEAP_SPAN * 0.5) / size) as int

    // The ball rides on the sand around it, not on the hole it has made:
    // its height comes from the ring just outside it, so a ball held still
    // does not sink a little further every frame into its own crater.
    ring = 0.0
    ring_cells = 0
    i = ci - reach
    while i <= ci + reach {
        j = cj - reach
        while j <= cj + reach {
            if i > 0 && j > 0 && i < HEAP_CELLS - 1 && j < HEAP_CELLS - 1 {
                dx = cell_x(i) - cx
                dz = cell_x(j) - cz
                d = core.sqrt_of(dx * dx + dz * dz)
                if d >= PROBE_R && d < PROBE_R * 1.4 {
                    ring = ring + heights[i * HEAP_CELLS + j]
                    ring_cells = ring_cells + 1
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    ground = heap(cx, cz)
    if ring_cells > 0 { ground = ring / (ring_cells as float) }
    cy = ground + PROBE_R * 0.7

    removed = 0.0
    rim_weight = 0.0
    i = ci - reach
    while i <= ci + reach {
        j = cj - reach
        while j <= cj + reach {
            if i > 0 && j > 0 && i < HEAP_CELLS - 1 && j < HEAP_CELLS - 1 {
                dx = cell_x(i) - cx
                dz = cell_x(j) - cz
                d = core.sqrt_of(dx * dx + dz * dz)
                at = i * HEAP_CELLS + j
                if d < PROBE_R {
                    cap = cy - core.sqrt_of(PROBE_R * PROBE_R - d * d)
                    if heights[at] > cap {
                        removed = removed + (heights[at] - cap)
                        heights[at] = cap
                        g_heap_changed = true
                    }
                } else if d < PROBE_R * 2.2 {
                    rim_weight = rim_weight + (1.0 - (d - PROBE_R) / (PROBE_R * 1.2))
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    if removed > 0.0 && rim_weight > 0.0 {
        i = ci - reach
        while i <= ci + reach {
            j = cj - reach
            while j <= cj + reach {
                if i > 0 && j > 0 && i < HEAP_CELLS - 1 && j < HEAP_CELLS - 1 {
                    dx = cell_x(i) - cx
                    dz = cell_x(j) - cz
                    d = core.sqrt_of(dx * dx + dz * dz)
                    if d >= PROBE_R && d < PROBE_R * 2.2 {
                        share = (1.0 - (d - PROBE_R) / (PROBE_R * 1.2)) / rim_weight
                        heights[i * HEAP_CELLS + j] = heights[i * HEAP_CELLS + j] + removed * share
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
    }

    // The rim slumps to its slope now, while the probe is still in it,
    // with the passes that takes; the ball stays where it is, so what
    // slides back under it is moved out again next frame and the rim
    // settles at the slope sand holds against a ball.
    heap_relax_window(ci - reach * 2, cj - reach * 2, ci + reach * 2, cj + reach * 2, 10)

    // Every grain at rest near the probe wakes: the ground under it has
    // moved, and it has to fall or be lifted with it. The grains in the
    // ball's way are shoved out to its edge, outward and up, the harder the
    // deeper in they were.
    position = g_position as float[]
    velocity = g_velocity as float[]
    wake_r = PROBE_R * 2.4
    n = 0
    while n < GRAINS {
        slot = n * 3
        dx = position[slot] - cx
        dz = position[slot + 2] - cz
        flat_sq = dx * dx + dz * dz
        if flat_sq < wake_r * wake_r {
            if n >= g_active {
                // Into the moving tier. What was at the tier's edge was
                // settled and already looked at, so nothing is skipped.
                swap_grains(n, g_active)
                g_active = g_active + 1
                g_settled_dirty = true
                dx = position[slot] - cx
                dz = position[slot + 2] - cz
                flat_sq = dx * dx + dz * dz
            }
            if flat_sq < PROBE_R * PROBE_R {
                dy = position[slot + 1] - cy
                if dx * dx + dy * dy + dz * dz < PROBE_R * PROBE_R {
                    flat = core.sqrt_of(flat_sq)
                    if flat < 1.0 { flat = 1.0 }
                    inside = 1.0 - flat / PROBE_R
                    velocity[slot] = velocity[slot] + dx / flat * (60.0 + inside * 120.0)
                    velocity[slot + 2] = velocity[slot + 2] + dz / flat * (60.0 + inside * 120.0)
                    velocity[slot + 1] = velocity[slot + 1] + 40.0 + inside * 80.0
                }
            }
        }
        n = n + 1
    }
}

// The probe drawn where it digs, or nowhere.
probe_show(x: float, z: float, on: bool) {
    probe = g_probe as *Model
    if probe == null { return }
    probe.visible = on
    if on { core.model_set_position(probe, x, heap(x, z) + PROBE_R * 0.7, z) }
}

// Grains stop rather than jitter: below a threshold the vertical velocity is
// zeroed instead of bounced, which is what lets a pile actually form.
step_grains(delta: float) {
    position = g_position as float[]
    velocity = g_velocity as float[]

    step = delta
    if step > 0.033 { step = 0.033 }

    i = 0
    while i < g_active {
        slot = i * 3
        vy = velocity[slot + 1] + GRAVITY * step

        x = position[slot] + velocity[slot] * step
        y = position[slot + 1] + vy * step
        z = position[slot + 2] + velocity[slot + 2] * step

        ground = heap(x, z)
        at_rest = false
        if y <= ground {
            y = ground
            if vy < 0.0 - 60.0 {
                vy = (0.0 - vy) * BOUNCE
            } else {
                vy = 0.0
                // Lying on the ground and barely sliding: at rest, and
                // out of the moving tier until something disturbs it.
                vx = velocity[slot] * FRICTION
                vz = velocity[slot + 2] * FRICTION
                at_rest = vx * vx + vz * vz < 4.0
            }
            velocity[slot] = velocity[slot] * FRICTION
            velocity[slot + 2] = velocity[slot + 2] * FRICTION
        }

        position[slot] = x
        position[slot + 1] = y
        position[slot + 2] = z
        velocity[slot + 1] = vy

        if at_rest {
            velocity[slot] = 0.0
            velocity[slot + 2] = 0.0
            g_active = g_active - 1
            swap_grains(i, g_active)
            g_settled_dirty = true
            // The grain swapped in has not been stepped: look at it next.
        } else {
            i = i + 1
        }
    }
    g_settled = GRAINS - g_active
}

// Two grains change places in every array: their positions, their
// velocities and their tints, so a grain keeps its colour whichever tier
// it is in.
swap_grains(a: int, b: int) {
    if a == b { return }
    position = g_position as float[]
    velocity = g_velocity as float[]
    tint = g_tint as float[]
    k = 0
    while k < 3 {
        t = position[a * 3 + k]
        position[a * 3 + k] = position[b * 3 + k]
        position[b * 3 + k] = t
        t = velocity[a * 3 + k]
        velocity[a * 3 + k] = velocity[b * 3 + k]
        velocity[b * 3 + k] = t
        t = tint[a * 3 + k]
        tint[a * 3 + k] = tint[b * 3 + k]
        tint[b * 3 + k] = t
        k = k + 1
    }
}

// Where the cursor ray meets the ground plane. Returns false when it points at
// or above the horizon and never reaches it.
ground_under_cursor(e: *Engine, out: *Vec3) -> bool {
    cam = engine.engine_camera(e)
    window = engine.engine_window(e)
    width = platform.window_width(window)
    height = platform.window_height(window)

    direction = raycast.screen_direction(cam, engine.engine_mouse_x(e),
                                         engine.engine_mouse_y(e), width, height)
    if direction.y >= 0.0 - 0.0001 { return false }

    distance = (0.0 - cam.position.y) / direction.y
    if distance <= 0.0 { return false }

    out.x = cam.position.x + direction.x * distance
    out.y = 0.0
    out.z = cam.position.z + direction.z * distance
    return true
}

on_start(data: ptr) {
    e = data as *Engine

    g_position = calloc(GRAINS * 3, 8)
    g_velocity = calloc(GRAINS * 3, 8)
    g_tint = calloc(GRAINS * 3, 8)
    if g_position == null || g_velocity == null || g_tint == null {
        println("could not allocate the grains")
        return
    }
    seed_grains()

    g_heap = calloc(HEAP_CELLS * HEAP_CELLS, 8)
    if g_heap == null {
        println("could not allocate the heap")
        return
    }
    heap_init()

    engine.engine_set_sky(e, "resources/sky/desert.png")
    // Clouds over the painted sky, drifting, their shadows crossing the ground.
    engine.engine_set_clouds(e, 0.25, 1.0)

    // The heap the grains lie on, in sand, with the sand's relief on it.
    mound = heap_mesh()
    core.model_set_texture(mound, "resources/textures/sand.png")
    if mound.material != null {
        core.material_set_normal_path(mound.material, "resources/textures/sand_normal.png")
    }
    core.model_set_pbr(mound, 0.0, 0.95)
    core.model_set_specular(mound, 0.03, 0.03, 0.03)
    engine.engine_add_model(e, mound)
    g_heap_model = mound as ptr

    // The probe: a pale glass ball, shown while it digs.
    probe = loader.sphere(PROBE_R, 24, 16)
    core.model_set_diffuse(probe, 0.95, 0.97, 1.0)
    core.model_set_alpha(probe, 0.30)
    core.model_set_pbr(probe, 0.0, 0.2)
    core.model_set_casts_shadow(probe, false)
    probe.visible = false
    engine.engine_add_model(e, probe)
    g_probe = probe as ptr

    plain = sand_floor(FLAT * 2.0, 90.0)
    core.model_set_position(plain, 0.0, 0.0 - 1.0, 0.0)
    core.model_set_texture(plain, "resources/textures/sand.png")
    if plain.material != null {
        core.material_set_normal_path(plain.material, "resources/textures/sand_normal.png")
    }
    core.model_set_pbr(plain, 0.0, 0.95)
    core.model_set_specular(plain, 0.03, 0.03, 0.03)
    engine.engine_add_model(e, plain)

    horizon = dunes(160)
    core.model_set_position(horizon, 0.0, 0.0 - 2.0, 0.0)
    core.model_set_texture(horizon, "resources/textures/sand.png")
    core.model_set_pbr(horizon, 0.0, 0.95)
    core.model_set_specular(horizon, 0.03, 0.03, 0.03)
    engine.engine_add_model(e, horizon)

    // A grain a metre and a half across seen from hundreds of metres is a
    // few pixels: an eight-sided sphere is all the silhouette it can show,
    // and a million of anything is a million times its triangles.
    grain = loader.sphere(1.0, 4, 2)
    core.model_set_scale(grain, 1.5, 1.5, 1.5)
    core.model_matte(grain, 1.0, 1.0, 1.0)
    core.model_set_exposure(grain, 1.0)
    rendering.apply(grain, rendering.performance_config())

    core.model_set_casts_shadow(grain, false)
    if !core.model_enable_instancing(grain, GRAINS) { return }
    core.model_enable_instance_colors(grain)
    core.model_set_instance_colors(grain, g_tint, GRAINS)
    engine.engine_add_model(e, grain)
    g_model = grain as ptr

    // The same grain again for the tier at rest.
    still = loader.sphere(1.0, 4, 2)
    core.model_set_scale(still, 1.5, 1.5, 1.5)
    core.model_matte(still, 1.0, 1.0, 1.0)
    core.model_set_exposure(still, 1.0)
    rendering.apply(still, rendering.performance_config())
    core.model_set_casts_shadow(still, false)
    if !core.model_enable_instancing(still, GRAINS) { return }
    core.model_enable_instance_colors(still)
    engine.engine_add_model(e, still)
    // Empty until grains come to rest: after the add, since a model added
    // with no instances is given no instance stream to draw from.
    core.model_set_instance_draw_count(still, 0)
    g_settled_model = still as ptr

    engine.engine_set_clear_color(e, HAZE_R, HAZE_G, HAZE_B)

    // Low, so the sky and the dunes are in the frame with the pile.
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0 - 260.0, 150.0, 820.0))
    core.camera_set_speed(cam, 500.0)
    core.camera_set_far(cam, 30000.0)
    core.camera_look_at(cam, core.vec3(80.0, 150.0, 0.0 - 200.0))

    println("sand: ${GRAINS} grains in one instanced draw, hold the left button to dig")
}

on_update(data: ptr, delta: float) {
    e = data as *Engine
    grain = g_model as *Model
    if grain == null { return }

    // AE3D_NOSTEP=1 and AE3D_NOUPLOAD=1 skip the simulation and the
    // instance upload, so a frame's cost splits into its three parts: at
    // 800k grains the draw is most of it, the 51 MB of instance matrices a
    // frame next, the step least.
    if core.env_int("AE3D_NOSTEP", 0) == 0 { step_grains(delta) }

    // The probe digs while the button is held, and the sand it has moved
    // slides toward the slope it holds, a few passes a frame.
    digging = false
    centre = core.vec3(0.0, 0.0, 0.0)
    if engine.engine_mouse_down(e, platform.MOUSE_LEFT) && ground_under_cursor(e, &centre) {
        dig(centre.x, centre.z)
        digging = true
    }
    // AE3D_DIGX/AE3D_DIGZ (metres) hold the probe at a point without a
    // mouse, walking it along x by AE3D_DIGV metres a second, so a bounded
    // run can show the furrow.
    if core.env_int("AE3D_DIGZ", 0 - 99999) != 0 - 99999 {
        g_dig_x = g_dig_x + (core.env_int("AE3D_DIGV", 0) as float) * delta
        centre.x = (core.env_int("AE3D_DIGX", 0) as float) + g_dig_x
        centre.z = core.env_int("AE3D_DIGZ", 0) as float
        dig(centre.x, centre.z)
        digging = true
    }
    probe_show(centre.x, centre.z, digging)
    heap_relax(1)
    heap_refresh()
    if core.env_int("AE3D_HEAPLOG", 0) != 0 && engine.engine_frame_count(e) % 60 == 0 {
        heights = g_heap as float[]
        total = 0.0
        top = 0.0
        n = 0
        while n < HEAP_CELLS * HEAP_CELLS {
            total = total + heights[n]
            if heights[n] > top { top = heights[n] }
            n = n + 1
        }
        println("sand[diag] frame ${engine.engine_frame_count(e)}: heap volume ${total} cell-metres, top ${top} m, probe at ${centre.x}, ${centre.z}")
    }

    if core.env_int("AE3D_NOUPLOAD", 0) == 0 { upload_tiers() }
}

// The moving tier every frame; the tier at rest only when grains have
// joined or left it, and then no more than a few times a second, since
// what it costs is the whole pile.
upload_tiers() {
    grain = g_model as *Model
    still = g_settled_model as *Model
    core.model_set_instance_draw_count(grain, g_active)
    if g_active > 0 {
        core.model_set_instance_positions(grain, g_position, g_active)
        core.model_set_instance_colors(grain, g_tint, g_active)
    }
    g_settled_age = g_settled_age + 1
    if still != null && g_settled_dirty && g_settled_age >= 20 {
        resting = GRAINS - g_active
        core.model_set_instance_draw_count(still, resting)
        if resting > 0 {
            core.model_set_instance_positions(still, ae3d_ptr_offset(g_position, (g_active * 24) as long), resting)
            core.model_set_instance_colors(still, ae3d_ptr_offset(g_tint, (g_active * 24) as long), resting)
        }
        g_settled_dirty = false
        g_settled_age = 0
    }
}

main() {
    e = engine.engine_new(platform.API_GL)
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d - sand")
    engine.engine_set_face_culling(e, true)

    // The desert sun, where the sky has it; the direction points at it.
    // The sun and the sky's fill, in hundredths: AE3D_SUN=220 AE3D_AMBIENT=34
    // sweep the light without a rebuild.
    light = core.light_directional(core.vec3(SUN_X, SUN_Y, SUN_Z),
                                   core.vec3(1.0, 0.94, 0.82),
                                   core.env_int("AE3D_SUN", 220) as float / 100.0)
    light.ambient_strength = core.env_int("AE3D_AMBIENT", 34) as float / 100.0
    engine.engine_set_light(e, light)
    // The occlusion in the pile, from the scene's depth: a grain in a
    // hollow between its neighbours is darker than one on the crest.
    engine.engine_set_ssao(e, core.env_int("AE3D_SSAO", 1) == 1, 8.0, 1.0)
    // The heap and the probe's furrow throw shadows; the grains do not
    // cast (a million spheres through the shadow pass for a shadow the heap
    // under them already throws), but they receive.
    engine.engine_set_shadow_distance(e, 900.0)
    // Heat haze: the dunes fade to the sky's horizon colour with distance.
    engine.engine_set_fog(e, core.fog_distance(1800.0, 9000.0,
                                               core.vec3(HAZE_R, HAZE_G, HAZE_B), 0.9))

    engine.engine_set_user_data(e, e as ptr)
    engine.engine_on_start(e, on_start as fn(ptr))
    engine.engine_on_update(e, on_update as fn(ptr, float))

    engine.engine_run(e, 0 - 1, 0 - 1)

    println("sand: ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps, ${g_settled} grains settled, ${g_active} moving, ${engine.engine_draw_calls(e)} draw calls")

    grain = g_model as *Model
    if grain != null { core.model_free(grain) }
    still = g_settled_model as *Model
    if still != null { core.model_free(still) }
    if g_position != null { free(g_position) }
    if g_velocity != null { free(g_velocity) }
    if g_tint != null { free(g_tint) }
    if g_heap != null { free(g_heap) }
    core.light_free(light)
    engine.engine_free(e)
}
