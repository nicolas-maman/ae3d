// Under the sea: the moving web of light a water surface throws onto the
// seabed, seen from where it is seen -- below the surface, in the murk, with
// the sun coming through the swell overhead and the light gathering on the
// sand and the rocks.
//
//   ./build.sh examples/caustics.ae && ./build/caustics
//
// AE3D_VIEW=1 puts the camera back above the water looking down through it.

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import ae3d.loader
import ae3d.rendering
import ae3d.water

const REACH = 2400.0
const SEABED = 0.0 - 260.0
// The colour the water fades everything to: deep, green-blue, and dark enough
// that the seabed's far edge is gone before it is seen.
const MURK_R = 0.015
const MURK_G = 0.10
const MURK_B = 0.15

var g_water: ptr = null
var g_seed = 0x3a5c91
next_random() -> float {
    g_seed = (g_seed * 1103515245 + 12345) & 0x7FFFFFFF
    return (g_seed as float) / 2147483647.0
}

lit_by_caustics(m: *Model, grainy: bool) {
    config = rendering.default_config()
    config.caustics = true
    config.caustics_intensity = 1.6
    config.caustics_scale = 0.012
    config.caustics_speed = 0.5
    config.caustics_water_level = 0.0
    config.caustics_depth = 300.0
    // Sand is not one flat colour: the shader's own noise breaks the seabed
    // into ripples and patches, which is all the texture a seabed this far
    // from the eye needs.
    config.perlin_noise = grainy
    config.noise_scale = 0.02
    config.noise_intensity = 0.55
    rendering.apply(m, config)
}

on_start(data: ptr) {
    e = data as *Engine

    seabed = loader.plane(48, REACH / 47.0)
    core.model_set_position(seabed, 0.0 - REACH / 2.0, SEABED, 0.0 - REACH / 2.0)
    core.model_set_diffuse(seabed, 0.62, 0.56, 0.42)
    core.model_set_pbr(seabed, 0.0, 0.95)
    lit_by_caustics(seabed, true)
    engine.engine_add_model(e, seabed)

    // A field of rocks, scattered from the seeded stream so the seabed is the
    // same every run: a few big ones the light webs across, many small.
    placed = 0
    while placed < 42 {
        rock = loader.sphere(1.0, 20, 16)
        big = next_random()
        radius = 14.0 + big * big * 90.0
        core.model_set_scale(rock, radius, radius * (0.45 + next_random() * 0.35), radius)
        core.model_rotate(rock, 0.0, next_random() * 360.0, 0.0)
        core.model_set_position(rock,
                                (next_random() - 0.5) * REACH * 0.8,
                                SEABED + radius * 0.25,
                                (next_random() - 0.5) * REACH * 0.8)
        shade = 0.40 + next_random() * 0.20
        core.model_set_diffuse(rock, shade, shade * 1.02, shade * 0.88)
        core.model_set_specular(rock, 0.02, 0.02, 0.02)
        core.model_set_pbr(rock, 0.0, 0.95)
        lit_by_caustics(rock, true)
        engine.engine_add_model(e, rock)
        placed = placed + 1
    }

    ocean = water.simulation_new(REACH * 4.0, 6.0)
    // Seen from below, the surface is the sky coming through it: light, not
    // the dark of the deep. Both colours are what the underside shows.
    water.simulation_set_color(ocean, 0.18, 0.42, 0.52)
    water.simulation_set_sky_color(ocean, 0.55, 0.78, 0.92)
    // Low, because this scene is about what the surface throws onto the
    // seabed and the seabed has to be visible through it. Set to 0.85 the
    // water was almost opaque and the caustics example showed no caustics.
    water.simulation_set_opacity(ocean, 0.15)
    water.simulation_set_wave_height(ocean, 0.4)

    surface = water.simulation_build(ocean, water.RESOLUTION)
    if surface == null {
        println("could not build the water surface")
        return
    }
    engine.engine_add_model(e, surface)
    g_water = ocean as ptr

    gl.renderer_set_clear_color(engine.engine_gl_renderer(e), MURK_R, MURK_G, MURK_B)

    cam = engine.engine_camera(e)
    if core.env_int("AE3D_VIEW", 0) == 1 {
        core.camera_set_position(cam, core.vec3(0.0, 420.0, 1500.0))
        core.camera_look_at(cam, core.vec3(0.0, SEABED, 0.0))
    } else {
        // Under the surface, a diver's height off the sand, looking along the
        // seabed with the swell overhead.
        core.camera_set_position(cam, core.vec3(0.0 - 420.0, SEABED + 110.0, 760.0))
        core.camera_look_at(cam, core.vec3(180.0, SEABED - 10.0, 0.0 - 400.0))
    }
    core.camera_set_speed(cam, 600.0)
    core.camera_set_far(cam, 40000.0)
}

on_update(data: ptr, delta: float) {
    ocean = g_water as *Simulation
    if ocean == null { return }
    water.simulation_update(ocean, delta)
}

main() {
    e = engine.engine_new(platform.API_GL)
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d - caustics")
    engine.engine_set_face_culling(e, false)
    // The murk: everything fades to the water's colour with distance, which
    // is what says "under water" before anything else in the frame does.
    engine.engine_set_fog(e, core.fog_distance(120.0, 1900.0,
                                               core.vec3(MURK_R, MURK_G, MURK_B), 1.0))

    light = core.light_sun(core.vec3(0.2, 1.0, 0.35))
    light.intensity = 3.5
    light.ambient_strength = 0.18
    engine.engine_set_light(e, light)

    engine.engine_set_user_data(e, e as ptr)
    engine.engine_on_start(e, on_start as fn(ptr))
    engine.engine_on_update(e, on_update as fn(ptr, float))

    engine.engine_run(e, 0 - 1, 0 - 1)

    println("caustics: ${engine.engine_frame_count(e)} frames")

    ocean = g_water as *Simulation
    if ocean != null { water.simulation_free(ocean) }
    core.light_free(light)
    engine.engine_free(e)
}
