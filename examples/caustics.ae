// Under the sea: the moving web of light a water surface throws onto the
// seabed, seen from where it is seen -- below the surface, in the murk, with
// the sun coming through the swell overhead and the light gathering on the
// sand and the rocks.
//
//   ./build.sh examples/caustics.ae && ./build/caustics
//
// AE3D_VIEW=1 puts the camera back above the water looking down through it.

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.loader
import ae3d.rendering
import ae3d.water
import ae3d.noise

// The seabed runs as far as the sea does: the surface is REACH * 4 across,
// and so is the floor under it, so no edge of the world shows through the
// murk. Rolling, from the noise, so it is a seabed and not a table.
const REACH = 2400.0
const SEABED = 0.0 - 260.0
const SEABED_CELLS = 160
// The colour the water fades everything to: deep, green-blue, and dark enough
// that the seabed's far edge is gone before it is seen.
const MURK_R = 0.07
const MURK_G = 0.24
const MURK_B = 0.30

var g_water: ptr = null
var g_seed = 0x3a5c91
next_random() -> float {
    g_seed = (g_seed * 1103515245 + 12345) & 0x7FFFFFFF
    return (g_seed as float) / 2147483647.0
}

// The floor's relief: broad swells of sand and a finer ripple, in metres
// above SEABED, the same everywhere it is asked so the rocks can sit on it.
var g_floor_noise: *Perlin = null
seafloor_height(x: float, z: float) -> float {
    if g_floor_noise == null { g_floor_noise = noise.perlin_new(5150) }
    broad = noise.fbm2(g_floor_noise, x * 0.00045, z * 0.00045, 4, 0.5)
    fine = noise.fbm2(g_floor_noise, x * 0.004 + 3.0, z * 0.004, 3, 0.5)
    return broad * 70.0 + fine * 9.0
}

// The seabed as a heightfield across the whole sea, its sand tiling every
// forty metres.
seafloor(cells: int, size: float) -> *Model {
    m = core.model_new()
    core.mesh_reserve(m.mesh, cells * cells, (cells - 1) * (cells - 1) * 6)
    step = size / ((cells - 1) as float)
    up = core.vec3(0.0, 1.0, 0.0)
    i = 0
    while i < cells {
        j = 0
        while j < cells {
            x = (i as float) * step - size * 0.5
            z = (j as float) * step - size * 0.5
            core.mesh_push_vertex(m.mesh, core.vec3(x, seafloor_height(x, z), z),
                                  x / 40.0, z / 40.0, up)
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < cells - 1 {
        j = 0
        while j < cells - 1 {
            near_l = i * cells + j
            near_r = near_l + 1
            far_l = (i + 1) * cells + j
            far_r = far_l + 1
            core.mesh_push_triangle(m.mesh, near_l, far_r, far_l)
            core.mesh_push_triangle(m.mesh, near_l, near_r, far_r)
            j = j + 1
        }
        i = i + 1
    }
    core.mesh_recalculate_normals(m.mesh)
    core.model_update_matrix(m)
    core.model_recalculate_bounds(m)
    return m
}

// A sphere is not a rock. Its vertices are pushed in and out along their
// normals by noise, a broad lump and a finer grit, so each rock is its own
// shape with facets and hollows for the caustic web to run over.
roughen(m: *Model, seed: int) {
    if g_floor_noise == null { g_floor_noise = noise.perlin_new(5150) }
    offset = (seed as float) * 17.3
    v = 0
    count = core.mesh_vertex_count(m.mesh)
    while v < count {
        at = core.mesh_position(m.mesh, v)
        lump = noise.fbm3(g_floor_noise, at.x * 1.1 + offset, at.y * 1.1, at.z * 1.1, 2, 0.5)
        grit = noise.fbm3(g_floor_noise, at.x * 4.0 + offset, at.y * 4.0, at.z * 4.0 + 5.0, 3, 0.5)
        push = 1.0 + lump * 0.28 + grit * 0.08
        core.mesh_set_position(m.mesh, v, core.vec3(at.x * push, at.y * push, at.z * push))
        v = v + 1
    }
    core.mesh_recalculate_normals(m.mesh)
    core.model_recalculate_bounds(m)
}

lit_by_caustics(m: *Model, grainy: bool) {
    config = rendering.default_config()
    config.caustics = true
    config.caustics_intensity = 1.0
    config.caustics_scale = 0.012
    config.caustics_speed = 0.5
    config.caustics_water_level = 0.0
    config.caustics_depth = 300.0
    // Sand is not one flat colour: the shader's own noise breaks the seabed
    // into ripples and patches, which is all the texture a seabed this far
    // from the eye needs.
    config.perlin_noise = grainy
    config.noise_scale = 0.02
    config.noise_intensity = 0.55
    rendering.apply(m, config)
}

on_start(data: ptr) {
    e = data as *Engine

    seabed = seafloor(SEABED_CELLS, REACH * 4.0)
    core.model_set_position(seabed, 0.0, SEABED, 0.0)
    core.model_set_texture(seabed, "resources/textures/sand.png")
    // The ripples in relief, so the light webs over a surface and not a
    // sheet: the slope of the same sand tools/make_sky.ae painted.
    if seabed.material != null {
        core.material_set_normal_path(seabed.material, "resources/textures/sand_normal.png")
    }
    core.model_set_diffuse(seabed, 0.70, 0.66, 0.55)
    core.model_set_pbr(seabed, 0.0, 0.95)
    core.model_set_specular(seabed, 0.02, 0.02, 0.02)
    lit_by_caustics(seabed, false)
    engine.engine_add_model(e, seabed)

    // A field of rocks, scattered from the seeded stream so the seabed is the
    // same every run: a few big ones the light webs across, many small,
    // each sunk to where the floor is under it and dressed in stone.
    placed = 0
    while placed < 90 {
        rock = loader.sphere(1.0, 20, 16)
        roughen(rock, placed)
        big = next_random()
        radius = 10.0 + big * big * 110.0
        rx = (next_random() - 0.5) * REACH * 1.6
        rz = (next_random() - 0.5) * REACH * 1.6
        core.model_set_scale(rock, radius, radius * (0.40 + next_random() * 0.35), radius)
        core.model_rotate(rock, 0.0, next_random() * 360.0, 0.0)
        core.model_set_position(rock, rx, SEABED + seafloor_height(rx, rz) + radius * 0.12, rz)
        core.model_set_texture(rock, "resources/blender/zombie_street/TrimStone.png")
        if rock.material != null {
            core.material_set_normal_path(rock.material, "resources/blender/zombie_street/TrimStoneNormal.png")
        }
        shade = 0.80 + next_random() * 0.25
        core.model_set_diffuse(rock, shade, shade * 1.02, shade * 0.90)
        core.model_set_specular(rock, 0.02, 0.02, 0.02)
        core.model_set_pbr(rock, 0.0, 0.92)
        lit_by_caustics(rock, false)
        engine.engine_add_model(e, rock)
        placed = placed + 1
    }

    // A swell you can see from underneath: taller waves, and the surface's
    // normals pushed harder so the underside is not one flat sheet of
    // sky-colour but ridges and troughs the light comes through.
    // Waves metres long, not kilometres: the ocean's own table is swells for
    // a sea seen from the air, and from under the surface it is a plain.
    ocean = water.simulation_new(REACH * 4.0, 2.6)
    water.simulation_set_wave_scale(ocean, 500.0)
    water.simulation_set_normal_strength(ocean, 2.4)
    water.simulation_set_wave_speed(ocean, 0.7)
    // Seen from below, the surface is the sky coming through it: light, not
    // the dark of the deep. Both colours are what the underside shows.
    water.simulation_set_color(ocean, 0.26, 0.52, 0.60)
    water.simulation_set_sky_color(ocean, 0.62, 0.82, 0.94)
    // Seen from below, the surface has to be there: the sky comes through
    // it, and at low opacity it is nothing but a faint tint over the sky
    // and vanishes overhead. From above (AE3D_VIEW=1 and 2) the seabed has
    // to show through instead, so the opacity follows the view.
    if core.env_int("AE3D_VIEW", 0) == 0 {
        water.simulation_set_opacity(ocean, 0.82)
    } else {
        water.simulation_set_opacity(ocean, 0.15)
    }
    water.simulation_set_wave_height(ocean, 1.2)

    // Twice the usual resolution: the swell is seen from a diver's height,
    // and at 256 across a sea this wide a vertex every 37 m flattens it.
    surface = water.simulation_build(ocean, 512)
    if surface == null {
        println("could not build the water surface")
        return
    }
    engine.engine_add_model(e, surface)
    g_water = ocean as ptr

    engine.engine_set_clear_color(e, MURK_R, MURK_G, MURK_B)

    cam = engine.engine_camera(e)
    if core.env_int("AE3D_VIEW", 0) == 2 {
        // Just over the surface, looking down through it at the seabed.
        core.camera_set_position(cam, core.vec3(0.0 - 300.0, 40.0, 620.0))
        core.camera_look_at(cam, core.vec3(220.0, SEABED + 40.0, 0.0 - 300.0))
    } else if core.env_int("AE3D_VIEW", 0) == 1 {
        core.camera_set_position(cam, core.vec3(0.0, 420.0, 1500.0))
        core.camera_look_at(cam, core.vec3(0.0, SEABED, 0.0))
    } else {
        // Under the surface, a diver's height off the sand, looking along the
        // seabed with the swell overhead.
        cam_x = 0.0 - 420.0
        cam_z = 760.0
        core.camera_set_position(cam, core.vec3(cam_x, SEABED + seafloor_height(cam_x, cam_z) + 150.0, cam_z))
        // Tilted up enough that the swell overhead is in the frame, not only
        // the floor: the surface is what says this is water.
        core.camera_look_at(cam, core.vec3(180.0, SEABED + 175.0, 0.0 - 400.0))
    }
    core.camera_set_speed(cam, 600.0)
    core.camera_set_far(cam, 40000.0)
}

on_update(data: ptr, delta: float) {
    ocean = g_water as *Simulation
    if ocean == null { return }
    water.simulation_update(ocean, delta)
}

main() {
    e = engine.engine_new(platform.API_GL)
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d - caustics")
    engine.engine_set_face_culling(e, false)
    // The murk: everything fades to the water's colour with distance, which
    // is what says "under water" before anything else in the frame does.
    engine.engine_set_fog(e, core.fog_distance(120.0, 1900.0,
                                               core.vec3(MURK_R, MURK_G, MURK_B), 1.0))

    light = core.light_sun(core.vec3(0.2, 1.0, 0.35))
    light.intensity = 3.5
    light.ambient_strength = 0.30
    engine.engine_set_light(e, light)

    engine.engine_set_user_data(e, e as ptr)
    engine.engine_on_start(e, on_start as fn(ptr))
    engine.engine_on_update(e, on_update as fn(ptr, float))

    engine.engine_run(e, 0 - 1, 0 - 1)

    println("caustics: ${engine.engine_frame_count(e)} frames")

    ocean = g_water as *Simulation
    if ocean != null { water.simulation_free(ocean) }
    if g_floor_noise != null { noise.perlin_free(g_floor_noise) }
    core.light_free(light)
    engine.engine_free(e)
}
