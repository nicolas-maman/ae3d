// A Schwarzschild black hole, drawn by following light backwards to its source.
//
// The previous version of this example simulated 200,000 particles on orbits and
// drew them. It could not do the one thing a black hole is famous for: the hole
// bends the light coming past it, so you see the FAR side of the accretion disc
// arced over the top of the shadow and again underneath it, and a rasteriser
// that projects points through a straight-line camera cannot produce that at any
// particle count.
//
// So this one traces instead. Every pixel is one photon, integrated backwards
// from the eye through curved spacetime until it lands on the disc or crosses the
// horizon, and the whole frame is a single screen quad -- one draw call.
//
// What comes out of that rather than being painted on:
//
//   * the shadow, and its rim at the photon sphere, where rays that graze 1.5
//     r_s wind round the hole before escaping;
//   * the far side of the disc lifted over the top of the shadow and under it,
//     because a ray that passes close crosses the disc plane twice;
//   * relativistic Doppler beaming, so the approaching side is brighter and
//     bluer -- with the photon direction taken at the point of emission, which
//     is not the direction it arrives from once the path has bent;
//   * gravitational redshift, deepest at the inner edge;
//   * a Shakura-Sunyaev temperature profile and its r^-3 surface brightness;
//   * two jets along the spin axis, integrated as emission along the same path.
//
// Lengths are in Schwarzschild radii: r_s = 1, the horizon is the unit sphere,
// the photon sphere is 1.5, the innermost stable circular orbit is 3.
//
// What is NOT modelled, so it is not mistaken for a bug:
//
//   * the hole does not spin. This is Schwarzschild and not Kerr, so there is
//     no frame dragging and no ergosphere, and the ISCO sits at 3 r_s where a
//     maximally spinning hole would put it at 1;
//   * the disc is a plane with no thickness, crossed rather than marched
//     through, so it has no vertical structure and casts no shadow on itself;
//   * there is no background sky, so nothing behind the hole is there to be
//     lensed into an Einstein ring. Everything visible is the disc and the jets.
//
//   ./build.sh examples/black_hole.ae && ./build/black_hole

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import ae3d.loader

const VERTEX_LENS = <<GLSL_END
#version 410 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aTexCoord;

out vec2 screenUV;

// The quad is loader.quad(2.0, 2.0): x and z run -1..1 in the XZ plane, which is
// clip space already. Nothing here reads the model or view matrices -- the
// camera arrives as a basis in the fragment shader instead, because a ray is
// what this needs and a matrix would only have to be taken apart again to get
// one.
void main() {
    screenUV = aTexCoord;
    gl_Position = vec4(aPos.x, aPos.z, 0.0, 1.0);
}
GLSL_END

const FRAGMENT_LENS = <<GLSL_END
#version 410 core

in vec2 screenUV;
out vec4 FragColor;

uniform vec3 camPos;
uniform vec3 camRight;
uniform vec3 camUp;
uniform vec3 camFwd;
uniform float tanHalfFov;
uniform float aspectRatio;
uniform float discTime;

const float ISCO       = 3.0;
const float DISC_OUT   = 13.0;
const float ESCAPE     = 55.0;
const float T_PEAK     = 5400.0;
const float PEAK_SHAPE = 0.4879;
const float DISC_GAIN  = 0.38;

const int   STEPS      = 480;
const float DPHI       = 0.031;

const float JET_BASE   = 1.35;
const float JET_LEN    = 34.0;
const float JET_BETA   = 0.85;
const float T_JET      = 21000.0;
const float JET_GAIN   = 0.55;

// The Planck locus in sRGB, walked in mireds -- a million over the temperature.
// Mireds are the axis colour temperature is linear in: 2000 K to 3000 K is an
// enormous change and 20000 K to 21000 K is invisible, and 500 -> 333 against
// 50 -> 47.6 says exactly that.
vec3 blackbody(float kelvin) {
    float k = clamp(kelvin, 1000.0, 40000.0);
    float m = 1000000.0 / k;

    if (m <  50.0) return mix(vec3(0.58, 0.70, 1.00), vec3(0.63, 0.74, 1.00), (m -  25.0) /  25.0);
    if (m <  83.3) return mix(vec3(0.63, 0.74, 1.00), vec3(0.71, 0.80, 1.00), (m -  50.0) /  33.3);
    if (m < 125.0) return mix(vec3(0.71, 0.80, 1.00), vec3(0.82, 0.87, 1.00), (m -  83.3) /  41.7);
    if (m < 153.8) return mix(vec3(0.82, 0.87, 1.00), vec3(1.00, 1.00, 1.00), (m - 125.0) /  28.8);
    if (m < 200.0) return mix(vec3(1.00, 1.00, 1.00), vec3(1.00, 0.90, 0.82), (m - 153.8) /  46.2);
    if (m < 250.0) return mix(vec3(1.00, 0.90, 0.82), vec3(1.00, 0.81, 0.64), (m - 200.0) /  50.0);
    if (m < 333.3) return mix(vec3(1.00, 0.81, 0.64), vec3(1.00, 0.69, 0.43), (m - 250.0) /  83.3);
    if (m < 500.0) return mix(vec3(1.00, 0.69, 0.43), vec3(1.00, 0.49, 0.16), (m - 333.3) / 166.7);
    return           mix(vec3(1.00, 0.49, 0.16), vec3(1.00, 0.22, 0.00), (m - 500.0) / 500.0);
}

float hash21(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

float vnoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash21(i),                  hash21(i + vec2(1.0, 0.0)), f.x),
               mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), f.x), f.y);
}

float turbulence(vec2 p) {
    return 0.60 * vnoise(p) + 0.28 * vnoise(p * 2.17) + 0.12 * vnoise(p * 4.51);
}

// T(r) as r^(-3/4) times the (1 - sqrt(ISCO/r))^(1/4) zero-torque inner
// boundary, so the disc peaks a little outside the ISCO rather than at it.
float discShape(float r) {
    float u = ISCO / r;
    if (u >= 1.0) return 0.0;
    float s = sqrt(u);
    return sqrt(u * s) * sqrt(sqrt(1.0 - s));
}

// photonDir is the direction the light TRAVELS, emitter to eye. Backwards
// tracing walks the other way, so the caller negates the marching direction --
// and it has to be taken here, at the emission point, because the path bends
// between here and the camera.
// Returns emission in rgb and how much of the ray the gas stops in a. Those are
// the same number twice for a reason: the rim of a disc thins out rather than
// ending at a drawn circle, and thin gas both emits less AND blocks less. Fading
// only the brightness left a rim that was invisible and still opaque, so every
// ray aimed just below the horizon of the frame was stopped dead by it and the
// bright far side behind it never got drawn -- a hard horizontal seam across the
// image, exactly where the rays stop being aimed upward.
vec4 discSample(vec3 p, vec3 photonDir) {
    float r = length(p.xz);
    if (r < ISCO || r > DISC_OUT) return vec4(0.0);

    float rim = 1.0 - smoothstep(DISC_OUT - 3.2, DISC_OUT, r);
    if (rim <= 0.0) return vec4(0.0);

    float temp = T_PEAK * discShape(r) / PEAK_SHAPE;

    // Keplerian circular orbit, in units where r_s = 1 and c = 1:
    // v/c = sqrt(r_s / 2r), which is 0.408 at the ISCO.
    float beta  = sqrt(0.5 / r);
    float gamma = 1.0 / sqrt(max(1.0 - beta * beta, 1e-4));
    vec3  rhat  = normalize(vec3(p.x, 0.0, p.z));
    vec3  vhat  = normalize(cross(vec3(0.0, 1.0, 0.0), rhat));
    float dop   = 1.0 / max(gamma * (1.0 - dot(beta * vhat, photonDir)), 0.06);

    // Gravitational redshift, from the emitter's depth in the well.
    float grav  = sqrt(max(1.0 - 1.0 / r, 1e-4));
    float shift = dop * grav;

    // Stefan-Boltzmann: the local flux goes as T^4, which is what makes the
    // inner disc outshine the rim rather than merely out-blue it. Beaming is the
    // fourth power of the Doppler factor for an optically thick surface
    // integrated over its spectrum.
    float ratio = temp / T_PEAK;
    float flux  = ratio * ratio * ratio * ratio;
    float beam  = shift * shift * shift * shift;

    // Turbulence that shears the way the disc does. Sampling a field rotated
    // backwards by the local orbital phase is seamless in azimuth -- there is no
    // angle coordinate to wrap -- and differential rotation stretches it into
    // spiral banding on its own, because the inner disc winds faster.
    float phase = -(beta / r) * discTime * 26.0;
    float ca = cos(phase);
    float sa = sin(phase);
    vec2  q  = vec2(p.x * ca - p.z * sa, p.x * sa + p.z * ca);
    float band = 0.32 + 1.35 * turbulence(q * 1.15);

    return vec4(blackbody(temp * shift) * (flux * beam * band * DISC_GAIN), rim);
}

// The jets are emission spread along the path rather than a surface to land on,
// so they are integrated over each segment instead of stopping the ray.
//
// Seen this close to edge-on they are dim, and correctly so: the outflow is very
// nearly perpendicular to the line of sight, which leaves only transverse
// Doppler, and that alone costs a factor of gamma^4 -- about thirteen at 0.85 c.
// JET_GAIN buys that back for the display. It is the one number here chosen to
// be seen rather than derived.
vec3 jetEmission(vec3 p, vec3 photonDir) {
    float ay = abs(p.y);
    if (ay < JET_BASE || ay > JET_LEN) return vec3(0.0);

    float open = 0.20 + 0.075 * ay;
    float rad  = length(p.xz);
    if (rad > open) return vec3(0.0);

    float across  = rad / open;
    float profile = exp(-3.2 * across * across) / (1.0 + 0.09 * ay * ay);

    // Bulk motion straight out along the axis. The near jet is beamed towards
    // the eye and the far one away from it, which is why one is bright and its
    // twin is nearly invisible -- in real sources as much as here.
    float gamma = 1.0 / sqrt(1.0 - JET_BETA * JET_BETA);
    vec3  bvec  = vec3(0.0, sign(p.y) * JET_BETA, 0.0);
    float dop   = 1.0 / max(gamma * (1.0 - dot(bvec, photonDir)), 0.06);
    float beam  = dop * dop * dop * dop;

    float temp = T_JET * sqrt(JET_BASE / ay);
    return blackbody(temp * dop) * (profile * beam * JET_GAIN);
}

void main() {
    vec2 ndc = screenUV * 2.0 - 1.0;
    vec3 rd  = normalize(camFwd
                       + camRight * (ndc.x * aspectRatio * tanHalfFov)
                       + camUp    * (ndc.y * tanHalfFov));
    vec3 ro = camPos;

    // The photon's whole path lies in the plane through the origin containing
    // the eye and the ray, so the geodesic is a one-dimensional problem: u(phi)
    // with u = 1/r, obeying u'' = -u + 1.5 r_s u^2. Two numbers to integrate
    // instead of a position and a momentum in three.
    vec3  nrm = cross(ro, rd);
    float nl  = length(nrm);
    if (nl < 1e-6) {
        // Dead on, or dead away: no plane, and nothing to see either way.
        FragColor = vec4(0.0, 0.0, 0.0, 1.0);
        return;
    }
    nrm /= nl;
    vec3 e1 = normalize(ro);
    vec3 e2 = normalize(cross(nrm, e1));

    float r0 = length(ro);
    float u  = 1.0 / r0;
    float du = -u * dot(rd, e1) / max(dot(rd, e2), 1e-6);

    // phi advances by a fixed step, so its cosine and sine come from turning a
    // unit vector by that step each time rather than from two transcendentals
    // per iteration. Over a few hundred steps the drift stays far below a pixel.
    float cd = cos(DPHI);
    float sd = sin(DPHI);
    float cp = 1.0;
    float sp = 0.0;

    vec3  colour   = vec3(0.0);
    float transmit = 1.0;
    vec3  prev     = ro;
    float prevY    = ro.y;

    for (int i = 0; i < STEPS; i++) {
        // Runge-Kutta 4 on (u, du).
        float k1u = du;
        float k1d = -u + 1.5 * u * u;
        float ua  = u + 0.5 * DPHI * k1u;
        float k2u = du + 0.5 * DPHI * k1d;
        float k2d = -ua + 1.5 * ua * ua;
        float ub  = u + 0.5 * DPHI * k2u;
        float k3u = du + 0.5 * DPHI * k2d;
        float k3d = -ub + 1.5 * ub * ub;
        float uc  = u + DPHI * k3u;
        float k4u = du + DPHI * k3d;
        float k4d = -uc + 1.5 * uc * uc;

        u  += (DPHI / 6.0) * (k1u + 2.0 * k2u + 2.0 * k3u + k4u);
        du += (DPHI / 6.0) * (k1d + 2.0 * k2d + 2.0 * k3d + k4d);

        float nc = cp * cd - sp * sd;
        float ns = sp * cd + cp * sd;
        cp = nc;
        sp = ns;

        if (u <= 0.0) break;              // escaped to infinity
        float r = 1.0 / u;
        if (r >= ESCAPE) break;           // far enough that nothing is left to hit
        if (r <= 1.0) break;              // through the horizon: this is the shadow

        vec3  p   = r * (cp * e1 + sp * e2);
        vec3  seg = p - prev;
        float len = length(seg);
        if (len < 1e-8) { prev = p; prevY = p.y; continue; }
        vec3 marchDir = seg / len;

        colour += transmit * jetEmission(0.5 * (p + prev), -marchDir) * len;

        // The disc is a plane, so a crossing is a sign change in y. Rays that
        // pass close cross it twice, which is exactly how the far side comes to
        // be visible above the shadow as well as below it.
        if (prevY * p.y < 0.0) {
            float t = prevY / (prevY - p.y);
            vec3  x = prev + t * seg;
            vec4  em = discSample(x, -marchDir);
            if (em.a > 0.0) {
                colour  += transmit * em.a * em.rgb;
                transmit *= 1.0 - em.a;
                // Opaque over most of its area, so most rays end here; only the
                // thin rim lets anything through to be seen behind it.
                if (transmit < 0.02) break;
            }
        }

        prev  = p;
        prevY = p.y;
    }

    // ACES, then sRGB -- the same tonemap the lit path uses, so the bright side
    // of the disc rolls off to white instead of clipping channel by channel and
    // sliding in hue on the way.
    vec3 x = colour;
    vec3 mapped = clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
    FragColor = vec4(pow(mapped, vec3(1.0 / 2.2)), 1.0);
}
GLSL_END

var g_screen: ptr = null
var g_time = 0.0

on_start(data: ptr) {
    e = data as *Engine

    // One quad, covering the frame. loader.quad puts it in the XZ plane with
    // corners at +/-1, which the vertex shader reads straight as clip space.
    screen = loader.quad(2.0, 2.0)
    core.model_set_shader(screen, core.shader_new(VERTEX_LENS, FRAGMENT_LENS))
    engine.engine_add_model(e, screen)
    g_screen = screen as ptr

    renderer = engine.engine_gl_renderer(e)
    gl.renderer_set_clear_color(renderer, 0.0, 0.0, 0.0)
    gl.renderer_set_bloom(renderer, true)
    gl.renderer_set_bloom_params(renderer, 0.62, 0.55)

    // Nine degrees above the disc. Nearly edge-on is where the lensing shows:
    // steeper and the far side stops arcing over the shadow, shallower and the
    // disc closes up into a line.
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0, 4.6, 30.0))
    core.camera_set_speed(cam, 9.0)
    core.camera_set_near(cam, 0.05)
    core.camera_set_far(cam, 400.0)
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))

    println("black hole: one screen quad, geodesics integrated per pixel")
}

on_update(data: ptr, delta: float) {
    screen = g_screen as *Model
    if screen == null { return }
    g_time = g_time + delta

    e = data as *Engine
    cam = engine.engine_camera(e)

    half_fov = core.deg_to_rad(cam.fov) * 0.5
    core.model_set_uniform_vec3(screen, "camPos", cam.position)
    core.model_set_uniform_vec3(screen, "camRight", cam.right)
    core.model_set_uniform_vec3(screen, "camUp", cam.up)
    core.model_set_uniform_vec3(screen, "camFwd", cam.front)
    core.model_set_uniform_float(screen, "tanHalfFov",
                                 core.sin_of(half_fov) / core.cos_of(half_fov))
    core.model_set_uniform_float(screen, "aspectRatio", cam.aspect)
    core.model_set_uniform_float(screen, "discTime", g_time)
}

main() {
    e = engine.engine_new(platform.API_GL)
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d - black hole")

    // The quad's winding is back-facing once the vertex shader has mapped it
    // into clip space, and there is nothing else in the scene to cull.
    engine.engine_set_face_culling(e, false)

    // Nothing in the frame is lit: every pixel is emission the shader works out
    // for itself. The light exists because the engine expects one.
    light = core.light_directional(core.vec3(0.0, 1.0, 0.0),
                                   core.vec3(1.0, 1.0, 1.0), 1.0)
    light.ambient_strength = 0.0
    engine.engine_set_light(e, light)

    engine.engine_set_user_data(e, e as ptr)
    engine.engine_on_start(e, on_start as fn(ptr))
    engine.engine_on_update(e, on_update as fn(ptr, float))

    engine.engine_run(e, 0 - 1, 0 - 1)

    println("black hole: ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps, ${gl.renderer_draw_calls(engine.engine_gl_renderer(e))} draw call(s)")

    screen = g_screen as *Model
    if screen != null { core.model_free(screen) }
    core.light_free(light)
    engine.engine_free(e)
}
