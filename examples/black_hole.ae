// A spinning black hole, drawn by following light backwards to its source.
//
// Every pixel is one photon, integrated backwards from the eye through curved
// spacetime until it reaches the disc, crosses the horizon, or escapes to the
// sky. The whole frame is a single screen quad -- one draw call.
//
// The metric is Kerr, in Boyer-Lindquist coordinates, so the hole spins. That
// is not a detail: a spinning hole drags spacetime round with it, which pushes
// the innermost stable orbit inward (6 M when a = 0, down towards 1 M as a
// approaches 1), makes the hot inner disc hotter and faster, and pulls the
// shadow itself out of round -- flattened on the side where the dragging runs
// towards the observer.
//
// What falls out of the integration rather than being painted on:
//
//   * the shadow, its rim built from rays that wind round the photon sphere
//     several times before escaping, and its asymmetry from the spin;
//   * the far side of the disc lifted over the top of the shadow and under it;
//   * the background sky lensed -- stars near the hole are drawn as arcs, and
//     the ring of images around the shadow is the same integration, not an
//     effect laid on afterwards;
//   * one redshift factor doing the work of three. g = 1 / (u^t (1 - omega L))
//     folds gravitational redshift, Doppler beaming and frame dragging into a
//     single number, because all three are the same statement about how the
//     emitter's clock runs against the observer's;
//   * a disc with thickness, marched through rather than crossed, so it
//     obscures itself and its silhouette is soft;
//   * two jets along the spin axis, integrated as emission along the same path.
//
// Lengths are in units of M, the gravitational radius. The horizon sits at
// 1 + sqrt(1 - a^2), which is 2 for a non-spinning hole and 1 for a maximal one.
//
// Setting SPIN to 0 turns the metric back into Schwarzschild, and the picture
// back into the non-spinning one: the ISCO returns to 6 M, the shadow to a
// circle. That is the test this was built against -- an a = 0 run has a known
// answer, and a Kerr integrator that cannot reproduce it is wrong somewhere.
//
// Still not modelled: the disc is Keplerian and geometrically thin (H/r =
// 0.015) rather than a solution of anything, the jets are a shape rather than a
// magnetohydrodynamic result, and there is no self-illumination -- the disc
// does not light itself, and the hole does not light it either.
//
//   ./build.sh examples/black_hole.ae && ./build/black_hole

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import ae3d.loader

// 0 is Schwarzschild, 0.998 is the Thorne limit that accretion holds a real
// hole to. Everything below reads this: the horizon, the ISCO, the orbital
// speeds and the shape of the shadow all follow from it.
const SPIN = 0.9

const VERTEX_LENS = <<GLSL_END
#version 410 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aTexCoord;

out vec2 screenUV;

// The quad is loader.quad(2.0, 2.0): x and z run -1..1 in the XZ plane, which is
// clip space already. Nothing here reads the model or view matrices -- the
// camera arrives as a basis in the fragment shader instead, because a ray is
// what this needs and a matrix would only have to be taken apart again to get
// one.
void main() {
    screenUV = aTexCoord;
    gl_Position = vec4(aPos.x, aPos.z, 0.0, 1.0);
}
GLSL_END

const FRAGMENT_LENS = <<GLSL_END
#version 410 core

in vec2 screenUV;
out vec4 FragColor;

uniform vec3 camPos;
uniform vec3 camRight;
uniform vec3 camUp;
uniform vec3 camFwd;
uniform float tanHalfFov;
uniform float aspectRatio;
uniform float discTime;
uniform float spin;

const float DISC_OUT   = 22.0;
const float ESCAPE     = 130.0;
const float T_PEAK     = 5400.0;
const float PEAK_SHAPE = 0.4879;
const float DISC_GAIN  = 0.78;
const float DISC_H     = 0.015;
const float DISC_K     = 70.0;

const int   STEPS      = 400;
const float STEP_ARC   = 0.026;

const float JET_BASE   = 2.7;
const float JET_LEN    = 60.0;
const float JET_BETA   = 0.85;
const float T_JET      = 21000.0;
const float JET_GAIN   = 0.9;

const float STAR_GAIN  = 1.25;

// The Planck locus in sRGB, walked in mireds -- a million over the temperature.
// Mireds are the axis colour temperature is linear in: 2000 K to 3000 K is an
// enormous change and 20000 K to 21000 K is invisible, and 500 -> 333 against
// 50 -> 47.6 says exactly that.
vec3 blackbody(float kelvin) {
    float k = clamp(kelvin, 1000.0, 40000.0);
    float m = 1000000.0 / k;

    if (m <  50.0) return mix(vec3(0.58, 0.70, 1.00), vec3(0.63, 0.74, 1.00), (m -  25.0) /  25.0);
    if (m <  83.3) return mix(vec3(0.63, 0.74, 1.00), vec3(0.71, 0.80, 1.00), (m -  50.0) /  33.3);
    if (m < 125.0) return mix(vec3(0.71, 0.80, 1.00), vec3(0.82, 0.87, 1.00), (m -  83.3) /  41.7);
    if (m < 153.8) return mix(vec3(0.82, 0.87, 1.00), vec3(1.00, 1.00, 1.00), (m - 125.0) /  28.8);
    if (m < 200.0) return mix(vec3(1.00, 1.00, 1.00), vec3(1.00, 0.90, 0.82), (m - 153.8) /  46.2);
    if (m < 250.0) return mix(vec3(1.00, 0.90, 0.82), vec3(1.00, 0.81, 0.64), (m - 200.0) /  50.0);
    if (m < 333.3) return mix(vec3(1.00, 0.81, 0.64), vec3(1.00, 0.69, 0.43), (m - 250.0) /  83.3);
    if (m < 500.0) return mix(vec3(1.00, 0.69, 0.43), vec3(1.00, 0.49, 0.16), (m - 333.3) / 166.7);
    return           mix(vec3(1.00, 0.49, 0.16), vec3(1.00, 0.22, 0.00), (m - 500.0) / 500.0);
}

float hash31(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.zyx + 31.32);
    return fract((p.x + p.y) * p.z);
}

// Stars, as a function of the direction a ray finally leaves in. Nothing here is
// a texture lookup: the sky is generated from the escape direction, so every
// star the hole has moved is drawn where the geodesic says it now is, and the
// arcs around the shadow are the same integration as everything else.
vec3 starfield(vec3 dir) {
    vec3 q  = dir * 260.0;
    vec3 id = floor(q);
    vec3 f  = fract(q) - 0.5;

    float pick = hash31(id);
    if (pick < 0.955) return vec3(0.0);

    vec3 off = vec3(hash31(id + 11.0), hash31(id + 23.0), hash31(id + 37.0));
    off = (off - 0.5) * 0.5;

    vec3  d   = f - off;
    float dsq = dot(d, d);
    float mag = (pick - 0.955) / 0.045;

    // The falloff has to be set against the cell, not against nothing: at this
    // scale one cell is about four pixels across, and a tighter exponent put
    // every star inside a fifth of a pixel, where it either aliased away or
    // flickered. This leaves a dot of roughly a pixel and a half.
    float glow = exp(-dsq * 26.0) * mag * mag;
    if (glow < 0.004) return vec3(0.0);

    float t = hash31(id + 53.0);
    return blackbody(2600.0 + 15000.0 * t * t) * (glow * STAR_GAIN);
}

float hash21(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

float vnoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash21(i),                  hash21(i + vec2(1.0, 0.0)), f.x),
               mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), f.x), f.y);
}

float turbulence(vec2 p) {
    return 0.60 * vnoise(p) + 0.28 * vnoise(p * 2.17) + 0.12 * vnoise(p * 4.51);
}

// Prograde innermost stable circular orbit. 6 M with no spin, falling to 1 M as
// a approaches 1: the disc's inner edge, and with it everything hot, moves in as
// the hole spins faster.
float iscoRadius(float a) {
    float z1 = 1.0 + pow(1.0 - a * a, 1.0 / 3.0)
                   * (pow(1.0 + a, 1.0 / 3.0) + pow(1.0 - a, 1.0 / 3.0));
    float z2 = sqrt(3.0 * a * a + z1 * z1);
    return 3.0 + z2 - sqrt(max((3.0 - z1) * (3.0 + z1 + 2.0 * z2), 0.0));
}

float discShape(float r, float isco) {
    float u = isco / r;
    if (u >= 1.0) return 0.0;
    float s = sqrt(u);
    return sqrt(u * s) * sqrt(sqrt(1.0 - s));
}

// Boyer-Lindquist to world. The spin axis is world +Y, so BL's z is world y.
// The radial coordinate is oblate: surfaces of constant r are ellipsoids, not
// spheres, which is why sqrt(r^2 + a^2) appears instead of r.
vec3 blToWorld(float r, float th, float ph, float a) {
    float s  = sin(th);
    float rr = sqrt(r * r + a * a);
    return vec3(rr * s * cos(ph), r * cos(th), rr * s * sin(ph));
}

// Just the radial coordinate, which is all the disc needs and avoids an acos
// and an atan2 on every sub-sample.
float blRadius(vec3 w, float a) {
    float t = dot(w, w) - a * a;
    return sqrt(max(0.5 * (t + sqrt(max(t * t + 4.0 * a * a * w.y * w.y, 0.0))), 1e-8));
}

vec3 worldToBL(vec3 w, float a) {
    float rho2 = dot(w, w);
    float t    = rho2 - a * a;
    float r2   = 0.5 * (t + sqrt(max(t * t + 4.0 * a * a * w.y * w.y, 0.0)));
    float r    = sqrt(max(r2, 1e-8));
    return vec3(r, acos(clamp(w.y / r, -1.0, 1.0)), atan(w.z, w.x));
}

// The geodesic, as Hamilton's equations for a null ray. Writing
//
//     Sigma * 2H = Delta pr^2 + pth^2 - P^2/Delta + Q^2
//
// with P = (r^2+a^2) pt + a L and Q = a sin(th) pt + L/sin(th), the whole system
// is derivatives of that one expression. Two of the four momenta are constants
// of the motion -- pt is the energy and L is the angular momentum -- so only pr
// and pth have to be carried.
//
// H is zero along the path, which is what lets the dSigma terms be dropped from
// the r and theta derivatives: they are multiplied by H.
void deriv(vec3 x, vec2 p, float a, float L, out vec3 dx, out vec2 dp) {
    float r = x.x;
    float s = sin(x.y);
    if (abs(s) < 1e-4) s = s < 0.0 ? -1e-4 : 1e-4;
    float c = cos(x.y);

    float sig = r * r + a * a * c * c;
    float del = r * r - 2.0 * r + a * a;
    if (abs(del) < 1e-6) del = 1e-6;
    float isig = 1.0 / sig;

    float P = -(r * r + a * a) + a * L;   // pt = -1
    float Q = -a * s + L / s;

    dx.x = del * p.x * isig;
    dx.y = p.y * isig;
    dx.z = (-a * P / del + Q / s) * isig;

    // dP/dr is -2r, not +2r: P = -(r^2+a^2) + aL. Differentiating -P^2/Delta
    // gives -2 P P'/Delta + P^2 Delta'/Delta^2, and with P' = -2r that first
    // term is +4rP/Delta. Getting its sign wrong does not merely bend the ray
    // slightly -- it drives the radial equation the wrong way, and every ray in
    // the frame spirals into the horizon regardless of how much angular
    // momentum it has.
    float dpr = (2.0 * r - 2.0);
    float dFdr = dpr * p.x * p.x + 4.0 * r * P / del + P * P * dpr / (del * del);
    dp.x = -0.5 * dFdr * isig;

    float dQ = -a * c - L * c / (s * s);
    dp.y = -0.5 * (2.0 * Q * dQ) * isig;
}

// Everything about how the disc looks at a point, in one number: the ratio of
// the frequency the observer receives to the frequency the gas emitted.
//
//   g = 1 / ( u^t (1 - omega L) )
//
// u^t is how fast the orbiting gas's clock runs against a distant one, which is
// the gravitational part; omega L is the projection of its motion onto the
// photon, which is the Doppler part; and omega itself is 1/(r^3/2 + a), where
// the a is frame dragging. One expression, because they are one effect.
float redshift(float r, float a, float L) {
    float om  = 1.0 / (r * sqrt(r) + a);
    float gtt = -(1.0 - 2.0 / r);
    float gtp = -2.0 * a / r;
    float gpp = r * r + a * a + 2.0 * a * a / r;
    float den = -(gtt + 2.0 * om * gtp + om * om * gpp);
    float ut  = 1.0 / sqrt(max(den, 1e-5));
    return 1.0 / max(ut * (1.0 - om * L), 1e-3);
}

float discDensity(float r, float worldY, float isco) {
    if (r < isco || r > DISC_OUT) return 0.0;
    float h = DISC_H * r;
    float z = worldY / h;
    return exp(-z * z) * (1.0 - smoothstep(DISC_OUT - 5.0, DISC_OUT, r));
}

vec3 discEmission(float r, vec3 world, float a, float L, float isco) {
    float temp  = T_PEAK * discShape(r, isco) / PEAK_SHAPE;
    float shift = redshift(r, a, L);

    // Stefan-Boltzmann for what the gas radiates, and the fourth power of the
    // shift for what survives the trip: specific intensity over frequency cubed
    // is the invariant, so a bolometric intensity scales as g^4.
    float ratio = temp / T_PEAK;
    float flux  = ratio * ratio * ratio * ratio;
    float beam  = shift * shift * shift * shift;

    // Turbulence sheared by the flow. Sampling a field rotated backwards by the
    // local orbital phase is seamless in azimuth -- there is no angle coordinate
    // to wrap -- and differential rotation stretches it into spiral banding on
    // its own, because the inner disc winds faster.
    float om    = 1.0 / (r * sqrt(r) + a);
    float phase = -om * discTime * 90.0;
    float ca = cos(phase);
    float sa = sin(phase);
    vec2  q  = vec2(world.x * ca - world.z * sa, world.x * sa + world.z * ca);
    float band = 0.32 + 1.35 * turbulence(q * 0.66);

    return blackbody(temp * shift) * (flux * beam * band * DISC_GAIN);
}

// The jets are emission spread along the path rather than a surface to land on,
// so they are integrated over each segment instead of stopping the ray.
//
// Seen this close to edge-on they are dim, and correctly so: the outflow is very
// nearly perpendicular to the line of sight, which leaves only transverse
// Doppler, and that alone costs a factor of gamma^4. JET_GAIN buys that back for
// the display. It is the one number here chosen to be seen rather than derived.
vec3 jetEmission(vec3 p, vec3 photonDir) {
    float ay = abs(p.y);
    if (ay < JET_BASE || ay > JET_LEN) return vec3(0.0);

    float open = 0.4 + 0.075 * ay;
    float rad  = length(p.xz);
    if (rad > open) return vec3(0.0);

    float across  = rad / open;
    float profile = exp(-3.2 * across * across) / (1.0 + 0.02 * ay * ay);

    float gamma = 1.0 / sqrt(1.0 - JET_BETA * JET_BETA);
    vec3  bvec  = vec3(0.0, sign(p.y) * JET_BETA, 0.0);
    float dop   = 1.0 / max(gamma * (1.0 - dot(bvec, photonDir)), 0.06);
    float beam  = dop * dop * dop * dop;

    float temp = T_JET * sqrt(JET_BASE / ay);
    return blackbody(temp * dop) * (profile * beam * JET_GAIN);
}

void main() {
    float a    = clamp(spin, 0.0, 0.998);
    float rh   = 1.0 + sqrt(max(1.0 - a * a, 0.0));
    float isco = iscoRadius(a);

    vec2 ndc = screenUV * 2.0 - 1.0;
    vec3 rd  = normalize(camFwd
                       + camRight * (ndc.x * aspectRatio * tanHalfFov)
                       + camUp    * (ndc.y * tanHalfFov));

    // The camera sits far enough out that the coordinate basis is nearly
    // orthonormal, so the ray's components in it are the photon's momenta up to
    // the metric factors. Whatever error that leaves is taken back below by
    // solving the null condition exactly for the radial momentum.
    vec3  bl = worldToBL(camPos, a);
    float r  = bl.x;
    float th = bl.y;
    float ph = bl.z;

    float s  = max(sin(th), 1e-5);
    float c  = cos(th);
    float rr = sqrt(r * r + a * a);

    vec3 er  = normalize(vec3(r / rr * s * cos(ph), c, r / rr * s * sin(ph)));
    vec3 eth = normalize(vec3(rr * c * cos(ph), -r * s, rr * c * sin(ph)));
    vec3 eph = normalize(vec3(-sin(ph), 0.0, cos(ph)));

    float sig = r * r + a * a * c * c;
    float del = r * r - 2.0 * r + a * a;
    float gpp = (r * r + a * a + 2.0 * a * a * r * s * s / sig) * s * s;

    float nr  = dot(rd, er);
    float nth = dot(rd, eth);
    float nph = dot(rd, eph);

    float pth = nth * sqrt(sig);
    float L   = nph * sqrt(max(gpp, 1e-8));

    // The null condition, solved rather than assumed: Delta pr^2 = P^2/Delta -
    // pth^2 - Q^2. Any small error in the basis above lands here and is removed,
    // so the ray that gets integrated is exactly a light ray.
    float P0 = -(r * r + a * a) + a * L;
    float Q0 = -a * s + L / s;
    float pr2 = (P0 * P0 / del - pth * pth - Q0 * Q0) / del;
    float pr  = sign(nr) * sqrt(max(pr2, 0.0));

    vec3 x = vec3(r, th, ph);
    vec2 p = vec2(pr, pth);

    vec3  colour   = vec3(0.0);
    float transmit = 1.0;
    vec3  prev     = camPos;
    vec3  lastDir  = rd;

    for (int i = 0; i < STEPS; i++) {
        vec3 dx1; vec2 dp1;
        deriv(x, p, a, L, dx1, dp1);

        // Step by arc length rather than by parameter: coarse where the path is
        // straight and the hole is far, fine where it bends. A fixed step either
        // wastes hundreds of iterations in empty space or steps clean over the
        // photon sphere, and this ray has to survive both.
        float sth   = max(sin(x.y), 1e-5);
        float speed = length(vec3(dx1.x, x.x * dx1.y, x.x * sth * dx1.z));
        float h     = clamp(STEP_ARC * (x.x - rh + 0.75) / max(speed, 1e-5), 0.001, 6.0);

        vec3 dx2; vec2 dp2;
        deriv(x + 0.5 * h * dx1, p + 0.5 * h * dp1, a, L, dx2, dp2);
        vec3 dx3; vec2 dp3;
        deriv(x + 0.5 * h * dx2, p + 0.5 * h * dp2, a, L, dx3, dp3);
        vec3 dx4; vec2 dp4;
        deriv(x + h * dx3, p + h * dp3, a, L, dx4, dp4);

        x += (h / 6.0) * (dx1 + 2.0 * dx2 + 2.0 * dx3 + dx4);
        p += (h / 6.0) * (dp1 + 2.0 * dp2 + 2.0 * dp3 + dp4);

        if (x.x <= rh * 1.002) break;          // through the horizon: the shadow

        vec3  world = blToWorld(x.x, x.y, x.z, a);
        vec3  seg   = world - prev;
        float len   = length(seg);
        if (len < 1e-9) { prev = world; continue; }
        vec3 marchDir = seg / len;
        lastDir = marchDir;

        if (x.x >= ESCAPE) { colour += transmit * starfield(marchDir); break; }

        // Sub-sampled like the disc, and for the same reason: the jet is a
        // narrow cone and the step out here is wide, so one sample per segment
        // drew it as a dotted line.
        for (int k = 0; k < 4; k++) {
            vec3 jp = prev + seg * ((float(k) + 0.5) * 0.25);
            colour += transmit * jetEmission(jp, -marchDir) * (len * 0.25);
        }

        // Through the disc rather than across it, so it obscures itself and its
        // edge is soft. The step is set by the bend in the path, which near the
        // disc is far coarser than the disc is thin, so the optical depth is
        // sub-sampled along the chord -- locally straight, and paid for only on
        // the few steps that are anywhere near the gas.
        vec3  mid   = 0.5 * (world + prev);
        if (abs(mid.y) < 4.0 * DISC_H * DISC_OUT + len && x.x < DISC_OUT + len) {
            for (int k = 0; k < 8; k++) {
                vec3  sp   = prev + seg * ((float(k) + 0.5) * 0.125);
                float sr   = blRadius(sp, a);
                float dens = discDensity(sr, sp.y, isco);
                if (dens > 0.0008) {
                    float dtau   = DISC_K * dens * len * 0.125;
                    float absorb = 1.0 - exp(-dtau);
                    colour   += transmit * absorb * discEmission(sr, sp, a, L, isco);
                    transmit *= 1.0 - absorb;
                }
            }
            if (transmit < 0.01) break;
        }

        prev = world;
    }

    // ACES, then sRGB -- the same tonemap the lit path uses, so the bright side
    // of the disc rolls off to white instead of clipping channel by channel and
    // sliding in hue on the way.
    // ACES, then sRGB -- the same tonemap the lit path uses, so the bright side
    // of the disc rolls off to white instead of clipping channel by channel and
    // sliding in hue on the way.
    vec3 v = colour;
    vec3 mapped = clamp((v * (2.51 * v + 0.03)) / (v * (2.43 * v + 0.59) + 0.14), 0.0, 1.0);
    FragColor = vec4(pow(mapped, vec3(1.0 / 2.2)), 1.0);
}
GLSL_END

var g_screen: ptr = null
var g_time = 0.0

on_start(data: ptr) {
    e = data as *Engine

    // One quad, covering the frame. loader.quad puts it in the XZ plane with
    // corners at +/-1, which the vertex shader reads straight as clip space.
    screen = loader.quad(2.0, 2.0)
    core.model_set_shader(screen, core.shader_new(VERTEX_LENS, FRAGMENT_LENS))
    engine.engine_add_model(e, screen)
    g_screen = screen as ptr

    renderer = engine.engine_gl_renderer(e)
    gl.renderer_set_clear_color(renderer, 0.0, 0.0, 0.0)
    gl.renderer_set_bloom(renderer, true)
    gl.renderer_set_bloom_params(renderer, 0.62, 0.55)

    // Eleven degrees above the disc. Nearly edge-on is where the lensing shows:
    // steeper and the far side stops arcing over the shadow, shallower and the
    // disc closes up into a line.
    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0, 11.0, 58.0))
    core.camera_set_speed(cam, 18.0)
    core.camera_set_near(cam, 0.05)
    core.camera_set_far(cam, 800.0)
    core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))

    println("black hole: Kerr geodesics per pixel, spin a = ${SPIN}")
}

on_update(data: ptr, delta: float) {
    screen = g_screen as *Model
    if screen == null { return }
    g_time = g_time + delta

    e = data as *Engine
    cam = engine.engine_camera(e)

    half_fov = core.deg_to_rad(cam.fov) * 0.5
    core.model_set_uniform_vec3(screen, "camPos", cam.position)
    core.model_set_uniform_vec3(screen, "camRight", cam.right)
    core.model_set_uniform_vec3(screen, "camUp", cam.up)
    core.model_set_uniform_vec3(screen, "camFwd", cam.front)
    core.model_set_uniform_float(screen, "tanHalfFov",
                                 core.sin_of(half_fov) / core.cos_of(half_fov))
    core.model_set_uniform_float(screen, "aspectRatio", cam.aspect)
    core.model_set_uniform_float(screen, "discTime", g_time)
    core.model_set_uniform_float(screen, "spin", SPIN)
}

main() {
    e = engine.engine_new(platform.API_GL)
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d - black hole")

    // The quad's winding is back-facing once the vertex shader has mapped it
    // into clip space, and there is nothing else in the scene to cull.
    engine.engine_set_face_culling(e, false)

    // Nothing in the frame is lit: every pixel is emission the shader works out
    // for itself. The light exists because the engine expects one.
    light = core.light_directional(core.vec3(0.0, 1.0, 0.0),
                                   core.vec3(1.0, 1.0, 1.0), 1.0)
    light.ambient_strength = 0.0
    engine.engine_set_light(e, light)

    engine.engine_set_user_data(e, e as ptr)
    engine.engine_on_start(e, on_start as fn(ptr))
    engine.engine_on_update(e, on_update as fn(ptr, float))

    engine.engine_run(e, 0 - 1, 0 - 1)

    println("black hole: ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps, ${gl.renderer_draw_calls(engine.engine_gl_renderer(e))} draw call(s)")

    screen = g_screen as *Model
    if screen != null { core.model_free(screen) }
    core.light_free(light)
    engine.engine_free(e)
}
