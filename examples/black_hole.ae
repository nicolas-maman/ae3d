// A spinning black hole, drawn by following light backwards to its source.
//
// Every pixel is one photon, integrated backwards from the eye through curved
// spacetime until it reaches the accretion disc, crosses the horizon, or escapes
// to the sky. The whole frame is a single screen quad -- one draw call.
//
// The rendering itself lives in ae3d.blackhole, because three callers want it:
// this example draws it, benchmarks/bench_black_hole.ae times it, and
// tests/test_blackhole.ae checks its shadow against the radius general
// relativity says it should have. What is left here is the scene: where the
// camera goes, and what the keys do.
//
// The camera orbits by default. The lensing changes character with inclination
// -- steeper and the far side stops arcing over the shadow, nearly edge-on and
// it closes towards a ring -- and a still camera shows one slice of that.
//
//   ./build.sh examples/black_hole.ae && ./build/black_hole
//
//   TAB     hand the camera over to WASD and the mouse, and back
//   WASD    move; SPACE up, CTRL down, SHIFT for 2.5x
//   RMB     hold and drag to look. The engine only turns the camera while the
//           right button is down, so the mouse alone does nothing
//   1 .. 6  quality, 1 highest. Also takes it off the frame-time guard.
//           Rays per pixel first, then the scale the scene is drawn at
//
// The toggle is TAB and not SPACE because SPACE is the engine's "up": with both
// on one key, flying up dropped the camera back onto the orbit rails mid-climb,
// which reads as a camera that cannot be moved at all.

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.behaviour
import blackhole

// 0 is Schwarzschild, 0.998 the Thorne limit that accretion holds a real hole
// to. The horizon, the innermost stable orbit, the orbital speeds, the disc's
// temperature and the shape of the shadow all follow from it.
const SPIN = 0.9

const ORBIT_RADIUS = 58.0
const ORBIT_HEIGHT = 11.0
const ORBIT_PERIOD = 75.0

var g_screen: ptr = null
var g_time = 0.0
var g_free = false
var g_toggle_was_down = false
// Quality is a ladder rather than two loose knobs, because the two do not trade
// off against each other evenly. Rays per pixel buys edges; render scale buys
// everything, since cost is dominated by pixels shaded and half scale is a
// quarter of the work. So the ladder spends rays first and only then starts
// drawing the scene smaller than the window.
//
// The bottom rung is meant for hardware that has no business running a per-pixel
// geodesic integration at all, and it still runs.
const LEVELS = 6

var g_level = 0
var g_taps = 4
var g_steps = 400

level_taps(level: int) -> int {
    if level <= 0 { return 4 }
    if level == 1 { return 2 }
    return 1
}

level_steps(level: int) -> int {
    if level <= 2 { return 400 }
    if level == 3 { return 300 }
    if level == 4 { return 220 }
    return 140
}

level_scale(level: int) -> float {
    if level <= 2 { return 1.0 }
    if level == 3 { return 0.75 }
    if level == 4 { return 0.5 }
    return 0.35
}

// Falls back on its own when the frame runs long, and never climbs again by
// itself. Climbing needs an estimate of what one ray costs, and under vsync
// there is none to be had -- the frame time is quantised to the refresh, so one
// ray and two can measure identical and the arithmetic reaches the wrong
// conclusion. The number keys take over instead.
//
// The first frame is judged on its own, because on a slow machine it is the
// expensive one and the point is not to render a second like it.
var g_auto = true
var g_watched = 0
var g_elapsed = 0.0
const BUDGET = 0.024
const HOPELESS = 0.1

apply_level(e: *Engine, screen: *Model, level: int) {
    wanted = level
    if wanted < 0 { wanted = 0 }
    if wanted > LEVELS - 1 { wanted = LEVELS - 1 }
    g_level = wanted
    g_taps = level_taps(g_level)
    g_steps = level_steps(g_level)
    blackhole.set_quality(screen, g_taps, g_steps)
    // Through the engine rather than into the GL renderer: the ladder then
    // reports the scale the backend really adopted, so a rung that did nothing
    // on this renderer says so instead of being printed as if it worked.
    adopted = engine.engine_set_render_scale(e, level_scale(g_level))
    println("  level ${g_level}: ${g_taps} ray(s), ${g_steps} steps, scale ${adopted}")
}

start(state: ptr, go: *GameObject) {
    e = engine.of(go)

    screen = blackhole.screen_new()
    blackhole.set_spin(screen, SPIN)
    engine.engine_add_model(e, screen)
    g_screen = screen as ptr

    engine.engine_set_clear_color(e, 0.0, 0.0, 0.0)
    engine.engine_set_post(e, false, true, 0.62, 0.55)

    cam = engine.engine_camera(e)
    core.camera_set_speed(cam, 18.0)
    core.camera_set_near(cam, 0.05)
    core.camera_set_far(cam, 800.0)

    // The orbit drives the camera, so the built-in controls stay off until TAB
    // asks for them.
    engine.engine_set_camera_input(e, false)

    apply_level(e, screen, 0)
    println("black hole: Kerr geodesics per pixel, spin a = ${SPIN}")
    println("  TAB   free camera on/off")
    println("  WASD  move, SPACE/CTRL up and down, SHIFT faster")
    println("  RMB   hold and drag to look around")
    println("  1-6   quality (1 highest)")
    println("  quality falls back on its own if the frame runs long")
}

update(state: ptr, go: *GameObject, delta: float) {
    e = engine.of(go)
    screen = g_screen as *Model
    if screen == null { return }

    cam = engine.engine_camera(e)
    g_time = g_time + delta

    // Edge-triggered: key_down is a level, and reading it every frame would
    // toggle the camera dozens of times per press.
    toggle_down = engine.engine_key_down(e, platform.KEY_TAB)
    if toggle_down && !g_toggle_was_down {
        g_free = !g_free
        engine.engine_set_camera_input(e, g_free)
    }
    g_toggle_was_down = toggle_down

    if g_auto {
        g_watched = g_watched + 1
        g_elapsed = g_elapsed + delta
        if g_watched == 1 && delta > HOPELESS {
            // Nothing about this machine says it can afford the top of the
            // ladder, so do not spend a second frame finding that out slowly.
            println("  ${delta} s for the first frame")
            apply_level(e, screen, LEVELS - 1)
            g_elapsed = 0.0
        } else if g_watched >= 30 {
            if g_elapsed / (g_watched * 1.0) > BUDGET && g_level < LEVELS - 1 {
                apply_level(e, screen, g_level + 1)
            }
            g_watched = 0
            g_elapsed = 0.0
        }
    }

    picked = 0 - 1
    if engine.engine_key_down(e, platform.KEY_1) { picked = 0 }
    if engine.engine_key_down(e, platform.KEY_2) { picked = 1 }
    if engine.engine_key_down(e, platform.KEY_3) { picked = 2 }
    if engine.engine_key_down(e, platform.KEY_4) { picked = 3 }
    if engine.engine_key_down(e, platform.KEY_5) { picked = 4 }
    if engine.engine_key_down(e, platform.KEY_6) { picked = 5 }
    if picked >= 0 && picked != g_level {
        g_auto = false
        apply_level(e, screen, picked)
    }

    if !g_free {
        angle = g_time * core.TWO_PI / ORBIT_PERIOD
        core.camera_set_position(cam, core.vec3(ORBIT_RADIUS * core.sin_of(angle),
                                                ORBIT_HEIGHT,
                                                ORBIT_RADIUS * core.cos_of(angle)))
        core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    } else {
        // Speed by distance, because one number cannot serve both ends of this
        // scene. The orbit sits at r = 58 and the horizon is at r = 1.4, so a
        // speed that crosses the first in a few seconds crosses the second in
        // about eighty milliseconds: aiming at the hole and holding W went
        // straight through it and out the far side, with nothing on screen long
        // enough to look at. Proportional speed makes the approach asymptotic --
        // the closer in, the finer the control -- which is what lets the horizon
        // be crept up on rather than flown past.
        reach = core.v3_len(cam.position) * 0.32
        if reach < 0.35 { reach = 0.35 }
        if reach > 26.0 { reach = 26.0 }
        core.camera_set_speed(cam, reach)
    }

    blackhole.set_view(screen, cam)
    blackhole.set_time(screen, g_time)
}

main() {
    // On OpenGL by name: the whole picture is one fragment shader written
    // here as GLSL (blackhole.screen_new), and the Vulkan backend compiles
    // no GLSL at run time -- with Vulkan the default it drew a black frame
    // at 150 fps and said nothing. AE3D_API=vulkan still overrides, and the
    // backend now says what it cannot draw.
    e = engine.engine_new_with(platform.API_GL)
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d - black hole")

    // The screen quad's winding is back-facing once the vertex shader has
    // mapped it into clip space, and there is nothing else in the scene to cull.
    engine.engine_set_face_culling(e, false)

    // Nothing in the frame is lit: every pixel is emission the shader works out
    // for itself. The light exists because the engine expects one.
    light = core.light_directional(core.vec3(0.0, 1.0, 0.0),
                                   core.vec3(1.0, 1.0, 1.0), 1.0)
    light.ambient_strength = 0.0
    engine.engine_set_light(e, light)

    game = engine.object(e, "Game", null)
    engine.script(game, "black hole", null, start, update)

    engine.engine_run(e)

    println("black hole: ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps, ${engine.engine_draw_calls(e)} draw call(s)")

    screen = g_screen as *Model
    if screen != null { core.model_free(screen) }
    core.light_free(light)
    engine.engine_free(e)
}
