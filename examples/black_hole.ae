// A spinning black hole, drawn by following light backwards to its source.
//
// Every pixel is one photon, integrated backwards from the eye through curved
// spacetime until it reaches the accretion disc, crosses the horizon, or escapes
// to the sky. The whole frame is a single screen quad -- one draw call.
//
// The rendering itself lives in ae3d.blackhole, because three callers want it:
// this example draws it, benchmarks/bench_black_hole.ae times it, and
// tests/test_blackhole.ae checks its shadow against the radius general
// relativity says it should have. What is left here is the scene: where the
// camera goes, and what the keys do.
//
// The camera orbits by default. The lensing changes character with inclination
// -- steeper and the far side stops arcing over the shadow, nearly edge-on and
// it closes towards a ring -- and a still camera shows one slice of that.
//
//   ./build.sh examples/black_hole.ae && ./build/black_hole
//
//   SPACE   hand the camera over to WASD and the mouse, and back
//   1 2 3 4 rays per pixel
//   9 0     step budget, 220 or 400

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import blackhole

// 0 is Schwarzschild, 0.998 the Thorne limit that accretion holds a real hole
// to. The horizon, the innermost stable orbit, the orbital speeds, the disc's
// temperature and the shape of the shadow all follow from it.
const SPIN = 0.9

const ORBIT_RADIUS = 58.0
const ORBIT_HEIGHT = 11.0
const ORBIT_PERIOD = 75.0

var g_screen: ptr = null
var g_time = 0.0
var g_free = false
var g_space_was_down = false
var g_taps = 4
var g_steps = 400

on_start(data: ptr) {
    e = data as *Engine

    screen = blackhole.screen_new()
    blackhole.set_spin(screen, SPIN)
    blackhole.set_quality(screen, g_taps, g_steps)
    engine.engine_add_model(e, screen)
    g_screen = screen as ptr

    renderer = engine.engine_gl_renderer(e)
    gl.renderer_set_clear_color(renderer, 0.0, 0.0, 0.0)
    gl.renderer_set_bloom(renderer, true)
    gl.renderer_set_bloom_params(renderer, 0.62, 0.55)

    cam = engine.engine_camera(e)
    core.camera_set_speed(cam, 18.0)
    core.camera_set_near(cam, 0.05)
    core.camera_set_far(cam, 800.0)

    // The orbit drives the camera, so the built-in controls stay off until the
    // space bar asks for them.
    engine.engine_set_camera_input(e, false)

    println("black hole: Kerr geodesics per pixel, spin a = ${SPIN}")
    println("  SPACE free camera, 1-4 rays per pixel, 9/0 step budget")
}

on_update(data: ptr, delta: float) {
    screen = g_screen as *Model
    if screen == null { return }

    e = data as *Engine
    cam = engine.engine_camera(e)
    g_time = g_time + delta

    // Edge-triggered: key_down is a level, and reading it every frame would
    // toggle the camera dozens of times per press.
    space_down = engine.engine_key_down(e, platform.KEY_SPACE)
    if space_down && !g_space_was_down {
        g_free = !g_free
        engine.engine_set_camera_input(e, g_free)
    }
    g_space_was_down = space_down

    taps = g_taps
    if engine.engine_key_down(e, platform.KEY_1) { taps = 1 }
    if engine.engine_key_down(e, platform.KEY_2) { taps = 2 }
    if engine.engine_key_down(e, platform.KEY_3) { taps = 3 }
    if engine.engine_key_down(e, platform.KEY_4) { taps = 4 }

    steps = g_steps
    if engine.engine_key_down(e, platform.KEY_9) { steps = 220 }
    if engine.engine_key_down(e, platform.KEY_0) { steps = 400 }

    if taps != g_taps || steps != g_steps {
        g_taps = taps
        g_steps = steps
        blackhole.set_quality(screen, g_taps, g_steps)
        println("  ${g_taps} ray(s) per pixel, ${g_steps} steps")
    }

    if !g_free {
        angle = g_time * core.TWO_PI / ORBIT_PERIOD
        core.camera_set_position(cam, core.vec3(ORBIT_RADIUS * core.sin_of(angle),
                                                ORBIT_HEIGHT,
                                                ORBIT_RADIUS * core.cos_of(angle)))
        core.camera_look_at(cam, core.vec3(0.0, 0.0, 0.0))
    }

    blackhole.set_view(screen, cam)
    blackhole.set_time(screen, g_time)
}

main() {
    e = engine.engine_new(platform.API_GL)
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d - black hole")

    // The screen quad's winding is back-facing once the vertex shader has
    // mapped it into clip space, and there is nothing else in the scene to cull.
    engine.engine_set_face_culling(e, false)

    // Nothing in the frame is lit: every pixel is emission the shader works out
    // for itself. The light exists because the engine expects one.
    light = core.light_directional(core.vec3(0.0, 1.0, 0.0),
                                   core.vec3(1.0, 1.0, 1.0), 1.0)
    light.ambient_strength = 0.0
    engine.engine_set_light(e, light)

    engine.engine_set_user_data(e, e as ptr)
    engine.engine_on_start(e, on_start as fn(ptr))
    engine.engine_on_update(e, on_update as fn(ptr, float))

    engine.engine_run(e, 0 - 1, 0 - 1)

    println("black hole: ${engine.engine_frame_count(e)} frames at ${engine.engine_fps(e)} fps, ${gl.renderer_draw_calls(engine.engine_gl_renderer(e))} draw call(s)")

    screen = g_screen as *Model
    if screen != null { core.model_free(screen) }
    core.light_free(light)
    engine.engine_free(e)
}
