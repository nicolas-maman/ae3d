// Gerstner-wave ocean under a textured-free sky, driven by the water shader.
//
//   ./build.sh examples/water.ae && ./build/water

import ae3d.core
import ae3d.platform
import ae3d.engine
import ae3d.gl
import ae3d.water

var g_water: ptr = null

on_start(data: ptr) {
    e = data as *Engine
    ocean = water.simulation_new(20000.0, 12.0)
    water.simulation_set_color(ocean, 0.06, 0.22, 0.45)
    water.simulation_set_sky_color(ocean, 0.5, 0.7, 1.0)
    water.simulation_set_caustics(ocean, true, 0.35, 0.003)

    surface = water.simulation_build(ocean, water.RESOLUTION)
    if surface == null {
        println("could not build the water surface")
        return
    }
    engine.engine_add_model(e, surface)
    g_water = ocean as ptr

    renderer = engine.engine_gl_renderer(e)
    gl.renderer_set_clear_color(renderer, 0.5, 0.7, 1.0)

    cam = engine.engine_camera(e)
    core.camera_set_position(cam, core.vec3(0.0, 260.0, 900.0))
    core.camera_set_speed(cam, 900.0)
    core.camera_set_far(cam, 60000.0)
}

on_update(data: ptr, delta: float) {
    ocean = g_water as *Simulation
    if ocean == null { return }
    water.simulation_update(ocean, delta)
}

main() {
    e = engine.engine_new(platform.API_GL)
    engine.engine_set_size(e, 1280, 800)
    engine.engine_set_title(e, "ae3d - ocean")
    engine.engine_set_face_culling(e, false)

    light = core.light_sun(core.vec3(0.3, 1.0, 0.5))
    light.intensity = 4.5
    engine.engine_set_light(e, light)

    engine.engine_set_user_data(e, e as ptr)
    engine.engine_on_start(e, on_start as fn(ptr))
    engine.engine_on_update(e, on_update as fn(ptr, float))

    engine.engine_run(e, 0 - 1, 0 - 1)

    println("ocean: ${engine.engine_frame_count(e)} frames, ${gl.renderer_draw_calls(engine.engine_gl_renderer(e))} draw calls")

    ocean = g_water as *Simulation
    if ocean != null { water.simulation_free(ocean) }
    core.light_free(light)
    engine.engine_free(e)
}
