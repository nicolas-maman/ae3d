build/
*.o
*.spv

# Snapshots land in build/. A run that wrote one somewhere else was a bug
# (a freed path read as garbage); the file it made is not an artefact to keep.
*.png.tmp

# Blender writes a .blend1 beside every file it saves over, and Python leaves a
# __pycache__ beside every module it imports. Neither is an input to anything.
*.blend1
__pycache__/
