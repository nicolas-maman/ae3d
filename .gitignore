build/
*.o
*.spv

# Generated by tools/blender/make_fixture.py. Regenerate rather than commit:
# a .blend is a file nobody can review and no one can regenerate when Blender
# changes it. What it exports to lives in tests/fixtures/exported/ and is
# committed, so the loading half is testable where Blender is not installed.
tests/fixtures/*.blend

# Snapshots land in build/. A run that wrote one somewhere else was a bug
# (a freed path read as garbage); the file it made is not an artefact to keep.
*.png.tmp
