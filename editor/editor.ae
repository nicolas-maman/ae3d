// ae3d editor.
//
// The chrome is aether-ui: it owns the real window, the panels, the hierarchy
// list and every control. The viewport is a GPU view aether-ui hosts
// (aether-lang-dev/aether-ui#92) with a canvas over it for the gizmo, so the
// scene is drawn straight into the window's own context at the framebuffer's
// size. Where there is no GPU surface, and for Vulkan, which cannot draw into a
// GL context, the scene is drawn into a framebuffer of its own, read back and
// blitted into that same canvas, which is what every run did before.
//
//   ./editor/build_editor.sh && ./build/ae3d_editor

import ui
import std.os
import std.list
import std.fs
import std.string
import std.mem

import ae3d.core
import ae3d.platform
import ae3d.gl
import ae3d.vulkan
import ae3d.offscreen
import ae3d.agent
import ae3d.loader
import ae3d.raycast
import ae3d.scene
import ae3d.history
import ae3d.behaviour
import ae3d.water
import ae3d.voxel
import ae3d.script
import ae3d.terrain
import ae3d.sky
import ae3d.rendering
import ae3d.engine
import ae3d.weather
import ae3d.physics
import ae3d.figure
import ae3d.motion
import ae3d.skin
import aephysics.human

const PANEL_LEFT = 240
const PANEL_RIGHT = 360
// The narrowest a panel may be dragged: its rows still read.
const PANEL_FLOOR = 180
// The width the viewport's GPU view and canvas are made at. Their pane gives
// them the rest; this is only the least they ask for, and on GTK it is a hard
// minimum -- made 900 wide, the viewport could not be narrowed and the
// inspector's divider did not move (#221). Their height stays the view's:
// it is what keeps the console under them the height it is.
const VIEW_FLOOR_W = 320
// A splitter's divider, which the pane widths do not include.
const SPLIT_DIVIDER = 6
const WINDOW_W = 1480
const WINDOW_H = 860
const ORBIT_SPEED = 0.35
const ZOOM_STEP = 1.12
const DRAG_SLOP = 3.0
// A slider's box. Wide enough for the longest value any bounded row shows,
// which is a field of view at 110.00.
const READOUT_W = 58
// The label column, so every row's control starts at the same x whatever the
// caption says. Ragged control edges are most of what makes a panel look
// unfinished.
const LABEL_COLUMN = 92
const HEX_COLUMN = 64
// A numeric field, and the coloured axis letter that labels one inside a
// vector row. Three of them plus their letters and gaps are what sets the
// inspector's width.
const FIELD_W = 78
const VECTOR_FIELD_W = 66
const AXIS_W = 10
const BLOOM_THRESHOLD = 0.8
const BLOOM_INTENSITY = 0.4
// Tool buttons, not page buttons. At 28 with the panel's spacing the add and
// terrain grids took more of the left column than the outliner did, and an
// editor's panel should give its room to the scene rather than to ten actions
// that are pressed once each.
// The viewport's ground. Near black makes a scene look like it is floating in
// a void rather than standing in a room, and an empty one is the first thing
// the editor shows.
const VIEWPORT_R = 0.110
const VIEWPORT_G = 0.110
const VIEWPORT_B = 0.114
const BUTTON_H = 23
const CONSOLE_LINES = 7
// A seed is a whole number carried through a row that holds floats, so the
// seeds this can express are the whole numbers a float counts exactly: up to
// two to the twenty-fourth. Above that, adding one to a seed lands back on the
// seed it started from, and the row silently refuses every other value typed
// into it. The default sits well inside the range for the same reason.
const SEED_MAX = 16777216.0
const DEFAULT_SEED = 2026090
const VOXEL_SIZE = 4.0
const WATER_SIZE = 700.0

// CRITICAL: these sit above the globals rather than beside the other section
// constants below, because a global initialised from one is emitted in file
// order and a const declared after it is not in scope yet.
const PRESET_FAST = 0
const PRESET_BALANCED = 1
const PRESET_QUALITY = 2
const PRESET_KINDS = 3

// The shading features the section offers, in the order they are drawn.
const SHADE_CLEARCOAT = 0
const SHADE_SHEEN = 1
const SHADE_VOLUMETRIC = 2
const SHADE_GI = 3
const SHADE_SHADOWS = 4
const SHADE_KINDS = 5

// Room for every section either panel builds, checked at build time: a
// section past the end would write off the end of these arrays.
const SECTIONS = 24
const CARET_W = 10
const OPEN_CARET = "▾"
const SHUT_CARET = "▸"

const GIZMO_TRANSLATE = 0
const GIZMO_ROTATE = 1
const GIZMO_SCALE = 2
const GIZMO_GRAB = 9.0
const GIZMO_REACH = 0.20
const RING_SEGMENTS = 48

var g_gizmo_mode = GIZMO_TRANSLATE
var g_gizmo_axis = 0 - 1
var g_gizmo_hover = 0 - 1
var g_gizmo_dragging = false
var g_gizmo_step = 0.0
var g_gizmo_dir_x = 0.0
var g_gizmo_dir_y = 0.0
var g_gizmo_angle = 0.0
var g_gizmo_turned = 0.0

var g_canvas = 0
// The GPU view the scene is drawn into, or 0 when it is drawn into a
// framebuffer of the editor's own and blitted into the canvas above.
var g_gpu = 0
var g_gpu_widget = 0               // the GPU view's widget handle
var g_gpu_seen_w = 0               // its size, in points, when last looked at
var g_gpu_seen_h = 0
// Decided before the window, because the two paths build the renderer at
// different moments: the editor's own context exists straight away, and
// aether-ui's does not exist until the view is realised.
var g_gpu_path = false
// Whether the frame being finished was one the agent is holding still, so the
// render callback can tell what the timer already worked out.
var g_held = false
// The size the scene is rendered at, in PIXELS. On the GPU path that is the
// framebuffer aether-ui hands over, which on a HiDPI screen is twice the
// canvas: the blit path could only ever render at the canvas's own point size,
// so the viewport was half resolution there and is not here.
// It starts at the width the window leaves between the panels: a weighted
// pane's first size is its minimum, so a viewport that opened wider than
// that pushed the right panel's edge, and its scrollbar, off the window.
var g_view_w = WINDOW_W - PANEL_LEFT - PANEL_RIGHT
var g_view_h = 620
// The canvas over it, in POINTS. The gizmo is drawn and picked in these, and
// mixing the two puts the handles at half the distance from the origin on a
// HiDPI screen. Equal on the blit path, where the canvas is the framebuffer.
var g_canvas_w = 900
var g_canvas_h = 620

var g_target: ptr = null
var g_renderer: ptr = null
var g_camera: ptr = null
var g_light: ptr = null
// The scene: one GameObject per row of the hierarchy, in the engine's own
// shape (ae3d.behaviour). The object owns its model; its first component
// says what the row is (mesh, water, voxel, terrain, light) and carries that
// thing's state; its second is the editor's, KIND_SCRIPT, whose state is an
// int[2] -- the script attached to it and whether the row is selected --
// and whose phases run the attached script, so the scene runs its scripts
// the way the engine's scene runs a program's: behaviour.scene_update.
var g_scene: ptr = null
var g_rows: ptr = null
var g_hierarchy: ptr = null
// What ui.modifiers() reports for the keys held right now. Not MOD_SHIFT:
// windows.h takes that name for RegisterHotKey, and a constant named after a
// macro is replaced by its value before the compiler ever sees a declaration.
const HELD_SHIFT = 1
const HELD_COMMAND = 8

// The last object clicked. The inspector answers for this one; an edit reaches
// everything selected, which is how Unreal, Unity and Godot all behave.
var g_selected = 0 - 1
var g_syncing = false
var g_backend_name = "opengl"
var g_vulkan = false

// The agent channel. Off unless AE3D_AGENT asks for it, exactly as in the
// engine: the editor drives its own loop rather than engine_loop, so it has to
// pump the channel itself or AE3D_AGENT would open a port that answered
// nothing.
var g_agent_on = false
var g_agent_ctx: ptr = null
var g_agent_steps_left = 0

var g_grid: ptr = null
var g_helpers: ptr = null
var g_outlines: ptr = null
var g_assets: ptr = null
var g_asset_rows: ptr = null
var g_asset_browser: ptr = null
var g_water_rows: ptr = null
// The sections, in the order they were built. A section is a bar and the stack
// under it; folding one hides the stack and turns the caret.
var g_section_bodies: ptr = null
var g_section_carets: ptr = null
var g_section_bars: ptr = null
var g_section_open: ptr = null
var g_section_count = 0
// The water section's bar, so a scene with no water can hide it. fold_section()
// returns the body; the bar is the widget before it.
var g_water_bar = 0
var g_water_body = 0
// The rule above the water heading. A section hides its heading, its rows and
// its rule, or the rule is left stacked against the next section's and the
// panel shows two lines with nothing between them.
var g_water_divider = 0
var g_script_clock = 0.0
var g_dirty = true

var g_status = 0
var g_console: ptr = null
var g_line0 = ""
var g_line1 = ""
var g_line2 = ""
var g_line3 = ""
var g_line4 = ""
var g_line5 = ""
var g_line6 = ""
var g_swatch = 0
var g_chip = 0
// The colour picker (#407): a saturation-value square over a hue strip on a
// canvas of their own, the chip and a hex field above them. The canvas is as
// wide as the panel lets it be; the square and the strip keep their heights.
const PICKER_W = 240
const PICKER_SQUARE_H = 104
const PICKER_GAP = 6
const PICKER_STRIP_H = 12
const PICKER_H = 122                   // the square, the gap and the strip
const PICKER_NONE = 0
const PICKER_SQUARE = 1
const PICKER_STRIP = 2
var g_picker = 0                       // the canvas id, 0 until it is built
var g_picker_w = 240                   // its width now, in points
var g_picker_pixels: ptr = null        // the square and the strip, RGBA, g_picker_w wide
var g_picker_painted = 0.0 - 1.0       // the hue the pixels were painted for
var g_picker_hue = 0.0                 // 0..1 around the wheel
var g_picker_sat = 0.0
var g_picker_val = 0.0
var g_picker_drag = 0                  // PICKER_NONE, _SQUARE or _STRIP
var g_picker_before: ptr = null        // each selected model's colour when the drag began
var g_hex_typing = false
// One widget of each styled kind, kept so the report can ask what the theme
// actually put on screen. A class that is never defined, or a name that does
// not match the sheet, styles nothing and says nothing: the widget renders in
// the toolkit's default and looks like a widget somebody meant to leave plain.
var g_probe_action = 0
var g_probe_primary = 0
var g_probe_danger = 0
var g_probe_field = 0
// The transform-mode buttons on the viewport. The mode was reachable only by
// pressing W, E or R, which is the convention but not a thing a panel can show
// you, so nothing on screen said which one was live.
// The lit segment of each row of choices, so a row of buttons says which one
// is on rather than only what could be chosen.
var g_biome_buttons: ptr = null
var g_style_buttons: ptr = null
// Sculpting: the brush's mode and reach, and the stroke under way -- the
// column heights the terrain had when it was pressed, so releasing can
// record one undo step for the whole drag.
var g_sculpt_buttons: ptr = null
// The sun by the hour: when on, the sky is drawn from the sun at the hour
// on the row and the key light takes the sun's direction, colour, strength
// and fill, so the sky, the clouds and the light agree.
var g_sun_by_time = false
var g_sun_by_time_toggle = 0
var g_time_of_day = 14.0
var g_sun_sky: ptr = null
// The image the scene is drawn under, or "" for the clear colour. Five of
// the examples set one with `engine_set_sky` and the scene file carried
// none of it, so a program's scene opened here lost its sky. It is kept
// beside the sun's own sky, which takes the viewport while the hour drives
// it and gives it back.
var g_scene_sky: ptr = null
var g_sky_image = ""
var g_sculpt = 0  // SCULPT_OFF, which is declared below the globals
var g_brush_radius = 12.0
var g_sculpting = false
var g_stroke_before: ptr = null
var g_stroke_world: ptr = null
var g_stroke_model: ptr = null
var g_stroke_cell_x = 0 - 1
var g_stroke_cell_z = 0 - 1
var g_strokes: ptr = null

// One stroke, as the terrain's column heights before and after it.
struct Stroke {
    world: ptr
    model: ptr
    before: ptr
    after: ptr
    columns: int
}
var g_terrain_bar = 0
var g_terrain_body = 0
var g_terrain_divider = 0
var g_script_buttons: ptr = null
// The scripts this project has: the source files that were found, and the
// libraries they were compiled into. Index 0 is none, so a script's id is its
// place here and id 1 is the first file found.
var g_script_files: ptr = null
var g_script_libs: ptr = null
var g_script_count = 1
// When each script's library was last written. A script rebuilt while the
// editor is open is reopened rather than ignored, which is what makes editing
// one worth doing without restarting.
var g_script_stamps: ptr = null
// The stamp seen on the previous look. A library is reopened once it has
// stopped changing rather than the moment it changes, so a build caught
// half-written is left alone until the next look, by which time it is whole.
var g_script_pending: ptr = null
var g_reload_checked = 0.0
var g_preset_buttons: ptr = null
var g_preset = PRESET_BALANCED
// The shading features, as the preset left them and as they were changed after.
// The engine's config carries a dozen more; these are the six the presets
// themselves disagree about, which is what makes them worth a control.
var g_shade_clearcoat = false
var g_shade_sheen = false
// Ambient occlusion from the scene's depth: a property of the view like
// the clouds, drawn by either backend, with how far a thing shadows its
// neighbours (metres) and how dark that goes.
var g_ssao = false
var g_ssao_toggle = 0
var g_ssao_radius = 3.0
var g_ssao_intensity = 1.0
var g_shade_volumetric = false
var g_shade_gi = false
var g_shade_shadows = false
var g_shade_toggles: ptr = null
var g_mode_move = 0
var g_mode_rotate = 0
var g_mode_scale = 0
var g_mode_hint = 0
// The row widget behind each hierarchy entry, so the selected one can be lit.
// A list with nothing marked is the same list whatever is selected, and the
// inspector was the only thing that said which object it was describing.
var g_hier_rows: ptr = null
// The hierarchy is a tree of the scene's objects: roots in scene order,
// an expanded parent's children under it, depth first -- what a person
// navigates a scene of a thousand props by, where a flat list is not.
// The rows are the objects shown, in the order shown; a row's object is
// looked up here, never by the row's position in the scene. While a
// filter is typed the tree gives way to every object whose name has the
// text, flat.
var g_visible: ptr = null          // int[g_visible_count]: the object of each row
var g_visible_count = 0
var g_visible_room = 0
// While the rows are rebuilt: each object's parent (int[], -1 for a root)
// and how many children it has, or null outside a rebuild.
var g_parent_rows: ptr = null
var g_child_counts: ptr = null
var g_table_count = 0
var g_expanded: ptr = null         // list of *Model: the parents shown open
var g_filter = ""
var g_filter_field = 0
var g_history: ptr = null
// When the last property edit was recorded. A drag delivers a callback per
// frame, so edits that stop arriving mean the adjustment is over and the undo
// step it opened has to close, or the next drag of the same slider extends it.
var g_last_edit = 0.0
const STATS_INTERVAL = 0.25
const EDIT_SETTLE = 0.4
var g_reported = false
// The scene's sky. It starts as the editor's own ground: near black makes a
// scene look like it is floating in a void rather than standing in a room, and
// an empty one is the first thing the editor shows.
var g_sky_r = VIEWPORT_R
var g_sky_g = VIEWPORT_G
var g_sky_b = VIEWPORT_B
var g_fxaa = true
var g_fxaa_toggle = 0
var g_bloom_toggle = 0
var g_bloom = false
// Screen-space reflection: a Vulkan feature, so the switch acts there and is
// inert on OpenGL, but the scene carries it either way (#267).
var g_ssr_toggle = 0
var g_ssr = false
// The reflection's road height and strength, the scene's (the view
// carries them; a program's scene sets its own road).
var g_ssr_road_height = 0.0
var g_ssr_strength = 0.6
// Distance fog, the scene's own, in the sky's colour.
var g_fog = false
var g_fog_toggle = 0
var g_fog_start = 20.0
var g_fog_end = 300.0
var g_fog_intensity = 1.0
// Clouds over the sky: a switch, at the cover a scene's sky usually wants.
var g_clouds = false
var g_clouds_toggle = 0
var g_cloud_cover = 0.4
// The sky's overcast, the scene's own: what it comes back to when the
// weather clears.
var g_overcast = 0.0
// The weather over the scene, run the way a game runs it: an engine over
// the viewport's renderer, its camera and its light, and the weather
// module over that, stepped by the frame. The section's state beside it,
// and the kind's buttons, one a kind.
var g_engine: ptr = null
var g_weather: ptr = null
var g_weather_kind = 0
var g_weather_intensity = 0.5
var g_wind_heading = 0.0
var g_wind_speed = 3.0
var g_weather_buttons: ptr = null
var g_sky_buttons: ptr = null
var g_sky_caption = 0
const WEATHER_KINDS = 5
// The physics section: the body's kind and the collider's, a button each,
// and the section's widgets so it can be hidden whole when nothing is
// selected. The simulation runs the scene's bodies in the editor's engine
// (physics.attach over it, stepped by the frame) and, stopped, puts every
// model back where it stood: what was simulated is looked at, not kept.
var g_body_buttons: ptr = null
var g_collider_buttons: ptr = null
var g_physics_bar = 0
var g_physics_section = 0
var g_physics_divider = 0
// The FIGURE section: a button a clip, the loop switch, and the section's
// widgets so it hides whole when the selection is not a figure.
var g_figure_bar = 0
var g_figure_section = 0
var g_figure_divider = 0
var g_clip_buttons: ptr = null     // int[MAX_CLIPS]
var g_loop_btn = 0
// The scene's figures: each a group row and the figure under it. A
// figure's meshes are the viewport's to draw, not rows: they come and go
// with their group, undone and redone with it.
var g_figure_rows: ptr = null      // list of *FigureRow
var g_figure_assets: ptr = null    // the figures resources/figures holds, for the browser
// The MOTION section: natural motion's switch, a button a mode, the
// protective switch, and the section's widgets.
var g_motion_bar = 0
var g_motion_section = 0
var g_motion_divider = 0
var g_motion_on_btn = 0
var g_motion_mode_buttons: ptr = null   // int[3]: animated, powered, limp
var g_protect_btn = 0
var g_live_figures = 0             // figures on their muscles in the running simulation
var g_floors: ptr = null           // list of *GameObject: the floors laid for them, gone when it stops
var g_simulating = false
var g_simulate_btn = 0
var g_rest: ptr = null             // list of *Rest, the models' transforms before the simulation

// Where a model stood before the simulation moved it.
struct Rest {
    model: ptr
    position: Vec3
    rotation: Quat
}
// The first frame rate the bar ever showed. A driver cannot see it: by the
// time anything can ask, the average has climbed to something plausible and a
// check on what the bar says now passes against a bar that opened on nothing.
// So the editor writes down what it showed first.
var g_first_fps = 0 - 1
// How long the editor took to show its scene: from the start of main to
// the end of the first frame drawn after the scene was built or opened.
// What someone opening a scene waits for, which no other figure said --
// first_fps is a rate, and a bounded run's wall time includes its report.
var g_started = 0.0
// AE3D_EDITOR_PROFILE=1: a line for each stage of the way to a scene on
// screen, what it took and when it ended, so the next loading work goes
// where the time is (#388) rather than where it is guessed to be.
var g_profile = false
var g_profile_last = 0.0
var g_profile_upload = 0.0             // placing models: the renderer's share, seconds
var g_profile_objects = 0.0            // the scene's objects and rows
var g_profile_shading = 0.0            // the shading switches on each
var g_scene_ready = false
var g_ready_ms = 0.0 - 1.0
// What the frame costs after the renderer is done with it: reading the
// framebuffer back off the GPU and handing it to the canvas. On the blit
// path that is the whole difference between what the renderer measures
// and what the editor shows, and nothing in the bar said so -- the
// street opened at nine frames a second with every pass reading under a
// millisecond. A smoothed average, like the frame rate beside it.
var g_blit_ms = 0.0
// And what the whole frame callback costs, so a frame rate that does not
// match the passes says where the rest of it went: inside this (the
// scene's own CPU work, the scripts, the outline) or outside it, in the
// toolkit's own painting.
var g_paint_ms = 0.0
var g_stats = 0
var g_title = 0
var g_visible_toggle = 0
var g_shadow_toggle = 0
// The light section's kind buttons, and the rows that are a spot's.
var g_light_buttons: ptr = null
var g_cone_rows: ptr = null
// The name of the selected object, typed into: a rename, undone as one.
var g_name_field = 0
// The object's components, under its name: what Unity's inspector lists
// first. The kind it is, and the script on it when there is one.
var g_parts = 0
var g_sliders: ptr = null
// Every row has a number box. A bounded row has a slider beside it as well:
// dragging and typing are two ways into the same value, which is how all three
// of Unreal, Unity and Godot draw a bounded setting. Both arrays are ROWS long.
var g_fields: ptr = null
// The row each control sits in, so a section can be hidden whole. Hiding the
// control and its box leaves the caption behind, and a caption with no
// control under it is worse than either: the water section read as four
// stranded words with no heading above them.
var g_row_frames: ptr = null
// CRITICAL: a model, its component and its script live at the same index in
// three lists, and anything that moves a model has to move all three. Removing
// one from the models alone leaves every component after it answering for the
// wrong object: deleting a cube made the editor stop believing its water was
// water, so the inspector hid the water section and update_water drove the
// wrong simulation.
//
// What a detached model takes with it is kept rather than dropped, because an
// undone delete has to bring back the object's simulation and its script, not
// a bare mesh.
// Objects taken out of the scene by a delete and kept for undo, whole:
// model, components and script slot together.
var g_detached: ptr = null
// The row whose field the user is typing in. Echoing a parsed value back into
// the field being edited rewrites it under the caret, which is what makes a
// numeric field impossible to type into.
// Drags that moved nothing, counted while the undo check runs. See
// undone_gizmo_drags: without it, a gizmo that never picks and a history that
// never restores report the same number.
var g_silent_drags = 0
var g_typing_row = 0 - 1
// The row whose slider is being dragged. A slider that is written to during its
// own tracking loop fights the drag, so it is the one control a change is not
// echoed back into.
var g_sliding_row = 0 - 1

var g_orbit_yaw = 0.0 - 55.0
var g_orbit_pitch = 26.0
var g_orbit_distance = 260.0
var g_focus_x = 0.0
var g_focus_y = 10.0
var g_focus_z = 0.0

var g_pressed = false
var g_moved = false
var g_press_x = 0.0
var g_press_y = 0.0
var g_last_x = 0.0
var g_last_y = 0.0

var g_frames = 0
var g_frame_limit = 0
var g_snapshot = ""
var g_report = ""
var g_fps = 0.0
var g_stats_written = 0.0
var g_last_time = 0.0
// The interval the last frame actually took. The agent channel reports it, and
// it was answering a constant while the editor had measured the real thing a
// few lines earlier.
var g_delta = 0.016
var g_timer = 0
var g_stage = 0
var g_split_outer = 0              // the left panel | everything else
var g_split_inner = 0              // the viewport | the inspector
var g_left = 0
var g_right = 0
var g_layout_settled = false

row_count() -> int {
    if g_scene == null { return 0 }
    return behaviour.scene_count(g_scene as *Scene)
}

row_object(index: int) -> *GameObject {
    if g_scene == null || index < 0 || index >= row_count() { return null }
    return behaviour.scene_object(g_scene as *Scene, index)
}

model_at(index: int) -> *Model {
    o = row_object(index)
    if o == null { return null }
    return behaviour.object_model(o)
}

// The editor's slot on an object: [script, selected].
row_slot(index: int) -> int[] {
    o = row_object(index)
    if o == null { return null }
    c = behaviour.object_component(o, 1)
    if c == null { return null }
    return behaviour.component_state(c) as int[]
}

// Every model in the scene, in row order, in a list the caller frees: for
// the callers that take a list of models (saving, shading).
scene_models() -> ptr {
    models = list.new()
    count = row_count()
    i = 0
    while i < count {
        m = model_at(i)
        if m != null { list.add_raw(models, m) }
        i = i + 1
    }
    return models
}

// The row whose model this is, or -1.
row_of_model(m: ptr) -> int {
    count = row_count()
    i = 0
    while i < count {
        if model_at(i) as ptr == m { return i }
        i = i + 1
    }
    return 0 - 1
}

selected_model() -> *Model {
    return model_at(g_selected)
}

// The status line carries the newest message and the console keeps the history,
// which is the split gopher3D's editor uses between its status bar and console.
say(text: string) {
    if g_status != 0 { ui.set_text(g_status, non_empty(text)) }
    log_line(text)
}

// The history is one newline-joined string rather than a list of strings, so
// there is a single owner to free and the trim is a substring.
// Each line is its own owned string rather than a slice of a history buffer:
// the widgets are fed exactly what was logged, so nothing depends on where a
// newline happens to fall.
// A computed empty string reaches AppKit as a nil NSString and throws inside
// setStringValue:, so a blank line is a space.
non_empty(value: string) -> string {
    if string.length(value) == 0 { return " " }
    return value
}

log_line(text: string) {
    if g_console == null { return }

    last = CONSOLE_LINES - 1
    stale = console_line(last)
    if string.length(stale) > 0 { string.free(stale) }

    i = last
    while i > 0 {
        set_console_line(i, console_line(i - 1))
        i = i - 1
    }
    set_console_line(0, string.copy(non_empty(text)))
    render_console()
}

console_line(index: int) -> string {
    if index == 0 { return g_line0 }
    if index == 1 { return g_line1 }
    if index == 2 { return g_line2 }
    if index == 3 { return g_line3 }
    if index == 4 { return g_line4 }
    if index == 5 { return g_line5 }
    return g_line6
}

set_console_line(index: int, value: string) {
    if index == 0 { g_line0 = value }
    if index == 1 { g_line1 = value }
    if index == 2 { g_line2 = value }
    if index == 3 { g_line3 = value }
    if index == 4 { g_line4 = value }
    if index == 5 { g_line5 = value }
    if index == 6 { g_line6 = value }
}

render_console() {
    if g_console == null { return }
    handles = g_console as int[]
    i = 0
    while i < CONSOLE_LINES {
        handle = handles[i]
        if handle != 0 {
            ui.set_text(handle, non_empty(console_line(i)))
        }
        i = i + 1
    }
}

clear_console() {
    i = 0
    while i < CONSOLE_LINES {
        stale = console_line(i)
        if string.length(stale) > 0 { string.free(stale) }
        set_console_line(i, "")
        i = i + 1
    }
    render_console()
}

// The preset behind the shading section. A preset is where the answers start,
// not a mode the scene is locked into.
preset_config() -> Config {
    if g_preset == PRESET_FAST { return rendering.performance_config() }
    if g_preset == PRESET_QUALITY { return rendering.high_quality_config() }
    return rendering.default_config()
}

// The preset's answers, loaded into the toggles so the section shows what the
// preset chose rather than whatever was last set by hand.
load_shading() {
    c = preset_config()
    g_shade_clearcoat = c.clearcoat
    g_shade_sheen = c.sheen
    g_shade_volumetric = c.volumetric_lighting
    g_shade_gi = c.global_illumination
    g_shade_shadows = c.advanced_shadows
    refresh_shading_toggles()
}

// The preset plus whatever was changed after it. Written to every model, the
// way the presets already are: the config is a scene setting here, and giving
// each model its own would mean a fourth list beside the models, the components
// and the scripts, all of which have to move together.
shading_config() -> Config {
    c = preset_config()
    c.clearcoat = g_shade_clearcoat
    c.sheen = g_shade_sheen
    c.volumetric_lighting = g_shade_volumetric
    c.global_illumination = g_shade_gi
    c.advanced_shadows = g_shade_shadows
    return c
}

apply_shading() {
    models = scene_models()
    rendering.apply_all(models, shading_config())
    list.free(models)
    paint_soon()
}

// A model that arrives after the shading was chosen has none of it: apply_all
// walks the models that exist when it runs, so a cube added later was lit by
// whatever the shader defaults to while the panel said otherwise.
apply_shading_to(m: *Model) {
    if m == null { return }
    rendering.apply(m, shading_config())
}

// The scene file carries each model's uniforms, so a loaded scene brings its
// own shading with it and the panel has to say what was loaded rather than
// what was last set by hand. Read off the first model, since the switches are
// a scene-wide control and that is what they were applied to.
read_shading() {
    m = model_at(0)
    if m == null { return }
    g_shade_clearcoat = model_flag(m, shading_uniform(SHADE_CLEARCOAT)) == 1
    g_shade_sheen = model_flag(m, shading_uniform(SHADE_SHEEN)) == 1
    g_shade_volumetric = model_flag(m, shading_uniform(SHADE_VOLUMETRIC)) == 1
    g_shade_gi = model_flag(m, shading_uniform(SHADE_GI)) == 1
    g_shade_shadows = model_flag(m, shading_uniform(SHADE_SHADOWS)) == 1
    refresh_shading_toggles()
}

// Whether the switches say what the models carry. The panel is a scene-wide
// control over per-model uniforms, so the two can drift apart in both
// directions: a model added after a switch was flipped never got it, and a
// loaded scene brought its own settings the panel knew nothing about.
shading_disagrees() -> int {
    wrong = 0
    slot = 0
    while slot < SHADE_KINDS {
        want = flag_of(shading_state(slot))
        i = 0
        while i < row_count() {
            m = model_at(i)
            if m != null && model_flag(m, shading_uniform(slot)) != want {
                wrong = wrong + 1
            }
            i = i + 1
        }
        slot = slot + 1
    }
    return wrong
}

refresh_shading_toggles() {
    set_shading_toggle(SHADE_CLEARCOAT, g_shade_clearcoat)
    set_shading_toggle(SHADE_SHEEN, g_shade_sheen)
    set_shading_toggle(SHADE_VOLUMETRIC, g_shade_volumetric)
    set_shading_toggle(SHADE_GI, g_shade_gi)
    set_shading_toggle(SHADE_SHADOWS, g_shade_shadows)
}

set_shading_toggle(slot: int, on: bool) {
    if g_shade_toggles == null { return }
    handles = g_shade_toggles as int[]
    if handles[slot] == 0 { return }
    value = 0
    if on { value = 1 }
    ui.set_toggle(handles[slot], value)
}

// The presets are the engine's own, applied to every model in the scene, which
// is what gopher3D's advanced rendering panel does.
apply_preset(name: string) {
    if string.equals(name, "performance") == 1 { g_preset = PRESET_FAST }
    if string.equals(name, "balanced") == 1 { g_preset = PRESET_BALANCED }
    if string.equals(name, "quality") == 1 { g_preset = PRESET_QUALITY }
    refresh_preset_buttons()

    load_shading()
    apply_shading()
    say("${name} preset applied to ${row_count()} models")
}

// Three ways in. Vulkan renders offscreen on its own. OpenGL on the GPU path
// is handed a context that is already current and draws into its default
// framebuffer, so it needs neither a context of its own nor a target. OpenGL on
// the blit path makes both.
start_renderer() -> bool {
    if g_vulkan {
        renderer = vulkan.renderer_new()
        backend = vulkan.backend(renderer)
        if !core.backend_init(&backend, null, g_view_w, g_view_h) {
            println("editor: the Vulkan backend would not initialise")
            return false
        }
        g_renderer = renderer as ptr
        return true
    }

    if g_gpu != 0 {
        gpu_renderer = gl.renderer_new()
        gpu_backend = gl.backend(gpu_renderer)
        // The context is aether-ui's and is current; renderer_init loads its
        // entry points out of whatever that is, so it is told nothing about it.
        if !core.backend_init(&gpu_backend, null, g_view_w, g_view_h) {
            println("editor: the OpenGL backend would not initialise")
            return false
        }
        g_renderer = gpu_renderer as ptr
        return true
    }

    context = offscreen.context_create(g_view_w, g_view_h)
    if context == null {
        println("editor: no OpenGL context available")
        return false
    }

    renderer = gl.renderer_new()
    backend = gl.backend(renderer)
    if !core.backend_init(&backend, context, g_view_w, g_view_h) {
        println("editor: the OpenGL backend would not initialise")
        return false
    }
    g_renderer = renderer as ptr
    g_target = offscreen.target_create(g_view_w, g_view_h)
    gl.renderer_set_target(renderer, g_target)
    return true
}

// What the renderer is set up with, once it exists. Its own function because
// the two viewport paths build the renderer at different moments and both owe
// it the same settings.
configure_renderer() {
    backend = viewport_backend()
    // CRITICAL to keep in step with the canvas fill on the blit path: the
    // canvas is painted this colour before the first frame arrives, and a
    // mismatch shows as the viewport changing shade on startup.
    core.backend_set_clear_color(&backend, VIEWPORT_R, VIEWPORT_G, VIEWPORT_B)
    core.backend_set_post(&backend, g_fxaa, g_bloom, BLOOM_THRESHOLD, BLOOM_INTENSITY)
    core.backend_set_shadows(&backend, true)
    core.set_face_culling(true)
}

// Either renderer, reached the same way. The editor holds the renderer as a
// bare pointer, so this is the only place that knows which one it is.
// The channel, from inside the editor's own loop.
//
// The editor is not the engine: it renders into a framebuffer with no window of
// its own and blits the result into an aether-ui canvas, so a snapshot is the
// canvas rather than a GL back buffer, and there is no swap for it to be taken
// before. Everything else an agent asks for -- the scene, the models, the
// camera, the animations, the trace -- is the same code answering, because the
// Context is what the ops read and the editor can fill one as well as the
// engine can.
pump_agent() {
    c = g_agent_ctx as *Context

    c.camera = g_camera
    c.gl_renderer = null
    c.vk_renderer = null
    c.backend = "opengl"
    if g_vulkan {
        c.vk_renderer = g_renderer
        c.backend = "vulkan"
    } else {
        c.gl_renderer = g_renderer
    }
    c.frame_count = g_frames
    c.fps = g_fps
    c.delta = g_delta
    c.width = g_view_w
    c.height = g_view_h
    c.draw_calls = 0
    if !g_vulkan && g_renderer != null {
        c.draw_calls = gl.renderer_draw_calls(g_renderer as *GLRenderer)
    }

    if g_agent_steps_left > 0 {
        g_agent_steps_left = g_agent_steps_left - 1
        if g_agent_steps_left == 0 {
            c.paused = true
            agent.answer_step(c)
        }
        return
    }

    agent.pump(c)

    if c.want_capture {
        c.want_capture = false
        captured = false
        if g_vulkan {
            pixels = vulkan.offscreen_pixels()
            if pixels != null {
                captured = agent.capture_adopt(pixels, vulkan.offscreen_width(), vulkan.offscreen_height())
            }
        } else if g_gpu != 0 {
            // Read from the framebuffer that has just been drawn. There is no
            // copy of it on the CPU on this path, which is the point of it.
            captured = agent.capture_frame(g_view_w, g_view_h)
        } else {
            pixels = gl.renderer_frame_pixels(g_renderer as *GLRenderer)
            if pixels != null {
                captured = agent.capture_adopt(pixels, g_view_w, g_view_h)
            }
        }
        if c.pending_capture_id >= 0 { agent.answer_capture(c, captured) }
        agent.answer_pending_trace(c)
        agent.answer_deferred(c)
    }
    if c.want_pause {
        c.want_pause = false
        c.paused = true
    }
    if c.want_resume {
        c.want_resume = false
        c.paused = false
    }
    if c.want_steps > 0 {
        c.paused = false
        g_agent_steps_left = c.want_steps
        c.want_steps = 0
    }

    if c.want_snapshot != "" {
        write_snapshot(c.want_snapshot)
        agent.answer_snapshot(c, c.want_snapshot, true)
        c.want_snapshot = ""
    }
    if c.want_stop {
        c.want_stop = false
        ui.timer_cancel(g_timer)
        report_state()
        ui.app_quit()
    }
}

viewport_backend() -> Backend {
    if g_vulkan { return vulkan.backend(g_renderer as *VKRenderer) }
    return gl.backend(g_renderer as *GLRenderer)
}

apply_post() {
    if g_renderer == null { return }
    backend = viewport_backend()
    core.backend_set_post(&backend, g_fxaa, g_bloom, BLOOM_THRESHOLD, BLOOM_INTENSITY)
    if g_vulkan {
        vulkan.renderer_set_ssr(g_renderer as *VKRenderer, g_ssr)
        vulkan.renderer_set_ssr_params(g_renderer as *VKRenderer, g_ssr_road_height, g_ssr_strength)
    }
    apply_fog()
    cover = 0.0
    if g_clouds { cover = g_cloud_cover }
    // The sky is the weather's while there is weather: the clouds and the
    // overcast it brings, over the scene's own, which come back when it
    // clears. Through the engine when there is one, so the weather knows
    // what the scene's own are.
    if g_weather_kind == weather.CLEAR || g_engine == null {
        if g_engine != null {
            engine.engine_set_clouds(g_engine as *Engine, cover, 1.0)
            engine.engine_set_sky_overcast(g_engine as *Engine, g_overcast, overcast_grey())
        } else if g_vulkan {
            vulkan.renderer_set_clouds(g_renderer as *VKRenderer, cover, 1.0)
            vulkan.renderer_set_sky_overcast(g_renderer as *VKRenderer, g_overcast, overcast_grey())
        } else {
            gl.renderer_set_clouds(g_renderer as *GLRenderer, cover, 1.0)
            gl.renderer_set_sky_overcast(g_renderer as *GLRenderer, g_overcast, overcast_grey())
        }
    }
    if g_vulkan {
        vulkan.renderer_set_ssao(g_renderer as *VKRenderer, g_ssao, g_ssao_radius, g_ssao_intensity)
    } else {
        gl.renderer_set_ssao(g_renderer as *GLRenderer, g_ssao, g_ssao_radius, g_ssao_intensity)
    }
    draw_frame()
}

// The grey the scene's own overcast pulls the sky toward: a wet day's.
overcast_grey() -> Vec3 { return core.vec3(0.62, 0.65, 0.70) }

// The weather runs in the editor as it runs in a game: an engine over the
// viewport's renderer, its camera and its light, and the weather module over
// that, its behaviour stepped by draw_frame. Once the renderer and the
// camera both exist, whichever came second, and once only.
start_weather() {
    if g_engine != null || g_renderer == null || g_camera == null { return }
    api = platform.API_GL
    if g_vulkan { api = platform.API_VULKAN }
    g_engine = engine.engine_over(g_renderer, api, g_camera as *Camera, g_light as *Light) as ptr
    // The engine is what runs the editor's scene, as far as a script on one
    // of its objects can tell: engine.of(go) answers with it here as in a
    // program, so the camera, the light and the weather are reachable.
    behaviour.scene_set_host(g_scene as *Scene, g_engine)
    g_weather = weather.weather_new(g_engine as *Engine) as ptr
    apply_weather()
}

// The fog onto the viewport: the scene's, in the sky's colour, or none.
apply_fog() {
    if g_renderer == null { return }
    backend = viewport_backend()
    haze = core.fog_none()
    if g_fog { haze = core.fog_distance(g_fog_start, g_fog_end, core.vec3(g_sky_r, g_sky_g, g_sky_b), g_fog_intensity) }
    core.backend_set_fog(&backend, &haze)
    mark_dirty()
}

// The section's state onto the weather: the wind first, since a kind
// scatters its particles into it, then the kind at its strength. The
// engine's light is the scene's current one, which a loaded scene replaces.
apply_weather() {
    if g_weather == null { return }
    engine.engine_set_light(g_engine as *Engine, g_light as *Light)
    w = g_weather as *Weather
    heading = core.deg_to_rad(g_wind_heading)
    weather.weather_set_wind(w, core.vec3(core.cos_of(heading), 0.0, core.sin_of(heading)), g_wind_speed)
    weather.weather_set(w, g_weather_kind, g_weather_intensity)
    mark_dirty()
}

// The scene changed its key light -- a row, the hour -- under the weather,
// which dims it from what it is now.
relight_weather() {
    if g_weather == null { return }
    weather.weather_relight(g_weather as *Weather)
}

weather_words(kind: int) -> string {
    if kind == weather.RAIN { return "rain" }
    if kind == weather.SNOW { return "snow" }
    if kind == weather.DUST { return "dust" }
    if kind == weather.STORM { return "storm" }
    return "clear"
}

// The kind chosen: one undo step, the section repainted, the weather set.
set_weather_kind(kind: int) {
    if kind == g_weather_kind { return }
    history.history_record(g_history, history.STEP_PROPERTY, null, WEATHER_KIND_SLOT,
                           (g_weather_kind) as float, (kind) as float)
    history.history_close(g_history)
    g_last_edit = seconds()
    g_weather_kind = kind
    refresh_weather_buttons()
    apply_weather()
    // Clear again: the scene's own sky back, as the rows have it now.
    if kind == weather.CLEAR { apply_post() }
    if kind == weather.CLEAR { say("the weather clears") } else { say("${weather_words(kind)} over the scene") }
}

refresh_weather_buttons() {
    paint_segments(g_weather_buttons, WEATHER_KINDS, g_weather_kind)
}

// The sky the scene is drawn under, chosen: the row lights the one it is
// on, and a sky the list does not have is spelled out beside them rather
// than dropped.
refresh_sky_buttons() {
    paint_segments(g_sky_buttons, SKY_IMAGES, sky_image_index(g_sky_image))
    if g_sky_caption == 0 { return }
    if sky_image_index(g_sky_image) >= 0 {
        ui.set_text(g_sky_caption, "")
    } else {
        ui.set_text(g_sky_caption, g_sky_image)
    }
}

set_sky_image(index: int) {
    was = sky_image_index(g_sky_image)
    if index == was { return }
    if set_scene_sky(sky_image_path(index)) == false { return }
    // A sky the list does not have is recorded as None, which is what
    // undoing back past it can put back: the file's own path is the
    // scene's, not a step's.
    from = was
    if from < 0 { from = 0 }
    history.history_record(g_history, history.STEP_PROPERTY, null, SKY_IMAGE_SLOT,
                           (from) as float, (index) as float)
    history.history_close(g_history)
    g_last_edit = seconds()
    refresh_sky_buttons()
    if index == 0 {
        say("the sky is the colour above")
    } else {
        say("the sky is ${sky_image_name(index)}")
    }
}

// The three channel sliders never show the colour they add up to, so the
// inspector shows it twice: a chip painted with it and the hex spelled out
// beside it, which is how all three of the editors this borrows from draw a
// colour property. The chip is a fixed-size label with a background colour:
// a background is all a chip needs. The picker under it is the canvas.
//
// ui.styled_bg answers from the layer that actually paints rather than from
// the value that was set, which is what makes it worth checking against.
// What the selection is and how big it is. Read from the model each time it is
// asked for, because a terrain that changes shape keeps its name and changes
// its geometry underneath: the title said twelve triangles while the model had
// eight thousand.
refresh_title() {
    if g_title == 0 { return }
    m = selected_model()
    if m == null {
        ui.set_text(g_title, "nothing selected")
        if g_name_field != 0 && !g_renaming { ui.set_text(g_name_field, "") }
        return
    }
    if g_name_field != 0 && !g_renaming { ui.set_text(g_name_field, core.text(m.name)) }
    ui.set_text(g_title, "${core.text(m.name)}   ${core.mesh_index_count(m.mesh) / 3} triangles")
    refresh_parts()
}

// "mesh", "water · orbit": the components on the selected object, in the
// order they are on it, the way an inspector lists them.
refresh_parts() {
    if g_parts == 0 { return }
    c = component_at(g_selected)
    if c == null {
        ui.set_text(g_parts, "")
        return
    }
    parts = string.copy(kind_name(c.kind))
    if is_group(g_selected) {
        string.free(parts)
        parts = string.copy("group")
    }
    attached = script_at(g_selected)
    if attached != SCRIPT_NONE {
        name = script_name(attached)
        joined = string.concat(parts, " · ")
        string.free(parts)
        parts = string.concat(joined, name)
        string.free(joined)
        string.free(name)
    }
    // The body is a component too: "mesh · dynamic body".
    spec = selected_spec()
    if spec != null {
        joined = string.concat(parts, " · ")
        string.free(parts)
        parts = string.concat(joined, body_kind_name(body_kind_of(spec)))
        string.free(joined)
        with_body = string.concat(parts, " body")
        string.free(parts)
        parts = with_body
    }
    ui.set_text(g_parts, parts)
    string.free(parts)
}

refresh_swatch() {
    if g_swatch == 0 { return }
    m = selected_model()
    if m == null || m.material == null {
        if !g_hex_typing { ui.set_text(g_swatch, "") }
        if g_chip != 0 { ui.style_bg_color(g_chip, 0.09, 0.09, 0.09, 1.0) }
        return
    }
    if !g_hex_typing {
        ui.set_text(g_swatch, "#${hex_byte(m.material.diffuse.x)}${hex_byte(m.material.diffuse.y)}${hex_byte(m.material.diffuse.z)}")
    }
    if g_chip != 0 {
        ui.style_bg_color(g_chip, core.clampf(m.material.diffuse.x, 0.0, 1.0),
                                  core.clampf(m.material.diffuse.y, 0.0, 1.0),
                                  core.clampf(m.material.diffuse.z, 0.0, 1.0), 1.0)
    }
    // The picker follows the colour however it was set -- a slider, the hex,
    // an undo -- except while it is the one setting it: a drag down to black
    // would otherwise lose its hue and saturation to the round trip.
    if g_picker_drag == PICKER_NONE {
        hsv = rgb_hsv(core.clampf(m.material.diffuse.x, 0.0, 1.0),
                      core.clampf(m.material.diffuse.y, 0.0, 1.0),
                      core.clampf(m.material.diffuse.z, 0.0, 1.0))
        // Grey has no hue and black no saturation: keep the ones it had.
        if hsv.y > 0.0001 && hsv.z > 0.0001 { g_picker_hue = hsv.x }
        if hsv.z > 0.0001 { g_picker_sat = hsv.y }
        g_picker_val = hsv.z
    }
    paint_picker()
}

// --- the colour picker (#407) ---------------------------------------------------
//
// Saturation left to right and value top to bottom in the square, at the hue
// the strip under it picks; what Unity, Unreal and Blender draw for a colour.
// Dragging either sets the colour of everything selected as it moves, and
// letting go records one step for the whole drag, so an undo puts back the
// colour the drag started from rather than the last few pixels of it.

// A hue, saturation and value (each 0..1) as linear-free RGB, 0..1.
hsv_rgb(h: float, sat: float, v: float) -> Vec3 {
    k = h * 6.0
    i = (k) as int
    if i > 5 { i = 5 }
    if i < 0 { i = 0 }
    f = k - (i) as float
    p = v * (1.0 - sat)
    q = v * (1.0 - sat * f)
    t = v * (1.0 - sat * (1.0 - f))
    if i == 0 { return core.vec3(v, t, p) }
    if i == 1 { return core.vec3(q, v, p) }
    if i == 2 { return core.vec3(p, v, t) }
    if i == 3 { return core.vec3(p, q, v) }
    if i == 4 { return core.vec3(t, p, v) }
    return core.vec3(v, p, q)
}

// The inverse: (hue, saturation, value) in x, y, z.
rgb_hsv(r: float, g: float, b: float) -> Vec3 {
    high = r
    if g > high { high = g }
    if b > high { high = b }
    low = r
    if g < low { low = g }
    if b < low { low = b }
    span = high - low
    h = 0.0
    if span > 0.00001 {
        if high == r {
            h = (g - b) / span
            if h < 0.0 { h = h + 6.0 }
        } else if high == g {
            h = (b - r) / span + 2.0
        } else {
            h = (r - g) / span + 4.0
        }
        h = h / 6.0
    }
    sat = 0.0
    if high > 0.00001 { sat = span / high }
    return core.vec3(h, sat, high)
}

picker_byte(x: float) -> long {
    return (core.clampf(x, 0.0, 1.0) * 255.0 + 0.5) as long
}

// One opaque pixel, as the canvas reads its bytes: red first.
picker_pixel(r: float, g: float, b: float) -> long {
    return picker_byte(r) + picker_byte(g) * 256 + picker_byte(b) * 65536 + (255 as long) * 16777216
}

// The square at the picker's hue, the gap in the panel's colour, and the
// strip. Repainted when the hue or the width changes, not on every move.
paint_picker_pixels() {
    w = g_picker_w
    if g_picker_pixels == null { g_picker_pixels = calloc(w * PICKER_H, 4) }
    top = hsv_rgb(g_picker_hue, 1.0, 1.0)
    y = 0
    while y < PICKER_SQUARE_H {
        v = 1.0 - (y) as float / (PICKER_SQUARE_H - 1) as float
        x = 0
        while x < w {
            sat = (x) as float / (w - 1) as float
            // v * lerp(white, the pure hue, saturation)
            r = v * (1.0 - sat + sat * top.x)
            g = v * (1.0 - sat + sat * top.y)
            b = v * (1.0 - sat + sat * top.z)
            mem.set_u32_le(g_picker_pixels, (y * w + x) * 4, picker_pixel(r, g, b))
            x = x + 1
        }
        y = y + 1
    }
    panel = picker_pixel(0.149, 0.149, 0.149)
    while y < PICKER_SQUARE_H + PICKER_GAP {
        x = 0
        while x < w {
            mem.set_u32_le(g_picker_pixels, (y * w + x) * 4, panel)
            x = x + 1
        }
        y = y + 1
    }
    x = 0
    while x < w {
        c = hsv_rgb((x) as float / (w - 1) as float, 1.0, 1.0)
        packed = picker_pixel(c.x, c.y, c.z)
        row = PICKER_SQUARE_H + PICKER_GAP
        while row < PICKER_H {
            mem.set_u32_le(g_picker_pixels, (row * w + x) * 4, packed)
            row = row + 1
        }
        x = x + 1
    }
    g_picker_painted = g_picker_hue
}

// The picture and the two markers: a ring where the colour is in the square
// and a bar where its hue is on the strip, each drawn light over dark so it
// reads on white and on black.
paint_picker() {
    if g_picker == 0 { return }
    if g_picker_pixels == null || g_picker_painted != g_picker_hue { paint_picker_pixels() }
    ui.canvas_clear(g_picker)
    ui.canvas_draw_image_ptr(g_picker, 0.0, 0.0, g_picker_w, PICKER_H, g_picker_pixels, g_picker_w * PICKER_H * 4)
    w = (g_picker_w - 1) as float
    cx = g_picker_sat * w
    cy = (1.0 - g_picker_val) * (PICKER_SQUARE_H - 1) as float
    ui.canvas_begin_path(g_picker)
    ui.canvas_arc(g_picker, cx, cy, 5.5, 0.0, 6.2832)
    ui.canvas_stroke(g_picker, 0.0, 0.0, 0.0, 0.7, 3.0)
    ui.canvas_begin_path(g_picker)
    ui.canvas_arc(g_picker, cx, cy, 5.5, 0.0, 6.2832)
    ui.canvas_stroke(g_picker, 1.0, 1.0, 1.0, 1.0, 1.5)
    hx = g_picker_hue * w
    strip = (PICKER_SQUARE_H + PICKER_GAP) as float
    ui.canvas_fill_rect(g_picker, hx - 2.5, strip - 2.0, 5.0, (PICKER_STRIP_H + 4) as float, 0.0, 0.0, 0.0, 0.7)
    ui.canvas_fill_rect(g_picker, hx - 1.0, strip - 1.0, 2.0, (PICKER_STRIP_H + 2) as float, 1.0, 1.0, 1.0, 1.0)
    ui.canvas_redraw(g_picker)
}

// The canvas took a new width from the panel: the pixels are remade for it.
resize_picker(width: int) {
    if width < 32 || width == g_picker_w { return }
    g_picker_w = width
    if g_picker_pixels != null { free(g_picker_pixels) }
    g_picker_pixels = null
    paint_picker()
}

// Where a point on the canvas puts the picker, by which part the drag began in.
picker_at(x: float, y: float) {
    w = (g_picker_w - 1) as float
    if g_picker_drag == PICKER_SQUARE {
        g_picker_sat = core.clampf(x / w, 0.0, 1.0)
        g_picker_val = core.clampf(1.0 - y / (PICKER_SQUARE_H - 1) as float, 0.0, 1.0)
    }
    if g_picker_drag == PICKER_STRIP {
        g_picker_hue = core.clampf(x / w, 0.0, 1.0)
    }
    c = hsv_rgb(g_picker_hue, g_picker_sat, g_picker_val)
    colour_selection(c.x, c.y, c.z)
}

picker_press(x: float, y: float) {
    m = selected_model()
    if m == null { return }
    g_picker_drag = PICKER_SQUARE
    if y > (PICKER_SQUARE_H + PICKER_GAP / 2) as float { g_picker_drag = PICKER_STRIP }
    remember_colours()
    picker_at(x, y)
}

picker_move(x: float, y: float) {
    if g_picker_drag == PICKER_NONE { return }
    picker_at(x, y)
}

picker_release(x: float, y: float) {
    if g_picker_drag == PICKER_NONE { return }
    picker_at(x, y)
    record_colours()
    g_picker_drag = PICKER_NONE
}

// Each selected model's colour as the drag begins, three floats a row.
remember_colours() {
    if g_picker_before != null { free(g_picker_before) }
    count = row_count()
    g_picker_before = calloc(count * 3 + 3, 8)
    before = g_picker_before as float[]
    i = 0
    while i < count {
        target = model_at(i)
        if is_selected(i) && target != null && target.material != null {
            before[i * 3] = target.material.diffuse.x
            before[i * 3 + 1] = target.material.diffuse.y
            before[i * 3 + 2] = target.material.diffuse.z
        } else {
            before[i * 3] = 0.0 - 1.0
        }
        i = i + 1
    }
}

// The drag as one step: every selected model, every channel, undone together.
record_colours() {
    if g_picker_before == null { return }
    before = g_picker_before as float[]
    history.history_group_begin(g_history)
    count = row_count()
    i = 0
    while i < count {
        target = model_at(i)
        if is_selected(i) && target != null && target.material != null && before[i * 3] >= 0.0 {
            ch = 0
            while ch < 3 {
                history.history_record(g_history, history.STEP_PROPERTY, target as ptr, 4 + ch,
                                       before[i * 3 + ch], property_value(target, 4 + ch))
                ch = ch + 1
            }
        }
        i = i + 1
    }
    history.history_group_end(g_history)
    g_last_edit = seconds()
    free(g_picker_before)
    g_picker_before = null
}

// The colour of everything selected, without a step: the drag and the hex
// field record their own.
colour_selection(r: float, g: float, b: float) {
    count = row_count()
    i = 0
    while i < count {
        target = model_at(i)
        if is_selected(i) && target != null {
            core.model_ensure_material(target)
            core.model_set_diffuse(target, r, g, b)
            follow_marker(i, target)
        }
        i = i + 1
    }
    show_row(4, r)
    show_row(5, g)
    show_row(6, b)
    refresh_swatch()
    paint_soon()
}

// A hex digit's value, or -1.
hex_digit(text: string, at: int) -> int {
    c = string.char_at(text, at)
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 55 }
    if c >= 97 && c <= 102 { return c - 87 }
    return 0 - 1
}

// "#3366CC" or "3366cc" typed into the field: the colour, one step. Anything
// else is a colour still being typed and is left alone.
hex_typed(text: string) {
    m = selected_model()
    if m == null { return }
    start = 0
    if string.length(text) == 7 && string.char_at(text, 0) == 35 { start = 1 }
    if string.length(text) - start != 6 { return }
    block = calloc(3, 8)
    channels = block as float[]
    ch = 0
    while ch < 3 {
        high = hex_digit(text, start + ch * 2)
        low = hex_digit(text, start + ch * 2 + 1)
        if high < 0 || low < 0 {
            free(block)
            return
        }
        channels[ch] = (high * 16 + low) as float / 255.0
        ch = ch + 1
    }
    if m.material != null && hex_byte(m.material.diffuse.x) == hex_byte(channels[0]) &&
       hex_byte(m.material.diffuse.y) == hex_byte(channels[1]) && hex_byte(m.material.diffuse.z) == hex_byte(channels[2]) {
        free(block)
        return
    }
    remember_colours()
    g_hex_typing = true
    colour_selection(channels[0], channels[1], channels[2])
    g_hex_typing = false
    record_colours()
    free(block)
}

// What the chip is actually painted, read back off the widget rather than from
// the value it was handed.
chip_rgb() -> int {
    if g_chip == 0 { return 0 - 1 }
    return ui.styled_bg(g_chip)
}

// The theme's own colours, as the sheet sets them. Written here rather than
// read back from the sheet on purpose: a check that asks the sheet what it
// contains agrees with itself no matter what reached the screen.
const STYLE_ACTION = 0x333333
const STYLE_PRIMARY = 0x2F6FEB
const STYLE_DANGER = 0x3A2628
const STYLE_FIELD = 0x171717

// How many styled widgets are not painted the colour their class asks for.
// A class the sheet never defines, or a name that does not match it, styles
// nothing at all and the widget renders in the toolkit's default.
mis_styled() -> int {
    wrong = 0
    if !painted_as(g_probe_action, STYLE_ACTION) { wrong = wrong + 1 }
    if !painted_as(g_probe_primary, STYLE_PRIMARY) { wrong = wrong + 1 }
    if !painted_as(g_probe_danger, STYLE_DANGER) { wrong = wrong + 1 }
    if !painted_as(g_probe_field, STYLE_FIELD) { wrong = wrong + 1 }
    return wrong
}

// Compared a channel at a time allowing one step, the same way the colour chip
// is: what a widget paints comes back off a layer and through a colour space.
painted_as(handle: int, wanted: int) -> bool {
    if handle == 0 { return false }
    got = ui.styled_bg(handle)
    if got < 0 { return false }
    shift = 65536
    while shift >= 1 {
        a = (got / shift) % 256
        b = (wanted / shift) % 256
        if a - b > 1 || b - a > 1 { return false }
        shift = shift / 256
    }
    return true
}

// Whether the chip on screen is the material's colour. Compared a channel at a
// time and allowing one step, because the colour goes out as a float and comes
// back off a CGColor: an exact comparison of the packed values would make this
// depend on a rounding nobody controls.
chip_wrong() -> int {
    got = chip_rgb()
    want = material_rgb()
    if want < 0 { return 0 }
    if got < 0 { return 1 }
    shift = 65536
    while shift >= 1 {
        a = (got / shift) % 256
        b = (want / shift) % 256
        if a - b > 1 || b - a > 1 { return 1 }
        shift = shift / 256
    }
    return 0
}

// The colour the selected material should be showing, packed the same way.
material_rgb() -> int {
    m = selected_model()
    if m == null || m.material == null { return 0 - 1 }
    r = (core.clampf(m.material.diffuse.x, 0.0, 1.0) * 255.0) as int
    g = (core.clampf(m.material.diffuse.y, 0.0, 1.0) * 255.0) as int
    b = (core.clampf(m.material.diffuse.z, 0.0, 1.0) * 255.0) as int
    return (r * 65536) + (g * 256) + b
}

hex_byte(value: float) -> string {
    digits = "0123456789ABCDEF"
    scaled = (core.clampf(value, 0.0, 1.0) * 255.0 + 0.5) as int
    high = scaled / 16
    low = scaled - high * 16
    return string.concat(string.substring(digits, high, high + 1),
                         string.substring(digits, low, low + 1))
}

number(value: float) -> string {
    scaled = (value * 100.0) as int
    whole = scaled / 100
    fraction = scaled - whole * 100
    if fraction < 0 { fraction = 0 - fraction }
    if fraction < 10 { return "${whole}.0${fraction}" }
    return "${whole}.${fraction}"
}

// The camera orbits a focus point rather than flying: an editor viewport wants
// the thing being inspected to stay in frame while the view moves around it.
apply_orbit() {
    mark_dirty()
    cam = g_camera as *Camera
    if cam == null { return }

    g_orbit_pitch = core.clampf(g_orbit_pitch, 0.0 - 85.0, 85.0)
    if g_orbit_distance < 8.0 { g_orbit_distance = 8.0 }
    if g_orbit_distance > 8000.0 { g_orbit_distance = 8000.0 }

    yaw = core.deg_to_rad(g_orbit_yaw)
    pitch = core.deg_to_rad(g_orbit_pitch)
    horizontal = g_orbit_distance * core.cos_of(pitch)

    focus = core.vec3(g_focus_x, g_focus_y, g_focus_z)
    eye = core.vec3(focus.x + horizontal * core.cos_of(yaw),
                    focus.y + g_orbit_distance * core.sin_of(pitch),
                    focus.z + horizontal * core.sin_of(yaw))

    core.camera_set_position(cam, eye)
    core.camera_look_at(cam, focus)
}

// The orbit from where the camera stands and looks: its pivot a way ahead
// along its line of sight, the eye behind it on that line. A scene's own
// view is kept this way, or the next turn of the orbit would snap the
// camera back to the editor's default.
const ORBIT_AHEAD = 40.0
orbit_from_camera(cam: *Camera) {
    core.camera_update_vectors(cam)
    front = cam.front
    g_focus_x = cam.position.x + front.x * ORBIT_AHEAD
    g_focus_y = cam.position.y + front.y * ORBIT_AHEAD
    g_focus_z = cam.position.z + front.z * ORBIT_AHEAD
    g_orbit_distance = ORBIT_AHEAD
    g_orbit_yaw = cam.yaw + 180.0
    g_orbit_pitch = 0.0 - cam.pitch
    apply_orbit()
}

// Frames the selection, the way pressing F does in every editor.
// The camera onto what is selected, with everything under it. A group is
// a transform with no mesh of its own, so its bounds are the origin with
// no reach: framing "Block 3" of a street flew the camera to 0,0,0 and
// left the block where it was, which is most of what a hierarchy is for.
//
// The sphere is the box around every member's own sphere, which is wider
// than a sphere fitted to them but never smaller, and it is what an
// editor frames by.
focus_selection() {
    if g_selected < 0 || g_selected >= row_count() { return }
    members = subtree_of(g_selected)
    low = core.vec3(0.0, 0.0, 0.0)
    high = core.vec3(0.0, 0.0, 0.0)
    seen = 0
    i = 0
    while i < list.size(members) {
        at = (list.get_raw(members, i) as int[])[0]
        member = model_at(at)
        if member != null {
            reach = member.bounding_radius
            centre = member.bounding_center
            // A member with no mesh (another group, a marker) reaches
            // nowhere; it still says where it stands.
            if member.mesh == null {
                centre = core.model_world_position(member)
                reach = 0.0
            }
            if seen == 0 {
                low = core.vec3(centre.x - reach, centre.y - reach, centre.z - reach)
                high = core.vec3(centre.x + reach, centre.y + reach, centre.z + reach)
            } else {
                if centre.x - reach < low.x { low.x = centre.x - reach }
                if centre.y - reach < low.y { low.y = centre.y - reach }
                if centre.z - reach < low.z { low.z = centre.z - reach }
                if centre.x + reach > high.x { high.x = centre.x + reach }
                if centre.y + reach > high.y { high.y = centre.y + reach }
                if centre.z + reach > high.z { high.z = centre.z + reach }
            }
            seen = seen + 1
        }
        i = i + 1
    }
    release_index_list(members)
    if seen == 0 { return }

    g_focus_x = (low.x + high.x) * 0.5
    g_focus_y = (low.y + high.y) * 0.5
    g_focus_z = (low.z + high.z) * 0.5
    span = high.x - low.x
    if high.y - low.y > span { span = high.y - low.y }
    if high.z - low.z > span { span = high.z - low.z }
    g_orbit_distance = span * 1.7
    if g_orbit_distance < 30.0 { g_orbit_distance = 30.0 }
    apply_orbit()
    name = "the selection"
    m = selected_model()
    if m != null { name = core.text(m.name) }
    if seen > 1 {
        say("framed ${name} and ${seen - 1} under it")
    } else {
        say("framed ${name}")
    }
}

// What kind of thing a row is, in one character. An editor's outliner says
// what an object is before you select it; this list said nothing at all, so a
// water surface and a cube were two words in the same grey.
// What kind of thing a row is, in one character, so the list can be read
// before anything is selected. They were a pipe, a tilde, a hash and an
// asterisk: punctuation that says nothing about what it stands for and reads
// as a stray keystroke down the edge of the list. Every editor this borrows
// from puts a small icon here, and a glyph that looks like the thing is the
// nearest a text list gets.
row_marker(index: int) -> string {
    c = component_at(index)
    if c == null { return "◆" }
    if c.kind == behaviour.KIND_WATER { return "≈" }
    if c.kind == behaviour.KIND_VOXEL { return "▦" }
    if c.kind == behaviour.KIND_LIGHT { return "✦" }
    return "◆"
}

row_label(index: int) -> string {
    m = model_at(index)
    if m == null { return "" }
    name = core.text(m.name)
    if name == "" { name = "object ${m.id}" }
    return "${row_marker(index)}  ${name}"
}

extern malloc(size: int) -> ptr
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)

// The weather over the scene: how hard it comes, the wind's heading in
// degrees from +X toward +Z and its speed in metres a second; and the
// sky's overcast, the scene's own under a clear sky.
const WEATHER_ROW = 34
const WIND_HEADING_ROW = 35
const WIND_SPEED_ROW = 36
const OVERCAST_ROW = 37
// A body on the object, as the scene file records one (ae3d.physics): the
// friction and the bounce of its surface, and the density its collider
// weighs. The body's kind and the collider's are choices, undone the way
// the weather's kind is.
const FRICTION_ROW = 38
const RESTITUTION_ROW = 39
const DENSITY_ROW = 40
// The scene's fog: where it starts and where it is whole, in metres. The
// view's, like the occlusion; its colour is the sky's.
const FOG_START_ROW = 41
const FOG_END_ROW = 42
// A light's reach in metres, and a spot's cone: the angle its light is
// whole within and the angle it is gone at. The light the rows act on is
// the selected one, or the scene's key light.
const LIGHT_RANGE_ROW = 43
const LIGHT_INNER_ROW = 44
const LIGHT_OUTER_ROW = 45
// An animated figure on the selected group (ae3d.figure): the pace its clip
// plays at, and how far into the clip it stands, as a share of the clip.
const FIGURE_SPEED_ROW = 46
const FIGURE_TIME_ROW = 47
// Natural motion on the selected figure (ae3d.motion): the share of its
// full strength, and the seconds it lies before it gets up (0 never).
const MOTION_STRENGTH_ROW = 48
const MOTION_GET_UP_ROW = 49
const ROWS = 50
// Past every inspector row, because a turn of the gizmo is not a row: it is
// recorded as the angle the drag has turned through so far, and undone by
// turning back through it.
const ROTATE_FIRST_SLOT = 50
// Past the rotation axes, which take 50 through 52. A behaviour is a property
// of a model like any other as far as undo is concerned, so it travels as a
// property step in a slot no row uses.
const SCRIPT_SLOT = 53
// A terrain's shape. A choice rather than a number, so it travels the way a
// behaviour does rather than as a row.
const TERRAIN_BIOME_SLOT = 54
// A terrain's style. Blocks are voxels drawn one cube per cell; smooth meshes
// the same field into one surface. Voxels are a kind of terrain rather than
// what terrain is.
const TERRAIN_STYLE_SLOT = 55
// A stroke of the sculpting brush: one undo step from press to release,
// whose before and after are the terrain's column heights, kept in a list
// of strokes the step indexes.
const SCULPT_SLOT = 56
// The weather's kind: a choice, undone the way a terrain's style is.
const WEATHER_KIND_SLOT = 57
// The body's kind and its collider's, on the selected object.
const BODY_KIND_SLOT = 58
const COLLIDER_KIND_SLOT = 59
// Whether the object is drawn, and whether it casts a shadow: switches
// on the object, undone as a property whose value is 0 or 1.
const VISIBLE_SLOT = 60
const SHADOW_SLOT = 61
// Which kind of light the selected one is: a choice, undone the way the
// weather's kind is.
const LIGHT_MODE_SLOT = 62
// Which image the sky is drawn from, by its place in the list below:
// the picker's choice, undone the way the weather's kind is. A scene that
// arrives with a sky of its own that is not in the list keeps it and no
// button is lit, so choosing never silently loses what a program set.
const SKY_IMAGE_SLOT = 63
// A figure's clip, by its place in the file's list (-1 for none), and
// whether it loops: choices, undone the way the weather's kind is.
const FIGURE_CLIP_SLOT = 64
const FIGURE_LOOP_SLOT = 65
// Natural motion on a figure: on or off, its mode, and whether it protects
// itself falling -- choices, undone the way a body's kind is.
const MOTION_ON_SLOT = 66
const MOTION_MODE_SLOT = 67
const MOTION_PROTECT_SLOT = 68
// The blow a click on a figure deals while the scene is simulated, newton
// seconds: past a standing figure's balance (400 fells one), so a click
// knocks it down and it falls the way a person does.
const HIT_IMPULSE = 450.0
// The clips the FIGURE section offers a button each, the first of a file's.
const MAX_CLIPS = 8
// The skies that ship with the engine, in the order the buttons draw
// them. The first is no image at all: the colour above, or the sun's own
// sky while the sun drives it.
const SKY_IMAGES = 4

sky_image_path(index: int) -> string {
    if index == 1 { return "resources/sky/desert.png" }
    if index == 2 { return "resources/sky/dusk.png" }
    if index == 3 { return "resources/sky/night.png" }
    return ""
}

sky_image_name(index: int) -> string {
    if index == 1 { return "Desert" }
    if index == 2 { return "Dusk" }
    if index == 3 { return "Night" }
    return "None"
}

// Where a path sits in that list, or -1 for a sky the list does not have.
sky_image_index(path: string) -> int {
    i = 0
    while i < SKY_IMAGES {
        if string.equals(sky_image_path(i), path) == 1 { return i }
        i = i + 1
    }
    return 0 - 1
}

// The kinds of light an object can be, in the order the buttons draw
// them: the sun (directional), a point, a spot.
const LIGHT_SUN = 0
const LIGHT_POINT = 1
const LIGHT_SPOT = 2
const LIGHT_MODES = 3
// The kinds of body an object can be, in the order the buttons draw them:
// none, the physics module's three, or a character (a capsule that walks
// the world, physics.character_controller, its collider always a capsule
// of the mesh's bounds).
const BODY_NONE = 0
const BODY_STATIC = 1
const BODY_KINEMATIC = 2
const BODY_DYNAMIC = 3
const BODY_CHARACTER = 4
const BODY_KINDS = 5
// The colliders the scene file names, from the object's own mesh: a box of
// its bounds, a sphere or a capsule of them, the hull of its vertices, or
// its triangles (static bodies only).
const COLLIDER_BOX = 0
const COLLIDER_SPHERE = 1
const COLLIDER_CAPSULE = 2
const COLLIDER_HULL = 3
const COLLIDER_MESH = 4
const COLLIDER_KINDS = 5
// The brush: what it does to the ground under the cursor while it is held.
const SCULPT_OFF = 0
const SCULPT_RAISE = 1
const SCULPT_LOWER = 2
const SCULPT_SMOOTH = 3
const SCULPT_KINDS = 4
// How many cells the brush moves the ground at its centre per touch, falling
// off to nothing at its edge.
const BRUSH_STEP = 2.0
const STYLE_BLOCKS = 0
const STYLE_SMOOTH = 1
const STYLE_KINDS = 2
const CAMERA_FIRST_ROW = 17
const CAMERA_LAST_ROW = 19
// Past the camera rows, because the row indices below it are spoken for and a
// water setting has to sit in the water section wherever its number falls.
const FOAM_ROW = 20
// The scene's sky, which the scene file has always carried and the editor had
// no control over: every scene it saved recorded a colour nobody could choose
// and every scene it opened was drawn on the editor's own grey.
const SKY_FIRST_ROW = 21
const SKY_LAST_ROW = 23
// A terrain's seed. Unbounded, so it is a field rather than a slider.
const TERRAIN_SEED_ROW = 24
// How mirror-like a surface is: what the wet road's reflection is scaled by
// on Vulkan (Reflections, in the view menu). A material property like the
// roughness beside it, so it saves with the model and undoes as a row.
const REFLECT_ROW = 25
// The rest of the water: how long its waves are, as the multiplier over the
// table's kilometre swells, and the shore -- the metres of water that hide
// the bottom and the metres the foam line runs out over.
const WAVE_SCALE_ROW = 26
const SHORE_FADE_ROW = 27
const SHORE_FOAM_ROW = 28
// How much of the sky the clouds cover, when they are on.
const CLOUD_COVER_ROW = 29
// The occlusion, when it is on: how dark it goes, and how far in metres a
// thing shadows what stands beside it.
const SSAO_ROW = 30
const SSAO_RADIUS_ROW = 31
// The sculpting brush's reach, in metres.
const BRUSH_ROW = 32
// The hour of the day the sun is set by, when the sky is drawn from it.
const TIME_ROW = 33
const SCRIPT_NONE = 0
// A behaviour is a script found on disk, not a case in this file. Zero is
// always "none"; the rest are whatever resources/scripts holds, in the order
// they were found.
const SCRIPT_NONE_ID = 0

// CRITICAL: room for the scripts a project has, checked when they are scanned.
// One past the end would write off the end of the arrays that hold them.
const MAX_SCRIPTS = 32
// How often the libraries are looked at. A rebuild takes longer than this, so
// noticing one is immediate to a person, and a stat of a handful of paths four
// times a second costs nothing next to a frame.
const RELOAD_INTERVAL = 0.25
const BOB_HEIGHT = 14.0
const BOB_RATE = 1.6
// Where the scene is saved and loaded from: the file the editor was opened
// on (its argument, or AE3D_SCENE), or this one. A scene's meshes that
// came from no file go beside it, in a directory named after it.
const DEFAULT_SCENE_PATH = "build/editor_scene.json"
var g_scene_path = ""

// Widget handles are not contiguous: a row creates a stack, two labels and a
// slider, so the next row's slider is not this one's handle plus one. They are
// kept in an array rather than derived by arithmetic, which is what made the
// inspector write text into a slider.
slider_handle(index: int) -> int {
    if g_sliders == null || index < 0 || index >= ROWS { return 0 }
    slots = g_sliders as int[]
    return slots[index]
}

row_frame(index: int) -> int {
    if g_row_frames == null || index < 0 || index >= ROWS { return 0 }
    slots = g_row_frames as int[]
    return slots[index]
}

field_handle(index: int) -> int {
    if g_fields == null || index < 0 || index >= ROWS { return 0 }
    slots = g_fields as int[]
    return slots[index]
}

// Whichever control this row has. A row with neither is a row that was never
// built, which is how the self-check tells the difference between a row that
// does nothing and a row that is not there.
row_control(index: int) -> int {
    handle = slider_handle(index)
    if handle != 0 { return handle }
    return field_handle(index)
}

// listbox_update takes a pointer list, and the rows carry nothing but their
// index, so each is one boxed int the list owns for as long as it holds it.
// One slot per object, holding what is attached to it and whether it is
// selected. Both live here rather than in lists of their own: a model, its
// component and its script already have to be moved together, and a fourth
// list beside them would be a fourth thing to keep in step. The allocation
// held one int and had room for two.
//
//   slot[0]  the script attached, or SCRIPT_NONE
//   slot[1]  1 when the object is in the selection
index_handle(value: int) -> ptr {
    slot = malloc(8) as int[]
    slot[0] = value
    slot[1] = 0
    return slot as ptr
}

release_rows() {
    if g_rows == null { return }
    count = list.size(g_rows)
    i = 0
    while i < count {
        free(list.get_raw(g_rows, i))
        i = i + 1
    }
    list.clear(g_rows)
}

// The selected row carries the accent, the rest the panel's own colour. Set as
// a colour rather than a class, because the sheet paints a widget when it is
// built and a class added later does not repaint it.
paint_selection() {
    if g_hier_rows == null { return }
    count = list.size(g_hier_rows)
    i = 0
    while i < count {
        slot = list.get_raw(g_hier_rows, i) as int[]
        handle = slot[0]
        shown = object_of_row(i)
        if shown >= 0 && (shown == g_selected || is_selected(shown)) {
            ui.style_bg_color(handle, 0.153, 0.310, 0.573, 1.0)
        } else {
            ui.style_bg_color(handle, 0.149, 0.149, 0.149, 1.0)
        }
        i = i + 1
    }
}

release_hier_rows() {
    if g_hier_rows == null { return }
    count = list.size(g_hier_rows)
    i = 0
    while i < count {
        free(list.get_raw(g_hier_rows, i))
        i = i + 1
    }
    list.clear(g_hier_rows)
}

rebuild_rows() {
    mark_dirty()
    if g_rows == null { g_rows = list.new() }
    release_rows()
    release_hier_rows()
    build_parent_table()
    build_visible()
    k = 0
    while k < g_visible_count {
        list.add_raw(g_rows, index_handle(object_of_row(k)))
        k = k + 1
    }
    // The rows are built here, each asking the table for its caret and indent.
    if g_hierarchy != null { ui.listbox_update(g_hierarchy, g_rows) }
    drop_parent_table()
    paint_selection()
}

// --- the hierarchy's tree ----------------------------------------------------------------------------------

// The object whose model is this one's parent, or -1: a parent outside the
// scene (a program's own) makes the object a root here.
parent_index_of(index: int) -> int {
    if g_parent_rows != null && index >= 0 && index < g_table_count {
        return (g_parent_rows as int[])[index]
    }
    return scan_parent_of(index)
}

scan_parent_of(index: int) -> int {
    m = model_at(index)
    if m == null { return 0 - 1 }
    parent = core.model_parent(m)
    if parent == null { return 0 - 1 }
    return row_of_model(parent as ptr)
}

has_children(index: int) -> bool {
    if g_child_counts != null && index >= 0 && index < g_table_count {
        return (g_child_counts as int[])[index] > 0
    }
    count = row_count()
    i = 0
    while i < count {
        if i != index && parent_index_of(i) == index { return true }
        i = i + 1
    }
    return false
}

// Every object's parent and child count, for one rebuild of the rows.
// Finding a parent is a scan of the scene, and a row asked it of every
// object -- has_children for its caret, depth_of for its indent, the tree
// walk for what is under it -- so 29 rows of the street's 1,240 objects cost
// 70 ms, 84 rows 180 ms. Found once, it costs what one row's question did.
// Only for the rebuild: the scene can change between rebuilds, and outside
// one the questions are asked by the scan.
build_parent_table() {
    drop_parent_table()
    count = row_count()
    g_table_count = count
    g_parent_rows = calloc(count + 1, 4)
    g_child_counts = calloc(count + 1, 4)
    parents = g_parent_rows as int[]
    children = g_child_counts as int[]
    i = 0
    while i < count {
        up = scan_parent_of(i)
        parents[i] = up
        if up >= 0 && up != i { children[up] = children[up] + 1 }
        i = i + 1
    }
}

drop_parent_table() {
    if g_parent_rows != null { free(g_parent_rows) }
    if g_child_counts != null { free(g_child_counts) }
    g_parent_rows = null
    g_child_counts = null
    g_table_count = 0
}

is_expanded(index: int) -> bool {
    m = model_at(index)
    if m == null || g_expanded == null { return false }
    count = list.size(g_expanded)
    i = 0
    while i < count {
        if list.get_raw(g_expanded, i) == m as ptr { return true }
        i = i + 1
    }
    return false
}

set_expanded(index: int, on: bool) {
    m = model_at(index)
    if m == null { return }
    if g_expanded == null { g_expanded = list.new() }
    count = list.size(g_expanded)
    i = 0
    while i < count {
        if list.get_raw(g_expanded, i) == m as ptr {
            if !on { list.remove(g_expanded, i) }
            return
        }
        i = i + 1
    }
    if on { list.add_raw(g_expanded, m as ptr) }
}

toggle_expanded(index: int) {
    set_expanded(index, !is_expanded(index))
    rebuild_rows()
}

// A group is an object with a transform and nothing to draw.
is_group(index: int) -> bool {
    m = model_at(index)
    return m != null && core.mesh_vertex_count(m.mesh) == 0
}

depth_of(index: int) -> int {
    depth = 0
    up = parent_index_of(index)
    while up >= 0 && depth < 32 {
        depth = depth + 1
        up = parent_index_of(up)
    }
    return depth
}

push_visible(index: int) {
    if g_visible_count >= g_visible_room {
        g_visible_room = g_visible_room * 2 + 64
        grown = calloc(g_visible_room, 4)
        if g_visible != null {
            memcpy(grown, g_visible, g_visible_count * 4)
            free(g_visible)
        }
        g_visible = grown
    }
    (g_visible as int[])[g_visible_count] = index
    g_visible_count = g_visible_count + 1
}

// An object and, when it is shown open, what is under it, depth first.
push_subtree(index: int) {
    push_visible(index)
    if !is_expanded(index) || !has_children(index) { return }
    count = row_count()
    i = 0
    while i < count {
        if i != index && parent_index_of(i) == index { push_subtree(i) }
        i = i + 1
    }
}

// The rows: the tree, or the filter's matches.
build_visible() {
    g_visible_count = 0
    count = row_count()
    i = 0
    while i < count {
        if g_filter != "" {
            m = model_at(i)
            if m != null && string.contains(core.text(m.name), g_filter) == 1 { push_visible(i) }
        } else if parent_index_of(i) < 0 {
            push_subtree(i)
        }
        i = i + 1
    }
}

// The object shown on a row, or -1.
object_of_row(row: int) -> int {
    if g_visible == null || row < 0 || row >= g_visible_count { return 0 - 1 }
    return (g_visible as int[])[row]
}

// The row an object is shown on, or -1 (under a collapsed parent, or
// outside the filter).
row_of_object(index: int) -> int {
    if g_visible == null { return 0 - 1 }
    rows = g_visible as int[]
    k = 0
    while k < g_visible_count {
        if rows[k] == index { return k }
        k = k + 1
    }
    return 0 - 1
}

// Every parent above the object shown open, so its row exists.
reveal(index: int) {
    up = parent_index_of(index)
    changed = false
    while up >= 0 {
        if !is_expanded(up) {
            set_expanded(up, true)
            changed = true
        }
        up = parent_index_of(up)
    }
    if changed { rebuild_rows() }
}

// The objects of a subtree, the root first, in scene order below it.
subtree_of(index: int) -> ptr {
    out = list.new()
    list.add_raw(out, index_handle(index))
    head = 0
    while head < list.size(out) {
        at = (list.get_raw(out, head) as int[])[0]
        count = row_count()
        i = 0
        while i < count {
            if i != at && parent_index_of(i) == at { list.add_raw(out, index_handle(i)) }
            i = i + 1
        }
        head = head + 1
    }
    return out
}

set_filter(text: string) {
    g_filter = string.copy(text)
    rebuild_rows()
}

// The inspector reads the selected model rather than keeping its own copy, so a
// change made anywhere shows here without a separate notification path.
// The marker wears the colour of the light it stands for, so a scene with
// several lights reads at a glance.
// A light has no geometry of its own, so it is wherever its marker is.
follow_marker(index: int, m: *Model) {
    c = component_at(index)
    if c == null || c.kind != behaviour.KIND_LIGHT { return }
    light = behaviour.component_state(c) as *Light
    if light == null { return }
    light.position = m.position
}

recolour_light_marker(light: *Light) {
    m = selected_model()
    if m == null || selected_light() != light { return }
    core.model_set_diffuse(m, light.color.x, light.color.y, light.color.z)
}

hidden_flag(shown: bool) -> int {
    if shown { return 0 }
    return 1
}

// A section with nothing to edit goes away whole: its bar, its rule and the
// stack under it. Hiding the controls and leaving the caption behind is worse
// than either, and the rule sits in the panel rather than in the body so that
// it has to be named here.
show_terrain_section(on: bool) {
    if g_terrain_bar != 0 { ui.set_hidden(g_terrain_bar, hidden_flag(on)) }
    if g_terrain_body != 0 { ui.set_hidden(g_terrain_body, hidden_flag(on)) }
    if g_terrain_divider != 0 { ui.set_hidden(g_terrain_divider, hidden_flag(on)) }
    frame = row_frame(TERRAIN_SEED_ROW)
    control = row_control(TERRAIN_SEED_ROW)
    if control != 0 { ui.set_hidden(control, hidden_flag(on)) }
    if frame != 0 { ui.set_hidden(frame, hidden_flag(on)) }
    frame = row_frame(BRUSH_ROW)
    control = row_control(BRUSH_ROW)
    if control != 0 { ui.set_hidden(control, hidden_flag(on)) }
    if frame != 0 { ui.set_hidden(frame, hidden_flag(on)) }
}

show_water_section(on: bool) {
    if g_water_bar != 0 { ui.set_hidden(g_water_bar, hidden_flag(on)) }
    if g_water_body != 0 { ui.set_hidden(g_water_body, hidden_flag(on)) }
    if g_water_divider != 0 { ui.set_hidden(g_water_divider, hidden_flag(on)) }
    i = 0
    while i < ROWS {
        if is_water_row(i) {
            control = row_control(i)
            frame = row_frame(i)
            if control != 0 { ui.set_hidden(control, hidden_flag(on)) }
            if frame != 0 { ui.set_hidden(frame, hidden_flag(on)) }
        }
        i = i + 1
    }
}

sync_inspector() {
    m = selected_model()
    if m == null {
        if g_title != 0 { ui.set_text(g_title, "nothing selected") }
        if g_parts != 0 { ui.set_text(g_parts, "") }
        show_water_section(false)
        show_terrain_section(false)
        show_physics_section(false)
        show_figure_section(false)
        show_motion_section(false)
        return
    }
    refresh_title()
    show_physics_section(true)
    refresh_physics_section()
    show_figure_section(selected_figure() != null)
    refresh_figure_section()
    show_motion_section(selected_figure() != null)
    refresh_motion_section()
    // The chip and the hex beside it are the material too, and nothing was
    // refreshing them when the selection changed: the three sliders under them
    // moved to the new object and the colour above stayed on the old one, so
    // selecting a terrain left the sphere's blue sitting over a terrain that
    // has no material at all.
    refresh_swatch()

    show_row(9, active_light().intensity)
    show_row(10, active_light().ambient_strength)
    show_row(14, active_light().color.x)
    show_row(15, active_light().color.y)
    show_row(16, active_light().color.z)

    show_row(17, camera_value(17))
    show_row(18, camera_value(18))
    show_row(19, camera_value(19))

    refresh_sky_rows()
    refresh_light_section()
    refresh_script_buttons()

    ground = selected_world()
    show_terrain_section(ground != null)
    if ground != null { refresh_terrain_section() }

    sim = selected_water()
    show_water_section(sim != null)
    if sim != null {
        show_row(11, sim.base_amplitude)
        show_row(12, sim.wave_speed_multiplier)
        show_row(13, sim.opacity)
        show_row(FOAM_ROW, water.simulation_foam_intensity(sim))
        show_row(WAVE_SCALE_ROW, water.simulation_wave_scale(sim))
        show_row(SHORE_FADE_ROW, water.simulation_shore_fade(sim))
        show_row(SHORE_FOAM_ROW, water.simulation_shore_foam(sim))
    }

    refresh_object_flags()
    show_row(0, m.position.x)
    show_row(1, m.position.y)
    show_row(2, m.position.z)
    show_row(3, m.scale.x)

    if m.material != null {
        show_row(4, m.material.diffuse.x)
        show_row(5, m.material.diffuse.y)
        show_row(6, m.material.diffuse.z)
        show_row(7, m.material.metallic)
        show_row(8, m.material.roughness)
        show_row(REFLECT_ROW, m.material.reflectivity)
    }
}

// The light rows read from the light itself, so a scene that brought its own
// has to put what it says in front of the sliders that set it.
refresh_light_rows() {
    show_row(9, light_value(9))
    show_row(10, light_value(10))
}

show_row(index: int, value: float) {
    if index != g_sliding_row {
        handle = slider_handle(index)
        if handle != 0 { ui.set_slider(handle, value) }
    }
    echo_row(index, value)
}

// Put a value in front of the user without moving the control it came from.
// The box is left alone while it is being typed in: rewriting a parsed value
// back under the caret is what makes a numeric field impossible to type into.
echo_row(index: int, value: float) {
    field = field_handle(index)
    if field != 0 && index != g_typing_row { ui.set_text(field, row_text(index, value)) }
}

// How a row spells its value. Every row but one is a measurement and reads
// better to two decimals; a seed is a whole number, and "20260903.00" is two
// digits of nothing that push the number out of its box.
row_text(index: int, value: float) -> string {
    if index == TERRAIN_SEED_ROW { return string.from_int((value) as int) }
    return number(value)
}

// listbox_select deliberately takes the same path as a row click, callback and
// all, so driving it from the very callback it fires would recurse until the
// stack ran out. The guard makes the highlight follow a programmatic selection
// without the two chasing each other.
// A click on a row. Whether it adds to the selection or replaces it is read
// here, at the edge, and passed on: a routine that reads the keyboard itself
// cannot be asked to do the other thing, and this one is driven by the
// editor's own checks as well as by a person.
select_object(index: int) {
    // The row callback, which fires for a person's click and also when the
    // editor moves the highlight itself. Only the first is a decision about
    // what is selected: the second would read no modifier held and replace the
    // selection the editor had just made.
    if g_syncing { return }
    holding = ui.modifiers()
    adding = holding == HELD_SHIFT || holding == HELD_COMMAND ||
             holding == HELD_SHIFT + HELD_COMMAND
    select_object_adding(index, adding)
}

select_object_adding(index: int, adding: bool) {
    mark_dirty()
    if index >= 0 {
        if adding {
            set_selected(index, !is_selected(index))
            // The last one clicked is the one the inspector answers for, and a
            // click that took something out of the selection cannot leave it
            // pointing there.
            if !is_selected(index) {
                fallback = 0 - 1
                i = 0
                while i < row_count() {
                    if is_selected(i) { fallback = i }
                    i = i + 1
                }
                index = fallback
            }
        } else {
            clear_selection()
            set_selected(index, true)
        }
    } else {
        clear_selection()
    }
    g_selected = index
    paint_selection()
    sync_inspector()

    if g_hierarchy != null && index >= 0 && !g_syncing {
        reveal(index)
        row = row_of_object(index)
        if row >= 0 {
            g_syncing = true
            ui.listbox_select(g_hierarchy, row)
            g_syncing = false
        }
    }
}

add_model(m: *Model, name: string) {
    add_component_model(m, name, behaviour.KIND_MESH, null)
}

// A game object for the model, at the end of the scene: the model is the
// object's, the kind component says what it is, the editor's slot follows
// with the phases that run whatever script the slot names.
add_object(m: *Model, name: string, kind: int, state: ptr) -> *GameObject {
    o = behaviour.object_new(name)
    behaviour.object_set_model(o, m)
    o.owns_model = true
    behaviour.object_add_component(o, behaviour.component_new(name, kind, state))
    behaviour.object_add_script(o, "editor", index_handle(SCRIPT_NONE), start_attached, update_attached)
    behaviour.scene_add(g_scene as *Scene, o)
    return o
}

// The phases of the editor's slot: the script the slot names, on the
// object the slot is on. What the script does is the script's business;
// the editor knows which object it is attached to and how long the frame
// was, and hands no state of its own.
start_attached(slot: ptr, go: *GameObject) {
    id = (slot as int[])[0]
    if id != SCRIPT_NONE { script.script_start(script_library(id), null, go) }
}

update_attached(slot: ptr, go: *GameObject, delta: float) {
    id = (slot as int[])[0]
    if id != SCRIPT_NONE { script.script_update(script_library(id), null, go, delta) }
}

// The slot component on an object: its start runs again on the next frame,
// which is what attaching a script or rebuilding one asks for.
restart_slot(index: int) {
    o = row_object(index)
    if o == null { return }
    c = behaviour.object_component(o, 1)
    if c != null { c.started = false }
}

// The object and everything it carries, gone: the editor's slot is the
// editor's to free, the model and the components are the object's.
free_object(o: *GameObject) {
    if o == null { return }
    c = behaviour.object_component(o, 1)
    if c != null {
        // A light object's light is its own: out of the renderer, which
        // holds a pointer to it, and then freed as a light (the name goes
        // with it). Everything else's state is a plain block.
        if c.kind == behaviour.KIND_LIGHT {
            beam = behaviour.component_state(c) as *Light
            if beam != null && beam != g_light as *Light {
                if g_renderer != null {
                    backend = viewport_backend()
                    core.backend_remove_light(&backend, beam)
                }
                core.light_free(beam)
            }
        } else {
            free(behaviour.component_state(c))
        }
    }
    behaviour.object_free(o)
}

// A light of the scene's own, with the marker that stands for it: what
// Add > Light makes, and what every light of a loaded scene becomes.
place_light(beam: *Light, name: string) {
    if beam == null { return }
    marker = loader.sphere(1.0, 16, 12)
    // The marker is sized by the light's reach, not by the editor's own
    // scene: a street lamp lights seven metres, and a six-metre ball at
    // every lamp swallowed the road and the camera with it. The editor's
    // own lights reach four hundred, so theirs is the same ball as before.
    size = core.light_range(beam) * 0.015
    if size < 0.15 { size = 0.15 }
    if size > 6.0 { size = 6.0 }
    core.model_set_scale(marker, size, size, size)
    core.model_set_position(marker, beam.position.x, beam.position.y, beam.position.z)
    core.model_matte(marker, beam.color.x, beam.color.y, beam.color.z)
    core.model_set_exposure(marker, 3.0)
    if g_renderer != null {
        backend = viewport_backend()
        core.backend_add_light(&backend, beam)
    }
    place_model(marker, name, behaviour.KIND_LIGHT, beam as ptr)
}

add_component_model(m: *Model, name: string, kind: int, state: ptr) {
    if m == null { return }
    place_model(m, name, kind, state)
    rebuild_rows()
    select_object(row_count() - 1)
    say("added ${core.text(m.name)}")
}

// The model into the scene and the viewport, without the hierarchy rebuilt
// or the selection moved: what adding one does, less what a scene of a
// thousand does once at the end. Rebuilding the rows per model made opening
// a street a million widgets.
place_model(m: *Model, name: string, kind: int, state: ptr) {
    if m == null { return }
    core.model_set_name(m, name)
    // Everything after this reads the model's own name, never the argument.
    // Loading a scene calls this with `core.text(m.name)`, so the argument is
    // the very string the setter just released, and using it again is a
    // use-after-free: the editor crashed drawing the hierarchy row for the
    // first model of every scene it opened.
    // A group -- a transform and nothing to draw -- is the scene's, not
    // the renderer's.
    t0 = seconds()
    if core.mesh_vertex_count(m.mesh) > 0 {
        backend = viewport_backend()
        core.backend_add_model(&backend, m)
    }
    t1 = seconds()
    add_object(m, core.text(m.name), kind, state)
    history.history_record(g_history, history.STEP_ADD, m as ptr, 0, 0.0, 0.0)
    t2 = seconds()
    apply_shading_to(m)
    g_profile_upload = g_profile_upload + (t1 - t0)
    g_profile_objects = g_profile_objects + (t2 - t1)
    g_profile_shading = g_profile_shading + (seconds() - t2)
}

// The object and everything under it: a group goes with its contents,
// each a step of its own, undone in turn.
remove_selected() {
    m = selected_model()
    if m == null { return }

    backend = viewport_backend()
    members = subtree_of(g_selected)
    // Deepest first: taking a row out moves the rows after it, so the
    // indices are resolved from the bottom of the list up.
    taken = list.new()
    i = 0
    while i < list.size(members) {
        list.add_raw(taken, model_at((list.get_raw(members, i) as int[])[0]) as ptr)
        i = i + 1
    }
    i = list.size(taken) - 1
    while i >= 0 {
        member = list.get_raw(taken, i) as *Model
        at = row_of_model(member as ptr)
        if at >= 0 {
            core.backend_remove_model(&backend, member)
            detach_at(at)
            history.history_record(g_history, history.STEP_REMOVE, member as ptr, 0, 0.0, 0.0)
        }
        i = i - 1
    }
    release_index_list(members)
    list.free(taken)

    g_selected = g_selected - 1
    if g_selected < 0 && row_count() > 0 { g_selected = 0 }
    if row_count() == 0 { g_selected = 0 - 1 }
    rebuild_rows()
    select_object(g_selected)
    say("deleted")
}

// The outline is one box scaled onto the selection's bounds each frame, so it
// costs a transform rather than geometry per object.
// One outline per selected object, from a pool that only ever grows to the
// largest selection the session has made.
update_water(delta: float) {
    count = row_count()
    i = 0
    while i < count {
        c = component_at(i)
        if c != null && c.kind == behaviour.KIND_WATER {
            water.simulation_update(behaviour.component_state(c) as *Simulation, delta)
        }
        i = i + 1
    }
}

update_outline() {
    shown = 0
    count = row_count()
    i = 0
    while i < count {
        if is_selected(i) {
            m = model_at(i)
            if m != null {
                outline = outline_for(shown)
                outline.visible = true
                span = m.bounding_radius * 2.0
                if span < 0.001 { span = 1.0 }
                core.model_set_position(outline, m.bounding_center.x,
                                        m.bounding_center.y, m.bounding_center.z)
                core.model_set_scale(outline, span, span, span)
                shown = shown + 1
            }
        }
        i = i + 1
    }

    spare = list.size(g_outlines)
    while shown < spare {
        stale = list.get_raw(g_outlines, shown) as *Model
        stale.visible = false
        shown = shown + 1
    }
}

// Whether an object is in the selection. The property and outline paths have
// always read this rather than comparing against the one selected index, so
// widening the selection was a matter of answering for more than one.
is_selected(index: int) -> bool {
    slot = row_slot(index)
    if slot == null { return false }
    return slot[1] == 1
}

set_selected(index: int, on: bool) {
    slot = row_slot(index)
    if slot == null { return }
    value = 0
    if on { value = 1 }
    slot[1] = value
}

clear_selection() {
    i = 0
    while i < row_count() {
        set_selected(i, false)
        i = i + 1
    }
}

// gopher3D attaches Go scripts it compiles and hot-reloads. The part that
// matters in an editor is attaching a behaviour and watching it run, so these
// are built in and driven from the frame loop.
script_at(index: int) -> int {
    slot = row_slot(index)
    if slot == null { return SCRIPT_NONE }
    return slot[0]
}

set_script(index: int, script: int) {
    slot = row_slot(index)
    if slot == null { return }
    was = slot[0]
    // Attaching a behaviour changes the scene, so it goes on the undo stack
    // like every other change. Without this, undo after attaching one steps
    // back through whatever came before it and puts that back instead, which
    // is the same fault the gizmo drag had.
    m = model_at(index)
    if m != null && was != script {
        history.history_record(g_history, history.STEP_PROPERTY, m as ptr,
                               SCRIPT_SLOT, (was) as float, (script) as float)
        // Each press is its own step: two of them are two decisions, not one
        // drag, and collapsing them would make the first unreachable.
        history.history_close(g_history)
    }
    slot[0] = script
    // Once, when it is attached, and only when the attachment changed: a
    // script that sets something up wants to do it on the object it was just
    // given, not every time the panel is refreshed. The scene runs start
    // before the first update, on the next frame.
    if m != null && was != script { restart_slot(index) }
    refresh_script_buttons()
    say("${script_name(script)} on ${core.text(model_at(index).name)}")
}

// A caption and a switch on one line, the shape the shading rows have.
switch_row(parent: int, name: string, on_change: fn) -> int {
    row = ui.hstack(parent, 8)
    as_row(row)
    caption = ui.text(row, name)
    ui.add_css_class(caption, "label")
    ui.spacer(row)
    return ui.toggle(row, "", on_change)
}

// Whether an object is drawn, or casts a shadow: onto everything
// selected, a step each, so the switch reaches the set the way a row
// does.
set_object_flag(slot: int, on: bool) {
    if selected_model() == null { return }
    count = row_count()
    i = 0
    while i < count {
        if is_selected(i) || i == g_selected {
            m = model_at(i)
            if m != null {
                was = object_flag(m, slot)
                if was != flag_of(on) {
                    history.history_record(g_history, history.STEP_PROPERTY, m as ptr, slot, was as float, flag_of(on) as float)
                    apply_object_flag(m, slot, on)
                }
            }
        }
        i = i + 1
    }
    history.history_close(g_history)
    g_last_edit = seconds()
    mark_dirty()
    if slot == VISIBLE_SLOT { say("visible ${on}") } else { say("casts shadow ${on}") }
}

object_flag(m: *Model, slot: int) -> int {
    if slot == VISIBLE_SLOT { return flag_of(m.visible) }
    return flag_of(m.casts_shadow)
}

apply_object_flag(m: *Model, slot: int, on: bool) {
    if slot == VISIBLE_SLOT { m.visible = on } else { core.model_set_casts_shadow(m, on) }
}

refresh_object_flags() {
    m = selected_model()
    if m == null { return }
    if g_visible_toggle != 0 { ui.set_toggle(g_visible_toggle, flag_of(m.visible)) }
    if g_shadow_toggle != 0 { ui.set_toggle(g_shadow_toggle, flag_of(m.casts_shadow)) }
}

// The selected object renamed to what was typed: its model and its object
// take the name, the row and the title follow. The field is not written
// back to while it is typed into, or the caret would jump.
var g_renaming = false

rename_selected(text: string) {
    m = selected_model()
    o = row_object(g_selected)
    if m == null || o == null { return }
    was = core.text(m.name)
    if string.equals(was, text) == 1 { return }
    history.history_record_name(g_history, m as ptr, was, text)
    g_last_edit = seconds()
    apply_name(m, o, text)
}

apply_name(m: *Model, o: *GameObject, text: string) {
    g_renaming = true
    core.model_set_name(m, text)
    behaviour.object_set_name(o, text)
    rebuild_rows()
    refresh_title()
    g_renaming = false
}

// The inverse of script_name, for a scene that recorded one. A scene naming a
// script this project does not have gets none rather than a wrong one: the
// file said what it wanted and the answer is that it is not here.
script_from_name(name: string) -> int {
    id = 1
    while id < g_script_count {
        if string.equals(script_name(id), name) == 1 { return id }
        id = id + 1
    }
    return SCRIPT_NONE
}

// What a component kind is called in a scene file. The editor's own constants
// are numbers and a file outlives them.
kind_name(kind: int) -> string {
    if kind == behaviour.KIND_WATER { return "water" }
    if kind == behaviour.KIND_VOXEL { return "voxel" }
    if kind == behaviour.KIND_LIGHT { return "light" }
    return "mesh"
}

kind_from_name(name: string) -> int {
    if string.equals(name, "water") == 1 { return behaviour.KIND_WATER }
    if string.equals(name, "voxel") == 1 { return behaviour.KIND_VOXEL }
    if string.equals(name, "light") == 1 { return behaviour.KIND_LIGHT }
    return behaviour.KIND_MESH
}

// A script's name is its file's, without the directory or the suffix, which is
// what a scene records and what the button says.
script_name(script: int) -> string {
    if g_script_files == null || script < 1 || script >= g_script_count { return "none" }
    path = core.text(fs.dir_list_get(g_script_files, script - 1))
    start = 0
    i = 0
    while i < string.length(path) {
        if string.equals(string.substring(path, i, i + 1), "/") == 1 { start = i + 1 }
        i = i + 1
    }
    stop = string.length(path)
    if stop - 3 > start && string.equals(string.substring(path, stop - 3, stop), ".ae") == 1 {
        stop = stop - 3
    }
    return string.substring(path, start, stop)
}

// The scripts a project has, found rather than listed. A behaviour is a file
// in resources/scripts compiled into a library beside it, so what the editor
// offers is whatever is there: adding one is adding a file, and the editor
// does not have to be taught what it does.
scan_scripts() {
    matches, err = fs.glob("resources/scripts/*.ae")
    if err != "" || matches == null { return }
    g_script_files = matches
    g_script_libs = list.new()
    list.add_raw(g_script_libs, null)
    g_script_stamps = calloc(MAX_SCRIPTS, 8)
    g_script_pending = calloc(MAX_SCRIPTS, 8)
    stamps = g_script_stamps as int[]

    found = fs.dir_list_count(g_script_files)
    if found > MAX_SCRIPTS - 1 { found = MAX_SCRIPTS - 1 }

    id = 1
    while id <= found {
        g_script_count = id + 1
        name = script_name(id)
        path = script.library_path("build/scripts/", name)
        loaded = script.script_open(path)
        if loaded == null {
            // Named, and honestly unusable. The button still appears, because
            // a script that will not load is a thing to fix rather than a
            // thing to hide, and the console says which and why.
            say("${name} did not load: ${script.last_error()}")
        }
        list.add_raw(g_script_libs, loaded as ptr)
        stamp, stamp_err = fs.mtime(path)
        if stamp_err == "" { stamps[id] = stamp }
        string.free(path)
        id = id + 1
    }
    say("${found} script(s) available")
}

// Reopen any script whose library has been written since it was opened.
//
// The editor does not compile anything: a script is rebuilt by the same step
// that built it the first time, and this notices. Watching the library rather
// than the source is what makes that honest, because a source saved with a
// syntax error in it leaves the last good library in place and the object
// keeps behaving the way it did.
reload_changed_scripts() {
    if g_script_stamps == null { return }
    now = seconds()
    if now - g_reload_checked < RELOAD_INTERVAL { return }
    g_reload_checked = now

    stamps = g_script_stamps as int[]
    id = 1
    while id < g_script_count {
        path = script.library_path("build/scripts/", script_name(id))
        stamp, err = fs.mtime(path)
        if err == "" && stamp != stamps[id] {
            pending = g_script_pending as int[]
            if stamp != pending[id] {
                // Changed since the last look, so wait for it to settle.
                pending[id] = stamp
                string.free(path)
                id = id + 1
                continue
            }
            was = stamps[id]
            stamps[id] = stamp
            // Not on the first look: the stamp starts at whatever the library
            // had when it was opened, so a zero here is a script that was
            // missing then and has arrived since.
            if was != 0 {
                replaced = script.script_open(path)
                if replaced == null {
                    say("${script_name(id)} would not reload: ${script.last_error()}")
                } else {
                    previous = script_library(id)
                    list.set(g_script_libs, id, replaced as ptr)
                    if previous != null { script.script_close(previous) }
                    restart_script(id)
                    say("reloaded ${script_name(id)}")
                }
            }
        }
        string.free(path)
        id = id + 1
    }
}

// A reloaded script starts again on everything carrying it, because the copy
// that ran start on those objects is the one that was just closed.
restart_script(id: int) {
    i = 0
    while i < row_count() {
        if script_at(i) == id { restart_slot(i) }
        i = i + 1
    }
}

// A new script, ready to edit. Unity and Godot both offer this, and the point
// is the same: the shape of a script is a thing to be given rather than
// remembered, and a first one written from an empty file is mostly a guess at
// what the two functions are called.
//
// The file is written and nothing else happens. Compiling it is the build step
// that compiles every other script, and the editor picks the library up when
// it appears, so the path from here is the same one an existing script takes.
new_script() {
    name = unused_script_name()
    path = "resources/scripts/${name}.ae"
    err = fs.write(path, script_template(name))
    if err != "" {
        say("could not write ${path}: ${err}")
        return
    }
    say("wrote ${path}: build it with scripts/build_script.sh")
}

// A name nothing is using yet, so pressing the button twice does not overwrite
// the file the first press made and the work someone did in it.
unused_script_name() -> string {
    attempt = 1
    while attempt < 100 {
        candidate = "script${attempt}"
        if !fs.file_exists("resources/scripts/${candidate}.ae") { return candidate }
        attempt = attempt + 1
    }
    return "script"
}

script_template(name: string) -> string {
    // Built up rather than written as one literal: the template is source
    // code, and a single string of it in here would be a wall of escapes that
    // nobody could read or change.
    body = "// ${name}\n"
    body = string.concat(body, "//\n")
    body = string.concat(body, "// Attached to an object in the editor, this runs on it every frame.\n")
    body = string.concat(body, "// start is optional and runs once, when it is attached.\n\n")
    body = string.concat(body, "import ae3d.core\n")
    body = string.concat(body, "import ae3d.behaviour\n\n")
    body = string.concat(body, "exports (start, update)\n\n")
    body = string.concat(body, "start(state: ptr, go: *GameObject) {\n}\n\n")
    body = string.concat(body, "update(state: ptr, go: *GameObject, delta: float) {\n")
    body = string.concat(body, "    core.model_rotate(behaviour.object_model(go), 0.0, delta * 30.0, 0.0)\n")
    body = string.concat(body, "}\n")
    return body
}

script_library(id: int) -> *Script {
    if g_script_libs == null || id < 1 || id >= list.size(g_script_libs) { return null }
    return list.get_raw(g_script_libs, id) as *Script
}

scripted_count() -> int {
    total = 0
    i = 0
    while i < row_count() {
        if script_at(i) != SCRIPT_NONE { total = total + 1 }
        i = i + 1
    }
    return total
}

// The scene runs its objects' phases -- start once, then update -- the way
// the engine's scene runs a program's; the editor's slot on each object is
// what runs the attached script.
run_scripts(delta: float) {
    g_script_clock = g_script_clock + delta
    behaviour.scene_update(g_scene as *Scene, delta)
}

kind_count(kind: int) -> int {
    total = 0
    i = 0
    while i < row_count() {
        c = component_at(i)
        if c != null && c.kind == kind { total = total + 1 }
        i = i + 1
    }
    return total
}

scene_triangles() -> int {
    total = 0
    i = 0
    while i < row_count() {
        m = model_at(i)
        if m != null && m.visible { total = total + core.mesh_index_count(m.mesh) / 3 }
        i = i + 1
    }
    return total
}

// What the row is: the object's first component.
component_at(index: int) -> *Component {
    o = row_object(index)
    if o == null { return null }
    return behaviour.object_component(o, 0)
}

selected_kind() -> int {
    c = component_at(g_selected)
    if c == null { return behaviour.KIND_MESH }
    return c.kind
}

// What was attached to this model, matched by the model itself so the two
// cannot drift apart.
attachment_on(attachments: ptr, m: *Model) -> *Attachment {
    if attachments == null { return null }
    count = list.size(attachments)
    i = 0
    while i < count {
        a = list.get_raw(attachments, i) as *Attachment
        if a != null && scene.attachment_model(a) == m { return a }
        i = i + 1
    }
    return null
}

// The body the scene file records on an object (ae3d.scene's PhysicsSpec),
// kept as a component of the object so it moves, is deleted and comes back
// with it. Null when the object has no body.
record_of(o: *GameObject) -> *PhysicsSpec {
    if o == null { return null }
    c = behaviour.object_find_component(o, behaviour.KIND_COLLIDER)
    if c == null { return null }
    return behaviour.component_state(c) as *PhysicsSpec
}

spec_at(index: int) -> *PhysicsSpec { return record_of(row_object(index)) }

selected_spec() -> *PhysicsSpec { return spec_at(g_selected) }

// The first row with a body, or -1: what the checks select to drive the
// physics rows against.
index_of_spec() -> int {
    i = 0
    while i < row_count() {
        if spec_at(i) != null { return i }
        i = i + 1
    }
    return 0 - 1
}

// How many objects carry a body.
spec_count() -> int {
    total = 0
    i = 0
    while i < row_count() {
        if spec_at(i) != null { total = total + 1 }
        i = i + 1
    }
    return total
}

free_spec(state: ptr, go: *GameObject) {
    if state != null { heap.free(state as *PhysicsSpec) }
}

// The record on the object, replacing one it had. The object owns it from
// here: it goes when the object does.
give_spec(o: *GameObject, spec: *PhysicsSpec) {
    if o == null || spec == null { return }
    existing = behaviour.object_find_component(o, behaviour.KIND_COLLIDER)
    if existing != null { behaviour.object_remove_component(o, existing) }
    c = behaviour.component_new("Physics", behaviour.KIND_COLLIDER, spec as ptr)
    c.destroy = free_spec
    behaviour.object_add_component(o, c)
}

take_spec(o: *GameObject) {
    if o == null { return }
    existing = behaviour.object_find_component(o, behaviour.KIND_COLLIDER)
    if existing != null { behaviour.object_remove_component(o, existing) }
}

body_kind_of(spec: *PhysicsSpec) -> int {
    if spec == null { return BODY_NONE }
    if string.equals(spec.body, "static") == 1 { return BODY_STATIC }
    if string.equals(spec.body, "kinematic") == 1 { return BODY_KINEMATIC }
    if string.equals(spec.body, "character") == 1 { return BODY_CHARACTER }
    return BODY_DYNAMIC
}

body_kind_name(kind: int) -> string {
    if kind == BODY_STATIC { return "static" }
    if kind == BODY_KINEMATIC { return "kinematic" }
    if kind == BODY_CHARACTER { return "character" }
    return "dynamic"
}

collider_kind_of(spec: *PhysicsSpec) -> int {
    if spec == null { return 0 - 1 }
    if string.equals(spec.collider, "sphere") == 1 { return COLLIDER_SPHERE }
    if string.equals(spec.collider, "capsule") == 1 { return COLLIDER_CAPSULE }
    if string.equals(spec.collider, "hull") == 1 { return COLLIDER_HULL }
    if string.equals(spec.collider, "mesh") == 1 { return COLLIDER_MESH }
    return COLLIDER_BOX
}

collider_kind_name(kind: int) -> string {
    if kind == COLLIDER_SPHERE { return "sphere" }
    if kind == COLLIDER_CAPSULE { return "capsule" }
    if kind == COLLIDER_HULL { return "hull" }
    if kind == COLLIDER_MESH { return "mesh" }
    return "box"
}

// The body's kind onto the object: none takes the record away, a kind on
// an object without one gives it a record with the defaults a prop wants
// (a box of its bounds, a wooden surface, water's density).
apply_body_kind(o: *GameObject, kind: int) {
    if o == null { return }
    if kind == BODY_NONE { take_spec(o); return }
    spec = record_of(o)
    if spec == null {
        collider = "box"
        if kind == BODY_CHARACTER { collider = "capsule" }
        give_spec(o, scene.physics_spec_new(body_kind_name(kind), collider, 0.6, 0.0, 1.0))
        return
    }
    spec.body = core.set_owned(spec.body, body_kind_name(kind))
    // A character is a capsule, whatever the body before it was.
    if kind == BODY_CHARACTER { spec.collider = core.set_owned(spec.collider, "capsule") }
}

apply_collider_kind(o: *GameObject, kind: int) {
    spec = record_of(o)
    if spec == null { return }
    spec.collider = core.set_owned(spec.collider, collider_kind_name(kind))
}

// The kind chosen for the selected object: one undo step, the section
// repainted, the record changed.
set_body_kind(kind: int) {
    o = row_object(g_selected)
    m = selected_model()
    if o == null || m == null { return }
    was = body_kind_of(record_of(o))
    if kind == was { return }
    history.history_record(g_history, history.STEP_PROPERTY, m as ptr, BODY_KIND_SLOT,
                           (was) as float, (kind) as float)
    history.history_close(g_history)
    g_last_edit = seconds()
    apply_body_kind(o, kind)
    refresh_physics_section()
    refresh_parts()
    if kind == BODY_NONE { say("no body on ${core.text(m.name)}") } else { say("${body_kind_name(kind)} body on ${core.text(m.name)}") }
}

set_collider_kind(kind: int) {
    o = row_object(g_selected)
    m = selected_model()
    if o == null || m == null { return }
    spec = record_of(o)
    if spec == null {
        say("give ${core.text(m.name)} a body first")
        return
    }
    was = collider_kind_of(spec)
    if kind == was { return }
    history.history_record(g_history, history.STEP_PROPERTY, m as ptr, COLLIDER_KIND_SLOT,
                           (was) as float, (kind) as float)
    history.history_close(g_history)
    g_last_edit = seconds()
    apply_collider_kind(o, kind)
    refresh_physics_section()
    say("${collider_kind_name(kind)} collider on ${core.text(m.name)}")
}

is_physics_row(index: int) -> bool {
    return index == FRICTION_ROW || index == RESTITUTION_ROW || index == DENSITY_ROW
}

physics_value(index: int) -> float {
    spec = selected_spec()
    if spec == null { return 0.0 }
    if index == FRICTION_ROW { return spec.friction }
    if index == RESTITUTION_ROW { return spec.restitution }
    if index == DENSITY_ROW { return spec.density }
    return 0.0
}

write_physics(spec: *PhysicsSpec, index: int, value: float) {
    if spec == null { return }
    if index == FRICTION_ROW { spec.friction = value }
    if index == RESTITUTION_ROW { spec.restitution = value }
    if index == DENSITY_ROW { spec.density = value }
}

// --- figures ---------------------------------------------------------------------------------

struct FigureRow {
    model: ptr                     // *Model, the group
    figure: ptr                    // *Figure
    shown: bool                    // its meshes in the viewport
    motion: ptr                    // *MotionSpec: natural motion on it, as the scene file records it; null for none
    live: ptr                      // *Motion while the scene is simulated
    kept: ptr                      // its pose before the simulation took the rig
    // And its group's place: a ragdoll carries the rig from the top of its
    // parent chain, which for a figure is the group, so the object goes
    // where the figure falls.
    rest_position: Vec3
    rest_rotation: Quat
    rest_scale: Vec3
}

// The row a figure's group is, or null.
figure_row_of(m: *Model) -> *FigureRow {
    if g_figure_rows == null || m == null { return null }
    i = 0
    while i < list.size(g_figure_rows) {
        r = list.get_raw(g_figure_rows, i) as *FigureRow
        if r.model == m as ptr { return r }
        i = i + 1
    }
    return null
}

// Natural motion on the selected figure, as it is recorded, or null.
selected_motion() -> *MotionSpec {
    r = figure_row_of(selected_model())
    if r == null { return null }
    return r.motion as *MotionSpec
}

// Natural motion on or off on the selected figure: on, as a figure stands
// on its own muscles and gets up three seconds after it falls.
set_motion_on(on: bool) {
    r = figure_row_of(selected_model())
    if r == null { return }
    was = 0.0
    if r.motion != null { was = 1.0 }
    now = 0.0
    if on { now = 1.0 }
    if was == now { return }
    history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr, MOTION_ON_SLOT, was, now)
    apply_motion_on(r, on)
    refresh_motion_section()
}

apply_motion_on(r: *FigureRow, on: bool) {
    if on && r.motion == null { r.motion = scene.motion_spec_new("powered", 1.0, true, 3.0) as ptr }
    if !on && r.motion != null {
        heap.free(r.motion as *MotionSpec)
        r.motion = null
    }
}

set_motion_mode(which: int) {
    spec = selected_motion()
    if spec == null { return }
    was = motion.mode_of_name(spec.mode)
    history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr, MOTION_MODE_SLOT, was as float, which as float)
    apply_motion_mode(spec, which)
    refresh_motion_section()
}

apply_motion_mode(spec: *MotionSpec, which: int) {
    string.free(spec.mode)
    spec.mode = string.copy(motion.mode_name(which))
}

toggle_protective() {
    spec = selected_motion()
    if spec == null { return }
    was = 0.0
    if spec.protective { was = 1.0 }
    history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr, MOTION_PROTECT_SLOT, was, 1.0 - was)
    spec.protective = !spec.protective
    refresh_motion_section()
}

is_motion_row(index: int) -> bool { return index == MOTION_STRENGTH_ROW || index == MOTION_GET_UP_ROW }

motion_value(index: int) -> float {
    spec = selected_motion()
    if spec == null { return 0.0 }
    if index == MOTION_STRENGTH_ROW { return spec.strength }
    return spec.get_up
}

write_motion(spec: *MotionSpec, index: int, value: float) {
    if spec == null { return }
    if index == MOTION_STRENGTH_ROW { spec.strength = value }
    if index == MOTION_GET_UP_ROW { spec.get_up = value }
}

show_motion_section(on: bool) {
    if g_motion_bar != 0 { ui.set_hidden(g_motion_bar, hidden_flag(on)) }
    if g_motion_section != 0 { ui.set_hidden(g_motion_section, hidden_flag(on)) }
    if g_motion_divider != 0 { ui.set_hidden(g_motion_divider, hidden_flag(on)) }
}

// The section as the selected figure has it: natural motion lit when on,
// its mode lit, the protective switch, the strength and the get-up.
refresh_motion_section() {
    spec = selected_motion()
    if g_motion_on_btn != 0 { paint_mode_button(g_motion_on_btn, spec != null) }
    which = 0 - 1
    if spec != null { which = motion.mode_of_name(spec.mode) - motion.ANIMATED }
    paint_segments(g_motion_mode_buttons, 3, which)
    if g_protect_btn != 0 { paint_mode_button(g_protect_btn, spec != null && spec.protective) }
    show_row(MOTION_STRENGTH_ROW, motion_value(MOTION_STRENGTH_ROW))
    show_row(MOTION_GET_UP_ROW, motion_value(MOTION_GET_UP_ROW))
}

// The simulation's natural motion: every figure with it on, on its own
// muscles in the editor's engine, its pose kept first. Returns how many.
start_motions(e: *Engine) -> int {
    if g_figure_rows == null { return 0 }
    made = 0
    i = 0
    while i < list.size(g_figure_rows) {
        r = list.get_raw(g_figure_rows, i) as *FigureRow
        at = row_of_model(r.model)
        if r.motion != null && r.shown && at >= 0 {
            f = r.figure as *Figure
            spec = r.motion as *MotionSpec
            floor_under(e, r.model as *Model)
            r.kept = figure.keep_pose(f)
            group = r.model as *Model
            r.rest_position = group.position
            r.rest_rotation = group.rotation
            r.rest_scale = group.scale
            m = motion.on_skeleton(e, row_object(at), figure.skeleton(f))
            if m == null {
                figure.pose_free(r.kept)
                r.kept = null
                say("${core.text(model_at(at).name)} is no humanoid the engine knows: no natural motion")
            } else {
                motion.set_strength(m, spec.strength)
                motion.set_protective(m, spec.protective)
                motion.set_get_up(m, spec.get_up)
                motion.set_mode(m, motion.mode_of_name(spec.mode))
                r.live = m as ptr
                made = made + 1
            }
        }
        i = i + 1
    }
    return made
}

// Ground under a figure about to stand on its muscles: what the scene's
// static bodies give it, or -- where a ray from a metre over its feet meets
// none within three -- a floor at its feet for the simulation, which goes
// with the world. A figure placed on a terrain or a street with no body
// on it would otherwise fall through it and on for ever.
floor_under(e: *Engine, group: *Model) {
    p = physics.of(e)
    if p == null { return }
    core.model_sync_transform(group)
    feet = group.world_position
    if physics.ray_hits(p, core.vec3(feet.x, feet.y + 1.0, feet.z), core.vec3(0.0, 0.0 - 1.0, 0.0), 3.0) { return }
    floor = engine.object(e, "floor", loader.cube(1.0))
    behaviour.object_set_position(floor, core.vec3(feet.x, feet.y - 0.5, feet.z))
    physics.box_collider(floor, core.vec3(20.0, 0.5, 20.0), physics.material(0.8, 0.0))
    if g_floors == null { g_floors = list.new() }
    list.add_raw(g_floors, floor as ptr)
}

// The floors laid for the simulation, out of the editor's engine.
remove_floors(e: *Engine) {
    if g_floors == null { return }
    while list.size(g_floors) > 0 {
        engine.destroy(e, list.get_raw(g_floors, 0) as *GameObject)
        list.remove(g_floors, 0)
    }
}

// Natural motion let go of before the world goes, and every figure put back
// in the pose it had.
stop_motions() {
    if g_figure_rows == null { return }
    i = 0
    while i < list.size(g_figure_rows) {
        r = list.get_raw(g_figure_rows, i) as *FigureRow
        if r.live != null {
            motion.release(r.live as *Motion)
            r.live = null
        }
        i = i + 1
    }
}

restore_figure_poses() {
    if g_figure_rows == null { return }
    i = 0
    while i < list.size(g_figure_rows) {
        r = list.get_raw(g_figure_rows, i) as *FigureRow
        if r.kept != null {
            figure.put_pose(r.figure as *Figure, r.kept)
            figure.pose_free(r.kept)
            r.kept = null
            group = r.model as *Model
            core.model_set_position(group, r.rest_position.x, r.rest_position.y, r.rest_position.z)
            core.model_set_rotation(group, r.rest_rotation)
            core.model_set_scale(group, r.rest_scale.x, r.rest_scale.y, r.rest_scale.z)
        }
        i = i + 1
    }
}

// A click on a figure while the scene is simulated: the blow lands where the
// click met its body, along the click. True when a figure was struck.
strike_at(x: float, y: float) -> bool {
    if !g_simulating || g_engine == null { return false }
    cam = g_camera as *Camera
    p = physics.of(g_engine as *Engine)
    if cam == null || p == null { return false }
    direction = raycast.screen_direction(cam, x, y, g_canvas_w, g_canvas_h)
    hit = physics.ragdoll_at(p, cam.position, direction, 10000.0)
    if hit.ragdoll == null { return false }
    i = 0
    while i < list.size(g_figure_rows) {
        r = list.get_raw(g_figure_rows, i) as *FigureRow
        live = r.live as *Motion
        if live != null && live.ragdoll as ptr == hit.ragdoll {
            motion.hit(live, hit.bone, hit.point, core.v3_mul(core.v3_normalize(direction), HIT_IMPULSE))
            say("struck ${core.text((r.model as *Model).name)}")
            mark_dirty()
            return true
        }
        i = i + 1
    }
    return false
}

// The figure a model stands for, or null.
figure_on(m: *Model) -> *Figure {
    if g_figure_rows == null || m == null { return null }
    i = 0
    while i < list.size(g_figure_rows) {
        r = list.get_raw(g_figure_rows, i) as *FigureRow
        if r.model == m as ptr { return r.figure as *Figure }
        i = i + 1
    }
    return null
}

selected_figure() -> *Figure { return figure_on(selected_model()) }

// The first row that is a figure with natural motion on, or -1.
index_of_motion() -> int {
    i = 0
    while i < row_count() {
        r = figure_row_of(model_at(i))
        if r != null && r.motion != null { return i }
        i = i + 1
    }
    return 0 - 1
}

// The first row that is a figure, or -1.
index_of_figure() -> int {
    i = 0
    while i < row_count() {
        if figure_on(model_at(i)) != null { return i }
        i = i + 1
    }
    return 0 - 1
}

// A figure read from `path` under the group `m`, its meshes drawn; null
// when the file cannot be read.
make_figure(m: *Model, path: string) -> *Figure {
    f = figure.figure_new(path, m)
    if f == null { return null }
    if g_figure_rows == null { g_figure_rows = list.new() }
    r = heap.new(FigureRow)
    r.model = m as ptr
    r.figure = f as ptr
    r.shown = false
    list.add_raw(g_figure_rows, r as ptr)
    show_figure(m, true)
    return f
}

// A figure's meshes into the viewport or out of it, with its group.
show_figure(m: *Model, on: bool) {
    if g_figure_rows == null { return }
    i = 0
    while i < list.size(g_figure_rows) {
        r = list.get_raw(g_figure_rows, i) as *FigureRow
        if r.model == m as ptr && r.shown != on {
            f = r.figure as *Figure
            backend = viewport_backend()
            k = 0
            while k < figure.primitive_count(f) {
                if on {
                    core.backend_add_model(&backend, figure.primitive(f, k))
                } else {
                    core.backend_remove_model(&backend, figure.primitive(f, k))
                }
                k = k + 1
            }
            r.shown = on
        }
        i = i + 1
    }
}

// Every figure gone from the viewport and freed, with its file: the scene
// they were in is going.
clear_figures() {
    if g_figure_rows == null { return }
    while list.size(g_figure_rows) > 0 {
        r = list.get_raw(g_figure_rows, 0) as *FigureRow
        show_figure(r.model as *Model, false)
        figure.figure_free(r.figure as *Figure)
        if r.motion != null { heap.free(r.motion as *MotionSpec) }
        if r.kept != null { figure.pose_free(r.kept) }
        heap.free(r)
        list.remove(g_figure_rows, 0)
    }
}

// The scene's figures, for the report.
figure_count() -> int {
    if g_figure_rows == null { return 0 }
    return list.size(g_figure_rows)
}

// Asks the first figure whether it plays while the scene is simulated:
// its clip on by a quarter second of simulation. Nought when it does, or
// when the scene has no figure with a clip.
figure_stuck() -> int {
    index = index_of_figure()
    if index < 0 { return 0 }
    f = figure_on(model_at(index))
    if string.equals(figure.clip(f), "") == 1 { return 0 }
    was = figure.time(f)
    start_simulation()
    if !g_simulating { return 1 }
    update_figures(0.125)
    update_figures(0.125)
    moved = core.abs_of(figure.time(f) - was) > 0.001
    stop_simulation()
    figure.set_time(f, was)
    if moved { return 0 }
    return 1
}

// The figures with natural motion on, for the report.
motion_count() -> int {
    count = 0
    if g_figure_rows == null { return 0 }
    i = 0
    while i < list.size(g_figure_rows) {
        r = list.get_raw(g_figure_rows, i) as *FigureRow
        if r.motion != null { count = count + 1 }
        i = i + 1
    }
    return count
}

// Asks the first figure with natural motion on what the simulation does
// with it: on its muscles it still stands a second in (its pelvis within a
// fifth of where it stood), struck at the chest with the click's blow it
// is down a second and a half later, and stopped, its bones are back where
// they were. Nought when all three hold, or when no figure has it on; one
// for each that does not.
motion_stuck() -> int {
    index = index_of_motion()
    if index < 0 { return 0 }
    r = figure_row_of(model_at(index))
    f = r.figure as *Figure
    sk = figure.skeleton(f)
    if sk == null { return 1 }
    first = skin.skeleton_bone(sk, 0)
    core.model_sync_transform(first)
    was = first.world_position
    wrong = 0
    start_simulation()
    live = r.live as *Motion
    if !g_simulating || live == null { return 3 }
    e = g_engine as *Engine
    pelvis = physics.ragdoll_bone(live.ragdoll, human.BONE_PELVIS)
    stood = behaviour.object_position(pelvis).y
    steps = 0
    while steps < 60 {
        engine.engine_update(e, 1.0 / 60.0)
        steps = steps + 1
    }
    standing = behaviour.object_position(pelvis).y
    if core.abs_of(standing - stood) > core.abs_of(stood) * 0.2 { wrong = wrong + 1 }
    chest = behaviour.object_position(physics.ragdoll_bone(live.ragdoll, human.BONE_SPINE_03))
    ahead = core.quat_apply(physics.ragdoll_bone_rotation(live.ragdoll, human.BONE_PELVIS), core.vec3(0.0, 0.0, 1.0))
    motion.hit(live, human.BONE_SPINE_03, chest, core.v3_mul(core.v3_normalize(core.vec3(ahead.x, 0.0, ahead.z)), HIT_IMPULSE))
    steps = 0
    while steps < 90 {
        engine.engine_update(e, 1.0 / 60.0)
        steps = steps + 1
    }
    if behaviour.object_position(pelvis).y > standing * 0.5 { wrong = wrong + 1 }
    stop_simulation()
    core.model_sync_transform(first)
    if core.v3_len(core.v3_sub(first.world_position, was)) > 0.0001 { wrong = wrong + 1 }
    return wrong
}

// Every figure in the scene on by the frame's time, while the scene runs:
// a figure stands in its pose while the scene is edited, and plays when
// it is simulated.
update_figures(delta: float) {
    if g_figure_rows == null || !g_simulating { return }
    i = 0
    while i < list.size(g_figure_rows) {
        r = list.get_raw(g_figure_rows, i) as *FigureRow
        if r.shown { figure.advance(r.figure as *Figure, delta) }
        i = i + 1
    }
}

is_figure_row(index: int) -> bool { return index == FIGURE_SPEED_ROW || index == FIGURE_TIME_ROW }

figure_value(index: int) -> float {
    f = selected_figure()
    if f == null { return 0.0 }
    if index == FIGURE_SPEED_ROW { return figure.speed(f) }
    if figure.duration(f) <= 0.0 { return 0.0 }
    return figure.time(f) / figure.duration(f)
}

write_figure(f: *Figure, index: int, value: float) {
    if f == null { return }
    if index == FIGURE_SPEED_ROW { figure.set_speed(f, value) }
    if index == FIGURE_TIME_ROW { figure.set_time(f, value * figure.duration(f)) }
    paint_soon()
}

// The clip at `index` in the file's list playing on the selected figure,
// from its start, at the speed and loop it had; -1 stops it.
choose_clip(index: int) {
    f = selected_figure()
    if f == null { return }
    if index >= figure.clip_count(f) { return }
    history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr, FIGURE_CLIP_SLOT,
                           (figure.clip_index(f)) as float, index as float)
    apply_clip(f, index)
    refresh_figure_section()
}

apply_clip(f: *Figure, index: int) {
    if index < 0 {
        figure.stop(f)
    } else {
        figure.play(f, figure.clip_name(f, index), figure.speed(f), figure.looping(f))
    }
    paint_soon()
}

toggle_loop() {
    f = selected_figure()
    if f == null { return }
    was = 0.0
    if figure.looping(f) { was = 1.0 }
    history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr, FIGURE_LOOP_SLOT, was, 1.0 - was)
    figure.set_looping(f, !figure.looping(f))
    refresh_figure_section()
}

show_figure_section(on: bool) {
    if g_figure_bar != 0 { ui.set_hidden(g_figure_bar, hidden_flag(on)) }
    if g_figure_section != 0 { ui.set_hidden(g_figure_section, hidden_flag(on)) }
    if g_figure_divider != 0 { ui.set_hidden(g_figure_divider, hidden_flag(on)) }
}

// The section as the selected figure has it: a button a clip, named for
// it and lit when it plays, the loop switch, the speed and the time.
refresh_figure_section() {
    f = selected_figure()
    if f == null || g_clip_buttons == null { return }
    buttons = g_clip_buttons as int[]
    playing = figure.clip_index(f)
    i = 0
    while i < MAX_CLIPS {
        b = buttons[i]
        if b != 0 {
            there = i < figure.clip_count(f)
            ui.set_hidden(b, hidden_flag(there))
            if there {
                ui.set_text(b, figure.clip_name(f, i))
                paint_mode_button(b, i == playing)
            }
        }
        i = i + 1
    }
    if g_loop_btn != 0 { paint_mode_button(g_loop_btn, figure.looping(f)) }
    show_row(FIGURE_SPEED_ROW, figure_value(FIGURE_SPEED_ROW))
    show_row(FIGURE_TIME_ROW, figure_value(FIGURE_TIME_ROW))
}

show_physics_section(on: bool) {
    if g_physics_bar != 0 { ui.set_hidden(g_physics_bar, hidden_flag(on)) }
    if g_physics_section != 0 { ui.set_hidden(g_physics_section, hidden_flag(on)) }
    if g_physics_divider != 0 { ui.set_hidden(g_physics_divider, hidden_flag(on)) }
}

// The section as the selected object has it: its kind lit, its collider
// lit when it has a body, the rows on the record's numbers.
refresh_physics_section() {
    spec = selected_spec()
    paint_segments(g_body_buttons, BODY_KINDS, body_kind_of(spec))
    paint_segments(g_collider_buttons, COLLIDER_KINDS, collider_kind_of(spec))
    show_row(FRICTION_ROW, physics_value(FRICTION_ROW))
    show_row(RESTITUTION_ROW, physics_value(RESTITUTION_ROW))
    show_row(DENSITY_ROW, physics_value(DENSITY_ROW))
}

// --- the simulation ----------------------------------------------------------------------------------------

// The scene's bodies, run: physics over the editor's engine, a body on
// every object with a record (from its own mesh, as the record says), the
// frame stepping the world. Every model's transform is kept first.
start_simulation() {
    if g_simulating { return }
    start_weather()
    if g_engine == null {
        say("nothing to simulate with yet")
        return
    }
    e = g_engine as *Engine
    if physics.of(e) == null { physics.attach(e) }
    g_rest = list.new()
    bodies = 0
    count = row_count()
    i = 0
    while i < count {
        o = row_object(i)
        m = model_at(i)
        spec = spec_at(i)
        if o != null && m != null && spec != null {
            rest = heap.new(Rest)
            rest.model = m as ptr
            rest.position = m.position
            rest.rotation = m.rotation
            list.add_raw(g_rest, rest as ptr)
            if physics.apply_spec(o, spec) != null || physics.character_of(o) != null { bodies = bodies + 1 }
        }
        i = i + 1
    }
    g_live_figures = start_motions(e)
    g_simulating = true
    if g_simulate_btn != 0 { ui.set_text(g_simulate_btn, "Stop") }
    mark_dirty()
    if g_live_figures > 0 {
        say("simulating ${bodies} bodies and ${g_live_figures} figures on their muscles: click one to strike it")
    } else {
        say("simulating ${bodies} bodies")
    }
}

// The world gone, and every model back where it stood: the simulation is
// for looking at, and the scene is what it was before it ran. A model
// deleted while it ran is not put back.
stop_simulation() {
    if !g_simulating { return }
    e = g_engine as *Engine
    stop_motions()
    p = physics.of(e)
    if p != null { physics.physics_free(p) }
    remove_floors(e)
    restore_figure_poses()
    g_live_figures = 0
    count = list.size(g_rest)
    i = 0
    while i < count {
        rest = list.get_raw(g_rest, i) as *Rest
        if row_of_model(rest.model) >= 0 {
            m = rest.model as *Model
            core.model_set_position(m, rest.position.x, rest.position.y, rest.position.z)
            core.model_set_rotation(m, rest.rotation)
        }
        heap.free(rest)
        i = i + 1
    }
    list.free(g_rest)
    g_rest = null
    g_simulating = false
    if g_simulate_btn != 0 { ui.set_text(g_simulate_btn, "Simulate") }
    mark_dirty()
    sync_inspector()
    say("the simulation stopped; the scene is as it was")
}

// Whether the world stepped at least this often since the simulation began.
physics_stepped(steps: int) -> bool {
    if g_engine == null { return false }
    p = physics.of(g_engine as *Engine)
    if p == null { return false }
    return physics.physics_step_count(p) >= steps
}

toggle_simulation() {
    if g_simulating { stop_simulation() } else { start_simulation() }
}

// The first row with a body that moves on its own, or -1.
index_of_dynamic() -> int {
    i = 0
    while i < row_count() {
        if body_kind_of(spec_at(i)) == BODY_DYNAMIC { return i }
        i = i + 1
    }
    return 0 - 1
}

// A dynamic body falls, or rests on what it stands on: the check runs the
// simulation for a second of fixed steps and asks the first dynamic body
// whether the world took it (it moved, or it was left exactly where it
// stood because something held it up -- either way the world stepped),
// then stops it and asks whether it is back where it stood. Nought when
// both hold, or when nothing in the scene has a dynamic body to ask.
simulation_stuck() -> int {
    index = index_of_dynamic()
    if index < 0 { return 0 }
    m = model_at(index)
    was = m.position
    start_simulation()
    if !g_simulating { return 1 }
    steps = 0
    while steps < 60 {
        engine.engine_update(g_engine as *Engine, 1.0 / 60.0)
        steps = steps + 1
    }
    moved = core.abs_of(m.position.y - was.y) > 0.05 || physics_stepped(60)
    stop_simulation()
    restored = core.abs_of(m.position.y - was.y) < 0.0001 &&
               core.abs_of(m.position.x - was.x) < 0.0001 &&
               core.abs_of(m.position.z - was.z) < 0.0001
    wrong = 0
    if !moved { wrong = wrong + 1 }
    if !restored { wrong = wrong + 1 }
    return wrong
}

selected_water() -> *Simulation {
    c = component_at(g_selected)
    if c == null || c.kind != behaviour.KIND_WATER { return null }
    return behaviour.component_state(c) as *Simulation
}

selection_count() -> int {
    count = row_count()
    total = 0
    i = 0
    while i < count {
        if is_selected(i) { total = total + 1 }
        i = i + 1
    }
    return total
}

// Picking casts the cursor ray at every model's exact triangles, nearest wins.
// Each is rejected against its bounding sphere first, so this stays cheap with a
// full scene. The grid and the outline are not pickable.
pick_at(x: float, y: float) {
    cam = g_camera as *Camera
    if cam == null || g_scene == null { return }
    if strike_at(x, y) { return }

    direction = raycast.screen_direction(cam, x, y, g_canvas_w, g_canvas_h)
    nearest = raycast.miss()
    chosen = 0 - 1

    count = row_count()
    i = 0
    while i < count {
        m = model_at(i)
        if m != null {
            distance = raycast.model_mesh(cam.position, direction, m)
            if raycast.hit(distance) {
                if !raycast.hit(nearest) || distance < nearest {
                    nearest = distance
                    chosen = i
                }
            }
        }
        i = i + 1
    }

    if chosen >= 0 {
        select_object(chosen)
        say("selected ${core.text(model_at(chosen).name)}")
    } else {
        say("nothing under the cursor")
    }
}

// The canvas changed size, in points. On the blit path the canvas is the
// framebuffer, so this is the render size too.
resize_canvas(width: int, height: int) {
    mark_dirty()
    if width < 16 || height < 16 { return }
    if width == g_canvas_w && height == g_canvas_h { return }
    g_canvas_w = width
    g_canvas_h = height
    if g_gpu != 0 {
        // The GPU view says what the framebuffer is; this one only says where
        // the gizmo goes.
        draw_frame()
        return
    }
    resize_viewport(width, height)
}

// The framebuffer changed size, in pixels.
resize_viewport(width: int, height: int) {
    mark_dirty()
    if width < 16 || height < 16 { return }
    if width == g_view_w && height == g_view_h { return }
    g_view_w = width
    g_view_h = height

    // CRITICAL: the canvas holds a BORROWED pointer to the framebuffer, and
    // updating the viewport reallocates it. Dropping the command first is what
    // keeps a repaint during the resize from reading freed memory; rendering
    // straight afterwards is what keeps the viewport from going blank for a
    // frame while the window is being dragged.
    ui.canvas_clear(g_canvas)

    core.camera_set_aspect(g_camera as *Camera, (width * 1.0) / (height * 1.0))
    // CRITICAL: the GPU path lays the view out before it hands over a context,
    // so this runs with no renderer behind it. viewport_backend would build a
    // vtable of null pointers out of a null renderer and the first call through
    // it jumps to zero.
    if g_renderer == null { return }

    backend = viewport_backend()
    core.backend_update_viewport(&backend, width, height)
    draw_frame()
}

// Split positions only stick once the window has been laid out, so they are
// applied on the first frame rather than while the tree is still being built.
// Proportional sharing across all three panes. Weighting only the viewport
// leaves the panels at their content width, which is far too narrow for a
// hierarchy or an inspector, and nothing else in the toolkit sets a width
// (aether-lang-dev/aether-ui#95).
// Exact widths for the side panels and the remainder for the viewport. Weights
// rounded each pane up independently, which left the three a pixel wider than
// the window they had to fit in.
settle_layout() {
    if g_layout_settled || g_stage == 0 { return }
    // The dividers where the panels open: the left panel PANEL_LEFT wide, the
    // inspector PANEL_RIGHT wide at the inner splitter's far end, the viewport
    // the rest. Only positions, so a drag moves them afterwards.
    if g_split_outer != 0 { ui.split_set_position(g_split_outer, PANEL_LEFT) }
    if g_split_inner != 0 { ui.split_set_position(g_split_inner, WINDOW_W - PANEL_LEFT - PANEL_RIGHT - 2 * SPLIT_DIVIDER) }
    // The colour chip is painted here for the same reason the widths are: the
    // style sheet is applied to the tree after it is built, and a background
    // set before that is wiped by it. The chip was set during the first
    // selection, so it came out an empty outline while the readback happily
    // reported the colour it had been given.
    refresh_swatch()
    refresh_mode_buttons()
    refresh_preset_buttons()
    refresh_script_buttons()
    g_layout_settled = true
}

// CRITICAL: platform.time(), not arithmetic on clock_ns(). The editor used to
// compute (clock_ns() / 1000000) * 0.001, and measured in place that clock only
// ever changed in whole seconds: printing the interval between two frames gave
// 0 for a run of ticks and then 1. So the frame rate read 0 for the life of the
// program, and delta never left its 0.016 fallback, which meant water and
// scripts advanced at a fixed step whatever the machine was doing. The same
// expression on its own keeps the fraction, so the arithmetic alone is not the
// explanation and it is not worth another guess: platform.time() is a double
// straight off the monotonic clock, it is what the engine's own loop already
// uses, and with it the interval reads 0.033, 0.021, 0.014 and the bar reads
// 62 fps.
seconds() -> float {
    return platform.time()
}

// The viewport changed size without its callback saying so. On GTK a GL area
// and a canvas both report a new size only when they are drawn, and a still
// scene draws nothing: a divider dragged across the viewport left the
// renderer at the old size. The canvas's allocation is read here, which
// every toolkit answers, and taken as its size; the GPU view is asked for a
// frame, since drawing it is what delivers the size in pixels
// (gpuview_on_resize). Both are aether-ui#211.
watch_view_size() {
    if g_gpu == 0 {
        if g_canvas == 0 { return }
        view = ui.canvas_widget(g_canvas)
        cw = ui.get_width(view)
        ch = ui.get_height(view)
        if cw > 0 && ch > 0 && (cw != g_canvas_w || ch != g_canvas_h) { resize_canvas(cw, ch) }
        return
    }
    if g_gpu_widget == 0 { return }
    w = ui.get_width(g_gpu_widget)
    h = ui.get_height(g_gpu_widget)
    if w == g_gpu_seen_w && h == g_gpu_seen_h { return }
    g_gpu_seen_w = w
    g_gpu_seen_h = h
    mark_dirty()
}

draw_frame() {
    paint_started = seconds()
    draw_frame_body()
    paint_spent = (seconds() - paint_started) * 1000.0
    if g_paint_ms <= 0.0 {
        g_paint_ms = paint_spent
    } else {
        g_paint_ms = g_paint_ms * 0.9 + paint_spent * 0.1
    }
}

draw_frame_body() {
    if g_renderer == null { return }

    now = seconds()
    delta = 0.016
    if g_last_time > 0.0 {
        elapsed = now - g_last_time
        if elapsed > 0.0 && elapsed < 0.25 { delta = elapsed }
        g_delta = delta
        // Seeded with the first measurement rather than smoothed up from
        // zero. A running average that starts at nothing spends a second
        // climbing, and what it shows on the way is a rate the editor is not
        // running at: the bar opened on 2 fps while the frames were arriving
        // sixty times a second.
        //
        // And a gap longer than a second is a stall rather than a frame:
        // the first gap of a run that opens a scene spans reading it off
        // disk, so the bar opened on 4 fps in a roundtrip run while the
        // editor was drawing at sixty. The simulation step above draws its
        // line at a quarter second; the rate's line is looser, because a
        // software rasteriser on a loaded CI runner draws a frame in a
        // quarter second or a little more, and with the step's rule every
        // frame of such a run was a stall and the bar never opened at all.
        if elapsed > 0.0 && elapsed < 1.0 {
            if g_fps <= 0.0 {
                g_fps = 1.0 / elapsed
            } else {
                g_fps = g_fps * 0.9 + (1.0 / elapsed) * 0.1
            }
        }
    }
    g_last_time = now

    if g_last_edit > 0.0 && now - g_last_edit > EDIT_SETTLE {
        history.history_close(g_history)
        g_last_edit = 0.0
    }

    // Held means the simulation does not advance. The editor redraws anyway,
    // because an editor that only redraws on change would otherwise stop
    // producing the frames an agent is holding it still in order to look at.
    held = false
    if g_agent_on { held = agent.is_paused(g_agent_ctx as *Context) }
    g_held = held

    // Outside the held check: a frame the agent is holding is exactly when
    // someone is looking at one object and rebuilding the script on it, and a
    // reload that only happens while time is running would never arrive.
    reload_changed_scripts()

    if !held {
        update_water(delta)
        update_figures(delta)
        run_scripts(delta)
        if g_engine != null { engine.engine_update(g_engine as *Engine, delta) }
    }
    update_outline()

    // A bounded run has to reach its frame count whatever is on screen, so the
    // gate never applies to one.
    backend = viewport_backend()

    if !held && !g_dirty && !scene_animates() && g_frame_limit == 0 {
        update_stats(&backend)
        return
    }
    g_dirty = false

    // On the GPU path the scene is drawn by aether-ui, inside the one callback
    // where its context is current. The canvas above it carries the gizmo and
    // nothing else, so it is repainted here and the frame is asked for.
    if g_gpu != 0 {
        ui.canvas_clear(g_canvas)
        draw_gizmo()
        ui.canvas_redraw(g_canvas)
        ui.gpuview_request_render(g_gpu)
        return
    }

    core.backend_render(&backend, g_camera as *Camera, g_light as *Light)

    blit_started = seconds()
    pixels = core.backend_frame_pixels(&backend)
    if pixels == null { return }

    // The canvas keeps a retained command list, so the previous frame's blit has
    // to go before the next is added, or it grows by a full viewport each frame.
    ui.canvas_clear(g_canvas)
    // Borrowed, not copied. The renderer owns one framebuffer and overwrites it
    // in place, which is the lifetime this asks for; the copying twin allocated
    // and memcpy'd the whole viewport every frame and measured 61% of the frame,
    // more than reading it back off the GPU and six times the cost of rendering
    // it. The one place the buffer does not outlive the command is a resize,
    // and resize_viewport clears the canvas before it reallocates.
    ui.canvas_draw_image_borrowed_ptr(g_canvas, 0.0, 0.0, g_view_w, g_view_h,
                                      pixels, g_view_w * g_view_h * 4)
    draw_gizmo()
    ui.canvas_redraw(g_canvas)
    spent = (seconds() - blit_started) * 1000.0
    if g_blit_ms <= 0.0 {
        g_blit_ms = spent
    } else {
        g_blit_ms = g_blit_ms * 0.9 + spent * 0.1
    }
    frame_finished(&backend)
}

// The scene, drawn where aether-ui's context is current. Draw only, as the
// toolkit asks: it presents afterwards, and a swap here would present twice.
//
// Everything that follows a frame happens here too rather than in the timer,
// because a snapshot and an agent's capture are both reads of the framebuffer
// that has just been drawn, and this is the only place it can be read from.
render_viewport() {
    if g_renderer == null { return }
    backend = viewport_backend()
    core.backend_render(&backend, g_camera as *Camera, g_light as *Light)
    frame_finished(&backend)
}

// What a produced frame owes: the count, the bar, the agent, and the end of a
// bounded run.
frame_finished(backend: *Backend) {
    if !g_held { g_frames = g_frames + 1 }
    if g_scene_ready && g_ready_ms < 0.0 {
        g_ready_ms = (seconds() - g_started) * 1000.0
        profile_mark("first frame of the scene")
    }

    update_stats(backend)

    if g_agent_on { pump_agent() }

    if g_frame_limit > 0 && g_frames >= g_frame_limit && !g_reported {
        g_reported = true
        write_snapshot(g_snapshot)
        ui.timer_cancel(g_timer)
        report_state()
        ui.app_quit()
    }
}

// The frame as a PNG. On the GPU path that is the GL framebuffer, read where it
// was drawn; on the blit path it is the canvas, which is what the editor is
// actually showing and includes the gizmo over it.
write_snapshot(path: string) {
    if path == "" { return }
    if g_gpu != 0 {
        gl.snapshot(path, g_view_w, g_view_h)
        return
    }
    ui.canvas_write_png(g_canvas, path, g_view_w, g_view_h)
}

// A scripted run of the edit paths, so undo and redo are checked by exercising
// them rather than by reading the code. Reported through the same file a
// bounded run writes, because the run loop has to be ended from outside.
// CRITICAL: throttled by time, not by a count of frames. A frame count only
// advances when the viewport is redrawn, and the viewport is not redrawn while
// nothing changes, so the bar froze on whatever it last managed to write. That
// was almost always the very first sample, taken before a single interval had
// been measured, which is why it read 0 fps for the life of the program.
//
// And nothing is written until there is something true to write. That first
// sample was also taken before the viewport had been given its real size, so
// the first thing the editor showed anyone was 0 fps at a resolution it was
// not rendering at. The bar carries the backend's name until the numbers mean
// something.
update_stats(backend: *Backend) {
    if g_stats == 0 { return }
    // Until an interval has been measured, not until a second frame has been
    // drawn. Those were the same thing before a gap longer than a quarter
    // second stopped counting as a frame: a run that opens a scene can draw
    // its first frames further apart than that, and the bar then wrote the
    // zero the average still held.
    if g_fps <= 0.0 { return }
    now = seconds()
    if g_stats_written > 0.0 && now - g_stats_written < STATS_INTERVAL { return }
    g_stats_written = now
    if g_first_fps < 0 { g_first_fps = (g_fps) as int }
    ui.set_text(g_stats, "${g_backend_name}   ${(g_fps) as int} fps   ${pass_costs()}   ${core.backend_draw_calls(backend)} draws   ${scene_triangles()} tris   ${g_view_w}x${g_view_h}")
}

// What the last frame cost on the device, pass by pass, in milliseconds:
// the shadow map, the scene, the effects. A frame rate says a scene is
// slow; this says which pass made it so. Both renderers time their passes
// with device timestamps, so the numbers are the GPU's and not the driver's.
pass_costs() -> string {
    shadow = 0.0
    scene = 0.0
    post = 0.0
    if g_vulkan {
        shadow = vulkan.renderer_shadow_ms(g_renderer as *VKRenderer)
        scene = vulkan.renderer_scene_ms(g_renderer as *VKRenderer)
        post = vulkan.renderer_post_ms(g_renderer as *VKRenderer)
    } else {
        shadow = gl.renderer_shadow_ms(g_renderer as *GLRenderer)
        scene = gl.renderer_scene_ms(g_renderer as *GLRenderer)
        post = gl.renderer_post_ms(g_renderer as *GLRenderer)
    }
    costs = "shadow ${number(shadow)} scene ${number(scene)} post ${number(post)} ms"
    // The readback and the blit, where the viewport is a picture the CPU
    // carries rather than a surface the GPU presents into.
    if g_gpu == 0 { costs = string.concat(costs, "  readback ${number(g_blit_ms)} ms") }
    // The scene's own split, where the backend stamps it: the same figures
    // AE3D_PERF prints and scripts/perf.sh tables, read off the bar.
    if g_vulkan {
        r = g_renderer as *VKRenderer
        costs = string.concat(costs, "  (depth ${number(vulkan.renderer_stage_ms(r, 3))} sky ${number(vulkan.renderer_stage_ms(r, 4))} opaque ${number(vulkan.renderer_stage_ms(r, 5))} ao ${number(vulkan.renderer_stage_ms(r, 6))} clear ${number(vulkan.renderer_stage_ms(r, 7))})")
    }
    return costs
}

// Every row is asked to move its target and the target is read back, because a
// row that records an undo step and updates its own readout looks exactly like
// a row that worked. Nine of them did that and nothing else.
row_reaches_its_target(index: int) -> bool {
    light = g_light as *Light
    cam = g_camera as *Camera
    sim = selected_water()

    if is_light_row(index) {
        if light == null { return true }
        before = light_value(index)
        apply_property(index, before + 0.25)
        moved = core.abs_of(light_value(index) - (before + 0.25)) < 0.001
        apply_property(index, before)
        return moved
    }

    if is_water_row(index) {
        if sim == null { return true }
        before = water_value(index)
        apply_property(index, before + 0.5)
        moved = core.abs_of(water_value(index) - (before + 0.5)) < 0.001
        apply_property(index, before)
        return moved
    }

    if is_motion_row(index) {
        if selected_motion() == null { return true }
        before = motion_value(index)
        apply_property(index, before * 0.5 + 0.25)
        moved = core.abs_of(motion_value(index) - (before * 0.5 + 0.25)) < 0.001
        apply_property(index, before)
        return moved
    }

    if is_figure_row(index) {
        if selected_figure() == null { return true }
        before = figure_value(index)
        apply_property(index, before * 0.5 + 0.25)
        moved = core.abs_of(figure_value(index) - (before * 0.5 + 0.25)) < 0.001
        apply_property(index, before)
        return moved
    }

    if is_physics_row(index) {
        if selected_spec() == null { return true }
        before = physics_value(index)
        apply_property(index, before + 0.25)
        moved = core.abs_of(physics_value(index) - (before + 0.25)) < 0.001
        apply_property(index, before)
        return moved
    }

    if index == BRUSH_ROW {
        before = g_brush_radius
        apply_property(index, before + 0.25)
        moved = core.abs_of(g_brush_radius - (before + 0.25)) < 0.001
        apply_property(index, before)
        return moved
    }

    if index == TIME_ROW {
        before = g_time_of_day
        apply_property(index, before + 0.25)
        moved = core.abs_of(g_time_of_day - (before + 0.25)) < 0.001
        apply_property(index, before)
        return moved
    }

    // The view's rows read the editor's state rather than a model, so with
    // a model selected they fell through to the model's properties and
    // reported the cloud cover and the occlusion stuck, which they were not.
    if is_light_shape_row(index) {
        if active_light() == null { return true }
        if (index == LIGHT_INNER_ROW || index == LIGHT_OUTER_ROW) && light_mode_of(active_light()) != LIGHT_SPOT { return true }
        before = light_shape_value(index)
        apply_property(index, before + 0.25)
        moved = core.abs_of(light_shape_value(index) - (before + 0.25)) < 0.05
        apply_property(index, before)
        return moved
    }

    if is_view_row(index) {
        before = view_value(index)
        apply_property(index, before + 0.25)
        moved = core.abs_of(view_value(index) - (before + 0.25)) < 0.001
        apply_property(index, before)
        return moved
    }

    if index == TERRAIN_SEED_ROW {
        // A seed is a whole number and regenerating is the whole of what it
        // does, so it moves by one rather than by the quarter every other row
        // uses: a quarter of a seed is the same seed.
        if selected_world() == null { return true }
        before = (terrain_seed()) as float
        apply_property(index, before + 1.0)
        moved = core.abs_of((terrain_seed()) as float - (before + 1.0)) < 0.5
        apply_property(index, before)
        return moved
    }

    if is_sky_row(index) {
        before = sky_value(index)
        apply_property(index, before + 0.25)
        moved = core.abs_of(sky_value(index) - (before + 0.25)) < 0.001
        apply_property(index, before)
        return moved
    }

    if index >= CAMERA_FIRST_ROW && index <= CAMERA_LAST_ROW {
        if cam == null { return true }
        before = camera_value(index)
        apply_property(index, before + 1.0)
        moved = core.abs_of(camera_value(index) - (before + 1.0)) < 0.001
        apply_property(index, before)
        return moved
    }

    m = selected_model()
    if m == null { return true }
    before = property_value(m, index)
    apply_property(index, before + 0.25)
    moved = core.abs_of(property_value(m, index) - (before + 0.25)) < 0.001
    apply_property(index, before)
    return moved
}

// The water rows read the selected object, so the check selects the water while
// it runs them and puts the selection back: with a sphere selected they would
// report nothing either way, which is how they came to be unreachable.
index_of_kind(kind: int) -> int {
    i = 0
    while i < row_count() {
        c = component_at(i)
        if c != null && c.kind == kind { return i }
        i = i + 1
    }
    return 0 - 1
}

// The buttons have the same shape of failure the rows had: one that dispatches
// to nothing looks exactly like one that works, because the only witness is a
// person watching the viewport. Each is asked for its effect and the effect is
// looked for.
actions_that_do_nothing() -> int {
    if selected_model() == null { return 0 }
    wrong = 0

    before_count = row_count()
    duplicate_selected()
    if row_count() != before_count + 1 { wrong = wrong + 1 }
    remove_selected()
    if row_count() != before_count { wrong = wrong + 1 }

    cam = g_camera as *Camera
    where = cam.position
    core.camera_set_position(cam, core.vec3(where.x + 500.0, where.y + 500.0, where.z + 500.0))
    focus_selection()
    if core.abs_of(cam.position.x - (where.x + 500.0)) < 0.01 &&
       core.abs_of(cam.position.z - (where.z + 500.0)) < 0.01 { wrong = wrong + 1 }
    core.camera_set_position(cam, where)

    // Each script moves what it is attached to, so a tenth of a second of it
    // has to leave the model somewhere else.
    scripts = 1
    while scripts < g_script_count {
        m = selected_model()
        position = m.position
        rotation = m.rotation
        scale = m.scale
        was_script = script_at(g_selected)

        set_script(g_selected, scripts)
        run_scripts(0.1)
        run_scripts(0.1)
        // Every way a script can move something, not just the two the editor
        // used to know about. A script that scales was reported as doing
        // nothing, because the check was written when the only behaviours were
        // the three this file used to contain.
        still = core.abs_of(m.position.x - position.x) < 0.0001 &&
                core.abs_of(m.position.y - position.y) < 0.0001 &&
                core.abs_of(m.position.z - position.z) < 0.0001 &&
                core.abs_of(m.scale.x - scale.x) < 0.0001 &&
                core.abs_of(m.scale.y - scale.y) < 0.0001 &&
                core.abs_of(m.scale.z - scale.z) < 0.0001 &&
                core.abs_of(m.rotation.x - rotation.x) < 0.000001 &&
                core.abs_of(m.rotation.y - rotation.y) < 0.000001 &&
                core.abs_of(m.rotation.z - rotation.z) < 0.000001 &&
                core.abs_of(m.rotation.w - rotation.w) < 0.000001
        if still { wrong = wrong + 1 }

        set_script(g_selected, was_script)
        core.model_set_position(m, position.x, position.y, position.z)
        core.model_set_scale(m, scale.x, scale.y, scale.z)
        core.model_set_rotation(m, rotation)
        scripts = scripts + 1
    }

    history.history_clear(g_history)
    return wrong
}

// Two objects selected, and an edit reaching both. The property paths have
// always written to everything selected; what was missing was a way to put
// more than one thing in the selection, so nothing had ever checked that the
// second one is written to.
unreached_by_edit() -> int {
    if row_count() < 2 { return 0 }
    was = g_selected

    select_object_adding(0, false)
    select_object_adding(1, true)
    if selection_count() != 2 {
        select_object_adding(was, false)
        return 1
    }

    first = model_at(0)
    second = model_at(1)
    start_first = first.position.y
    start_second = second.position.y

    // A row states a value rather than nudging one, so both objects end up at
    // it: that is what typing 12 into a field with two things selected means,
    // and it is what Unity does with the same gesture.
    apply_property(1, 12.0)

    wrong = 0
    if core.abs_of(first.position.y - 12.0) > 0.01 { wrong = wrong + 1 }
    if core.abs_of(second.position.y - 12.0) > 0.01 { wrong = wrong + 1 }

    core.model_set_position(first, first.position.x, start_first, first.position.z)
    core.model_set_position(second, second.position.x, start_second, second.position.z)
    select_object_adding(was, false)
    history.history_clear(g_history)
    return wrong
}

// Attaching a behaviour used to record nothing, so the next undo stepped back
// through whatever came before it. Each behaviour is set, undone, and the model
// asked whether it carries the one it had.
unundone_scripts() -> int {
    if g_selected < 0 { return 0 }
    was = script_at(g_selected)

    wrong = 0
    kind = 0
    while kind < g_script_count {
        if kind != was {
            set_script(g_selected, kind)
            undo_step()
            if script_at(g_selected) != was { wrong = wrong + 1 }
            set_script(g_selected, was)
            history.history_clear(g_history)
        }
        kind = kind + 1
    }
    return wrong
}

// A drag of the gizmo used to record nothing, so the next undo stepped back
// through whatever came before it and put that back instead. Each mode is
// dragged, undone, and the model asked whether it is where it started.
//
// Two different faults land in the same count, which is why this also records
// how many drags moved nothing at all. A drag that never reaches the model
// leaves the model where it started, and the undo after it steps back through
// whatever came before and moves it away: the count of drags that did not come
// back is then the count of drags that never happened. Told apart, the first
// number says the gizmo did not pick or the drag arithmetic gave nothing, and
// the second says the history did not put it back, which are not the same bug
// and are not in the same file. Asked for on Windows, where the count is three
// and nobody can say which of the two it is (#198).
undone_gizmo_drags() -> int {
    m = selected_model()
    g_silent_drags = 0
    if m == null { return 0 }
    // From an empty history, so an undo can only undo the drag before it:
    // with the scene's own steps under it, a drag that recorded nothing had
    // its undo take back the last thing the scene added, and the check
    // passed with an object gone.
    history.history_clear(g_history)

    wrong = 0
    modes = 0
    while modes < 3 {
        was_mode = g_gizmo_mode
        g_gizmo_mode = modes
        position = m.position
        scale = m.scale
        rotation = m.rotation

        gizmo_begin_drag(0, 40.0, 40.0)
        gizmo_drag(90.0, 60.0, 50.0, 20.0)
        gizmo_drag(140.0, 90.0, 50.0, 30.0)
        g_gizmo_dragging = false
        history.history_close(g_history)

        // Before the undo, so a drag that reached nothing is named as that
        // rather than as an undo that failed. Every component of the rotation,
        // because this drag turns about x: comparing y alone, as the undo check
        // below does, called a rotation that plainly happened no movement at
        // all and reported one silent drag on a machine with none.
        if core.abs_of(m.position.x - position.x) < 0.0001 &&
           core.abs_of(m.position.y - position.y) < 0.0001 &&
           core.abs_of(m.position.z - position.z) < 0.0001 &&
           core.abs_of(m.scale.x - scale.x) < 0.0001 &&
           core.abs_of(m.rotation.x - rotation.x) < 0.000001 &&
           core.abs_of(m.rotation.y - rotation.y) < 0.000001 &&
           core.abs_of(m.rotation.z - rotation.z) < 0.000001 &&
           core.abs_of(m.rotation.w - rotation.w) < 0.000001 {
            g_silent_drags = g_silent_drags + 1
        }

        undo_step()

        if core.abs_of(m.position.x - position.x) > 0.01 ||
           core.abs_of(m.position.y - position.y) > 0.01 ||
           core.abs_of(m.position.z - position.z) > 0.01 { wrong = wrong + 1 }
        if core.abs_of(m.scale.x - scale.x) > 0.01 { wrong = wrong + 1 }
        if core.abs_of(m.rotation.y - rotation.y) > 0.001 ||
           core.abs_of(m.rotation.w - rotation.w) > 0.001 { wrong = wrong + 1 }

        core.model_set_position(m, position.x, position.y, position.z)
        core.model_set_scale(m, scale.x, scale.y, scale.z)
        core.model_set_rotation(m, rotation)
        g_gizmo_mode = was_mode
        modes = modes + 1
    }
    history.history_clear(g_history)
    return wrong
}

rows_that_do_nothing() -> int {
    history.history_begin_replay(g_history)
    was_selected = g_selected
    water_index = index_of_kind(behaviour.KIND_WATER)
    ground_index = index_of_kind(behaviour.KIND_VOXEL)
    body_index = index_of_spec()

    stuck = 0
    index = 0
    while index < ROWS {
        // A row that reads the selected object has to be asked while that kind
        // of object is selected, or it reports nothing either way.
        wants = 0 - 1
        if is_water_row(index) { wants = water_index }
        if is_physics_row(index) { wants = body_index }
        if is_figure_row(index) { wants = index_of_figure() }
        if is_motion_row(index) { wants = index_of_motion() }
        if index == TERRAIN_SEED_ROW { wants = ground_index }
        if wants >= 0 { select_object(wants) }
        if row_control(index) != 0 && !row_reaches_its_target(index) {
            stuck = stuck + 1
        }
        if wants >= 0 { select_object(was_selected) }
        index = index + 1
    }

    history.history_end_replay(g_history)
    return stuck
}

// A row that applies its value but never shows it is a row the user cannot
// read, and stuck_rows cannot see the difference: it drives apply_property
// directly and never looks at the widget. So each field is written through the
// same path the inspector uses and read straight back out of the control.
blind_fields() -> int {
    blind = 0
    index = 0
    while index < ROWS {
        handle = field_handle(index)
        if handle != 0 {
            was = ui.get_text(handle)
            // Compared against what the row would spell, not against a fixed
            // string: a seed writes whole numbers, so one row would report
            // itself unreadable for spelling 12 the way it should.
            show_row(index, 12.25)
            if string.equals(ui.get_text(handle), row_text(index, 12.25)) != 1 {
                blind = blind + 1
            }
            // Back through show_row rather than set_text: a bounded row has a
            // slider that moved too, and putting only the text back leaves the
            // two showing different numbers.
            show_row(index, string.string_get_float(was))
        }
        index = index + 1
    }
    return blind
}

report_state() {
    // Both are read before the row check runs: it drives the inspector, which
    // asks for a repaint, and a frame drawn for the report is not a frame the
    // run was asked for.
    frames = g_frames
    stuck = rows_that_do_nothing()
    blind = blind_fields()
    refresh_swatch()
    styling = mis_styled()
    chip = chip_rgb()
    wanted = material_rgb()
    chip_off = chip_wrong()
    undrag = undone_gizmo_drags()
    idle = actions_that_do_nothing()

    selected = "none"
    m = selected_model()
    if m != null { selected = core.text(m.name) }

    lines = string.concat("backend ", g_backend_name)
    // Which of the two viewports drew this run. A blit where a GPU surface was
    // available is a silent regression to reading the framebuffer back every
    // frame, and it looks identical in a snapshot.
    lines = string.concat(lines, "\nviewport_path ")
    if g_gpu != 0 {
        lines = string.concat(lines, "gpu")
    } else if g_gpu_path {
        lines = string.concat(lines, "gpu-unbuilt")
    } else {
        lines = string.concat(lines, "blit")
    }
    lines = string.concat(lines, "\nmodels ")
    lines = string.concat(lines, string.from_int(row_count()))
    lines = string.concat(lines, "\nassets ")
    lines = string.concat(lines, string.from_int(asset_count()))
    lines = string.concat(lines, "\nselected_count ")
    lines = string.concat(lines, string.from_int(selection_count()))
    lines = string.concat(lines, "\nwater ")
    lines = string.concat(lines, string.from_int(kind_count(behaviour.KIND_WATER)))
    lines = string.concat(lines, "\nvoxels ")
    lines = string.concat(lines, string.from_int(kind_count(behaviour.KIND_VOXEL)))
    lines = string.concat(lines, "\nlights ")
    lines = string.concat(lines, string.from_int(kind_count(behaviour.KIND_LIGHT)))
    lines = string.concat(lines, "\nscripted ")
    lines = string.concat(lines, string.from_int(scripted_count()))
    // The scene's sky image, or "-" for the clear colour: a roundtrip
    // run reads it after the file, where a sky the file does not carry
    // shows up as the dash.
    lines = string.concat(lines, "\nsky ")
    if g_sky_image == "" {
        lines = string.concat(lines, "-")
    } else {
        lines = string.concat(lines, g_sky_image)
    }
    lines = string.concat(lines, "\nbodies ")
    lines = string.concat(lines, string.from_int(spec_count()))
    lines = string.concat(lines, "\nsimulation_stuck ")
    lines = string.concat(lines, string.from_int(simulation_stuck()))
    // The figures, and whether the first plays while simulated: in the
    // roundtrip scene it has been through the file and back.
    lines = string.concat(lines, "\nfigures ")
    lines = string.concat(lines, string.from_int(figure_count()))
    lines = string.concat(lines, "\nfigure_stuck ")
    lines = string.concat(lines, string.from_int(figure_stuck()))
    // Natural motion: the figures with it on, and whether the first stands
    // on its muscles, falls when struck and is put back when stopped.
    lines = string.concat(lines, "\nmotion_figures ")
    lines = string.concat(lines, string.from_int(motion_count()))
    lines = string.concat(lines, "\nmotion_stuck ")
    lines = string.concat(lines, string.from_int(motion_stuck()))
    lines = string.concat(lines, "\ntriangles ")
    lines = string.concat(lines, string.from_int(scene_triangles()))
    lines = string.concat(lines, "\nselected ")
    lines = string.concat(lines, selected)
    lines = string.concat(lines, "\ncanvas ")
    lines = string.concat(lines, string.from_int(g_canvas))
    lines = string.concat(lines, "\nviewport ")
    lines = string.concat(lines, string.from_int(g_view_w))
    lines = string.concat(lines, "x")
    lines = string.concat(lines, string.from_int(g_view_h))
    lines = string.concat(lines, "\nstuck_rows ")
    lines = string.concat(lines, string.from_int(stuck))
    lines = string.concat(lines, "\nblind_fields ")
    lines = string.concat(lines, string.from_int(blind))
    lines = string.concat(lines, "\nmis_styled ")
    lines = string.concat(lines, string.from_int(styling))
    lines = string.concat(lines, "\nchip_wrong ")
    lines = string.concat(lines, string.from_int(chip_off))
    lines = string.concat(lines, "\nchip_rgb ")
    lines = string.concat(lines, string.from_int(chip))
    lines = string.concat(lines, "\nchip_wanted ")
    lines = string.concat(lines, string.from_int(wanted))
    lines = string.concat(lines, "\nunundone_drags ")
    lines = string.concat(lines, string.from_int(undrag))
    lines = string.concat(lines, "\nsilent_drags ")
    lines = string.concat(lines, string.from_int(g_silent_drags))
    lines = string.concat(lines, "\nunreached_by_edit ")
    lines = string.concat(lines, string.from_int(unreached_by_edit()))
    lines = string.concat(lines, "\nunundone_scripts ")
    lines = string.concat(lines, string.from_int(unundone_scripts()))
    // What the renderer says the frame cost, beside what the editor
    // measured around it: a viewport slow in its passes and one slow
    // in the readback look the same from outside.
    lines = string.concat(lines, "\npaint_ms ")
    lines = string.concat(lines, number(g_paint_ms))
    lines = string.concat(lines, "\npasses ")
    lines = string.concat(lines, pass_costs())
    lines = string.concat(lines, "\ndraws ")
    shown = viewport_backend()
    lines = string.concat(lines, string.from_int(core.backend_draw_calls(&shown)))
    lines = string.concat(lines, "\nblit_ms ")
    lines = string.concat(lines, number(g_blit_ms))
    // The rate the run settled at, beside the first one it showed: the
    // first frame after a scene opens carries its upload to the GPU,
    // which is not what the editor runs at.
    lines = string.concat(lines, "\nfps ")
    lines = string.concat(lines, string.from_int((g_fps) as int))
    lines = string.concat(lines, "\nready_ms ")
    lines = string.concat(lines, string.from_int((g_ready_ms) as int))
    lines = string.concat(lines, "\nfirst_fps ")
    lines = string.concat(lines, string.from_int(g_first_fps))
    lines = string.concat(lines, "\nshading_disagrees ")
    lines = string.concat(lines, string.from_int(shading_disagrees()))
    lines = string.concat(lines, "\nunreached_shading ")
    lines = string.concat(lines, string.from_int(unreached_shading()))
    lines = string.concat(lines, "\nidle_actions ")
    lines = string.concat(lines, string.from_int(idle))
    lines = string.concat(lines, "\nframes ")
    lines = string.concat(lines, string.from_int(frames))
    lines = string.concat(lines, "\n")


    // Written to a file rather than printed, so the report survives however the
    // run ends.
    if g_report != "" { fs.write(g_report, lines) }
    string.free(lines)
}

// os.getenv returns null for a variable that is not set, so every read goes
// through core.text: comparing that null against "" is false, which silently
// turned every unset switch on.
env(name: string) -> string {
    return core.text(os.getenv(name))
}

// For a read that is only compared and then thrown away. The value comes back
// on the heap, and env() hands back a literal for an unset one, which must not
// be freed: this keeps the two apart so neither leaks nor is freed twice.
profile_mark(stage: string) {
    if !g_profile { return }
    now = seconds()
    println("editor[profile] ${stage} ${number((now - g_profile_last) * 1000.0)} ms (at ${number((now - g_started) * 1000.0)} ms)")
    g_profile_last = now
}

env_is(name: string, expected: string) -> bool {
    raw = os.getenv(name)
    if raw == null { return string.equals(expected, "") == 1 }
    same = string.equals(raw, expected) == 1
    string.free(raw)
    return same
}

limit_from_env() -> int {
    return core.env_int("AE3D_EDITOR_FRAMES", 0)
}

// One row of the inspector: a label, a slider and a number box. Both write
// straight through to the selected model, so what is on screen and what the
// renderer draws are never two copies of the same number.
// CRITICAL: these must not be called undo and redo. aether-ui exports names of
// its own for stepping the toolkit's command stack, and inside the ui.window
// block a bare call to either bound to those rather than to the editor's, so
// the Undo button stepped an empty stack belonging to the toolkit and did
// nothing whatever. The report's check calls this from the top level, where the
// editor's own definition wins, which is why it passed while the button was
// dead.
// A step, and the rest of its group with it: grouping five objects was
// one edit to the person who did it, and comes back as one.
undo_step() {
    step = history.history_undo(g_history)
    replay(step, true)
    while step != null && history.history_undo_group(g_history, step.group) {
        replay(history.history_undo(g_history), true)
    }
}

redo_step() {
    step = history.history_redo(g_history)
    replay(step, false)
    while step != null && history.history_redo_group(g_history, step.group) {
        replay(history.history_redo(g_history), false)
    }
}

// The history hands a step back; applying it in the right direction is the
// editor's half, because only the editor knows what a slot means.
replay(step: *EditStep, backwards: bool) {
    if step == null {
        say("nothing to undo")
        return
    }

    history.history_begin_replay(g_history)
    if step.kind == history.STEP_PROPERTY {
        target = step.after
        if backwards { target = step.before }
        subject = step.subject as *Model
        if step.slot == SCULPT_SLOT {
            select_model_pointer(step.subject)
            apply_stroke((step.before) as int, backwards)
        } else if step.slot == WEATHER_KIND_SLOT {
            g_weather_kind = (target) as int
            refresh_weather_buttons()
            apply_weather()
            if g_weather_kind == weather.CLEAR { apply_post() }
        } else if step.slot == SKY_IMAGE_SLOT {
            set_scene_sky(sky_image_path((target) as int))
            refresh_sky_buttons()
        } else if step.slot == LIGHT_MODE_SLOT {
            apply_light_mode(step.subject as *Light, (target) as int)
            refresh_light_section()
        } else if is_light_shape_row(step.slot) {
            write_light_shape(step.subject as *Light, step.slot, target)
            relight_weather()
            refresh_light_section()
            paint_soon()
        } else if step.slot == VISIBLE_SLOT || step.slot == SHADOW_SLOT {
            if subject != null {
                apply_object_flag(subject, step.slot, target != 0.0)
                select_model_pointer(step.subject)
                refresh_object_flags()
                mark_dirty()
            }
        } else if step.slot == BODY_KIND_SLOT {
            select_model_pointer(step.subject)
            apply_body_kind(row_object(g_selected), (target) as int)
            refresh_physics_section()
            refresh_parts()
        } else if step.slot == COLLIDER_KIND_SLOT {
            select_model_pointer(step.subject)
            apply_collider_kind(row_object(g_selected), (target) as int)
            refresh_physics_section()
        } else if is_physics_row(step.slot) {
            select_model_pointer(step.subject)
            write_physics(selected_spec(), step.slot, target)
            show_row(step.slot, target)
        } else if is_figure_row(step.slot) {
            select_model_pointer(step.subject)
            write_figure(figure_on(subject), step.slot, target)
            show_row(step.slot, target)
        } else if step.slot == FIGURE_CLIP_SLOT {
            select_model_pointer(step.subject)
            f = figure_on(subject)
            if f != null { apply_clip(f, (target) as int) }
            refresh_figure_section()
        } else if is_motion_row(step.slot) {
            select_model_pointer(step.subject)
            r = figure_row_of(subject)
            if r != null { write_motion(r.motion as *MotionSpec, step.slot, target) }
            show_row(step.slot, target)
        } else if step.slot == MOTION_ON_SLOT {
            select_model_pointer(step.subject)
            r = figure_row_of(subject)
            if r != null { apply_motion_on(r, target != 0.0) }
            refresh_motion_section()
        } else if step.slot == MOTION_MODE_SLOT {
            select_model_pointer(step.subject)
            r = figure_row_of(subject)
            if r != null && r.motion != null { apply_motion_mode(r.motion as *MotionSpec, (target) as int) }
            refresh_motion_section()
        } else if step.slot == MOTION_PROTECT_SLOT {
            select_model_pointer(step.subject)
            r = figure_row_of(subject)
            if r != null && r.motion != null { (r.motion as *MotionSpec).protective = target != 0.0 }
            refresh_motion_section()
        } else if step.slot == FIGURE_LOOP_SLOT {
            select_model_pointer(step.subject)
            f = figure_on(subject)
            if f != null { figure.set_looping(f, target != 0.0) }
            refresh_figure_section()
        } else if step.slot == TERRAIN_STYLE_SLOT {
            select_model_pointer(step.subject)
            regenerate_terrain(terrain_seed(), terrain_biome(), (target) as int)
            refresh_terrain_section()
        } else if step.slot == TERRAIN_BIOME_SLOT {
            select_model_pointer(step.subject)
            regenerate_terrain(terrain_seed(), (target) as int, terrain_style())
            refresh_terrain_section()
        } else if step.slot == SCRIPT_SLOT {
            select_model_pointer(step.subject)
            if g_selected >= 0 { set_script(g_selected, (target) as int) }
        } else if step.slot >= ROTATE_FIRST_SLOT {
            // A turn is undone by turning back through it, so what matters is
            // the angle between the two ends of the step rather than either end.
            turn = step.after - step.before
            if backwards { turn = 0.0 - turn }
            axis = step.slot - ROTATE_FIRST_SLOT
            if subject != null {
                select_model_pointer(step.subject)
                if axis == 0 { core.model_rotate(subject, turn, 0.0, 0.0) }
                if axis == 1 { core.model_rotate(subject, 0.0, turn, 0.0) }
                if axis == 2 { core.model_rotate(subject, 0.0, 0.0, turn) }
                mark_dirty()
                sync_inspector()
            }
        } else if is_water_row(step.slot) {
            // The water rows read whichever object is selected, so replaying one
            // has to name the water it was recorded against rather than take
            // whatever happens to be selected now.
            sim = step.subject as *Simulation
            if sim != null {
                if step.slot == 11 { water.simulation_set_amplitude(sim, target) }
                if step.slot == 12 { water.simulation_set_wave_speed(sim, target) }
                if step.slot == 13 { water.simulation_set_opacity(sim, target) }
                if step.slot == FOAM_ROW { water.simulation_set_foam(sim, true, target) }
                if step.slot == WAVE_SCALE_ROW { water.simulation_set_wave_scale(sim, target) }
                if step.slot == SHORE_FADE_ROW { water.simulation_set_shore(sim, target, water.simulation_shore_foam(sim)) }
                if step.slot == SHORE_FOAM_ROW { water.simulation_set_shore(sim, water.simulation_shore_fade(sim), target) }
                show_row(step.slot, target)
                paint_soon()
            }
        } else if step.slot >= 9 {
            apply_property(step.slot, target)
        } else {
            select_model_pointer(step.subject)
            write_property(subject, step.slot, target)
            show_row(step.slot, target)
            refresh_swatch()
            paint_soon()
        }
    }
    if step.kind == history.STEP_NAME {
        name = step.name_to
        if backwards { name = step.name_from }
        renamed = step.subject as *Model
        at = row_of_model(step.subject)
        if at >= 0 {
            apply_name(renamed, row_object(at), name)
            select_model_pointer(step.subject)
            if g_name_field != 0 { ui.set_text(g_name_field, name) }
        }
    }
    if step.kind == history.STEP_PARENT {
        parent = step.to
        if backwards { parent = step.from }
        reparent_keeping_world(step.subject as *Model, parent as *Model)
        rebuild_rows()
        select_model_pointer(step.subject)
    }
    if (step.kind == history.STEP_ADD && backwards) ||
       (step.kind == history.STEP_REMOVE && !backwards) {
        detach_model(step.subject as *Model)
    }
    if (step.kind == history.STEP_ADD && !backwards) ||
       (step.kind == history.STEP_REMOVE && backwards) {
        attach_model(step.subject as *Model)
    }
    history.history_end_replay(g_history)

    if backwards { say("undo") } else { say("redo") }
}

// The object and everything under it, copied: the copies are parented as
// the originals are, and the root of the copy is set a little aside.
duplicate_selected() {
    m = selected_model()
    if m == null { return }
    members = subtree_of(g_selected)
    originals = list.new()
    copies = list.new()
    i = 0
    while i < list.size(members) {
        at = (list.get_raw(members, i) as int[])[0]
        original = model_at(at)
        copy = core.model_clone(original)
        if copy != null {
            list.add_raw(originals, original as ptr)
            list.add_raw(copies, copy as ptr)
        }
        i = i + 1
    }
    release_index_list(members)
    // The parents among the copies, by the originals' relation.
    i = 0
    while i < list.size(copies) {
        original = list.get_raw(originals, i) as *Model
        parent = core.model_parent(original)
        k = 0
        while k < list.size(originals) {
            if list.get_raw(originals, k) == parent as ptr {
                core.model_set_parent(list.get_raw(copies, i) as *Model, list.get_raw(copies, k) as *Model)
            }
            k = k + 1
        }
        i = i + 1
    }
    if list.size(copies) > 0 {
        root = list.get_raw(copies, 0) as *Model
        core.model_set_position(root, m.position.x + 20.0, m.position.y, m.position.z + 20.0)
    }
    i = 0
    while i < list.size(copies) {
        copy = list.get_raw(copies, i) as *Model
        suffix = ""
        if i == 0 { suffix = " copy" }
        place_model(copy, "${core.text(copy.name)}${suffix}", behaviour.KIND_MESH, null)
        i = i + 1
    }
    list.free(originals)
    list.free(copies)
    rebuild_rows()
    select_object(row_count() - 1)
    say("duplicated")
}

// A model under another parent, staying where it is in the world: its
// local transform is rederived under the new parent.
reparent_keeping_world(m: *Model, parent: *Model) {
    if m == null || m == parent { return }
    core.model_sync_transform(m)
    world_p = m.world_position
    world_q = m.world_rotation
    if !core.model_set_parent(m, parent) { return }
    o = row_object(row_of_model(m as ptr))
    if o == null { return }
    behaviour.object_set_world_position(o, world_p)
    behaviour.object_set_world_rotation(o, world_q)
}

// An empty group: a transform and nothing to draw, at the origin, for
// what is put under it later.
add_group() {
    m = core.model_new()
    add_component_model(m, "group", behaviour.KIND_MESH, null)
}

// The selection under a new group at its centre: the objects stay where
// they are in the world, and the group is the one edit to undo.
group_selection() {
    members = list.new()
    centre = core.vec3(0.0, 0.0, 0.0)
    i = 0
    while i < row_count() {
        if is_selected(i) || i == g_selected {
            m = model_at(i)
            if m != null {
                list.add_raw(members, m as ptr)
                centre = core.v3_add(centre, core.model_world_position(m))
            }
        }
        i = i + 1
    }
    if list.size(members) == 0 {
        list.free(members)
        say("nothing selected to group")
        return
    }
    centre = core.v3_mul(centre, 1.0 / (list.size(members) as float))
    history.history_group_begin(g_history)
    group = core.model_new()
    // Under whatever the first member was under, so grouping inside a
    // group stays inside it.
    first = list.get_raw(members, 0) as *Model
    common = core.model_parent(first)
    place_model(group, "group", behaviour.KIND_MESH, null)
    if common != null { core.model_set_parent(group, common) }
    behaviour.object_set_world_position(row_object(row_of_model(group as ptr)), centre)
    i = 0
    while i < list.size(members) {
        m = list.get_raw(members, i) as *Model
        history.history_record_parent(g_history, m as ptr, core.model_parent(m) as ptr, group as ptr)
        reparent_keeping_world(m, group)
        i = i + 1
    }
    history.history_group_end(g_history)
    count = list.size(members)
    list.free(members)
    rebuild_rows()
    select_object(row_of_model(group as ptr))
    say("grouped ${count}")
}

// The selected group's contents out from under it, where they are in the
// world, and the group gone; one edit.
ungroup_selected() {
    m = selected_model()
    if m == null { return }
    if !is_group(g_selected) || !has_children(g_selected) {
        say("select a group to ungroup")
        return
    }
    above = core.model_parent(m)
    members = subtree_of(g_selected)
    history.history_group_begin(g_history)
    freed = 0
    i = 1
    while i < list.size(members) {
        at = (list.get_raw(members, i) as int[])[0]
        child = model_at(at)
        if child != null && core.model_parent(child) == m {
            history.history_record_parent(g_history, child as ptr, m as ptr, above as ptr)
            reparent_keeping_world(child, above)
            freed = freed + 1
        }
        i = i + 1
    }
    release_index_list(members)
    backend = viewport_backend()
    core.backend_remove_model(&backend, m)
    at = row_of_model(m as ptr)
    detach_at(at)
    history.history_record(g_history, history.STEP_REMOVE, m as ptr, 0, 0.0, 0.0)
    history.history_group_end(g_history)
    g_selected = 0 - 1
    rebuild_rows()
    if row_count() > 0 { select_object(object_of_row(0)) }
    say("ungrouped ${freed}")
}

release_index_list(members: ptr) {
    i = 0
    while i < list.size(members) {
        free(list.get_raw(members, i))
        i = i + 1
    }
    list.free(members)
}

attach_model(m: *Model) {
    if m == null { return }
    if core.mesh_vertex_count(m.mesh) > 0 {
        backend = viewport_backend()
        core.backend_add_model(&backend, m)
    }
    show_figure(m, true)
    if !reattach(m as ptr) {
        add_object(m, core.text(m.name), behaviour.KIND_MESH, null)
    }
    rebuild_rows()
    select_object(row_count() - 1)
}

// Takes the object out of the scene whole and sets it aside, so putting it
// back is possible.
detach_at(index: int) {
    o = row_object(index)
    if o == null { return }
    behaviour.scene_detach(g_scene as *Scene, o)
    list.add_raw(g_detached, o)
}

// Puts back what detach_at set aside. False when the model was never detached,
// which is a model the caller has to give an object of its own.
reattach(m: ptr) -> bool {
    count = list.size(g_detached)
    i = 0
    while i < count {
        o = list.get_raw(g_detached, i) as *GameObject
        if o != null && o.model == m {
            list.remove(g_detached, i)
            behaviour.scene_add(g_scene as *Scene, o)
            return true
        }
        i = i + 1
    }
    return false
}

detach_model(m: *Model) {
    if m == null { return }
    backend = viewport_backend()
    core.backend_remove_model(&backend, m)
    show_figure(m, false)
    i = row_of_model(m as ptr)
    if i < 0 { return }
    detach_at(i)
    rebuild_rows()
    if g_selected >= row_count() { g_selected = row_count() - 1 }
    select_object(g_selected)
}

select_model_pointer(m: ptr) {
    if m == null { return }
    i = row_of_model(m)
    if i >= 0 && g_selected != i { select_object(i) }
}

// CRITICAL: the material rows dereference m.material, and a model is not
// obliged to have one. A voxel terrain is built out of a bare cube and carries
// its colour per instance, so moving the roughness slider with one selected
// read through a null pointer and took the editor down. Every model the
// inspector writes to gets a material first; core makes one with the same
// defaults a loader would.
write_property(m: *Model, index: int, value: float) {
    if is_material_row(index) { core.model_ensure_material(m) }
    if index == 0 { core.model_set_position(m, value, m.position.y, m.position.z) }
    if index == 1 { core.model_set_position(m, m.position.x, value, m.position.z) }
    if index == 2 { core.model_set_position(m, m.position.x, m.position.y, value) }
    if index == 3 { core.model_set_scale(m, value, value, value) }
    if index == 4 { core.model_set_diffuse(m, value, m.material.diffuse.y, m.material.diffuse.z) }
    if index == 5 { core.model_set_diffuse(m, m.material.diffuse.x, value, m.material.diffuse.z) }
    if index == 6 { core.model_set_diffuse(m, m.material.diffuse.x, m.material.diffuse.y, value) }
    if index == 7 { core.model_set_pbr(m, value, m.material.roughness) }
    if index == 8 { core.model_set_pbr(m, m.material.metallic, value) }
    if index == REFLECT_ROW { core.model_set_reflectivity(m, value) }
}

is_material_row(index: int) -> bool {
    return (index >= 4 && index <= 8) || index == REFLECT_ROW
}

property_value(m: *Model, index: int) -> float {
    if is_material_row(index) && m.material == null { return 0.0 }
    if index == 0 { return m.position.x }
    if index == 1 { return m.position.y }
    if index == 2 { return m.position.z }
    if index == 3 { return m.scale.x }
    if index == 4 { return m.material.diffuse.x }
    if index == 5 { return m.material.diffuse.y }
    if index == 6 { return m.material.diffuse.z }
    if index == 7 { return m.material.metallic }
    if index == 8 { return m.material.roughness }
    if index == REFLECT_ROW { return m.material.reflectivity }
    return 0.0
}

water_value(index: int) -> float {
    sim = selected_water()
    if sim == null { return 0.0 }
    if index == 11 { return water.simulation_amplitude(sim) }
    if index == 12 { return sim.wave_speed_multiplier }
    if index == 13 { return sim.opacity }
    if index == FOAM_ROW { return water.simulation_foam_intensity(sim) }
    if index == WAVE_SCALE_ROW { return water.simulation_wave_scale(sim) }
    if index == SHORE_FADE_ROW { return water.simulation_shore_fade(sim) }
    if index == SHORE_FOAM_ROW { return water.simulation_shore_foam(sim) }
    return 0.0
}

// The rows that are the view's rather than a model's: the sky's clouds
// and overcast, the occlusion, the weather and its wind. Read back from
// the editor's own state, which is what they set.
view_value(index: int) -> float {
    if index == FOG_START_ROW { return g_fog_start }
    if index == FOG_END_ROW { return g_fog_end }
    if index == CLOUD_COVER_ROW { return g_cloud_cover }
    if index == OVERCAST_ROW { return g_overcast }
    if index == SSAO_ROW { return g_ssao_intensity }
    if index == SSAO_RADIUS_ROW { return g_ssao_radius }
    if index == WEATHER_ROW { return g_weather_intensity }
    if index == WIND_HEADING_ROW { return g_wind_heading }
    if index == WIND_SPEED_ROW { return g_wind_speed }
    return 0.0
}

is_view_row(index: int) -> bool {
    return index == CLOUD_COVER_ROW || index == OVERCAST_ROW || index == SSAO_ROW || index == SSAO_RADIUS_ROW ||
           index == FOG_START_ROW || index == FOG_END_ROW ||
           index == WEATHER_ROW || index == WIND_HEADING_ROW || index == WIND_SPEED_ROW
}

camera_value(index: int) -> float {
    cam = g_camera as *Camera
    if cam == null { return 0.0 }
    if index == 17 { return cam.fov }
    if index == 18 { return cam.near }
    if index == 19 { return cam.far }
    return 0.0
}

// The water rows are not contiguous: the light colour sits between the wave
// settings and the foam row that follows them. A predicate rather than a range,
// which is what is_light_row and is_camera_row already are.
is_water_row(index: int) -> bool {
    return index == 11 || index == 12 || index == 13 || index == FOAM_ROW ||
           index == WAVE_SCALE_ROW || index == SHORE_FADE_ROW || index == SHORE_FOAM_ROW
}

is_light_row(index: int) -> bool {
    return index == 9 || index == 10 || index == 14 || index == 15 || index == 16
}

is_camera_row(index: int) -> bool {
    return index >= CAMERA_FIRST_ROW && index <= CAMERA_LAST_ROW
}

is_sky_row(index: int) -> bool {
    return index >= SKY_FIRST_ROW && index <= SKY_LAST_ROW
}

sky_value(index: int) -> float {
    if index == SKY_FIRST_ROW { return g_sky_r }
    if index == SKY_FIRST_ROW + 1 { return g_sky_g }
    return g_sky_b
}

// The rows, wherever the sky came from. sync_inspector runs when a selection
// changes, and a load changes the sky after the selection has already been
// made: without this the renderer cleared to the loaded colour while the three
// sliders still showed the one before it.
refresh_sky_rows() {
    show_row(SKY_FIRST_ROW, g_sky_r)
    show_row(SKY_FIRST_ROW + 1, g_sky_g)
    show_row(SKY_LAST_ROW, g_sky_b)
}

// The renderer clears to this, so the sky is what the scene is drawn on rather
// than a colour behind it.
apply_sky_and_fog() {
    apply_sky()
    apply_fog()
}

apply_sky() {
    if g_renderer == null { return }
    backend = viewport_backend()
    core.backend_set_clear_color(&backend, g_sky_r, g_sky_g, g_sky_b)
    mark_dirty()
    paint_soon()
}

// The sun where the hour puts it: the key light takes its direction,
// colour, strength and fill, and the sky is drawn from the same sun. Off,
// the sky is the clear colour again and the light stays where the hour
// last left it, to be edited like any light.
apply_time_of_day() {
    if g_renderer == null { return }
    backend = viewport_backend()
    if g_sun_by_time {
        light = g_light as *Light
        if light != null {
            light.direction = sky.sun_direction(g_time_of_day)
            light.color = sky.sun_color(g_time_of_day)
            light.intensity = sky.sun_intensity(g_time_of_day)
            light.ambient_strength = sky.ambient_strength(g_time_of_day)
            relight_weather()
        }
        // One sky, made once and kept: the renderer draws whatever it was
        // last handed, and the hour reaches the shader through the light.
        if g_sun_sky == null {
            if g_vulkan {
                g_sun_sky = vulkan.skybox_create(g_renderer as *VKRenderer, core.SKY_PROCEDURAL) as ptr
            } else {
                g_sun_sky = gl.skybox_create(g_renderer as *GLRenderer, core.SKY_PROCEDURAL) as ptr
            }
        }
        core.backend_set_skybox(&backend, g_sun_sky)
        refresh_light_rows()
    } else if g_scene_sky != null {
        core.backend_set_skybox(&backend, g_scene_sky)
        // The clear colour still fills what the sky leaves, and the fog
        // takes its colour from it.
        core.backend_set_clear_color(&backend, g_sky_r, g_sky_g, g_sky_b)
    } else {
        core.backend_set_skybox(&backend, null)
        apply_sky()
    }
    mark_dirty()
    paint_soon()
}

// The sky the renderer is no longer holding. A backend frees the sky it was
// last handed with itself; one it has given up is ours to free.
free_sky(s: ptr) {
    if s == null || g_renderer == null { return }
    if g_vulkan {
        vulkan.skybox_free(g_renderer as *VKRenderer, s as *Skybox)
    } else {
        gl.skybox_free(g_renderer as *GLRenderer, s as *Skybox)
    }
}

// The image the scene is drawn under, made on the viewport's renderer; ""
// for the clear colour. False when the image could not be read, and then
// the sky is left as it was.
set_scene_sky(path: string) -> bool {
    if g_renderer == null { return false }
    made = null as ptr
    if path != "" {
        if g_vulkan {
            made = vulkan.skybox_create(g_renderer as *VKRenderer, path) as ptr
        } else {
            made = gl.skybox_create(g_renderer as *GLRenderer, path) as ptr
        }
        if made == null {
            say("the sky image ${path} could not be read")
            return false
        }
    }
    old = g_scene_sky
    g_scene_sky = made
    if g_sky_image != "" { string.free(g_sky_image) }
    if path == "" {
        g_sky_image = ""
    } else {
        g_sky_image = string.copy(path)
    }
    // Whichever sky it is now, the viewport takes it here: the sun's wins
    // while the hour drives it, and the image is what shows otherwise. The
    // old one goes after, once the renderer has let go of it.
    apply_time_of_day()
    free_sky(old)
    refresh_sky_buttons()
    return true
}


// A light's kind as the buttons order them.
light_mode_of(l: *Light) -> int {
    if l == null { return LIGHT_POINT }
    if l.mode == core.MODE_DIRECTIONAL { return LIGHT_SUN }
    if l.mode == core.MODE_SPOT { return LIGHT_SPOT }
    return LIGHT_POINT
}

light_mode_name(mode: int) -> string {
    if mode == LIGHT_SUN { return "sun" }
    if mode == LIGHT_SPOT { return "spot" }
    return "point"
}

// The kind chosen for the light the inspector is showing: one undo step,
// the section repainted. A light that becomes a point or a spot keeps
// its place and colour and takes a reach; the sun keeps neither.
set_light_mode(mode: int) {
    l = active_light()
    if l == null { return }
    was = light_mode_of(l)
    if mode == was { return }
    history.history_record(g_history, history.STEP_PROPERTY, l as ptr, LIGHT_MODE_SLOT,
                           (was) as float, (mode) as float)
    history.history_close(g_history)
    g_last_edit = seconds()
    apply_light_mode(l, mode)
    refresh_light_section()
    say("${light_mode_name(mode)} light")
}

apply_light_mode(l: *Light, mode: int) {
    if mode == LIGHT_SUN {
        l.mode = core.MODE_DIRECTIONAL
    } else {
        // A point or a spot reaches only so far; a light that had no
        // reach (the sun) takes a room's worth.
        if core.light_range(l) <= 0.0 { core.light_set_range(l, 400.0) }
        if mode == LIGHT_SPOT {
            l.mode = core.MODE_SPOT
            // A light that was never a spot has no cone: the field is
            // zero, which is the cosine of ninety degrees -- a spot
            // lighting the whole hemisphere, which is what choosing Spot
            // gave. A cone that is not a cone (zero, a closed one, or an
            // inner angle wider than the outer) takes the default.
            if l.spot_cos_outer <= 0.0 || l.spot_cos_outer >= 1.0 || l.spot_cos_inner < l.spot_cos_outer {
                core.light_set_cone(l, 20.0, 35.0)
            }
        } else {
            l.mode = core.MODE_POINT
        }
    }
    relight_weather()
    mark_dirty()
}

is_light_shape_row(index: int) -> bool {
    return index == LIGHT_RANGE_ROW || index == LIGHT_INNER_ROW || index == LIGHT_OUTER_ROW
}

light_shape_value(index: int) -> float {
    l = active_light()
    if l == null { return 0.0 }
    if index == LIGHT_RANGE_ROW { return core.light_range(l) }
    if index == LIGHT_INNER_ROW { return core.light_inner_degrees(l) }
    return core.light_outer_degrees(l)
}

write_light_shape(l: *Light, index: int, value: float) {
    if l == null { return }
    if index == LIGHT_RANGE_ROW {
        core.light_set_range(l, value)
        return
    }
    inner = core.light_inner_degrees(l)
    outer = core.light_outer_degrees(l)
    if index == LIGHT_INNER_ROW { inner = value } else { outer = value }
    core.light_set_cone(l, inner, outer)
}

// The section as the light has it: its kind lit, its rows on its own
// numbers, and the cone rows only where there is a cone.
refresh_light_section() {
    l = active_light()
    paint_segments(g_light_buttons, LIGHT_MODES, light_mode_of(l))
    show_row(LIGHT_RANGE_ROW, light_shape_value(LIGHT_RANGE_ROW))
    show_row(LIGHT_INNER_ROW, light_shape_value(LIGHT_INNER_ROW))
    show_row(LIGHT_OUTER_ROW, light_shape_value(LIGHT_OUTER_ROW))
    spot = light_mode_of(l) == LIGHT_SPOT
    show_cone_rows(spot)
}

show_cone_rows(on: bool) {
    i = 0
    while i < ROWS {
        if i == LIGHT_INNER_ROW || i == LIGHT_OUTER_ROW {
            control = row_control(i)
            frame = row_frame(i)
            if control != 0 { ui.set_hidden(control, hidden_flag(on)) }
            if frame != 0 { ui.set_hidden(frame, hidden_flag(on)) }
        }
        i = i + 1
    }
}

light_value(index: int) -> float {
    light = active_light()
    if light == null { return 0.0 }
    if index == 9 { return light.intensity }
    if index == 10 { return light.ambient_strength }
    if index == 14 { return light.color.x }
    if index == 15 { return light.color.y }
    if index == 16 { return light.color.z }
    return 0.0
}

apply_property(index: int, value: float) {
    // Every row from nine up used to land here and only nine and ten were
    // written, so the water rows, the light colour and the camera all recorded
    // an undo step, moved their readout and changed nothing at all.
    if is_light_row(index) {
        light = g_light as *Light
        if light != null {
            history.history_record(g_history, history.STEP_PROPERTY, null, index, light_value(index), value)
            g_last_edit = seconds()
            if index == 9 { light.intensity = value }
            if index == 10 { light.ambient_strength = value }
            if index == 14 { light.color = core.vec3(value, light.color.y, light.color.z) }
            if index == 15 { light.color = core.vec3(light.color.x, value, light.color.z) }
            if index == 16 { light.color = core.vec3(light.color.x, light.color.y, value) }
            if index == 9 { relight_weather() }
        }
        show_row(index, value)
        paint_soon()
        return
    }

    if is_light_shape_row(index) {
        l = active_light()
        if l != null {
            history.history_record(g_history, history.STEP_PROPERTY, l as ptr, index,
                                   light_shape_value(index), value)
            g_last_edit = seconds()
            write_light_shape(l, index, value)
            relight_weather()
        }
        show_row(index, light_shape_value(index))
        paint_soon()
        return
    }

    if is_camera_row(index) {
        cam = g_camera as *Camera
        if cam != null {
            history.history_record(g_history, history.STEP_PROPERTY, cam as ptr, index,
                                   camera_value(index), value)
            g_last_edit = seconds()
            if index == 17 { core.camera_set_fov(cam, value) }
            if index == 18 { core.camera_set_near(cam, value) }
            if index == 19 { core.camera_set_far(cam, value) }
            // A camera setter refuses a value that would divide by zero in the
            // projection, so the row shows what the camera kept, not what it
            // was asked for.
            show_row(index, camera_value(index))
            paint_soon()
            return
        }
        show_row(index, value)
        paint_soon()
        return
    }

    if index == TERRAIN_SEED_ROW {
        w = selected_world()
        if w == null { return }
        if value < 0.0 { value = 0.0 }
        if value > SEED_MAX { value = SEED_MAX }
        was = (terrain_seed()) as float
        if core.abs_of(value - was) < 0.5 { return }
        history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr,
                               TERRAIN_SEED_ROW, was, value)
        history.history_close(g_history)
        g_last_edit = seconds()
        regenerate_terrain((value) as long, terrain_biome(), terrain_style())
        show_row(index, value)
        return
    }

    if index == CLOUD_COVER_ROW {
        history.history_record(g_history, history.STEP_PROPERTY, null, index, g_cloud_cover, value)
        g_last_edit = seconds()
        g_cloud_cover = value
        apply_post()
        show_row(index, value)
        return
    }

    if index == OVERCAST_ROW {
        history.history_record(g_history, history.STEP_PROPERTY, null, index, g_overcast, value)
        g_last_edit = seconds()
        g_overcast = value
        apply_post()
        show_row(index, value)
        return
    }

    if index == WEATHER_ROW || index == WIND_HEADING_ROW || index == WIND_SPEED_ROW {
        was = view_value(index)
        history.history_record(g_history, history.STEP_PROPERTY, null, index, was, value)
        g_last_edit = seconds()
        if index == WEATHER_ROW { g_weather_intensity = value }
        if index == WIND_HEADING_ROW { g_wind_heading = value }
        if index == WIND_SPEED_ROW { g_wind_speed = value }
        // The wind alone does not scatter the particles again; the strength
        // does, since it is their count.
        if index == WEATHER_ROW || g_weather == null {
            apply_weather()
        } else {
            heading = core.deg_to_rad(g_wind_heading)
            weather.weather_set_wind(g_weather as *Weather, core.vec3(core.cos_of(heading), 0.0, core.sin_of(heading)), g_wind_speed)
            mark_dirty()
        }
        show_row(index, value)
        return
    }

    if index == BRUSH_ROW {
        history.history_record(g_history, history.STEP_PROPERTY, null, index, g_brush_radius, value)
        g_last_edit = seconds()
        g_brush_radius = value
        show_row(index, value)
        return
    }

    if index == TIME_ROW {
        history.history_record(g_history, history.STEP_PROPERTY, null, index, g_time_of_day, value)
        g_last_edit = seconds()
        g_time_of_day = value
        apply_time_of_day()
        show_row(index, value)
        return
    }

    if index == FOG_START_ROW || index == FOG_END_ROW {
        was = g_fog_start
        if index == FOG_END_ROW { was = g_fog_end }
        history.history_record(g_history, history.STEP_PROPERTY, null, index, was, value)
        g_last_edit = seconds()
        if index == FOG_START_ROW { g_fog_start = value } else { g_fog_end = value }
        apply_fog()
        show_row(index, value)
        return
    }

    if index == SSAO_ROW || index == SSAO_RADIUS_ROW {
        was = g_ssao_intensity
        if index == SSAO_RADIUS_ROW { was = g_ssao_radius }
        history.history_record(g_history, history.STEP_PROPERTY, null, index, was, value)
        g_last_edit = seconds()
        if index == SSAO_ROW { g_ssao_intensity = value } else { g_ssao_radius = value }
        apply_post()
        show_row(index, value)
        return
    }

    if is_sky_row(index) {
        history.history_record(g_history, history.STEP_PROPERTY, null, index,
                               sky_value(index), value)
        g_last_edit = seconds()
        if index == SKY_FIRST_ROW { g_sky_r = value }
        if index == SKY_FIRST_ROW + 1 { g_sky_g = value }
        if index == SKY_LAST_ROW { g_sky_b = value }
        apply_sky_and_fog()
        show_row(index, value)
        return
    }

    if is_motion_row(index) {
        spec = selected_motion()
        if spec != null {
            history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr, index,
                                   motion_value(index), value)
            g_last_edit = seconds()
            write_motion(spec, index, value)
        }
        show_row(index, value)
        return
    }

    if is_figure_row(index) {
        f = selected_figure()
        if f != null {
            history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr, index,
                                   figure_value(index), value)
            g_last_edit = seconds()
            write_figure(f, index, value)
        }
        show_row(index, value)
        return
    }

    if is_physics_row(index) {
        spec = selected_spec()
        if spec != null {
            // Recorded against the model rather than the record: a body taken
            // off and put back is a new record, and the step finds it by the
            // model it is on.
            history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr, index,
                                   physics_value(index), value)
            g_last_edit = seconds()
            write_physics(spec, index, value)
        }
        show_row(index, value)
        return
    }

    if is_water_row(index) {
        sim = selected_water()
        if sim != null {
            history.history_record(g_history, history.STEP_PROPERTY, sim as ptr, index,
                                   water_value(index), value)
            g_last_edit = seconds()
            if index == 11 { water.simulation_set_amplitude(sim, value) }
            if index == 12 { water.simulation_set_wave_speed(sim, value) }
            if index == 13 { water.simulation_set_opacity(sim, value) }
            if index == FOAM_ROW { water.simulation_set_foam(sim, true, value) }
            if index == WAVE_SCALE_ROW { water.simulation_set_wave_scale(sim, value) }
            if index == SHORE_FADE_ROW { water.simulation_set_shore(sim, value, water.simulation_shore_foam(sim)) }
            if index == SHORE_FOAM_ROW { water.simulation_set_shore(sim, water.simulation_shore_fade(sim), value) }
        }
        show_row(index, value)
        paint_soon()
        return
    }

    primary = selected_model()
    if primary == null { return }

    count = row_count()
    i = 0
    while i < count {
        if is_selected(i) {
            target = model_at(i)
            if target != null {
                history.history_record(g_history, history.STEP_PROPERTY, target as ptr,
                                       index, property_value(target, index), value)
                g_last_edit = seconds()
                write_property(target, index, value)
                follow_marker(i, target)
            }
        }
        i = i + 1
    }

    show_row(index, value)
    refresh_swatch()

    paint_soon()
}

// AppKit runs a slider drag in its own tracking mode, where a timer scheduled in
// the default mode does not fire (aether-lang-dev/aether-ui#97), so a property
// change repaints the viewport itself. A drag delivers events faster than a full
// render and readback can answer them, so the repaint is capped rather than run
// once per event.
// The viewport only has to be redrawn when something in it changed. A full
// render, a readback and a blit of the whole framebuffer sixty times a second
// to show an identical picture is the editor's largest idle cost.
mark_dirty() {
    g_dirty = true
}

// Water and attached behaviours move every frame, so a scene holding either is
// never still.
scene_animates() -> bool {
    if g_simulating { return true }
    if g_weather_kind != weather.CLEAR { return true }
    if kind_count(behaviour.KIND_WATER) > 0 { return true }
    return scripted_count() > 0
}

// Marking it dirty is the whole of it. The frame timer draws, including
// during a drag: AppKit runs one in its own tracking mode, and a timer
// scheduled in the default mode did not fire there, so a property change had
// to repaint the viewport itself and cap how often it did
// (aether-lang-dev/aether-ui#97, fixed upstream). Painting from the callback
// as well as from the timer meant a drag drew twice as often as the frame
// rate, and the cap existed to make that bearable rather than because
// anything wanted it.
paint_soon() {
    mark_dirty()
}

// A number typed into a field. Anything that is not a number is ignored
// rather than read as zero, so a half-typed "-" or "1." does not slam the
// value to nothing on the way to being finished.
commit_field(index: int, text: string) {
    if string.string_try_float(text) == 0 { return }
    g_typing_row = index
    apply_property(index, string.string_get_float(text))
    g_typing_row = 0 - 1
}

number_field(parent: int, index: int, initial: float, width: int) -> int {
    handle = ui.textfield(parent, "0.00") callback |text: string| {
        commit_field(index, text)
    }
    ui.add_css_class(handle, "field")
    ui.width(handle, width)
    ui.set_text(handle, number(initial))
    fields = g_fields as int[]
    fields[index] = handle
    if g_probe_field == 0 { g_probe_field = handle }
    return handle
}

// A value with no natural end to it: a position hundreds of units out, a far
// plane in the thousands. A slider over a range like that is a guess about how
// far the user will ever go and a pixel is worth several units, so these get a
// field to type into instead. Unreal, Unity and Godot all draw this control the
// same way, and for the same reason.
field_row(parent: int, name: string, initial: float, index: int) {
    row = ui.hstack(parent, 8)
    as_row(row)
    caption = ui.text(row, name)
    ui.add_css_class(caption, "label")
    ui.spacer(row)
    number_field(row, index, initial, FIELD_W)
    frames = g_row_frames as int[]
    frames[index] = row
}

// Three fields on one line with coloured axis letters, which is how every one
// of the three editors draws a vector: it reads as one property rather than
// three, and it costs a third of the height three labelled rows do.
vector_row(parent: int, name: string, first: int) {
    row = ui.hstack(parent, 4)
    as_row(row)
    caption = ui.text(row, name)
    ui.add_css_class(caption, "label")
    ui.spacer(row)

    x_axis = ui.text(row, "X")
    ui.add_css_class(x_axis, "axis-x")
    ui.width(x_axis, AXIS_W)
    number_field(row, first, 0.0, VECTOR_FIELD_W)

    y_axis = ui.text(row, "Y")
    ui.add_css_class(y_axis, "axis-y")
    ui.width(y_axis, AXIS_W)
    number_field(row, first + 1, 0.0, VECTOR_FIELD_W)

    z_axis = ui.text(row, "Z")
    ui.add_css_class(z_axis, "axis-z")
    ui.width(z_axis, AXIS_W)
    number_field(row, first + 2, 0.0, VECTOR_FIELD_W)
}

// A bounded value, where the whole range is meaningful and dragging across it
// is the point: a colour channel, a roughness, a field of view.
//
// Label, slider and a box on one line, which is how all three of the editors
// this borrows from draw a bounded setting. The box is the half that was
// missing: a slider is a pixel per several hundredths, so there was no way to
// ask for exactly 0.5 metallic, and the number beside it was dead text that
// looked like something to click. Stacking the slider under its own caption
// cost two lines a row and read like a page of preferences rather than an
// inspector: eleven settings filled the panel twice over.
inspector_row(parent: int, name: string, low: float, high: float,
              initial: float, index: int) {
    row = ui.hstack(parent, 8)
    as_row(row)
    caption = ui.text(row, name)
    ui.add_css_class(caption, "label")
    ui.width(caption, LABEL_COLUMN)

    slider = ui.slider(row, low, high, initial) callback |value: float| {
        g_sliding_row = index
        apply_property(index, value)
        g_sliding_row = 0 - 1
    }
    ui.height(slider, 16)
    ui.fill_width(slider)

    number_field(row, index, initial, READOUT_W)

    sliders = g_sliders as int[]
    frames = g_row_frames as int[]
    sliders[index] = slider
    frames[index] = row
}

// One shading feature: a caption and a switch, the same shape as the FXAA and
// bloom rows below them. The engine's shader has carried these since it was
// written and the editor offered no way to reach any of them, so the whole
// advanced half of the renderer was three preset buttons wide.
shading_row(parent: int, name: string, slot: int) {
    row = ui.hstack(parent, 8)
    as_row(row)
    caption = ui.text(row, name)
    ui.add_css_class(caption, "label")
    ui.spacer(row)
    handle = ui.toggle(row, "") callback |on: bool| {
        set_shading(slot, on)
    }
    handles = g_shade_toggles as int[]
    handles[slot] = handle
}

set_shading(slot: int, on: bool) {
    if slot == SHADE_CLEARCOAT { g_shade_clearcoat = on }
    if slot == SHADE_SHEEN { g_shade_sheen = on }
    if slot == SHADE_VOLUMETRIC { g_shade_volumetric = on }
    if slot == SHADE_GI { g_shade_gi = on }
    if slot == SHADE_SHADOWS { g_shade_shadows = on }
    apply_shading()
    say("${shading_name(slot)} ${on}")
}

shading_name(slot: int) -> string {
    if slot == SHADE_CLEARCOAT { return "clearcoat" }
    if slot == SHADE_SHEEN { return "sheen" }
    if slot == SHADE_VOLUMETRIC { return "volumetric light" }
    if slot == SHADE_GI { return "global illumination" }
    return "soft shadows"
}

// The uniform each switch writes, so the self-check can ask a model what it was
// actually told rather than trust that the switch was wired to anything.
shading_uniform(slot: int) -> string {
    if slot == SHADE_CLEARCOAT { return "enableClearcoat" }
    if slot == SHADE_SHEEN { return "enableSheen" }
    if slot == SHADE_VOLUMETRIC { return "enableVolumetricLighting" }
    if slot == SHADE_GI { return "enableGlobalIllumination" }
    return "enableShadows"
}

// Whether the model was told what the switch says. A switch that sets a global
// and reaches no model looks exactly like one that works, because the only
// witness is a frame nobody compares. Each is flipped, the model asked what
// uniform it now carries, and the switch put back.
unreached_shading() -> int {
    m = selected_model()
    if m == null { return 0 }

    wrong = 0
    slot = 0
    while slot < SHADE_KINDS {
        was = shading_state(slot)
        set_shading(slot, !was)
        if model_flag(m, shading_uniform(slot)) == flag_of(was) { wrong = wrong + 1 }
        set_shading(slot, was)
        slot = slot + 1
    }
    return wrong
}

shading_state(slot: int) -> bool {
    if slot == SHADE_CLEARCOAT { return g_shade_clearcoat }
    if slot == SHADE_SHEEN { return g_shade_sheen }
    if slot == SHADE_VOLUMETRIC { return g_shade_volumetric }
    if slot == SHADE_GI { return g_shade_gi }
    return g_shade_shadows
}

flag_of(value: bool) -> int {
    if value { return 1 }
    return 0
}

// What a model currently carries for a named uniform, or -1 if it carries none
// of that name. The renderer reads these off the model, so this is the same
// value the shader will be handed.
model_flag(m: *Model, name: string) -> int {
    count = core.model_uniform_count(m)
    i = 0
    while i < count {
        u = core.model_uniform(m, i)
        if u != null && string.equals(core.text(u.name), name) == 1 { return u.integer }
        i = i + 1
    }
    return 0 - 1
}

theme() -> ptr {
    sheet = ui.create_styles()

    // Neutral dark greys, the palette of Unity's and Blender's dark themes
    // and Unreal's: a grey with a blue cast read as a colour of its own
    // next to the scene, and put a tint on every material chip and swatch
    // beside it. The viewport clears to 0x1C1C1D, so the panels sit a clear
    // step lighter and the chrome around them a step darker: three tones,
    // not one flat grey; the one colour in the chrome is the accent.
    ui.st_bg(sheet, "panel", 0x262626)
    ui.st_border(sheet, "panel", 1.0, 0x363636)
    ui.st_insets(sheet, "panel", 12.0, 14.0, 12.0, 14.0)

    // The stack inside a panel is only as tall as what it holds, so a border on
    // it draws a line across the middle of the column with nothing under it and
    // the panel reads as a card that stopped short of the window. The frame
    // belongs to the scroll view, which is the full height; the stack inside it
    // carries the same ground and the padding, and no edges of its own.
    ui.st_bg(sheet, "panel-body", 0x262626)
    // No horizontal inset. A section bar and a rule reach both edges of the
    // column, which is what makes a panel read as docked chrome rather than a
    // stack of cards, and it is what Unreal, Unity and Godot all draw. The
    // gutter belongs to the rows instead, so anything that needs one says so.
    ui.st_insets(sheet, "panel-body", 12.0, 0.0, 12.0, 0.0)

    ui.st_bg(sheet, "sunken", 0x1B1B1B)
    ui.st_border(sheet, "sunken", 1.0, 0x363636)
    ui.st_insets(sheet, "sunken", 8.0, 14.0, 8.0, 14.0)


    // The gutter down each side of a panel. It is on the rows rather than on
    // the panel's stack, so a section bar and a rule reach both edges of the
    // column while everything inside them still lines up.
    ui.st_insets(sheet, "row", 0.0, 14.0, 0.0, 14.0)

    ui.st_bg(sheet, "bar", 0x1E1E1E)
    ui.st_insets(sheet, "bar", 6.0, 14.0, 6.0, 14.0)

    // The bar a section caption sits on. It spans the column, so the padding
    // that keeps the caption off the edge is a margin on the caption itself.
    ui.st_bg(sheet, "heading", 0x1F1F1F)
    ui.st_insets(sheet, "heading", 3.0, 0.0, 3.0, 0.0)

    // A section's typography without its bar, for a caption sharing a row.
    ui.st_color(sheet, "caption", 0xA6A6A6)
    ui.st_bold(sheet, "caption")
    ui.st_font_size(sheet, "caption", 10.0)

    ui.st_color(sheet, "title", 0xEBEBEB)
    ui.st_bold(sheet, "title")
    ui.st_font_size(sheet, "title", 13.0)

    ui.st_color(sheet, "console", 0xB4B4B4)
    ui.st_font_family(sheet, "console", "Menlo")
    ui.st_font_size(sheet, "console", 11.0)


    ui.st_color(sheet, "label", 0x9C9C9C)
    ui.st_font_size(sheet, "label", 11.0)

    ui.st_color(sheet, "value", 0xE3E3E3)
    ui.st_font_size(sheet, "value", 11.0)

    ui.st_color(sheet, "stats", 0x8C8C8C)
    ui.st_font_size(sheet, "stats", 11.0)

    ui.st_border(sheet, "chip", 1.0, 0x0F0F0F)
    ui.st_radius(sheet, "chip", 3.0)

    // A field is sunk into the panel rather than raised off it, so it reads as
    // something to type into next to a button that reads as something to press.
    ui.st_bg(sheet, "field", 0x171717)
    ui.st_color(sheet, "field", 0xEBEBEB)
    ui.st_border(sheet, "field", 1.0, 0x3F3F3F)
    ui.st_radius(sheet, "field", 4.0)
    ui.st_font_family(sheet, "field", "Menlo")
    ui.st_font_size(sheet, "field", 11.0)
    ui.st_insets(sheet, "field", 4.0, 6.0, 4.0, 6.0)
    ui.st_hover(sheet, "field", 0x1F1F1F)

    // The axis colours every 3D editor uses, so a vector row is read without
    // looking at the letters.
    ui.st_color(sheet, "axis-x", 0xE05252)
    ui.st_color(sheet, "axis-y", 0x77C043)
    ui.st_color(sheet, "axis-z", 0x4A90E2)
    ui.st_bold(sheet, "axis-x")
    ui.st_bold(sheet, "axis-y")
    ui.st_bold(sheet, "axis-z")
    ui.st_font_size(sheet, "axis-x", 10.0)
    ui.st_font_size(sheet, "axis-y", 10.0)
    ui.st_font_size(sheet, "axis-z", 10.0)

    // Buttons carry an edge for the same reason the fields do. A flat fill on
    // a panel one step darker reads as a soft block rather than as something
    // to press, and a panel of them had no lines in it at all.
    ui.st_bg(sheet, "action", 0x333333)
    ui.st_border(sheet, "action", 1.0, 0x454545)
    ui.st_color(sheet, "action", 0xDCDCDC)
    ui.st_radius(sheet, "action", 5.0)
    ui.st_insets(sheet, "action", 4.0, 10.0, 4.0, 10.0)
    ui.st_hover(sheet, "action", 0x3F3F3F)
    ui.st_active(sheet, "action", 0x4B4B4B)

    ui.st_bg(sheet, "danger", 0x3A2628)
    ui.st_border(sheet, "danger", 1.0, 0x5C3A3E)
    ui.st_color(sheet, "danger", 0xE79A9A)
    ui.st_radius(sheet, "danger", 5.0)
    ui.st_insets(sheet, "danger", 4.0, 10.0, 4.0, 10.0)
    ui.st_hover(sheet, "danger", 0x4C2F35)
    ui.st_active(sheet, "danger", 0x5E383F)

    ui.st_bg(sheet, "primary", 0x2F6FEB)
    ui.st_border(sheet, "primary", 1.0, 0x1F55C4)
    ui.st_color(sheet, "primary", 0xFFFFFF)
    ui.st_radius(sheet, "primary", 5.0)
    ui.st_insets(sheet, "primary", 4.0, 12.0, 4.0, 12.0)
    ui.st_hover(sheet, "primary", 0x3D7DF6)

    return sheet
}

// Widget-building helpers take their parent explicitly. The block DSL's context
// is lexical, so a widget created inside a called function is not parented by
// the block the call sits in, and lands at the root instead.
// A section header is a bar across the panel, not a word floating above the
// rows. Without one the panel reads as a single column of everything: the
// headings were the same weight as the labels under them and carried no
// horizontal rule, so nothing said where one group ended and the next began.
// A section header: a bar the width of the column with its caption on the
// gutter. The caption needs a row of its own because a text widget does not
// inset itself, only its children, so a caption placed straight on the bar sits
// against the edge of the window.
// A section: the bar, and a stack under it the bar folds away. Eleven sections
// stacked in one column is more than fits in the window, and a person working
// on a material should not have to scroll past a camera to reach the next one.
// Every editor this borrows from folds its inspector sections, and clicking the
// header is how all three of them do it.
//
// Returns the body, so rows go into the section rather than into the panel.
// CRITICAL: not called section. aether-ui exports a `section` of its own, and
// a bare call inside the ui.window block binds the toolkit's rather than this
// one: the bars rendered, every caret and body was silently something else,
// and tools/check_ui_names.ae is what said so.
fold_section(parent: int, caption: string) -> int {
    // CRITICAL: a section past the end would write off the end of the arrays
    // that hold them. Raise SECTIONS rather than letting one fall off.
    if g_section_count >= SECTIONS { return parent }
    bar = ui.hstack(parent, 0)
    ui.add_css_class(bar, "heading")
    ui.fill_width(bar)

    strip = as_row(ui.hstack(bar, 6))
    slot = g_section_count
    caret = ui.text(strip, OPEN_CARET)
    ui.add_css_class(caret, "caption")
    ui.width(caret, CARET_W)
    label = ui.text(strip, caption)
    ui.add_css_class(label, "caption")

    body = ui.vstack(parent, 6)
    ui.fill_width(body)

    bodies = g_section_bodies as int[]
    carets = g_section_carets as int[]
    bars = g_section_bars as int[]
    open = g_section_open as int[]
    bodies[slot] = body
    carets[slot] = caret
    bars[slot] = bar
    open[slot] = 1
    g_section_count = g_section_count + 1

    ui.on_click(bar) callback { toggle_section(slot) }
    return body
}

// The bar a section's body hangs under, for a section that has to be hidden
// whole rather than folded by hand.
section_bar(slot: int) -> int {
    if g_section_bars == null || slot < 0 || slot >= SECTIONS { return 0 }
    bars = g_section_bars as int[]
    return bars[slot]
}

toggle_section(slot: int) {
    if g_section_bodies == null || slot < 0 || slot >= SECTIONS { return }
    open = g_section_open as int[]
    open[slot] = 1 - open[slot]
    paint_section(slot)
}

paint_section(slot: int) {
    bodies = g_section_bodies as int[]
    carets = g_section_carets as int[]
    open = g_section_open as int[]
    if bodies[slot] != 0 { ui.set_hidden(bodies[slot], 1 - open[slot]) }
    if carets[slot] != 0 {
        mark = SHUT_CARET
        if open[slot] == 1 { mark = OPEN_CARET }
        ui.set_text(carets[slot], mark)
    }
}

// The same caption without the bar, for a heading that shares a row with
// something else. It carries the typography and not the section bar's own
// padding, which sat CONSOLE fourteen pixels right of the lines beneath it.
heading_inline(parent: int, caption: string) -> int {
    handle = ui.text(parent, caption)
    ui.add_css_class(handle, "caption")
    return handle
}

// A strip inside a panel for something that is not already a row of its own.
// The panel's stack does not inset its children any more, so a lone button or
// a caption needs the gutter the rows carry.
panel_row(parent: int) -> int {
    return as_row(ui.hstack(parent, 0))
}

// A panel row: it carries the gutter, and the class the layout audit reads.
as_row(handle: int) -> int {
    ui.add_css_class(handle, "row")
    return handle
}

style_button(handle: int, style: string) {
    ui.height(handle, BUTTON_H)
    ui.add_css_class(handle, style)
    ui.fill_width(handle)
}

// The two axes through the origin, in the colours every 3D editor uses for
// them and the same ones the gizmo already uses: red along x, blue along z.
// A grid of identical lines says how big things are and nothing about where
// they are, so a scene with nothing selected gave no way to tell which way
// round it was.
add_axis(length: float, thickness: float, along_x: bool, r: float, g: float, b: float) {
    axis = loader.cube(1.0)
    if along_x {
        core.model_set_scale(axis, length, 0.4, thickness)
    } else {
        core.model_set_scale(axis, thickness, 0.4, length)
    }
    // Just above the grid, so the two do not fight over the same depth.
    core.model_set_position(axis, 0.0, 0.0 - 0.12, 0.0)
    core.model_matte(axis, r, g, b)
    add_helper(axis)
}

build_scene() {
    grid = loader.grid(600.0, 30.0, 0.7)
    core.model_matte(grid, 0.26, 0.28, 0.32)
    core.model_set_position(grid, 0.0, 0.0 - 0.2, 0.0)
    add_helper(grid)
    g_grid = grid as ptr

    add_axis(1200.0, 1.6, true, 0.62, 0.24, 0.26)
    add_axis(1200.0, 1.6, false, 0.24, 0.36, 0.62)

    cube = loader.cube(1.0)
    core.model_set_scale(cube, 40.0, 40.0, 40.0)
    core.model_set_position(cube, 0.0 - 60.0, 20.0, 0.0)
    core.model_polished_metal(cube, 0.82, 0.45, 0.20)
    add_model(cube, "cube")

    sphere = loader.sphere(1.0, 48, 36)
    core.model_set_scale(sphere, 30.0, 30.0, 30.0)
    core.model_set_position(sphere, 60.0, 30.0, 0.0)
    core.model_glossy(sphere, 0.24, 0.52, 0.88)
    add_model(sphere, "sphere")

    // A bounded run can build the component types too, so the water and voxel
    // paths are exercised rather than only reachable by clicking.
    if env_is("AE3D_EDITOR_SCENE", "components") || env_is("AE3D_EDITOR_SCENE", "roundtrip") {
        add_water()
        add_voxels()
        add_light()
        // Two, and one of them a spot: a scene's lights used to collapse
        // into one on the way back in, and a spot's cone was not written
        // at all.
        add_spot_light()
        set_script(0, script_from_name("spin"))
        // The cube a dynamic body: what the simulation check drops.
        apply_body_kind(row_object(0), BODY_DYNAMIC)
        // An animated figure, playing its first clip: what the figure check
        // plays, and what the roundtrip carries through the file.
        // Without framing either or moving the selection: the checks that
        // drag the gizmo do it where the scene put the camera.
        was_selected = g_selected
        add_figure("tests/fixtures/gltf/arm.glb", "arm")
        // A humanoid figure with natural motion on: what the motion check
        // stands on its muscles, strikes and puts back, and what the
        // roundtrip carries through the file with its motion record.
        humanoid = add_figure("tests/fixtures/gltf/humanoid.glb", "humanoid")
        humanoid_row = figure_row_of(humanoid)
        if humanoid_row != null { apply_motion_on(humanoid_row, true) }
        select_object(was_selected)
    }

    // Save the scene and open it again before the run starts, so the report
    // describes what came BACK rather than what was built. A component the file
    // does not carry shows up here as a count that dropped.
    if env_is("AE3D_EDITOR_SCENE", "roundtrip") {
        // A sky from an image, which is what a program's scene brings and
        // what the file dropped before it carried one.
        set_scene_sky("resources/sky/dusk.png")
        save_scene()
        load_scene()
    }

    // Opened on a scene file: the editor's argument, or AE3D_SCENE. A
    // program's scene (AE3D_SCENE_OUT) opens here with its bodies.
    if string.equals(g_scene_path, DEFAULT_SCENE_PATH) != 1 && fs.file_exists(g_scene_path) == 1 {
        load_scene()
        g_scene_ready = true
        return
    }

    select_object(1)
    g_scene_ready = true
}

// Everything the scene is, not just its models: the simulations behind its
// water, and where the camera stood. A scene that keeps the meshes and loses
// these opens static and framed somewhere else.
current_view() -> View {
    v = scene.view_defaults()
    cam = g_camera as *Camera
    if cam != null {
        v.camera_x = cam.position.x
        v.camera_y = cam.position.y
        v.camera_z = cam.position.z
        v.yaw = cam.yaw
        v.pitch = cam.pitch
        v.fov = cam.fov
        v.near = cam.near
        v.far = cam.far
        v.speed = cam.speed
    }
    v.face_culling = core.face_culling()
    v.frustum_culling = core.frustum_culling()
    // The scene file has carried the post chain since it carried anything, and
    // the editor filled none of it: every scene it saved recorded the defaults,
    // so a scene saved with bloom on came back with it off whatever the file
    // was for.
    v.sky_image = g_sky_image
    v.sky_r = g_sky_r
    v.sky_g = g_sky_g
    v.sky_b = g_sky_b
    v.fxaa = g_fxaa
    v.bloom = g_bloom
    v.bloom_threshold = BLOOM_THRESHOLD
    v.bloom_intensity = BLOOM_INTENSITY
    v.ssr = g_ssr
    v.ssr_road_height = g_ssr_road_height
    v.ssr_strength = g_ssr_strength
    v.fog = g_fog
    v.fog_start = g_fog_start
    v.fog_end = g_fog_end
    v.fog_intensity = g_fog_intensity
    v.fog_r = g_sky_r
    v.fog_g = g_sky_g
    v.fog_b = g_sky_b
    v.clouds = g_clouds
    v.cloud_cover = g_cloud_cover
    v.overcast = g_overcast
    v.weather_kind = g_weather_kind
    v.weather_intensity = g_weather_intensity
    v.wind_heading = g_wind_heading
    v.wind_speed = g_wind_speed
    v.sky_time = 0.0 - 1.0
    if g_sun_by_time { v.sky_time = g_time_of_day }
    v.ssao = g_ssao
    v.ssao_radius = g_ssao_radius
    v.ssao_intensity = g_ssao_intensity
    return v
}

// What is attached to each model being saved: what kind of thing it is, the
// behaviour running on it, and the simulation driving it if it is water.
current_attachments() -> ptr {
    attachments = list.new()
    count = row_count()
    i = 0
    while i < count {
        m = model_at(i)
        c = component_at(i)
        kind = behaviour.KIND_MESH
        sim = null as *Simulation
        world = null as *VoxelWorld
        if c != null {
            kind = c.kind
            if kind == behaviour.KIND_WATER {
                sim = behaviour.component_state(c) as *Simulation
            }
            if kind == behaviour.KIND_VOXEL {
                world = behaviour.component_state(c) as *VoxelWorld
            }
        }
        script = script_name(script_at(i))
        if string.equals(script, "none") == 1 { script = "" }
        spec = spec_at(i)
        fig = figure_on(m)
        if kind != behaviour.KIND_MESH || script != "" || sim != null || world != null || spec != null || fig != null {
            a = scene.attachment_new(m, kind_name(kind), script, sim, world)
            // The light a marker stands for goes with it, so a scene of
            // twenty lamps comes back as twenty lamps.
            if kind == behaviour.KIND_LIGHT {
                beam = behaviour.component_state(c) as *Light
                if beam != null && beam != g_light as *Light { scene.attachment_set_light(a, beam) }
            }
            // A copy: the attachment's record is freed with the list, the
            // object keeps its own.
            if spec != null {
                scene.attachment_set_physics(a, scene.physics_spec_new(spec.body, spec.collider, spec.friction, spec.restitution, spec.density))
            }
            // A figure is its file and its clip; its meshes come from the
            // file when the scene is read.
            if fig != null {
                scene.attachment_set_figure(a, scene.figure_spec_new(figure.path(fig), figure.clip(fig), figure.speed(fig),
                                                                     figure.looping(fig), figure.time(fig)))
                row = figure_row_of(m)
                if row != null && row.motion != null {
                    mot = row.motion as *MotionSpec
                    scene.attachment_set_motion(a, scene.motion_spec_new(mot.mode, mot.strength, mot.protective, mot.get_up))
                }
            }
            list.add_raw(attachments, a as ptr)
        }
        i = i + 1
    }
    return attachments
}

// The directory a scene's own meshes are written to: beside the file,
// named after it, the way a program's AE3D_SCENE_OUT writes them.
mesh_directory_of(path: string) -> string {
    return string.concat(path, "_meshes/")
}

save_scene() {
    lights = list.new()
    if g_light != null { list.add_raw(lights, g_light) }
    attachments = current_attachments()
    view = current_view()
    models = scene_models()
    directory = mesh_directory_of(g_scene_path)
    fs.fs_mkdir_p_raw(directory)
    saved = scene.scene_save(models, lights, attachments, &view, g_scene_path, directory)
    string.free(directory)
    list.free(models)
    scene.attachments_free(attachments)
    list.free(lights)

    if saved {
        say("saved ${g_scene_path}")
    } else {
        say("save failed: ${scene.last_error()}")
    }
}

// Loading replaces the scene rather than merging into it, which is what a
// scene file means, so everything currently in it goes first.
load_scene() {
    profile_mark("before the scene")
    loaded = scene.scene_load(g_scene_path)
    if loaded == null {
        say("load failed: ${scene.last_error()}")
        return
    }
    profile_mark("scene file and its meshes read")

    clear_scene()

    // The lights first: a light marker's row holds the light it stands for, so
    // it has to exist before the models are added. A file written before scenes
    // carried lights has none, and the scene keeps the one it is already using.
    //
    // The first is the scene's key light, the one the sun and the LIGHT rows
    // follow; the rest are lights of the scene in their own right and get a
    // marker each below. They used to be freed on the way in, so a program's
    // scene -- the street's twenty lamps and headlights -- opened lit by one.
    beams = scene.scene_load_lights(g_scene_path)
    spare_beams = list.new()
    if beams != null {
        if list.size(beams) > 0 {
            if g_light != null { core.light_free(g_light as *Light) }
            g_light = list.get_raw(beams, 0)
            if g_engine != null { engine.engine_set_light(g_engine as *Engine, g_light as *Light) }
            refresh_light_rows()
        }
        spare = 1
        while spare < list.size(beams) {
            list.add_raw(spare_beams, list.get_raw(beams, spare))
            spare = spare + 1
        }
        list.free(beams)
    }

    // What was attached to each model, so a surface comes back as the water it
    // is rather than as a plain mesh: a KIND_MESH row has no water section and
    // nothing drives its waves.
    attachments = scene.scene_load_attachments(g_scene_path, loaded)
    profile_mark("lights and attachments read")

    count = list.size(loaded)
    i = 0
    while i < count {
        m = list.get_raw(loaded, i) as *Model
        if m != null {
            a = attachment_on(attachments, m)
            kind = behaviour.KIND_MESH
            state = null as ptr
            if a != null {
                kind = kind_from_name(scene.attachment_component(a))
                sim = scene.attachment_water(a)
                if sim != null { state = sim as ptr }
                world = scene.attachment_world(a)
                if world != null { state = world as ptr }
            }
            // The light marker carries its own light, written with it. A
            // file from before that has none, and the marker stands for the
            // scene's key light as it always did.
            if kind == behaviour.KIND_LIGHT {
                own = null as *Light
                if a != null { own = scene.attachment_light(a) }
                if own != null {
                    state = own as ptr
                    if g_renderer != null {
                        backend = viewport_backend()
                        core.backend_add_light(&backend, own)
                    }
                } else {
                    state = g_light
                }
            }
            place_model(m, core.text(m.name), kind, state)
            if a != null {
                slot = row_slot(row_count() - 1)
                if slot != null { slot[0] = script_from_name(scene.attachment_script(a)) }
                // The body the file records, onto the object: a copy, since
                // the attachments are freed below.
                spec = scene.attachment_physics(a)
                if spec != null {
                    give_spec(row_object(row_count() - 1),
                              scene.physics_spec_new(spec.body, spec.collider, spec.friction, spec.restitution, spec.density))
                }
                // A figure, made again from its file on the group, at its
                // clip, pace and time.
                fig_spec = scene.attachment_figure(a)
                if fig_spec != null {
                    f = make_figure(m, fig_spec.gltf)
                    if f == null {
                        say("could not read the figure ${fig_spec.gltf}")
                    } else if string.equals(fig_spec.clip, "") == 0 {
                        figure.play(f, fig_spec.clip, fig_spec.speed, fig_spec.looping)
                        figure.set_time(f, fig_spec.time)
                    }
                    mot_spec = scene.attachment_motion(a)
                    row = figure_row_of(m)
                    if f != null && mot_spec != null && row != null {
                        row.motion = scene.motion_spec_new(mot_spec.mode, mot_spec.strength, mot_spec.protective, mot_spec.get_up) as ptr
                    }
                }
            }
        }
        i = i + 1
    }
    scene.attachments_free(attachments)
    list.free(loaded)
    profile_mark("models placed")
    if g_profile {
        println("editor[profile]   of which the renderer ${number(g_profile_upload * 1000.0)} ms, objects ${number(g_profile_objects * 1000.0)} ms, shading ${number(g_profile_shading * 1000.0)} ms")
    }

    // A program writes its lights at the root, with no marker for any of
    // them: each gets one here, so the scene is lit the way the program lit
    // it and every lamp is a row that can be picked and moved.
    extra = 0
    while extra < list.size(spare_beams) {
        beam = list.get_raw(spare_beams, extra) as *Light
        place_light(beam, core.text(beam.name))
        extra = extra + 1
    }
    list.free(spare_beams)
    profile_mark("light markers placed")
    // The hierarchy once, for every model, and its first root selected:
    // the tree opens closed.
    rebuild_rows()
    profile_mark("hierarchy rows built")
    if g_visible_count > 0 { select_object(object_of_row(0)) }
    refresh_script_buttons()
    profile_mark("first selection")

    view = scene.scene_load_view(g_scene_path)
    cam = g_camera as *Camera
    if cam != null {
        core.camera_set_position(cam, core.vec3(view.camera_x, view.camera_y, view.camera_z))
        cam.yaw = view.yaw
        cam.pitch = view.pitch
        core.camera_update_vectors(cam)
        core.camera_set_fov(cam, view.fov)
        core.camera_set_near(cam, view.near)
        core.camera_set_far(cam, view.far)
        core.camera_set_speed(cam, view.speed)
        orbit_from_camera(cam)
    }
    core.set_face_culling(view.face_culling)
    core.set_frustum_culling(view.frustum_culling)
    g_sky_r = view.sky_r
    g_sky_g = view.sky_g
    g_sky_b = view.sky_b
    apply_sky()
    refresh_sky_rows()
    g_sun_by_time = view.sky_time >= 0.0
    if g_sun_by_time { g_time_of_day = view.sky_time }
    show_row(TIME_ROW, g_time_of_day)
    if g_sun_by_time_toggle != 0 { ui.set_toggle(g_sun_by_time_toggle, flag_of(g_sun_by_time)) }
    set_scene_sky(view.sky_image)
    apply_time_of_day()
    g_fxaa = view.fxaa
    g_bloom = view.bloom
    g_ssr = view.ssr
    g_ssr_road_height = view.ssr_road_height
    g_ssr_strength = view.ssr_strength
    g_fog = view.fog
    g_fog_start = view.fog_start
    g_fog_end = view.fog_end
    g_fog_intensity = view.fog_intensity
    show_row(FOG_START_ROW, g_fog_start)
    show_row(FOG_END_ROW, g_fog_end)
    if g_fog_toggle != 0 { ui.set_toggle(g_fog_toggle, flag_of(g_fog)) }
    g_clouds = view.clouds
    g_cloud_cover = view.cloud_cover
    show_row(CLOUD_COVER_ROW, g_cloud_cover)
    g_overcast = view.overcast
    show_row(OVERCAST_ROW, g_overcast)
    g_weather_kind = view.weather_kind
    g_weather_intensity = view.weather_intensity
    g_wind_heading = view.wind_heading
    g_wind_speed = view.wind_speed
    show_row(WEATHER_ROW, g_weather_intensity)
    show_row(WIND_HEADING_ROW, g_wind_heading)
    show_row(WIND_SPEED_ROW, g_wind_speed)
    refresh_weather_buttons()
    apply_weather()
    g_ssao = view.ssao
    g_ssao_radius = view.ssao_radius
    g_ssao_intensity = view.ssao_intensity
    show_row(SSAO_ROW, g_ssao_intensity)
    show_row(SSAO_RADIUS_ROW, g_ssao_radius)
    if g_ssao_toggle != 0 { ui.set_toggle(g_ssao_toggle, flag_of(g_ssao)) }
    if g_fxaa_toggle != 0 { ui.set_toggle(g_fxaa_toggle, flag_of(g_fxaa)) }
    if g_bloom_toggle != 0 { ui.set_toggle(g_bloom_toggle, flag_of(g_bloom)) }
    if g_ssr_toggle != 0 { ui.set_toggle(g_ssr_toggle, flag_of(g_ssr)) }
    if g_clouds_toggle != 0 { ui.set_toggle(g_clouds_toggle, flag_of(g_clouds)) }
    apply_post()


    // The file carried each model's uniforms, so the switches say what was
    // loaded rather than what was last set by hand. Without this the panel
    // disagreed with the scene, and the next switch pressed applied the panel's
    // answer to every model and threw the loaded one away.
    read_shading()

    history.history_clear(g_history)
    say("loaded ${count} models from ${g_scene_path}")
    profile_mark("view, sky and settings applied")
}

clear_scene() {
    // The bodies go before the objects they are on, and the figures before
    // the groups they hang from.
    if g_simulating { stop_simulation() }
    clear_figures()
    backend = viewport_backend()
    while row_count() > 0 {
        o = row_object(0)
        m = behaviour.object_model(o)
        if m != null { core.backend_remove_model(&backend, m) }
        behaviour.scene_detach(g_scene as *Scene, o)
        free_object(o)
    }
    // Anything undo was still holding on to goes with the scene it belonged to.
    while list.size(g_detached) > 0 {
        free_object(list.get_raw(g_detached, 0) as *GameObject)
        list.remove(g_detached, 0)
    }
    g_selected = 0 - 1
    rebuild_rows()
}

// A light is a scene object like any other: it gets a marker so it can be
// picked and moved, and a component so the inspector knows what it is. The
// shader takes one light, so the selected one is the one that lights the scene,
// which is the same single-light model gopher3D's renderer has.
add_cube() {
    m = loader.cube(1.0)
    core.model_set_scale(m, 34.0, 34.0, 34.0)
    core.model_set_position(m, 0.0, 20.0, 0.0)
    core.model_matte(m, 0.78, 0.52, 0.32)
    add_model(m, "cube")
}

add_sphere() {
    m = loader.sphere(1.0, 40, 30)
    core.model_set_scale(m, 28.0, 28.0, 28.0)
    core.model_set_position(m, 0.0, 26.0, 0.0)
    core.model_glossy(m, 0.42, 0.68, 0.50)
    add_model(m, "sphere")
}

add_plane() {
    m = loader.plane(20, 24.0)
    core.model_set_position(m, 0.0 - 228.0, 0.0, 0.0 - 228.0)
    core.model_matte(m, 0.40, 0.42, 0.46)
    add_model(m, "plane")
}

add_light() {
    light = core.light_point(core.vec3(0.0, 90.0, 0.0), core.vec3(1.0, 0.92, 0.78), 1.6, 400.0)
    if light == null { return }
    place_light(light, "light")
    rebuild_rows()
    select_object(row_count() - 1)
    say("added light")
}

// A spot light: a point light with a cone, pointed down at the scene.
add_spot_light() {
    light = core.light_spot(core.vec3(0.0, 90.0, 0.0), core.vec3(0.0, 0.0 - 1.0, 0.0),
                            core.vec3(1.0, 0.92, 0.78), 2.0, 400.0, 20.0, 35.0)
    if light == null { return }
    place_light(light, "spot light")
    rebuild_rows()
    select_object(row_count() - 1)
    say("added spot light")
}

selected_light() -> *Light {
    c = component_at(g_selected)
    if c == null || c.kind != behaviour.KIND_LIGHT { return null }
    return behaviour.component_state(c) as *Light
}

// The inspector's light rows follow the selection: a light object if one is
// picked, otherwise the light the scene was built with.
active_light() -> *Light {
    picked = selected_light()
    if picked != null { return picked }
    return g_light as *Light
}

// Water and voxels are engine features the port already carries; the editor
// creates them the way gopher3D's add dialogs do.
add_water() {
    ocean = water.simulation_new(WATER_SIZE, 6.0)
    water.simulation_set_color(ocean, 0.06, 0.22, 0.45)
    water.simulation_set_sky_color(ocean, 0.5, 0.7, 1.0)
    water.simulation_set_opacity(ocean, 0.72)

    surface = water.simulation_build(ocean, 96)
    if surface == null {
        water.simulation_free(ocean)
        say("water surface could not be built")
        return
    }
    core.model_set_position(surface, 0.0, 0.0 - 6.0, 0.0)
    add_component_model(surface, "water", behaviour.KIND_WATER, ocean as ptr)
}


add_voxels() {
    add_terrain()
}

// The terrain shapes live in ae3d.terrain, so the editor asks for a biome
// rather than carrying a copy of one generator inline where the only way to
// check it is to look at it.
// One terrain object. Which shape it has is a property of it, edited in the
// inspector like everything else about an object, rather than five buttons in
// the panel that each add a different thing: the editor's job is to put a
// terrain in the scene, and terrain's job is to know what a plain looks like.
// Unreal and Unity both do it this way, and neither has a Desert button.
add_terrain() {
    world = voxel.world_new(48, 48, 28, VOXEL_SIZE)
    if world == null { return }

    terrain.fill_seeded(world, DEFAULT_SEED, terrain.PLAINS)

    base = loader.cube(VOXEL_SIZE)
    chunk = voxel.world_build(world, base)
    if chunk == null {
        voxel.world_free(world)
        core.model_free(base)
        say("terrain could not be built")
        return
    }
    core.model_set_position(chunk, 0.0 - 96.0, 0.0 - 8.0, 0.0 - 96.0)
    add_component_model(chunk, "terrain", behaviour.KIND_VOXEL, world as ptr)
    say("terrain: ${voxel.world_visible_count(world)} visible of ${voxel.world_active_count(world)}")
}

// The world behind the selected object, or null where it is not a terrain.
selected_world() -> *VoxelWorld {
    c = component_at(g_selected)
    if c == null || c.kind != behaviour.KIND_VOXEL { return null }
    return behaviour.component_state(c) as *VoxelWorld
}

// Fill it again and rebuild the instances on the model that is already there.
// model_enable_instancing resizes and flags both buffers, so the renderer is
// told; replacing the object instead would take the selection with it and
// leave two undo steps behind for one change.
regenerate_terrain(seed: long, biome: int, style: int) {
    w = selected_world()
    m = selected_model()
    if w == null || m == null { return }
    terrain.fill_seeded(w, seed, biome)

    // The renderers decide a model's buffers when it is added, and both halves
    // of this change them: blocks give a model its own vertex array for the
    // instance attributes, smooth gives it a mesh of its own. So the model
    // leaves the backend and comes back, keeping its pointer and with it the
    // selection, the component beside it and its place in the history.
    backend = viewport_backend()
    core.backend_remove_model(&backend, m)

    built = true
    if style == STYLE_SMOOTH {
        core.model_disable_instancing(m)
        if voxel.world_sdf_enable(w) {
            voxel.world_sdf_from_voxels(w)
            surface = voxel.world_build_surface(w)
            if surface == null {
                built = false
            } else {
                // The surface is built as a model; only its mesh is wanted,
                // and a mesh has one owner, so the husk is released without it.
                handed = surface.mesh
                surface.mesh = null
                core.model_free(surface)
                core.model_set_mesh(m, handed)
            }
        } else {
            built = false
        }
    } else {
        if voxel.world_build(w, m) == null { built = false }
    }

    core.backend_add_model(&backend, m)
    if !built {
        say("terrain could not be rebuilt")
        return
    }

    refresh_title()
    refresh_swatch()
    mark_dirty()
    paint_soon()
    say("${terrain.biome_name(biome)} ${style_name(style)}: ${voxel.world_visible_count(w)} visible of ${voxel.world_active_count(w)}")
}

style_name(style: int) -> string {
    if style == STYLE_SMOOTH { return "smooth" }
    return "blocks"
}

// The terrain's model built again from its world, in place: blocks as the
// instances of one cube, smooth as one surface. The model leaves the backend
// and comes back, keeping its pointer and with it the selection, the
// component beside it and its place in the history.
rebuild_terrain_model(w: *VoxelWorld, m: *Model) -> bool {
    backend = viewport_backend()
    core.backend_remove_model(&backend, m)
    built = true
    if !m.is_instanced {
        if voxel.world_sdf_enable(w) {
            voxel.world_sdf_from_voxels(w)
            surface = voxel.world_build_surface(w)
            if surface == null {
                built = false
            } else {
                handed = surface.mesh
                surface.mesh = null
                core.model_free(surface)
                core.model_set_mesh(m, handed)
            }
        } else {
            built = false
        }
    } else {
        if voxel.world_build(w, m) == null { built = false }
    }
    core.backend_add_model(&backend, m)
    refresh_title()
    mark_dirty()
    paint_soon()
    return built
}

set_sculpt(mode: int) {
    g_sculpt = mode
    paint_segments(g_sculpt_buttons, SCULPT_KINDS, g_sculpt)
    if mode == SCULPT_OFF { say("brush off") }
    if mode == SCULPT_RAISE { say("brush raises the ground: press and drag on a terrain") }
    if mode == SCULPT_LOWER { say("brush lowers the ground: press and drag on a terrain") }
    if mode == SCULPT_SMOOTH { say("brush smooths the ground: press and drag on a terrain") }
}

// Where the cursor's ray meets the selected terrain, as a cell of its
// world; false when it misses. A smooth terrain's surface is in the model's
// own frame, so the hit goes back through the model matrix; blocks stand
// where their instances were placed, which is the world's own frame.
sculpt_cell(x: float, y: float) -> bool {
    w = selected_world()
    m = selected_model()
    cam = g_camera as *Camera
    if w == null || m == null || cam == null { return false }
    direction = raycast.screen_direction(cam, x, y, g_canvas_w, g_canvas_h)
    distance = raycast.model_mesh(cam.position, direction, m)
    if !raycast.hit(distance) { return false }
    hit = core.v3_add(cam.position, core.v3_mul(direction, distance))
    if !m.is_instanced {
        inverse = core.mat4_inverse(m.model_matrix)
        local = core.mat4_mul_v4(inverse, core.vec4(hit.x, hit.y, hit.z, 1.0))
        hit = core.vec3(local.x, local.y, local.z)
    }
    size = voxel.world_voxel_size(w)
    g_stroke_cell_x = (hit.x / size) as int
    g_stroke_cell_z = (hit.z / size) as int
    return true
}

// The heights of every column, as one array the stroke keeps.
column_heights(w: *VoxelWorld) -> ptr {
    sx = voxel.world_size_x(w)
    sz = voxel.world_size_z(w)
    heights = calloc(sx * sz, 4)
    if heights == null { return null }
    values = heights as int[]
    x = 0
    while x < sx {
        z = 0
        while z < sz {
            values[x * sz + z] = voxel.world_column_height(w, x, z)
            z = z + 1
        }
        x = x + 1
    }
    return heights
}

sculpt_press(x: float, y: float) -> bool {
    if selected_world() == null {
        say("select a terrain to sculpt")
        return false
    }
    if !sculpt_cell(x, y) { return false }
    w = selected_world()
    g_stroke_before = column_heights(w)
    g_stroke_world = w as ptr
    g_stroke_model = selected_model() as ptr
    g_sculpting = true
    sculpt_apply()
    return true
}

sculpt_move(x: float, y: float) {
    was_x = g_stroke_cell_x
    was_z = g_stroke_cell_z
    if !sculpt_cell(x, y) { return }
    // Once per cell the cursor crosses, not once per pixel: the brush is a
    // rate of change of the ground, and a slow drag is not a deeper one.
    if g_stroke_cell_x == was_x && g_stroke_cell_z == was_z { return }
    sculpt_apply()
}

// The brush at the cell under the cursor: every column within its reach
// moves by the step scaled by how far in it is, up for raise, down for
// lower; smooth pulls each toward the mean of its neighbours. Then the
// terrain is built again.
sculpt_apply() {
    w = g_stroke_world as *VoxelWorld
    m = g_stroke_model as *Model
    if w == null || m == null { return }
    size = voxel.world_voxel_size(w)
    reach = g_brush_radius / size
    if reach < 1.0 { reach = 1.0 }
    span = (reach as int) + 1
    cx = g_stroke_cell_x
    cz = g_stroke_cell_z
    sx = voxel.world_size_x(w)
    sz = voxel.world_size_z(w)
    // Read first, then written, so a smoothing pass reads the ground as it
    // was and not half of it already moved.
    heights = column_heights(w)
    if heights == null { return }
    values = heights as int[]
    x = cx - span
    while x <= cx + span {
        z = cz - span
        while z <= cz + span {
            if x >= 0 && z >= 0 && x < sx && z < sz {
                dx = (x - cx) as float
                dz = (z - cz) as float
                distance = core.sqrt_of(dx * dx + dz * dz)
                if distance <= reach {
                    inside = 1.0 - distance / reach
                    height = values[x * sz + z]
                    target = height
                    if g_sculpt == SCULPT_RAISE {
                        target = height + ((inside * BRUSH_STEP + 0.5) as int)
                    } else if g_sculpt == SCULPT_LOWER {
                        target = height - ((inside * BRUSH_STEP + 0.5) as int)
                    } else if g_sculpt == SCULPT_SMOOTH {
                        sum = 0
                        n = 0
                        nx = x - 1
                        while nx <= x + 1 {
                            nz = z - 1
                            while nz <= z + 1 {
                                if nx >= 0 && nz >= 0 && nx < sx && nz < sz {
                                    sum = sum + values[nx * sz + nz]
                                    n = n + 1
                                }
                                nz = nz + 1
                            }
                            nx = nx + 1
                        }
                        mean = (sum as float) / (n as float)
                        target = ((height as float) + (mean - (height as float)) * inside + 0.5) as int
                    }
                    if target != height { voxel.world_set_column_height(w, x, z, target) }
                }
            }
            z = z + 1
        }
        x = x + 1
    }
    free(heights)
    rebuild_terrain_model(w, m)
}

sculpt_end() {
    g_sculpting = false
    w = g_stroke_world as *VoxelWorld
    m = g_stroke_model as *Model
    if w == null || m == null || g_stroke_before == null { return }
    stroke = heap.new(Stroke)
    stroke.world = w as ptr
    stroke.model = m as ptr
    stroke.before = g_stroke_before
    stroke.after = column_heights(w)
    stroke.columns = voxel.world_size_x(w) * voxel.world_size_z(w)
    g_stroke_before = null
    index = list.size(g_strokes)
    list.add_raw(g_strokes, stroke as ptr)
    history.history_record(g_history, history.STEP_PROPERTY, m as ptr, SCULPT_SLOT,
                           (index) as float, (index) as float)
    history.history_close(g_history)
    changed = 0
    before = stroke.before as int[]
    after = stroke.after as int[]
    i = 0
    while i < stroke.columns {
        if before[i] != after[i] { changed = changed + 1 }
        i = i + 1
    }
    say("sculpted ${changed} columns")
}

// A stroke played back: the terrain's columns put to the heights the stroke
// recorded, before it for undo and after it for redo, and the model rebuilt.
apply_stroke(index: int, backwards: bool) {
    if index < 0 || index >= list.size(g_strokes) { return }
    stroke = list.get_raw(g_strokes, index) as *Stroke
    w = stroke.world as *VoxelWorld
    m = stroke.model as *Model
    if w == null || m == null { return }
    heights = stroke.after
    if backwards { heights = stroke.before }
    values = heights as int[]
    sz = voxel.world_size_z(w)
    i = 0
    while i < stroke.columns {
        voxel.world_set_column_height(w, i / sz, i % sz, values[i])
        i = i + 1
    }
    rebuild_terrain_model(w, m)
    refresh_terrain_section()
}

set_terrain_style(style: int) {
    w = selected_world()
    if w == null || style == terrain_style() { return }
    history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr,
                           TERRAIN_STYLE_SLOT, (terrain_style()) as float, (style) as float)
    history.history_close(g_history)
    regenerate_terrain(terrain_seed(), terrain_biome(), style)
    refresh_terrain_section()
}

terrain_seed() -> long {
    w = selected_world()
    if w == null { return DEFAULT_SEED }
    return voxel.world_origin_seed(w)
}

// Read off the model rather than remembered beside it. Blocks are one cube
// drawn many times and smooth is a single surface, so a terrain's style is
// exactly whether its model is instanced: a fourth list beside the models,
// the components and the scripts would be a fourth thing to keep in step, and
// those three going out of step has already caused one bug.
terrain_style() -> int {
    m = selected_model()
    if m == null || m.is_instanced { return STYLE_BLOCKS }
    return STYLE_SMOOTH
}

terrain_biome() -> int {
    w = selected_world()
    if w == null { return terrain.PLAINS }
    return voxel.world_origin_kind(w)
}

set_terrain_biome(biome: int) {
    w = selected_world()
    if w == null || biome == terrain_biome() { return }
    history.history_record(g_history, history.STEP_PROPERTY, selected_model() as ptr,
                           TERRAIN_BIOME_SLOT, (terrain_biome()) as float, (biome) as float)
    history.history_close(g_history)
    regenerate_terrain(terrain_seed(), biome, terrain_style())
    refresh_terrain_section()
}

refresh_terrain_section() {
    paint_segments(g_style_buttons, STYLE_KINDS, terrain_style())
    paint_segments(g_biome_buttons, terrain.BIOME_COUNT, terrain_biome())
    show_row(TERRAIN_SEED_ROW, (terrain_seed()) as float)
}

// Every mesh the project ships, so a model can be brought into the scene
// without a file dialog. gopher3D calls this its file explorer.
scan_assets() {
    matches, err = fs.glob("resources/obj/*.obj")
    if err != "" || matches == null {
        say("no assets under resources/obj")
        return
    }
    g_assets = matches
    // And the animated figures, after the meshes.
    figures, figures_err = fs.glob("resources/figures/*.glb")
    if figures_err == "" && figures != null { g_figure_assets = figures }

    if g_asset_rows == null { g_asset_rows = list.new() }
    count = asset_count()
    i = 0
    while i < count {
        list.add_raw(g_asset_rows, index_handle(i))
        i = i + 1
    }
    if g_asset_browser != null { ui.listbox_update(g_asset_browser, g_asset_rows) }
}

mesh_asset_count() -> int {
    if g_assets == null { return 0 }
    return fs.dir_list_count(g_assets)
}

figure_asset_count() -> int {
    if g_figure_assets == null { return 0 }
    return fs.dir_list_count(g_figure_assets)
}

asset_count() -> int { return mesh_asset_count() + figure_asset_count() }

// An asset's file: a mesh's, or past them, a figure's.
asset_path(index: int) -> string {
    if index < 0 || index >= asset_count() { return "" }
    if index < mesh_asset_count() { return core.text(fs.dir_list_get(g_assets, index)) }
    return core.text(fs.dir_list_get(g_figure_assets, index - mesh_asset_count()))
}

asset_label(index: int) -> string {
    path = asset_path(index)
    if path == "" { return "" }
    cut = 0
    i = 0
    while i < string.length(path) {
        if string.equals(string.substring(path, i, i + 1), "/") == 1 { cut = i + 1 }
        i = i + 1
    }
    return "  ${string.substring(path, cut, string.length(path))}"
}

load_asset(index: int) {
    path = asset_path(index)
    if path == "" { return }
    if index >= mesh_asset_count() {
        load_figure_asset(path, asset_label(index))
        return
    }

    m = loader.load_obj(path, true)
    if m == null {
        say("could not load ${asset_label(index)}: ${loader.last_error()}")
        return
    }
    core.model_set_position(m, 0.0, 30.0, 0.0)
    add_model(m, asset_label(index))
    focus_selection()
}

// A figure from the browser, framed.
load_figure_asset(path: string, label: string) {
    if add_figure(path, label) != null { focus_selection() }
}

// A figure into the scene: a group at the origin with the figure under it,
// its first clip ready to play. The group, or null when the file cannot be
// read.
add_figure(path: string, label: string) -> *Model {
    group = core.model_new()
    f = make_figure(group, path)
    if f == null {
        core.model_free(group)
        say("could not load ${label}")
        return null
    }
    if figure.clip_count(f) > 0 { figure.play(f, figure.clip_name(f, 0), 1.0, true) }
    add_model(group, string.trim(label))
    return group
}

// The grid and the selection outlines belong to the editor, not the scene: the
// renderer draws them, but they are not listed, picked, saved or undoable.
// The grid, the selection outline and the gizmo are the editor drawing on top
// of the scene, not things in it. They were casting shadows: the gizmo's arrow
// laid a black stripe across the terrain it was pointing at.
add_helper(m: *Model) {
    if m == null { return }
    core.model_set_casts_shadow(m, false)
    backend = viewport_backend()
    core.backend_add_model(&backend, m)
    list.add_raw(g_helpers, m)
}

outline_for(index: int) -> *Model {
    while list.size(g_outlines) <= index {
        outline = loader.box_outline(0.012)
        core.model_matte(outline, 1.0, 0.62, 0.16)
        core.model_set_exposure(outline, 2.0)
        outline.visible = false
        add_helper(outline)
        list.add_raw(g_outlines, outline)
    }
    return list.get_raw(g_outlines, index) as *Model
}

component_of(v: Vec3, axis: int) -> float {
    if axis == 0 { return v.x }
    if axis == 1 { return v.y }
    return v.z
}

gizmo_axis_vector(axis: int) -> Vec3 {
    if axis == 0 { return core.vec3(1.0, 0.0, 0.0) }
    if axis == 1 { return core.vec3(0.0, 1.0, 0.0) }
    return core.vec3(0.0, 0.0, 1.0)
}

// The gizmo keeps the same size on screen however far the camera is, so the
// world length of an axis is a fraction of the distance to the camera.
gizmo_reach() -> float {
    cam = g_camera as *Camera
    m = selected_model()
    if cam == null || m == null { return 0.0 }
    return core.v3_len(core.v3_sub(cam.position, m.position)) * GIZMO_REACH
}

gizmo_project(p: Vec3) -> Vec4 {
    return core.camera_world_to_screen(g_camera as *Camera, p, g_canvas_w, g_canvas_h)
}

// Distance from a point to a segment, the same test for hovering an axis and
// for hovering one span of a rotation ring.
point_to_segment(px: float, py: float, ax: float, ay: float, bx: float, by: float) -> float {
    dx = bx - ax
    dy = by - ay
    length = dx * dx + dy * dy
    if length < 0.000001 { return core.sqrt_of((px - ax) * (px - ax) + (py - ay) * (py - ay)) }
    t = ((px - ax) * dx + (py - ay) * dy) / length
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    cx = ax + t * dx
    cy = ay + t * dy
    return core.sqrt_of((px - cx) * (px - cx) + (py - cy) * (py - cy))
}

axis_color(axis: int, index: int) -> float {
    lit = g_gizmo_axis == axis || (g_gizmo_axis < 0 && g_gizmo_hover == axis)
    dim = 0.16
    if lit { dim = 0.62 }
    if axis == index { return 1.0 }
    return dim
}

// A point on the ring around `axis`, in the plane the axis is normal to.
ring_point(centre: Vec3, axis: int, radius: float, turn: float) -> Vec3 {
    c = core.cos_of(turn) * radius
    s = core.sin_of(turn) * radius
    if axis == 0 { return core.vec3(centre.x, centre.y + c, centre.z + s) }
    if axis == 1 { return core.vec3(centre.x + c, centre.y, centre.z + s) }
    return core.vec3(centre.x + c, centre.y + s, centre.z)
}

draw_ring(centre: Vec3, axis: int, radius: float) {
    ui.canvas_begin_path(g_canvas)
    started = false
    i = 0
    while i <= RING_SEGMENTS {
        turn = (i * 1.0) * core.TWO_PI / (RING_SEGMENTS * 1.0)
        screen = gizmo_project(ring_point(centre, axis, radius, turn))
        if screen.w < 0.0001 {
            started = false
        } else {
            if started {
                ui.canvas_line_to(g_canvas, screen.x, screen.y)
            } else {
                ui.canvas_move_to(g_canvas, screen.x, screen.y)
                started = true
            }
        }
        i = i + 1
    }
    ui.canvas_stroke(g_canvas, axis_color(axis, 0), axis_color(axis, 1), axis_color(axis, 2), 1.0, 2.0)
}

draw_axis(origin: Vec4, centre: Vec3, axis: int, reach: float) {
    tip = gizmo_project(core.v3_add(centre, core.v3_mul(gizmo_axis_vector(axis), reach)))
    if tip.w < 0.0001 { return }

    red = axis_color(axis, 0)
    green = axis_color(axis, 1)
    blue = axis_color(axis, 2)

    ui.canvas_begin_path(g_canvas)
    ui.canvas_move_to(g_canvas, origin.x, origin.y)
    ui.canvas_line_to(g_canvas, tip.x, tip.y)
    ui.canvas_stroke(g_canvas, red, green, blue, 1.0, 2.5)

    dx = tip.x - origin.x
    dy = tip.y - origin.y
    length = core.sqrt_of(dx * dx + dy * dy)
    if length < 0.001 { return }
    ux = dx / length
    uy = dy / length

    if g_gizmo_mode == GIZMO_SCALE {
        half = 5.0
        ui.canvas_fill_rect(g_canvas, tip.x - half, tip.y - half, half * 2.0, half * 2.0,
                            red, green, blue, 1.0)
        return
    }

    // An arrowhead as a filled triangle: the tip, and two points stepped back
    // along the axis and out to either side of it.
    back = 13.0
    wide = 5.0
    ui.canvas_begin_path(g_canvas)
    ui.canvas_move_to(g_canvas, tip.x, tip.y)
    ui.canvas_line_to(g_canvas, tip.x - ux * back - uy * wide, tip.y - uy * back + ux * wide)
    ui.canvas_line_to(g_canvas, tip.x - ux * back + uy * wide, tip.y - uy * back - ux * wide)
    ui.canvas_close_path(g_canvas)
    ui.canvas_fill(g_canvas, red, green, blue, 1.0, 0)
}

draw_gizmo() {
    m = selected_model()
    if m == null { return }
    reach = gizmo_reach()
    if reach <= 0.0 { return }

    origin = gizmo_project(m.position)
    if origin.w < 0.0001 { return }

    if g_gizmo_mode == GIZMO_ROTATE {
        axis = 0
        while axis < 3 {
            draw_ring(m.position, axis, reach)
            axis = axis + 1
        }
    } else {
        axis = 0
        while axis < 3 {
            draw_axis(origin, m.position, axis, reach)
            axis = axis + 1
        }
    }

    ui.canvas_begin_path(g_canvas)
    ui.canvas_arc(g_canvas, origin.x, origin.y, 4.0, 0.0, core.TWO_PI)
    ui.canvas_fill(g_canvas, 0.94, 0.94, 0.96, 1.0, 0)
}

// Which handle is under the pointer, or -1. Rotation rings are tested span by
// span against the same projected points they are drawn from, so the test and
// the picture cannot disagree.
gizmo_pick(x: float, y: float) -> int {
    m = selected_model()
    if m == null { return 0 - 1 }
    reach = gizmo_reach()
    if reach <= 0.0 { return 0 - 1 }

    origin = gizmo_project(m.position)
    if origin.w < 0.0001 { return 0 - 1 }

    best = 0 - 1
    closest = GIZMO_GRAB

    axis = 0
    while axis < 3 {
        if g_gizmo_mode == GIZMO_ROTATE {
            i = 0
            while i < RING_SEGMENTS {
                a = gizmo_project(ring_point(m.position, axis, reach,
                                             (i * 1.0) * core.TWO_PI / (RING_SEGMENTS * 1.0)))
                b = gizmo_project(ring_point(m.position, axis, reach,
                                             ((i + 1) * 1.0) * core.TWO_PI / (RING_SEGMENTS * 1.0)))
                if a.w > 0.0001 && b.w > 0.0001 {
                    away = point_to_segment(x, y, a.x, a.y, b.x, b.y)
                    if away < closest { closest = away ; best = axis }
                }
                i = i + 1
            }
        } else {
            tip = gizmo_project(core.v3_add(m.position, core.v3_mul(gizmo_axis_vector(axis), reach)))
            if tip.w > 0.0001 {
                away = point_to_segment(x, y, origin.x, origin.y, tip.x, tip.y)
                if away < closest { closest = away ; best = axis }
            }
        }
        axis = axis + 1
    }
    return best
}

// Dragging follows the axis as it appears on screen rather than a fixed screen
// direction per axis, so a handle keeps moving the way it points however the
// camera is orbited.
gizmo_begin_drag(axis: int, x: float, y: float) {
    m = selected_model()
    if m == null { return }
    reach = gizmo_reach()
    origin = gizmo_project(m.position)
    tip = gizmo_project(core.v3_add(m.position, core.v3_mul(gizmo_axis_vector(axis), reach)))

    g_gizmo_axis = axis
    g_gizmo_dragging = true
    g_gizmo_angle = core.atan2_of(y - origin.y, x - origin.x)
    // Each drag opens its own step, so the angle it has turned through starts
    // from nothing however many drags came before.
    g_gizmo_turned = 0.0
    history.history_close(g_history)

    dx = tip.x - origin.x
    dy = tip.y - origin.y
    length = core.sqrt_of(dx * dx + dy * dy)
    if length < 1.0 || tip.w < 0.0001 {
        g_gizmo_dir_x = 0.0
        g_gizmo_dir_y = 0.0
        g_gizmo_step = 0.0
        return
    }
    g_gizmo_dir_x = dx / length
    g_gizmo_dir_y = dy / length
    g_gizmo_step = reach / length
}

gizmo_drag(x: float, y: float, dx: float, dy: float) {
    m = selected_model()
    if m == null || g_gizmo_axis < 0 { return }

    if g_gizmo_mode == GIZMO_ROTATE {
        origin = gizmo_project(m.position)
        if origin.w < 0.0001 { return }
        turn = core.atan2_of(y - origin.y, x - origin.x)
        step = core.rad_to_deg(turn - g_gizmo_angle)
        if step > 180.0 { step = step - 360.0 }
        if step < 0.0 - 180.0 { step = step + 360.0 }
        g_gizmo_angle = turn

        history.history_record(g_history, history.STEP_PROPERTY, m as ptr,
                               ROTATE_FIRST_SLOT + g_gizmo_axis,
                               g_gizmo_turned, g_gizmo_turned + step)
        g_last_edit = seconds()
        g_gizmo_turned = g_gizmo_turned + step

        if g_gizmo_axis == 0 { core.model_rotate(m, step, 0.0, 0.0) }
        if g_gizmo_axis == 1 { core.model_rotate(m, 0.0, step, 0.0) }
        if g_gizmo_axis == 2 { core.model_rotate(m, 0.0, 0.0, step) }
        mark_dirty()
        sync_inspector()
        return
    }

    along = (dx * g_gizmo_dir_x + dy * g_gizmo_dir_y) * g_gizmo_step
    if g_gizmo_mode == GIZMO_SCALE {
        factor = 1.0 + along / core.abs_of(gizmo_reach() + 0.0001)
        if factor < 0.02 { factor = 0.02 }
        // The same slot the scale row writes, so one undo step covers a drag of
        // either and the row follows what the handle did.
        history.history_record(g_history, history.STEP_PROPERTY, m as ptr, 3,
                               m.scale.x, m.scale.x * factor)
        g_last_edit = seconds()
        core.model_set_scale(m, m.scale.x * factor, m.scale.y * factor, m.scale.z * factor)
        mark_dirty()
    } else {
        moved = core.v3_add(m.position, core.v3_mul(gizmo_axis_vector(g_gizmo_axis), along))
        history.history_record(g_history, history.STEP_PROPERTY, m as ptr, g_gizmo_axis,
                               property_value(m, g_gizmo_axis),
                               component_of(moved, g_gizmo_axis))
        g_last_edit = seconds()
        core.model_set_position(m, moved.x, moved.y, moved.z)
        mark_dirty()
    }
    sync_inspector()
}

style_mode_button(handle: int) {
    ui.height(handle, 22)
    ui.width(handle, 66)
    ui.add_css_class(handle, "action")
}

// The live mode wears the accent. Set as a colour rather than by adding a
// class: the sheet styles a widget when it is created, and a class added
// afterwards does not repaint it, which left all three buttons looking the
// same whatever the mode was.
paint_mode_button(handle: int, active: bool) {
    if handle == 0 { return }
    if active {
        ui.style_bg_color(handle, 0.184, 0.435, 0.922, 1.0)
    } else {
        ui.style_bg_color(handle, 0.173, 0.192, 0.227, 1.0)
    }
}

refresh_mode_buttons() {
    paint_mode_button(g_mode_move, g_gizmo_mode == GIZMO_TRANSLATE)
    paint_mode_button(g_mode_rotate, g_gizmo_mode == GIZMO_ROTATE)
    paint_mode_button(g_mode_scale, g_gizmo_mode == GIZMO_SCALE)
}

// A row of choices where exactly one is on: light the one that is, the way the
// transform modes over the viewport already do. A row where every button looks
// the same shows what can be chosen and never what was.
paint_segments(store: ptr, count: int, active: int) {
    if store == null { return }
    buttons = store as int[]
    i = 0
    while i < count {
        paint_mode_button(buttons[i], i == active)
        i = i + 1
    }
}

refresh_script_buttons() {
    paint_segments(g_script_buttons, g_script_count, script_at(g_selected))
    refresh_parts()
}

refresh_preset_buttons() {
    paint_segments(g_preset_buttons, PRESET_KINDS, g_preset)
}

set_gizmo_mode(mode: int) {
    mark_dirty()
    g_gizmo_mode = mode
    refresh_mode_buttons()
    if mode == GIZMO_TRANSLATE { say("move: drag an axis") }
    if mode == GIZMO_ROTATE { say("rotate: drag a ring") }
    if mode == GIZMO_SCALE { say("scale: drag a handle") }
}

main() {
    g_started = seconds()
    g_profile_last = g_started
    g_profile = !env_is("AE3D_EDITOR_PROFILE", "")
    g_frame_limit = limit_from_env()
    // Same switch as the engine, same cost when it is not set.
    g_agent_on = agent.start()
    if g_agent_on { g_agent_ctx = agent.context_new() as ptr }

    g_snapshot = env("AE3D_EDITOR_SNAPSHOT")
    g_report = env("AE3D_EDITOR_REPORT")
    g_scene_path = DEFAULT_SCENE_PATH
    if env("AE3D_SCENE") != "" { g_scene_path = env("AE3D_SCENE") }
    if os.args_count() >= 2 { g_scene_path = os.args_get(1) }
    g_scene = behaviour.scene_new() as ptr
    g_rows = list.new()
    g_section_bodies = calloc(SECTIONS, 4)
    g_section_bars = calloc(SECTIONS, 4)
    g_section_carets = calloc(SECTIONS, 4)
    g_section_open = calloc(SECTIONS, 4)
    g_shade_toggles = calloc(SHADE_KINDS, 4)
    g_biome_buttons = calloc(terrain.BIOME_COUNT, 4)
    g_style_buttons = calloc(STYLE_KINDS, 4)
    g_sculpt_buttons = calloc(SCULPT_KINDS, 4)
    g_strokes = list.new()
    g_script_buttons = calloc(MAX_SCRIPTS, 4)
    // Before the panel is built, because the panel is built out of what this
    // finds: a button per script, and none of them known to this file.
    scan_scripts()
    g_preset_buttons = calloc(PRESET_KINDS, 4)
    g_weather_buttons = calloc(WEATHER_KINDS, 4)
    g_sky_buttons = calloc(SKY_IMAGES, 4)
    g_light_buttons = calloc(LIGHT_MODES, 4)
    g_body_buttons = calloc(BODY_KINDS, 4)
    g_collider_buttons = calloc(COLLIDER_KINDS, 4)
    g_sliders = calloc(ROWS, 4)
    g_fields = calloc(ROWS, 4)
    g_row_frames = calloc(ROWS, 4)
    g_detached = list.new()
    g_hier_rows = list.new()
    g_console = calloc(CONSOLE_LINES, 4)
    g_history = history.history_new()
    g_helpers = list.new()
    g_outlines = list.new()

    // Vulkan, as the engine's programs; AE3D_EDITOR_BACKEND=opengl for the
    // other renderer, and OpenGL where there is no Vulkan driver, said so.
    if !env_is("AE3D_EDITOR_BACKEND", "opengl") {
        if vulkan.available() {
            g_vulkan = true
            g_backend_name = "vulkan"
        } else {
            println("editor: no Vulkan driver (${vulkan.last_error()}), staying on OpenGL")
        }
    }

    // Vulkan cannot draw into a GL context, so it keeps the framebuffer of its
    // own and the blit that shows it. Asked before the window because the
    // answer decides how the window is built.
    if !g_vulkan && ui.gpuview_available() == 1 { g_gpu_path = true }

    // The blit path makes its own context, so the renderer can be built now.
    // The GPU path's context arrives with the view, so it is built at realize.
    if !g_gpu_path {
        if !start_renderer() { return }
        profile_mark("renderer started")
        configure_renderer()
    }

    g_camera = core.camera_new(g_view_w, g_view_h) as ptr
    g_light = core.light_sun(core.vec3(0.42, 0.82, 0.38)) as ptr
    start_weather()

    sheet = theme()

    ui.window("ae3d editor", WINDOW_W, WINDOW_H) {
        shell = ui.vstack(0)

        bar = ui.hstack(shell, 12)
        ui.add_css_class(bar, "bar")
        ui.fill_width(bar)
        g_stats = ui.text(bar, g_backend_name)
        ui.add_css_class(g_stats, "stats")
        ui.spacer(bar)

        // Two splitters, the way every editor lays out its panels: the left
        // panel against the rest, and inside the rest the viewport against the
        // inspector, each divider dragged to taste. The panels open at their
        // widths (settle_layout) and cannot be dragged narrower than a floor
        // that keeps their rows legible. Until aether-ui#95 and #136 a panel
        // could be a width or draggable, never both, and the editor had three
        // fixed widths in an hstack.
        body = ui.splitview(shell, "h")
        ui.fill_width(body)
        ui.fill_height(body)
        g_split_outer = body

        // The panels scroll rather than stretch: an inspector that grows a
        // section must not push the viewport past the bottom of the window.
        left_scroll = ui.scrollview(body)
        ui.set_min_width(left_scroll, PANEL_FLOOR)
        ui.fill_height(left_scroll)
        // The panel colour goes on the scroll view as well as the stack inside
        // it. The stack is only as tall as what it holds, and the left panel's
        // contents stop well short of the window, so everything below the last
        // button was the toolkit's own white. Only the scroll view carries the
        // frame, for the same reason.
        ui.add_css_class(left_scroll, "panel")
        left = ui.vstack(left_scroll, 4)
        ui.add_css_class(left, "panel-body")
        scene_body = fold_section(left, "SCENE")

        // The row's position is `at`, not `index`: a closure parameter named
        // index is mangled in the signature and not in the body by the
        // current compiler (aether#2087), and on Linux the body then reads
        // libc's index().
        // Typing here narrows the tree to the objects whose names have the
        // text, the way every editor's outliner searches.
        g_filter_field = ui.textfield(scene_body, "filter") callback |text: string| {
            set_filter(text)
        }
        ui.add_css_class(g_filter_field, "field")
        ui.fill_width(g_filter_field)

        // A row is an object of the tree, indented by its depth, with a
        // disclosure for a parent; the object is the row's, carried in the
        // item, never the row's position in the scene.
        g_hierarchy = ui.listbox(scene_body, 4) callback |item: ptr, at: int, row: int| {
            shown = (item as int[])[0]
            row_line = as_row(ui.hstack(row, 2))
            depth = 0
            if g_filter == "" { depth = depth_of(shown) }
            if g_filter == "" && has_children(shown) {
                glyph = SHUT_CARET
                if is_expanded(shown) { glyph = OPEN_CARET }
                caret = ui.btn(row_line, glyph) callback { toggle_expanded(shown) }
                ui.style_flat(caret)
                ui.width(caret, CARET_W + 6)
                if depth > 0 { ui.margin_of(caret, 0, 0, 0, 14 * depth) }
            } else {
                blank = ui.text(row_line, " ")
                ui.width(blank, CARET_W + 6)
                if depth > 0 { ui.margin_of(blank, 0, 0, 0, 14 * depth) }
            }
            entry = ui.text(row_line, row_label(shown))
            ui.add_css_class(entry, "value")
            list.add_raw(g_hier_rows, index_handle(row))
        }
        ui.on_select(g_hierarchy) callback |at: int| {
            // A rebuild of the rows (a filter typed, a group opened) reports
            // no row selected; the selection is the editor's, not the list's.
            if at >= 0 { select_object(object_of_row(at)) }
        }

        ui.divider(left)
        add_body = fold_section(left, "ADD")

        // Two to a row, grouped by what they make. Ten buttons each taking the
        // full width of the panel is a column of identical bars you have to
        // read top to bottom to find anything in; a grid is scanned, and the
        // grouping is what tells you a biome is not a primitive.
        primitives = ui.hstack(add_body, 6)
        as_row(primitives)
        cube_btn = ui.btn(primitives, "Cube") callback { add_cube() }
        style_button(cube_btn, "action")
        sphere_btn = ui.btn(primitives, "Sphere") callback { add_sphere() }
        style_button(sphere_btn, "action")

        surfaces = ui.hstack(add_body, 6)
        as_row(surfaces)
        plane_btn = ui.btn(surfaces, "Plane") callback { add_plane() }
        style_button(plane_btn, "action")
        water_btn = ui.btn(surfaces, "Water") callback { add_water() }
        style_button(water_btn, "action")

        // The odd one out of a pair spans the row rather than sitting at its
        // own width beside a spacer, which left it a third the size of the
        // buttons above it and made the grid look unfinished.
        light_btn = ui.btn(panel_row(add_body), "Light") callback { add_light() }
        style_button(light_btn, "action")
        spot_light_btn = ui.btn(panel_row(add_body), "Spot light") callback { add_spot_light() }
        style_button(spot_light_btn, "action")

        // One terrain, not five biomes. What shape it takes is a property of
        // the object, edited in the inspector; five buttons in the panel made
        // the editor responsible for knowing what a desert is.
        terrain_btn = ui.btn(panel_row(add_body), "Terrain") callback { add_terrain() }
        style_button(terrain_btn, "action")

        // A group: nothing to draw, a place to put things under.
        group_add_btn = ui.btn(panel_row(add_body), "Group") callback { add_group() }
        style_button(group_add_btn, "action")

        ui.divider(left)
        assets_body = fold_section(left, "ASSETS")
        g_asset_browser = ui.listbox(assets_body, 4) callback |item: ptr, at: int, row: int| {
            entry = ui.text(as_row(ui.hstack(row, 0)), asset_label(at))
            ui.add_css_class(entry, "value")
        }
        ui.on_select(g_asset_browser) callback |at: int| {
            load_asset(at)
        }

        ui.divider(left)
        edit_body = fold_section(left, "EDIT")

        undo_row = ui.hstack(edit_body, 6)
        as_row(undo_row)
        undo_btn = ui.btn(undo_row, "Undo") callback { undo_step() }
        style_button(undo_btn, "action")
        redo_btn = ui.btn(undo_row, "Redo") callback { redo_step() }
        style_button(redo_btn, "action")

        object_row = ui.hstack(edit_body, 6)
        as_row(object_row)
        duplicate_btn = ui.btn(object_row, "Duplicate") callback { duplicate_selected() }
        style_button(duplicate_btn, "action")
        delete_btn = ui.btn(object_row, "Delete") callback { remove_selected() }
        style_button(delete_btn, "danger")
        g_probe_danger = delete_btn
        g_probe_action = duplicate_btn

        group_row = ui.hstack(edit_body, 6)
        as_row(group_row)
        group_btn = ui.btn(group_row, "Group selection") callback { group_selection() }
        style_button(group_btn, "action")
        ungroup_btn = ui.btn(group_row, "Ungroup") callback { ungroup_selected() }
        style_button(ungroup_btn, "action")

        frame_btn = ui.btn(panel_row(edit_body), "Frame selection") callback { focus_selection() }
        style_button(frame_btn, "action")

        scene_row = ui.hstack(edit_body, 6)
        as_row(scene_row)
        save_btn = ui.btn(scene_row, "Save") callback { save_scene() }
        style_button(save_btn, "primary")
        g_probe_primary = save_btn
        load_btn = ui.btn(scene_row, "Load") callback { load_scene() }
        style_button(load_btn, "action")
        // The scene's bodies run, and stopped, put back: the same button.
        g_simulate_btn = ui.btn(panel_row(edit_body), "Simulate") callback { toggle_simulation() }
        style_button(g_simulate_btn, "action")
        ui.spacer(left)

        // The rest of the window: the viewport, and the inspector beside it.
        inner = ui.splitview(body, "h")
        ui.fill_width(inner)
        ui.fill_height(inner)
        g_split_inner = inner
        stage = ui.vstack(inner, 0)
        ui.fill_height(stage)

        // A strip over the viewport carrying the transform modes, the way
        // every editor this borrows from does. The keys still work; this is
        // what makes the live one visible.
        viewport_bar = ui.hstack(stage, 6)
        ui.add_css_class(viewport_bar, "bar")
        ui.fill_width(viewport_bar)
        g_mode_move = ui.btn(viewport_bar, "Move") callback { set_gizmo_mode(GIZMO_TRANSLATE) }
        style_mode_button(g_mode_move)
        g_mode_rotate = ui.btn(viewport_bar, "Rotate") callback { set_gizmo_mode(GIZMO_ROTATE) }
        style_mode_button(g_mode_rotate)
        g_mode_scale = ui.btn(viewport_bar, "Scale") callback { set_gizmo_mode(GIZMO_SCALE) }
        style_mode_button(g_mode_scale)
        ui.spacer(viewport_bar)
        g_mode_hint = ui.text(viewport_bar, "W move   E rotate   R scale   F frame")
        ui.add_css_class(g_mode_hint, "stats")

        // Two layers where there is a GPU to draw on: the scene underneath,
        // drawn by aether-ui's own context, and the canvas over it carrying the
        // gizmo. The canvas keeps every event it ever had, so orbiting,
        // picking and dragging are unchanged; what it no longer carries is a
        // copy of the scene read back off the GPU every frame.
        viewport_host = stage
        if g_gpu_path {
            layers = ui.zstack(stage)
            ui.fill_width(layers)
            ui.fill_height(layers)
            viewport_host = layers

            g_gpu = ui.gpuview_create(layers, VIEW_FLOOR_W, g_view_h)
            gpu_view = ui.gpuview_widget(g_gpu)
            g_gpu_widget = gpu_view
            ui.fill_width(gpu_view)
            ui.fill_height(gpu_view)

            // The context is current here and nowhere earlier, so this is
            // where the renderer is built and the scene it holds is filled.
            ui.gpuview_on_realize(g_gpu) callback {
                if start_renderer() {
                    configure_renderer()
                    start_weather()
                    build_scene()
                    scan_assets()
                    apply_orbit()
                }
            }
            ui.gpuview_on_render(g_gpu) callback |_dt: float| {
                render_viewport()
            }
            // PIXELS, not points, which is what the renderer wants and what
            // makes this path sharper than the blit it replaces.
            ui.gpuview_on_resize(g_gpu) callback |w: int, h: int| {
                resize_viewport(w, h)
            }
        }

        g_canvas = ui.canvas_create(viewport_host, VIEW_FLOOR_W, g_view_h)
        ui.fill_width(ui.canvas_widget(g_canvas))
        ui.fill_height(ui.canvas_widget(g_canvas))
        // Only on the blit path. Over a GPU view this would paint the scene
        // out, and the clear colour the renderer was given is the same one.
        if g_gpu == 0 {
            ui.canvas_fill_rect(g_canvas, 0.0, 0.0, g_view_w * 1.0, g_view_h * 1.0,
                                VIEWPORT_R, VIEWPORT_G, VIEWPORT_B, 1.0)
            ui.canvas_redraw(g_canvas)
        }

        ui.canvas_on_resize(g_canvas) callback |w: float, h: float| {
            resize_canvas(w as int, h as int)
        }
        // A press that never moves is a selection; a press that moves is an
        // orbit. Doing both makes the view lurch every time something is picked.
        ui.canvas_on_click(g_canvas) callback |x: float, y: float| {
            handle = gizmo_pick(x, y)
            if handle >= 0 {
                gizmo_begin_drag(handle, x, y)
                g_last_x = x
                g_last_y = y
                return
            }
            if g_sculpt != SCULPT_OFF && sculpt_press(x, y) { return }
            g_pressed = true
            g_moved = false
            g_press_x = x
            g_press_y = y
            g_last_x = x
            g_last_y = y
        }
        ui.canvas_on_move(g_canvas) callback |x: float, y: float| {
            if g_gizmo_dragging {
                gizmo_drag(x, y, x - g_last_x, y - g_last_y)
                g_last_x = x
                g_last_y = y
                return
            }
            if g_sculpting {
                sculpt_move(x, y)
                return
            }
            hovered = gizmo_pick(x, y)
            if hovered != g_gizmo_hover { mark_dirty() }
            g_gizmo_hover = hovered
            if g_pressed {
                if core.abs_of(x - g_press_x) > DRAG_SLOP ||
                   core.abs_of(y - g_press_y) > DRAG_SLOP {
                    g_moved = true
                }
                if g_moved {
                    g_orbit_yaw = g_orbit_yaw + (x - g_last_x) * ORBIT_SPEED
                    g_orbit_pitch = g_orbit_pitch - (y - g_last_y) * ORBIT_SPEED
                    apply_orbit()
                }
                g_last_x = x
                g_last_y = y
            }
        }
        ui.canvas_on_release(g_canvas) callback |x: float, y: float| {
            if g_gizmo_dragging {
                g_gizmo_dragging = false
                g_gizmo_axis = 0 - 1
                return
            }
            if g_sculpting {
                sculpt_end()
                return
            }
            if g_pressed && !g_moved { pick_at(x, y) }
            g_pressed = false
            g_moved = false
        }
        // W, E and R are what every engine editor binds these to.
        ui.canvas_on_key(g_canvas) callback |key: string| {
            if string.equals(key, "w") == 1 { set_gizmo_mode(GIZMO_TRANSLATE) }
            if string.equals(key, "e") == 1 { set_gizmo_mode(GIZMO_ROTATE) }
            if string.equals(key, "r") == 1 { set_gizmo_mode(GIZMO_SCALE) }
            if string.equals(key, "f") == 1 { focus_selection() }
            if string.equals(key, "Delete") == 1 { remove_selected() }
            if string.equals(key, "BackSpace") == 1 { remove_selected() }
            if string.equals(key, "z") == 1 { undo_step() }
            if string.equals(key, "Z") == 1 { redo_step() }
            if string.equals(key, "d") == 1 { duplicate_selected() }
        }
        ui.canvas_on_scroll(g_canvas) callback |dx: float, dy: float| {
            if dy > 0.0 {
                g_orbit_distance = g_orbit_distance / ZOOM_STEP
            } else {
                g_orbit_distance = g_orbit_distance * ZOOM_STEP
            }
            apply_orbit()
        }

        console_panel = ui.vstack(stage, 2)
        ui.add_css_class(console_panel, "sunken")
        ui.fill_width(console_panel)

        // No row inset here: the console panel already carries one, and two of
        // them sat the caption fourteen pixels right of the lines below it.
        console_bar = ui.hstack(console_panel, 8)
        heading_inline(console_bar, "CONSOLE")
        ui.spacer(console_bar)
        clear_btn = ui.btn(console_bar, "Clear") callback { clear_console() }
        style_button(clear_btn, "action")
        ui.width(clear_btn, 64)

        handles = g_console as int[]
        line = 0
        while line < CONSOLE_LINES {
            entry = ui.text(console_panel, "")
            ui.add_css_class(entry, "console")
            // Cut at the pane's edge rather than widening it. On GTK a
            // label's least width is its whole text, so a long line (a
            // path the editor saved to) held the viewport's side of the
            // splitter at its width and the divider could not move.
            ui.text_truncate(entry, "tail")
            handles[line] = entry
            line = line + 1
        }

        footer = ui.hstack(stage, 8)
        ui.add_css_class(footer, "bar")
        ui.fill_width(footer)
        g_status = ui.text(footer, "drag to orbit, scroll to zoom, click to select")
        ui.add_css_class(g_status, "label")
        ui.text_truncate(g_status, "tail")
        ui.spacer(footer)

        right_scroll = ui.scrollview(inner)
        ui.set_min_width(right_scroll, PANEL_FLOOR)
        ui.fill_height(right_scroll)
        ui.add_css_class(right_scroll, "panel")
        right = ui.vstack(right_scroll, 6)
        ui.add_css_class(right, "panel-body")
        inspector_body = fold_section(right, "INSPECTOR")
        g_title = ui.text(panel_row(inspector_body), "nothing selected")
        ui.add_css_class(g_title, "value")
        g_name_field = ui.textfield(inspector_body, "name") callback |text: string| {
            rename_selected(text)
        }
        ui.add_css_class(g_name_field, "field")
        ui.fill_width(g_name_field)
        g_parts = ui.text(panel_row(inspector_body), "")
        ui.add_css_class(g_parts, "caption")
        ui.divider(right)

        transform_body = fold_section(right, "TRANSFORM")
        vector_row(transform_body, "position", 0)
        field_row(transform_body, "scale", 30.0, 3)
        g_visible_toggle = switch_row(transform_body, "Visible") callback |on: bool| { set_object_flag(VISIBLE_SLOT, on) }
        g_shadow_toggle = switch_row(transform_body, "Casts shadow") callback |on: bool| { set_object_flag(SHADOW_SLOT, on) }

        ui.divider(right)
        material_body = fold_section(right, "MATERIAL")

        swatch_row = ui.hstack(material_body, 8)
        as_row(swatch_row)
        swatch_caption = ui.text(swatch_row, "colour")
        ui.add_css_class(swatch_caption, "label")
        ui.spacer(swatch_row)
        // A stack, not a label. A label's layer background is set and not
        // painted: the readback reports the colour while the panel shows
        // through, so the chip was an empty outline.
        g_chip = ui.text(swatch_row, "")
        ui.add_css_class(g_chip, "chip")
        ui.width(g_chip, 30)
        ui.height(g_chip, 14)
        // The hex is a field: a colour copied from anywhere else is typed or
        // pasted in whole.
        g_swatch = ui.textfield(swatch_row, "#RRGGBB") callback |text: string| {
            hex_typed(text)
        }
        ui.add_css_class(g_swatch, "field")
        // Wider than a number's column: a hex colour is seven characters and
        // the value column is sized for four, so it came out cut off.
        ui.width(g_swatch, HEX_COLUMN)

        g_picker = ui.canvas_create(material_body, PICKER_W, PICKER_H)
        picker_widget = ui.canvas_widget(g_picker)
        ui.canvas_size(g_picker, PICKER_W, PICKER_H)
        ui.fill_width(picker_widget)
        ui.canvas_on_resize(g_picker) callback |w: float, h: float| {
            resize_picker((w) as int)
        }
        ui.canvas_on_click(g_picker) callback |x: float, y: float| {
            picker_press(x, y)
        }
        ui.canvas_on_move(g_picker) callback |x: float, y: float| {
            picker_move(x, y)
        }
        ui.canvas_on_release(g_picker) callback |x: float, y: float| {
            picker_release(x, y)
        }
        paint_picker()

        inspector_row(material_body, "red", 0.0, 1.0, 0.8, 4)
        inspector_row(material_body, "green", 0.0, 1.0, 0.5, 5)
        inspector_row(material_body, "blue", 0.0, 1.0, 0.3, 6)
        inspector_row(material_body, "metallic", 0.0, 1.0, 0.0, 7)
        inspector_row(material_body, "roughness", 0.0, 1.0, 0.5, 8)
        inspector_row(material_body, "reflectivity", 0.0, 1.0, 0.0, REFLECT_ROW)

        ui.divider(right)
        light_body = fold_section(right, "LIGHT")
        // What kind of light it is: the sun over the whole scene, a point
        // in a room, or a spot down a street. A lamp is a point and a
        // headlight is a spot, and the engine has always drawn both; the
        // editor could only make the one the Add button chose.
        light_kind_row = as_row(ui.hstack(light_body, 6))
        sun_btn = ui.btn(light_kind_row, "Sun") callback { set_light_mode(LIGHT_SUN) }
        style_button(sun_btn, "action")
        point_btn = ui.btn(light_kind_row, "Point") callback { set_light_mode(LIGHT_POINT) }
        style_button(point_btn, "action")
        spot_btn = ui.btn(light_kind_row, "Spot") callback { set_light_mode(LIGHT_SPOT) }
        style_button(spot_btn, "action")
        kinds_of_light = g_light_buttons as int[]
        kinds_of_light[LIGHT_SUN] = sun_btn
        kinds_of_light[LIGHT_POINT] = point_btn
        kinds_of_light[LIGHT_SPOT] = spot_btn
        inspector_row(light_body, "intensity", 0.0, 4.0, 1.0, 9)
        inspector_row(light_body, "ambient", 0.0, 1.0, 0.2, 10)
        inspector_row(light_body, "light red", 0.0, 1.0, 1.0, 14)
        inspector_row(light_body, "light green", 0.0, 1.0, 1.0, 15)
        inspector_row(light_body, "light blue", 0.0, 1.0, 1.0, 16)
        field_row(light_body, "reach", 400.0, LIGHT_RANGE_ROW)
        inspector_row(light_body, "cone", 1.0, 80.0, 20.0, LIGHT_INNER_ROW)
        inspector_row(light_body, "cone edge", 1.0, 89.0, 35.0, LIGHT_OUTER_ROW)
        refresh_light_section()

        // A terrain's own settings, beside the object rather than in the panel
        // that made it. Unreal and Unity both put the shape of a landscape on
        // the landscape; the editor's ADD list only has to say that a terrain
        // is a thing you can have.
        g_terrain_divider = ui.divider(right)
        g_terrain_body = fold_section(right, "TERRAIN")
        g_terrain_bar = section_bar(g_section_count - 1)

        biome_row = ui.hstack(g_terrain_body, 6)
        as_row(biome_row)
        biomes = g_biome_buttons as int[]
        plains_btn = ui.btn(biome_row, "Plains") callback { set_terrain_biome(terrain.PLAINS) }
        style_button(plains_btn, "action")
        mountains_btn = ui.btn(biome_row, "Hills") callback { set_terrain_biome(terrain.MOUNTAINS) }
        style_button(mountains_btn, "action")
        desert_btn = ui.btn(biome_row, "Desert") callback { set_terrain_biome(terrain.DESERT) }
        style_button(desert_btn, "action")
        biomes[terrain.PLAINS] = plains_btn
        biomes[terrain.MOUNTAINS] = mountains_btn
        biomes[terrain.DESERT] = desert_btn

        biome_row_two = ui.hstack(g_terrain_body, 6)
        as_row(biome_row_two)
        islands_btn = ui.btn(biome_row_two, "Islands") callback { set_terrain_biome(terrain.ISLANDS) }
        style_button(islands_btn, "action")
        caves_btn = ui.btn(biome_row_two, "Caves") callback { set_terrain_biome(terrain.CAVES) }
        style_button(caves_btn, "action")
        biomes[terrain.ISLANDS] = islands_btn
        biomes[terrain.CAVES] = caves_btn

        style_row = ui.hstack(g_terrain_body, 6)
        as_row(style_row)
        styles = g_style_buttons as int[]
        blocks_btn = ui.btn(style_row, "Blocks") callback { set_terrain_style(STYLE_BLOCKS) }
        style_button(blocks_btn, "action")
        smooth_btn = ui.btn(style_row, "Smooth") callback { set_terrain_style(STYLE_SMOOTH) }
        style_button(smooth_btn, "action")
        styles[STYLE_BLOCKS] = blocks_btn
        styles[STYLE_SMOOTH] = smooth_btn

        field_row(g_terrain_body, "seed", (DEFAULT_SEED) as float, TERRAIN_SEED_ROW)

        // The brush. Off, the viewport picks and orbits as it always did;
        // raise, lower or smooth, a press on the terrain sculpts it under
        // the cursor for as long as the button is held, and the drag is one
        // undo step.
        sculpt_row = ui.hstack(g_terrain_body, 6)
        as_row(sculpt_row)
        sculpts = g_sculpt_buttons as int[]
        sculpt_off_btn = ui.btn(sculpt_row, "Off") callback { set_sculpt(SCULPT_OFF) }
        style_button(sculpt_off_btn, "action")
        raise_btn = ui.btn(sculpt_row, "Raise") callback { set_sculpt(SCULPT_RAISE) }
        style_button(raise_btn, "action")
        lower_btn = ui.btn(sculpt_row, "Lower") callback { set_sculpt(SCULPT_LOWER) }
        style_button(lower_btn, "action")
        smooth_brush_btn = ui.btn(sculpt_row, "Smooth out") callback { set_sculpt(SCULPT_SMOOTH) }
        style_button(smooth_brush_btn, "action")
        sculpts[SCULPT_OFF] = sculpt_off_btn
        sculpts[SCULPT_RAISE] = raise_btn
        sculpts[SCULPT_LOWER] = lower_btn
        sculpts[SCULPT_SMOOTH] = smooth_brush_btn
        paint_segments(g_sculpt_buttons, SCULPT_KINDS, g_sculpt)
        inspector_row(g_terrain_body, "brush", 1.0, 200.0, 12.0, BRUSH_ROW)

        g_water_divider = ui.divider(right)
        g_water_body = fold_section(right, "WATER")
        g_water_bar = section_bar(g_section_count - 1)
        inspector_row(g_water_body, "wave height", 0.0, 24.0, 6.0, 11)
        inspector_row(g_water_body, "wave speed", 0.0, 4.0, 1.0, 12)
        inspector_row(g_water_body, "opacity", 0.0, 1.0, 0.72, 13)
        inspector_row(g_water_body, "foam", 0.0, 4.0, 1.0, FOAM_ROW)
        inspector_row(g_water_body, "wave scale", 1.0, 600.0, 1.0, WAVE_SCALE_ROW)
        inspector_row(g_water_body, "shore fade", 0.0, 40.0, 0.0, SHORE_FADE_ROW)
        inspector_row(g_water_body, "shore foam", 0.0, 15.0, 0.0, SHORE_FOAM_ROW)
        // Neither section applies until a terrain or a water surface is
        // selected, so both start hidden. Hiding them here, while the column
        // is still being built, costs 60 ms; the first selection used to do
        // it, after the window was laid out, and each set_hidden laid out the
        // whole inspector again: 200 ms of every editor start
        // (aether-lang-dev/aether-ui#206).
        show_terrain_section(false)
        show_water_section(false)

        // The object's body, as the scene file records it and the physics
        // module reads it back: its kind, its collider from its own mesh,
        // its surface and its density.
        g_physics_divider = ui.divider(right)
        g_physics_section = fold_section(right, "PHYSICS")
        g_physics_bar = section_bar(g_section_count - 1)
        body_row = as_row(ui.hstack(g_physics_section, 6))
        no_body_btn = ui.btn(body_row, "No body") callback { set_body_kind(BODY_NONE) }
        style_button(no_body_btn, "action")
        static_btn = ui.btn(body_row, "Static") callback { set_body_kind(BODY_STATIC) }
        style_button(static_btn, "action")
        kinematic_btn = ui.btn(body_row, "Kinematic") callback { set_body_kind(BODY_KINEMATIC) }
        style_button(kinematic_btn, "action")
        // The ones that move, on a row of their own: five do not fit an
        // inspector at its narrowest.
        moving_row = as_row(ui.hstack(g_physics_section, 6))
        dynamic_btn = ui.btn(moving_row, "Dynamic") callback { set_body_kind(BODY_DYNAMIC) }
        style_button(dynamic_btn, "action")
        character_btn = ui.btn(moving_row, "Character") callback { set_body_kind(BODY_CHARACTER) }
        style_button(character_btn, "action")
        bodies = g_body_buttons as int[]
        bodies[BODY_NONE] = no_body_btn
        bodies[BODY_STATIC] = static_btn
        bodies[BODY_KINEMATIC] = kinematic_btn
        bodies[BODY_DYNAMIC] = dynamic_btn
        bodies[BODY_CHARACTER] = character_btn
        collider_row = as_row(ui.hstack(g_physics_section, 6))
        box_btn = ui.btn(collider_row, "Box") callback { set_collider_kind(COLLIDER_BOX) }
        style_button(box_btn, "action")
        sphere_btn = ui.btn(collider_row, "Sphere") callback { set_collider_kind(COLLIDER_SPHERE) }
        style_button(sphere_btn, "action")
        capsule_btn = ui.btn(collider_row, "Capsule") callback { set_collider_kind(COLLIDER_CAPSULE) }
        style_button(capsule_btn, "action")
        hull_btn = ui.btn(collider_row, "Hull") callback { set_collider_kind(COLLIDER_HULL) }
        style_button(hull_btn, "action")
        mesh_btn = ui.btn(collider_row, "Mesh") callback { set_collider_kind(COLLIDER_MESH) }
        style_button(mesh_btn, "action")
        colliders = g_collider_buttons as int[]
        colliders[COLLIDER_BOX] = box_btn
        colliders[COLLIDER_SPHERE] = sphere_btn
        colliders[COLLIDER_CAPSULE] = capsule_btn
        colliders[COLLIDER_HULL] = hull_btn
        colliders[COLLIDER_MESH] = mesh_btn
        inspector_row(g_physics_section, "friction", 0.0, 2.0, 0.6, FRICTION_ROW)
        inspector_row(g_physics_section, "bounce", 0.0, 1.0, 0.0, RESTITUTION_ROW)
        field_row(g_physics_section, "density", 1.0, DENSITY_ROW)
        refresh_physics_section()

        // An animated figure (ae3d.figure): the clip it plays, a button a
        // clip named for it, whether it loops, its pace, and how far into
        // the clip it stands. It plays while the scene is simulated.
        g_figure_divider = ui.divider(right)
        g_figure_section = fold_section(right, "FIGURE")
        g_figure_bar = section_bar(g_section_count - 1)
        g_clip_buttons = calloc(MAX_CLIPS, 4)
        clips = g_clip_buttons as int[]
        clip_row = as_row(ui.hstack(g_figure_section, 6))
        clips[0] = ui.btn(clip_row, "clip") callback { choose_clip(0) }
        clips[1] = ui.btn(clip_row, "clip") callback { choose_clip(1) }
        clips[2] = ui.btn(clip_row, "clip") callback { choose_clip(2) }
        clips[3] = ui.btn(clip_row, "clip") callback { choose_clip(3) }
        more_clips = as_row(ui.hstack(g_figure_section, 6))
        clips[4] = ui.btn(more_clips, "clip") callback { choose_clip(4) }
        clips[5] = ui.btn(more_clips, "clip") callback { choose_clip(5) }
        clips[6] = ui.btn(more_clips, "clip") callback { choose_clip(6) }
        clips[7] = ui.btn(more_clips, "clip") callback { choose_clip(7) }
        k = 0
        while k < MAX_CLIPS {
            style_button(clips[k], "action")
            k = k + 1
        }
        loop_row = as_row(ui.hstack(g_figure_section, 6))
        g_loop_btn = ui.btn(loop_row, "Loop") callback { toggle_loop() }
        style_button(g_loop_btn, "action")
        inspector_row(g_figure_section, "speed", 0.0, 3.0, 1.0, FIGURE_SPEED_ROW)
        inspector_row(g_figure_section, "time", 0.0, 1.0, 0.0, FIGURE_TIME_ROW)
        show_figure_section(false)

        // Natural motion (ae3d.motion): the figure's animation played by its
        // muscles while the scene is simulated -- it stands on them, gives
        // when struck (a click on it strikes it), falls the way a person
        // does, and gets up.
        g_motion_divider = ui.divider(right)
        g_motion_section = fold_section(right, "MOTION")
        g_motion_bar = section_bar(g_section_count - 1)
        on_row = as_row(ui.hstack(g_motion_section, 6))
        g_motion_on_btn = ui.btn(on_row, "Natural motion") callback { set_motion_on(selected_motion() == null) }
        style_button(g_motion_on_btn, "action")
        g_protect_btn = ui.btn(on_row, "Protective") callback { toggle_protective() }
        style_button(g_protect_btn, "action")
        mode_row = as_row(ui.hstack(g_motion_section, 6))
        g_motion_mode_buttons = calloc(3, 4)
        modes = g_motion_mode_buttons as int[]
        modes[0] = ui.btn(mode_row, "Animated") callback { set_motion_mode(motion.ANIMATED) }
        modes[1] = ui.btn(mode_row, "Powered") callback { set_motion_mode(motion.POWERED) }
        modes[2] = ui.btn(mode_row, "Limp") callback { set_motion_mode(motion.LIMP) }
        style_button(modes[0], "action")
        style_button(modes[1], "action")
        style_button(modes[2], "action")
        inspector_row(g_motion_section, "strength", 0.0, 1.0, 1.0, MOTION_STRENGTH_ROW)
        inspector_row(g_motion_section, "get up after", 0.0, 10.0, 3.0, MOTION_GET_UP_ROW)
        show_motion_section(false)

        ui.divider(right)
        camera_body = fold_section(right, "CAMERA")
        inspector_row(camera_body, "field of view", 20.0, 110.0, 60.0, 17)
        field_row(camera_body, "near plane", 0.1, 18)
        field_row(camera_body, "far plane", 3000.0, 19)

        ui.divider(right)
        behaviour_body = fold_section(right, "BEHAVIOUR")

        // One button per script the project has, built from what was found on
        // disk rather than from a list in this file. Four to a row, so a
        // project with a dozen scripts reads as a grid rather than as one line
        // running off the panel.
        scripts = g_script_buttons as int[]
        script_row = as_row(ui.hstack(behaviour_body, 6))
        none_btn = ui.btn(script_row, "None") callback { set_script(g_selected, SCRIPT_NONE) }
        style_button(none_btn, "action")
        scripts[SCRIPT_NONE] = none_btn

        // Writing one is the other half of assigning one. The button leaves a
        // file to edit and says where it is; building it is the same step that
        // builds every script, and the editor picks the library up when it
        // appears.
        new_btn = ui.btn(panel_row(behaviour_body), "New script") callback { new_script() }
        style_button(new_btn, "action")

        slot = 1
        while slot < g_script_count {
            if slot % 4 == 0 { script_row = as_row(ui.hstack(behaviour_body, 6)) }
            id = slot
            button = ui.btn(script_row, script_name(id)) callback {
                set_script(g_selected, id)
            }
            style_button(button, "action")
            scripts[id] = button
            slot = slot + 1
        }

        ui.divider(right)
        sky_body = fold_section(right, "SKY")
        inspector_row(sky_body, "red", 0.0, 1.0, VIEWPORT_R, SKY_FIRST_ROW)
        inspector_row(sky_body, "green", 0.0, 1.0, VIEWPORT_G, SKY_FIRST_ROW + 1)
        inspector_row(sky_body, "blue", 0.0, 1.0, VIEWPORT_B, SKY_LAST_ROW)

        image_row = ui.hstack(sky_body, 6)
        as_row(image_row)
        skies = g_sky_buttons as int[]
        which = 0
        while which < SKY_IMAGES {
            sky_btn = ui.btn(image_row, sky_image_name(which)) callback {
                set_sky_image(which)
            }
            style_button(sky_btn, "action")
            skies[which] = sky_btn
            which = which + 1
        }
        g_sky_caption = ui.text(sky_body, "")
        ui.add_css_class(g_sky_caption, "label")
        refresh_sky_buttons()

        sun_row = ui.hstack(sky_body, 8)
        as_row(sun_row)
        sun_caption = ui.text(sun_row, "Sun by time")
        ui.add_css_class(sun_caption, "label")
        ui.spacer(sun_row)
        g_sun_by_time_toggle = ui.toggle(sun_row, "") callback |on: bool| {
            g_sun_by_time = on
            apply_time_of_day()
            if on { say("the sun at ${sky.hour_name(g_time_of_day)}: the sky is drawn from it") }
            else { say("the sky is the colour above, the light the scene's own") }
        }
        inspector_row(sky_body, "time of day", 0.0, 24.0, 14.0, TIME_ROW)

        ui.divider(right)
        weather_body = fold_section(right, "WEATHER")

        kind_row = ui.hstack(weather_body, 6)
        as_row(kind_row)
        clear_btn = ui.btn(kind_row, "Clear") callback { set_weather_kind(weather.CLEAR) }
        style_button(clear_btn, "action")
        rain_btn = ui.btn(kind_row, "Rain") callback { set_weather_kind(weather.RAIN) }
        style_button(rain_btn, "action")
        snow_btn = ui.btn(kind_row, "Snow") callback { set_weather_kind(weather.SNOW) }
        style_button(snow_btn, "action")
        dust_btn = ui.btn(kind_row, "Dust") callback { set_weather_kind(weather.DUST) }
        style_button(dust_btn, "action")
        storm_btn = ui.btn(kind_row, "Storm") callback { set_weather_kind(weather.STORM) }
        style_button(storm_btn, "action")
        kinds = g_weather_buttons as int[]
        kinds[0] = clear_btn
        kinds[1] = rain_btn
        kinds[2] = snow_btn
        kinds[3] = dust_btn
        kinds[4] = storm_btn
        refresh_weather_buttons()
        inspector_row(weather_body, "strength", 0.0, 1.0, 0.5, WEATHER_ROW)
        inspector_row(weather_body, "wind heading", 0.0, 360.0, 0.0, WIND_HEADING_ROW)
        inspector_row(weather_body, "wind speed", 0.0, 40.0, 3.0, WIND_SPEED_ROW)

        ui.divider(right)
        rendering_body = fold_section(right, "RENDERING")

        preset_row = ui.hstack(rendering_body, 6)
        as_row(preset_row)
        fast_btn = ui.btn(preset_row, "Fast") callback { apply_preset("performance") }
        style_button(fast_btn, "action")
        balanced_btn = ui.btn(preset_row, "Balanced") callback { apply_preset("balanced") }
        style_button(balanced_btn, "action")
        quality_btn = ui.btn(preset_row, "Quality") callback { apply_preset("quality") }
        style_button(quality_btn, "action")
        presets = g_preset_buttons as int[]
        presets[0] = fast_btn
        presets[1] = balanced_btn
        presets[2] = quality_btn

        ui.divider(right)
        shading_body = fold_section(right, "SHADING")

        shading_row(shading_body, "Clearcoat", SHADE_CLEARCOAT)
        shading_row(shading_body, "Sheen", SHADE_SHEEN)
        shading_row(shading_body, "Volumetric light", SHADE_VOLUMETRIC)
        shading_row(shading_body, "Global illumination", SHADE_GI)
        shading_row(shading_body, "Soft shadows", SHADE_SHADOWS)

        fxaa_row = ui.hstack(shading_body, 8)
        as_row(fxaa_row)
        fxaa_caption = ui.text(fxaa_row, "FXAA")
        ui.add_css_class(fxaa_caption, "label")
        ui.spacer(fxaa_row)
        g_fxaa_toggle = ui.toggle(fxaa_row, "") callback |on: bool| {
            g_fxaa = on
            apply_post()
            say("fxaa ${on}")
        }
        ui.set_toggle(g_fxaa_toggle, 1)

        bloom_row = ui.hstack(shading_body, 8)
        as_row(bloom_row)
        bloom_caption = ui.text(bloom_row, "Bloom")
        ui.add_css_class(bloom_caption, "label")
        ui.spacer(bloom_row)
        g_bloom_toggle = ui.toggle(bloom_row, "") callback |on: bool| {
            g_bloom = on
            apply_post()
            say("bloom ${on}")
        }

        ssr_row = ui.hstack(shading_body, 8)
        as_row(ssr_row)
        ssr_caption = ui.text(ssr_row, "Reflections")
        ui.add_css_class(ssr_caption, "label")
        ui.spacer(ssr_row)
        g_ssr_toggle = ui.toggle(ssr_row, "") callback |on: bool| {
            g_ssr = on
            apply_post()
            if g_vulkan { say("reflections ${on}") }
            else { say("reflections ${on} (drawn on the Vulkan backend)") }
        }

        fog_row = ui.hstack(shading_body, 8)
        as_row(fog_row)
        fog_caption = ui.text(fog_row, "Fog")
        ui.add_css_class(fog_caption, "label")
        ui.spacer(fog_row)
        g_fog_toggle = ui.toggle(fog_row, "") callback |on: bool| {
            g_fog = on
            apply_fog()
            say("fog ${on}")
        }
        inspector_row(shading_body, "fog start", 0.0, 500.0, 20.0, FOG_START_ROW)
        inspector_row(shading_body, "fog end", 1.0, 2000.0, 300.0, FOG_END_ROW)

        clouds_row = ui.hstack(shading_body, 8)
        as_row(clouds_row)
        clouds_caption = ui.text(clouds_row, "Clouds")
        ui.add_css_class(clouds_caption, "label")
        ui.spacer(clouds_row)
        g_clouds_toggle = ui.toggle(clouds_row, "") callback |on: bool| {
            g_clouds = on
            apply_post()
            say("clouds ${on}")
        }
        inspector_row(shading_body, "cloud cover", 0.0, 1.0, 0.4, CLOUD_COVER_ROW)
        inspector_row(shading_body, "overcast", 0.0, 1.0, 0.0, OVERCAST_ROW)

        ssao_row = ui.hstack(shading_body, 8)
        as_row(ssao_row)
        ssao_caption = ui.text(ssao_row, "Ambient occlusion")
        ui.add_css_class(ssao_caption, "label")
        ui.spacer(ssao_row)
        g_ssao_toggle = ui.toggle(ssao_row, "") callback |on: bool| {
            g_ssao = on
            apply_post()
            say("ambient occlusion ${on}")
        }
        inspector_row(shading_body, "occlusion", 0.0, 2.0, 1.0, SSAO_ROW)
        inspector_row(shading_body, "occlusion reach", 0.2, 30.0, 3.0, SSAO_RADIUS_ROW)
        ui.spacer(right)

        g_stage = stage
        g_left = left_scroll
        g_right = right_scroll

        if !env_is("AE3D_EDITOR_DRIVER", "") {
            ui.enable_test_server(9222)
        }

        profile_mark("window and widgets built")
        ui.apply_styles(0, sheet)
        profile_mark("style sheet applied")
        // On the GPU path this happens at realize instead: the models go into
        // a renderer that does not exist until aether-ui hands over a context.
        if g_gpu == 0 {
            build_scene()
            scan_assets()
            apply_orbit()
        }

        // The layout is settled from the timer and nowhere else: a frame is
        // also drawn from the viewport's resize callback, which runs inside
        // the toolkit's layout pass, and a divider set from there was undone
        // by the pass it interrupted (aether-ui#209), leaving the inspector
        // over the middle of the viewport on Windows.
        g_timer = ui.timer(16) callback {
            if g_renderer != null { settle_layout() }
            watch_view_size()
            draw_frame()
        }

        build_menus()
    }
}

// The window's menu bar. Every editor this borrows from has one, and a window
// with panels and no menu reads as a demo of a toolkit rather than as an
// application: it is where a person looks first for what a program can do, and
// where they look to find out what a thing is called.
//
// Each item calls the same function its button does, so there is one action
// behind two ways of reaching it. The accelerators are all Cmd combinations,
// because the viewport already answers W, E, R and F and a menu accelerator
// fires wherever the focus is, including inside a number field.
build_menus() {
    bar = ui.menu_bar()

    file_menu = ui.menu("File")
    ui.menu_item_accel(file_menu, "Save Scene", "Cmd+S") callback { save_scene() }
    ui.menu_item_accel(file_menu, "Load Scene", "Cmd+O") callback { load_scene() }
    ui.menu_separator(file_menu)
    ui.menu_item_accel(file_menu, "Simulate", "Cmd+P") callback { toggle_simulation() }
    ui.menu_bar_add(bar, file_menu)

    edit_menu = ui.menu("Edit")
    ui.menu_item_accel(edit_menu, "Undo", "Cmd+Z") callback { undo_step() }
    ui.menu_item_accel(edit_menu, "Redo", "Shift+Cmd+Z") callback { redo_step() }
    ui.menu_separator(edit_menu)
    ui.menu_item_accel(edit_menu, "Duplicate", "Cmd+D") callback { duplicate_selected() }
    ui.menu_item_accel(edit_menu, "Delete", "Cmd+Backspace") callback { remove_selected() }
    ui.menu_separator(edit_menu)
    ui.menu_item_accel(edit_menu, "Group Selection", "Cmd+G") callback { group_selection() }
    ui.menu_item_accel(edit_menu, "Ungroup", "Shift+Cmd+G") callback { ungroup_selected() }
    ui.menu_bar_add(bar, edit_menu)

    add_menu = ui.menu("Add")
    ui.menu_item(add_menu, "Cube") callback { add_cube() }
    ui.menu_item(add_menu, "Sphere") callback { add_sphere() }
    ui.menu_item(add_menu, "Plane") callback { add_plane() }
    ui.menu_item(add_menu, "Water") callback { add_water() }
    ui.menu_item(add_menu, "Light") callback { add_light() }
    ui.menu_item(add_menu, "Spot Light") callback { add_spot_light() }
    ui.menu_item(add_menu, "Terrain") callback { add_terrain() }
    ui.menu_item(add_menu, "Group") callback { add_group() }
    ui.menu_bar_add(bar, add_menu)

    // The transform modes carry no accelerator here: W, E, R and F already
    // reach them from the viewport, and binding the same key twice would run
    // the action twice.
    view_menu = ui.menu("View")
    ui.menu_item(view_menu, "Move") callback { set_gizmo_mode(GIZMO_TRANSLATE) }
    ui.menu_item(view_menu, "Rotate") callback { set_gizmo_mode(GIZMO_ROTATE) }
    ui.menu_item(view_menu, "Scale") callback { set_gizmo_mode(GIZMO_SCALE) }
    ui.menu_separator(view_menu)
    ui.menu_item_accel(view_menu, "Frame Selection", "Cmd+F") callback { focus_selection() }
    ui.menu_separator(view_menu)
    ui.menu_item(view_menu, "Fast") callback { apply_preset("performance") }
    ui.menu_item(view_menu, "Balanced") callback { apply_preset("balanced") }
    ui.menu_item(view_menu, "Quality") callback { apply_preset("quality") }
    ui.menu_bar_add(bar, view_menu)

    ui.attach_menu_bar_to_window(1, bar)
}
