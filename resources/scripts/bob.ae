// Rise and fall on the spot.
//
// The height is integrated rather than assigned: moving by the derivative
// needs no memory of where the object started, so a script attached to
// something already in the air bobs around where it is rather than snapping to
// the middle of its own curve.

import ae3d.core

exports (script_update)

const RATE = 2.0
const HEIGHT = 6.0

var g_clock = 0.0

script_update(m: *Model, delta: float) {
    g_clock = g_clock + delta
    step = core.cos_of(g_clock * RATE) * HEIGHT * RATE * delta
    core.model_set_position(m, m.position.x, m.position.y + step, m.position.z)
}
