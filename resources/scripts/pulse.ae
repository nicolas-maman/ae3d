// Breathe: scale up and down about whatever size the object was given.
//
// The size to return to is read once, when the script is attached, which is
// what start is for: a script that measured it every frame would be
// measuring its own last answer and would drift.

import ae3d.core
import ae3d.behaviour

exports (start, update)

const RATE = 2.4
const DEPTH = 0.12

var g_base = 1.0
var g_clock = 0.0

start(state: ptr, go: *GameObject) {
    g_base = behaviour.object_model(go).scale.x
    g_clock = 0.0
}

update(state: ptr, go: *GameObject, delta: float) {
    g_clock = g_clock + delta
    size = g_base * (1.0 + core.sin_of(g_clock * RATE) * DEPTH)
    core.model_set_scale(behaviour.object_model(go), size, size, size)
}
