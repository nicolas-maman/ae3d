// Turn steadily about the up axis.
//
// A script is an ordinary source file: it imports what it needs and moves the
// object it is given. Attaching it to something in the editor is what makes it
// run, and nothing about the file says which object that is.

import ae3d.core
import ae3d.behaviour

exports (update)

const TURN_PER_SECOND = 60.0

update(state: ptr, go: *GameObject, delta: float) {
    core.model_rotate(behaviour.object_model(go), 0.0, delta * TURN_PER_SECOND, 0.0)
}
