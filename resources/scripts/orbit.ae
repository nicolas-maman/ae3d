// Circle the origin, keeping height.
//
// The radius comes from where the object already is, so attaching this does
// not teleport it: it starts orbiting from its own distance out. An object
// sitting at the centre has no radius to keep, and is given one.

import ae3d.core
import ae3d.behaviour

exports (update)

const RATE = 0.8
const DEFAULT_RADIUS = 60.0

var g_clock = 0.0

update(state: ptr, go: *GameObject, delta: float) {
    m = behaviour.object_model(go)
    g_clock = g_clock + delta
    angle = g_clock * RATE
    radius = core.sqrt_of(m.position.x * m.position.x + m.position.z * m.position.z)
    if radius < 1.0 { radius = DEFAULT_RADIUS }
    core.model_set_position(m, core.cos_of(angle) * radius, m.position.y,
                            core.sin_of(angle) * radius)
}
