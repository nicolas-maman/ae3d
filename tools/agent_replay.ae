// A recorded agent session asked again of a running program (#416).
//
//   AE3D_AGENT_RECORD=build/scratch/good.log AE3D_AGENT=7920 ./build/zombie_street
//   ... drive it: tools/ae3d_agent.ae, the pipeline, anything on the channel ...
//   AE3D_AGENT=7921 ./build/zombie_street &          # the same program, changed
//   ./build/agent_replay build/scratch/good.log --port 7921
//
// Every request of the session is sent again, in order, and every answer
// compared with the one recorded (ae3d.replay): numbers within a tolerance
// (--tolerance, relative; a part in a million by default), everything else
// exactly, the id and the clocks left out and any other key with --ignore.
// It prints each difference, up to the first 64, with where in the answer it
// is, and a line of counts; it exits 0 when every answer is the same, 1 when
// one differs or goes unanswered, 2 when it cannot start.
import std.os
import std.string
import ae3d.probe
import ae3d.replay

main() {
    path = ""
    port = 0
    tolerance = 0.0 - 1.0
    extra = ""
    i = 1
    while i < os.aether_args_count() {
        arg = os.aether_args_get(i)
        if arg == "--port" && i + 1 < os.aether_args_count() {
            port = string.string_get_int(os.aether_args_get(i + 1))
            i = i + 1
        } else if arg == "--tolerance" && i + 1 < os.aether_args_count() {
            tolerance = string.string_get_float(os.aether_args_get(i + 1))
            i = i + 1
        } else if arg == "--ignore" && i + 1 < os.aether_args_count() {
            extra = os.aether_args_get(i + 1)
            i = i + 1
        } else {
            path = arg
        }
        i = i + 1
    }
    if path == "" || port == 0 {
        println("usage: agent_replay <session file> --port <port> [--tolerance t] [--ignore key]")
        os.exit(2)
    }
    s = replay.read(path)
    if s == null {
        println("agent_replay: ${replay.last_error()}")
        os.exit(2)
    }
    if tolerance >= 0.0 { replay.set_tolerance(s, tolerance) }
    if extra != "" { replay.ignore(s, extra) }
    p = probe.open(port)
    if p == null {
        println("agent_replay: cannot reach 127.0.0.1:${port}: ${probe.last_error()}")
        replay.session_free(s)
        os.exit(2)
    }
    r = replay.replay(s, p)
    k = 0
    while k < replay.note_count(r) {
        println("  ${replay.note_at(r, k)}")
        k = k + 1
    }
    println("agent_replay: ${r.asked} asked, ${r.same} the same, ${r.differing} different, ${r.unanswered} unanswered; ${r.differences} difference(s)")
    failed = r.differing + r.unanswered
    replay.report_free(r)
    probe.close(p)
    replay.session_free(s)
    if failed > 0 { os.exit(1) }
}
