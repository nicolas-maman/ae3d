// A region of a rendered frame at full size, so a detail is judged at the
// pixels it was drawn at and not through a halved contact sheet: the sky
// over one corner, the shore under the island, one figure in the crowd.
//
//   ./build.sh tools/crop.ae && ./build/crop out.png frame.png x y width height
//
// x and y are from the top left, in pixels, like an image editor's; the
// region is clamped to the frame. Several frames' regions are compared by
// cropping each and laying them out with tools/montage.
import ae3d.core
import ae3d.png
import std.os
import std.string

extern ae3d_image_load(path: string) -> ptr
extern ae3d_image_free(img: ptr)
extern ae3d_image_width(img: ptr) -> int
extern ae3d_image_height(img: ptr) -> int
extern ae3d_image_pixels(img: ptr) -> ptr
extern ae3d_image_error() -> string
extern calloc(count: int, size: int) -> ptr
extern free(block: ptr)

channel(pixels: ptr, index: int) -> int {
    bytes = pixels as byte[]
    return (bytes[index] as int) & 255
}

main() {
    if os.args_count() < 7 {
        println("usage: crop out.png frame.png x y width height")
        return
    }
    img = ae3d_image_load(os.args_get(2))
    if img == null { println("crop: ${ae3d_image_error()}"); return }
    w = ae3d_image_width(img)
    h = ae3d_image_height(img)
    x0 = string.get_int(os.args_get(3))
    y0 = string.get_int(os.args_get(4))
    cw = string.get_int(os.args_get(5))
    ch = string.get_int(os.args_get(6))
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x0 + cw > w { cw = w - x0 }
    if y0 + ch > h { ch = h - y0 }
    if cw <= 0 || ch <= 0 {
        println("crop: nothing of ${w}x${h} inside that region")
        ae3d_image_free(img)
        return
    }
    pixels = calloc(cw * ch * 4, 1)
    if pixels == null { ae3d_image_free(img); return }
    src = ae3d_image_pixels(img)
    y = 0
    while y < ch {
        x = 0
        while x < cw {
            // The loader flips rows so row 0 is the bottom; the crop is
            // written top row first, like the frame it came from.
            at = ((h - 1 - (y0 + y)) * w + x0 + x) * 4
            png.rgba_set(pixels, y * cw + x,
                          (channel(src, at) as float) / 255.0,
                          (channel(src, at + 1) as float) / 255.0,
                          (channel(src, at + 2) as float) / 255.0, 1.0)
            x = x + 1
        }
        y = y + 1
    }
    ae3d_image_free(img)
    if png.write(os.args_get(1), pixels, cw, ch) {
        println("crop: wrote ${os.args_get(1)} (${cw}x${ch} at ${x0},${y0} of ${w}x${h})")
    } else {
        println("crop: could not write ${os.args_get(1)}")
    }
    free(pixels)
}
