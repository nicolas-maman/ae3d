// Prints the agent channel's command table as JSON.
//
// No window, no socket, no engine: the schema is a property of the protocol
// rather than of a running program, so anything that needs it -- the
// documentation generator, a client checking an op exists -- can have it
// without starting one.
//
//   ./build.sh tools/agent_schema.ae && ./build/agent_schema

import ae3d.agent

main() {
    println(agent.schema_json())
}
